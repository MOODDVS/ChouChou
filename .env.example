# ==========================================================================
#  RestoHub — DEMO (restohub.moodd.online)  ·  motore RestoHub v3.0
#  NB: le PUBLIC_* si "cuociono" nel build → devono esserci PRIMA di npm run build.
#  Usa un Supabase DEMO dedicato (dati finti), NON il DB di un cliente.
# ==========================================================================

# ---- URL del sito (niente slash finale!) ---------------------------------
PUBLIC_SITE_URL=https://restohub.moodd.online

# ---- Database — Supabase (OBBLIGATORIE, senza queste non parte niente) ----
# Progetto Supabase DEMO. Le PUBLIC_ vanno nel browser (anon key = sicura).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=          # chiave service_role — SEGRETA, solo server
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ---- Pagamenti — Stripe (solo chiavi TEST, mai live) ---------------------
# Publishable key NON serve (checkout è 100% lato server).
# Webhook: crea in Stripe (test) un endpoint verso
#   https://restohub.moodd.online/api/stripe-webhook
#   evento: checkout.session.completed  → copia il "whsec_..." qui sotto.
STRIPE_SECRET_KEY=             # sk_test_...  (Stripe del "ristorante" demo)
MOODD_STRIPE_SECRET_KEY=       # sk_test_...  (Stripe MOODD, per i bons cadeaux)
STRIPE_WEBHOOK_SECRET=         # whsec_...    (dal webhook test)
#
# ⚠️ MULTI-SEDE: un gruppo con piu' societa' ha un conto Stripe per sede, e
# nel .env ci sta una chiave sola. Le altre si mettono in Super admin > Sedi
# e vivono CIFRATE nel database. Le due variabili qui sopra restano il
# ripiego: valgono per un'installazione a sede unica, e per le sedi a cui
# nessuno ha ancora messo la loro chiave.

# ---- Cifratura dei segreti di sede --------------------------------------
# Chiave madre con cui si cifrano le chiavi Stripe salvate nel database
# (`location_secrets`). Senza, l'admin RIFIUTA di registrarne: un segreto in
# chiaro nel database e' peggio di un segreto assente, perche' funziona.
# 32 byte in base64. Generala cosi', e NON mandarla a nessuno:
#   openssl rand -base64 32
# Cambiarla rende illeggibili i segreti gia' salvati: vanno riscritti.
SECRETS_KEY=

# ---- Email — Resend (dominio moodd.online GIÀ verificato) ----------------
RESEND_API_KEY=
RESEND_FROM="RestoHub Admin <no-reply@moodd.online>"
# KITCHEN_EMAIL: solo fallback della mail cucina impostata in Réglages → Général.
# Ridondante se la imposti nei settings; puoi anche ometterla.
KITCHEN_EMAIL=

# ---- Notifiche push — VAPID (opzionali per la demo) ----------------------
# Genera la COPPIA nel tuo terminale:  npx web-push generate-vapid-keys
# (Public → PUBLIC_VAPID_KEY, Private → VAPID_PRIVATE_KEY. Non mescolarle.)
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@moodd.online

# ---- Google (opzionali — se vuote, quelle tuiles restano nascoste) -------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
GOOGLE_SA_KEY_B64=             # service account (base64) per Search Console

# ---- Tecniche (opzionali per la demo) ------------------------------------
# CRON_SECRET: protegge gli endpoint cron (brief quotidiano, newsletter
# programmate, promemoria). Se non configuri uno scheduler, puoi ometterla.
# Se la metti, genera un valore random forte:  openssl rand -hex 32
# (MAI un placeholder tipo "dev-solo-locale" su un URL pubblico.)
CRON_SECRET=
SLACK_WEBHOOK_URL=             # notifiche Slack interne (facoltative)

# ---- Quanti thread tiene Node (hosting condiviso) ------------------------
# ⚠️ DA METTERE SU OGNI NUOVO CLIENTE, prima del primo deploy.
#
# Su Hostinger (CloudLinux) il limite «Max Processes» conta PROCESSI E
# THREAD, non solo i processi. Un'applicazione Node e' un processo solo ma
# tiene una decina di thread, e il pool di V8 si dimensiona sul numero di
# processori che la MACCHINA espone — su un server condiviso li espone
# tutti, non la tua fetta. Risultato: ogni sito si prende thread per lavori
# che non fara' mai, e con sette siti sullo stesso piano si arriva al tetto.
# Quando il tetto e' pieno nessun thread nuovo parte, e il visitatore vede
# un 503.
#
# Misurato l'11/10/2026 sul piano con sette siti, con `ps -o nlwp`:
#   senza queste due righe   11 thread per istanza
#   con queste due righe      7 thread per istanza
# Stesso server, stesso momento, stesso codice.
#
# ⚠️ NON sono un'ottimizzazione di velocita': tolgono lavoratori di
# sfondo che un sito vetrina non usa. Se un giorno un cliente facesse
# compressione o crittografia pesante lato server, `UV_THREADPOOL_SIZE`
# e' il primo numero da rialzare (il valore di fabbrica e' 4).
#
# ⚠️ I DUE TRATTINI SONO DUE TRATTINI CORTI. Incollando il valore a mano
# in un pannello, la sostituzione automatica di macOS trasforma `--` in un
# trattino lungo: Node non riconosce l'opzione e l'applicazione NON PARTE.
# Importando questo file il problema non si pone, ed e' il motivo per cui
# stanno qui invece che in una pagina di istruzioni.
NODE_OPTIONS=--v8-pool-size=2
UV_THREADPOOL_SIZE=2