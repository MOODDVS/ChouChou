---
// Placeholder — Jobs. Struttura base da riempire con offerte/candidatura.
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl } from "../i18n/ui";
const lang = getLangFromUrl(Astro.url);
const text =
  lang === "en"
    ? "Join the team — this page is coming soon."
    : "Rejoignez l'équipe — cette page est en préparation.";
---

<Layout title="Jobs — La Molisana">
  <section class="ph">
    <div class="ph-inner">
      <p class="ph-claim">La Molisana</p>
      <h1 class="ph-title">Jobs</h1>
      <p class="ph-text">{text}</p>
    </div>
  </section>
</Layout>

<style>
  .ph {
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem 8rem;
  }
  .ph-inner { max-width: 640px; }
  .ph-claim {
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--c-accent);
    margin-bottom: 1rem;
  }
  .ph-title {
    font-family: var(--font-title);
    font-size: clamp(3rem, 9vw, 6rem);
    letter-spacing: 0.03em;
    line-height: 0.95;
  }
  .ph-text { color: var(--c-muted); font-size: 1.05rem; margin-top: 1.25rem; }
</style>
