---
// Homepage "coming soon" del TEMPLATE: il cliente parte SOLO con l'admin.
// Quando si attiva il sito pubblico, questa pagina si sostituisce con la
// vera home (le pagine pubbliche esistono già, non sono linkate).
//
// Brand-aware: prende NOME, LOGO e COLORI dai Réglages (app_config) e la
// LINGUA del testo dalla lingua admin. Se il DB non risponde, fallback totale
// ai default: la pagina non deve MAI rompersi.
import { supabaseAdmin } from "../lib/db";
import { adminLang } from "../lib/admin/adminLang";
import { adminT } from "../i18n/admin";
import { TEMA_DEFAULT } from "../lib/admin/superAdmin";
import { cacheOr } from "../lib/cache";

export const prerender = false;

const lang = await adminLang();
const t = adminT(lang);

const HEX = /^#[0-9a-f]{6}$/i;
type Brand = { tema: Record<string, string>; nome: string; logo: string };

const brand: Brand = await (async () => {
  try {
    return await cacheOr("pub:coming-soon", async () => {
      const { data } = await supabaseAdmin
        .from("app_config")
        .select("key, value")
        .in("key", ["admin_theme", "restaurant_name", "brand_logo"]);
      const m = new Map((data ?? []).map((r) => [String(r.key), String(r.value ?? "")] as [string, string]));
      let tema: Record<string, string> = {};
      try { tema = JSON.parse(m.get("admin_theme") ?? "{}") ?? {}; } catch { tema = {}; }
      return {
        tema,
        nome: (m.get("restaurant_name") ?? "").trim(),
        logo: (m.get("brand_logo") ?? "").trim() || "/icon-192.png",
      } as Brand;
    }, 60);
  } catch {
    return { tema: {}, nome: "", logo: "/icon-192.png" };
  }
})();

// Titolo grande = "Nuovo sito internet" nella lingua admin (frase generica,
// non il nome ristorante). Il nome, se impostato, va solo nel <title> del tab.
const titolo = t("pub.newSite");
const tabTitle = brand.nome || titolo;

// Colore effettivo: valore dal tema se è un hex valido, altrimenti default MOODD.
const col = (k: string): string => (HEX.test(brand.tema[k] ?? "") ? brand.tema[k] : TEMA_DEFAULT[k]);
const cBg = col("bg");
const cText = col("text");
const cMuted = col("muted");
const cAccent = col("accent");
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tabTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={cBg} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito+Sans:wght@400;700&display=swap"
    />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        font-family: "Nunito Sans", system-ui, sans-serif;
        text-align: center; padding: 2rem;
      }
      .box { max-width: 480px; }
      .logo { width: 84px; height: 84px; border-radius: 18px; margin: 0 auto 1.6rem; display: block; object-fit: contain; }
      h1 { font-family: "Bebas Neue", system-ui, sans-serif; font-size: 2.6rem; letter-spacing: 0.06em; }
      .riga { width: 64px; height: 3px; margin: 1.1rem auto 1.3rem; }
      p { font-size: 0.95rem; line-height: 1.7; }
    </style>
  </head>
  <body style={`background:${cBg};color:${cText}`}>
    <div class="box">
      <img class="logo" src={brand.logo} alt={titolo} />
      <h1 style={`color:${cText}`}>{titolo}</h1>
      <div class="riga" style={`background:${cAccent}`}></div>
      <p style={`color:${cMuted}`}>{t("pub.comingSoon")}</p>
    </div>
  </body>
</html>
