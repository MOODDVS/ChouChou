function iconaDi(titolo: string): string {
  const s = titolo.toLowerCase();
  let k = "fork";
  if (s.includes("antipast")) k = "antipasti";
  else if (s.includes("past")) k = "pasta";
  else if (s.includes("enfant") || s.includes("kid")) k = "enfants";
  else if (s.includes("pizza")) k = "pizza";
  else if (s.includes("dessert")) k = "desserts";
  return ICONE[k];
}

// --- Voci della barra sezioni: un bottone per ogni gruppo CIBO, e un
// UNICO bottone "Boissons" per tutte le bevande (porta alla prima —
// Apéritifs — e resta attivo su qualsiasi sezione bevande).
const vociNav: { href: string; title: string; icona: string; secs: string[] }[] = [];
gruppi.forEach((g, i) => {
  const bevanda = g.subcats[0].category_order >= 9;
  if (!bevanda) {
    vociNav.push({ href: "#sec-" + i, title: g.title, icona: iconaDi(g.title), secs: ["sec-" + i] });
  } else {
    const esistente = vociNav.find((v) => v.icona === ICONE.boissons);
    if (esistente) {
      esistente.secs.push("sec-" + i);
    } else {
      vociNav.push({
        href: "#sec-" + i,
        title: en ? "Drinks" : "Boissons",
        icona: ICONE.boissons,
        secs: ["sec-" + i],
      });
    }
  }
});
---

<Layout title={lang === "en" ? "Our Menu — La Molisana, Italian Restaurant in Saint-Gilles, Brussels" : "Notre Carte — La Molisana, Restaurant Italien à Saint-Gilles, Bruxelles"}>
  <section class="menu-hero">
    <img class="menu-hero__bg-img" src={HERO_FOTO} alt="" loading="eager" decoding="async" />
    <div class="menu-hero__overlay" aria-hidden="true"></div>

    <div class="menu-hero__inner">
      <h1 class="menu-hero__title">{t("menu.title")}</h1>
      <p class="menu-hero__sub">
        {lang === "en"
          ? "Pizzas, homemade pasta, antipasti and Italian desserts — dine in or take away in Saint-Gilles, Brussels."
          : "Pizzas, pâtes maison, antipasti et desserts italiens — sur place ou à emporter à Saint-Gilles, Bruxelles."}
      </p>
      {/* Commander masqué pour le moment */}
    </div>

    <div class="menu-hero__flag" aria-hidden="true"></div>
  </section>

  <nav class="secnav" id="secnav" aria-label={en ? "Menu sections" : "Sections du menu"}>
    {vociNav.map((v) => (
      <a href={v.href} class="secnav__item" data-secs={v.secs.join(",")}>
        <span class="secnav__label">{v.title}</span>
        <span class="secnav__box" set:html={v.icona} />
      </a>
    ))}
  </nav>

  <div class="carte">
    {gruppi.map((g, i) => (
      <section class="cat" id={"sec-" + i}>
        <h2 class="cat__title">{g.title}</h2>
        <div class="cat__body">
          {g.subcats.map((sub) => (
            <div class="subcat">
              {g.subcats.length > 1 && <h3 class="cat__subtitle">{sub.category}</h3>}
              <ul class="cat__items">
                {sub.items.map((item) => (
                  <li class="dish">
                    <p class="dish__head">
                      <span class="dish__name">
                        {item.name}
                        {item.is_bestseller && <span class="b b-star" title="Best-seller">★</span>}
                        {item.is_vegan && <span class="b" title={en ? "Vegan" : "Végan"}>🌱</span>}
                        {item.is_spicy && <span class="b" title={en ? "Spicy" : "Épicé"}>🌶️</span>}
                        {item.is_suggestion && <span class="b-sugg">Suggestion</span>}
                        {item.is_seasonal && <span class="b" title={en ? "Seasonal" : "Saisonnier"}>🍂</span>}
                        {item.allergens.length > 0 && (
                          <sup class="dish__alg">{item.allergens.join("·")}</sup>
                        )}
                      </span>
                      <span class="dish__dots" aria-hidden="true"></span>
                      <span class="dish__price">
                        {item.original_price_cents && (
                          <s class="dish__old">{prezzo(item.original_price_cents)}</s>
                        )}
                        {prezzo(item.price_cents)}
                      </span>
                    </p>
                    {descDi(item) && <p class="dish__desc">{descDi(item)}</p>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="alg-legend">
      <h2 class="alg-legend__title">{en ? "Allergens" : "Allergènes"}</h2>
      <p class="alg-legend__list">
        {ALLERGENI.map(([n, label]) => `${n}. ${label}`).join(" · ")}
      </p>
      <p class="alg-legend__badges">
        <span class="b-star">★</span> Best-seller · 🌱 {en ? "Vegan" : "Végan"} · 🌶️ {en ? "Spicy" : "Épicé"} · <span class="b-sugg">Suggestion</span>
      </p>
    </section>
  </div>
</Layout>

