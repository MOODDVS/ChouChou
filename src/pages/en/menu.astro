<script>
  // Barra sezioni: evidenzia la sezione visibile (scrollspy) e, quando la
  // barra è orizzontale (mobile), la fa scorrere per tenere visibile
  // il bottone attivo.
  const nav = document.getElementById("secnav");
  const voci = Array.from(nav?.querySelectorAll<HTMLAnchorElement>(".secnav__item") ?? []);
  const sezioni = Array.from(document.querySelectorAll(".cat[id^='sec-']"));

  function attiva(id: string) {
    let attivo: HTMLAnchorElement | null = null;
    for (const a of voci) {
      // data-secs: elenco delle sezioni coperte (Boissons ne copre molte)
      const on = (a.dataset.secs ?? "").split(",").includes(id);
      a.classList.toggle("active", on);
      if (on) attivo = a;
    }
    // Barra orizzontale (mobile): centra il bottone attivo
    if (attivo && nav && nav.scrollWidth > nav.clientWidth + 4) {
      nav.scrollTo({
        left: attivo.offsetLeft - nav.clientWidth / 2 + attivo.clientWidth / 2,
        behavior: "smooth",
      });
    }
  }

  const oss = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) attiva(e.target.id);
      }
    },
    { rootMargin: "-30% 0px -60% 0px" }
  );
  sezioni.forEach((s) => oss.observe(s));
</script>
