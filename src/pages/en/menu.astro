---
// Pagina "Notre Carte" (vetrina, non ordinabile).
// Hero: banner con foto + overlay, titolo Marcellus, riga SEO, bottone
// Commander e tricolore. Corpo: una sezione per OGNI categoria del DB
// (ordine dell'admin) — titolo oro a sinistra, piatti su 2 colonne a
// destra con puntini fino al prezzo e descrizione sotto.
// Prezzi scontati (scope "partout"): pieno barrato + prezzo promo.
// Badge piatto: ★ best-seller (oro) · 🌱 végan · 🌶️ épicé.
// Allergeni: numeri UE in apice + legenda a fondo pagina.
import Layout from "../../layouts/Layout.astro";
import { getMenu } from "../../lib/db";
import { getLangFromUrl, useTranslations, getLocalizedUrl } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const en = lang === "en";

const menu = await getMenu();

const HERO_FOTO = "/la-molisana-home-foto-01.webp";

// I 14 allergeni UE — stessi numeri usati dall'admin.
const ALLERGENI: [number, string][] = en
  ? [
      [1, "Gluten"], [2, "Milk"], [3, "Peanuts"], [4, "Eggs"],
      [5, "Fish"], [6, "Crustaceans"], [7, "Soy"], [8, "Tree nuts"],
      [9, "Celery"], [10, "Mustard"], [11, "Sulphites"], [12, "Sesame"],
      [13, "Lupin"], [14, "Molluscs"],
    ]
  : [
      [1, "Gluten"], [2, "Lait"], [3, "Arachides"], [4, "Œufs"],
      [5, "Poisson"], [6, "Crustacés"], [7, "Soja"], [8, "Fruits à coque"],
      [9, "Céleri"], [10, "Moutarde"], [11, "Sulfites"], [12, "Sésame"],
      [13, "Lupin"], [14, "Mollusques"],
    ];

function prezzo(cents: number): string {
  const euro = cents / 100;
  return Number.isInteger(euro) ? `${euro} €` : `${euro.toFixed(2).replace(".", ",")} €`;
}

function descDi(item: { description_fr: string | null; description_en: string | null }): string | null {
  return en ? (item.description_en || item.description_fr) : item.description_fr;
}

// --- Raggruppamenti: più categorie consecutive sotto un unico titolo
// grande, ciascuna col suo titoletto (per range di category_order):
// Pizza = rouges/blanches/calzone/suppléments (4..7)
// Bières = pression/bouteilles (14..15)
// Vins = du patron/rouges/blancs/rosé (16..19)
// Le altre categorie restano sezioni singole.
const RAGGRUPPAMENTI = [
  { title: "Pizza", min: 4, max: 7 },
  { title: en ? "Beers" : "Bières", min: 14, max: 15 },
  { title: en ? "Wines" : "Vins", min: 16, max: 19 },
];
const gruppi: { title: string; subcats: typeof menu }[] = [];
for (const cat of menu) {
  const r = RAGGRUPPAMENTI.find((x) => cat.category_order >= x.min && cat.category_order <= x.max);
  const last = gruppi[gruppi.length - 1];
  if (r && last && last.title === r.title) {
    last.subcats.push(cat);
  } else {
    gruppi.push({ title: r ? r.title : cat.category, subcats: [cat] });
  }
}

// --- Ordine di visualizzazione della carta (richiesta Enzo):
// cibo e desserts nell'ordine dell'admin, poi Apéritifs, Softs,
// Bières, Vins, il resto (Long drinks, Alcools) e Boissons chaudes
// in fondo. Basato sul category_order della prima sottocategoria.
function rango(g: { subcats: typeof menu }): number {
  const o = g.subcats[0].category_order;
  if (o <= 8) return o; // Antipasti..Desserts
  if (o === 11) return 9; // Apéritifs
  if (o === 10) return 10; // Softs
  if (o >= 14 && o <= 15) return 11; // Bières
  if (o >= 16) return 12; // Vins
  if (o === 12) return 13; // Long drinks
  if (o === 13) return 14; // Alcools
  if (o === 9) return 15; // Boissons chaudes
  return 99;
}
gruppi.sort((a, b) => rango(a) - rango(b));

