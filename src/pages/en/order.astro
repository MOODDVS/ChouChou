---
// Pagina "Commander" (ordini take-away online).
// Hero: stesso pattern delle altre pagine (foto + overlay, titolo
// Marcellus, riga SEO, tricolore). Corpo: isola React OrderApp con
// le categorie REALI dell'admin (Pizza e Boissons raggruppate),
// badge ★/🌱/🌶️ + pillola oro "Suggestion" come su Notre Carte,
// prezzi scontati barrati, carrello e checkout Stripe.
import Layout from "../../layouts/Layout.astro";
import OrderApp from "../../components/OrderApp";
import { getMenuOrderable, supabaseAdmin } from "../../lib/db";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";
import { DateTime } from "luxon";
import { configGiornoEffettiva } from "../../lib/schedule";

const lang = getLangFromUrl(Astro.url);
const tr = useTranslations(lang);
const en = lang === "en";

// Ristorante chiuso OGGI (es. martedì, o giorno speciale dell'admin)?
// Il carrello diventa un avviso "fermé aujourd'hui" ben visibile,
// con sotto la prossima riapertura ("Nous serons ouverts demain dès 11:00").
let chiusoOggi = false;
let riapertura = "";
try {
  const cfg = await configGiornoEffettiva(DateTime.now());
  if (cfg) {
    const midi = cfg.lunch_active && cfg.lunch_open && cfg.lunch_close;
    const soir = cfg.dinner_active && cfg.dinner_open && cfg.dinner_close;
    chiusoOggi = !midi && !soir;
  }

  if (chiusoOggi) {
    // Cerca il primo giorno d'apertura nei prossimi 7 (giorni speciali inclusi)
    const oggi = DateTime.now().setZone("Europe/Brussels");
    const hhmm = (t: string | null) => (t ? String(t).slice(0, 5) : "");
    for (let i = 1; i <= 7; i++) {
      const giorno = oggi.plus({ days: i });
      const c = await configGiornoEffettiva(giorno);
      if (!c) continue;
      let ora = "";
      if (c.lunch_active && c.lunch_open && c.lunch_close) ora = hhmm(c.lunch_open);
      else if (c.dinner_active && c.dinner_open && c.dinner_close) ora = hhmm(c.dinner_open);
      if (!ora) continue;
      if (i === 1) {
        riapertura = en
          ? `We'll be open tomorrow from ${ora}`
          : `Nous serons ouverts demain dès ${ora}`;
      } else {
        const nomeGiorno = giorno.setLocale(en ? "en" : "fr").toFormat("cccc");
        riapertura = en
          ? `We'll be open on ${nomeGiorno} from ${ora}`
          : `Nous serons ouverts ${nomeGiorno} dès ${ora}`;
      }
      break;
    }
  }
} catch {
  // in dubbio niente avviso: lo slot picker segnala comunque l'assenza di orari
}

// Servizio chiuso dall'admin? (bottone "Fermer" nella pagina Commandes)
let ordiniChiusi = false;
try {
  const { data } = await supabaseAdmin
    .from("app_config")
    .select("value")
    .eq("key", "orders_closed")
    .maybeSingle();
  ordiniChiusi = data?.value === "1";
} catch {
  // in dubbio il servizio resta aperto: il checkout ricontrolla comunque
}

// Solo piatti ordinabili in take-away (available = true AND orderable = true).
const menu = ordiniChiusi ? [] : await getMenuOrderable();

const HERO_FOTO = "/slideshow/slide-02.webp";

// Stringhe tradotte passate all'isola React.
const orderStrings = {
  cartTitle: tr("order.cartTitle"),
  cartEmpty: tr("order.cartEmpty"),
  recap: tr("order.recap"),
  yourInfo: tr("order.yourInfo"),
  pickupTime: tr("order.pickupTime"),
  notes: tr("order.notes"),
  notesPlaceholder: tr("order.notesPlaceholder"),
  coupon: tr("order.coupon"),
  couponPlaceholder: tr("order.couponPlaceholder"),
  couponApply: tr("order.couponApply"),
  couponRemove: tr("order.couponRemove"),
  couponInvalid: tr("order.couponInvalid"),
  subtotal: tr("order.subtotal"),
  discount: tr("order.discount"),
  total: tr("order.total"),
  items: tr("order.items"),
  toCheckout: tr("order.toCheckout"),
  pay: tr("order.pay"),
  paying: tr("order.paying"),
  backToMenu: tr("order.backToMenu"),
  seeCart: tr("order.seeCart"),
  fillAll: tr("order.fillAll"),
  errPayment: tr("order.errPayment"),
  errConnection: tr("order.errConnection"),
  firstName: tr("book.firstName"),
  lastName: tr("book.lastName"),
  phone: tr("book.phone"),
  email: tr("book.email"),
  ariaIncrease: tr("order.aria.increase"),
  ariaDecrease: tr("order.aria.decrease"),
  ariaRemove: tr("order.aria.remove"),
  ariaAdd: tr("order.aria.add"),
  tabBoissons: en ? "Drinks" : "Boissons",
  closedToday: en ? "We're closed today" : "On est fermé aujourd'hui",
  reopenInfo: riapertura,
  consentPre: tr("contact.consentPre"),
  consentLink: tr("contact.consentLink"),
  privacyHref: en ? "/en/privacy" : "/privacy",
};
---

<Layout title={en ? "Order online, Comptoir Chouchou" : "Commander en ligne, Comptoir Chouchou"}>
  <section class="order-hero">
    <img class="order-hero__bg" src={HERO_FOTO} alt="" loading="eager" fetchpriority="high" decoding="async" />
    <div class="order-hero__overlay" aria-hidden="true"></div>

    <div class="order-hero__inner">
      <h1 class="order-hero__title">{en ? "Order online" : "Commander en ligne"}</h1>
      <p class="order-hero__sub">
        {en
          ? "Take-away order from Comptoir Chouchou, freshly prepared, ready at your chosen time, in Mont-Saint-Guibert."
          : "Commande à emporter au Comptoir Chouchou, préparée fraîche, prête à l'heure choisie, à Mont-Saint-Guibert."}
      </p>
    </div>

    <div class="order-hero__flag" aria-hidden="true"></div>
  </section>

  {ordiniChiusi ? (
    <section class="order-closed">
      <h2 class="order-closed__title">
        {en ? "Online ordering is temporarily closed" : "Les commandes en ligne sont momentanément fermées"}
      </h2>
      <p class="order-closed__text">
        {en
          ? "Please come back later, or call us:"
          : "Revenez un peu plus tard, ou appelez-nous :"}
      </p>
      <a class="order-closed__phone" href="tel:+32455131465">+32 455 13 14 65</a>
    </section>
  ) : (
    <OrderApp menu={menu} t={orderStrings} lang={lang} closedToday={chiusoOggi} client:load />
  )}
</Layout>

<style>
  /* ---------- HERO (stesso pattern di Notre Carte) ---------- */
  .order-hero {
    position: relative;
    min-height: clamp(260px, 32vh, 380px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3.5rem 1.5rem 4rem;
    overflow: hidden;
  }

  .order-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .order-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.55);
  }

  .order-hero__inner {
    position: relative;
    z-index: 2;
  }

  .order-hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin: 0 0 0.9rem;
    color: var(--c-text);
    opacity: 0;
    transform: translateY(18px);
    animation: order-in 0.8s ease-out 0.15s forwards;
  }

  .order-hero__sub {
    max-width: 560px;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    opacity: 0;
    transform: translateY(18px);
    animation: order-in 0.8s ease-out 0.3s forwards;
  }

  .order-hero__flag {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    z-index: 2;
    background: linear-gradient(
      90deg,
      #007153 0%, #007153 33.333%,
      #ffffff 33.333%, #ffffff 66.666%,
      #ed1c24 66.666%, #ed1c24 100%
    );
  }

  @keyframes order-in {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .order-hero__title,
    .order-hero__sub {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- SERVIZIO CHIUSO (bottone "Fermer" dell'admin) ---------- */
  .order-closed {
    max-width: 640px;
    margin: 0 auto;
    padding: 6rem 1.5rem 8rem;
    text-align: center;
  }
  .order-closed__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    line-height: 1.25;
    color: var(--c-accent);
    margin: 0 0 1rem;
  }
  .order-closed__text {
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--c-muted);
    margin: 0 0 1.6rem;
  }
  .order-closed__phone {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
    text-decoration: none;
    border: 2px solid rgba(255, 255, 255, 0.9);
    padding: 12px 30px;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .order-closed__phone:hover {
    background: #fff;
    color: var(--c-bg);
    transform: scale(0.96);
  }
</style>

<style is:global>
  /* Altezza header per ancorare gli sticky: 76px + 1px di bordo su
     desktop, 72px + 1px su mobile (misure reali di Header.astro). */
  :root { --hdr-h: 77px; }

  .order-wrap { width: 100%; }

  /* ---- Barra filtri full-width, sticky sotto l'header ---- */
  .order-filterbar {
    position: sticky;
    top: var(--hdr-h);
    z-index: 40;
    width: 100%;
    /* Leggermente più scura del fondo pagina per staccarsi dall'header */
    background: #1c1819;
    border-bottom: 1px solid var(--c-line);
  }
  .order-filterbar-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    display: flex;
    gap: 0.6rem;
    padding: 1rem 1.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .order-filterbar-inner::-webkit-scrollbar { display: none; }
  .order-tab {
    flex: 0 0 auto;
    white-space: nowrap;
    padding: 0.5rem 1.15rem;
    border: 1px solid var(--c-line);
    background: transparent;
    color: var(--c-muted);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .order-tab:hover {
    border-color: var(--c-accent);
    color: var(--c-text);
  }
  .order-tab.is-active {
    background: var(--c-accent);
    color: var(--c-bg);
    border-color: var(--c-accent);
  }
  .order-tab.is-active:hover { color: var(--c-bg); }

  /* ---- Layout due colonne: menu lungo + carrello ---- */
  .order-app {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 2.5rem;
    align-items: start;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  /* ---- Sezioni del menu ---- */
  .order-sec {
    scroll-margin-top: calc(var(--hdr-h) + 70px);
    margin-bottom: 3.5rem;
  }
  .order-sec-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 3.4vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    margin: 0 0 1.6rem;
    color: var(--c-accent);
  }

  /* Sotto-categorie (Pizzas rouges/blanches…, Softs, Bières…) */
  .order-subcat { margin-bottom: 2.2rem; }
  .order-subcat:last-child { margin-bottom: 0; }
  .order-subcat-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin: 0 0 0.6rem;
  }

  .order-items { display: flex; flex-direction: column; }
  .order-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--c-line);
  }
  .order-item-info { flex: 1; }
  .order-item-name {
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
    color: var(--c-text);
  }

  /* Badge piatto: come su Notre Carte */
  .order-b { font-size: 0.85rem; margin-left: 0.3rem; font-weight: 400; }
  .order-b-star { color: var(--c-accent); }
  .order-sugg {
    display: inline-block;
    background: var(--c-accent);
    color: var(--c-bg);
    font-family: var(--font-body);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    margin-left: 0.45rem;
    vertical-align: 2px;
    white-space: nowrap;
  }

  .order-item-desc {
    margin: 0 0 0.4rem;
    font-size: 0.88rem;
    color: var(--c-muted);
    line-height: 1.5;
  }
  .order-item-price {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--c-text);
  }
  .order-item-old {
    color: rgba(255, 255, 255, 0.55);
    margin-right: 0.45rem;
    font-size: 0.95rem;
    font-weight: 400;
  }

  .order-item-add {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border: none;
    background: var(--c-accent);
    color: var(--c-bg);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 999px;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .order-item-add:hover {
    background: #fff;
    color: var(--c-bg);
    transform: scale(0.94);
  }

  /* ---- Carrello laterale ---- */
  .order-cart {
    position: sticky;
    top: calc(var(--hdr-h) + 80px);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--c-line);
    border-radius: 14px;
    padding: 1.5rem;
  }
  .order-cart-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    margin: 0 0 1.3rem;
    color: var(--c-accent);
  }
  .order-cart-empty { color: var(--c-muted); }

  /* Ristorante chiuso oggi: il carrello diventa l'avviso rosso
     (fondo rosso trasparente, bordo rosso pieno, testo centrato + icona) */
  .order-cart--ferme {
    background: transparent;
    border: none;
    padding: 0;
  }
  .order-ferme {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    background: rgba(237, 28, 36, 0.18);
    border: 1px solid #ed1c24;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.35;
    text-align: center;
    padding: 1.4rem 1.2rem;
    border-radius: 10px;
  }
  .order-ferme-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }
  .order-ferme svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    fill: none;
    stroke: #ed1c24;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .order-ferme-sub {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .order-cart-lines { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .order-cart-line { border-bottom: 1px solid var(--c-line); padding-bottom: 1rem; }
  .order-cart-line-top { display: flex; justify-content: space-between; gap: 0.8rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--c-text); }
  .order-cart-line-controls { display: flex; align-items: center; gap: 0.5rem; }
  .order-cart-line-controls button {
    width: 30px; height: 30px;
    border: 1px solid var(--c-line);
    background: transparent;
    color: var(--c-text);
    cursor: pointer;
    font-size: 1.1rem;
    border-radius: 8px;
    transition: border-color 0.2s ease;
  }
  .order-cart-line-controls button:hover { border-color: var(--c-accent); }
  .order-cart-qty { min-width: 22px; text-align: center; color: var(--c-text); }
  /* Cestino con conferma in 2 tap, come nell'admin */
  .order-cart-remove {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(237, 28, 36, 0.25) !important;
    border: 1px solid rgba(237, 28, 36, 0.35) !important;
    color: #fff !important;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .order-cart-remove:hover {
    background: rgba(237, 28, 36, 0.55) !important;
    border-color: #ed1c24 !important;
  }
  .order-cart-remove svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .order-cart-remove.confirm {
    width: auto !important;
    padding: 0 0.7rem;
    background: #a3320f !important;
    border-color: #a3320f !important;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.75rem !important;
    white-space: nowrap;
  }
  .order-cart-total {
    display: flex; justify-content: space-between; align-items: baseline;
    margin: 1.2rem 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    color: var(--c-text);
  }
  .order-cart-total strong { font-size: 1.5rem; font-weight: 400; }
  .order-cart-checkout {
    width: 100%;
    padding: 0.95rem;
    background: var(--c-accent);
    color: var(--c-bg);
    border: none;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 10px;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .order-cart-checkout:hover:not(:disabled) {
    background: #fff;
    color: var(--c-bg);
    transform: scale(0.97);
  }
  .order-cart-checkout:disabled { opacity: 0.5; cursor: not-allowed; }
  .order-cart-note { font-size: 0.78rem; color: var(--c-muted); text-align: center; margin: 0.6rem 0 0; }
  .order-cart-error { color: #ff6b6b; font-size: 0.85rem; margin: 0.6rem 0 0; }

  /* ---- Nota ordine (checkout) ---- */
  .order-note { margin-top: 2rem; }
  .order-note-field {
    width: 100%;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: var(--c-text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.5;
    padding: 0.85rem 1rem;
    border-radius: 0;
    resize: vertical;
    transition: border-color 0.2s;
  }
  .order-note-field::placeholder { color: var(--c-muted); }
  .order-note-field:focus { outline: none; border-color: var(--c-accent); }

  /* ---- Checkout ---- */
  .order-section-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 0 0 1.5rem;
    color: var(--c-accent);
  }
  .order-field-label {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    color: var(--c-text);
    margin: 0 0 0.6rem;
  }
  .order-form { display: flex; flex-direction: column; gap: 0.8rem; margin: 1.3rem 0; }
  .order-input {
    width: 100%;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: var(--c-text);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0;
    transition: border-color 0.2s;
  }
  .order-input::placeholder { color: var(--c-muted); }
  .order-input:focus { outline: none; border-color: var(--c-accent); }
  .order-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0 0 1rem;
    color: var(--c-muted);
    font-size: 0.9rem;
    line-height: 1.45;
    cursor: pointer;
  }
  .order-consent input {
    width: 18px; height: 18px; margin: 0.15rem 0 0;
    flex-shrink: 0; accent-color: var(--c-accent); cursor: pointer;
  }
  .order-consent a { color: var(--c-text); text-decoration: underline; text-underline-offset: 2px; }
  .order-consent a:hover { color: var(--c-accent); }

  /* Campo code promo + applicazione */
  .order-coupon { margin: 0 0 1rem; }
  .order-coupon-row { display: flex; gap: 0.5rem; }
  .order-coupon-row .order-input { flex: 1; }
  .order-coupon-apply {
    flex: 0 0 auto;
    padding: 0 1.1rem;
    background: transparent;
    border: 1px solid var(--c-accent);
    color: var(--c-accent);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
