---
// Pagina mostrata quando il cliente annulla il pagamento su Stripe.
// Nessun ordine da confermare: l'eventuale record pending resta nel DB
// (non verrà mai confermato dal webhook). Il carrello in sessione resta,
// così l'utente può riprovare senza ricomporre l'ordine.
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations, getLocalizedUrl } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("cancel.title") + " — La Molisana"}>
  <section class="oc">
    <div class="oc-card">
      <p class="oc-claim">La Molisana — Pizza &amp; Pasta</p>
      <h1 class="oc-title">{t("cancel.title")}</h1>
      <p class="oc-sub">{t("cancel.text")}</p>

      <div class="oc-actions">
        <a href={getLocalizedUrl("/order", lang)} class="oc-btn oc-btn-solid">{t("cancel.retry")}</a>
        <a href={getLocalizedUrl("/", lang)} class="oc-btn oc-btn-outline">{t("cancel.home")}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .oc {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 5rem 1.5rem;
    display: flex;
    justify-content: center;
  }
  .oc-card {
    width: 100%;
    max-width: 560px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--c-line);
    border-radius: 14px;
    padding: 2.5rem 2rem;
    text-align: center;
  }
  .oc-claim {
    font-family: var(--font-display);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--c-accent);
    margin: 0 0 1rem;
  }
  .oc-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 5.5vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 1rem;
    color: var(--c-text);
  }
  .oc-sub {
    font-family: var(--font-body);
    color: var(--c-muted);
    line-height: 1.6;
    margin: 0 auto 1.5rem;
    max-width: 420px;
  }
  .oc-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .oc-btn {
    display: inline-block;
    padding: 0.9rem 1.2rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 10px;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .oc-btn:hover { transform: scale(0.97); }
  .oc-btn-solid {
    background: var(--c-accent);
    color: var(--c-bg);
    border: 1px solid var(--c-accent);
  }
  .oc-btn-solid:hover { background: #fff; border-color: #fff; color: var(--c-bg); }
  .oc-btn-outline {
    background: transparent;
    color: var(--c-text);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }
  .oc-btn-outline:hover { background: #fff; border-color: #fff; color: var(--c-bg); }
</style>
