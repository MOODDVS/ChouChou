---
// Grocery page (EN) — provisoire. Voir la version FR /epicerie.
import Layout from "../../layouts/Layout.astro";
export const prerender = false;
---

<Layout title="Grocery, Comptoir Chouchou">
  <section class="ph">
    <div class="ph-glow"></div>
    <div class="ph-in">
      <p class="ph-script">Comptoir</p>
      <h1 class="ph-title">The grocery</h1>
      <p class="ph-sub">
        A selection of local artisan and producer goods to take away.
        This page is coming very soon.
      </p>
      <a class="ph-btn" href="/en/">Back to home</a>
    </div>
  </section>
</Layout>

<style>
  .ph {
    --navy: #353c4e;
    --mag: #ed2289;
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background: radial-gradient(120% 100% at 50% 0%, #3d4458 0%, #2b3040 55%, #23283a 100%);
    padding: 8rem 1.5rem 6rem;
  }
  .ph-glow {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 640px;
    height: 640px;
    max-width: 120vw;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(237, 34, 137, 0.2) 0%, rgba(237, 34, 137, 0) 62%);
    pointer-events: none;
  }
  .ph-in { position: relative; z-index: 1; max-width: 640px; }
  .ph-script {
    font-family: var(--font-script);
    color: var(--mag);
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 0.9;
    margin: 0 0 0.1em;
  }
  .ph-title {
    font-family: var(--font-display);
    font-weight: 500;
    color: #fff;
    font-size: clamp(2.4rem, 7vw, 4rem);
    line-height: 1;
    margin: 0;
  }
  .ph-sub {
    font-family: var(--font-body);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1rem, 2.2vw, 1.18rem);
    line-height: 1.6;
    margin: 1.4rem auto 0;
    max-width: 30em;
  }
  .ph-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 2.2rem;
    padding: 14px 32px;
    font-family: var(--font-body);
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.6);
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }
  .ph-btn:hover { background: #fff; color: var(--navy); transform: translateY(-2px); }
</style>
