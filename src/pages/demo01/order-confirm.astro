---
// Conferma ordine per il TEMPLATE demo01 — usa Demo01Layout (header + footer
// stile demo01). Marchio e dati dal motore. success_url impostato in stripe.ts
// (returnBase "/demo01") quando l'ordine parte da demo01.
import Demo01Layout from "../../layouts/Demo01Layout.astro";
import { supabaseAdmin } from "../../lib/db";
import { CLIENT } from "../../config/client";

export const prerender = false;

const url = Astro.url;
const langParam = (url.searchParams.get("lang") || "fr").toLowerCase();
const lang = ["fr", "en", "it"].includes(langParam) ? langParam : "fr";
const sessionId = url.searchParams.get("session_id");

const { data: cfgBrand } = await supabaseAdmin.from("app_config").select("value").eq("key", "restaurant_name").maybeSingle();
const brand = String(cfgBrand?.value ?? "").trim() || CLIENT.nome;

interface Ordine {
  id: string;
  status: string;
  pickup_time: string;
  customer_name: string;
  items: { name: string; qty: number; price_cents: number; notes?: string }[];
  total_cents: number;
}
let ordine: Ordine | null = null;
if (sessionId) {
  const { data } = await supabaseAdmin
    .from("orders")
    .select("id, status, pickup_time, customer_name, items, total_cents")
    .eq("stripe_session_id", sessionId)
    .maybeSingle();
  ordine = data as Ordine | null;
}
const euro = (c: number): string => (c / 100).toFixed(2).replace(".", ",") + " €";
const oraRitiro = (iso: string): string =>
  new Date(iso).toLocaleTimeString(lang === "it" ? "it-IT" : lang === "en" ? "en-GB" : "fr-FR", {
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "Europe/Brussels",
  });
const numero = ordine ? ordine.id.slice(0, 8) : null;
const confermato = ordine?.status === "paid";
const voci = ordine ? ordine.items.filter((i) => i.qty > 0) : [];
const noteCliente = ordine ? ordine.items.find((i) => i.qty === 0 && i.notes)?.notes ?? null : null;

const T: Record<string, Record<string, string>> = {
  fr: { title: "Commande confirmée", pending: "Paiement en cours de validation", notfound: "Commande introuvable", notfoundsub: "Nous n'avons pas trouvé cette commande. Contactez-nous si besoin.", pendingsub: "Votre paiement est en cours de validation. Vous recevrez un email de confirmation.", pickup: "Retrait prévu à", total: "Total", notes: "Note", home: "← Retour au site" },
  en: { title: "Order confirmed", pending: "Payment being validated", notfound: "Order not found", notfoundsub: "We couldn't find this order. Contact us if needed.", pendingsub: "Your payment is being validated. You'll receive a confirmation email.", pickup: "Pickup at", total: "Total", notes: "Note", home: "← Back to site" },
  it: { title: "Ordine confermato", pending: "Pagamento in convalida", notfound: "Ordine non trovato", notfoundsub: "Non abbiamo trovato questo ordine. Contattaci se necessario.", pendingsub: "Il pagamento è in fase di convalida. Riceverai un'email di conferma.", pickup: "Ritiro previsto alle", total: "Totale", notes: "Nota", home: "← Torna al sito" },
};
const tr = T[lang];
const paidText = ordine
  ? lang === "it"
    ? `Grazie ${ordine.customer_name}. Il tuo ordine #${numero} è stato ricevuto.`
    : lang === "en"
      ? `Thank you ${ordine.customer_name}. Your order #${numero} has been received.`
      : `Merci ${ordine.customer_name}. Votre commande #${numero} a bien été reçue.`
  : "";
---
<Demo01Layout title={`${tr.title} — ${brand}`} lang={lang}>
  <section class="oc">
    <div class="card">
      {!ordine && (<><h1>{tr.notfound}</h1><p class="sub">{tr.notfoundsub}</p></>)}
      {ordine && confermato && (
        <>
          <p class="eye">{brand}</p>
          <h1>{tr.title}</h1>
          <p class="sub">{paidText}</p>
          <div class="pickup"><span class="lab">{tr.pickup}</span><span class="time">{oraRitiro(ordine.pickup_time)}</span></div>
          <ul>{voci.map((i) => (<li><span>{i.qty}× {i.name}</span><span>{euro(i.price_cents * i.qty)}</span></li>))}</ul>
          {noteCliente && (<p class="note"><strong>{tr.notes} :</strong> {noteCliente}</p>)}
          <div class="total"><span>{tr.total}</span><strong>{euro(ordine.total_cents)}</strong></div>
        </>
      )}
      {ordine && !confermato && (<><h1>{tr.pending}</h1><p class="sub">{tr.pendingsub}</p></>)}
      <a class="home" href="/demo01">{tr.home}</a>
    </div>
  </section>
  <script is:inline>
    try { window.sessionStorage.removeItem("lm-order-cart"); } catch (e) {}
  </script>
</Demo01Layout>

<style>
  .oc { max-width: 640px; margin: 0 auto; padding: 4rem 1.2rem 5rem; }
  .card { width: 100%; background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 2.6rem 2.1rem; text-align: center; }
  .eye { font-family: var(--disp); letter-spacing: .3em; text-transform: uppercase; font-size: .72rem; color: var(--accent); margin-bottom: 1rem; }
  h1 { font-family: var(--disp); font-weight: 400; font-size: clamp(1.9rem, 5.5vw, 2.6rem); line-height: 1.15; margin-bottom: 1rem; }
  .sub { color: var(--muted); line-height: 1.6; margin-bottom: 1.6rem; }
  .pickup { display: flex; flex-direction: column; gap: .25rem; border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem; margin: 1.5rem 0; }
  .pickup .lab { font-size: .78rem; color: var(--muted); letter-spacing: .08em; text-transform: uppercase; }
  .pickup .time { font-family: "Bebas Neue", var(--disp); font-size: 2.4rem; color: var(--accent); letter-spacing: .04em; }
  ul { list-style: none; margin: 1.5rem 0 0; text-align: left; border-top: 1px solid var(--line); }
  li { display: flex; justify-content: space-between; gap: 1rem; padding: .75rem 0; border-bottom: 1px solid var(--line); }
  .note { text-align: left; color: var(--muted); font-size: .9rem; margin-top: 1rem; }
  .total { display: flex; justify-content: space-between; align-items: baseline; margin-top: 1.1rem; font-family: var(--disp); font-size: 1.2rem; }
  .total strong { font-size: 1.6rem; font-weight: 400; color: var(--accent); }
  .home { display: inline-block; margin-top: 2rem; color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--line); transition: color .2s, border-color .2s; }
  .home:hover { color: var(--accent); border-color: var(--accent); }
</style>
