---
// Pagina PUBBLICA di prenotazione/modifica per il TEMPLATE demo01
// (URL /demo01/reservation). Stesso ReservationWidget reale con la palette
// demo01 (nero/rosso), dentro Demo01Layout (header + footer del sito). Il
// widget legge ?token= dalla URL per entrare in modalità modifica: è la
// pagina puntata dal bottone "Modifier" nelle email di prenotazione.
import Demo01Layout from "../../layouts/Demo01Layout.astro";
import ReservationWidget from "../../components/ReservationWidget.astro";
import { CLIENT } from "../../config/client";
import { datiRistorante } from "../../lib/ristorante";

export const prerender = false;

const url = Astro.url;
const langParam = (url.searchParams.get("lang") || "fr").toLowerCase();
const lang = ["fr", "en", "it"].includes(langParam) ? langParam : "fr";

let telWidget = CLIENT.telefono;
try {
  const dati = await datiRistorante();
  if (dati.tel) telWidget = dati.tel;
} catch { /* fallback config */ }
---
<Demo01Layout title={`Réservation — ${CLIENT.nome}`} lang={lang}>
  <section class="rh-resa">
    <div class="wrap">
      <ReservationWidget telWidget={telWidget} inPage />
    </div>
  </section>
  <style is:global>
    :root {
      --rw-bg: #161616;
      --rw-bg2: #0e0e0e;
      --rw-line: rgba(247, 241, 230, 0.14);
      --rw-accent: #e23b2e;
      --rw-muted: #a49a8e;
      --rw-panel: #191919;
      --rw-hover: #211a1a;
    }
    .rh-resa { padding: 3rem 0 4.5rem; }
    .rh-resa .rw-claim { display: none !important; }
  </style>
</Demo01Layout>
