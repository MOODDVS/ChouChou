---
// Annullamento ordine per il TEMPLATE demo01 — usa Demo01Layout (header/footer).
import Demo01Layout from "../../layouts/Demo01Layout.astro";
import { supabaseAdmin } from "../../lib/db";
import { CLIENT } from "../../config/client";

export const prerender = false;

const url = Astro.url;
const langParam = (url.searchParams.get("lang") || "fr").toLowerCase();
const lang = ["fr", "en", "it"].includes(langParam) ? langParam : "fr";

const { data: cfgBrand } = await supabaseAdmin.from("app_config").select("value").eq("key", "restaurant_name").maybeSingle();
const brand = String(cfgBrand?.value ?? "").trim() || CLIENT.nome;

const T: Record<string, Record<string, string>> = {
  fr: { title: "Commande annulée", sub: "Votre paiement a été annulé. Aucun montant n'a été prélevé. Vous pouvez recommencer quand vous voulez.", home: "← Retour au site" },
  en: { title: "Order cancelled", sub: "Your payment was cancelled. No charge was made. You can start again whenever you like.", home: "← Back to site" },
  it: { title: "Ordine annullato", sub: "Il pagamento è stato annullato. Nessun importo è stato addebitato. Puoi ricominciare quando vuoi.", home: "← Torna al sito" },
};
const tr = T[lang];
---
<Demo01Layout title={`${tr.title} — ${brand}`} lang={lang}>
  <section class="oc">
    <div class="card">
      <p class="eye">{brand}</p>
      <h1>{tr.title}</h1>
      <p class="sub">{tr.sub}</p>
      <a class="home" href="/demo01">{tr.home}</a>
    </div>
  </section>
</Demo01Layout>

<style>
  .oc { max-width: 560px; margin: 0 auto; padding: 4.5rem 1.2rem 5.5rem; }
  .card { width: 100%; background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 2.6rem 2.1rem; text-align: center; }
  .eye { font-family: var(--disp); letter-spacing: .3em; text-transform: uppercase; font-size: .72rem; color: var(--accent); margin-bottom: 1rem; }
  h1 { font-family: var(--disp); font-weight: 400; font-size: clamp(1.9rem, 5.5vw, 2.6rem); line-height: 1.15; margin-bottom: 1rem; }
  .sub { color: var(--muted); line-height: 1.6; }
  .home { display: inline-block; margin-top: 2rem; color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--line); transition: color .2s, border-color .2s; }
  .home:hover { color: var(--accent); border-color: var(--accent); }
</style>
