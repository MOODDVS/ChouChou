---
import { CLIENT } from "../config/client";
// Pagina "Links" — destinazione del QR code (sul tavolo, in vetrina…).
// Solo l'essenziale: bottoni impilati (Réserver, Commander, Notre Carte,
// avis Google se impostato nell'admin) e i social sotto.
// Header e footer normali del sito.
import Layout from "../layouts/Layout.astro";
import { linksSocial, linkGoogleReview } from "../lib/links";

const social = await linksSocial();
const googleReview = await linkGoogleReview();
---

<Layout title={`Links — ${CLIENT.nome}`}>
  <section class="lnk">
    <h1 class="lnk-title">{CLIENT.nome}</h1>
    <p class="lnk-sub">{CLIENT.claim}</p>

    <div class="lnk-btns">
      <button type="button" class="lnk-btn" data-reserver>Réserver</button>
      <a href="/order" class="lnk-btn">Commander</a>
      <a href="/menu" class="lnk-btn">Notre Carte</a>
      {googleReview && (
        <a href={googleReview} target="_blank" rel="noopener" class="lnk-btn">
          Laisser un avis Google
        </a>
      )}
    </div>

    {social.length > 0 && (
      <div class="lnk-social">
        {social.map((s) => (
          <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} set:html={s.icon} />
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .lnk {
    max-width: 420px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
    text-align: center;
  }
  .lnk-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 6vw, 2.6rem);
    line-height: 1.1;
    margin: 0 0 0.4rem;
    color: var(--c-text);
  }
  .lnk-sub {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin: 0 0 2.5rem;
  }

  .lnk-btns {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .lnk-btn {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 1.05rem 1.2rem;
    background: var(--c-accent);
    color: var(--c-bg);
    border: none;
    border-radius: 10px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .lnk-btn:hover {
    background: #fff;
    color: var(--c-bg);
    transform: scale(0.97);
  }

  .lnk-social {
    display: flex;
    justify-content: center;
    gap: 1.4rem;
    margin-top: 2.5rem;
  }
  .lnk-social a {
    color: var(--c-text);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .lnk-social a:hover {
    color: var(--c-accent);
    transform: scale(1.08);
  }
  .lnk-social a :global(svg) {
    width: 26px;
    height: 26px;
    display: block;
  }
</style>
