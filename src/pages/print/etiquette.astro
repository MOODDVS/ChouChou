---
// PAGINA /print/etiquette — sticker 5x5 cm (sito pubblico).
// Mostra e fa scaricare ESATTAMENTE il PDF fornito dal cliente
// (public/print/etiquette-5x5.pdf), senza riprodurlo.
// Per l'admin (Stampa): /admin/super → Print, route /print/etiquette.
// SOLO SITO PUBBLICO — nessun file del motore RH toccato.
export const prerender = false;
const PDF = "/print/etiquette-5x5.pdf";
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Comptoir Chouchou — Étiquette 5×5 (PDF)</title>
  <style>
    html,body{margin:0;height:100%;background:#e7e5e0;}
    .pdf{position:fixed;inset:0;width:100%;height:100%;border:0;}
    .dl-btn{position:fixed;right:20px;bottom:20px;z-index:9;text-decoration:none;
      background:#ed2289;color:#fff;font-family:"Quicksand",system-ui,sans-serif;font-weight:700;
      font-size:15px;padding:13px 22px;border-radius:999px;box-shadow:0 8px 24px rgba(237,34,137,.4);}
    @media print{ .dl-btn{display:none !important;} }
  </style>
</head>
<body>
  <object class="pdf" data={PDF} type="application/pdf">
    <iframe class="pdf" src={PDF} title="Étiquette 5×5"></iframe>
  </object>
  <a class="dl-btn" href={PDF} download="etiquette-chouchou-5x5.pdf">⬇  Télécharger le PDF</a>
</body>
</html>
