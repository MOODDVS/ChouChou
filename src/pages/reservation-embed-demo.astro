---
// Variante DEMO del widget di prenotazione, usata SOLO nell'iframe della
// pagina /demo. È lo STESSO ReservationWidget reale, ma con la palette del
// sito demo (nero / rosso / verde) applicata tramite le variabili CSS --rw-*
// (i cui default restano l'oro/scuro originale per tutti gli altri usi).
// NON tocca /reservation-embed, che i clienti reali continuano a usare.
import ReservationWidget from "../components/ReservationWidget.astro";
import { CLIENT } from "../config/client";
import { datiRistorante } from "../lib/ristorante";

export const prerender = false;

let telWidget = CLIENT.telefono;
try {
  const dati = await datiRistorante();
  if (dati.tel) telWidget = dati.tel;
} catch { /* fallback config */ }
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Réservation — démo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Marcellus&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --font-body: "Nunito Sans", system-ui, sans-serif;
        /* Palette DEMO — coerente col sito pizzeria (nero / rosso / verde). */
        --rw-bg: #161616;
        --rw-bg2: #0e0e0e;
        --rw-line: rgba(247, 241, 230, 0.14);
        --rw-accent: #e23b2e;
        --rw-muted: #a49a8e;
        --rw-panel: #191919;
        --rw-hover: #211a1a;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: transparent; color: #fff; font-family: var(--font-body); }
      /* Niente 100vh né padding: l'iframe si adatta all'altezza reale del widget. */
      .page { min-height: 0 !important; padding: 0 !important; }
      .rw { border: none !important; }
      /* Nasconde il claim col nome ristorante (in demo = "Nouveau Restaurant"). */
      .rw-claim { display: none !important; }
    </style>
  </head>
  <body>
    <ReservationWidget telWidget={telWidget} />
    <script is:inline>
      // Comunica l'altezza reale alla pagina /demo così l'iframe si ridimensiona
      // e non resta spazio vuoto. Stessa origine → nessun problema di sicurezza.
      function rhPost() {
        try { parent.postMessage({ rhDemoHeight: document.body.scrollHeight }, "*"); } catch (e) {}
      }
      window.addEventListener("load", rhPost);
      if (window.ResizeObserver) new ResizeObserver(rhPost).observe(document.body);
      setInterval(rhPost, 1000);
    </script>
  </body>
</html>
