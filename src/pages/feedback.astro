---
// Pagina feedback privato (gating recensioni). Aperta dalle stelle 1-3
// dell'email recensione: raccoglie una nota e la invia SOLO al ristorante.
// Theme-driven (admin_theme) e nella lingua del cliente (fr/en/it/nl/es).
import { temaEmail } from "../lib/temaBrand";
import { datiRistorante } from "../lib/ristorante";

const url = Astro.url;
const rParam = Math.round(Number(url.searchParams.get("r")));
const rating = Number.isFinite(rParam) && rParam >= 1 && rParam <= 5 ? rParam : 3;
const order = (url.searchParams.get("o") ?? "").slice(0, 40);
const name = (url.searchParams.get("name") ?? "").slice(0, 200);
const email = (url.searchParams.get("email") ?? "").slice(0, 200);
const phone = (url.searchParams.get("phone") ?? "").slice(0, 60);
const LANGS = ["fr", "en", "it", "nl", "es"];
const langRaw = (url.searchParams.get("lang") ?? "fr").toLowerCase();
const lang = LANGS.includes(langRaw) ? langRaw : "fr";

const tema = await temaEmail();
const dati = await datiRistorante();
const logo = (tema.isDark ? dati.logoNeg || dati.logoPos : dati.logoPos || dati.logoNeg) || dati.logo || "";

type Str = { title: string; sub: string; ph: string; contactPh: string; send: string; sending: string; thanksT: string; thanksS: string; rate: string; needMsg: string; err: string };
const T: Record<string, Str> = {
  fr: { title: "Comment pouvons-nous nous améliorer ?", sub: "Désolés que l'expérience n'ait pas été parfaite. Votre retour arrive uniquement au restaurant et nous aide à faire mieux.", ph: "Dites-nous ce qui n'a pas fonctionné…", contactPh: "Votre email ou téléphone (facultatif)", send: "Envoyer mon avis", sending: "Envoi…", thanksT: "Merci pour votre retour", thanksS: "Nous en tenons compte pour nous améliorer.", rate: "Votre note", needMsg: "Merci d'écrire un petit message.", err: "Envoi impossible, réessayez." },
  en: { title: "How can we do better?", sub: "Sorry your experience wasn't perfect. Your feedback goes only to the restaurant and helps us improve.", ph: "Tell us what went wrong…", contactPh: "Your email or phone (optional)", send: "Send my feedback", sending: "Sending…", thanksT: "Thanks for your feedback", thanksS: "We'll use it to do better.", rate: "Your rating", needMsg: "Please write a short message.", err: "Couldn't send, please retry." },
  it: { title: "Come possiamo migliorare?", sub: "Ci dispiace non sia stata un'esperienza perfetta. Il tuo riscontro arriva solo al ristorante e ci aiuta a fare meglio.", ph: "Raccontaci cosa non ha funzionato…", contactPh: "La tua email o telefono (facoltativo)", send: "Invia il feedback", sending: "Invio…", thanksT: "Grazie per il tuo feedback", thanksS: "Ne teniamo conto per migliorare.", rate: "La tua valutazione", needMsg: "Scrivi un breve messaggio.", err: "Invio non riuscito, riprova." },
  nl: { title: "Hoe kunnen we het beter doen?", sub: "Sorry dat je ervaring niet perfect was. Je feedback gaat alleen naar het restaurant en helpt ons te verbeteren.", ph: "Vertel ons wat er misging…", contactPh: "Je e-mail of telefoon (optioneel)", send: "Feedback versturen", sending: "Versturen…", thanksT: "Bedankt voor je feedback", thanksS: "We gebruiken het om beter te worden.", rate: "Jouw beoordeling", needMsg: "Schrijf een kort bericht.", err: "Versturen mislukt, probeer opnieuw." },
  es: { title: "¿Cómo podemos mejorar?", sub: "Sentimos que la experiencia no haya sido perfecta. Tu comentario llega solo al restaurante y nos ayuda a mejorar.", ph: "Cuéntanos qué no funcionó…", contactPh: "Tu email o teléfono (opcional)", send: "Enviar mi opinión", sending: "Enviando…", thanksT: "Gracias por tu comentario", thanksS: "Lo tendremos en cuenta para mejorar.", rate: "Tu valoración", needMsg: "Escribe un breve mensaje.", err: "No se pudo enviar, inténtalo de nuevo." },
};
const t = T[lang];
const contactPrefill = [email, phone].filter(Boolean).join(" · ");
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{t.title} — {dati.nome}</title>
  <style define:vars={{ bg: tema.bg, card: tema.card, accent: tema.accent, onAccent: tema.onAccent, title: tema.title, text: tema.text, muted: tema.muted, border: tema.border, tint: tema.tint, tintBorder: tema.tintBorder }}>
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;align-items:flex-start;justify-content:center;padding:22px 14px 60px}
    .card{width:100%;max-width:560px;background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden}
    .bar{height:4px;background:var(--accent)}
    .pad{padding:34px 40px}
    .logo{display:block;margin:0 auto 4px;max-width:170px;max-height:64px;height:auto}
    h1{margin:14px 0 0;color:var(--title);font-size:23px;line-height:1.25;text-align:center}
    .sub{margin:12px 0 0;color:var(--text);font-size:14.5px;line-height:1.6;text-align:center}
    .stars{text-align:center;margin:22px 0 4px;font-size:0;white-space:nowrap}
    .star{font-size:40px;line-height:1;padding:0 4px;cursor:pointer;color:var(--border);transition:color .12s;-webkit-tap-highlight-color:transparent}
    .star.on{color:var(--accent)}
    .rateline{text-align:center;color:var(--muted);font-size:12px;margin:4px 0 0}
    textarea,input{width:100%;background:transparent;color:var(--title);border:1px solid var(--border);border-radius:10px;padding:13px 15px;font-size:15px;font-family:inherit;margin-top:16px;outline:none}
    textarea{min-height:120px;resize:vertical}
    textarea:focus,input:focus{border-color:var(--accent)}
    ::placeholder{color:var(--muted);opacity:.9}
    .btn{display:block;width:100%;margin-top:20px;background:var(--accent);color:var(--onAccent);border:0;border-radius:999px;padding:16px;font-size:13px;letter-spacing:2px;text-transform:uppercase;font-weight:bold;cursor:pointer}
    .btn[disabled]{opacity:.6;cursor:default}
    .err{color:#e5645b;font-size:13px;text-align:center;margin:14px 0 0;min-height:1px}
    .foot{padding:20px 40px 26px;border-top:1px solid var(--border);text-align:center;color:var(--muted);font-size:12px;line-height:1.8}
    .thanks{text-align:center;padding:48px 40px}
    .thanks h2{color:var(--title);font-size:24px;margin:16px 0 0}
    .thanks p{color:var(--text);font-size:15px;margin:12px 0 0;line-height:1.6}
    .check{width:64px;height:64px;border-radius:50%;background:var(--tint);border:1px solid var(--tintBorder);display:inline-flex;align-items:center;justify-content:center;color:var(--accent);font-size:32px}
    @media (max-width:480px){.pad{padding:26px 22px}.foot{padding:18px 22px 24px}.thanks{padding:40px 22px}h1{font-size:21px}.star{font-size:36px}}
  </style>
</head>
<body>
  <main class="card" role="main">
    <div class="bar"></div>
    <div id="form">
      <div class="pad">
        {logo ? <img class="logo" src={logo} alt={dati.nome} /> : <p style="text-align:center;letter-spacing:4px;color:var(--muted);font-size:12px;margin:0">{dati.nome.toUpperCase()}</p>}
        <h1>{t.title}</h1>
        <p class="sub">{t.sub}</p>
        <div class="stars" id="stars">
          {[1,2,3,4,5].map((n) => <span class="star" data-n={n}>★</span>)}
        </div>
        <p class="rateline"><span id="ratetxt"></span></p>
        <textarea id="msg" placeholder={t.ph}></textarea>
        <input id="contact" type="text" placeholder={t.contactPh} value={contactPrefill} />
        <button class="btn" id="send">{t.send}</button>
        <p class="err" id="err"></p>
      </div>
      <div class="foot">{dati.indirizzo}{dati.tel ? " · " + dati.tel : ""}</div>
    </div>
    <div id="done" class="thanks" style="display:none">
      <span class="check">✓</span>
      <h2>{t.thanksT}</h2>
      <p>{t.thanksS}</p>
    </div>
  </main>

  <script define:vars={{ rating, order, name, email, phone, STR: t }}>
    (function () {
      let current = rating;
      const stars = Array.from(document.querySelectorAll(".star"));
      const rateTxt = document.getElementById("ratetxt");
      const paint = (v) => {
        stars.forEach((s) => s.classList.toggle("on", Number(s.dataset.n) <= v));
        rateTxt.textContent = STR.rate + ": " + v + " / 5";
      };
      stars.forEach((s) => {
        s.addEventListener("click", () => { current = Number(s.dataset.n); paint(current); });
      });
      paint(current);

      const btn = document.getElementById("send");
      const err = document.getElementById("err");
      btn.addEventListener("click", async () => {
        const message = document.getElementById("msg").value.trim();
        const contact = document.getElementById("contact").value.trim();
        err.textContent = "";
        if (!message) { err.textContent = STR.needMsg; return; }
        // separa email/telefono dal campo contatto unico
        let em = email, ph = phone;
        const parts = contact.split(/[·,;\n]+/).map((x) => x.trim()).filter(Boolean);
        parts.forEach((p) => { if (p.indexOf("@") >= 0) em = p; else if (/[0-9]/.test(p)) ph = p; });
        btn.disabled = true; const label = btn.textContent; btn.textContent = STR.sending;
        try {
          const res = await fetch("/api/feedback", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ rating: current, message, name, email: em, phone: ph, order }),
          });
          if (!res.ok) throw new Error("http");
          document.getElementById("form").style.display = "none";
          document.getElementById("done").style.display = "block";
        } catch (_e) {
          err.textContent = STR.err;
          btn.disabled = false; btn.textContent = label;
        }
      });
    })();
  </script>
</body>
</html>
