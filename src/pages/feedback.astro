---
// Pagina feedback privato (gating recensioni) — design demo01 adattato al
// Layout e ai colori del tema del cliente (brand-aware via variabili --c-*).
// Aperta dalle stelle 1-3 dell'email recensione: raccoglie nota +
// sotto-valutazioni e le invia SOLO al ristorante (/api/feedback).
// Il logo NON si ripete qui: c'è già nell'header del sito.
import Layout from "../layouts/Layout.astro";
import { datiRistorante } from "../lib/ristorante";

export const prerender = false;

const url = Astro.url;
const rParam = Math.round(Number(url.searchParams.get("r")));
const rating = Number.isFinite(rParam) && rParam >= 1 && rParam <= 5 ? rParam : 3;
const order = (url.searchParams.get("o") ?? "").slice(0, 40);
const name = (url.searchParams.get("name") ?? "").slice(0, 200);
const email = (url.searchParams.get("email") ?? "").slice(0, 200);
const phone = (url.searchParams.get("phone") ?? "").slice(0, 60);
const LANGS = ["fr", "en", "it", "nl", "es"];
const langRaw = (url.searchParams.get("lang") ?? "fr").toLowerCase();
// /en/feedback (prefisso path) forza l'inglese; altrimenti ?lang= (fr/it/nl/es).
const pathEn = url.pathname.split("/")[1] === "en";
const lang = pathEn ? "en" : (LANGS.includes(langRaw) ? langRaw : "fr");

const dati = await datiRistorante();
const brand = dati.nome;

type Cats = { food: string; service: string; atmosphere: string };
type Str = { title: string; sub: string; ph: string; contactPh: string; send: string; sending: string; thanksT: string; thanksS: string; rate: string; needMsg: string; err: string; home: string; details: string; cats: Cats };
const T: Record<string, Str> = {
  fr: { title: "Comment pouvons-nous nous améliorer ?", sub: "Désolés que l'expérience n'ait pas été parfaite. Votre retour arrive uniquement au restaurant et nous aide à faire mieux.", ph: "Dites-nous ce qui n'a pas fonctionné…", contactPh: "Votre email ou téléphone (facultatif)", send: "Envoyer mon avis", sending: "Envoi…", thanksT: "Merci pour votre retour", thanksS: "Nous en tenons compte pour nous améliorer.", rate: "Votre note", needMsg: "Merci d'écrire un petit message.", err: "Envoi impossible, réessayez.", home: "← Retour au site", details: "Notez plus en détail (facultatif)", cats: { food: "Cuisine", service: "Service", atmosphere: "Ambiance" } },
  en: { title: "How can we do better?", sub: "Sorry your experience wasn't perfect. Your feedback goes only to the restaurant and helps us improve.", ph: "Tell us what went wrong…", contactPh: "Your email or phone (optional)", send: "Send my feedback", sending: "Sending…", thanksT: "Thanks for your feedback", thanksS: "We'll use it to do better.", rate: "Your rating", needMsg: "Please write a short message.", err: "Couldn't send, please retry.", home: "← Back to site", details: "Rate in more detail (optional)", cats: { food: "Food", service: "Service", atmosphere: "Atmosphere" } },
  it: { title: "Come possiamo migliorare?", sub: "Ci dispiace non sia stata un'esperienza perfetta. Il tuo riscontro arriva solo al ristorante e ci aiuta a fare meglio.", ph: "Raccontaci cosa non ha funzionato…", contactPh: "La tua email o telefono (facoltativo)", send: "Invia il feedback", sending: "Invio…", thanksT: "Grazie per il tuo feedback", thanksS: "Ne teniamo conto per migliorare.", rate: "La tua valutazione", needMsg: "Scrivi un breve messaggio.", err: "Invio non riuscito, riprova.", home: "← Torna al sito", details: "Valuta più in dettaglio (facoltativo)", cats: { food: "Cucina", service: "Servizio", atmosphere: "Atmosfera" } },
  nl: { title: "Hoe kunnen we het beter doen?", sub: "Sorry dat je ervaring niet perfect was. Je feedback gaat alleen naar het restaurant en helpt ons te verbeteren.", ph: "Vertel ons wat er misging…", contactPh: "Je e-mail of telefoon (optioneel)", send: "Feedback versturen", sending: "Versturen…", thanksT: "Bedankt voor je feedback", thanksS: "We gebruiken het om beter te worden.", rate: "Jouw beoordeling", needMsg: "Schrijf een kort bericht.", err: "Versturen mislukt, probeer opnieuw.", home: "← Terug naar de site", details: "Beoordeel gedetailleerder (optioneel)", cats: { food: "Eten", service: "Service", atmosphere: "Sfeer" } },
  es: { title: "¿Cómo podemos mejorar?", sub: "Sentimos que la experiencia no haya sido perfecta. Tu comentario llega solo al restaurante y nos ayuda a mejorar.", ph: "Cuéntanos qué no funcionó…", contactPh: "Tu email o teléfono (opcional)", send: "Enviar mi opinión", sending: "Enviando…", thanksT: "Gracias por tu comentario", thanksS: "Lo tendremos en cuenta para mejorar.", rate: "Tu valoración", needMsg: "Escribe un breve mensaje.", err: "No se pudo enviar, inténtalo de nuevo.", home: "← Volver al sitio", details: "Valora con más detalle (opcional)", cats: { food: "Comida", service: "Servicio", atmosphere: "Ambiente" } },
};
const t = T[lang];
const contactPrefill = [email, phone].filter(Boolean).join(" · ");
const CATS: { key: string; label: string }[] = [
  { key: "food", label: t.cats.food },
  { key: "service", label: t.cats.service },
  { key: "atmosphere", label: t.cats.atmosphere },
];
---
<Layout title={`${t.title} — ${brand}`} transparentHeader={true} noindex={true}>
  <section class="fb">
    <div id="form" class="fb-inner">
      <h1 class="fb-title">{t.title}</h1>
      <p class="fb-sub">{t.sub}</p>

      <div class="stars" id="stars">
        {[1,2,3,4,5].map((n) => <button type="button" class="star" data-n={n} aria-label={`${n}`}>★</button>)}
      </div>
      <p class="rate" id="ratetxt"></p>

      <div class="subratings">
        <p class="sub-hint">{t.details}</p>
        {CATS.map((c) => (
          <div class="subrow">
            <span class="sublabel">{c.label}</span>
            <div class="substars" data-cat={c.key}>
              {[1,2,3,4,5].map((n) => <button type="button" class="star star--sm" data-n={n} aria-label={`${c.label} ${n}`}>★</button>)}
            </div>
          </div>
        ))}
      </div>

      <div class="fields">
        <textarea id="msg" placeholder={t.ph}></textarea>
        <input id="contact" type="text" placeholder={t.contactPh} value={contactPrefill} />
        <button class="send" id="send" type="button">{t.send}</button>
        <p class="err" id="err"></p>
      </div>

      <a class="home" href="/">{t.home}</a>
    </div>

    <div id="done" class="fb-inner done" style="display:none">
      <span class="check">✓</span>
      <h1 class="fb-title">{t.thanksT}</h1>
      <p class="fb-sub">{t.thanksS}</p>
      <a class="home" href="/">{t.home}</a>
    </div>
  </section>
</Layout>

<script define:vars={{ rating, order, name, email, phone, STR: t }}>
  (function () {
    let current = rating;
    const stars = Array.from(document.querySelectorAll("#stars .star"));
    const rateTxt = document.getElementById("ratetxt");
    const paint = (v) => {
      stars.forEach((s) => s.classList.toggle("on", Number(s.dataset.n) <= v));
      rateTxt.textContent = STR.rate + ": " + v + " / 5";
    };
    stars.forEach((s) => s.addEventListener("click", () => { current = Number(s.dataset.n); paint(current); }));
    paint(current);

    const sub = { food: 0, service: 0, atmosphere: 0 };
    document.querySelectorAll(".substars").forEach((grp) => {
      const cat = grp.dataset.cat;
      const items = Array.from(grp.querySelectorAll(".star"));
      const paintSub = (v) => items.forEach((s) => s.classList.toggle("on", Number(s.dataset.n) <= v));
      items.forEach((s) => s.addEventListener("click", () => { sub[cat] = Number(s.dataset.n); paintSub(sub[cat]); }));
    });

    const btn = document.getElementById("send");
    const err = document.getElementById("err");
    btn.addEventListener("click", async () => {
      const message = document.getElementById("msg").value.trim();
      const contact = document.getElementById("contact").value.trim();
      err.textContent = "";
      if (!message) { err.textContent = STR.needMsg; return; }
      let em = email, ph = phone;
      contact.split(/[·,;\n]+/).map((x) => x.trim()).filter(Boolean).forEach((p) => {
        if (p.indexOf("@") >= 0) em = p; else if (/[0-9]/.test(p)) ph = p;
      });
      btn.disabled = true; const label = btn.textContent; btn.textContent = STR.sending;
      try {
        const res = await fetch("/api/feedback", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ rating: current, message, name, email: em, phone: ph, order, food: sub.food, service: sub.service, atmosphere: sub.atmosphere }),
        });
        if (!res.ok) throw new Error("http");
        document.getElementById("form").style.display = "none";
        document.getElementById("done").style.display = "block";
      } catch (_e) {
        err.textContent = STR.err;
        btn.disabled = false; btn.textContent = label;
      }
    });
  })();
</script>

<style>
  .fb { max-width: 620px; margin: 0 auto; padding: clamp(7rem, 12vw, 9.5rem) 1.5rem 5.5rem; text-align: center; color: var(--c-text); }
  .fb-inner { display: flex; flex-direction: column; align-items: center; }
  .fb-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(2rem, 5.5vw, 3rem); line-height: 1.1; margin: 0; color: var(--c-text); }
  .fb-sub { color: var(--c-muted); line-height: 1.65; max-width: 480px; margin: 1.1rem auto 0; }

  .stars { display: flex; justify-content: center; gap: .35rem; margin: 2.2rem 0 .5rem; }
  .star { background: none; border: 0; cursor: pointer; font-size: clamp(2.4rem, 8vw, 3rem); line-height: 1; padding: 0 .1rem; color: color-mix(in srgb, var(--c-muted) 45%, transparent); transition: color .12s, transform .12s; -webkit-tap-highlight-color: transparent; }
  .star:hover { transform: translateY(-3px); }
  .star.on { color: var(--c-flame, var(--c-accent)); }
  .rate { color: var(--c-muted); font-size: .82rem; letter-spacing: .04em; min-height: 1em; }

  .subratings { width: 100%; max-width: 400px; margin: 1.8rem auto 0; border-top: 1px solid var(--c-line); padding-top: 1.4rem; }
  .sub-hint { color: var(--c-muted); font-size: .74rem; text-transform: uppercase; letter-spacing: .14em; margin-bottom: .9rem; }
  .subrow { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .35rem 0; }
  .sublabel { color: var(--c-text); font-size: .95rem; }
  .substars { display: flex; gap: .15rem; }
  .star--sm { font-size: 1.5rem; padding: 0 .06rem; }
  .star--sm:hover { transform: none; }

  .fields { width: 100%; max-width: 480px; margin: 1.8rem auto 0; }
  textarea, #contact { width: 100%; background: color-mix(in srgb, var(--c-muted) 8%, transparent); color: var(--c-text); border: 1px solid var(--c-line); border-radius: 12px; padding: .95rem 1.1rem; font-family: var(--font-body); font-size: 1rem; outline: none; transition: border-color .2s; }
  textarea { min-height: 130px; resize: vertical; }
  #contact { margin-top: .9rem; }
  textarea:focus, #contact:focus { border-color: var(--c-flame, var(--c-accent)); }
  textarea::placeholder, #contact::placeholder { color: var(--c-muted); opacity: .8; }
  .send { width: 100%; margin-top: 1.1rem; background: var(--c-flame, var(--c-accent)); color: var(--c-bg); border: 1px solid var(--c-flame, var(--c-accent)); border-radius: 999px; padding: .95rem 2rem; font-family: var(--font-title); font-weight: 400; font-size: 1.05rem; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: filter .2s; }
  .send:hover { filter: brightness(1.08); }
  .send[disabled] { opacity: .6; cursor: default; }
  .err { color: #ff9b8f; font-size: .85rem; min-height: 1em; margin-top: .85rem; }
  .home { display: inline-block; margin-top: 2.2rem; color: var(--c-muted); border-bottom: 1px solid var(--c-line); padding-bottom: 2px; transition: color .2s, border-color .2s; }
  .home:hover { color: var(--c-flame, var(--c-accent)); border-color: var(--c-flame, var(--c-accent)); }
  .check { display: inline-flex; align-items: center; justify-content: center; width: 68px; height: 68px; border-radius: 50%; background: color-mix(in srgb, var(--c-flame, var(--c-accent)) 12%, transparent); border: 1px solid color-mix(in srgb, var(--c-flame, var(--c-accent)) 40%, transparent); color: var(--c-flame, var(--c-accent)); font-size: 2rem; margin-bottom: 1.3rem; }
</style>
