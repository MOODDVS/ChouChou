---
// Widget prenotazioni RestoHub in versione NUDA (niente Layout/header/footer).
// Caricato SOLO dentro l'iframe del modale "Réserver". La pagina intera con
// header + footer è /reservation.
import ReservationWidget from "../components/ReservationWidget.astro";
import { CLIENT } from "../config/client";
import { datiRistorante } from "../lib/ristorante";
import { ambitoPubblicoChiesto } from "../lib/admin/sede";
import Fonts from "../components/Fonts.astro";

export const prerender = false;

// ⚠️ UN CLIENTE MULTI-SEDE INCORPORA QUESTA PAGINA UNA VOLTA PER PUNTO,
// con `?sede=<id>` nell'URL dell'iframe. Da li' arriva il telefono giusto
// nel messaggio d'errore, e da li' il widget porta il punto a ogni chiamata.
// Senza, si ripiega come sempre: e' il caso di un sito a punto unico.
const sedeChiesta = Astro.url.searchParams.get("sede") ?? "";
let telWidget = CLIENT.telefono;
try {
  const dati = await datiRistorante(await ambitoPubblicoChiesto(Astro.request));
  if (dati.tel) telWidget = dati.tel;
} catch { /* fallback config */ }
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Réservation — {CLIENT.nome}</title>
    <Fonts vetrina />
    <style is:global>
      :root {
        --c-muted: #b3aca6;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: #231f20; color: #fff; font-family: var(--font-body); }
    </style>
  </head>
  <body>
    <ReservationWidget telWidget={telWidget} sede={sedeChiesta} />
  </body>
</html>
