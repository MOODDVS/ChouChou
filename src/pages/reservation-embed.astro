---
// Widget prenotazioni RestoHub in versione NUDA (niente Layout/header/footer).
// Caricato SOLO dentro l'iframe del modale "Réserver". La pagina intera con
// header + footer è /reservation.
import ReservationWidget from "../components/ReservationWidget.astro";
import { CLIENT } from "../config/client";
import { datiRistorante } from "../lib/ristorante";
import { ambitoPubblicoChiesto } from "../lib/admin/sede";
import Fonts from "../components/Fonts.astro";

export const prerender = false;

let telWidget = CLIENT.telefono;
try {
  const dati = await datiRistorante(await ambitoPubblicoChiesto(Astro.request));
  if (dati.tel) telWidget = dati.tel;
} catch { /* fallback config */ }

// ⚠️ IL PUNTO CHE LA PAGINA HA RICEVUTO VIAGGIA COL WIDGET. Un cliente
// multi-sede apre questa pagina (o l'iframe) una volta per punto, con
// `?sede=<id>`: da lì il widget porta la sede a ogni chiamata, e le
// prenotazioni nascono nella sala giusta. Vuoto = punto unico, come oggi.
const sedeChiesta = Astro.url.searchParams.get("sede") ?? "";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Réservation, {CLIENT.nome}</title>
    {/* I font dal dominio di ChouChou, non da Google (vedi Layout.astro). */}
    <Fonts sito />
    <style is:global>
      :root {
        --c-muted: #b3aca6;
      }
      /* ⚠️ Rinvio, non ridichiarazione: vedi Layout.astro. `html:root` vince
         per specificita' sull'iniezione di Astro, e il valore e' un `var()`
         perche' il nome della famiglia ha un hash. */
      html:root { --font-title: var(--font-titolo); --font-body: var(--font-testo); }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: #353c4e; color: #fff; font-family: var(--font-body); }
      /* Dans le modale : le widget occupe tout, sans cadre ni marge autour. */
      .page { padding: 0 !important; min-height: auto !important; }
      .rw { max-width: none !important; border: none !important; border-radius: 0 !important; background: #353c4e !important; }
    </style>
  </head>
  <body>
    <ReservationWidget telWidget={telWidget} sede={sedeChiesta} />
  </body>
</html>
