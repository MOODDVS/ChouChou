---
// Pagina PUBBLICA di prenotazione (URL /reservation). Pagina intera del sito
// con header + footer: il widget MOODD è reso dentro il Layout. La versione
// nuda per l'iframe del modale "Réserver" è /reservation-embed.
import Layout from "../layouts/Layout.astro";
import ReservationWidget from "../components/ReservationWidget.astro";
import { CLIENT } from "../config/client";
import { datiRistorante } from "../lib/ristorante";

export const prerender = false;

// Telefono per il bottone "Téléphoner": da Réglages → Général (cache 60s),
// fallback sul config statico del cliente.
let telWidget = CLIENT.telefono;
try {
  const dati = await datiRistorante();
  if (dati.tel) telWidget = dati.tel;
} catch { /* fallback config */ }
---

<Layout title={`Réservation — ${CLIENT.nome}`}>
  <ReservationWidget telWidget={telWidget} inPage />
</Layout>
