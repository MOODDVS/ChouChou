---
// Pagina PUBBLICA di prenotazione (URL /reservation). Pagina intera del sito
// con header + footer: hero Chouchou (foto random + overlay + halo magenta) +
// widget MOODD incorniciato su fondo ivoire. La versione nuda per l'iframe del
// modale "Réserver" resta /reservation-embed.
import Layout from "../layouts/Layout.astro";
import ReservationWidget from "../components/ReservationWidget.astro";
import { CLIENT } from "../config/client";
import { datiRistorante } from "../lib/ristorante";
import { getLangFromUrl } from "../i18n/ui";
import { siteImages } from "../lib/siteImages";

export const prerender = false;

// Lingua: prefisso /en oppure ?lang=en (stessa logica del widget, che legge
// ?lang= per aprirsi nella lingua giusta). Cosi hero e widget restano allineati.
const en = getLangFromUrl(Astro.url) === "en" || Astro.url.searchParams.get("lang") === "en";

// Telefono per il bottone "Téléphoner" del widget: da Réglages -> Général
// (cache 60s), fallback sul config statico del cliente.
let telWidget = CLIENT.telefono;
try {
  const dati = await datiRistorante();
  if (dati.tel) telWidget = dati.tel;
} catch { /* fallback config */ }

// Sfondo hero: una foto Chouchou a caso tra quelle caricate nell'admin
// (heroes, galerie, ambiance). Cambia a ogni ricaricamento (SSR).
const IMGS = await siteImages();
const POOL_KEYS = [
  "site_hero_1", "site_hero_2", "site_hero_3",
  "site_gallery_1", "site_gallery_2", "site_gallery_3", "site_gallery_4", "site_gallery_5",
  "site_gallery_6", "site_gallery_7", "site_gallery_8", "site_gallery_9",
  "site_resto_photo", "site_brunch", "site_soir_chef",
  "site_menu_hero", "site_contact_hero", "site_epicerie_hero",
];
const DISPO = POOL_KEYS.map((k) => IMGS[k]).filter(Boolean);
const HERO_BG = DISPO.length ? DISPO[Math.floor(Math.random() * DISPO.length)] : "/chouchou-restaurant.webp";

const L = {
  title: en ? "Reservation" : "Réservation",
  sub: en
    ? "Book your table at Comptoir Chouchou in just a few clicks. We can't wait to welcome you."
    : "Réservez votre table au Comptoir Chouchou en quelques clics. On a hâte de vous accueillir.",
};
---

<Layout
  title={en ? "Book a table, Comptoir Chouchou in Mont-Saint-Guibert" : "Réserver une table, Comptoir Chouchou à Mont-Saint-Guibert"}
  description={en
    ? "Book your table at Comptoir Chouchou, a restaurant in Mont-Saint-Guibert, in just a few clicks. Creative, homemade cuisine in Walloon Brabant."
    : "Réservez votre table au Comptoir Chouchou, restaurant à Mont-Saint-Guibert, en quelques clics. Cuisine créative et faite maison en Brabant wallon."}
>
  <div class="chou">
    <section class="rv-hero">
      <div class="rv-hero__bg" aria-hidden="true"></div>
      <img class="rv-hero__photo" src={HERO_BG} alt="" loading="eager" fetchpriority="high" decoding="async" onerror="this.remove()" />
      <div class="rv-hero__overlay" aria-hidden="true"></div>
      <div class="rv-hero__glow" aria-hidden="true"></div>
      <div class="rv-hero__inner">
        <h1 class="rv-hero__title">{L.title}</h1>
        <p class="rv-hero__sub">{L.sub}</p>
      </div>
    </section>

    <section class="rv-body">
      <div class="rv-body__glow" aria-hidden="true"></div>
      <div class="rv-body__inner">
        <ReservationWidget telWidget={telWidget} inPage />
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ---------- Wrapper Chouchou : navy + accent magenta ---------- */
  .chou {
    --c-bg: #353c4e;
    --c-accent: #ed2289;
    background: #2b3040;
    position: relative;
  }

  /* ---------- HERO ---------- */
  .rv-hero {
    position: relative;
    min-height: clamp(230px, 30vh, 340px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(7.5rem, 12vh, 9rem) 1.5rem 2.75rem;
    overflow: hidden;
  }
  .rv-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(120% 100% at 50% 0%, #3d4458 0%, #2b3040 55%, #23283a 100%);
  }
  .rv-hero__photo {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rv-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(180deg, rgba(23, 27, 40, 0.5) 0%, rgba(23, 27, 40, 0.68) 100%);
  }
  .rv-hero__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 560px;
    height: 560px;
    max-width: 130vw;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(237, 34, 137, 0.22) 0%, rgba(237, 34, 137, 0) 62%);
    pointer-events: none;
  }
  .rv-hero__inner { position: relative; z-index: 3; }
  .rv-hero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.4rem, 5.4vw, 3.6rem);
    letter-spacing: 0.01em;
    line-height: 1.05;
    margin: 0 0 0.8rem;
    color: #fff;
    opacity: 0;
    transform: translateY(16px);
    animation: rv-in 0.8s ease-out 0.12s forwards;
  }
  .rv-hero__sub {
    max-width: 560px;
    margin: 0 auto;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    opacity: 0;
    transform: translateY(16px);
    animation: rv-in 0.8s ease-out 0.24s forwards;
  }
  @keyframes rv-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ---------- BODY : ivoire + widget incorniciato ---------- */
  .rv-body {
    position: relative;
    background: #f7f4ee;
    padding: clamp(3rem, 7vh, 5.5rem) 1.25rem clamp(4rem, 9vh, 6.5rem);
    overflow: hidden;
  }
  .rv-body__glow {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: 0;
    width: 720px;
    height: 520px;
    max-width: 130vw;
    transform: translate(-50%, -34%);
    background: radial-gradient(circle, rgba(237, 34, 137, 0.10) 0%, rgba(237, 34, 137, 0) 66%);
    pointer-events: none;
  }
  .rv-body__inner {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  /* Ombre douce sous la carte navy du widget, pour la détacher de l'ivoire.
     (styling de page, on ne modifie jamais le composant moteur.) */
  .rv-body :global(.rw) {
    box-shadow: 0 22px 60px rgba(53, 60, 78, 0.22);
  }
  .rv-body :global(.page--inpage) {
    padding-top: 0;
    padding-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .rv-hero__title, .rv-hero__sub {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
