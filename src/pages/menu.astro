<style>
  /* ---------- Wrapper Chouchou : fond navy + accent magenta ---------- */
  .chou {
    --c-bg: #353c4e;
    --c-accent: #ed2289;
    background: #2b3040;
    position: relative;
  }

  /* ---------- HERO ---------- */
  .menu-hero {
    position: relative;
    min-height: clamp(400px, 56vh, 600px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(9rem, 15vh, 12.5rem) 1.5rem 4.5rem;
    overflow: hidden;
  }
  .menu-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(120% 100% at 50% 0%, #3d4458 0%, #2b3040 55%, #23283a 100%);
  }
  .menu-hero__photo {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .menu-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(180deg, rgba(23, 27, 40, 0.4) 0%, rgba(23, 27, 40, 0.62) 100%);
  }
  .menu-hero__glow {
    position: absolute;
    left: 50%;
    top: 44%;
    z-index: 2;
    width: 620px;
    height: 620px;
    max-width: 120vw;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(237, 34, 137, 0.22) 0%, rgba(237, 34, 137, 0) 62%);
    pointer-events: none;
  }
  .menu-hero__inner { position: relative; z-index: 3; }
  .menu-hero__script {
    font-family: var(--font-script);
    color: var(--c-accent);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 0.9;
    margin: 0 0 0.05em;
    opacity: 0;
    transform: translateY(18px);
    animation: carte-in 0.8s ease-out 0.1s forwards;
  }
  .menu-hero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 6vw, 4rem);
    letter-spacing: 0.01em;
    line-height: 1.05;
    margin: 0 0 0.9rem;
    color: #fff;
    opacity: 0;
    transform: translateY(18px);
    animation: carte-in 0.8s ease-out 0.2s forwards;
  }
  .menu-hero__sub {
    max-width: 560px;
    margin: 0 auto 1.7rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
    opacity: 0;
    transform: translateY(18px);
    animation: carte-in 0.8s ease-out 0.32s forwards;
  }
  .menu-hero__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    background: var(--c-accent);
    border: none;
    cursor: pointer;
    text-decoration: none;
    padding: 14px 34px;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(18px);
    animation: carte-in 0.8s ease-out 0.45s forwards;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .menu-hero__btn:hover { background: #c8176f; transform: translateY(-2px); }

  @keyframes carte-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ---------- BARRA SEZIONI ---------- */
  :global(html) { scroll-behavior: smooth; }

  .secnav {
    position: fixed;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    scrollbar-width: none;
    z-index: 60;
  }
  .secnav::-webkit-scrollbar { display: none; }

  .secnav__item {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    text-decoration: none;
  }
  .secnav__label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--c-text);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }
  .secnav__item:hover .secnav__label { opacity: 0.85; transform: none; }
  .secnav__item.active .secnav__label {
    opacity: 1;
    transform: none;
    color: var(--c-accent);
    font-weight: 700;
  }
  .secnav__box {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid var(--c-line);
    border-radius: 8px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--c-text);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .secnav__box :global(svg) {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }
  /* Icone "piene" (fornite): riempimento invece del tratto */
  .secnav__box :global(svg.ico-fill) {
    fill: currentColor;
    stroke: none;
    width: 20px;
    height: 20px;
  }
  .secnav__item.active .secnav__box {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-bg);
  }

  /* ---------- CARTE ---------- */
  /* Titolo gigante statico "Le Lunch" tra hero e carte (stile home, niente scroll) */
  /* flow-root: il margine negativo del testo NON collassa, cosi 'Le Lunch'
     sale sopra la foto dell'hero mentre il fondo bianco resta sotto. */
  .lunch-band { background: #ffffff; display: flow-root; position: relative; z-index: 4; --c-text: #353c4e; --c-muted: #6b7183; }
  .lunch-in {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(2.2rem, 4.5vw, 3.5rem) 28px clamp(2.5rem, 5vw, 4.5rem);
  }
  .lunch-kicker {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin: 0 0 clamp(1.5rem, 3vw, 2.4rem);
  }
  .lunch-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.6rem, 4vw, 3.2rem);
  }
  .lunch-col__t {
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-text);
    margin: 0 0 1rem;
  }
  .lunch-dishes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .lunch-dish__n { display: block; font-family: var(--font-title); font-weight: 600; font-size: 1.02rem; color: var(--c-text); }
  .lunch-dish__d { display: block; font-family: var(--font-body); font-size: 0.9rem; line-height: 1.45; color: var(--c-muted); margin-top: 0.2rem; }
  .lunch-prices {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.9rem 1.1rem;
    margin: clamp(2.4rem, 5vw, 3.4rem) 0 0;
    border-top: 1px solid rgba(53, 60, 78, 0.15);
  }
  .lunch-price {
    margin-top: -1.15rem; /* pillola a cavallo della linea */
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.55rem;
    width: clamp(260px, 24vw, 320px); /* meme largeur pour les 3 */
    background: #ffffff;
    border: 1px solid rgba(53, 60, 78, 0.2);
    border-radius: 999px;
    padding: 0.6rem 1.3rem;
    font-family: var(--font-title);
    white-space: nowrap;
  }
  .lunch-price__l { font-weight: 600; font-size: 0.92rem; color: var(--c-text); }
  .lunch-price__v { font-weight: 700; font-size: 1rem; color: var(--c-accent); }
  @media (max-width: 760px) {
    .lunch-cols { grid-template-columns: 1fr; gap: 1.8rem; }
    /* pillules empilees : meme largeur + espace entre elles */
    .lunch-prices { flex-direction: column; align-items: center; gap: 0.9rem; margin-top: clamp(2rem, 6vw, 3rem); border-top: none; }
    .lunch-price { margin-top: 0; width: 100%; max-width: 300px; }
  }
  .lunch-txt {
    display: block;
    max-width: 1440px;
    margin: clamp(-8rem, -11vw, -4rem) auto 0;
    padding: 0 28px clamp(0.6rem, 1.6vw, 1.4rem);
    font-family: var(--font-script);
    color: #ed2289;
    font-size: clamp(4rem, 14vw, 12rem);
    line-height: 1.1;
    white-space: nowrap;
    text-align: left;
  }
  .lunch-sub {
    display: block;
    max-width: 1440px;
    margin: clamp(-4rem, -5vw, -1.6rem) auto 0;
    padding: 0 28px;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    font-style: italic;
    color: #6b7183;
  }
  /* Mobile : titre « le lunch » plus grand, a moitie sur l'image du hero */
  @media (max-width: 620px) {
    .lunch-txt {
      font-size: 25vw;
      margin-top: -0.66em;          /* la moitie du titre chevauche l'image */
      padding-bottom: 0.12em;
    }
    .lunch-sub {
      font-size: 1.05rem;
      margin-top: -1.8rem;   /* rapproche de « le lunch » */
    }
    .carte-band__in .carte-title { font-size: 25vw; }   /* aussi grand que « le lunch » (specificite > regle de base) */
  }

  .carte-band { background: #ffffff; position: relative; z-index: 1; margin-top: -1px; }
  .carte-band__in {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) 28px clamp(0.5rem, 2vw, 1rem);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;                 /* legumes colles au titre a droite */
    gap: clamp(1rem, 3.5vw, 2.6rem);
  }
  .carte-veg {
    --veg: #565f7a; /* meme navy clair que la page Accueil */
    display: flex;
    align-items: flex-end;
    gap: clamp(0.6rem, 2.2vw, 1.8rem);
    flex: 0 1 auto;
    min-width: 0;
    /* remonte les legumes au niveau visuel du titre (descentes du script) */
    margin-bottom: clamp(0.6rem, 2vw, 1.8rem);
  }
  .cv {
    display: block;
    flex: none;
    position: relative;
    transform-origin: 50% 92%;
    background-color: var(--veg);
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: center bottom; mask-position: center bottom;
    -webkit-mask-size: contain; mask-size: contain;
  }
  /* ordre : aubergine, bouteille, chou-fleur, herbe */
  .cv-6 {
    height: clamp(38px, 5vw, 82px); aspect-ratio: 1268.68 / 535.23;
    -webkit-mask-image: url("/SVG/veg-6.svg"); mask-image: url("/SVG/veg-6.svg");
    animation: cveg-a 7.5s ease-in-out -0.5s infinite;
  }
  .cv-7 {
    height: clamp(74px, 9.6vw, 158px); aspect-ratio: 520.06 / 1065.39;
    -webkit-mask-image: url("/SVG/veg-7.svg"); mask-image: url("/SVG/veg-7.svg");
    top: clamp(-1.6rem, -2.4vw, -0.6rem);         /* remonte un peu la bouteille */
    margin-left: clamp(-4.5rem, -6.5vw, -1.8rem); /* colle a l'aubergine */
    animation: cveg-b 6s ease-in-out -1.5s infinite;
  }
  .cv-5 {
    height: clamp(78px, 10vw, 164px); aspect-ratio: 1082.1 / 1032.36;
    -webkit-mask-image: url("/SVG/veg-5.svg"); mask-image: url("/SVG/veg-5.svg");
    top: clamp(0.6rem, 1.6vw, 1.6rem);            /* descend la salade */
    margin-left: clamp(-1.3rem, -1.7vw, -0.4rem); /* decale la salade a gauche */
    animation: cveg-a 8.5s ease-in-out -2.5s infinite;
  }
  .cv-4 {
    height: clamp(26px, 3.4vw, 56px); aspect-ratio: 617.9 / 332.88;
    -webkit-mask-image: url("/SVG/veg-4.svg"); mask-image: url("/SVG/veg-4.svg");
    margin-left: clamp(-2rem, -2.6vw, -0.7rem); /* rapproche l'herbe a gauche */
    top: clamp(-0.7rem, -1vw, -0.25rem);        /* remonte un peu l'herbe */
    animation: cveg-b 5.5s ease-in-out -1s infinite;
  }
  .carte-title {
    flex: 0 0 auto;
    margin: 0;
    font-family: var(--font-script);
    font-weight: 400;
    color: #353c4e;
    font-size: clamp(4rem, 14vw, 12rem);   /* meme taille que « le lunch » */
    line-height: 1.1;
    white-space: nowrap;
    text-align: right;
  }
  @media (max-width: 760px) {
    /* mobile : bloc de legumes centre AU-DESSUS du titre */
    .carte-band__in { flex-direction: column; align-items: stretch; gap: 0; }
    .carte-veg { display: flex; justify-content: center; margin-bottom: 0; margin-top: 0.6rem; }
    .carte-title { margin-top: -1.2rem; }   /* rapproche le titre du bloc */
  }
  /* balancement leger « au vent », comme sur la page Accueil */
  @keyframes cveg-a {
    0%, 100% { transform: rotate(-1.5deg); }
    50% { transform: rotate(1.5deg); }
  }
  @keyframes cveg-b {
    0%, 100% { transform: rotate(1.5deg); }
    50% { transform: rotate(-1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cv { animation: none !important; }
  }

  .carte {
    --c-text: #353c4e;
    --c-muted: #6b7183;
    background: #ffffff;
    position: relative;
    z-index: 2;
    margin-top: -1px;   /* couvre la ligne de couture au-dessus du menu */
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 7rem);
  }

  /* Grille editoriale : les categories coulent sur 3 colonnes */
  .carte__cols {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 28px;   /* aligne avec le logo (gauche) et l'icone sociale (droite) */
    columns: 3;
    column-gap: clamp(2.5rem, 5vw, 5.5rem);
  }

  /* Section « les vins » : une seule categorie -> ce sont les ITEMS qui
     coulent sur 3 colonnes (sinon tout reste dans une colonne). */
  .carte--vins { padding-top: clamp(1rem, 2.5vw, 2rem); padding-bottom: clamp(1rem, 2vw, 2rem); }
  .carte--autres { padding-top: clamp(0.4rem, 1.2vw, 1rem); }
  .vins-credit {
    max-width: 1440px;
    margin: clamp(-1rem, -1.5vw, -0.2rem) auto 0;
    padding: 0 28px clamp(0.4rem, 1.2vw, 0.9rem);
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.9vw, 1.5rem);
    line-height: 1.5;
    color: #353c4e;
  }
  .vc-name {
    font-family: var(--font-script);
    color: #ed2289;
    font-size: 1.5em;
    line-height: 1;
  }
  .carte--vins .carte__cols { columns: 1; }
  .carte--vins .cat { break-inside: auto; -webkit-column-break-inside: auto; }
  .carte--vins .cat__items {
    columns: 3;
    column-gap: clamp(2.5rem, 5vw, 5.5rem);
  }
  .carte--vins .dish,
  .carte--vins .dish--sub {
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
  }
  /* un sous-titre ne doit jamais rester seul en bas de colonne :
     il reste collé au vin qui suit (passe en haut de la colonne suivante). */
  .carte--vins .dish--sub {
    break-after: avoid;
    page-break-after: avoid;
    -webkit-column-break-after: avoid;
  }
  @media (max-width: 1024px) { .carte--vins .cat__items { columns: 2; } }
  @media (max-width: 620px) { .carte--vins .cat__items { columns: 1; } }

  /* Ancres : eviter que le header cache le debut de la section */
  #lunch, #carte, #vins, #boissons { scroll-margin-top: 90px; }

  /* Barre mobile d'acces rapide (au-dessus de l'ilot Réserver) */
  .qnav { display: none; }
  @media (max-width: 900px) {
    .qnav {
      display: flex;
      position: fixed;
      left: 14px;
      right: 14px;
      bottom: 88px;
      z-index: 101;   /* au-dessus de l'ombre de l'ilot (100), sous le panneau (110) */
      background: transparent;
      box-shadow: none;
      padding: 0;
      justify-content: center;
      gap: clamp(16px, 7vw, 40px);
    }
    .qnav__item {
      display: flex;
      text-decoration: none;
    }
    .qnav__circle {
      width: 62px;
      height: 62px;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
