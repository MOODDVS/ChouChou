---
// Pagina "Carte" (vetrina, non ordinabile).
// Hero Chouchou: gradiente navy (+ foto admin opzionale), halo magenta,
// script "Comptoir" + titolo, bottone Commander magenta. Corpo: una sezione
// per OGNI categoria del DB (ordine dell'admin), titolo magenta a sinistra,
// piatti su 2 colonne a destra con puntini fino al prezzo e descrizione sotto.
// Prezzi scontati (scope "partout"): pieno barrato + prezzo promo.
// Badge piatto: ★ best-seller (magenta) · 🌱 végan · 🌶️ épicé.
// Allergeni: numeri UE in apice + legenda a fondo pagina.
import Layout from "../layouts/Layout.astro";
import { getMenu, type MenuItem } from "../lib/db";
import { getLunchAttivo } from "../lib/lunch";
import { getLangFromUrl, useTranslations, getLocalizedUrl } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const en = lang === "en";

const menu = await getMenu();

// Lunch del giorno (tab Lunch dell'admin), risolto sui piatti del menù.
const lunch = await getLunchAttivo();
const lunchHaPiatti = !!lunch && lunch.courses.some((c) => (lunch.piatti[c] ?? []).length > 0);
const COURSE_LABEL: Record<string, string> = en
  ? { entree: "Starter", plat: "Main", dessert: "Dessert" }
  : { entree: "Entrée", plat: "Plat", dessert: "Dessert" };
const comboLabel = (parts: string[]) => parts.map((x) => COURSE_LABEL[x] ?? x).join(" + ");
function fmtLunchRange(from: string, to: string): string {
  const loc = en ? "en-GB" : "fr-FR";
  const d1 = new Date(from + "T12:00:00");
  const d2 = new Date(to + "T12:00:00");
  const sameMY = d1.getMonth() === d2.getMonth() && d1.getFullYear() === d2.getFullYear();
  const jour = (d: Date) => d.toLocaleDateString(loc, { day: "numeric" });
  const moisAn = (d: Date) => d.toLocaleDateString(loc, { month: "long", year: "numeric" });
  const complet = (d: Date) => d.toLocaleDateString(loc, { day: "numeric", month: "long", year: "numeric" });
  if (sameMY) return en ? `${jour(d1)}–${jour(d2)} ${moisAn(d2)}` : `Du ${jour(d1)} au ${jour(d2)} ${moisAn(d2)}`;
  return en ? `${complet(d1)} – ${complet(d2)}` : `Du ${complet(d1)} au ${complet(d2)}`;
}
const lunchPeriodo = lunch && lunch.date_from && lunch.date_to ? fmtLunchRange(lunch.date_from, lunch.date_to) : null;

import { siteImages, siteImg } from "../lib/siteImages";
const IMGS = await siteImages();
const HERO_FOTO = siteImg(IMGS, "site_menu_hero", IMGS["site_hero_1"] || "/chouchou-restaurant.webp");
const BRUNCH_FOTO = siteImg(IMGS, "site_brunch", IMGS["site_hero_1"] || "/chouchou-restaurant.webp");
const SOIR_FOTO = siteImg(IMGS, "site_soir_chef", IMGS["site_hero_1"] || "/chouchou-restaurant.webp");

// I 14 allergeni UE — stessi numeri usati dall'admin.
const ALLERGENI: [number, string][] = en
  ? [
      [1, "Gluten"], [2, "Milk"], [3, "Peanuts"], [4, "Eggs"],
      [5, "Fish"], [6, "Crustaceans"], [7, "Soy"], [8, "Tree nuts"],
      [9, "Celery"], [10, "Mustard"], [11, "Sulphites"], [12, "Sesame"],
      [13, "Lupin"], [14, "Molluscs"],
    ]
  : [
      [1, "Gluten"], [2, "Lait"], [3, "Arachides"], [4, "Œufs"],
      [5, "Poisson"], [6, "Crustacés"], [7, "Soja"], [8, "Fruits à coque"],
      [9, "Céleri"], [10, "Moutarde"], [11, "Sulfites"], [12, "Sésame"],
      [13, "Lupin"], [14, "Mollusques"],
    ];

function prezzo(cents: number): string {
  const euro = cents / 100;
  return Number.isInteger(euro) ? `${euro} €` : `${euro.toFixed(2).replace(".", ",")} €`;
}

function descDi(item: { description_fr: string | null; description_en: string | null }): string | null {
  return en ? (item.description_en || item.description_fr) : item.description_fr;
}

// Convention admin : une voce dont le Nom commence par "-" devient un
// sous-titre de section (pas de prix, pas de description-plat). Etiquette
// FR = Nom sans le "-", EN = Description EN (sinon FR).
function sottotitoloDi(item: { name: string; description_en: string | null }): string | null {
  const nome = (item.name ?? "").trim();
  if (!nome.startsWith("-")) return null;
  const fr = nome.replace(/^-+\s*/, "").trim();
  const enTxt = (item.description_en ?? "").replace(/^-+\s*/, "").trim();
  return en ? (enTxt || fr) : fr;
}

// --- Raggruppamenti: più categorie consecutive sotto un unico titolo
// grande, ciascuna col suo titoletto (per range di category_order):
// Pizza = rouges/blanches/calzone/suppléments (4..7)
// Bières = pression/bouteilles (14..15)
// Vins = du patron/rouges/blancs/rosé (16..19)
// Le altre categorie restano sezioni singole.
// Nessun raggruppamento fisso: ogni categoria dell'admin resta una sezione
// col suo titolo. (Struttura ChouChou, non più La Molisana.)
const RAGGRUPPAMENTI: { title: string; min: number; max: number }[] = [];
const gruppi: { title: string; subcats: typeof menu }[] = [];
for (const cat of menu) {
  const r = RAGGRUPPAMENTI.find((x) => cat.category_order >= x.min && cat.category_order <= x.max);
  const last = gruppi[gruppi.length - 1];
  if (r && last && last.title === r.title) {
    last.subcats.push(cat);
  } else {
    gruppi.push({ title: r ? r.title : cat.category, subcats: [cat] });
  }
}

// --- Ordine di visualizzazione della carta (richiesta Enzo):
// cibo e desserts nell'ordine dell'admin, poi Apéritifs, Softs,
// Bières, Vins, il resto (Long drinks, Alcools) e Boissons chaudes
// in fondo. Basato sul category_order della prima sottocategoria.
function rango(g: { subcats: typeof menu }): number {
  // Ordine di visualizzazione = quello impostato nell'admin (category_order).
  return g.subcats[0].category_order;
}
gruppi.sort((a, b) => rango(a) - rango(b));

// Detection des BOISSONS par nom de categorie (robuste a l'ordre admin).
const BEVANDA_WORDS = new Set([
  "aperitif", "aperitifs", "apero", "aperos", "boisson", "boissons", "boire",
  "bulle", "bulles", "champagne", "cremant", "mousseux", "petillant", "petillants", "prosecco",
  "vin", "vins", "cocktail", "cocktails", "mocktail", "mocktails",
  "soft", "softs", "soda", "sodas", "limonade", "limonades", "sirop", "sirops", "jus",
  "biere", "bieres", "eau", "eaux",
  "cafe", "cafes", "the", "thes", "infusion", "infusions", "chaud", "chaude", "chaudes",
  "digestif", "digestifs", "spiritueux", "gin", "whisky", "rhum", "vodka", "liqueur", "liqueurs",
  "alcool",
]);
function isBevandaCat(name: string): boolean {
  const norm = (name ?? "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  return norm.split(/[^a-z0-9]+/).filter(Boolean).some((t) => BEVANDA_WORDS.has(t));
}
function isBevandaG(g: { subcats: typeof menu }): boolean {
  // Sotto-categoria bevanda per nome OPPURE per categoria radice (Vins, Bières…).
  return g.subcats.some((sc) => isBevandaCat(sc.category) || isBevandaCat(sc.root ?? ""));
}

// À la carte = uniquement la nourriture (les boissons, category_order >= 9,
// iront dans une section « boissons » dédiée plus bas).
const gruppiCibo = gruppi
  .map((g, i) => ({ g, i }))
  .filter(({ g }) => !isBevandaG(g));
// Boissons = categorie reconnue par son nom (Apéritifs, Softs, Vins, …).
const gruppiBibite = gruppi
  .map((g, i) => ({ g, i }))
  .filter(({ g }) => isBevandaG(g));
// Vins = categorie dont le nom contient « vin » (Vin rouge/rosé/blanc, Vins).
const VIN_WORDS = new Set(["vin", "vins"]);
function isVinCat(name: string): boolean {
  const norm = (name ?? "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  return norm.split(/[^a-z0-9]+/).filter(Boolean).some((t) => VIN_WORDS.has(t));
}
const isVinG = (g: { subcats: typeof menu }) =>
  g.subcats.some((sc) => isVinCat(sc.category) || isVinCat(sc.root ?? ""));
const gruppiVini = gruppiBibite.filter(({ g }) => isVinG(g));
// Toutes les autres boissons (apéritifs, bières, softs, boissons chaudes…).
const gruppiAltreBibite = gruppiBibite.filter(({ g }) => !isVinG(g));

// --- Vins : fondus en UN SEUL flux qui coule sur 3 colonnes. Chaque
// sous-catégorie du moteur (Vin rouge, Vin rosé, Nos suggestions au verre…)
// devient un sous-titre, suivi de ses vins. On restaure la mise en page 3
// colonnes malgré la nouvelle hiérarchie de sous-catégories.
type VinoRiga = { tipo: "head"; label: string } | { tipo: "dish"; item: MenuItem };
const vinoRighe: VinoRiga[] = [];
for (const { g } of gruppiVini) {
  for (const sub of g.subcats) {
    const label = (en ? (sub.name_i18n?.[lang] ?? sub.category) : sub.category) ?? sub.category;
    vinoRighe.push({ tipo: "head", label });
    for (const item of sub.items) {
      const st = sottotitoloDi(item);
      vinoRighe.push(st ? { tipo: "head", label: st } : { tipo: "dish", item });
    }
  }
}

// --- Boissons (non vin) regroupées par catégorie RACINE : chaque famille
// (Apéritifs, Bières, Softs, Boissons chaudes…) devient un TITRE, ses
// sous-catégories du moteur deviennent des sous-titres, puis les items.
type BoissonSub = { label: string | null; items: MenuItem[]; note?: string };
type BoissonFamiglia = { root: string; title: string; ordine: number; subs: BoissonSub[] };
const boissonMappa = new Map<string, BoissonFamiglia>();
for (const { g } of gruppiAltreBibite) {
  for (const sub of g.subcats) {
    const root = sub.root ?? sub.category;
    if (!boissonMappa.has(root)) {
      const titolo = (en ? (sub.root_i18n?.[lang] ?? root) : root) ?? root;
      boissonMappa.set(root, { root, title: titolo, ordine: sub.category_order, subs: [] });
    }
    const fam = boissonMappa.get(root)!;
    fam.ordine = Math.min(fam.ordine, sub.category_order);
    const isRoot = sub.category === root;
    const label = isRoot ? null : ((en ? (sub.name_i18n?.[lang] ?? sub.category) : sub.category) ?? sub.category);
    const nn = sub.category.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    const note = nn.includes("cocktail")
      ? (en ? "And the classics: Aperol, Pisang, etc." : "Et les classiques Apérol, Pisang, etc")
      : undefined;
    fam.subs.push({ label, items: sub.items, note });
  }
}
// Ordine delle famiglie richiesto da Enzo : Apéritifs, Bières, Softs,
// Digestifs (à venir), Boissons chaudes. Altre famiglie eventuali : dopo.
function rangoBoisson(fam: BoissonFamiglia): number {
  const n = (fam.root ?? "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  if (n.includes("aperitif") || n.includes("apero")) return 1;
  if (n.includes("biere")) return 2;
  if (n.includes("soft")) return 3;
  if (n.includes("digestif")) return 4;
  if (n.includes("chaud")) return 5;
  return 9;
}
const gruppiBoissoni = Array.from(boissonMappa.values())
  .sort((a, b) => rangoBoisson(a) - rangoBoisson(b) || a.ordine - b.ordine);

// Vin orange : répété aussi en tête des apéritifs (au verre) — demande Enzo.
const vinoArancione: MenuItem[] = [];
for (const { g } of gruppiVini) {
  for (const sub of g.subcats) {
    const n = sub.category.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    if (n.includes("orange")) {
      for (const it of sub.items) { if (!sottotitoloDi(it)) vinoArancione.push(it); }
    }
  }
}
const famApero = gruppiBoissoni.find((f) => {
  const n = (f.root ?? "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  return n.includes("aperitif") || n.includes("apero");
});
if (famApero && vinoArancione.length) {
  famApero.subs.unshift({ label: null, items: vinoArancione });
}

