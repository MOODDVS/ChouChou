<Layout title={en ? "Menu, Comptoir Chouchou" : "Carte, Comptoir Chouchou"}>
  <div class="chou">
  <section class="menu-hero">
    <div class="menu-hero__bg" aria-hidden="true"></div>
    <img class="menu-hero__photo" src={HERO_FOTO} alt="" loading="eager" decoding="async" onerror="this.remove()" />
    <div class="menu-hero__overlay" aria-hidden="true"></div>
    <div class="menu-hero__glow" aria-hidden="true"></div>

    <div class="menu-hero__inner">
      <h1 class="menu-hero__title">{t("menu.title")}</h1>
      <p class="menu-hero__sub">
        {en
          ? "Creative, homemade plates, in tune with the seasons and local producers."
          : "Des assiettes créatives et faites maison, au rythme des saisons et des producteurs d'ici."}
      </p>
    </div>
  </section>

  <section class="lunch-band" id="lunch" aria-label="le lunch">
    <span class="lunch-txt">{en ? "the lunch" : "le lunch"}</span>
    <span class="lunch-sub">{en ? "New menu every week" : "nouveau menu chaque semaine"}</span>
    {lunch && (lunchHaPiatti || lunch.combos.length > 0) && (
      <div class="lunch-in">
        {lunchPeriodo && <p class="lunch-kicker">{lunchPeriodo}</p>}
        {lunchHaPiatti && (
          <div class="lunch-cols">
            {lunch.courses.filter((c) => (lunch.piatti[c] ?? []).length > 0).map((c) => (
              <div class="lunch-col">
                <h3 class="lunch-col__t">{COURSE_LABEL[c]}</h3>
                <ul class="lunch-dishes">
                  {(lunch.piatti[c] ?? []).map((pt) => (
                    <li class="lunch-dish">
                      <span class="lunch-dish__n">{en ? (pt.name_i18n?.en ?? pt.name) : pt.name}</span>
                      {descDi(pt) && <span class="lunch-dish__d">{descDi(pt)}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
        {lunch.combos.length > 0 && (
          <p class="lunch-prices">
            {lunch.combos.map((cb) => (
              <span class="lunch-price">
                <span class="lunch-price__l">{comboLabel(cb.parts)}</span>
                <span class="lunch-price__v">{prezzo(cb.price_cents)}</span>
              </span>
            ))}
          </p>
        )}
      </div>
    )}
  </section>

  <section class="carte-band" id="carte">
    <div class="carte-band__in">
      <div class="carte-veg" aria-hidden="true">
        <span class="cv cv-6"></span>
        <span class="cv cv-7"></span>
        <span class="cv cv-5"></span>
        <span class="cv cv-4"></span>
      </div>
      <h2 class="carte-title">à la carte</h2>
    </div>
  </section>

  <div class="carte">
    <div class="carte__cols">
    {gruppiCibo.map(({ g, i }) => (
      <section class="cat" id={"sec-" + i}>
        <div class="cat__head">
          <h2 class="cat__title">{en ? (g.subcats[0].name_i18n?.en ?? g.title) : g.title}</h2>
        </div>
        <div class="cat__body">
          {g.subcats.map((sub) => (
            <div class="subcat">
              {g.subcats.length > 1 && <h3 class="cat__subtitle">{en ? (sub.name_i18n?.en ?? sub.category) : sub.category}</h3>}
              <ul class="cat__items">
                {sub.items.map((item) => {
                  const _st = sottotitoloDi(item);
                  return _st ? (
                    <li class="dish dish--sub"><h4 class="cat__subhead">{_st}</h4></li>
                  ) : (
                  <li class="dish">
                    <p class="dish__head">
                      <span class="dish__name">
                        {item.name}
                        {item.is_bestseller && <span class="b b-star" title="Coup de cœur">♥</span>}
                        {item.is_vegan && <span class="b" title={en ? "Vegan" : "Végan"}>🌱</span>}
                        {item.is_spicy && <span class="b" title={en ? "Spicy" : "Épicé"}>🌶️</span>}
                        {item.is_suggestion && <span class="b-sugg">Suggestion</span>}
                        {item.is_seasonal && <span class="b" title={en ? "Seasonal" : "Saisonnier"}>🍂</span>}
                        {item.allergens.length > 0 && (
                          <sup class="dish__alg">{item.allergens.join("·")}</sup>
                        )}
                      </span>
                      <span class="dish__dots" aria-hidden="true"></span>
                      {item.price_cents > 0 && (
                        <span class="dish__price">
                          {item.original_price_cents && (
                            <s class="dish__old">{prezzo(item.original_price_cents)}</s>
                          )}
                          {prezzo(item.price_cents)}
                        </span>
                      )}
                    </p>
                    {descDi(item) && <p class="dish__desc">{descDi(item)}</p>}
                  </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}
    </div>

    <section class="alg-legend">
      <h2 class="alg-legend__title">{en ? "Allergens" : "Allergènes"}</h2>
      <p class="alg-legend__list">
        {ALLERGENI.map(([n, label]) => `${n}. ${label}`).join(" · ")}
      </p>
    </section>
  </div>

  <section class="brunch brunch--soir" aria-label="Un soir, un chef">
