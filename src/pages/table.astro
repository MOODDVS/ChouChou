---
/**
 * ORDINARE DAL PROPRIO TAVOLO — la pagina del QR, versione AUTONOMA.
 *
 * Il cliente inquadra il cartoncino sul tavolo, sceglie dal menu della sala,
 * poi dice chi e' e in quanti sono, e paga. A servizio chiuso vede subito
 * quando riapre, invece di scoprirlo dopo aver composto la cena. Due QR
 * possibili, e questa pagina li regge entrambi:
 *   /table           il QR generico (volantino, bancone): il tavolo si scegle
 *   /table?table=7   il QR stampato PER quel tavolo: arriva gia' scelto
 *
 * TUTTO IL CONTENUTO sta in `components/PaginaTavolo.astro` (del motore).
 * Qui c'e' solo il guscio: `<html>`, i colori dei Réglages sul corpo, e il
 * 404 a sala spenta — che un componente non puo' dare.
 *
 * ⚠️ QUESTA PAGINA E' DEL CLIENTE (`src/pages/**` sta in `.gitattributes`
 * come `merge=ours`). Il motore la consegna funzionante: un cliente che ha un
 * sito la sostituisce con una che mette `PaginaTavolo` dentro il suo
 * `<Layout>` — header e switch lingua del sito — e ne aggiunge una per lingua
 * (`/en/table`, `/it/table`…). Vedi ENGINE.md. Il blocco si aggiorna da solo.
 */
import { ambitoPubblicoChiesto } from "../lib/admin/sede";
import { opzioniTavolo } from "../lib/ordiniOpzioni";
import { brandPubblico, coloreTema } from "../lib/brandPubblico";
import { getLangFromUrl } from "../i18n/ui";
import Fonts from "../components/Fonts.astro";
import PaginaTavolo from "../components/PaginaTavolo.astro";

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const ambito = await ambitoPubblicoChiesto(Astro.request);
const sala = await opzioniTavolo(ambito);
/* ⚠️ Sala spenta → 404, non una pagina che spiega. Il QR resta incollato al
   tavolo per mesi: se un ristoratore spegne gli ordini dal locale, chi
   inquadra deve trovare «questa pagina non c'e'», non un modulo che poi
   rifiuta l'ordine dopo che ha composto la cena. */
if (!sala.attivo) return new Response(null, { status: 404 });

const brand = await brandPubblico(ambito);
const cBg = coloreTema(brand.tema, "bg");
/* Il fondo e il testo anche sul CORPO: il blocco e' largo 34rem, e da solo
   lasciava bianco tutt'intorno — su un tablet sembrava una pagina rotta. */
const stileTema = `--tbl-bg:${cBg};--tbl-text:${coloreTema(brand.tema, "text")}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* ⚠️ `noindex`: la pagina del QR non deve finire su Google. Chi la
        trovasse cercando il ristorante aprirebbe un tavolo da casa. */}
    <meta name="robots" content="noindex, nofollow" />
    <title>{brand.nome}</title>
    <meta name="theme-color" content={cBg} />
    <link rel="icon" href={brand.favicon} />
    <Fonts />
  </head>
  <body style={stileTema}>
    <main>
      <PaginaTavolo ambito={ambito} sala={sala} brand={brand} />
    </main>
    <style is:global>
      /* I ripieghi se la lettura dei Réglages non riesce: sobria e leggibile,
         mai bianco su bianco. L'attributo `style` qui sopra li sovrascrive. */
      body { --tbl-bg: #fff; --tbl-text: #1b1b1b;
             margin: 0; min-height: 100dvh;
             background: var(--tbl-bg); color: var(--tbl-text);
             font-family: var(--font-body); }
    </style>
  </body>
</html>
