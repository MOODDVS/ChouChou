---
/**
 * ORDINARE DAL PROPRIO TAVOLO — la pagina del QR.
 *
 * Il cliente inquadra il cartoncino sul tavolo, sceglie dal menu della sala,
 * poi dice chi e' e in quanti sono, e paga. A servizio chiuso vede subito
 * quando riapre, invece di scoprirlo dopo aver composto la cena. Due QR
 * possibili, e questa pagina li regge entrambi:
 *   /table           il QR generico (volantino, bancone): il tavolo si scegle
 *   /table?table=7   il QR stampato PER quel tavolo: arriva gia' scelto
 *
 * ⚠️ QUESTA PAGINA E' DEL CLIENTE (`src/pages/**` sta in `.gitattributes`
 * come `merge=ours`). Il motore la consegna funzionante e non la riscrive
 * mai piu': un cliente che la rifa' col suo disegno tiene la sua a ogni
 * merge, e non si prende un conflitto a ogni giro. Cio' che resta del motore
 * e' quello che conta — `TableOrder`, `OrderApp`, `/api/table-session`,
 * `/api/checkout` — e quello si aggiorna da solo.
 *
 * ⚠️ LO STILE E' QUELLO DEL SITO. Qui sotto c'e' solo il vestito delle classi
 * `tbl-*`, che sono nuove e nessun cliente ha ancora. Il menu e il carrello
 * usano le classi `order-*`, che il sito pubblico veste gia' per /order: su
 * un'installazione che quel CSS non ce l'ha, la pagina FUNZIONA e si vede
 * spoglia — che e' il modo giusto di sbagliare.
 */
import { ambitoPubblicoChiesto } from "../lib/admin/sede";
import { opzioniTavolo, modiDiPagamento, tavoliDiSala, statoServizioSala } from "../lib/ordiniOpzioni";
import { getMenuSala } from "../lib/db";
import { getLangFromUrl, useTranslations } from "../i18n/ui";
import TableOrder from "../components/TableOrder";
import type { TestiSessione } from "../components/TableOrder";
import Fonts from "../components/Fonts.astro";
/* ⚠️ Il vestito di BASE di menu e carrello (`order-*`): senza, la carta usciva
   coi bottoni grigi del sistema. Vale zero di specificita' — qualunque regola
   del sito vince — quindi un sito che ha gia' vestito /order non perde niente.
   Una pagina che lo toglie deve vestire `order-*` da se'. */
import "../components/TableOrder.css";
import { brandPubblico, coloreTema } from "../lib/brandPubblico";

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const sede = (Astro.url.searchParams.get("sede") ?? "").trim();
const tavoloDaUrl = (Astro.url.searchParams.get("table") ?? "").trim().slice(0, 40);
/* Ritorno da Stripe col tasto «indietro»: si riapre sui dati, non sul menu. */
const ripresa = Astro.url.searchParams.get("ripresa") === "1";

const ambito = await ambitoPubblicoChiesto(Astro.request);
const sala = await opzioniTavolo(ambito);
/* ⚠️ Sala spenta → 404, non una pagina che spiega. Il QR resta incollato al
   tavolo per mesi: se un ristoratore spegne gli ordini dal locale, chi
   inquadra deve trovare «questa pagina non c'e'», non un modulo che poi
   rifiuta l'ordine dopo che ha composto la cena. */
if (!sala.attivo) return new Response(null, { status: 404 });

const [menu, pagamento, brand, tavoli, servizio] = await Promise.all([
  getMenuSala(ambito),
  modiDiPagamento(ambito),
  brandPubblico(ambito),
  /* ⚠️ L’ELENCO, non un «ci sono i tavoli: sì/no». Un campo libero al tavolo
     produce «7», «tavolo 7», «7 terrazza» e «8» battuto per sbaglio: il
     server rifiuta i primi tre e accetta il quarto, che e’ il peggiore — i
     piatti partono per un tavolo dove siede qualcun altro. Da una tendina si
     puo’ scegliere solo un tavolo che esiste. */
  tavoliDiSala(ambito),
  /* ⚠️ APERTO O CHIUSO SI DECIDE QUI, prima di mostrare il menu, con la
     stessa regola delle due rotte (`statoServizioSala`, nel motore). Prima
     lo si scopriva solo al momento di pagare: il cliente componeva la cena
     e poi leggeva «fermé». */
  statoServizioSala(ambito),
]);

/* ⚠️ IL VESTITO VIENE DAI REGLAGES DEL CLIENTE, non dal motore. Logo,
   nome e colori sono quelli che il ristoratore ha gia’ messo: una pagina del
   motore non ha un design suo, e non deve averne uno. Senza questa riga la
   pagina esce in Times New Roman su fondo bianco — tecnicamente giusta, e per
   chi inquadra il QR seduto al tavolo e’ il sito di nessuno.
   ⚠️ E restano VARIABILI: il cliente che rifa’ questa pagina, o che scrive
   una riga nel suo foglio di stile, vince su tutto senza toccare il motore. */
const cBg = coloreTema(brand.tema, "bg");
const cText = coloreTema(brand.tema, "text");
const cMuted = coloreTema(brand.tema, "muted");
const cLine = coloreTema(brand.tema, "line");
/* Il fondo dei quadrati: su un fondo scuro un bordo sottile sparisce. */
const cCard = coloreTema(brand.tema, "card");
/* Il fondo dei campi: piu’ scuro della pagina, cosi’ si vede dove si scrive. */
const cCampo = coloreTema(brand.tema, "input");
const cAccent = coloreTema(brand.tema, "accent");
/**
 * Le variabili del tema, da mettere sul CORPO della pagina.
 *
 * ⚠️ SUL CORPO, non sul blocco centrale: li’ il fondo si fermava a 34rem di
 * larghezza e lasciava bianco tutt’intorno. Su un telefono si vede poco, su un
 * tablet appoggiato al bancone si vede benissimo, e sembra una pagina rotta.
 *
 * ⚠️ E la spiegazione sta QUI e non accanto al tag: fra la testa e il corpo
 * della pagina Astro non accetta un’espressione, e un commento messo li’ fa
 * smettere di compilare tutto il file.
 */
const stileTema = [
  `--tbl-bg:${cBg}`, `--tbl-text:${cText}`, `--tbl-muted:${cMuted}`,
  `--tbl-line:${cLine}`, `--tbl-card:${cCard}`, `--tbl-campo:${cCampo}`,
  /* Il testo sui bottoni d’accento e’ il fondo pagina: e’ la regola che il
     tema dichiara da se’ (vedi `TEMA_DEFAULT`), non una scelta presa qui. */
  `--tbl-ink:${cAccent}`, `--tbl-paper:${cBg}`,
].join(";");

/**
 * LE PAROLE DELLA PRIMA SCHERMATA, qui e non nel dizionario pubblico.
 *
 * ⚠️ E’ UNA SCELTA, e ha un motivo preciso: `src/i18n/**` e’ del cliente
 * (`merge=ours`), quindi una chiave nuova messa in `fr.json` dal motore NON
 * arriverebbe mai a nessuno — `t("...")` renderebbe la chiave, e sul tavolo
 * si leggerebbe «table.intro». Stando nella pagina, le parole viaggiano col
 * file che le usa: arrivano insieme, o non arriva nessuno dei due.
 *
 * Cinque lingue perche’ tante sono quelle pubbliche del motore; un sito che
 * ne ha due usa le sue due, e qualunque altra ripiega sul francese.
 */
const TESTI: Record<string, TestiSessione> = {
  fr: {
    titolo: "Commander à table",
    tavolo: "Votre table", tavoloAiuto: "Le numéro inscrit sur la table",
    persone: "Vous êtes combien ?",
    passo1: "Votre choix", passo2: "Vos infos", passo3: "Paiement",
    scegli: "Choisir", cambia: "Changer", chiudi: "Fermer", scegliTavolo: "Choisissez votre table…",
    errCampi: "Vérifiez les champs.", errChiuso: "Le service vient de se terminer.",
    errTavolo: "Cette table n’existe pas. Vérifiez le numéro.",
    errGenerico: "Impossible d’enregistrer la table. Réessayez.",
    chiusoTitolo: "Nous sommes fermés", chiusoRiapre: "Nous rouvrons aujourd’hui à {ora}.",
    chiusoOggi: "Le service est terminé pour aujourd’hui.", aggiorna: "Actualiser",
    nonDisponibileTitolo: "Commande indisponible", nonDisponibileTesto: "La commande depuis la table n’est pas disponible pour le moment. Un membre de l’équipe peut prendre votre commande.",
  },
  en: {
    titolo: "Order from your table",
    tavolo: "Your table", tavoloAiuto: "The number written on the table",
    persone: "How many of you?",
    passo1: "Your choice", passo2: "Your details", passo3: "Payment",
    scegli: "Choose", cambia: "Change", chiudi: "Close", scegliTavolo: "Choose your table…",
    errCampi: "Please check the fields.", errChiuso: "Service has just ended.",
    errTavolo: "That table doesn’t exist. Check the number.",
    errGenerico: "Could not register the table. Please try again.",
    chiusoTitolo: "We’re closed", chiusoRiapre: "We reopen today at {ora}.",
    chiusoOggi: "Service is over for today.", aggiorna: "Refresh",
    nonDisponibileTitolo: "Ordering unavailable", nonDisponibileTesto: "Ordering from the table isn’t available right now. A member of staff can take your order.",
  },
  it: {
    titolo: "Ordina dal tavolo",
    tavolo: "Il tuo tavolo", tavoloAiuto: "Il numero scritto sul tavolo",
    persone: "In quanti siete?",
    passo1: "La scelta", passo2: "I tuoi dati", passo3: "Pagamento",
    scegli: "Scegli", cambia: "Cambia", chiudi: "Chiudi", scegliTavolo: "Scegli il tuo tavolo…",
    errCampi: "Controlla i campi.", errChiuso: "Il servizio è appena terminato.",
    errTavolo: "Questo tavolo non esiste. Controlla il numero.",
    errGenerico: "Non riesco a registrare il tavolo. Riprova.",
    chiusoTitolo: "Siamo chiusi", chiusoRiapre: "Riapriamo oggi alle {ora}.",
    chiusoOggi: "Il servizio di oggi è terminato.", aggiorna: "Aggiorna",
    nonDisponibileTitolo: "Ordine non disponibile", nonDisponibileTesto: "L’ordine dal tavolo non è disponibile al momento. Il personale può prendere la tua ordinazione.",
  },
  nl: {
    titolo: "Bestellen aan tafel",
    tavolo: "Uw tafel", tavoloAiuto: "Het nummer op de tafel",
    persone: "Hoeveel bent u?",
    passo1: "Uw keuze", passo2: "Uw gegevens", passo3: "Betaling",
    scegli: "Kiezen", cambia: "Wijzigen", chiudi: "Sluiten", scegliTavolo: "Kies uw tafel…",
    errCampi: "Controleer de velden.", errChiuso: "De service is net afgelopen.",
    errTavolo: "Die tafel bestaat niet. Controleer het nummer.",
    errGenerico: "Kan de tafel niet registreren. Probeer opnieuw.",
    chiusoTitolo: "We zijn gesloten", chiusoRiapre: "We gaan vandaag weer open om {ora}.",
    chiusoOggi: "De service is voor vandaag afgelopen.", aggiorna: "Vernieuwen",
    nonDisponibileTitolo: "Bestellen niet beschikbaar", nonDisponibileTesto: "Bestellen vanaf de tafel is momenteel niet beschikbaar. Een medewerker kan uw bestelling opnemen.",
  },
  es: {
    titolo: "Pedir en la mesa",
    tavolo: "Su mesa", tavoloAiuto: "El número escrito en la mesa",
    persone: "¿Cuántos son?",
    passo1: "Su elección", passo2: "Sus datos", passo3: "Pago",
    scegli: "Elegir", cambia: "Cambiar", chiudi: "Cerrar", scegliTavolo: "Elija su mesa…",
    errCampi: "Revise los campos.", errChiuso: "El servicio acaba de terminar.",
    errTavolo: "Esa mesa no existe. Revise el número.",
    errGenerico: "No se puede registrar la mesa. Inténtelo de nuevo.",
    chiusoTitolo: "Estamos cerrados", chiusoRiapre: "Volvemos a abrir hoy a las {ora}.",
    chiusoOggi: "El servicio de hoy ha terminado.", aggiorna: "Actualizar",
    nonDisponibileTitolo: "Pedido no disponible", nonDisponibileTesto: "Pedir desde la mesa no está disponible en este momento. El personal puede tomar su pedido.",
  },
};

/* ⚠️ «Remplissez tous les champs, CHOISISSEZ UNE HEURE…» e' la frase di
   /order: al tavolo un'ora da scegliere non c'e', e chi la legge cerca un
   campo che non esiste. Qui la stessa richiesta, senza l'ora. */
const RIEMPI: Record<string, string> = {
  fr: "Remplissez tous les champs pour commander.",
  en: "Fill in all the fields to order.",
  it: "Compila tutti i campi per ordinare.",
  nl: "Vul alle velden in om te bestellen.",
  es: "Complete todos los campos para pedir.",
};

/* Il perche' dell'email obbligatoria, sotto il campo di OrderApp. Sta fuori
   da `TESTI` perche' non e' di questa pagina: lo mostra OrderApp, che lo
   riceve fra le sue parole (`emailWhyRequired`). */
const EMAIL_PERCHE: Record<string, string> = {
  fr: "Pour vous prévenir quand c’est prêt",
  en: "So we can tell you when it’s ready",
  it: "Per avvisarti quando è pronto",
  nl: "Om u te verwittigen als het klaar is",
  es: "Para avisarle cuando esté listo",
};

/* ⚠️ Le persone e il nome stanno sotto `book.*`, non `order.*`: sono le
   stesse parole del widget prenotazioni, e il dizionario pubblico le ha
   solo la'. Inventarne di nuove vorrebbe dire due traduzioni della stessa
   parola, e il giorno che il cliente cambia una delle due la pagina
   mostrerebbe l'altra. */
const testiOrdine = {
  cartTitle: t("order.cartTitle"),
  cartEmpty: t("order.cartEmpty"),
  recap: t("order.recap"),
  yourInfo: t("order.yourInfo"),
  pickupTime: t("order.pickupTime"),
  notes: t("order.notes"),
  notesPlaceholder: t("order.notesPlaceholder"),
  coupon: t("order.coupon"),
  couponPlaceholder: t("order.couponPlaceholder"),
  couponApply: t("order.couponApply"),
  couponRemove: t("order.couponRemove"),
  couponInvalid: t("order.couponInvalid"),
  subtotal: t("order.subtotal"),
  discount: t("order.discount"),
  total: t("order.total"),
  items: t("order.items"),
  toCheckout: t("order.toCheckout"),
  pay: t("order.pay"),
  paying: t("order.paying"),
  backToMenu: t("order.backToMenu"),
  seeCart: t("order.seeCart"),
  fillAll: RIEMPI[lang] ?? RIEMPI.fr,
  errPayment: t("order.errPayment"),
  errConnection: t("order.errConnection"),
  firstName: t("book.firstName"),
  lastName: t("book.lastName"),
  phone: t("book.phone"),
  email: t("book.email"),
  ariaIncrease: t("order.aria.increase"),
  ariaDecrease: t("order.aria.decrease"),
  ariaRemove: t("order.aria.remove"),
  ariaAdd: t("order.aria.add"),
  tabBoissons: t("order.tab.boissons"),
  /* ⚠️ Non si usano, e ci sono: `closedToday` la pagina non la accende mai
     — a servizio chiuso il menu non si monta nemmeno, e lo dice il modale
     di `TableOrder` — ma la prop e' obbligatoria e una stringa vuota in
     un'interfaccia e' peggio di una parola giusta mai mostrata. */
  closedToday: t("slot.closed"),
  reopenInfo: "",
  consentPre: t("book.consentPre"),
  consentLink: t("book.consentLink"),
  privacyHref: t("footer.privacy"),
  emailWhyRequired: EMAIL_PERCHE[lang] ?? EMAIL_PERCHE.fr,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* ⚠️ `noindex`: la pagina del QR non deve finire su Google. Chi la
        trovasse cercando il ristorante aprirebbe un tavolo da casa. */}
    <meta name="robots" content="noindex, nofollow" />
    <title>{brand.nome}</title>
    <meta name="theme-color" content={cBg} />
    <link rel="icon" href={brand.favicon} />
    <Fonts />
  </head>
  <body style={stileTema}>
    <main class="tbl-main">
      {/* ⚠️ QUI VA L’INTESTAZIONE DEL SITO, e il motore non ne ha una: il
          logo, il menu e i colori del locale vivono nel `Layout` del cliente,
          che questa pagina non puo’ importare — nel motore quel file non
          esiste e la pagina non compilerebbe. Il cliente sostituisce il guscio
          `<html>` col suo `<Layout>` (vedi ENGINE.md), e da quel momento
          l’intestazione compare sopra il percorso senza toccare l’isola.
          Finche’ non lo fa, la pagina comincia dai passi: nuda, e giusta. */}
      {/* `sceltaFormato="modale"`: un piatto con piu' formati apre la scheda
          con la foto e i formati da scegliere, invece di una fila di bottoni
          dentro la riga — al tavolo, su un telefono, la fila andava a capo e
          i prezzi si leggevano male. `foto`: la foto compare solo sui piatti
          che ne hanno una, mai un riquadro vuoto. `carrelloDettagliato`: nel
          riepilogo la foto del piatto, il formato a parte e il prezzo unitario
          — questa pagina ha gia' lo stile pronto (`TableOrder.css`). Tutte e due scelte di
          QUESTA pagina, che e' del cliente: le cambia senza toccare il motore. */}
      <TableOrder
        client:load
        menu={menu}
        testiOrdine={testiOrdine}
        testi={TESTI[lang] ?? TESTI.fr}
        lang={lang}
        sede={sede}
        tavoli={tavoli}
        avvisa={sala.avvisa}
        tavoloDaUrl={tavoloDaUrl}
        ripresa={ripresa}
        chiuso={pagamento.nessuno
          ? { riapre: null, motivo: "pagamento" }
          : servizio.aperto ? null : { riapre: servizio.riapre, motivo: "orario" }}
        immagine={brand.immagine}
        sceltaFormato="modale"
        foto={true}
        carrelloDettagliato={true}
        pagamento={pagamento}
      />
    </main>
    {/* ⚠️ `is:global`, E NON E’ PIGRIZIA. Astro marca con `data-astro-…`
        solo gli elementi del SUO template; questo modulo lo disegna React
        dentro l’isola, quindi uno stile «scoped» non combacia con niente e la
        pagina esce nuda — senza un errore da nessuna parte, in Astro o in
        console. E’ lo stesso motivo per cui `reservation.astro` e
        `ReservationWidget.astro` fanno gia’ cosi’. */}
    <style is:global>
      /* Il vestito delle sole classi NUOVE. Il resto della pagina usa le
         `order-*` del sito, che il cliente veste gia' per /order. */
      /* ⚠️ DUE VARIABILI, NON DUE COLORI SCRITTI DENTRO. Il motore non
         conosce la tavolozza di questo sito, e non deve imporgliene una: qui
         ci sono due neutri che servono solo a far vedere qualcosa il primo
         giorno. Il cliente li cambia dal SUO foglio di stile con una riga —
         `.tbl-main { --tbl-ink: var(--mio-accento); }` — senza toccare questa
         pagina, quindi senza nessun conflitto al merge. */
      /* ⚠️ I ripieghi stanno QUI, non nei valori scritti sopra: se la lettura
         dei Reglages non riesce, la pagina deve uscire sobria e leggibile —
         mai bianco su bianco. L’attributo `style` del <main> li sovrascrive
         quando il brand c’e’. */
      body { --tbl-bg: #fff; --tbl-text: #1b1b1b; --tbl-muted: #6b6b6b;
             --tbl-line: #c9c9c9; --tbl-ink: #1b1b1b; --tbl-paper: #fff; --tbl-card: #f2f2f2; --tbl-campo: #f7f7f7;
             margin: 0; min-height: 100dvh;
             background: var(--tbl-bg); color: var(--tbl-text);
             font-family: var(--font-body); }
      .tbl-main { max-width: 34rem; margin: 0 auto; padding: 1.2rem 1rem 1.5rem; }
      /* IL PERCORSO IN TRE PASSI. ⚠️ In cima a tutto, logo compreso: chi
         inquadra un QR non sa cosa succede dopo, e il primo dubbio («mi stanno
         chiedendo di pagare adesso?») e’ quello che fa chiudere la pagina. */
      .tbl-passi { display: flex; gap: .4rem; list-style: none; margin: 0 0 1.4rem; padding: 0; }
      .tbl-passo { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; gap: .35rem;
                   font-size: .72rem; letter-spacing: .02em; text-align: center; color: var(--tbl-muted); }
      /* ⚠️ I passi non ancora raggiunti hanno un FONDO, non solo un bordo:
         un cerchio vuoto su schermo scuro sparisce al sole, e chi non vede
         il 2 e il 3 non capisce che la pagina ha un seguito.
         ⚠️ Il fondo e’ NERO TRASPARENTE, non un colore del tema: --tbl-campo
         su fondo scuro risultava piu’ CHIARO della pagina, cioe’ il contrario
         di quello che serve. Una velatura nera scurisce qualunque fondo le
         capiti sotto — tema chiaro o scuro, cliente per cliente — senza che
         il motore debba scegliere un colore al posto del sito. */
      .tbl-passo-n { display: flex; align-items: center; justify-content: center;
                     width: 26px; height: 26px; border-radius: 50%; font-size: .8rem; font-weight: 700;
                     background: rgba(0, 0, 0, .22); border: 1px solid var(--tbl-line); }
      .tbl-passo--ora { color: var(--tbl-text); font-weight: 700; }
      .tbl-passo--ora .tbl-passo-n { background: var(--tbl-ink); color: var(--tbl-paper); border-color: var(--tbl-ink); }
      .tbl-passo--fatto .tbl-passo-n { border-color: var(--tbl-ink); color: var(--tbl-ink); }
      /* ⚠️ Il terzo passo si vede ma si vede SPENTO: annuncia cosa viene, non
         dice che ci sei. Una barra che mente e’ peggio di nessuna barra. */
      .tbl-passo--poi { opacity: .5; }
      /* IL TITOLO NON SI VEDE, MA C'E'. Il percorso in tre passi dice gia' dove
         si e', e la vetrina dei piatti fa il resto: un titolo in piu' spingeva
         la carta sotto la piega. Resta per chi usa un lettore di schermo, che
         su una pagina senza titolo non sa dove e' arrivato. */
      .tbl-titolo { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
                    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
      /* LA VETRINA DEI PIATTI. ⚠️ `scroll-snap`: si sfoglia col dito come ogni
         galleria del telefono e si ferma sempre su una foto intera, mai a
         meta'. `aspect-ratio` fisso: le foto della carta hanno qualunque
         forma, e una verticale spingerebbe il menu fuori dalla vista. */
      .tbl-vetrina { position: relative; margin: 0 0 1.2rem; }
      .tbl-vetrina-binario { display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
                             scrollbar-width: none; border-radius: .8rem; }
      .tbl-vetrina-binario::-webkit-scrollbar { display: none; }
      .tbl-vetrina-foto { position: relative; flex: 0 0 100%; margin: 0; scroll-snap-align: start;
                          aspect-ratio: 16 / 9; background: var(--tbl-card); }
      .tbl-vetrina-foto img { display: block; width: 100%; height: 100%; object-fit: cover; }
      /* Il nome in basso a sinistra, piccolo, su una sfumatura scura: si legge
         su un piatto chiaro come su uno scuro, e non copre il piatto. Bianco
         scritto qui e non preso dal tema: sta sopra una FOTO, non sul fondo. */
      .tbl-vetrina-nome { position: absolute; left: 0; right: 0; bottom: 0; text-align: left;
                          padding: 1.8rem .85rem .6rem; font-size: .78rem; font-weight: 600;
                          letter-spacing: .02em; color: #fff;
                          background: linear-gradient(to top, rgba(0, 0, 0, .7), transparent); }
      .tbl-vetrina-punti { display: flex; justify-content: center; gap: .35rem; margin-top: .55rem; }
      .tbl-vetrina-punti span { width: 6px; height: 6px; border-radius: 3px; background: var(--tbl-line);
                                transition: width .2s ease, background-color .2s ease; }
      .tbl-vetrina-punti span.is-ora { width: 16px; background: var(--tbl-ink); }
      .tbl-form { display: flex; flex-direction: column; gap: 1rem; }
      .tbl-campo { display: flex; flex-direction: column; gap: .35rem; }
      .tbl-lab { display: flex; flex-direction: column; font-weight: 600; }
      /* La spiegazione sta sotto il campo: piu’ piccola dell’etichetta, e
         staccata dal campo meno di quanto il campo sia staccato dal prossimo. */
      .tbl-aiuto { font-weight: 400; font-size: .8rem; color: var(--tbl-muted); margin-top: .3rem; }
      /* ⚠️ 16px pieni, mai meno: sotto i 16px iOS ZOOMA sul campo appena lo
         si tocca, e chi ordina si ritrova la pagina ingrandita e storta. */
      /* ⚠️ I campi hanno un fondo PROPRIO, piu’ scuro della pagina: trasparenti
         si vedeva solo il bordo, e su uno schermo al sole un bordo sottile
         sparisce — chi ordina non capisce dove toccare. Il colore viene dal
         tema del cliente (`input`), non da un grigio scelto qui. */
      .tbl-input { padding: .8rem .85rem; font-size: 16px; border: 1px solid var(--tbl-line); border-radius: .5rem; background: var(--tbl-campo); color: inherit; }
      .tbl-input::placeholder { color: var(--tbl-muted); }
      /* LA TENDINA DEI TAVOLI. ⚠️ `appearance: none` toglie la freccia del
         sistema, quindi se ne disegna una: senza, il campo sembra un campo di
         testo e nessuno lo apre. */
      /* LA RIGA DEL TAVOLO: a sinistra cosa si chiede, a destra la risposta. */
      .tbl-campo--riga { flex-direction: row; align-items: center; justify-content: space-between;
                         flex-wrap: wrap; gap: .6rem 1rem; }
      .tbl-lab--riga { flex-direction: row; align-items: center; gap: .45rem; }
      /* ⚠️ L’aiuto e’ un BOTTONE, non un `title`: su un telefono non c’e’
         niente da sorvolare, e quella frase resterebbe scritta solo per chi
         usa il mouse. 28px, perche’ si deve poter toccare. */
      .tbl-aiuto-btn { width: 28px; height: 28px; flex: 0 0 auto; border-radius: 50%;
                       border: 1px solid var(--tbl-line); background: transparent; color: var(--tbl-muted);
                       font: inherit; font-size: .8rem; font-weight: 700; line-height: 1; cursor: pointer; }
      .tbl-aiuto-testo { flex: 1 1 100%; margin: 0; font-size: .85rem; color: var(--tbl-muted); }
      /* LE PERSONE, a pastiglie — come `rw-pgrid` nel widget prenotazioni.
         ⚠️ 44px di lato: e’ la misura minima di un bersaglio da toccare, e
         qui si tocca in piedi, con una mano sola. */
      .tbl-pgrid { display: flex; flex-wrap: wrap; gap: .4rem; }
      .tbl-p { min-width: 44px; min-height: 44px; padding: .4rem .6rem;
               font: inherit; font-size: .95rem; cursor: pointer;
               border: 1px solid var(--tbl-line); border-radius: .5rem;
               background: var(--tbl-card); color: inherit; }
      .tbl-p--ora { background: var(--tbl-ink); color: var(--tbl-paper);
                    border-color: var(--tbl-ink); font-weight: 700; }
      .tbl-p-oltre { margin-top: .5rem; }
      .tbl-scegli { padding: .6rem 1rem; font: inherit; font-weight: 700; cursor: pointer;
                    border: 1px solid var(--tbl-ink); border-radius: .5rem;
                    background: transparent; color: var(--tbl-ink); min-height: 44px; }
      /* IL MODALE DELLA SCELTA. ⚠️ In fondo allo schermo su un telefono: e’
         dove arriva il pollice. `max-height` + scorrimento perche’ una sala da
         sessanta tavoli non ci sta, e senza, gli ultimi non si raggiungono. */
      .tbl-modale { position: fixed; inset: 0; z-index: 40; display: flex;
                    align-items: flex-end; justify-content: center;
                    background: rgba(0, 0, 0, .55); }
      .tbl-modale-box { width: 100%; max-width: 34rem; max-height: 80vh; overflow: auto;
                        padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom, 0px));
                        border-radius: .9rem .9rem 0 0; background: var(--tbl-bg);
                        border-top: 1px solid var(--tbl-line); }
      .tbl-modale-testa { display: flex; align-items: center; justify-content: space-between; margin-bottom: .9rem; }
      .tbl-modale-tit { margin: 0; font-size: .9rem; color: var(--tbl-muted); }
      .tbl-modale-x { width: 36px; height: 36px; border: 0; background: none; color: inherit;
                      font-size: 1.6rem; line-height: 1; cursor: pointer; }
      /* ⚠️ SEI COLONNE, come chiesto. I quadrati scendono sotto i 56px su un
         telefono stretto: si accetta perche’ i numeri sono corti e il
         riquadro e’ l’unica cosa sullo schermo — ma e’ il punto da riguardare
         per primo se qualcuno sbaglia tavolo. */
      .tbl-griglia { display: grid; grid-template-columns: repeat(6, 1fr); gap: .4rem; }
      /* ⚠️ I quadrati hanno un fondo SUO, preso dal tema: su un fondo scuro
         un bordo sottile e basta sparisce, e si tocca a caso. */
      .tbl-tav { display: flex; align-items: center; justify-content: center;
                 aspect-ratio: 1; padding: .15rem;
                 font: inherit; font-weight: 700; font-size: .95rem; line-height: 1.05;
                 text-align: center; overflow: hidden;
                 border: 1px solid var(--tbl-line); border-radius: .5rem;
                 background: var(--tbl-card); color: inherit; cursor: pointer; }
      .tbl-tav--ora { border-color: var(--tbl-ink); box-shadow: inset 0 0 0 2px var(--tbl-ink); }
      /* Il tavolo scelto, nella riga: piu’ piccolo del quadrato di prima, pieno,
         e con la matita in un angolo che dice che si puo’ toccare. */
      .tbl-tav--scelto { position: relative; flex: 0 0 auto; width: 52px; min-height: 52px;
                         font-size: 1.05rem; background: var(--tbl-ink); color: var(--tbl-paper);
                         border-color: var(--tbl-ink); }
      .tbl-tav-ico { position: absolute; right: 2px; bottom: 2px; width: 13px; height: 13px; opacity: .85; }
      .tbl-tav-ico svg { width: 100%; height: 100%; }
      /* ⚠️ L'errore non e' una riga di testo in fondo al modulo: e' la
         risposta alla cosa che la persona ha appena fatto, e deve leggersi
         come un blocco. Centrato, con bordo e un velo del suo stesso rosso,
         perche' su un telefono al sole una riga rossa sottile sparisce —
         e chi non la vede ripreme il bottone finche' si stanca.
         ⚠️ Il fondo e' il rosso stesso reso quasi trasparente (`color-mix`),
         non un rosa fisso: cosi' funziona sul tema chiaro e su quello scuro
         senza che il motore scelga una seconda tinta. */
      .tbl-err { --tbl-err-c: #c0392b;
                 margin: 1.2rem 0 0; padding: .8rem 1rem; text-align: center;
                 color: var(--tbl-err-c); font-weight: 600; line-height: 1.35;
                 border: 1px solid color-mix(in srgb, var(--tbl-err-c) 45%, transparent);
                 border-radius: .6rem;
                 background: color-mix(in srgb, var(--tbl-err-c) 12%, transparent); }
      /* ⚠️ Due colori DICHIARATI, non `currentColor`: lo sfondo preso da
         `currentColor` e il testo che eredita lo stesso colore davano un
         rettangolo pieno con la scritta invisibile. Sono i due neutri del
         motore: il sito del cliente li sovrascrive col suo accento. */
      .tbl-btn { margin-top: 0; width: 100%; min-height: 52px; font-size: 1.05rem; font-weight: 700; border: 0; border-radius: 999px; background: var(--tbl-ink); color: var(--tbl-paper); cursor: pointer; }
      .tbl-btn:disabled { opacity: .45; cursor: default; }
      /* SERVIZIO CHIUSO. Il primo passo SPENTO, non «da fare»: niente da
         scegliere adesso, e un cerchio acceso inviterebbe a provarci. */
      .tbl-passo--spento { opacity: .35; }
      .tbl-passo--spento .tbl-passo-n { background: transparent; border-style: dashed; }
      /* ⚠️ Il modale «chiuso» sta in MEZZO allo schermo, non in fondo come la
         scelta del tavolo: non e’ una cosa da fare col pollice, e’ una notizia
         da leggere. */
      .tbl-modale--chiuso { align-items: center; padding: 1rem; }
      .tbl-chiuso { border-radius: .9rem; border: 1px solid var(--tbl-line); text-align: center;
                    padding: 1.6rem 1.2rem; }
      .tbl-chiuso-tit { margin: 0 0 .5rem; font-family: var(--font-title); font-size: 1.15rem;
                        text-transform: uppercase; letter-spacing: .06em; }
      .tbl-chiuso-testo { margin: 0 0 1.4rem; color: var(--tbl-muted); line-height: 1.4; }
    </style>
  </body>
</html>
