---
// Page Épicerie (FR). Hero Chouchou (dégradé navy + halo magenta) puis
// corps blanc, texte navy : présentation de la sélection de produits en
// vente, tous proposés au restaurant. Photo optionnelle depuis l'admin
// (site_disc_epicerie). Version EN à faire plus tard (/en/epicerie).
import Layout from "../layouts/Layout.astro";
import { siteImages, siteImg } from "../lib/siteImages";
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";
export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const en = lang === "en";
const L = {
  title: en ? "Grocery" : "L'épicerie",
  heroSub: en ? "A selection of gourmet, quality products to discover on site and take home." : "Une sélection de produits gourmands et de qualité, à découvrir sur place et à emporter chez vous.",
  lead: en ? "At Comptoir Chouchou, the pleasure of the table goes beyond the plate." : "Chez Comptoir Chouchou, le plaisir de la table se prolonge au-delà de l'assiette.",
  p1: en ? "We offer for sale a selection of original, quality products, chosen with the same curiosity and care that guide our cooking." : "Nous proposons à la vente une sélection de produits originaux et de qualité, choisis avec la même curiosité et la même exigence que celles qui guident notre cuisine.",
  p2: en ? "All these products are available directly at the restaurant. Come and discover them, ask the team for advice and leave with your favourites." : "Tous ces produits sont proposés directement au restaurant. Passez les découvrir, demandez conseil à l'équipe et repartez avec vos coups de cœur.",
  reserve: en ? "Book a table" : "Réserver une table",
  find: en ? "Find us" : "Nous trouver",
  discWord: en ? "Our finds" : "Nos découvertes",
  discScript: en ? "the grocery" : "l'épicerie",
  brandsTitle: en ? "Our brands" : "Nos marques",
  brandsLead: en ? "A selection of houses and artisans we love, from sweet to savoury, from the table to the object, to be found on our shelves." : "Une sélection de maisons et d'artisans que nous aimons, du sucré au salé, de la table à l'objet, à retrouver sur nos étagères.",
  photoAlt: en ? "Comptoir Chouchou grocery" : "L'épicerie du Comptoir Chouchou",
};

const IMGS = await siteImages();
const HERO_FOTO = siteImg(IMGS, "site_epicerie_hero", IMGS["site_disc_epicerie"] || IMGS["site_resto_photo"] || "");
const EP_FOTO = siteImg(IMGS, "site_disc_epicerie", IMGS["site_resto_photo"] || "");

// Galerie produits (masonry 4 colonnes) : slots admin site_epicerie_1..14.
// Case vide -> vignette placeholder (hauteur variée) pour montrer la grille.
// Ordre mélangé à chaque chargement (SSR) : la disposition change à chaque reload.
function melange<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
const PRODOTTI = melange(Array.from({ length: 14 }, (_, i) => IMGS[`site_epicerie_${i + 1}`] || null));
// Répétitions du bandeau défilant (comme la home).
const MARQ = [0, 1, 2, 3];

// Marques / producteurs de l'épicerie (logos dans public/logos).
const MARQUES = [
  { src: "/logos/baru-logo.webp", alt: "Baru" },
  { src: "/logos/delehaut-logo.webp", alt: "Délehaut" },
  { src: "/logos/le-creuset-logo.webp", alt: "Le Creuset" },
  { src: "/logos/dandoy-logo.webp", alt: "Dandoy" },
  { src: "/logos/manucurist-logo.webp", alt: "Manucurist" },
  { src: "/logos/autre-the-logo.webp", alt: "Autre Thé" },
  { src: "/logos/cuberdons-leopold-logo.webp", alt: "Cuberdons Léopold" },
  { src: "/logos/loccitane-logo.webp", alt: "L'Occitane" },
];
---

<Layout title={L.title + ", Comptoir Chouchou"}>
  <div class="chou">
  <section class="ep-hero">
    <div class="ep-hero__bg" aria-hidden="true"></div>
    {HERO_FOTO && <img class="ep-hero__photo" src={HERO_FOTO} alt="" loading="eager" decoding="async" onerror="this.remove()" />}
    <div class="ep-hero__overlay" aria-hidden="true"></div>
    <div class="ep-hero__glow" aria-hidden="true"></div>
    <div class="ep-hero__inner">
      <h1 class="ep-hero__title">{L.title}</h1>
      <p class="ep-hero__sub">{L.heroSub}</p>
    </div>
  </section>

  <section class="ep-body">
    <div class={"ep" + (EP_FOTO ? "" : " ep--solo")}>
      <div class="ep-text">
        <p class="ep-lead">{L.lead}</p>
        <p>{L.p1}</p>
        <p>{L.p2}</p>
        <div class="ep-cta">
          <button type="button" class="ep-btn ep-btn--mag" data-reserver>{L.reserve}</button>
          <a class="ep-btn ep-btn--out" href={getLocalizedUrl("/contact", lang)}>{L.find}</a>
        </div>
      </div>
      {EP_FOTO && (
        <figure class="ep-photo">
          <img src={EP_FOTO} alt={L.photoAlt} loading="lazy" decoding="async" onerror="this.closest('.ep-photo').remove()" />
        </figure>
      )}
    </div>
  </section>

  <section class="ep-disc">
    <div class="ep-marquee" aria-hidden="true">
      <div class="ep-mrow">
        <div class="ep-mseq">
          {MARQ.map(() => (
            <span class="ep-munit">
              <span class="ep-mword">{L.discWord}</span>
              <span class="ep-mdot ep-mdot--sep">✦</span>
              <span class="ep-mscript">{L.discScript}</span>
              <span class="ep-mdot">✦</span>
            </span>
          ))}
        </div>
        <div class="ep-mseq">
          {MARQ.map(() => (
            <span class="ep-munit">
              <span class="ep-mword">{L.discWord}</span>
              <span class="ep-mdot ep-mdot--sep">✦</span>
              <span class="ep-mscript">{L.discScript}</span>
              <span class="ep-mdot">✦</span>
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="ep-gal">
      {PRODOTTI.map((src, i) => (
        <div class={"ep-tile" + (src ? "" : " ep-tile--ph") + " ep-tile--h" + ((i % 3) + 1)}>
          {src && <img src={src} alt={"Produit " + (i + 1)} loading="lazy" decoding="async" onerror="this.closest('.ep-tile').classList.add('ep-tile--ph'); this.remove();" />}
        </div>
      ))}
    </div>

    <div class="ep-brands">
      <h2 class="ep-brands__title">{L.brandsTitle}</h2>
      <p class="ep-brands__lead">{L.brandsLead}</p>
      <div class="ep-logos">
        {MARQUES.map((m) => (
          <div class="ep-logo"><img src={m.src} alt={m.alt} loading="lazy" decoding="async" /></div>
        ))}
      </div>
    </div>
  </section>
  </div>
</Layout>

<script>
  (() => {
    const logos = Array.from(document.querySelectorAll(".ep-logo"));
    if (!logos.length) return;
    // Ordre aléatoire à chaque chargement (Fisher-Yates)
    const parent = logos[0].parentElement;
    const shuffled = logos.slice();
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    if (parent) shuffled.forEach((el) => parent.appendChild(el));
    // Apparition lente et asynchrone au scroll
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      logos.forEach((l) => l.classList.add("is-in"));
      return;
    }
    const io = new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        el.style.transitionDelay = (Math.random() * 1.4).toFixed(2) + "s";
        el.classList.add("is-in");
        obs.unobserve(el);
      }
    }, { threshold: 0.2 });
    logos.forEach((l) => io.observe(l));
  })();
</script>

<style>
  /* Wrapper Chouchou (fond navy + accent magenta) */
  .chou {
    --c-bg: #353c4e;
    --c-accent: #ed2289;
    background: #2b3040;
    position: relative;
  }

  /* ---------- HERO ---------- */
  .ep-hero {
    position: relative;
    min-height: clamp(400px, 56vh, 600px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(9rem, 15vh, 12.5rem) 1.5rem 4.5rem;
    overflow: hidden;
  }
  .ep-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(120% 100% at 50% 0%, #3d4458 0%, #2b3040 55%, #23283a 100%);
  }
  .ep-hero__photo {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ep-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(180deg, rgba(23, 27, 40, 0.4) 0%, rgba(23, 27, 40, 0.62) 100%);
  }
  .ep-hero__glow {
    position: absolute;
    left: 50%;
    top: 44%;
    z-index: 2;
    width: 600px;
    height: 600px;
    max-width: 120vw;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(237, 34, 137, 0.22) 0%, rgba(237, 34, 137, 0) 62%);
    pointer-events: none;
  }
  .ep-hero__inner { position: relative; z-index: 3; }
  .ep-hero__script {
    display: block;
    font-family: var(--font-script);
    color: var(--c-accent);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 0.9;
    margin: 0 0 0.05em;
    opacity: 0;
    transform: translateY(18px);
    animation: ep-in 0.8s ease-out 0.1s forwards;
  }
  .ep-hero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 6vw, 4rem);
    letter-spacing: 0.01em;
    line-height: 1.05;
    margin: 0 0 0.9rem;
    color: #fff;
    opacity: 0;
    transform: translateY(18px);
    animation: ep-in 0.8s ease-out 0.2s forwards;
  }
  .ep-hero__sub {
    max-width: 620px;
    margin: 0 auto;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
    opacity: 0;
    transform: translateY(18px);
    animation: ep-in 0.8s ease-out 0.32s forwards;
  }
  @keyframes ep-in { to { opacity: 1; transform: translateY(0); } }

  /* ---------- CORPS BLANC ---------- */
  .ep-body {
    background: #ffffff;
    --c-text: #353c4e;
    --c-muted: #6b7183;
    color: var(--c-text);
    position: relative;
    z-index: 1;
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(4rem, 9vw, 7rem);
  }
  .ep {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 28px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .ep-text { max-width: 34em; }
  .ep--solo { grid-template-columns: 1fr; max-width: 720px; }
  .ep--solo .ep-text { max-width: none; }
  .ep-lead {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    line-height: 1.25;
    color: var(--c-text);
    margin: 0 0 1.2rem;
  }
  .ep-text p:not(.ep-lead) {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.7;
    color: var(--c-muted);
    margin: 0 0 1rem;
  }

  .ep-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .ep-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 30px;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }
  .ep-btn--mag { background: var(--c-accent); color: #fff; }
  .ep-btn--mag:hover { background: #c8176f; transform: translateY(-2px); }
  .ep-btn--out {
    background: transparent;
    color: var(--c-text);
    box-shadow: inset 0 0 0 1.5px rgba(53, 60, 78, 0.3);
  }
  .ep-btn--out:hover { background: var(--c-text); color: #fff; transform: translateY(-2px); }

  .ep-photo { margin: 0; }
  .ep-photo img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 460px;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .ep { grid-template-columns: 1fr; }
    .ep-text { max-width: none; }
    .ep-photo { order: -1; }
    .ep-photo img { max-height: 300px; }
  }

  /* ---------- DÉCOUVERTES : bandeau animé + galerie masonry ---------- */
  .ep-disc {
    --navy: #353c4e;
    --mag: #ed2289;
    --avorio: #f7f4ee;
    background: #ffffff;
    position: relative;
    z-index: 1;
    display: flow-root;
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  .ep-marquee {
    position: relative;
    overflow: hidden;
    /* padding vertical : laisse respirer les hampes/jambages du script
       (Birthstone) qui débordent de la boîte de ligne, sinon overflow:hidden
       les coupe en bas. */
    padding: clamp(0.5rem, 1.6vw, 1.3rem) 0 clamp(1.1rem, 2.8vw, 2.2rem);
    margin: clamp(0.6rem, 2.4vw, 1.8rem) 0 clamp(2rem, 4.5vw, 3.4rem);
  }
  .ep-mrow {
    display: flex;
    width: max-content;
    animation: ep-scroll 90s linear infinite;
  }
  .ep-mseq { display: flex; flex: 0 0 auto; align-items: baseline; }
  .ep-munit { display: inline-flex; align-items: baseline; white-space: nowrap; }
  .ep-mword {
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--navy);
    font-size: clamp(3.5rem, 10vw, 9rem);
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .ep-mscript {
    font-family: var(--font-script);
    color: var(--mag);
    font-size: clamp(4.5rem, 13vw, 11rem);
    line-height: 1.22;
    margin: 0 0.16em;
  }
  .ep-mdot {
    color: var(--mag);
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1;
    margin: 0 0.35em 0 0.1em;
    align-self: center;
  }
  .ep-mdot--sep { color: var(--navy); margin: 0 0.2em 0 0.55em; }
  @keyframes ep-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Galerie produits : masonry 4 colonnes */
  .ep-gal {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 28px;
    columns: 4;
    column-gap: clamp(0.8rem, 1.6vw, 1.4rem);
  }
  .ep-tile {
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    margin: 0 0 clamp(0.8rem, 1.6vw, 1.4rem);
    overflow: hidden;
    background: var(--avorio);
  }
  .ep-tile img { display: block; width: 100%; height: auto; }
  .ep-tile--ph {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ep-tile--ph::after {
    content: "\2726";
    color: rgba(237, 34, 137, 0.35);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }
  .ep-tile--ph.ep-tile--h1 { height: 210px; }
  .ep-tile--ph.ep-tile--h2 { height: 300px; }
  .ep-tile--ph.ep-tile--h3 { height: 250px; }

  @media (max-width: 1100px) { .ep-gal { columns: 3; } }
  @media (max-width: 720px)  { .ep-gal { columns: 2; } }
  @media (prefers-reduced-motion: reduce) {
    .ep-mrow { animation: none; }
  }

  /* Marques / logos partenaires */
  .ep-brands {
    max-width: 1100px;
    margin: clamp(3rem, 7vw, 5.5rem) auto 0;
    padding: 0 28px;
    text-align: center;
  }
  .ep-brands__title {
    font-family: var(--font-title);
    font-weight: 700;
    color: #353c4e;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.1;
    margin: 0 0 0.8rem;
  }
  .ep-brands__lead {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.7;
    color: #6b7183;
    max-width: 40em;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
  }
  .ep-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  .ep-logo {
    flex: 0 0 auto;
    width: clamp(130px, 17vw, 210px);
    aspect-ratio: 400 / 260;
    background: #ffffff;
    border-radius: 10px;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 1.1s ease, transform 1.1s ease;
  }
  .ep-logo.is-in { opacity: 1; transform: none; }
  .ep-logo img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
