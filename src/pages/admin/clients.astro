---
// Pannello admin — CLIENTS: tutti i clienti che hanno ordinato (aggregati
// dagli ordini) UNITI ai clienti aggiunti a mano. Nome, email, téléphone,
// nombre de commandes, total dépensé. Possibilità di aggiungere un cliente.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHead from "../../components/admin/AdminHead.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import Modal from "../../components/admin/Modal.astro";
import ImagePicker from "../../components/admin/ImagePicker.astro";
import { CLIENT } from "../../config/client";
import { verificaTokenLocale } from "../../lib/admin/adminAuth";
import { caricaClienti } from "../../lib/admin/caricaClienti";
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";
import "../../styles/fab.css";

const lang = await adminLang();
const t = adminT(lang);

export const prerender = false;

// SSR (Fase 2): se il cookie di sessione è valido, pre-carichiamo la lista
// clienti sul server. Altrimenti ssrClients resta null → caricamento client.
let ssrClients: unknown = null;
try {
  const token = Astro.cookies.get("mdd_at")?.value ?? "";
  const staff = token ? await verificaTokenLocale(token) : null;
  if (staff) {
    const r = await caricaClienti();
    if (!("error" in r)) ssrClients = r;
  }
} catch {
  ssrClients = null;
}
const ssrClientsJson = ssrClients ? JSON.stringify(ssrClients).replace(/</g, "\\u003c") : "";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("nav.clients") + " — Admin " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@700&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-hover: #e04f00;
        --c-input: #e6e6e6;
        --c-bg: #ffffff;
        --c-text: #666666;
        --c-accent: #ff7300;
        --c-muted: #a6a6a6;
        --c-line: #ebebeb;
        --c-card: #ffffff;
        --font-title: "Quicksand", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; overflow-x: hidden; }
      #app { display: none; min-height: 100vh; flex-direction: column; }

      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; margin-bottom: 1.25rem; }
      h1 svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .state { color: var(--c-muted); text-align: center; padding: 3rem 1rem; }

      /* Barra azioni (pulsante + ricerca), stile pagina Menu */
      .actionsbar { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
      .pill {
        font-family: var(--font-title); letter-spacing: 0.05em; cursor: pointer; border-radius: 999px;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .fl-filtri { display: inline-flex; flex-wrap: wrap; gap: 0.45rem; }
      .fl-sep { width: 1px; align-self: stretch; background: var(--c-line); margin: 0.15rem 0.35rem; flex: 0 0 auto; }
      .fl-pill .n { margin-left: 0.4rem; font-weight: 800; color: var(--c-text); }
      .fl-pill.is-on .n { color: var(--c-bg); }
      .fl-pill {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-body); font-size: 0.82rem; padding: 0.4rem 1rem;
        border-radius: 999px; cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .fl-pill { display: inline-flex; align-items: center; justify-content: center; }
      .fl-pill svg {
        width: 15px; height: 15px; display: block; fill: none; stroke: currentColor;
        stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
      }
      .fl-pill b { margin-left: 0.4rem; font-weight: 800; color: var(--c-text); }
      .fl-pill.is-on b { color: var(--c-bg); }
      .fl-pill:hover { border-color: var(--c-accent); color: var(--c-text); }
      .fl-pill.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); font-weight: 700; }
      /* Filtri estesi: in linea su desktop, a tendina (mobile) sotto la barra */
      .fl-more { display: inline-flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; }
      .fl-toggle { display: none; background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-body); font-size: 0.82rem; padding: 0.4rem 1rem; border-radius: 999px; cursor: pointer; align-items: center; gap: 0.45rem; }
      .fl-toggle.has-active { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); font-weight: 700; }
      .fl-toggle-n { display: none; align-items: center; justify-content: center; min-width: 1.15rem; height: 1.15rem; padding: 0 0.3rem; border-radius: 999px; background: rgba(0, 0, 0, 0.22); font-size: 0.7rem; font-weight: 800; }
      .fl-toggle.has-active .fl-toggle-n { display: inline-flex; }
      .ab-sep { display: none; }
      .search {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-size: 0.88rem; padding: 0.45rem 1rem;
        border-radius: 999px; flex: 0 1 300px; min-width: 200px; margin-left: auto;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23b3aca6' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='8'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg>");
        background-repeat: no-repeat; background-position: 0.85rem center; background-size: 14px;
        padding-left: 2.3rem;
      }
      .search::placeholder { color: var(--c-muted); }
      .search:focus { outline: none; border-color: var(--c-accent); }
      /* Selettore colonne, accanto alla ricerca */
      .colpick { position: relative; flex: 0 0 auto; }
      .cp-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 36px; height: 36px; border-radius: 999px; padding: 0;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        cursor: pointer; transition: border-color 0.15s, color 0.15s;
      }
      .cp-btn:hover, .cp-btn[aria-expanded="true"] { border-color: var(--c-accent); color: var(--c-text); }
      .cp-btn svg { width: 16px; height: 16px; display: block; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .cp-menu {
        position: absolute; top: calc(100% + 0.45rem); right: 0; z-index: 30; min-width: 210px;
        background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px;
        padding: 0.5rem; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
      }
      .cp-h { font-family: var(--font-title); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); padding: 0.2rem 0.5rem 0.5rem; }
      .cp-item {
        display: flex; align-items: center; gap: 0.6rem; width: 100%;
        background: none; border: none; color: var(--c-text); cursor: pointer;
        font-family: var(--font-body); font-size: 0.85rem; text-align: left;
        padding: 0.4rem 0.5rem; border-radius: 8px;
      }
      .cp-item:hover { background: color-mix(in srgb, var(--c-accent) 12%, transparent); }
      .cp-item:disabled { opacity: 0.45; cursor: default; }
      .cp-item:disabled:hover { background: none; }
      /* Voce di ordinamento attiva: corallo + freccia del verso. */
      .cp-item.is-on { color: var(--c-accent); font-weight: 700; }
      .cp-item .cp-dir { font-size: 0.62rem; }
      .cp-box {
        width: 15px; height: 15px; border-radius: 4px; flex: 0 0 auto;
        border: 1px solid var(--c-line); display: inline-flex; align-items: center; justify-content: center;
      }
      .cp-item[aria-checked="true"] .cp-box { background: var(--c-accent); border-color: var(--c-accent); }
      .cp-box svg { width: 11px; height: 11px; display: none; fill: none; stroke: var(--c-bg); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
      .cp-item[aria-checked="true"] .cp-box svg { display: block; }
      .count { color: var(--c-muted); font-size: 0.9rem; white-space: nowrap; }
      .titlebar {
        display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
        padding-bottom: 1.1rem; border-bottom: 1px solid var(--c-line); margin-bottom: 1.3rem;
      }
      .titlebar h1 { margin-bottom: 0; }
      .t-stats { display: flex; gap: 0.45rem; flex-wrap: wrap; }
      .t-pill {
        display: inline-flex; align-items: center; gap: 0.4rem;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        border-radius: 999px; padding: 0.32rem 0.9rem; font-size: 0.82rem; white-space: nowrap;
      }
      .t-pill b { color: var(--c-text); font-size: 0.95rem; }
      .t-pill.gold { border-color: var(--c-accent); }
      .t-pill.gold b { color: var(--c-accent); }

      /* Tabella (CSS grid) */
      .table { background: transparent; border: none; border-radius: 0; overflow: visible; box-shadow: none; }
      #rows { display: flex; flex-direction: column; gap: 0.5rem; }
      /* Le colonne visibili le decide il JS (preferenza utente + larghezza +
         modulo ordini) scrivendo --grid-cols su .table: qui c'e' solo il
         ripiego se lo script non e' ancora passato. */
      .thead, .row {
        display: grid;
        grid-template-columns: var(--grid-cols, minmax(120px, var(--col-nome, 220px)) minmax(0, 2fr) minmax(0, 1.3fr) 66px 66px 120px 96px);
        gap: 0.65rem;
        align-items: center;
        padding: 0.85rem 1.2rem;
      }
      /* Una colonna spenta: via la cella E la sua intestazione, cosi la
         griglia e il contenuto restano allineati. */
      .table.off-email .c-email, .table.off-email .th[data-sort="email"],
      .table.off-phone .c-phone, .table.off-phone .th[data-sort="phone"],
      .table.off-since .c-since, .table.off-since .th[data-sort="since"],
      .table.off-reservations .c-resa, .table.off-reservations .th[data-sort="reservations"],
      .table.off-orders .c-orders, .table.off-orders .th[data-sort="orders"],
      .table.off-total .c-total, .table.off-total .th[data-sort="total"] { display: none; }
      /* L'intestazione resta nascosta a ogni larghezza: l'ordinamento si fa
         dal menu «Ordina» accanto al selettore colonne, non cliccando le
         colonne. I `.th` restano nel markup perche' il JS li usa come
         sorgente di verita' dello stato (chiave attiva + verso). */
      .thead { display: none; }
      .th {
        background: transparent; border: none; color: var(--c-muted); cursor: pointer;
        font-family: var(--font-body); font-size: 0.72rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.06em; text-align: left;
        display: inline-flex; align-items: center; gap: 0.3rem;
      }
      .th:hover { color: var(--c-text); }
      .th.num { justify-content: flex-end; text-align: right; }
      .th .arrow { font-size: 0.6rem; opacity: 0; transition: opacity 0.15s; }
      .th.sorted { color: var(--c-accent); }
      .th.sorted .arrow { opacity: 1; }

      .row { border: 1px solid var(--c-line); border-radius: 10px; background: var(--c-card); cursor: pointer; transition: background 0.12s; }
      .row:hover { background: color-mix(in srgb, var(--c-card), var(--c-bg) 20%); }
      .c-name { white-space: nowrap; overflow: hidden; display: flex; align-items: center; }
      .c-avatar {
        position: relative;
        width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
        display: inline-flex; align-items: center; justify-content: center;
        background: color-mix(in srgb, var(--c-accent) 16%, transparent); color: var(--c-accent);
        border: 1px solid color-mix(in srgb, var(--c-accent) 45%, transparent);
        font-size: 0.76rem; font-weight: 800; letter-spacing: 0.02em;
        margin-right: 0.65rem; user-select: none;
      }
      .c-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 50%; }
      /* Lingua del cliente: bandierina agganciata al badge, al posto di una
         colonna intera. */
      .c-flag {
        position: absolute; right: -5px; bottom: -4px;
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 22px; height: 17px; padding: 0 1px;
        border-radius: 5px; background: var(--c-card); border: 1px solid var(--c-line);
        font-size: 0.88rem; line-height: 1; pointer-events: none;
      }
      .c-email, .c-phone { display: flex; align-items: center; gap: 0.45rem; overflow: hidden; white-space: nowrap; min-width: 0; }
      .c-email a, .c-phone a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
      .c-c-ico { display: inline-flex; flex: none; }
      .c-c-ico svg { width: 15px; height: 15px; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .act-contacts { display: flex; flex-wrap: wrap; gap: 0.4rem 1.3rem; margin: -0.1rem 0 1.35rem; font-size: 0.9rem; }
      .act-contacts:empty { display: none; }
      .act-contacts .r-c { display: inline-flex; align-items: center; gap: 0.4rem; min-width: 0; }
      .act-contacts .r-c svg { width: 15px; height: 15px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .act-contacts a { color: var(--c-text); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.15s, color 0.15s; }
      .act-contacts a:hover { color: var(--c-accent); border-bottom-color: var(--c-accent); }
      .act-state { color: var(--c-muted); font-style: italic; padding: 0.6rem 0; }
      .act-row {
        display: flex; align-items: center; gap: 0.9rem; flex-wrap: nowrap;
        padding: 0.7rem 0; border-bottom: 1px solid var(--c-line);
      }
      .act-row:last-child { border-bottom: none; }
      .act-ico { display: inline-flex; flex-shrink: 0; }
      .act-ico svg { width: 15px; height: 15px; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .act-when { font-weight: 700; font-size: 0.9rem; min-width: 128px; flex-shrink: 0; white-space: nowrap; }
      .act-label { flex: 1 1 auto; color: var(--c-muted); font-size: 0.88rem; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .act-amount { font-family: var(--font-title); color: var(--c-accent); font-size: 1.05rem; letter-spacing: 0.03em; flex-shrink: 0; white-space: nowrap; }
      .act-status { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; border-radius: 999px; padding: 0.2rem 0.7rem; border: 1px solid var(--c-line); color: var(--c-muted); flex-shrink: 0; white-space: nowrap; }
      /* Lo spazio dal nome lo da' il `gap` di #act-name: qui niente margine,
         o si sommerebbero. */
      .act-new { display: inline-block; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.08em; vertical-align: middle; background: var(--c-accent); color: var(--c-bg); border-radius: 999px; padding: 0.15rem 0.55rem; font-weight: 700; }
      .act-stats { display: flex; flex-direction: column; gap: 0.9rem; margin: 0 0 1.4rem; }
      .act-stats:empty { display: none; }
      .act-flags { margin-top: 0.1rem; }
      .st-sec { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 0.8rem 1.1rem 0.9rem; }
      .st-sec-h { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
      .st-sec-h svg { width: 16px; height: 16px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
      .st-sec-h .t { font-family: var(--font-title); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--c-text); }
      .st-sec-h .cnt { margin-left: auto; font-family: var(--font-title); font-weight: 700; font-size: 1.18rem; letter-spacing: 0.03em; color: var(--c-accent); line-height: 1; }
      .st-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.34rem 0; border-bottom: 1px solid color-mix(in srgb, var(--c-line) 55%, transparent); }
      .st-row:last-child { border-bottom: none; padding-bottom: 0; }
      .st-row .k { color: var(--c-muted); font-size: 0.85rem; }
      .st-row .v { font-family: var(--font-title); font-weight: 700; font-size: 1.02rem; letter-spacing: 0.02em; color: var(--c-text); }
      .st-row.hl .v { color: var(--c-accent); font-size: 1.14rem; }
      /* I 5 piatti piu' ordinati, in fondo alla sezione ORDINI. Stessa forma
         dei preferiti nel modale «Nuovo ordine», ma qui sono da leggere e
         basta: niente hover, niente click. La riga sopra tiene gia' la sua
         linea (non e' piu' l'ultimo figlio), quindi qui nessun bordo. */
      .st-fav { margin-top: 0.7rem; }
      .st-fav-lab { display: block; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); }
      .st-fav-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.45rem; }
      .st-fav-chip {
        display: inline-flex; align-items: baseline; gap: 0.4rem; min-width: 0;
        background: var(--c-bg); border: 1px solid var(--c-line); border-radius: 999px;
        padding: 0.3rem 0.75rem; font-size: 0.82rem; color: var(--c-text);
      }
      .st-fav-n { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .st-fav-q { color: var(--c-accent); font-size: 0.75rem; font-weight: 700; flex-shrink: 0; }
      .act-status.ko { border-color: #ed1c24; color: #ff8a8f; }
      .act-status.ns { border-color: var(--c-accent); color: var(--c-accent); }
      .row:last-child { border-bottom: none; }
      /* Cliente bloccato: barra rossa a sinistra (inset = nessuno spostamento) */
      .row.is-blocked { box-shadow: inset 3px 0 0 #ed1c24; }
      .cell { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .c-name { font-weight: 700; }
      .c-name .c-ico { display: inline-flex; gap: 0.3rem; margin-left: 0.45rem; vertical-align: middle; }
      .c-name .c-ico svg { width: 13px; height: 13px; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .c-name .c-ico svg.ico-ns { stroke: #ed1c24; }
      .th-ico svg {
        width: 15px; height: 15px; fill: none; stroke: var(--c-accent); stroke-width: 1.8;
        stroke-linecap: round; stroke-linejoin: round; vertical-align: -2px; margin-right: 0.25rem;
      }
      /* La freccetta del sort passa a sinistra: l'icona resta a filo destro, come i numeri */
      .th-ico .arrow { order: -1; }
      .c-name .c-ico span { display: inline-flex; }
      .tag-new {
        display: inline-flex; align-items: center; height: 17px; box-sizing: border-box;
        margin-left: 0.45rem; vertical-align: middle;
        background: var(--c-accent); color: var(--c-bg); border-radius: 999px;
        font-size: 0.58rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
        padding: 0 0.5rem;
      }
      .tag-ns {
        display: inline-flex; align-items: center; gap: 0.32rem; height: 17px; box-sizing: border-box;
        margin-left: 0.45rem; vertical-align: middle;
        background: #ed1c24; color: #fff; border-radius: 999px;
        font-size: 0.58rem; font-weight: 800; letter-spacing: 0.05em;
        padding: 0 0.55rem 0 3px; line-height: 1;
      }
      .tag-ns svg.ico-ns {
        width: 11px; height: 11px; fill: none; stroke: #fff;
        stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; display: block;
      }
      .c-name .tag { font-family: var(--font-body); font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-accent); border: 1px solid var(--c-accent); border-radius: 999px; padding: 0.05rem 0.4rem; margin-left: 0.5rem; vertical-align: middle; }
      /* Dati (email, telefono): bianco pieno, peso normale — leggibili senza urlare */
      .cell a { color: var(--c-text); font-weight: 400; text-decoration: none; }
      .cell a:hover { color: var(--c-accent); }
      .c-num { text-align: right; font-variant-numeric: tabular-nums; }
      .c-since { color: var(--c-muted); font-size: 0.82rem; text-align: right; white-space: nowrap; margin-right: 3rem; }
      .c-nums { display: contents; }
      .c-cash-ico { display: none; }
      .c-cash-ico svg { width: 15px; height: 15px; fill: var(--c-accent); }
      .c-resa, .c-orders { font-family: var(--font-title); font-size: 1.2rem; letter-spacing: 0.03em; display: inline-flex; align-items: center; gap: 0.4rem; justify-content: flex-start; }
      .c-num-ico { display: inline-flex; flex: none; }
      .c-num-ico svg { width: 15px; height: 15px; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .c-total { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.03em; color: var(--c-accent); }
      /* Zero speso non e' un importo: e' un'assenza. Trattino, come le altre
         celle vuote. */
      .c-total.vuoto { font-family: var(--font-body); font-size: 0.95rem; color: var(--c-muted); }
      .c-act { display: flex; justify-content: flex-end; gap: 0.45rem; overflow: visible; }
      /* Riga foto: la stessa forma degli altri modali (anteprima + pastiglie
         neutre «Carica una foto» / «Libreria»). L'anteprima resta il CERCHIO
         dell'avatar, non il quadrato smussato: per una persona il ritratto e'
         tondo dappertutto nell'app, dalla lista alle card. */
      .ed-photo-row { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
      .ed-avatar { width: 64px; height: 64px; font-size: 1.25rem; margin-right: 0; }
      /* I bottoni d'azione sono il componente condiviso `.btn`
         (src/styles/button.css): qui non resta niente da ridisegnare. */
      .ed-danger { border-color: #7a3a3a; color: #ff8a8f; }
      .ed-danger:hover { background: rgba(237, 28, 36, 0.25); border-color: #ed1c24; color: #ff8a8f; }
      .ed-row2 {
        display: flex; justify-content: space-between; align-items: center; gap: 1rem;
        border-top: 1px solid var(--c-line); padding: 0.85rem 0; margin-top: 0.3rem;
      }
      .ed-hint { color: var(--c-muted); font-size: 0.82rem; margin: 0.2rem 0 0; }
      /* Permesso/negato sono uno STATO, e su questa pagina gli stati sono
         pillole (vedi .act-status nella colonna accanto). Stessa forma, verde
         quando e' concesso e rosso quando non lo e'. Il testo semplice resta
         solo per il caso neutro — cliente senza email, dove non c'e' niente
         da concedere o negare. */
      .ed-hint.ok, .ed-hint.warn {
        /* `block` + `fit-content`, non `inline-block`: la pillola deve restare
           sulla riga sotto l'etichetta (com'era da `<p>`) e larga quanto il suo
           testo. Con `inline-block` si incollava di fianco a NEWSLETTER. */
        display: block; width: fit-content; max-width: 100%;
        font-size: 0.68rem; text-transform: uppercase;
        letter-spacing: 0.06em; font-weight: 700; white-space: nowrap;
        border: 1px solid currentColor; border-radius: 999px;
        padding: 0.25rem 0.75rem; margin-top: 0.45rem;
      }
      .ed-hint.warn { color: #ff8a8f; border-color: #ed1c24; }
      .ed-hint.ok { color: #63c495; border-color: #2e9e6b; }
      .ed-upl-state { color: var(--c-muted); font-size: 0.78rem; margin: 0; }
      .ed-upl-state:empty { display: none; }
      /* L'errore vive nel footer del guscio, spinto a sinistra dai bottoni.
         Vuoto non deve occupare spazio, o il footer resta alto per niente. */
      .ed-err { color: #ff8a8f; font-size: 0.85rem; margin: 0; margin-right: auto; align-self: center; }
      .ed-err:empty { display: none; }
      .ed-names { display: flex; gap: 0.8rem; }
      .ed-names .f-field { flex: 1; min-width: 0; }
      .k-ico { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .i-btn {
        width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
        background: transparent; border: 1px solid var(--c-line); color: var(--c-text);
        cursor: pointer; border-radius: 50%; transition: border-color 0.15s, color 0.15s, background 0.15s;
      }
      .i-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .i-del { background: rgba(237, 28, 36, 0.25); border-color: rgba(237, 28, 36, 0.35); color: #fff; }
      .i-del:hover { background: rgba(237, 28, 36, 0.55); border-color: #ed1c24; color: #fff; }
      .i-del .k-ico { width: 15px; height: 15px; }
      .i-del.confirm { width: auto; padding: 0 0.75rem; border-radius: 999px; font-size: 0.75rem; font-family: var(--font-body); background: #a3320f; border-color: #a3320f; color: #fff; white-space: nowrap; }

      .loading { opacity: 0.45; pointer-events: none; }

      /* Il guscio fatto a mano (.overlay / .modal / .m-close / .m-actions /
         .m-save / .tel-prefix) NON C'E' PIU': apriva un modale «aggiungi
         cliente» che nessuno chiamava piu' da quando creazione e modifica
         sono la stessa finestra (#ed-overlay). Clienti e' una pagina chiusa. */
      /* Modale attività cliente: largo, due colonne che scrollano da sole.
         Il corpo del guscio non scrolla (`overflow:hidden`), altrimenti le due
         colonne scorrerebbero insieme invece che ognuna per conto suo. */
      #act-overlay .md-body { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
      #act-name { display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; }
      .act-cols { display: flex; gap: 1.5rem; min-height: 0; flex: 1 1 auto; overflow: hidden; }
      .act-left { flex: 0 0 44%; max-width: 44%; overflow-y: auto; padding-right: 0.4rem; }
      .act-right { flex: 1 1 auto; min-width: 0; overflow-y: auto; border-left: 1px solid var(--c-line); padding-left: 1.5rem; }
      .act-tabs { display: flex; gap: 0.5rem; margin-bottom: 0.9rem; position: sticky; top: 0; background: var(--c-bg); padding-bottom: 0.2rem; z-index: 2; }
      .act-tab { background: var(--c-input); border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-body); font-weight: 700; font-size: 0.82rem; padding: 0.45rem 1rem; border-radius: 999px; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; transition: background 0.15s, color 0.15s, border-color 0.15s; }
      .act-tab.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .act-tab-n { font-size: 0.7rem; background: rgba(255,255,255,0.12); border-radius: 999px; padding: 0.05rem 0.45rem; min-width: 1.2rem; text-align: center; }
      .act-tab.is-on .act-tab-n { background: rgba(0,0,0,0.18); }
      .act-left::-webkit-scrollbar, .act-right::-webkit-scrollbar { width: 8px; }
      .act-left::-webkit-scrollbar-thumb, .act-right::-webkit-scrollbar-thumb { background: var(--c-line); border-radius: 8px; }
      /* Altezza fissa finche' le colonne sono due: senza, il modale si
         affloscia sul contenuto e le due liste perdono la loro barra. */
      @media (min-width: 761px) { #act-overlay .md-box { height: 88vh; max-height: 88vh; } }
      /* 760/761 e' la deroga gia' in uso per i modali a due colonne. */
      @media (max-width: 760px) {
        .act-cols { flex-direction: column; overflow-y: auto; gap: 1.1rem; }
        .act-left, .act-right { flex: none; max-width: none; width: 100%; overflow: visible; border-left: none; padding-left: 0; padding-right: 0; }
        .act-right { border-top: 1px solid var(--c-line); padding-top: 1rem; }
      }
      .f-field { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.9rem; }
      .f-label { font-size: 0.72rem; color: var(--c-muted); letter-spacing: 0.05em; text-transform: uppercase; }
      .ed-telrow { display: flex; gap: 0.5rem; }
      .ed-telrow input { flex: 1; min-width: 0; }
      /* Solo la misura e il posto nella riga: la grafica del campo (fondo,
         bordo, angoli, freccia) arriva da field.css. */
      .ed-prefix { flex: 0 0 auto; width: 126px; }
      .ed-langs { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
      .ed-lang-pill {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-size: 0.9rem; padding: 0.5rem 0.9rem; border-radius: 999px;
        cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .ed-lang-pill:hover { border-color: var(--c-accent); }
      .ed-lang-pill.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); font-weight: 700; }
      .ed-lang-piu {
        background: transparent; border: 1px dashed var(--c-line); color: var(--c-muted);
        font-family: var(--font-body); font-size: 0.85rem; padding: 0.5rem 0.9rem; border-radius: 999px;
        cursor: pointer; display: inline-flex; align-items: center; gap: 0.3rem;
      }
      .ed-lang-piu:hover { color: var(--c-text); border-color: var(--c-text); }

      /* Toast */
      .toast {
        position: fixed; top: 1rem; left: 50%; transform: translateX(-50%) translateY(-8px);
        z-index: 400; background: var(--c-card); border: 1px solid var(--c-line);
        padding: 0.7rem 1.3rem; font-size: 0.9rem; border-radius: 999px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, calc(0.5 * var(--sh, 0.15)));
        opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.25s;
      }
      .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
      .toast.err { border-color: #a3320f; color: #ff8a8f; }

      /* Modulo ORDINI disattivato dal super admin: via colonna ordini (lista) e tab/statistiche ordini (modale) */
      .no-orders .c-orders, .no-orders .th[data-sort="orders"], .no-orders .act-tab[data-tab="order"] { display: none; }
      /* Mobile: righe → schede impilate con etichette */
      @media (max-width: 720px) {
        /* Barra compatta: [tutto] [Filtri] [ricerca]; i filtri escono a tendina sotto */
        .actionsbar { position: relative; align-items: stretch; flex-wrap: nowrap; gap: 0.55rem; }
        .fl-filtri { flex: 0 0 auto; align-items: stretch; gap: 0.55rem; }
        .fl-pill, .fl-toggle { align-self: stretch; }
        .fl-toggle { display: inline-flex; }
        .ab-sep { display: block; align-self: stretch; width: 1px; flex: 0 0 auto; background: var(--c-line); margin: 0.25rem 0; }
        .fl-more { display: none; position: absolute; top: calc(100% + 0.45rem); left: 0; right: 0; z-index: 20; background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px; padding: 0.75rem; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45); }
        .fl-filtri.open .fl-more { display: flex; }
        .search { margin-left: 0; flex: 1 1 auto; min-width: 0; }
        /* Niente ordinamento su mobile: qui la barra e' compatta e senza a capo
           ([tutto] [Filtri] [ricerca] [colonne]), un pulsante in piu' la
           strozzerebbe. Sopra i 720 c'e' spazio, ed e' anche dove le righe
           tornano una tabella vera. */
        .sortpick { display: none; }
        .thead { display: none; }
        .row {
          position: relative;
          grid-template-columns: 1fr auto;
          gap: 0.35rem 0.75rem;
          padding: 1rem 1.1rem;
        }
        /* Qui la riga e' una scheda, non una tabella: il selettore colonne
           non ha niente da spegnere. */
        .colpick { display: none; }
        .cell { white-space: normal; }
        .c-name { grid-column: 1; grid-row: 1; font-size: 0.97rem; min-width: 0; overflow: hidden; }
        .c-name .c-nome-txt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
        .c-since { display: none; }
        .c-act { position: absolute; right: 1.1rem; bottom: 1rem; flex-direction: column; gap: 0.45rem; margin: 0; }
        .cell[data-label]::before {
          content: attr(data-label) " · ";
          color: var(--c-muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;
        }
        .c-email, .c-phone { grid-column: 1 / -1; padding-left: calc(34px + 0.65rem); padding-right: 3.2rem; white-space: nowrap; overflow: hidden; }
        .c-email a, .c-phone a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
        .c-nums { display: flex; grid-column: 1 / -1; align-items: baseline; gap: 1.35rem; padding-left: calc(34px + 0.65rem); }
        .c-total { display: inline-flex; align-items: center; gap: 0.4rem; }
        .c-cash-ico { display: inline-flex; align-items: center; }
        .c-num { text-align: left; }
        .c-orders, .c-resa, .c-total { font-size: 1.1rem; }
      }
      /* iPad mini orizzontale (e tablet 721-1024): ricerca in alto a destra
         all'altezza del titolo, niente colonna email, font piu piccola per
         totali euro e conteggi ordini/prenotazioni. */
      @media (min-width: 721px) and (max-width: 1024px) {
        main { position: relative; }
        .titlebar { padding-right: 330px; }
        /* Centrata sulla riga del titolo: main ha padding-top 2rem, h1 ~1.3rem */
        .search { position: absolute; right: calc(1.5rem + 36px + 0.5rem); top: calc(2rem + 0.82rem); transform: translateY(-50%); margin: 0; flex: 0 0 auto; width: 260px; min-width: 0; z-index: 5; }
        .colpick { position: absolute; right: 1.5rem; top: calc(2rem + 0.82rem); transform: translateY(-50%); z-index: 6; }
        /* Email e DA le spegne colonneForzate() nel JS: la griglia si ricalcola
           da sola, qui restano solo le misure. */
        .thead, .row { gap: 0.55rem; }
        .th-ico .th-lbl { display: none; }                                /* pren/ord solo icona */
        .c-total { font-size: 1rem; }
        .c-resa, .c-orders { font-size: 1rem; }
      }
      /* Tablet in VERTICALE (es. iPad mini 768): nome e totale piu piccoli,
         cosi i bottoni edit/cancella rientrano meglio. */
      @media (min-width: 721px) and (max-width: 900px) {
        .c-name { font-size: 0.9rem; }
        .c-total { font-size: 0.88rem; }
      }
    </style>
    <AdminHead />
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <div class="titlebar">
          <h1><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>{t("nav.clients")}</h1>
          <div class="t-stats" id="t-stats"></div>
        </div>
        <div class="actionsbar">
          <div class="fl-filtri" id="fl-filtri">
            <button type="button" class="fl-pill is-on" data-f="all" title={t("cli.all")}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
            </button>
            <button type="button" class="fl-toggle" id="fl-toggle" aria-expanded="false">{t("cli.filters")} <span class="fl-toggle-n" id="fl-toggle-n"></span></button>
            <div class="fl-more" id="fl-more">
              <button type="button" class="fl-pill" data-f="new">{t("cli.new")}</button>
              <button type="button" class="fl-pill" data-f="noshow">{t("cli.noshow")}</button>
              <button type="button" class="fl-pill" data-f="optin">{t("cli.optin")}</button>
              <button type="button" class="fl-pill" data-f="optout">{t("cli.optout")}</button>
            </div>
          </div>
          <span class="ab-sep" aria-hidden="true"></span>
          <input id="search" class="search" type="search" placeholder={t("cli.searchPh")} />
          <div class="colpick sortpick" id="sortpick">
            <button type="button" class="cp-btn" id="sp-btn" aria-expanded="false" aria-haspopup="true" title={t("cli.sortTitle")} aria-label={t("cli.sortTitle")}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="4" y1="6" x2="16" y2="6" /><line x1="4" y1="12" x2="13" y2="12" /><line x1="4" y1="18" x2="10" y2="18" /><polyline points="17 15 20 18 17 21" /><line x1="20" y1="18" x2="20" y2="4" /></svg>
            </button>
            <div class="cp-menu" id="sp-menu" hidden>
              <div class="cp-h">{t("cli.sort")}</div>
              <div id="sp-list"></div>
            </div>
          </div>
          <div class="colpick" id="colpick">
            <button type="button" class="cp-btn" id="cp-btn" aria-expanded="false" aria-haspopup="true" title={t("cli.colsTitle")} aria-label={t("cli.colsTitle")}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="9" y1="3" x2="9" y2="21" /><line x1="15" y1="3" x2="15" y2="21" /></svg>
            </button>
            <div class="cp-menu" id="cp-menu" hidden>
              <div class="cp-h">{t("cli.cols")}</div>
              <div id="cp-list"></div>
            </div>
          </div>
          <div class="count" id="count" style="display:none"></div>
        </div>
        <div class="state" id="state">{t("sup.loading")}</div>
        <div id="content" style="display:none">
          <div class="table">
            <div class="thead">
              <button class="th" data-sort="name">{t("us.lname")} <span class="arrow"></span></button>
              <button class="th" data-sort="email">{t("ord.emailLabel")} <span class="arrow"></span></button>
              <button class="th" data-sort="phone">{t("ord.phone")} <span class="arrow"></span></button>
              <button class="th num" data-sort="since" title={t("cli.sinceTitle")}>{t("cli.since")} <span class="arrow"></span></button>
              <button class="th num th-ico" data-sort="reservations" title={t("nav.reservations")}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg><span class="th-lbl">{t("cli.resaCol")}</span> <span class="arrow"></span></button>
              <button class="th num th-ico" data-sort="orders" title={t("nav.orders")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 4 6v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6l-2-4Z" /><path d="M4 6h16" /><path d="M9 10a3 3 0 0 0 6 0" /></svg><span class="th-lbl">{t("nav.s.orders")}</span> <span class="arrow"></span></button>
              <button class="th num sorted" data-sort="total">{t("ord.total")} <span class="arrow">▼</span></button>
              <span class="th-act" aria-hidden="true"></span>
            </div>
            <div id="rows"></div>
          </div>
          <p class="state" id="empty" style="display:none"></p>
        </div>
      </main>
      <AdminFooter />
    </div>

    <!-- Modale attività cliente: storico ordini + prenotazioni -->
    <Modal id="act-overlay" title={t("ord.client")} titleId="act-name" width="1080px">
      <div class="act-cols">
        <div class="act-left">
          <p class="act-contacts" id="act-contacts"></p>
          <div class="act-flags" id="act-flags"></div>
          <div class="act-stats" id="act-stats"></div>
        </div>
        <div class="act-right">
          <div class="act-tabs" id="act-tabs">
            <button type="button" class="act-tab is-on" data-tab="reservation">{t("nav.reservations")} <span class="act-tab-n" id="act-n-resa">0</span></button>
            <button type="button" class="act-tab" data-tab="order">{t("nav.orders")} <span class="act-tab-n" id="act-n-ord">0</span></button>
          </div>
          <div class="act-state" id="act-state">{t("sup.loading")}</div>
          <div id="act-list"></div>
        </div>
      </div>
    </Modal>

    <!-- Bottone flottante per aggiungere (come Résa/Commandes) -->
    <button class="fab-add fab-pill" id="add-btn" type="button" title={t("cli.addClient")}><span class="fab-plus">+</span>{t("cli.clientWordCap")}</button>

    <!-- Modale modifica cliente (matita): dati + foto -->
    <Modal id="ed-overlay" title={t("cli.editClient")} titleId="ed-title" width="520px">
      <div class="f-field">
        <span class="f-label">{t("menu.photoOpt")}</span>
        <div class="ed-photo-row">
          <span class="c-avatar ed-avatar" id="ed-avatar">?</span>
          <button type="button" class="btn" id="ed-upload">{t("cli.uploadPhoto")}</button>
          <button type="button" class="btn" id="ed-photo-lib">{t("menu.library")}</button>
          <button type="button" class="btn btn-danger" id="ed-photo-rm" style="display:none">{t("ord.remove")}</button>
          <input type="file" id="ed-file" accept="image/*" style="display:none" />
          <span class="ed-upl-state" id="ed-upl-state"></span>
        </div>
      </div>
      <div class="ed-names">
        <div class="f-field"><span class="f-label">{t("ord.firstName")}</span><input type="text" id="ed-fname" maxlength="60" autocomplete="off" /></div>
        <div class="f-field"><span class="f-label">{t("ord.lastNameReq")}</span><input type="text" id="ed-lname" maxlength="60" autocomplete="off" /></div>
      </div>
      <div class="f-field"><span class="f-label">{t("ord.emailLabel")}</span><input type="email" id="ed-email" autocomplete="off" /></div>
      <div class="f-field"><span class="f-label">{t("ord.phone")}</span>
        <span class="ed-telrow">
          <select id="ed-prefix" class="ed-prefix" aria-label={t("cli.dialCode")}></select>
          <input type="tel" id="ed-phone" autocomplete="off" placeholder="455 12 34 56" />
        </span>
      </div>
      <div class="f-field"><span class="f-label">{t("cli.langCol")}</span><div class="ed-langs" id="ed-langs"></div><input type="hidden" id="ed-lang" /></div>
      <div class="ed-row2">
        <div><span class="f-label">{t("tab.marketing.news")}</span><p class="ed-hint" id="ed-news-state"></p></div>
        <button type="button" class="switch" role="switch" aria-checked="false" id="ed-news-btn"><span class="track"></span></button>
      </div>
      <div class="ed-row2" id="ed-block-row">
        <div><span class="f-label">{t("nav.reservations")}</span><p class="ed-hint" id="ed-block-state"></p></div>
        <button type="button" class="switch" role="switch" aria-checked="false" id="ed-block-btn"><span class="track"></span></button>
      </div>
      <Fragment slot="foot">
        <p class="ed-err" id="ed-err"></p>
        <button type="button" class="md-btn" data-md-close>{t("common.cancel")}</button>
        <button type="button" class="md-btn md-btn-primary" id="ed-save">{t("common.save")}</button>
      </Fragment>
    </Modal>


    <ImagePicker />

    <div class="toast" id="toast"></div>

    <AdminNav current="clients" />

    <!-- Dati SSR (Fase 2): lista clienti pre-caricata dal server. -->
    <script id="ssr-clients" type="application/json" is:inline set:html={ssrClientsJson}></script>

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { conAttesa } from "../../lib/admin/attesa";
      import { collegaLogout } from "../../lib/admin/logout";
      import { PREFISSI, separaPrefisso } from "../../lib/prefissi";
      import { LINGUE_WIDGET } from "../../lib/reservationI18n";
      import { CLIENT } from "../../config/client";
      import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";

      const LANG = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(LANG);
      const LOC = ADMIN_LOCALE[LANG] ?? "fr-BE";
      const LINGUE_MAP = new Map<string, (typeof LINGUE_WIDGET)[number]>(LINGUE_WIDGET.map((l) => [l.code, l]));
      // La lingua non ha piu una colonna: vive come bandierina sul badge.
      function flagBadge(code?: string | null): string {
        const l = LINGUE_MAP.get((code || "").toLowerCase());
        return l ? `<span class="c-flag" title="${esc(l.label)}">${l.flag}</span>` : "";
      }

      type Client = {
        id: string | null;
        name: string;
        email: string;
        phone: string;
        orders: number;
        reservations: number;
        noshows: number;
        photo_url?: string | null;
        blocked?: boolean;
        newsletter_optout?: boolean;
        lang?: string | null;
        total_cents: number;
        last_order: string | null;
        first_activity: string | null;
        manual: boolean;
        key?: string;
      };
      type Resp = { count: number; clients: Client[] };
      type SortKey = "name" | "email" | "phone" | "lang" | "since" | "orders" | "reservations" | "total";

      function esc(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }
      function euro(cents: number): string {
        return (cents / 100).toLocaleString(LOC, { style: "currency", currency: "EUR" });
      }
      const ICO_TEL =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>';
      const ICO_MAIL =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>';
      const ICO_ORD =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 4 6v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6l-2-4Z" /><path d="M4 6h16" /><path d="M9 10a3 3 0 0 0 6 0" /></svg>';
      const ICO_NOSHOW =
        '<svg class="ico-ns" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="4.9" y1="4.9" x2="19.1" y2="19.1" /></svg>';
      const ICO_RESA =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>';
      const ICO_CASH =
        '<svg viewBox="0 0 314.965 314.965" fill="currentColor" aria-hidden="true"><path d="M104.982,104.987c60.086,0,104.983-23.753,104.983-44.992c0-21.237-44.898-44.991-104.983-44.991S0,38.758,0,59.995C0,81.234,44.896,104.987,104.982,104.987z"/><path d="M104.982,284.961c8.77,0,17.211-0.51,25.24-1.439c-6.768-8.698-12.365-18.35-16.558-28.716c-2.881,0.097-5.772,0.164-8.683,0.164c-34.333,0-66.847-6.803-91.55-19.155C8.567,233.383,4.091,230.77,0,228.004v11.966C0,261.207,44.896,284.961,104.982,284.961z"/><path d="M104.982,224.97c0.308,0,0.611-0.005,0.918-0.006c-0.615-4.916-0.936-9.923-0.936-15.003c0-5.078,0.32-10.082,0.936-14.994c-0.307,0-0.611,0.011-0.918,0.011c-34.333,0-66.846-6.803-91.55-19.155c-4.865-2.432-9.342-5.045-13.433-7.81v11.965C0,201.216,44.896,224.97,104.982,224.97z"/><path d="M104.982,164.977c2.976,0,5.912-0.06,8.811-0.174c4.656-11.423,11.019-21.974,18.777-31.331c-8.982,0.99-18.213,1.515-27.588,1.515c-34.333,0-66.846-6.803-91.55-19.155c-4.865-2.433-9.342-5.045-13.433-7.811v11.966C0,141.225,44.896,164.977,104.982,164.977z"/><path d="M149.982,160.244c-6.49,9.757-11.127,20.846-13.408,32.762c-1.053,5.493-1.609,11.16-1.609,16.955c0,4.357,0.318,8.641,0.919,12.834c1.477,10.301,4.704,20.041,9.37,28.914c4.896,9.311,11.373,17.666,19.076,24.701c16.008,14.621,37.298,23.551,60.635,23.551c49.626,0,90-40.374,90-90c0-49.627-40.374-90-90-90c-5.129,0-10.158,0.438-15.056,1.266C184.961,125.446,163.473,139.965,149.982,160.244z"/></svg>';
      const ICO_CHECK =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>';
      const ICO_EDIT =
        '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" /></svg>';
      const ICO_TRASH =
        '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /></svg>';

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const contentEl = document.getElementById("content") as HTMLDivElement;
        const rowsEl = document.getElementById("rows") as HTMLDivElement;
        const emptyEl = document.getElementById("empty") as HTMLParagraphElement;
        const countEl = document.getElementById("count") as HTMLDivElement;
        const searchEl = document.getElementById("search") as HTMLInputElement;
        const theadEl = document.querySelector(".thead") as HTMLDivElement;
        const toastEl = document.getElementById("toast") as HTMLDivElement;

        // Modale
        const addBtn = document.getElementById("add-btn") as HTMLButtonElement;
        let filtroLista: "all" | "new" | "noshow" | "optin" | "optout" = "all";
        let filtroLingua = "";
        const flFiltriEl = document.getElementById("fl-filtri") as HTMLDivElement;
        const flMoreEl = document.getElementById("fl-more") as HTMLDivElement;
        const flToggleEl = document.getElementById("fl-toggle") as HTMLButtonElement;
        const flToggleN = document.getElementById("fl-toggle-n") as HTMLSpanElement;
        // Bottone "Filtri" (mobile): corallo + numero se ci sono filtri attivi.
        function aggiornaToggle() {
          const n = (filtroLista !== "all" ? 1 : 0) + (filtroLingua ? 1 : 0);
          flToggleEl.classList.toggle("has-active", n > 0);
          flToggleN.textContent = n > 0 ? String(n) : "";
        }
        flToggleEl.addEventListener("click", () => {
          const open = flFiltriEl.classList.toggle("open");
          flToggleEl.setAttribute("aria-expanded", open ? "true" : "false");
        });
        document.addEventListener("click", (e) => {
          if (!flFiltriEl.contains(e.target as Node)) flFiltriEl.classList.remove("open");
        });
        flFiltriEl.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".fl-pill") as HTMLElement | null;
          if (!b) return;
          // Chip LINGUA (data-l): toggle indipendente; riclic = tutte le lingue.
          if (b.dataset.l !== undefined) {
            const val = b.dataset.l;
            filtroLingua = filtroLingua === val ? "" : val;
            flMoreEl.querySelectorAll<HTMLElement>(".fl-pill[data-l]").forEach((x) =>
              x.classList.toggle("is-on", filtroLingua !== "" && x.dataset.l === filtroLingua)
            );
            flFiltriEl.classList.remove("open");
            render();
            return;
          }
          const fSel = b.dataset.f ?? "all";
          filtroLista =
            fSel === "new" || fSel === "noshow" || fSel === "optin" || fSel === "optout" ? fSel : "all";
          // "Tutto" = clear all: azzera anche il filtro lingua
          if (filtroLista === "all") {
            filtroLingua = "";
            flMoreEl.querySelectorAll<HTMLElement>(".fl-pill[data-l]").forEach((x) => x.classList.remove("is-on"));
          }
          flFiltriEl.querySelectorAll<HTMLElement>(".fl-pill[data-f]").forEach((x) => x.classList.toggle("is-on", x === b));
          flFiltriEl.classList.remove("open");
          render();
        });

        // Chip LINGUA: aggiunte in coda alla riga dei filtri (accanto a Opted-out).
        function costruisciLingue() {
          flMoreEl.querySelectorAll(".fl-pill[data-l], .fl-sep").forEach((x) => x.remove());
          const conta = new Map<string, number>();
          for (const c of tutti) {
            const l = (c.lang || "").toLowerCase();
            if (l && LINGUE_MAP.has(l)) conta.set(l, (conta.get(l) ?? 0) + 1);
          }
          if (conta.size < 1) { filtroLingua = ""; return; }
          if (filtroLingua && !conta.has(filtroLingua)) filtroLingua = "";
          const html = [...conta.entries()]
            .sort((a, b) => b[1] - a[1])
            .map(([code, n]) => {
              const li = LINGUE_MAP.get(code);
              const on = filtroLingua === code;
              return `<button type="button" class="fl-pill${on ? " is-on" : ""}" data-l="${code}">${li ? li.flag : ""} ${code.toUpperCase()} <span class="n">${n}</span></button>`;
            })
            .join("");
          flMoreEl.insertAdjacentHTML("beforeend", `<span class="fl-sep" aria-hidden="true"></span>${html}`);
        }
        // Bottone flottante allineato con l'isola dei link (come Résa/Commandes)
        function posizionaAdd() {
          const barra = document.querySelector(".admin-nav") as HTMLElement | null;
          if (!barra) return;
          // Deve combaciare con fab.css (641): sotto, i FAB stanno sopra la barra.
          if (!window.matchMedia("(min-width: 641px)").matches) {
            addBtn.style.height = "";
            addBtn.style.bottom = "";
            return;
          }
          const r = barra.getBoundingClientRect();
          addBtn.style.height = `${r.height}px`;
          addBtn.style.bottom = `${window.innerHeight - r.bottom}px`;
        }
        posizionaAdd();
        window.addEventListener("resize", posizionaAdd);
        const PREFISSO_DEFAULT = PREFISSI.find((pf) => pf.code === CLIENT.paese)?.dial ?? PREFISSI[0].dial;
        // Select prefisso del MODALE cliente (stessa lista del widget)
        const edPrefixEl = () => document.getElementById("ed-prefix") as HTMLSelectElement;
        edPrefixEl().innerHTML = PREFISSI.map(
          (pf) => `<option value="${pf.dial}" title="${pf.nome}">${pf.flag} ${pf.dial}</option>`
        ).join("");
        edPrefixEl().value = PREFISSO_DEFAULT;
        // Lingue pubbliche attive del sito (da /api/admin/pages); default storico FR+EN.
        let publicLangs: string[] = ["fr", "en"];
        // Lingua del cliente: pillole (lingue pubbliche attive) + "+N lingue"
        // per svelare le altre. Valore selezionato tenuto in un input nascosto.
        const edLangEl = () => document.getElementById("ed-lang") as HTMLInputElement;
        let edLangExpanded = false;
        function costruisciEdLingue(): void {
          const cont = document.getElementById("ed-langs");
          if (!cont) return;
          const sel = (edLangEl().value || "").toLowerCase();
          const pubSet = new Set(publicLangs.filter((c) => LINGUE_MAP.has(c)));
          const publiche = [...pubSet];
          const extra = LINGUE_WIDGET.map((l) => l.code).filter((c) => !pubSet.has(c));
          // se il cliente ha una lingua non pubblica, mostrala comunque
          const mostraExtra = edLangExpanded || (sel !== "" && !pubSet.has(sel));
          const pill = (code: string): string => {
            const l = LINGUE_MAP.get(code);
            if (!l) return "";
            const on = sel === code ? " is-on" : "";
            return `<button type="button" class="ed-lang-pill${on}" data-l="${code}">${l.flag} ${l.label}</button>`;
          };
          let html = publiche.map(pill).join("");
          if (mostraExtra) {
            html += extra.map(pill).join("");
          } else if (extra.length) {
            html += `<button type="button" class="ed-lang-piu" id="ed-lang-piu">+${extra.length} ${tr("cli.langsMore")}</button>`;
          }
          cont.innerHTML = html;
        }
        document.getElementById("ed-langs")?.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest("button");
          if (!btn) return;
          if (btn.id === "ed-lang-piu") { edLangExpanded = true; costruisciEdLingue(); return; }
          const code = (btn as HTMLElement).dataset.l;
          if (!code) return;
          const cur = (edLangEl().value || "").toLowerCase();
          edLangEl().value = cur === code ? "" : code;  // riclic = deseleziona
          costruisciEdLingue();
        });
        // "+33 6…" o "0033…" digitato nel numero → prefisso riconosciuto e
        // spostato nella tendina, numero ripulito. Stava solo sul modale
        // «aggiungi» che nessuno apriva piu': qui e' sul modale vero.
        (document.getElementById("ed-phone") as HTMLInputElement).addEventListener("input", (e) => {
          const campo = e.target as HTMLInputElement;
          const sep = separaPrefisso(campo.value);
          if (!sep) return;
          edPrefixEl().value = sep.dial;
          campo.value = sep.resto;
        });

        collegaLogout(logoutBtn);

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        const token = session.access_token ?? "";
        let headers = { Authorization: `Bearer ${token}` };

        // Il token Supabase SCADE (di norma dopo un'ora). Con `headers` fissato
        // una volta sola al caricamento, un tab lasciato aperto continuava a
        // mandare il token vecchio: ogni salvataggio tornava «Non autorisé»,
        // e in certi punti il campo spariva senza spiegazione. supabase-js
        // rinnova il token da solo in background: qui ci limitiamo ad
        // ASCOLTARLO e a riscrivere l'header. Nessuna chiamata da cambiare.
        supabaseBrowser.auth.onAuthStateChange((_evento, sessione) => {
          if (sessione?.access_token) headers = { Authorization: `Bearer ${sessione.access_token}` };
        });

        // Modulo "Commandes" disattivato dal super admin (app_config admin_pages_hidden):
        // nasconde la colonna ordini nella lista e il tab/statistiche ordini nel modale.
        let ordersHidden = false;
        void fetch("/api/admin/pages", { headers })
          .then((r) => (r.ok ? r.json() : null))
          .then((j: { hidden?: unknown; publicLangs?: unknown } | null) => {
            const hid = Array.isArray(j?.hidden) ? (j!.hidden as unknown[]).map(String) : [];
            ordersHidden = hid.includes("orders");
            app.classList.toggle("no-orders", ordersHidden);
            applicaColonne();  // la colonna ordini esce anche dalla griglia
            if (Array.isArray(j?.publicLangs) && j!.publicLangs!.length) {
              publicLangs = (j!.publicLangs as unknown[]).map(String);
              costruisciEdLingue();  // aggiorna le pillole se il modale è già aperto
            }
          })
          .catch(() => { /* default: modulo attivo */ });

        let tutti: Client[] = [];
        let sortKey: SortKey = "total";
        let sortAsc = false;
        let filtro = "";
        let tCancella = 0;

        /* ---- Colonne: preferenza dell'utente + larghezza + modulo ordini ----
           Un'unica sorgente: le larghezze non stanno piu nei @media ma qui,
           perche il set visibile dipende anche da una scelta dell'utente che
           il CSS non puo conoscere. --grid-cols finisce su .table. */
        type ColKey = "email" | "phone" | "since" | "reservations" | "orders" | "total";
        const COLONNE: { k: ColKey; w: string; lab: string }[] = [
          { k: "email", w: "minmax(0, 2fr)", lab: tr("ord.emailLabel") },
          { k: "phone", w: "minmax(0, 1.3fr)", lab: tr("ord.phone") },
          { k: "since", w: "136px", lab: tr("cli.since") },
          { k: "reservations", w: "66px", lab: tr("cli.resaCol") },
          { k: "orders", w: "66px", lab: tr("nav.s.orders") },
          { k: "total", w: "120px", lab: tr("ord.total") },
        ];
        const colPref: Record<ColKey, boolean> = {
          email: true, phone: true, since: true,
          reservations: true, orders: true, total: true,
        };
        try {
          const grezzo = localStorage.getItem("mdd_cli_cols");
          if (grezzo) {
            const j = JSON.parse(grezzo) as Partial<Record<ColKey, boolean>>;
            COLONNE.forEach((c) => { if (typeof j[c.k] === "boolean") colPref[c.k] = j[c.k] as boolean; });
          }
        } catch { /* storage non disponibile o JSON rotto: si tengono i default */ }

        // Larghezze in cui una colonna sparisce comunque, preferenza o no.
        // Coppie della scala del motore (ENGINE.md): 1024/1025 e 1279/1280.
        const MQ_TABLET = window.matchMedia("(min-width: 721px) and (max-width: 1024px)");
        const MQ_STRETTO = window.matchMedia("(min-width: 1025px) and (max-width: 1279px)");
        function colonneForzate(): Set<ColKey> {
          const f = new Set<ColKey>();
          if (MQ_TABLET.matches) { f.add("email"); f.add("since"); }
          else if (MQ_STRETTO.matches) f.add("since");
          if (ordersHidden) f.add("orders");
          return f;
        }
        const cpBtn = document.getElementById("cp-btn") as HTMLButtonElement | null;
        const cpMenu = document.getElementById("cp-menu") as HTMLElement | null;
        const cpList = document.getElementById("cp-list") as HTMLElement | null;

        function applicaColonne() {
          const forzate = colonneForzate();
          const viste = COLONNE.filter((c) => colPref[c.k] && !forzate.has(c.k));
          const tav = document.querySelector(".table") as HTMLElement | null;
          if (tav) {
            tav.style.setProperty(
              "--grid-cols",
              ["minmax(120px, var(--col-nome, 220px))", ...viste.map((c) => c.w), "96px"].join(" "),
            );
            COLONNE.forEach((c) => tav.classList.toggle(`off-${c.k}`, !viste.some((v) => v.k === c.k)));
          }
          if (cpList) {
            cpList.innerHTML = COLONNE.map((c) => {
              const bloccata = forzate.has(c.k);
              return `<button type="button" class="cp-item" role="menuitemcheckbox" data-col="${c.k}"` +
                ` aria-checked="${colPref[c.k] ? "true" : "false"}"` +
                (bloccata ? ` disabled title="${esc(tr("cli.colAuto"))}"` : "") +
                `><span class="cp-box">${ICO_CHECK}</span>${esc(c.lab)}</button>`;
            }).join("");
          }
        }
        /**
         * Menu a tendina della barra azioni (colonne, ordinamento).
         * Una funzione sola: apre/chiude, chiude cliccando fuori, chiude con
         * Escape, e CHIUDE GLI ALTRI quando se ne apre uno — cosi' i due menu
         * non restano aperti uno sopra l'altro. Duplicare questa logica per
         * ogni menu e' il modo in cui poi ne resta uno indietro.
         */
        const tendine: (() => void)[] = [];
        function menuTendina(btn: HTMLButtonElement, menu: HTMLElement) {
          const chiudi = () => {
            if (menu.hidden) return;
            menu.hidden = true;
            btn.setAttribute("aria-expanded", "false");
          };
          tendine.push(chiudi);
          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const apri = menu.hidden;
            for (const c of tendine) c();
            menu.hidden = !apri;
            btn.setAttribute("aria-expanded", apri ? "true" : "false");
          });
          document.addEventListener("click", (e) => {
            if (menu.contains(e.target as Node) || btn.contains(e.target as Node)) return;
            chiudi();
          });
          document.addEventListener("keydown", (e) => { if (e.key === "Escape") chiudi(); });
          return chiudi;
        }

        if (cpBtn && cpMenu) {
          menuTendina(cpBtn, cpMenu);
          cpMenu.addEventListener("click", (e) => {
            const b = (e.target as HTMLElement).closest(".cp-item") as HTMLButtonElement | null;
            if (!b || b.disabled) return;
            const k = b.dataset.col as ColKey;
            colPref[k] = !colPref[k];
            try { localStorage.setItem("mdd_cli_cols", JSON.stringify(colPref)); } catch { /* storage pieno */ }
            applicaColonne();
          });
        }

        // ---- Ordinamento: stesse chiavi dei `.th`, ma raggiungibili ----
        // L'intestazione della tabella e' nascosta a ogni larghezza, quindi
        // i suoi pulsanti non li puo' premere nessuno: il comando e' qui.
        const ORDINI: { k: SortKey; lab: string }[] = [
          { k: "name", lab: tr("us.lname") },
          { k: "email", lab: tr("ord.emailLabel") },
          { k: "phone", lab: tr("ord.phone") },
          { k: "since", lab: tr("cli.since") },
          { k: "reservations", lab: tr("cli.resaCol") },
          { k: "orders", lab: tr("nav.s.orders") },
          { k: "total", lab: tr("ord.total") },
        ];
        const spBtn = document.getElementById("sp-btn") as HTMLButtonElement | null;
        const spMenu = document.getElementById("sp-menu") as HTMLElement | null;
        const spList = document.getElementById("sp-list") as HTMLElement | null;

        function renderOrdini() {
          if (!spList) return;
          spList.innerHTML = ORDINI.map((o) => {
            const attivo = o.k === sortKey;
            // La freccia indica il verso SOLO sulla voce attiva: sulle altre
            // sarebbe una promessa su un verso che non e' ancora stato scelto.
            const dir = attivo ? `<span class="cp-dir">${sortAsc ? "▲" : "▼"}</span>` : "";
            return `<button type="button" class="cp-item${attivo ? " is-on" : ""}" data-sk="${o.k}"` +
              ` aria-current="${attivo ? "true" : "false"}"><span class="cp-box">${dir}</span>${esc(o.lab)}</button>`;
          }).join("");
        }
        if (spBtn && spMenu && spList) {
          menuTendina(spBtn, spMenu);
          spMenu.addEventListener("click", (e) => {
            const b = (e.target as HTMLElement).closest(".cp-item") as HTMLButtonElement | null;
            if (!b) return;
            const k = b.dataset.sk as SortKey;
            // Stessa regola dei `.th`: stessa chiave = inverte, chiave nuova =
            // parte dal verso che ha senso per quel dato (A-Z per il testo,
            // dal piu' alto per i numeri).
            if (k === sortKey) sortAsc = !sortAsc;
            else {
              sortKey = k;
              sortAsc = k === "name" || k === "email" || k === "phone";
            }
            updateHeader();
            renderOrdini();
            render();
          });
          renderOrdini();
        }
        MQ_TABLET.addEventListener("change", applicaColonne);
        MQ_STRETTO.addEventListener("change", applicaColonne);
        applicaColonne();

        function toast(msg: string, err = false) {
          toastEl.textContent = msg;
          toastEl.className = "toast show" + (err ? " err" : "");
          clearTimeout(tCancella);
          tCancella = window.setTimeout(() => (toastEl.className = "toast"), 2600);
        }

        function compare(a: Client, b: Client): number {
          let r: number;
          if (sortKey === "since")
            r = (a.first_activity ? Date.parse(a.first_activity) : 0) - (b.first_activity ? Date.parse(b.first_activity) : 0);
          else if (sortKey === "orders") r = a.orders - b.orders;
          else if (sortKey === "reservations") r = a.reservations - b.reservations;
          else if (sortKey === "total") r = a.total_cents - b.total_cents;
          else r = String(a[sortKey] || "").localeCompare(String(b[sortKey] || ""), LOC, { sensitivity: "base" });
          return sortAsc ? r : -r;
        }

        function render() {
          const q = filtro.trim().toLowerCase();
          let lista = tutti
            .filter((c) =>
              !q ||
              c.name.toLowerCase().includes(q) ||
              c.email.toLowerCase().includes(q) ||
              c.phone.toLowerCase().includes(q)
            )
            .sort(compare);

          if (filtroLista === "new")
            lista = lista.filter(
              (c) => !!c.first_activity && Date.now() - Date.parse(c.first_activity) < 14 * 86400000
            );
          if (filtroLista === "noshow") lista = lista.filter((c) => (c.noshows ?? 0) > 0);
          if (filtroLista === "optin") lista = lista.filter((c) => c.email && !c.newsletter_optout);
          if (filtroLista === "optout") lista = lista.filter((c) => Boolean(c.newsletter_optout));
          if (filtroLingua) lista = lista.filter((c) => (c.lang || "").toLowerCase() === filtroLingua);

          countEl.textContent =
            `${lista.length} ${lista.length > 1 ? tr("cli.clientsWord") : tr("cli.clientWord")}` +
            (q && lista.length !== tutti.length ? ` / ${tutti.length}` : "");
          countEl.style.display = q ? "" : "none"; // conteggio filtrato: solo in ricerca

          // Pillola del titolo: solo il totale; i conteggi vivono nei filtri
          const nNuovi = tutti.filter(
            (c) => !!c.first_activity && Date.now() - Date.parse(c.first_activity) < 14 * 86400000
          ).length;
          const nOptin = tutti.filter((c) => c.email && !c.newsletter_optout).length;
          const nOptout = tutti.filter((c) => Boolean(c.newsletter_optout)).length;
          const nNoshow = tutti.filter((c) => (c.noshows ?? 0) > 0).length;
          (document.getElementById("t-stats") as HTMLDivElement).innerHTML =
            `<span class="t-pill gold"><b>${tutti.length}</b> ${tutti.length > 1 ? tr("cli.clientsWord") : tr("cli.clientWord")}</span>`;
          const setFl = (f: string, label: string, n: number) => {
            const b = document.querySelector(`#fl-filtri .fl-pill[data-f="${f}"]`) as HTMLElement | null;
            if (b) b.innerHTML = `${label} <b>${n}</b>`;
          };
          setFl("new", tr("cli.new"), nNuovi);
          setFl("noshow", tr("cli.noshow"), nNoshow);
          setFl("optin", tr("cli.optin"), nOptin);
          setFl("optout", tr("cli.optout"), nOptout);
          aggiornaToggle();

          if (!lista.length) {
            rowsEl.innerHTML = "";
            emptyEl.textContent = tutti.length
              ? tr("cli.noneMatch")
              : tr("cli.noneYet");
            emptyEl.style.display = "block";
            return;
          }
          emptyEl.style.display = "none";

          rowsEl.innerHTML = lista
            .map((c) => {
              const email = esc(c.email);
              const phone = esc(c.phone);
              // New: cliente arrivato da meno di 2 settimane (solo tempo,
              // resta anche se nel frattempo riordina o riprenota)
              const nuovo = !!c.first_activity && Date.now() - Date.parse(c.first_activity) < 14 * 86400000;
              const parti = (c.name ?? "").trim().split(/\s+/).filter(Boolean);
              const iniz = ((parti[0]?.[0] ?? "") + (parti[1]?.[0] ?? "")).toUpperCase() || "?";
              const bandiera = flagBadge(c.lang);
              const avatar = c.photo_url
                ? `<span class="c-avatar"><img src="${esc(c.photo_url)}" alt="" />${bandiera}</span>`
                : `<span class="c-avatar">${esc(iniz)}${bandiera}</span>`;
              const attivita =
                (c.noshows ?? 0) > 0
                  ? `<span class="tag-ns" title="${c.noshows} ${tr("cli.noshow")}">${ICO_NOSHOW}${c.noshows}</span>`
                  : "";
              return `
              <div class="row${c.blocked ? " is-blocked" : ""}" data-key="${esc(c.key ?? "")}">
                <div class="cell c-name">${avatar}<span class="c-nome-txt">${esc(c.name) || "—"}</span>${nuovo ? `<span class="tag-new">${tr("cli.new")}</span>` : ""}${attivita}</div>
                <div class="cell c-email"><span class="c-c-ico">${ICO_MAIL}</span>${email ? `<a href="mailto:${email}">${email}</a>` : "—"}</div>
                <div class="cell c-phone"><span class="c-c-ico">${ICO_TEL}</span>${phone ? `<a href="tel:${phone.replace(/\s/g, "")}">${phone}</a>` : "—"}</div>
                <div class="cell c-since" data-label="${tr("cli.since")}">${
                  c.first_activity
                    ? new Date(c.first_activity).toLocaleDateString(LOC, { day: "2-digit", month: "2-digit", year: "2-digit" })
                    : "—"
                }</div>
                <div class="c-nums"><div class="cell c-num c-resa"><span class="c-num-ico">${ICO_RESA}</span>${c.reservations}</div>
                <div class="cell c-num c-orders"><span class="c-num-ico">${ICO_ORD}</span>${c.orders}</div>
                <div class="cell c-num c-total${c.total_cents ? "" : " vuoto"}"><span class="c-cash-ico">${ICO_CASH}</span>${c.total_cents ? euro(c.total_cents) : "—"}</div></div>
                <div class="cell c-act"><button class="i-btn i-edit" data-editkey="${esc(c.key ?? "")}" title="${tr("common.edit")}">${ICO_EDIT}</button><button class="i-btn i-del" data-id="${esc(c.id ?? "")}" data-email="${email}" data-phone="${phone}" data-name="${esc(c.name)}" data-orders="${c.orders}" title="${tr("common.delete")}">${ICO_TRASH}</button></div>
              </div>`;
            })
            .join("");
          // Colonna Nom = nome più largo (tag e icone comprese): mai troncato,
          // email e téléphone si stringono per fargli spazio
          const tavola = document.querySelector(".table") as HTMLElement | null;
          if (tavola) {
            let maxNome = 120;
            rowsEl.querySelectorAll<HTMLElement>(".c-name").forEach((el) => {
              maxNome = Math.max(maxNome, el.scrollWidth);
            });
            // +28: il nome misurato al pixel incollava l'email al cognome.
            // E' aria, non troncamento: la traccia e' un minmax, se manca spazio si stringe.
            tavola.style.setProperty("--col-nome", `${Math.min(maxNome + 28, 480)}px`);
          }
        }

        function updateHeader() {
          theadEl.querySelectorAll(".th").forEach((el) => {
            const th = el as HTMLElement;
            const active = th.dataset.sort === sortKey;
            th.classList.toggle("sorted", active);
            const arrow = th.querySelector(".arrow") as HTMLElement;
            arrow.textContent = active ? (sortAsc ? "▲" : "▼") : "";
          });
        }

        theadEl.addEventListener("click", (e) => {
          const th = (e.target as HTMLElement).closest(".th") as HTMLElement | null;
          if (!th) return;
          const k = th.dataset.sort as SortKey;
          if (k === sortKey) sortAsc = !sortAsc;
          else {
            sortKey = k;
            sortAsc = k === "name" || k === "email" || k === "phone";
          }
          updateHeader();
          render();
        });

        searchEl.addEventListener("input", () => {
          filtro = searchEl.value;
          render();
        });

        // Cancella un cliente — conferma a 2 tocchi (come nel menu).
        // Manuale senza ordini: eliminato davvero. Con ordini: nascosto
        // dalla lista (gli ordini restano in contabilità).
        // ---- Modale attività cliente ----
        const actOverlay = document.getElementById("act-overlay") as HTMLDivElement;
        const actList = document.getElementById("act-list") as HTMLDivElement;
        const actState = document.getElementById("act-state") as HTMLDivElement;
        // Storico cliente diviso in due tab (prenotazioni / ordini) per non
        // avere una lista unica enorme. Dati caricati una volta, filtrati qui.
        type Att = { type: string; when: string; label: string; status: string; amount_cents: number | null };
        let actAtti: Att[] = [];
        let actTab: "reservation" | "order" = "reservation";
        const actTabsEl = document.getElementById("act-tabs") as HTMLDivElement;
        const actNResa = document.getElementById("act-n-resa") as HTMLSpanElement;
        const actNOrd = document.getElementById("act-n-ord") as HTMLSpanElement;
        function renderAtti() {
          actTabsEl.querySelectorAll(".act-tab").forEach((b) =>
            b.classList.toggle("is-on", (b as HTMLElement).dataset.tab === actTab)
          );
          const lista = actAtti.filter((a) => (actTab === "order" ? a.type === "order" : a.type === "reservation"));
          if (!lista.length) {
            actList.innerHTML = "";
            actState.style.display = "";
            actState.textContent = tr("cli.noActivity");
            return;
          }
          actState.style.display = "none";
          actList.innerHTML = lista
            .map((a) => {
              const ico = a.type === "order" ? ICO_ORD : ICO_RESA;
              const stato =
                a.type === "reservation" && a.status !== "confirmed" && a.status !== "done"
                  ? `<span class="act-status ${a.status === "cancelled" ? "ko" : "ns"}">${STATO_ACT[a.status] ?? a.status}</span>`
                  : "";
              const importo = a.amount_cents != null ? `<span class="act-amount">${euro(a.amount_cents)}</span>` : "";
              return `<div class="act-row">
                    <span class="act-ico">${ico}</span>
                    <span class="act-when">${dataOra(a.when)}</span>
                    <span class="act-label">${esc(a.label)}</span>
                    ${importo}${stato}
                  </div>`;
            })
            .join("");
        }
        actTabsEl.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".act-tab") as HTMLElement | null;
          if (!b) return;
          actTab = b.dataset.tab === "order" ? "order" : "reservation";
          renderAtti();
        });
        function chiudiAttivita() {
          actOverlay.hidden = true;
        }
        // Chiusura: le ancore del guscio condiviso (sfondo + ×).
        actOverlay.querySelectorAll("[data-md-close]").forEach((el) => {
          el.addEventListener("click", chiudiAttivita);
        });
        function dataOra(iso: string): string {
          const d = new Date(iso);
          const gg = `${String(d.getDate()).padStart(2, "0")}/${String(d.getMonth() + 1).padStart(2, "0")}/${d.getFullYear()}`;
          const hh = `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
          return `${gg} · ${hh}`;
        }
        const STATO_ACT: Record<string, string> = {
          cancelled: tr("res.stCancelled"),
          noshow: tr("res.stNoshow"),
          done: tr("res.stDone"),
          confirmed: tr("res.stConfirmed"),
          seated: tr("res.stSeated"),
          paid: tr("cli.stPaid"),
        };
        let actKeyCorrente = "";
        function fmtMinAct(m: number): string {
          return m < 90 ? `${Math.max(1, Math.round(m))} min` : `${Math.floor(m / 60)} h ${String(Math.round(m) % 60).padStart(2, "0")}`;
        }
        const actFlags = document.getElementById("act-flags") as HTMLDivElement;
        let actFlagCliente: Client | null = null;
        function renderActFlags(c: Client) {
          actFlagCliente = c;
          const parti: string[] = [];
          if (c.email) {
            const optout = Boolean(c.newsletter_optout);
            parti.push(
              `<div class="ed-row2"><div><span class="f-label">${tr("tab.marketing.news")}</span><p class="ed-hint ${optout ? "warn" : "ok"}">${optout ? tr("cli.optedOut") : tr("cli.optedIn")}</p></div><button type="button" class="switch" role="switch" aria-checked="${optout ? "false" : "true"}" aria-label="${tr("tab.marketing.news")}" data-aflag="news"><span class="track"></span></button></div>`
            );
          }
          const bl = Boolean(c.blocked);
          parti.push(
            `<div class="ed-row2"><div><span class="f-label">${tr("nav.reservations")}</span><p class="ed-hint ${bl ? "warn" : "ok"}">${bl ? tr("cli.blockedShort") : tr("cli.allowedShort")}</p></div><button type="button" class="switch" role="switch" aria-checked="${bl ? "false" : "true"}" aria-label="${tr("nav.reservations")}" data-aflag="block"><span class="track"></span></button></div>`
          );
          actFlags.innerHTML = parti.join("");
        }
        actFlags.addEventListener("click", async (e) => {
          const btn = (e.target as HTMLElement).closest("button[data-aflag]") as HTMLButtonElement | null;
          if (!btn || !actFlagCliente) return;
          const c = actFlagCliente;
          const which = btn.dataset.aflag;
          const nuovoOptout = which === "news" ? !Boolean(c.newsletter_optout) : Boolean(c.newsletter_optout);
          const nuovoBlocked = which === "block" ? !Boolean(c.blocked) : Boolean(c.blocked);
          btn.disabled = true;
          try {
            const res = await fetch("/api/admin/clients", {
              method: "PATCH",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({
                id: c.id ?? null,
                match_email: c.email,
                match_phone: c.phone,
                name: c.name,
                email: c.email,
                phone: c.phone,
                photo_url: c.photo_url ?? null,
                newsletter_optout: nuovoOptout,
                blocked: nuovoBlocked,
              }),
            });
            if (!res.ok) { toast(tr("common.saveErr"), true); return; }
            c.newsletter_optout = nuovoOptout;
            c.blocked = nuovoBlocked;
            renderActFlags(c);
            render();
            toast(tr("cli.clientModified"));
          } catch {
            toast(tr("res.connErr"), true);
          } finally {
            btn.disabled = false;
          }
        });
        async function apriAttivita(c: Client) {
          const mioKey = c.key ?? "";
          actKeyCorrente = mioKey;
          const titleEl = document.getElementById("act-name") as HTMLElement;
          titleEl.textContent = c.name || "—";
          if (c.first_activity && Date.now() - Date.parse(c.first_activity) < 14 * 86400000)
            titleEl.insertAdjacentHTML("beforeend", `<span class="act-new">${tr("cli.new")}</span>`);
          const cont: string[] = [];
          if (c.phone) cont.push(`<span class="r-c">${ICO_TEL}<a href="tel:${c.phone.replace(/\s/g, "")}">${esc(c.phone)}</a></span>`);
          if (c.email) cont.push(`<span class="r-c">${ICO_MAIL}<a href="mailto:${esc(c.email)}">${esc(c.email)}</a></span>`);
          (document.getElementById("act-contacts") as HTMLElement).innerHTML = cont.join("");

          const statsBox = document.getElementById("act-stats") as HTMLDivElement;
          const ordCount = c.orders ?? 0;
          const resaBase = c.reservations ?? 0;
          const noshowBase = c.noshows ?? 0;
          const rigaSt = (k: string, v: string, hl = false) => `<div class="st-row${hl ? " hl" : ""}"><span class="k">${k}</span><span class="v">${v}</span></div>`;
          const sezione = (ico: string, titolo: string, cnt: string, rows: string[], extra = "") =>
            rows.length ? `<div class="st-sec"><div class="st-sec-h">${ico}<span class="t">${titolo}</span><span class="cnt">${cnt}</span></div>${rows.join("")}${extra}</div>` : "";
          // I piatti piu' ordinati arrivano dopo, da una loro chiamata: li
          // teniamo qui insieme all'ultimo pacchetto di statistiche, cosi'
          // qualunque dei due arrivi per secondo ridisegna con tutto.
          type StatsEx = { total: number; noshows: number; cancelled: number; avg_people: number | null; avg_lead_min: number | null; avg_table_min: number | null; avg_spent_cents: number | null };
          let exUltimo: StatsEx | null = null;
          let topPiatti: Array<{ name: string; qty: number }> = [];
          const renderStats = (ex: StatsEx | null) => {
            exUltimo = ex;
            const secs: string[] = [];
            if (ordCount > 0 && !ordersHidden) {
              const rows = [
                rigaSt(tr("cli.stSpent"), euro(c.total_cents ?? 0), true),
                rigaSt(tr("cli.avgBasket"), euro(Math.round((c.total_cents ?? 0) / ordCount))),
              ];
              const fav = topPiatti.length
                ? `<div class="st-fav"><span class="st-fav-lab">${esc(tr("ord.favItems"))}</span><div class="st-fav-chips">` +
                  topPiatti
                    .map((it) => `<span class="st-fav-chip"><span class="st-fav-n">${esc(it.name)}</span><span class="st-fav-q">\u00d7${it.qty}</span></span>`)
                    .join("") +
                  `</div></div>`
                : "";
              secs.push(sezione(ICO_ORD, tr("cli.stOrders"), String(ordCount), rows, fav));
            }
            const resaTot = ex ? ex.total : resaBase;
            const nsTot = ex ? ex.noshows : noshowBase;
            if (resaTot > 0 || nsTot > 0) {
              const rows: string[] = [];
              if (ex) rows.push(rigaSt(tr("res.cancellations"), String(ex.cancelled)));
              rows.push(rigaSt(tr("res.stNoshow"), nsTot > 0 ? `<span style="color:#ff8a8f">${nsTot}</span>` : "0"));
              if (ex && ex.avg_people != null) rows.push(rigaSt(tr("res.peopleAvg"), String(Math.round(ex.avg_people * 10) / 10).replace(".", ",")));
              if (ex && ex.avg_table_min != null) rows.push(rigaSt(tr("res.tableTimeAvg"), `~${fmtMinAct(ex.avg_table_min)}`));
              if (ex && ex.avg_lead_min != null) {
                const m = ex.avg_lead_min;
                const lbl = m < 90 ? `${Math.max(1, Math.round(m))} min` : m < 2880 ? `${Math.round(m / 60)} h` : `${Math.round(m / 1440)} j`;
                rows.push(rigaSt(tr("res.bookInAdvance"), `~${lbl}`));
              }
              if (ex && ex.avg_spent_cents != null) {
                const eur = (ex.avg_spent_cents / 100).toFixed(ex.avg_spent_cents % 100 ? 2 : 0).replace(".", ",");
                rows.push(rigaSt(tr("res.spendAvg"), `~${eur} €`, true));
              }
              secs.push(sezione(ICO_RESA, tr("nav.reservations"), String(resaTot), rows));
            }
            statsBox.innerHTML = secs.join("");
          };
          renderStats(null);
          renderActFlags(c);
          if (c.email || c.phone) {
            const qs = new URLSearchParams({ client_stats: "1" });
            if (c.email) qs.set("client_email", c.email);
            if (c.phone) qs.set("client_phone", c.phone);
            fetch(`/api/admin/reservations?${qs.toString()}`, { headers })
              .then(async (res) => {
                if (!res.ok || actKeyCorrente !== mioKey) return;
                const j = (await res.json()) as { total: number; noshows: number; cancelled: number; avg_people: number | null; avg_lead_min: number | null; avg_table_min: number | null; avg_spent_cents: number | null };
                renderStats(j);
              })
              .catch(() => { /* niente stats ricche: restano quelle base */ });
          }
          // I 5 piatti piu' ordinati: stessa chiamata che alimenta i preferiti
          // nel modale «Nuovo ordine», cosi' i due posti dicono la stessa cosa.
          if ((c.email || c.phone) && ordCount > 0 && !ordersHidden) {
            const qt = new URLSearchParams({ client_top: "1" });
            if (c.email) qt.set("email", c.email);
            if (c.phone) qt.set("phone", c.phone);
            fetch(`/api/admin/orders?${qt.toString()}`, { headers })
              .then(async (res) => {
                if (!res.ok || actKeyCorrente !== mioKey) return;
                const j = (await res.json()) as { top_items?: Array<{ name: string; qty: number }> };
                topPiatti = (j.top_items ?? []).filter((it) => it && it.name);
                if (topPiatti.length) renderStats(exUltimo);
              })
              .catch(() => { /* niente preferiti: la sezione resta com'e' */ });
          }

          actList.innerHTML = "";
          actState.style.display = "";
          actState.textContent = tr("sup.loading");
          actOverlay.hidden = false;
          try {
            const res = await fetch("/api/admin/clients?activity=" + encodeURIComponent(c.key ?? ""), { headers });
            if (!res.ok) throw new Error();
            const j = (await res.json()) as {
              activity?: { type: string; when: string; label: string; status: string; amount_cents: number | null }[];
            };
            // Modulo ordini spento: gli ordini escono proprio dai dati, non
            // solo dalla vista. Cosi' non c'e' modo che il tab nascosto venga
            // scelto da solo e mostri una lista che non dovrebbe esistere.
            actAtti = ((j.activity ?? []) as Att[]).filter((a) => !ordersHidden || a.type !== "order");
            const nResa = actAtti.filter((a) => a.type === "reservation").length;
            const nOrd = actAtti.filter((a) => a.type === "order").length;
            actNResa.textContent = String(nResa);
            actNOrd.textContent = String(nOrd);
            // Default: Prenotazioni (primo tab); Ordini solo se non ci sono
            // prenotazioni — e mai se il modulo ordini e' spento.
            actTab = nResa > 0 || ordersHidden ? "reservation" : "order";
            renderAtti();
          } catch {
            actState.textContent = tr("sup.load.error");
          }
        }

        rowsEl.addEventListener("click", async (e) => {
          const ed = (e.target as HTMLElement).closest(".i-edit") as HTMLButtonElement | null;
          if (ed) {
            const c = tutti.find((x) => x.key === (ed.dataset.editkey ?? ""));
            if (c) apriEdit(c);
            return;
          }
          const del = (e.target as HTMLElement).closest(".i-del") as HTMLButtonElement | null;
          if (!del) {
            // Click sulla riga (ma non su un link): storico del cliente
            if ((e.target as HTMLElement).closest("a")) return;
            const riga = (e.target as HTMLElement).closest(".row") as HTMLElement | null;
            const k = riga?.dataset.key ?? "";
            if (!k) return;
            const c = tutti.find((x) => x.key === k);
            if (c) apriAttivita(c);
            return;
          }
          if (!del.classList.contains("confirm")) {
            del.classList.add("confirm");
            del.textContent = tr("common.confirm");
            setTimeout(() => { del.classList.remove("confirm"); del.innerHTML = ICO_TRASH; }, 3000);
            return;
          }
          const params = new URLSearchParams({
            id: del.dataset.id ?? "",
            email: del.dataset.email ?? "",
            phone: del.dataset.phone ?? "",
            name: del.dataset.name ?? "",
            orders: del.dataset.orders ?? "0",
          });
          await conAttesa(del, async () => {
            try {
              const res = await fetch("/api/admin/clients?" + params.toString(), { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } });
              if (!res.ok) { toast(tr("us.delErr"), true); return; }
              toast(tr("cli.clientDeleted"));
              await carica();
            } catch {
              toast(tr("res.connErr"), true);
            }
          });
        });

        // ---- Modale MODIFICA cliente (matita): dati + foto ----
        const edOverlay = document.getElementById("ed-overlay") as HTMLDivElement;
        const edAvatar = document.getElementById("ed-avatar") as HTMLSpanElement;
        const edUplState = document.getElementById("ed-upl-state") as HTMLParagraphElement;
        const edPhotoRm = document.getElementById("ed-photo-rm") as HTMLButtonElement;
        const edFile = document.getElementById("ed-file") as HTMLInputElement;
        let edCliente: Client | null = null;
        let edPhotoUrl = "";
        let edOptout = false;
        let edBlocked = false;

        function edRenderFlags() {
          const haEmail = !!(document.getElementById("ed-email") as HTMLInputElement).value.trim();
          const newsState = document.getElementById("ed-news-state") as HTMLElement;
          const newsBtn = document.getElementById("ed-news-btn") as HTMLButtonElement;
          if (!haEmail) {
            newsState.textContent = tr("cli.noEmailNoNews");
            newsState.className = "ed-hint";
            newsBtn.style.display = "none";
          } else {
            newsBtn.style.display = "";
            newsState.textContent = edOptout ? tr("cli.optedOut") : tr("cli.optedIn");
            newsState.className = "ed-hint" + (edOptout ? " warn" : " ok");
            newsBtn.setAttribute("aria-checked", edOptout ? "false" : "true");
          }
          const blockState = document.getElementById("ed-block-state") as HTMLElement;
          const blockBtn = document.getElementById("ed-block-btn") as HTMLButtonElement;
          blockState.textContent = edBlocked
            ? tr("cli.blocked")
            : tr("cli.allowed");
          blockState.className = "ed-hint" + (edBlocked ? " warn" : " ok");
          blockBtn.setAttribute("aria-checked", edBlocked ? "false" : "true");
        }

        function edRenderAvatar() {
          const nome = `${(document.getElementById("ed-fname") as HTMLInputElement).value} ${(document.getElementById("ed-lname") as HTMLInputElement).value}`;
          if (edPhotoUrl) {
            edAvatar.innerHTML = `<img src="${esc(edPhotoUrl)}" alt="" />`;
          } else {
            const parti = nome.trim().split(/\s+/).filter(Boolean);
            edAvatar.textContent = ((parti[0]?.[0] ?? "") + (parti[1]?.[0] ?? "")).toUpperCase() || "?";
          }
          edPhotoRm.style.display = edPhotoUrl ? "" : "none";
        }
        function apriNuovo() {
          edCliente = null;
          edPhotoUrl = "";
          edOptout = false;
          edBlocked = false;
          (document.getElementById("ed-title") as HTMLElement).textContent = tr("cli.addClient");
          (document.getElementById("ed-block-row") as HTMLElement).style.display = "none";
          for (const idc of ["ed-fname", "ed-lname", "ed-email", "ed-phone"])
            (document.getElementById(idc) as HTMLInputElement).value = "";
          edPrefixEl().value = PREFISSO_DEFAULT;
          edLangEl().value = "";
          edLangExpanded = false;
          costruisciEdLingue();
          (document.getElementById("ed-err") as HTMLElement).textContent = "";
          (document.getElementById("ed-save") as HTMLButtonElement).textContent = tr("common.add");
          edUplState.textContent = "";
          edRenderAvatar();
          edRenderFlags();
          edOverlay.hidden = false;
        }
        function apriEdit(c: Client) {
          edCliente = c;
          edPhotoUrl = c.photo_url ?? "";
          (document.getElementById("ed-title") as HTMLElement).textContent = tr("cli.editClient");
          (document.getElementById("ed-block-row") as HTMLElement).style.display = "";
          (document.getElementById("ed-save") as HTMLButtonElement).textContent = tr("common.save");
          edOptout = Boolean(c.newsletter_optout);
          edBlocked = Boolean(c.blocked);
          const parti = (c.name ?? "").trim().split(/\s+/).filter(Boolean);
          (document.getElementById("ed-fname") as HTMLInputElement).value = parti[0] ?? "";
          (document.getElementById("ed-lname") as HTMLInputElement).value = parti.slice(1).join(" ");
          (document.getElementById("ed-email") as HTMLInputElement).value = c.email ?? "";
          edLangEl().value = (c.lang || "").toLowerCase();
          edLangExpanded = false;
          costruisciEdLingue();
          {
            const sep = separaPrefisso(c.phone ?? "");
            edPrefixEl().value = sep?.dial ?? PREFISSO_DEFAULT;
            (document.getElementById("ed-phone") as HTMLInputElement).value = sep ? sep.resto : (c.phone ?? "");
          }
          (document.getElementById("ed-err") as HTMLElement).textContent = "";
          edUplState.textContent = "";
          edRenderAvatar();
          edRenderFlags();
          edOverlay.hidden = false;
        }
        (document.getElementById("ed-news-btn") as HTMLButtonElement).addEventListener("click", () => {
          edOptout = !edOptout;
          edRenderFlags();
        });
        (document.getElementById("ed-block-btn") as HTMLButtonElement).addEventListener("click", () => {
          edBlocked = !edBlocked;
          edRenderFlags();
        });
        (document.getElementById("ed-email") as HTMLInputElement).addEventListener("input", edRenderFlags);
        // Chiusura: le ancore del guscio condiviso (sfondo, ×, Annulla).
        edOverlay.querySelectorAll("[data-md-close]").forEach((el) => {
          el.addEventListener("click", () => { edOverlay.hidden = true; });
        });
        for (const idc of ["ed-fname", "ed-lname"])
          (document.getElementById(idc) as HTMLInputElement).addEventListener("input", () => {
            if (!edPhotoUrl) edRenderAvatar();
          });
        (document.getElementById("ed-upload") as HTMLButtonElement).addEventListener("click", () => edFile.click());
        // «Libreria»: la stessa ImagePicker degli altri modali, cosi' una foto
        // gia' caricata non va ricaricata una seconda volta.
        (document.getElementById("ed-photo-lib") as HTMLButtonElement).addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent("imgpick:open"));
        });
        window.addEventListener("imgpick:pick", (e) => {
          // Solo se il modale e' aperto: la Libreria sta fuori da lui.
          if (edOverlay.hidden) return;
          const url = (e as CustomEvent<{ url?: string }>).detail?.url ?? "";
          if (!url) return;
          edPhotoUrl = url;
          edRenderAvatar();
          edUplState.textContent = "";
        });
        edPhotoRm.addEventListener("click", () => {
          edPhotoUrl = "";
          edRenderAvatar();
        });
        edFile.addEventListener("change", async () => {
          const file = edFile.files?.[0];
          if (!file) return;
          if (file.size > 4 * 1024 * 1024) {
            edUplState.textContent = tr("cli.fileTooBig");
            return;
          }
          edUplState.textContent = tr("cli.uploading");
          try {
            const base64 = await new Promise<string>((res, rej) => {
              const r = new FileReader();
              r.onload = () => res(String(r.result).split(",")[1] ?? "");
              r.onerror = () => rej(new Error());
              r.readAsDataURL(file);
            });
            const resp = await fetch("/api/admin/upload", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ filename: file.name, data: base64 }),
            });
            const j = (await resp.json()) as { url?: string; error?: string };
            if (!resp.ok || !j.url) {
              edUplState.textContent = j.error ?? tr("cli.uploadError");
              return;
            }
            edPhotoUrl = j.url;
            edRenderAvatar();
            edUplState.textContent = tr("cli.photoUploaded");
          } catch {
            edUplState.textContent = tr("res.connErr");
          } finally {
            edFile.value = "";
          }
        });
        (document.getElementById("ed-save") as HTMLButtonElement).addEventListener("click", async () => {
          const errEl = document.getElementById("ed-err") as HTMLElement;
          errEl.textContent = "";
          const prenomV = (document.getElementById("ed-fname") as HTMLInputElement).value.trim();
          const cognomeV = (document.getElementById("ed-lname") as HTMLInputElement).value.trim();
          const nome = `${prenomV} ${cognomeV}`.trim();
          const emailV = (document.getElementById("ed-email") as HTMLInputElement).value.trim();
          const telGrezzo = (document.getElementById("ed-phone") as HTMLInputElement).value.trim();
          const telV = telGrezzo
            ? telGrezzo.startsWith("+") || telGrezzo.startsWith("00")
              ? telGrezzo
              : `${edPrefixEl().value} ${telGrezzo.replace(/^0/, "")}`
            : "";
          if (!cognomeV && !prenomV) {
            errEl.textContent = tr("res.nameRequired");
            return;
          }
          // Anche in modifica: il server lo pretende su OGNI scrittura, e
          // fermarlo qui significa un messaggio tradotto invece del 400 in
          // francese che arrivava dall'API.
          if (!emailV && !telV) {
            errEl.textContent = tr("cli.emailOrPhone");
            return;
          }
          const btn = document.getElementById("ed-save") as HTMLButtonElement;
          btn.disabled = true;
          btn.classList.add("is-loading"); // su rete lenta un bottone solo spento non dice niente
          try {
            const corpo: Record<string, unknown> = {
              id: edCliente?.id ?? null,
              match_email: edCliente ? edCliente.email : emailV,
              match_phone: edCliente ? edCliente.phone : telV,
              name: nome,
              email: emailV,
              phone: telV,
              photo_url: edPhotoUrl || null,
              newsletter_optout: edOptout,
              lang: edLangEl().value || null,
            };
            if (edCliente) corpo.blocked = edBlocked; // in creazione il blocco non si tocca
            const res = await fetch("/api/admin/clients", {
              method: "PATCH",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify(corpo),
            });
            const j = (await res.json()) as { error?: string };
            if (!res.ok) {
              errEl.textContent = j.error ?? tr("common.saveErr");
              return;
            }
            edOverlay.hidden = true;
            toast(edCliente ? tr("cli.clientModified") : tr("cli.clientAdded"));
            await carica();
          } catch {
            errEl.textContent = tr("res.connErr");
          } finally {
            btn.disabled = false;
            btn.classList.remove("is-loading");
          }
        });

        // Invio salva, da qualunque campo del modale: c'era nel modale morto
        // e si era perso in quello unificato.
        for (const idc of ["ed-fname", "ed-lname", "ed-email", "ed-phone"]) {
          document.getElementById(idc)?.addEventListener("keydown", (e) => {
            if ((e as KeyboardEvent).key !== "Enter") return;
            e.preventDefault();
            (document.getElementById("ed-save") as HTMLButtonElement).click();
          });
        }

        async function carica(datiIniziali?: Resp) {
          contentEl.classList.add("loading");
          try {
            let data: Resp;
            if (datiIniziali) {
              data = datiIniziali; // dati già pronti dal server (SSR)
            } else {
              const res = await fetch("/api/admin/clients", { headers });
              if (!res.ok) {
                stateEl.textContent = tr("sup.load.error");
                stateEl.style.display = "block";
                return;
              }
              data = (await res.json()) as Resp;
            }
            tutti = data.clients;
            costruisciLingue();
            stateEl.style.display = "none";
            contentEl.style.display = "block";
            updateHeader();
            render();
          } catch {
            stateEl.textContent = tr("common.netErr");
            stateEl.style.display = "block";
          } finally {
            contentEl.classList.remove("loading");
          }
        }

        // Aggiungi e modifica sono lo STESSO modale (#ed-overlay): il pulsante
        // flottante apre quello, in modalita' creazione.
        addBtn.addEventListener("click", apriNuovo);

        // Primo caricamento: usa i dati SSR (Fase 2) se presenti, senza fetch.
        let ssrClientsDati: Resp | null = null;
        try {
          const raw = document.getElementById("ssr-clients")?.textContent?.trim();
          if (raw) ssrClientsDati = JSON.parse(raw);
        } catch {
          ssrClientsDati = null;
        }
        await carica(ssrClientsDati ?? undefined);
      })();
    </script>
  </body>
</html>
