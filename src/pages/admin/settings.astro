        // Jours spéciaux correnti (riempita da caricaSpecial): serve al
        // datepicker del widget per bloccare i giorni di chiusura.
        let spCache: {
          date_from: string;
          date_to: string;
          type: string;
          lunch_open?: string | null;
          lunch_close?: string | null;
          dinner_open?: string | null;
          dinner_close?: string | null;
          services?: unknown;
        }[] = [];

        /** Jour spécial "ouvert" del giorno: fasce orarie proprie in minuti
         *  (null = niente special open, o special open senza orari). */
        function rwFasceSpeciali(iso: string): [number, number][] | null {
          const sp = spCache.find((x) => x.type === "open" && x.date_from <= iso && iso <= x.date_to);
          if (!sp) return null;
          const ranges: [number, number][] = [];
          for (const [o, c] of [[sp.lunch_open, sp.lunch_close], [sp.dinner_open, sp.dinner_close]]) {
            const da = rwMinuti(String(o ?? "").slice(0, 5));
            const a = rwMinuti(String(c ?? "").slice(0, 5));
            if (da >= 0 && a > da) ranges.push([da, a]);
          }
          return ranges.length ? ranges : null;
        }
        /** Il giorno è un jour spécial "ouvert"? (scavalca i giorni dei services) */
        function rwSpecialOpen(iso: string): boolean {
          if (spCache.some((x) => x.type === "closed" && x.date_from <= iso && iso <= x.date_to)) return false;
          return spCache.some((x) => x.type === "open" && x.date_from <= iso && iso <= x.date_to);
        }
        /** Lista servizi del jour spécial "ouvert" (null = tutti, [] = nessuno). */
        function rwSpServizi(iso: string): string[] | null {
          const sp = spCache.find((x) => x.type === "open" && x.date_from <= iso && iso <= x.date_to);
          return sp && Array.isArray(sp.services) ? (sp.services as unknown[]).map((t) => String(t)) : null;
        }
        function rwSvAttivoSp(sv: { key: string; da: number; a: number }, lista: string[] | null): boolean {
          if (lista === null) return true;
          const hh = (m: number) => `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
          return lista.includes(`${sv.key}|${hh(sv.da)}-${hh(sv.a)}`) || lista.includes(sv.key);
        }

        /** Il ristorante è aperto quel giorno? Stessa logica del motore:
         *  chiusura speciale > apertura speciale > orario settimanale. */
        function rwGiornoAperto(iso: string): boolean {
          let spClosed = false;
          let spOpen = false;
          for (const sp of spCache) {
            if (sp.date_from <= iso && iso <= sp.date_to) {
              if (sp.type === "closed") spClosed = true;
              else spOpen = true;
            }
          }
          if (spClosed) return false;
          if (spOpen) return true;
          const dow = new Date(iso + "T12:00:00").getDay(); // 0 = dimanche (come settings)
          const row = document.querySelector<HTMLElement>(`.day-row[data-day="${dow}"]`);
          if (!row) return true; // orari non ancora caricati: nessun blocco
          return (row.querySelector(".d-active") as HTMLInputElement).checked;
        }

        function rwIsoPiuGiorni(g: number): string {
          const d = new Date();
          d.setDate(d.getDate() + g);
          return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
        }
        function apriAcc(chiave: string | null) {
          document.querySelectorAll<HTMLElement>(".rw-acc").forEach((a) => {
            a.classList.toggle("is-open", a.dataset.acc === chiave);
          });
        }
        function prossimaAcc(dopo: string) {
          const ordine = ["date", "personnes", "zone", "heure"];
          const visibili = ordine.filter((k) => {
            const el = document.querySelector<HTMLElement>(`.rw-acc[data-acc="${k}"]`);
            return el && el.style.display !== "none";
          });
          const i = visibili.indexOf(dopo);
          apriAcc(i >= 0 && i + 1 < visibili.length ? visibili[i + 1] : null);
        }

        function rwImpostaData(iso: string) {
          rwDate.value = fmtFr(iso);
          rwDate.dataset.iso = iso;
          (document.getElementById("rw-val-date") as HTMLElement).textContent = fmtFr(iso);
          const auj = document.getElementById("rw-auj") as HTMLButtonElement;
          const dem = document.getElementById("rw-dem") as HTMLButtonElement;
          auj.classList.toggle("is-on", iso === rwIsoPiuGiorni(0));
          dem.classList.toggle("is-on", iso === rwIsoPiuGiorni(1));
          auj.disabled = !rwGiornoAperto(rwIsoPiuGiorni(0)) || !rwHaOrari(rwIsoPiuGiorni(0));
          dem.disabled = !rwGiornoAperto(rwIsoPiuGiorni(1)) || !rwHaOrari(rwIsoPiuGiorni(1));
          auj.title = auj.disabled ? "Fermé" : "";
          dem.title = dem.disabled ? "Fermé" : "";
        }
        function rwMaxPersone(): number {
          const el = document.getElementById("r-maxp") as HTMLInputElement;
          const n = Math.floor(Number(el.value));
          return Number.isFinite(n) && n >= 1 ? Math.min(100, n) : 8;
        }

        function renderAnteprima() {
          (document.getElementById("rw-zone-field") as HTMLElement).style.display = rZoneChoice.checked ? "" : "none";
          const isoGiorno = rwDate.dataset.iso ?? rwIsoPiuGiorni(0);
          const datiGiorno = rwReseDel(isoGiorno);
          const znChiuse = datiGiorno?.zoneChiuse ?? [];
          // Sezioni: dalle righe correnti dell'editor (live), meno quelle chiuse quel giorno
          const nomi = Array.from(rZonesBox.querySelectorAll<HTMLInputElement>(".rz-name"))
            .map((i) => i.value.trim())
            .filter(Boolean)
            .filter((n) => !znChiuse.some((c) => c.zone === n));
          const zone = nomi.length ? nomi : [T().salle];
          const attiva = rwZones.querySelector(".is-on")?.textContent ?? "";
          rwZones.innerHTML = zone
            .map((z, i) => {
              const on = z === attiva || (i === 0 && !zone.includes(attiva));
              return `<span class="rw-zone${on ? " is-on" : ""}">${z.replace(/&/g, "&amp;").replace(/</g, "&lt;")}</span>`;
            })
            .join("");
          // Créneaux: ogni service usa il SUO passo (créneau per service)
          // Solo gli orari realmente prenotabili: dopo adesso + préavis (fuso del ristorante)
          const soglia = rwSoglia(isoGiorno);
          const spOpenGiorno = rwSpecialOpen(isoGiorno);
          const spFasceGiorno = spOpenGiorno ? rwFasceSpeciali(isoGiorno) : null;
          const spServGiorno = spOpenGiorno ? rwSpServizi(isoGiorno) : null;
          const svChiusi = datiGiorno?.chiusure ?? [];
          const servizi = rwServizi()
            // Service chiuso dal ristoratore (Complet / Fermeture exceptionnelle)
            .filter((sv) => !svChiusi.some((c) => c.service_key === sv.key))
            // Service non attivo in quel giorno della settimana
            .filter((sv) => (spOpenGiorno ? rwSvAttivoSp(sv, spServGiorno) : rwServeGiorno(sv, isoGiorno)))
            .map((sv) => {
              const finestre: [number, number][] = spFasceGiorno
                ? spFasceGiorno
                    .map(([r1, r2]) => [Math.max(sv.da, r1), Math.min(sv.a, r2)] as [number, number])
                    .filter(([f1, f2]) => f2 > f1)
                : [[sv.da, sv.a]];
              const slots: number[] = [];
              for (const [fda, fa] of finestre) {
                for (let m = fda; m <= fa; m += sv.slot) if (m >= soglia && !slots.includes(m)) slots.push(m);
              }
              slots.sort((x, y) => x - y);
              return { ...sv, slots };
            })
            .filter((sv) => sv.slots.length > 0);
          if (rwServIdx >= servizi.length) rwServIdx = 0;
          const stabs = document.getElementById("rw-stabs") as HTMLDivElement;
          stabs.style.display = servizi.length > 1 ? "" : "none";
          stabs.innerHTML = servizi
            .map(
              (sv, i) =>
                `<button type="button" class="rw-stab${i === rwServIdx ? " is-on" : ""}" data-i="${i}">${sv.label.replace(/&/g, "&amp;").replace(/</g, "&lt;")}</button>`
            )
            .join("");
          const att = servizi[rwServIdx];
          const tutti: number[] = att ? att.slots : [];
          const LIMITE = 12; // 3 righe da 4 colonne
          const visibili = rwEspanso ? tutti : tutti.slice(0, LIMITE);
          // Orari pieni: prenotazioni reali che si sovrappongono allo slot
          // Occupazione: durée d'occupation PROPRIA di ogni service
          const reseGiorno = datiGiorno?.rese ?? [];
          const capienza = rwCapienza() - znChiuse.reduce((t, c) => t + rwPostiZona(c.zone), 0);
          const holdByKey = new Map(servizi.map((sv) => [sv.key, sv.hold]));
          const holdNuovo = att?.hold ?? 90;
          // Section scelta nel widget (solo se il cliente può scegliere)
          const zonaSel = rZoneChoice.checked ? (rwZones.querySelector(".is-on")?.textContent ?? "").trim() : "";
          const postiZona = zonaSel ? rwPostiZona(zonaSel) : 0;
          const slotPieno = (sMin: number): boolean => {
            if (!capienza) return false;
            let occTot = 0;
            let occZona = 0;
            for (const rr of reseGiorno) {
              const rMin = rwMinuti(rr.heure.slice(0, 5));
              if (rMin < 0) continue;
              const rHold = holdByKey.get(rr.service_key ?? "") ?? holdNuovo;
              if (rMin < sMin + holdNuovo && rMin + rHold > sMin) {
                occTot += rr.people;
                if (zonaSel && (rr.zone ?? "") === zonaSel) occZona += rr.people;
              }
            }
            if (occTot + rwN > capienza) return true;
            return postiZona > 0 && occZona + rwN > postiZona;
          };
          const tuttiPieni = !!att && tutti.length > 0 && tutti.every((m) => slotPieno(m));
          let html = visibili
            .map((m) => `<span class="rw-slot${slotPieno(m) ? " rw-slot-full" : ""}">${slotHHMM(m)}</span>`)
            .join("");
          if (tutti.length > LIMITE) {
            html += `<button type="button" class="rw-more">${rwEspanso ? T().voirMoins : T().voirPlus}<svg class="rw-more-ico${rwEspanso ? " is-up" : ""}" viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg></button>`;
          }
          if (!att) html = `<p class="rw-noslot">${T().aucuneHeure}</p>`;
          else if (tuttiPieni) html = `<p class="rw-noslot rw-complet">${T().complet}</p>`;
          rwSlots.innerHTML = html;
          rwSlots.querySelector(".rw-slot:not(.rw-slot-full)")?.classList.add("is-on");
          (document.getElementById("rw-val-zone") as HTMLElement).textContent =
            rwZones.querySelector(".is-on")?.textContent ?? "";
          const oraSel = rwSlots.querySelector(".is-on")?.textContent ?? "";
          (document.getElementById("rw-val-heure") as HTMLElement).textContent =
            att && oraSel && servizi.length > 1 ? `${att.label} · ${oraSel}` : oraSel;
        }

        (document.getElementById("r-notice") as HTMLInputElement).addEventListener("input", renderAnteprima);
        (document.getElementById("g-tz") as HTMLSelectElement).addEventListener("change", renderAnteprima);
        rZoneChoice.addEventListener("change", () => {
          dirty();
          renderAnteprima();
        });
        rZonesBox.addEventListener("input", renderAnteprima);
        rZonesBox.addEventListener("click", () => setTimeout(renderAnteprima, 0)); // dopo la rimozione di una riga
        rwZones.addEventListener("click", (e) => {
          const z = (e.target as HTMLElement).closest(".rw-zone");
          if (!z) return;
          rwZones.querySelectorAll(".rw-zone").forEach((el) => el.classList.toggle("is-on", el === z));
          (document.getElementById("rw-val-zone") as HTMLElement).textContent = z.textContent ?? "";
          renderAnteprima(); // il pieno dipende anche dalla section scelta
          prossimaAcc("zone");
        });
        (document.getElementById("rw-stabs") as HTMLDivElement).addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".rw-stab") as HTMLElement | null;
          if (!t) return;
          rwServIdx = Number(t.dataset.i);
          rwEspanso = false;
          renderAnteprima();
        });
        // ---- Step 2 : récapitulatif + formulaire ----
        const RW_RC_ICO = {
          date: '<svg class="rw-rc-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>',
          heure: '<svg class="rw-rc-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>',
          pers: '<svg class="rw-rc-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>',
        };
        function aggiornaRecap() {
          const t = T();
          (document.getElementById("rw-rc-l1") as HTMLElement).innerHTML = RW_RC_ICO.date + `<span>${t.date}</span>`;
          (document.getElementById("rw-rc-v1") as HTMLElement).textContent = rwDate.value;
          (document.getElementById("rw-rc-l2") as HTMLElement).innerHTML = RW_RC_ICO.heure + `<span>${t.heure}</span>`;
          (document.getElementById("rw-rc-v2") as HTMLElement).textContent =
            (document.getElementById("rw-val-heure") as HTMLElement).textContent ?? "";
          (document.getElementById("rw-rc-l3") as HTMLElement).innerHTML = RW_RC_ICO.pers + `<span>${t.personnes}</span>`;
          (document.getElementById("rw-rc-v3") as HTMLElement).textContent =
            (document.getElementById("rw-val-pers") as HTMLElement).textContent ?? "";
          const zoneField = document.getElementById("rw-zone-field") as HTMLElement;
          (document.getElementById("rw-rc-zone") as HTMLElement).textContent =
            zoneField.style.display === "none" ? "" : rwZones.querySelector(".is-on")?.textContent ?? "";
        }
        function aggiornaDone() {
          const t = T();
          (document.getElementById("rw-done-title") as HTMLElement).textContent = t.merci;
          (document.getElementById("rw-done-msg") as HTMLElement).textContent = t.confMsg;
          (document.getElementById("rw-done-new") as HTMLButtonElement).textContent = t.nouvelleResa;
          const heure = (document.getElementById("rw-val-heure") as HTMLElement).textContent ?? "";
          const pers = (document.getElementById("rw-val-pers") as HTMLElement).textContent ?? "";
          (document.getElementById("rw-done-recap") as HTMLElement).textContent = `${rwDate.value} · ${heure} · ${pers}`;
        }
        function vaiStep(n: 1 | 2 | 3) {
          (document.getElementById("rw-step1") as HTMLElement).style.display = n === 1 ? "" : "none";
          (document.getElementById("rw-step2") as HTMLElement).style.display = n === 2 ? "" : "none";
          (document.getElementById("rw-step3") as HTMLElement).style.display = n === 3 ? "" : "none";
          if (n === 2) aggiornaRecap();
          if (n === 3) aggiornaDone();
        }
        // Prefisso telefonico: default dal paese del ristorante (config)
        const rwPrefix = document.getElementById("rw-f-prefix") as HTMLSelectElement;
        rwPrefix.innerHTML = PREFISSI.map((pf) => `<option value="${pf.dial}">${pf.flag} ${pf.dial}</option>`).join("");
        rwPrefix.value = PREFISSI.find((pf) => pf.code === CLIENTE_CFG.paese)?.dial ?? PREFISSI[0].dial;
        // "+33 6…" o "0033…" nel campo numero → prefisso in tendina, numero pulito
        const rwTel = document.getElementById("rw-f-tel") as HTMLInputElement;
        rwTel.addEventListener("input", () => {
          const sep = separaPrefisso(rwTel.value);
          if (!sep) return;
          rwPrefix.value = sep.dial;
          rwTel.value = sep.resto;
        });

        // Condizioni del ristorante: senza spunta niente Confirmer
        const rwTerms = document.getElementById("rw-f-terms") as HTMLInputElement;
        function aggiornaConferma() {
          (document.getElementById("rw-confirm") as HTMLButtonElement).disabled = !rwTerms.checked;
        }
        rwTerms.addEventListener("change", aggiornaConferma);
        aggiornaConferma();

        // SOLO SIMULAZIONE (aperçu): nessuna email, nessun cliente creato.
        // Nella V1 il Confirmer chiamerà l'API di prenotazione.
        (document.getElementById("rw-confirm") as HTMLButtonElement).addEventListener("click", () => vaiStep(3));
        (document.getElementById("rw-done-new") as HTMLButtonElement).addEventListener("click", () => vaiStep(1));
        (document.getElementById("rw-cta") as HTMLButtonElement).addEventListener("click", () => {
          if (rwTroppi) return; // Téléphoner : nella V1 aprirà tel:
          vaiStep(2);
        });
        (document.getElementById("rw-back") as HTMLButtonElement).addEventListener("click", () => vaiStep(1));
        document.querySelectorAll<HTMLButtonElement>(".rw-opt").forEach((b) => {
          b.addEventListener("click", () => {
            b.classList.toggle("is-on");
            if (b.id === "rw-opt-biz") {
              (document.getElementById("rw-f-societe") as HTMLInputElement).style.display =
                b.classList.contains("is-on") ? "" : "none";
            }
          });
        });

        rwSlots.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest(".rw-more")) {
            rwEspanso = !rwEspanso;
            renderAnteprima();
            return;
          }
          const sl = (e.target as HTMLElement).closest(".rw-slot");
          if (!sl) return;
          rwSlots.querySelectorAll(".rw-slot").forEach((el) => el.classList.toggle("is-on", el === sl));
          const stabsEl = document.getElementById("rw-stabs") as HTMLElement;
          const labAttivo = stabsEl.style.display === "none" ? "" : stabsEl.querySelector(".is-on")?.textContent ?? "";
          (document.getElementById("rw-val-heure") as HTMLElement).textContent =
            labAttivo ? `${labAttivo} · ${sl.textContent}` : sl.textContent ?? "";
          apriAcc(null);
        });
        let rwN = 2;
        let rwLingua: LinguaWidget = "fr"; // lingua del widget (separata dal sito)
        const T = () => TESTI_WIDGET[rwLingua];
        let rwServIdx = 0; // service attivo nel tab Heure
        let rwEspanso = false; // orari: mostra oltre le prime 3 righe
        let rwTroppi = false; // il cliente ha scelto "N+" (oltre il massimo)

        // Prenotazioni reali del giorno mostrato nell'anteprima → orari pieni
        type RwGiorno = {
          rese: { heure: string; people: number; zone: string | null; service_key: string | null }[];
          chiusure: { service_key: string; reason: string }[];
          zoneChiuse: { zone: string; reason: string }[];
        };
        const rwReseCache = new Map<string, RwGiorno>();
        let rwReseFetching = "";
        let rwAuthPronta = false; // headers create più sotto: prima niente fetch
        function rwReseDel(iso: string): RwGiorno | null {
          if (!rwAuthPronta) return null;
          if (rwReseCache.has(iso)) return rwReseCache.get(iso) ?? null;
          if (rwReseFetching !== iso) {
            rwReseFetching = iso;
            fetch("/api/admin/reservations?date=" + iso, { headers })
              .then((r) => (r.ok ? r.json() : null))
              .then((j) => {
                if (!j) return;
                rwReseCache.set(iso, {
                  rese: ((j.reservations ?? []) as { heure: string; people: number; zone: string | null; service_key: string | null; status: string }[]).filter(
                    (x) => x.status === "confirmed" || x.status === "seated"
                  ),
                  chiusure: (j.closures ?? []) as { service_key: string; reason: string }[],
                  zoneChiuse: (j.zone_closures ?? []) as { zone: string; reason: string }[],
                });
                renderAnteprima();
              })
              .catch(() => { /* anteprima senza sbarrati */ });
          }
          return null;
        }
        /** Coperti di una section (dal form). 0 = sconosciuta/illimitata. */
        function rwPostiZona(nome: string): number {
          for (const r of Array.from(rZonesBox.querySelectorAll<HTMLElement>(".rz-row"))) {
            if ((r.querySelector(".rz-name") as HTMLInputElement).value.trim() === nome) {
              const n = Math.floor(Number((r.querySelector(".rz-seats") as HTMLInputElement).value));
              return Number.isFinite(n) && n > 0 ? n : 0;
            }
          }
          return 0;
        }
        /** Capienza totale = somma dei coperti delle sections (form). */
        function rwCapienza(): number {
          return Array.from(rZonesBox.querySelectorAll<HTMLInputElement>(".rz-seats")).reduce((t, el) => {
            const n = Math.floor(Number(el.value));
            return t + (Number.isFinite(n) && n > 0 ? n : 0);
          }, 0);
        }
        function rwTz(): string {
          return (document.getElementById("g-tz") as HTMLSelectElement).value || "Europe/Brussels";
        }
        function rwMinutiAdesso(): number {
          const [h, m] = new Intl.DateTimeFormat("en-GB", { timeZone: rwTz(), hour: "2-digit", minute: "2-digit", hour12: false })
            .format(new Date())
            .split(":");
          return Number(h) * 60 + Number(m);
        }
        /** Primo minuto prenotabile del giorno scelto: adesso + preavviso, meno i giorni di distanza. */
        function rwSoglia(iso: string): number {
          const notice = Math.min(4320, Math.max(0, Math.floor(Number((document.getElementById("r-notice") as HTMLInputElement).value)) || 0));
          const oggiTz = new Intl.DateTimeFormat("en-CA", { timeZone: rwTz() }).format(new Date());
          const diff = Math.round((Date.parse(iso) - Date.parse(oggiTz)) / 86400000);
          return rwMinutiAdesso() + notice - diff * 1440;
        }
        /** Il giorno ha almeno un créneau prenotabile? (per Aujourd'hui/Demain) */
        function rwHaOrari(iso: string): boolean {
          const soglia = rwSoglia(iso);
          const spOpen = rwSpecialOpen(iso);
          const fasce = spOpen ? rwFasceSpeciali(iso) : null;
          const spServ = spOpen ? rwSpServizi(iso) : null;
          return rwServizi()
            .filter((sv) => (spOpen ? rwSvAttivoSp(sv, spServ) : rwServeGiorno(sv, iso)))
            .some((sv) => {
              const finestre: [number, number][] = fasce
                ? fasce.map(([r1, r2]) => [Math.max(sv.da, r1), Math.min(sv.a, r2)] as [number, number]).filter(([f1, f2]) => f2 > f1)
                : [[sv.da, sv.a]];
              for (const [fda, fa] of finestre) for (let m = fda; m <= fa; m += sv.slot) if (m >= soglia) return true;
              return false;
            });
        }
        function rwMinuti(hhmm: string): number {
          const m = /^(\d{1,2}):(\d{2})$/.exec(hhmm);
          return m ? Number(m[1]) * 60 + Number(m[2]) : -1;
        }
        function rwServizi(): { key: string; label: string; da: number; a: number; hold: number; slot: number; days: number[] }[] {
          const righe = Array.from(rServicesBox.querySelectorAll<HTMLElement>(".rs-row"))
            .map((r) => {
              const key = (r.querySelector(".rs-key") as HTMLSelectElement).value;
              return {
                key,
                label: SERVIZI_WIDGET[key]?.[rwLingua] ?? key,
                da: rwMinuti((r.querySelector(".rs-from") as HTMLInputElement).value),
                a: rwMinuti((r.querySelector(".rs-to") as HTMLInputElement).value),
                hold: Math.min(360, Math.max(15, Math.floor(Number((r.querySelector(".rs-hold") as HTMLInputElement).value)) || 90)),
                slot: Math.min(120, Math.max(10, Math.floor(Number((r.querySelector(".rs-slot") as HTMLInputElement).value)) || 30)),
                days: Array.from(r.querySelectorAll<HTMLElement>(".rs-day.is-on")).map((b) => Number(b.dataset.d)),
              };
            })
            .filter((sv) => sv.da >= 0 && sv.a > sv.da);
          return righe.length
            ? righe
            : [
                { key: "midi", label: SERVIZI_WIDGET.midi[rwLingua], da: 12 * 60, a: 14 * 60, hold: 90, slot: 30, days: [] },
                { key: "soir", label: SERVIZI_WIDGET.soir[rwLingua], da: 18 * 60, a: 21 * 60 + 30, hold: 90, slot: 30, days: [] },
              ];
        }
        /** Il service è attivo in quel giorno? (days vuoto = tutti i giorni) */
        function rwServeGiorno(sv: { days: number[] }, iso: string): boolean {
          if (!sv.days || sv.days.length === 0) return true;
          return sv.days.includes(new Date(iso + "T12:00:00").getDay());
        }
        const rwPGrid = document.getElementById("rw-pgrid") as HTMLDivElement;
        const rwAlert = document.getElementById("rw-alert") as HTMLParagraphElement;
        const rwCta = document.getElementById("rw-cta") as HTMLButtonElement;

        function renderPersone() {
          const max = rwMaxPersone();
          if (!rwTroppi && rwN > max) rwN = max;
          let html = "";
          for (let n = 1; n <= max; n++) {
