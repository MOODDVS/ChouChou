        let tmDelPending: string | null = null;
        let tmDelTimer: number | undefined;
        tmListEl.addEventListener("click", async (e) => {
          const t = e.target as HTMLElement;
          const edit = t.closest("[data-edit]") as HTMLElement | null;
          if (edit) {
            const m = team.find((x) => x.id === edit.dataset.edit);
            if (m) tmApri(m);
            return;
          }
          const del = t.closest("[data-del]") as HTMLElement | null;
          if (del) {
            const id = del.dataset.del!;
            if (tmDelPending === id) {
              window.clearTimeout(tmDelTimer);
              tmDelPending = null;
              try {
                const res = await fetch("/api/admin/team?id=" + id, { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } });
                if (res.ok) await tmCarica();
              } catch {
                /* noop */
              }
              return;
            }
            tmDelPending = id;
            del.classList.add("confirm");
            del.textContent = "Confirmer ?";
            window.clearTimeout(tmDelTimer);
            tmDelTimer = window.setTimeout(() => {
              tmDelPending = null;
              del.classList.remove("confirm");
              del.textContent = "✕";
            }, 3000);
          }
        });

        tmCarica();
      })();
    
  // ----- Tab della pagina (visibilità gestita dal super admin) -----
  (async () => {
