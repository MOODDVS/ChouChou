        if (rp.ok) {
          const { hiddenTabs } = (await rp.json()) as { hiddenTabs?: string[] };
          const nasc = (hiddenTabs ?? [])
            .filter((k) => k.startsWith("settings:"))
            .map((k) => k.slice("settings:".length));
          for (const tk of nasc) {
            document.querySelector(`#tabs button[data-t="${tk}"]`)?.remove();
            document.querySelector(`#content .section[data-tab="${tk}"]`)?.remove();
          }
        }
      }
    } catch {
      /* rete assente: mostra tutto */
    }

    const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("#tabs button"));
    const TAB_KEY = "lm-adm-settings-tab";

    function mostraTab(t: string) {
      tabBtns.forEach((b) => b.classList.toggle("is-active", b.dataset.t === t));
      document.querySelectorAll<HTMLElement>("#content .section[data-tab]").forEach((sec) => {
        sec.style.display = sec.dataset.tab === t ? "" : "none";
      });
      const contenuto = document.getElementById("content");
      if (contenuto) contenuto.dataset.tab = t;
      // Enregistrer serve solo dove ci sono campi da salvare
      const bar = document.querySelector<HTMLElement>(".save-bar");
      if (bar) bar.style.display = t === "general" || t === "horaire" || t === "reservations" || t === "cuisine" || t === "liens" ? "" : "none";
      try {
        sessionStorage.setItem(TAB_KEY, t);
      } catch {
        /* storage non disponibile: pazienza */
      }
    }

    tabBtns.forEach((b) => b.addEventListener("click", () => mostraTab(b.dataset.t ?? "horaire")));

    let tabIniziale = "general";
    try {
      const salvato = sessionStorage.getItem(TAB_KEY);
      if (salvato && tabBtns.some((b) => b.dataset.t === salvato)) tabIniziale = salvato;
    } catch {
      /* niente ripristino */
    }
    // ?tab=horaire (es. tile Jours spéciaux della Accueil) vince su tutto
    const tabUrl = new URLSearchParams(location.search).get("tab");
    if (tabUrl && tabBtns.some((b) => b.dataset.t === tabUrl)) tabIniziale = tabUrl;
    // Se il tab iniziale è stato tolto, parti dal primo visibile
    if (!tabBtns.some((b) => b.dataset.t === tabIniziale)) tabIniziale = tabBtns[0]?.dataset.t ?? "horaire";
    mostraTab(tabIniziale);
  })();

  // Anti-autofill: i campi marcati data-noauto restano readonly (Chrome non
  // riempie mai i readonly); si sbloccano solo quando l'utente ci clicca.
  document.addEventListener("focusin", (e) => {
    const t = e.target;
    if (t instanceof HTMLInputElement && t.dataset.noauto === "1") t.readOnly = false;
  });
  document.addEventListener("focusout", (e) => {
    const t = e.target;
    if (t instanceof HTMLInputElement && t.dataset.noauto === "1") t.readOnly = true;
  });
</script>
  </body>
</html>
