        // Upload foto (riusa /api/admin/upload, bucket popups)
        tmUpload.addEventListener("click", () => tmFile.click());
        tmFile.addEventListener("change", async () => {
          const file = tmFile.files?.[0];
          if (!file) return;
          if (file.size > 4 * 1024 * 1024) {
            tmUploadState.textContent = "Fichier trop lourd (max 4 Mo).";
            return;
          }
          tmUpload.disabled = true;
          tmUploadState.textContent = "Téléversement…";
          try {
            const base64 = await new Promise<string>((res, rej) => {
              const r = new FileReader();
              r.onload = () => res(String(r.result).split(",")[1] ?? "");
              r.onerror = () => rej(new Error());
              r.readAsDataURL(file);
            });
            const resp = await fetch("/api/admin/upload", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ filename: file.name, data: base64 }),
            });
            const j = await resp.json();
            if (!resp.ok) {
              tmUploadState.textContent = j.error ?? "Erreur de téléversement";
              return;
            }
            tmPhotoUrl = j.url;
            tmRenderAvatarPreview();
            tmUploadState.textContent = "Photo téléversée ✓";
          } catch {
            tmUploadState.textContent = "Erreur de connexion";
          } finally {
            tmUpload.disabled = false;
            tmFile.value = "";
