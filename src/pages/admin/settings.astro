            photo_url: tmPhotoUrl,
            notes: tmNotes.value.trim(),
            is_employee: tmEmp.checked,
            active: tmActive.checked,
          };
          if (!payload.name) {
            tmErr.textContent = "Le nom est obligatoire.";
