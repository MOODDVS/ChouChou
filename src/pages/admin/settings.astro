    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { isSuper } from "../../lib/admin/superAdmin";
      import { SERVIZI_WIDGET, TESTI_WIDGET, LINGUE_WIDGET, type LinguaWidget } from "../../lib/reservationI18n";
      import { PREFISSI, separaPrefisso } from "../../lib/prefissi";
      import { CLIENT as CLIENTE_CFG } from "../../config/client";

      type Giorno = {
        day_of_week: number;
        lunch_active: boolean;
        lunch_open: string | null;
        lunch_close: string | null;
        dinner_active: boolean;
        dinner_open: string | null;
        dinner_close: string | null;
      };

      const NOMI = ["Dimanche", "Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi"];
      // Ordine di visualizzazione: lunedì -> domenica
      const ORDINE = [1, 2, 3, 4, 5, 6, 0];

