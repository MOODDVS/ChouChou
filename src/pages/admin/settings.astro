        function tmEsc(s: string): string {
          return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        // Avatar: foto se presente, altrimenti pastiglia rotonda con le iniziali
        // (colore stabile derivato dal nome).
        function tmInitiali(name: string): string {
          const parts = name.trim().split(/\s+/).filter(Boolean);
          if (parts.length === 0) return "";
          if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
          return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        }
        function tmColore(name: string): string {
          let h = 0;
          for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) % 360;
          return `hsl(${h}, 42%, 40%)`;
        }
        function tmAvatarHTML(m: TeamMember): string {
          if (m.photo_url) return `<span class="tm-avatar"><img src="${tmEsc(m.photo_url)}" alt="" loading="lazy" /></span>`;
          return `<span class="tm-avatar" style="background:${tmColore(m.name)}">${tmEsc(tmInitiali(m.name))}</span>`;
        }
        function tmRenderAvatarPreview() {
          if (tmPhotoUrl) {
