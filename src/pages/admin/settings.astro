        });
        (document.getElementById("rw-dem") as HTMLButtonElement).addEventListener("click", () => {
          rwImpostaData(rwIsoPiuGiorni(1));
          prossimaAcc("date");
        });
        rwDate.addEventListener("click", (e) => {
          e.stopPropagation();
          dpApri(rwDate);
        });
        rwDate.addEventListener("change", () => {
          rwImpostaData(rwDate.dataset.iso ?? rwIsoPiuGiorni(0));
          prossimaAcc("date");
        });
        document.querySelectorAll<HTMLElement>(".rw-acc-head").forEach((h) => {
          h.addEventListener("click", () => {
            const acc = h.closest(".rw-acc") as HTMLElement;
            apriAcc(acc.classList.contains("is-open") ? null : acc.dataset.acc ?? null);
          });
        });
        document.addEventListener("change", (e) => {
          const t = e.target as HTMLElement;
          if (t instanceof HTMLInputElement && t.classList.contains("d-active")) {
            rwImpostaData(rwDate.dataset.iso ?? rwIsoPiuGiorni(0));
          }
        });
        rwImpostaData(rwIsoPiuGiorni(0));
        applicaLingua();

        // --- Link social / recensioni (tab Liens) ---
        const CHIAVI_LINK = ["facebook", "instagram", "tiktok", "linkedin", "x", "google_review"];
        const lnkEls = new Map(
          CHIAVI_LINK.map((k) => [k, document.getElementById("lnk-" + k) as HTMLInputElement])
        );
        lnkEls.forEach((el) => el.addEventListener("input", dirty));
        const saveBtn = document.getElementById("save-btn") as HTMLButtonElement;
        const msgEl = document.getElementById("msg") as HTMLSpanElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        const token = session.access_token ?? "";
        const headers = { Authorization: `Bearer ${token}` };
        rwAuthPronta = true;

        // --- Carica i valori attuali ---
        let dati: { days: Giorno[]; prep_time_minutes: number; slot_duration_minutes: number; kitchen_email: string; links?: Record<string, string>; general?: Record<string, string>; reservations?: Record<string, string> };
        try {
          const res = await fetch("/api/admin/settings", { headers });
          if (!res.ok) { stateEl.textContent = "Erreur de chargement."; return; }
          dati = await res.json();
        } catch {
          stateEl.textContent = "Erreur de connexion.";
          return;
        }

        // --- Tab Notifications: toggle email quotidienne (salvataggio immediato) ---
        const nfSw = document.getElementById("nf-daily") as HTMLButtonElement | null;
        const nfMsg = document.getElementById("nf-msg") as HTMLParagraphElement | null;
        const nfHour = document.getElementById("nf-hour") as HTMLInputElement | null;
        const nfEmail = document.getElementById("nf-email") as HTMLInputElement | null;
        const nfDati = dati as unknown as { daily_brief_enabled?: boolean; daily_brief_hour?: string; daily_brief_email?: string };
        if (nfHour) nfHour.value = nfDati.daily_brief_hour || "09:00";
        if (nfEmail) nfEmail.value = nfDati.daily_brief_email || "";
        let nfOn = Boolean(nfDati.daily_brief_enabled);
        const nfBadge = document.getElementById("nf-badge") as HTMLSpanElement | null;
        const nfAggiorna = () => {
          nfSw?.classList.toggle("is-on", nfOn);
          if (nfBadge) nfBadge.style.display = nfOn ? "" : "none";
        };
        nfAggiorna();
        nfSw?.addEventListener("click", async () => {
          const nuovo = !nfOn;
          nfOn = nuovo;
          nfAggiorna();
          if (nfMsg) nfMsg.textContent = "";
          try {
            const { data: sFresca } = await supabaseBrowser.auth.getSession();
            const tk = sFresca.session?.access_token ?? "";
            const res = await fetch("/api/admin/settings", {
              method: "PATCH",
              headers: { Authorization: `Bearer ${tk}`, "Content-Type": "application/json" },
              body: JSON.stringify({ daily_brief_enabled: nuovo }),
            });
            if (!res.ok) throw new Error();
          } catch {
            nfOn = !nuovo;
            nfAggiorna();
            if (nfMsg) nfMsg.textContent = "Enregistrement impossible — réessaie.";
          }
        });
        const nfPatch = async (body: Record<string, string>, okMsg: string) => {
          if (nfMsg) nfMsg.textContent = "";
          try {
            const { data: sFresca } = await supabaseBrowser.auth.getSession();
            const tk = sFresca.session?.access_token ?? "";
            const res = await fetch("/api/admin/settings", {
              method: "PATCH",
              headers: { Authorization: `Bearer ${tk}`, "Content-Type": "application/json" },
              body: JSON.stringify(body),
            });
            if (!res.ok) {
              const j = await res.json().catch(() => null);
              if (nfMsg) nfMsg.textContent = (j as { error?: string } | null)?.error ?? "Enregistrement impossible — réessaie.";
              return;
            }
            if (nfMsg) nfMsg.textContent = okMsg;
          } catch {
            if (nfMsg) nfMsg.textContent = "Erreur de connexion.";
          }
        };
        nfHour?.addEventListener("change", () => {
          if (nfHour.value) nfPatch({ daily_brief_hour: nfHour.value }, `Heure d'envoi enregistrée (${nfHour.value}).`);
        });
        nfEmail?.addEventListener("change", () => {
          nfPatch({ daily_brief_email: nfEmail.value.trim() }, nfEmail.value.trim() ? "Adresse enregistrée." : "Adresse par défaut (réservations) rétablie.");
        });

        const mappa = new Map(dati.days.map((g) => [g.day_of_week, g]));
