---
// Pannello admin — Réglages: orari settimanali con giornata continua o
// servizio spezzato (Midi/Soir), tempo di preparazione, durata slot,
// email cucina.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";

// Tab "Liens": social + recensioni Google (icone piatte, currentColor)
const LNK = [
  { k: "facebook", label: "Facebook", ph: "https://www.facebook.com/...", icon: '<svg viewBox="0 0 24 24"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07z"/></svg>' },
  { k: "instagram", label: "Instagram", ph: "https://www.instagram.com/...", icon: '<svg viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.9 5.9 0 0 0-2.13 1.39A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.39 2.13a5.9 5.9 0 0 0 2.13 1.39c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.39 5.9 5.9 0 0 0 1.39-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.39-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zM12 16a4 4 0 1 1 4-4 4 4 0 0 1-4 4zM19.85 5.59a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44z"/></svg>' },
  { k: "tiktok", label: "TikTok", ph: "https://www.tiktok.com/@...", icon: '<svg viewBox="0 0 24 24"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>' },
  { k: "linkedin", label: "LinkedIn", ph: "https://www.linkedin.com/company/...", icon: '<svg viewBox="0 0 24 24"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>' },
  { k: "x", label: "X (Twitter)", ph: "https://x.com/...", icon: '<svg viewBox="0 0 24 24"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.24 6.93zM17.6 20.64h2.04L6.49 3.24H4.3z"/></svg>' },
  { k: "google_review", label: "Google — avis", ph: "https://g.page/r/.../review", icon: '<svg viewBox="0 0 24 24"><path d="M23.5 12.27c0-.85-.08-1.66-.22-2.45H12v4.64h6.44a5.5 5.5 0 0 1-2.39 3.61v3h3.87c2.26-2.09 3.58-5.16 3.58-8.8z"/><path d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.87-3c-1.08.72-2.45 1.15-4.06 1.15-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09A12 12 0 0 0 12 24z"/><path d="M5.27 14.28A7.2 7.2 0 0 1 4.89 12c0-.79.14-1.56.38-2.28V6.63H1.29a12 12 0 0 0 0 10.74z"/><path d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42A11.98 11.98 0 0 0 12 0 12 12 0 0 0 1.29 6.63l3.98 3.09C6.22 6.87 8.87 4.75 12 4.75z"/></svg>' },
];
import { CLIENT } from "../../config/client";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{"Réglages — Admin " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#231f20" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-bg: #231f20;
        --c-text: #ffffff;
        --c-accent: #dfab4e;
        --c-muted: #b3aca6;
        --c-line: #3a3335;
        --c-card: #362c28;
        --font-title: "Bebas Neue", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; overflow-x: hidden; }
      #app { display: none; min-height: 100vh; flex-direction: column; }

      main { flex: 1; padding: 2rem 2rem 7rem; width: 100%; }
      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; margin-bottom: 1.5rem; }
      h1 svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      h2 { font-family: var(--font-title); font-size: 1.4rem; letter-spacing: 0.04em; color: var(--c-muted); margin: 0 0 1rem; }
      .state { color: var(--c-muted); text-align: center; padding: 3rem 1rem; }

      #content { display: grid; grid-template-columns: 1fr; gap: 1.5rem; align-items: start; }
      .tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; padding-bottom: 1.5rem; margin: 0 0 1.5rem; border-bottom: 1px solid var(--c-line); }
      .tabs button {
        font-family: var(--font-title);
        font-size: 1.05rem;
        letter-spacing: 0.05em;
        padding: 0.5rem 1.2rem;
        background: var(--c-card);
        border: 1px solid var(--c-line);
        color: var(--c-muted);
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .tabs button:hover { border-color: var(--c-accent); color: var(--c-text); }
      .tabs button.is-active { background: var(--c-accent); border-color: var(--c-accent); color: #231f20; }
      /* Fuori dal tab Horaire il contenuto sta su una colonna contenuta */
      #content:not([data-tab="horaire"]) { grid-template-columns: 1fr; max-width: 720px; }
      .section { background: var(--c-card); border: 1px solid var(--c-line); padding: 1.5rem; min-width: 0; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28); }
      /* Tab Liens: riga = icona + label a sinistra, campo largo a destra */
      #content[data-tab="liens"], #content[data-tab="general"], #content[data-tab="team"] { max-width: none; }
      .lnk-field { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; }
      .lnk-field:last-of-type { margin-bottom: 0.9rem; }
      .lnk-lab { display: flex; align-items: center; gap: 0.8rem; min-width: 200px; }
      .lnk-ico { display: inline-flex; color: var(--c-accent); }
      .lnk-ico svg { width: 20px; height: 20px; fill: currentColor; display: block; }
      .lnk-field input[type="url"] { flex: 1; width: auto; max-width: none; }
      @media (max-width: 640px) {
        .lnk-field { flex-wrap: wrap; gap: 0.6rem; }
        .lnk-field input[type="url"] { flex-basis: 100%; }
      }

      .kemails { display: flex; flex-direction: column; gap: 0.6rem; }
      .kemail-row { display: flex; gap: 0.5rem; align-items: center; }
      .kemail-row input { flex: 1; }
      .kemail-del {
        width: 36px; height: 36px; flex-shrink: 0;
        background: rgba(237, 28, 36, 0.25);
        border: none; border-radius: 8px;
        color: #ff6b6b; font-size: 1.1rem; line-height: 1;
        cursor: pointer;
      }
      .kemail-del:hover { background: rgba(237, 28, 36, 0.4); }
      .kemail-add {
        margin-top: 0.6rem;
        background: transparent;
        border: 1px solid var(--c-accent);
        color: var(--c-accent);
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.5rem 0.9rem;
        border-radius: 8px;
        cursor: pointer;
      }
      .kemail-add:hover { background: var(--c-accent); color: #231f20; }

      .save-bar {
        position: fixed; z-index: 95;
        display: flex; align-items: center; gap: 1rem;
        left: 50%; bottom: 6.5rem;
        opacity: 0; pointer-events: none;
        transform: translateX(-50%) translateY(8px);
        transition: opacity 0.25s, transform 0.25s;
      }
      .save-bar.is-visible { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0); }
      @media (min-width: 900px) {
        .save-bar { left: auto; right: 1.75rem; bottom: 1.75rem; transform: translateY(8px); }
        .save-bar.is-visible { transform: translateY(0); }
      }
      @media (min-width: 900px) {
        #content { grid-template-columns: 1fr 1fr; }
      }

      /* --- Riga giorno --- */
      .day-row { padding: 0.75rem 0; border-bottom: 1px solid var(--c-line); }
      .day-row:last-child { border-bottom: none; }
      .day-head { display: flex; align-items: center; gap: 1rem; }
      .day-name { flex: 1; font-weight: 700; }

      /* Selettore Continu/Coupé */
      .mode { display: none; }
      .day-row.is-open .mode { display: inline-flex; }
      .mode button {
        background: transparent; border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-body); font-size: 0.78rem; letter-spacing: 0.04em;
        padding: 0.35rem 0.8rem; cursor: pointer; border-radius: 0; text-transform: uppercase;
      }
      .mode button + button { border-left: none; }
      .mode button.is-active { background: var(--c-accent); border-color: var(--c-accent); color: #231f20; font-weight: 700; }

      /* Fasce orarie */
      .bands { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.6rem; padding-right: calc(44px + 1rem); }
      .band { display: flex; align-items: center; justify-content: flex-end; gap: 0.6rem; flex-wrap: wrap; }
      .band-label { min-width: 3rem; color: var(--c-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .day-row:not(.is-open) .bands { display: none; }
      .day-row[data-mode="continu"] .band-label { visibility: hidden; }
      .day-row[data-mode="continu"] .band-soir { display: none; }

      /* Switch */
      .switch { position: relative; width: 44px; height: 24px; flex-shrink: 0; }
      .switch input { opacity: 0; width: 0; height: 0; }
      .switch .track {
        position: absolute; inset: 0; cursor: pointer; border-radius: 999px;
        background: var(--c-line); transition: background 0.2s;
      }
      .switch .track::before {
        content: ""; position: absolute; width: 18px; height: 18px; border-radius: 50%;
        left: 3px; top: 3px; background: var(--c-muted); transition: transform 0.2s, background 0.2s;
      }
      .switch input:checked + .track { background: var(--c-accent); }
      .switch input:checked + .track::before { transform: translateX(20px); background: #231f20; }

      input[type="time"], input[type="number"], input[type="email"], input[type="date"], input[type="text"], input[type="url"] {
        background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-size: 0.95rem; padding: 0.5rem 0.6rem; border-radius: 0;
        color-scheme: dark;
      }
      input:focus { outline: none; border-color: var(--c-accent); }
      input[type="number"] { width: 90px; }
      input[type="email"] { width: 100%; max-width: 360px; }

      .field { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.9rem; flex-wrap: wrap; }
      .field:last-child { margin-bottom: 0; }
      .field label { flex: 0 0 220px; max-width: 220px; }
      /* Tab Général: input a tutta larghezza, tutto allineato a sinistra */
      .section[data-tab="general"] .field { flex-wrap: nowrap; }
      .section[data-tab="general"] .field label { flex: 0 0 260px; max-width: 260px; }
      .section[data-tab="general"] .field input,
      .section[data-tab="general"] .kemails { flex: 1; width: auto; max-width: none; min-width: 0; }
      .section[data-tab="general"] .kemail-row input { width: auto; max-width: none; }
      .section[data-tab="general"] .field input.g-zip { flex: 0 0 120px; }
      /* Descrizione del campo: sempre sotto il suo label */
      .field:has(.lab-hint) { align-items: flex-start; }
      .lab-hint {
        display: block;
        color: var(--c-muted);
        font-size: 0.78rem;
        font-weight: 400;
        line-height: 1.5;
        margin-top: 0.25rem;
        padding-right: 1rem;
      }
      /* Righe dinamiche + bottone "+ Ajouter" in un'unica colonna a destra:
         il bottone sta SEMPRE subito sotto l'ultima riga del suo campo. */
      .dyn-col { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
      .dyn-col .kemails, .dyn-col .rzones { width: 100%; }
      /* Righe "sezione sala": nome + coperti + elimina */
      .rzones { display: flex; flex-direction: column; gap: 0.6rem; }
      .rz-row { display: flex; gap: 0.5rem; align-items: center; }
      .rz-row .rz-name { flex: 1; min-width: 0; }
      .section[data-tab="reservations"] .field .rz-row .rz-seats { flex: 0 0 110px; width: 110px; }
      .section[data-tab="reservations"] .rzones { flex: 1; }
      /* Tab Réservations: stessi allineamenti (label più lunghe: 300px) */
      .section[data-tab="reservations"] .field { flex-wrap: nowrap; }
      .section[data-tab="reservations"] .field label { flex: 0 0 300px; max-width: 300px; }
      .section[data-tab="reservations"] .field input { flex: 1; width: auto; max-width: none; min-width: 0; }
      @media (max-width: 700px) {
        .section[data-tab="reservations"] .field { flex-wrap: wrap; }
        .section[data-tab="reservations"] .field input { flex-basis: 100%; }
        .section[data-tab="reservations"] .hint { margin-left: 0; }
      }
      @media (max-width: 700px) {
        .field label { flex: 0 0 auto; max-width: none; }
        .section[data-tab="general"] .field { flex-wrap: wrap; }
        .section[data-tab="general"] .field input, .section[data-tab="general"] .kemails { flex-basis: 100%; }
        .section[data-tab="general"] .kemail-add, .section[data-tab="general"] .hint { margin-left: 0; }
      }
      .hint { color: var(--c-muted); font-size: 0.8rem; }

      .save {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        background: var(--c-accent); color: #231f20; border: 1px solid var(--c-accent);
        font-family: var(--font-title); font-size: 1.2rem; letter-spacing: 0.05em;
        padding: 0.75rem 2.4rem; cursor: pointer; border-radius: 999px;
        transition: background 0.25s, color 0.25s, border-color 0.25s;
      }
      .save:hover:not(:disabled):not(.is-saved) { background: transparent; color: var(--c-accent); }
      .save:disabled { opacity: 0.5; cursor: not-allowed; }
      .save.is-saved { background: #2e9e6b; border-color: #2e9e6b; color: #ffffff; }
      .msg { font-size: 0.9rem; }
      .msg.ok { color: #4caf7d; }
      .msg.err { color: #ff6b6b; }

      /* --- Team (rubrica contatti) --- */
      .tm-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; }
      .tm-head-txt { flex: 1; min-width: 0; }
      .tm-head-txt h2 { margin: 0 0 0.5rem; }
      .tm-head-txt .hint { max-width: 680px; }
      .tm-add { margin-top: 0; flex-shrink: 0; white-space: nowrap; }
      .tm-filters { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.1rem 0 1.3rem; }
      .tm-fil {
        background: transparent; border: 1px solid rgba(179, 172, 166, 0.45); color: var(--c-muted);
        font-family: var(--font-body); font-size: 0.78rem; letter-spacing: 0.03em;
        padding: 0.35rem 0.85rem; cursor: pointer; border-radius: 999px;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .tm-fil:hover { border-color: var(--c-accent); color: var(--c-text); }
      .tm-fil.is-on { background: var(--c-accent); border-color: var(--c-accent); color: #231f20; font-weight: 700; }
      .tm-group { margin-bottom: 1.6rem; }
      .tm-group:last-child { margin-bottom: 0; }
      .tm-group-title { font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.06em; color: var(--c-accent); margin-bottom: 0.6rem; text-transform: uppercase; }
      .tm-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 0.9rem; }
      .tm-card { background: var(--c-bg); border: 1px solid var(--c-line); border-radius: 12px; padding: 1.25rem 1.4rem; display: flex; flex-direction: column; }
      .tm-card.is-off { opacity: 0.5; }
      .tm-card-head { display: flex; align-items: flex-start; gap: 0.9rem; }
      .tm-card-id { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; }
      .tm-card-nameline { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
      .tm-card-details { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 1rem; }
      .tm-card-company { font-size: 0.95rem; color: var(--c-muted); }
      .tm-card-ico { width: 22px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; color: var(--c-accent); }
      .tm-ico-svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .tm-card-note { font-size: 0.95rem; color: var(--c-muted); word-break: break-word; margin-top: 0.6rem; }
      .tm-avatar {
        width: 52px; height: 52px; flex-shrink: 0; border-radius: 50%; overflow: hidden;
        display: inline-flex; align-items: center; justify-content: center;
        font-family: var(--font-body); font-weight: 700; font-size: 1.05rem;
        color: #fff; text-transform: uppercase; background: var(--c-line); user-select: none;
      }
      .tm-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .tm-avatar-lg { width: 76px; height: 76px; font-size: 1.6rem; }
      .tm-avatar-edit { display: flex; align-items: center; gap: 1.1rem; margin-bottom: 0.3rem; }
      .tm-avatar-side { display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; }
      .tm-upl {
        background: transparent; border: 1px solid var(--c-accent); color: var(--c-accent);
        font-family: var(--font-body); font-weight: 700; font-size: 0.8rem;
        padding: 0.45rem 0.9rem; border-radius: 8px; cursor: pointer;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .tm-upl:hover { background: var(--c-accent); color: #231f20; }
      .tm-upl-rm { border-color: var(--c-line); color: var(--c-muted); }
      .tm-upl-rm:hover { background: transparent; border-color: #ed1c24; color: #ff6b6b; }
      .tm-upl-state { font-size: 0.75rem; color: var(--c-muted); }
      .tm-card-top { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
      .tm-card-name { font-weight: 700; font-size: 1.1rem; color: var(--c-text); }
      .tm-card-role { color: var(--c-muted); font-size: 0.95rem; }
      .tm-badge { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.12rem 0.45rem; border-radius: 999px; border: 1px solid rgba(223, 171, 78, 0.5); color: var(--c-accent); white-space: nowrap; }
      .tm-card-line { display: grid; grid-template-columns: 22px 1fr; gap: 0.55rem; align-items: center; font-size: 0.95rem; color: var(--c-muted); word-break: break-word; }
      .tm-card-line a { color: var(--c-text); text-decoration: none; transition: color 0.15s; }
      .tm-card-line a:hover { color: var(--c-accent); text-decoration: underline; }
      .tm-card-actions { display: flex; gap: 0.5rem; margin-top: 0.9rem; }
      .tm-ibtn {
        width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
        background: transparent; border: 1px solid var(--c-line); border-radius: 50%;
        color: var(--c-muted); cursor: pointer; font-size: 0.9rem;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .tm-ibtn.edit { margin-left: auto; }
      .tm-ibtn.edit:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .tm-ibtn.del { background: rgba(237, 28, 36, 0.22); border-color: rgba(237, 28, 36, 0.35); color: #fff; }
      .tm-ibtn.del:hover { background: rgba(237, 28, 36, 0.5); border-color: #ed1c24; }
      .tm-ibtn.del.confirm { width: auto; padding: 0 0.7rem; border-radius: 999px; font-size: 0.72rem; background: #a3320f; border-color: #a3320f; white-space: nowrap; }

      /* --- Modale team --- */
      .overlay {
        position: fixed; inset: 0; z-index: 300; display: none;
        background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
        justify-content: center; padding: 3vh 1rem; overflow-y: auto;
      }
      .overlay.is-open { display: flex; }
      .overlay .modal { width: 100%; max-width: 660px; background: var(--c-bg); border: 1px solid var(--c-line); padding: 2rem; position: relative; margin: auto; }
      .overlay .modal h2 { color: var(--c-text); margin-bottom: 1.2rem; }
      .m-close { position: absolute; top: 0.8rem; right: 1rem; background: none; border: none; color: var(--c-muted); font-size: 1.6rem; cursor: pointer; line-height: 1; }
      .m-close:hover { color: var(--c-text); }
      .overlay .f-lab { display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); margin: 1.2rem 0 0.4rem; }
      .overlay .f-lab:first-of-type { margin-top: 0; }
      .overlay .f-input {
        width: 100%; background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-size: 0.95rem; padding: 0.6rem 0.8rem; border-radius: 8px;
        color-scheme: dark; max-width: none;
      }
      .overlay .f-input:focus { outline: none; border-color: var(--c-accent); }
      .overlay select.f-input { cursor: pointer; }
      .overlay textarea.f-input { resize: vertical; }
      .f-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.6rem; }
      .overlay .f-row2 .f-lab { margin-top: 0; }
      @media (max-width: 620px) { .f-row2 { grid-template-columns: 1fr; } }
      .tm-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 1.1rem; margin-top: 1.9rem; }
      .sw-wrap { display: inline-flex; align-items: center; gap: 0.5rem; }
      .sw-lab { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); }
      .tm-save { box-shadow: none; font-size: 1rem; padding: 0.6rem 1.6rem; }

      /* --- Jours spéciaux --- */
      .sp-type { display: inline-flex; }
      .sp-type button {
        background: transparent; border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-body); font-size: 0.78rem; letter-spacing: 0.04em;
        padding: 0.35rem 0.8rem; cursor: pointer; border-radius: 0; text-transform: uppercase;
      }
      .sp-type button + button { border-left: none; }
      .sp-type button.is-active { background: var(--c-accent); border-color: var(--c-accent); color: #231f20; font-weight: 700; }
      .sp-list { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; }
      .sp-item { display: flex; align-items: center; gap: 0.6rem; border: 1px solid var(--c-line); padding: 0.5rem 0.7rem; font-size: 0.9rem; }
      .sp-badge { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.15rem 0.55rem; border-radius: 999px; font-weight: 700; }
      .sp-b-closed { background: rgba(237, 28, 36, 0.18); color: #ff8a8f; }
      .sp-b-open { background: rgba(0, 113, 83, 0.3); color: #58c9a3; }
      .sp-txt { flex: 1; }
      .sp-del { background: none; border: none; color: var(--c-muted); font-size: 1.25rem; cursor: pointer; line-height: 1; padding: 0 0.2rem; }
      .sp-del:hover { color: #ff6b6b; }
      .sp-add { border-top: 1px solid var(--c-line); padding-top: 1rem; display: flex; flex-direction: column; gap: 0.6rem; }
      .sp-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
      .sp-dates { flex-wrap: nowrap; }
      #sp-hours { flex-direction: column; gap: 0.6rem; }
      /* Touch (tablet/telefono): campi data/ora più grandi per le dita */
      @media (pointer: coarse) {
        input[type="date"], input[type="time"] {
          padding: 0.8rem 0.9rem;
          font-size: 1.05rem;
          min-height: 48px;
        }
      }
      .sp-dates input { flex: 1; min-width: 0; cursor: pointer; }

      /* --- Datepicker custom (brand) --- */
      .dp-panel {
        position: fixed; z-index: 220; width: 308px;
        background: var(--c-card); border: 1px solid var(--c-line);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55); padding: 0.9rem;
      }
      .dp-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
      .dp-title { font-family: var(--font-title); font-size: 1.15rem; letter-spacing: 0.04em; text-transform: capitalize; }
      .dp-nav {
        width: 40px; height: 40px; background: transparent; border: 1px solid var(--c-line);
        color: var(--c-text); font-size: 1.3rem; cursor: pointer; border-radius: 50%;
        transition: border-color 0.15s, color 0.15s;
      }
      .dp-nav:hover:not(:disabled) { border-color: var(--c-accent); color: var(--c-accent); }
      .dp-nav:disabled { opacity: 0.3; cursor: not-allowed; }
      .dp-dow { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 0.2rem; }
      .dp-dow span { text-align: center; font-size: 0.7rem; color: var(--c-muted); text-transform: uppercase; padding: 0.2rem 0; }
      .dp-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
      .dp-cell {
        aspect-ratio: 1; min-height: 40px; display: flex; align-items: center; justify-content: center;
        background: transparent; border: none; color: var(--c-text); font-family: var(--font-body);
        font-size: 0.95rem; cursor: pointer; border-radius: 50%;
        transition: background 0.15s, color 0.15s;
      }
      .dp-cell:hover:not(:disabled):not(.dp-vuota):not(.dp-sel) { background: var(--c-line); }
      .dp-vuota { cursor: default; }
      .dp-off { color: #5d5555; cursor: not-allowed; }
      .dp-today { box-shadow: inset 0 0 0 1px var(--c-accent); }
      .dp-sel { background: var(--c-accent); color: #231f20; font-weight: 700; }
      @media (pointer: coarse) {
        .dp-panel { width: 340px; }
        .dp-cell { min-height: 44px; font-size: 1.05rem; }
      }
      #sp-note { flex: 1; min-width: 140px; }
      .sp-addbtn {
        background: transparent; border: 1px solid var(--c-accent); color: var(--c-accent);
        font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.05em;
        padding: 0.45rem 1.5rem; cursor: pointer; border-radius: 999px;
        transition: background 0.2s, color 0.2s;
      }
      .sp-addbtn:hover { background: var(--c-accent); color: #231f20; }

      @media (max-width: 560px) {
        main { padding: 1.5rem 1rem 7rem; }
        .day-head { flex-wrap: wrap; gap: 0.5rem; }
        .day-head .day-name { flex: 1; order: 1; }
        .day-head .switch { order: 2; }
        .day-head .mode { order: 3; flex-basis: 100%; }
        .bands { padding-right: 0; }
        .band { justify-content: flex-start; }
        .band input[type="time"] { flex: 1; min-width: 0; }
        .sp-row input[type="time"] { flex: 1; min-width: 0; }
      }
      /* Loader dentro i bottoni di salvataggio */
      .is-loading { position: relative; color: transparent !important; pointer-events: none; }
      .is-loading::after {
        content: ""; position: absolute; inset: 0; margin: auto;
        width: 18px; height: 18px; border-radius: 50%;
        border: 2px solid rgba(35, 31, 32, 0.3); border-top-color: #231f20;
        animation: btnspin 0.7s linear infinite;
      }
      @keyframes btnspin { to { transform: rotate(360deg); } }
    </style>
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <h1><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14" /><line x1="4" y1="10" x2="4" y2="3" /><line x1="12" y1="21" x2="12" y2="12" /><line x1="12" y1="8" x2="12" y2="3" /><line x1="20" y1="21" x2="20" y2="16" /><line x1="20" y1="12" x2="20" y2="3" /><line x1="1" y1="14" x2="7" y2="14" /><line x1="9" y1="8" x2="15" y2="8" /><line x1="17" y1="16" x2="23" y2="16" /></svg>Réglages</h1>

        <div class="tabs" id="tabs" role="tablist">
          <button type="button" data-t="general" class="is-active">Général</button>
          <button type="button" data-t="horaire">Horaire</button>
          <button type="button" data-t="reservations">Réservations</button>
          <button type="button" data-t="cuisine">Cuisine</button>
          <button type="button" data-t="liens">Liens</button>
          <button type="button" data-t="team">Team</button>
        </div>

        <div class="state" id="state">Chargement…</div>

        <div id="content" style="display:none" data-tab="general">
          <div class="section" data-tab="general">
            <h2>Informations générales</h2>
            <div class="field">
              <label for="g-name">Nom de la société</label>
              <input type="text" id="g-name" placeholder="Migraf SRL" />
            </div>
            <div class="field">
              <label for="g-street">Adresse (rue et numéro)</label>
              <input type="text" id="g-street" placeholder="Av. Adolphe Demeur 37" />
            </div>
            <div class="field">
              <label for="g-zip">Code postal &amp; ville</label>
              <input type="text" id="g-zip" class="g-zip" placeholder="1060" autocomplete="off" />
              <input type="text" id="g-city" placeholder="Saint-Gilles" />
            </div>
            <div class="field">
              <label for="g-country">Pays</label>
              <input type="text" id="g-country" placeholder="Belgique" />
            </div>
            <div class="field">
              <label for="g-vat">Numéro de TVA</label>
              <input type="text" id="g-vat" placeholder="BE 0899.648.967" autocomplete="off" />
            </div>
            <div class="field">
              <label for="g-iban">IBAN</label>
              <input type="text" id="g-iban" placeholder="BE12 3456 7890 1234" autocomplete="off" />
            </div>
            <div class="field">
              <label for="g-phone">Téléphone public</label>
              <input type="text" id="g-phone" placeholder="+32 455 13 14 65" autocomplete="tel" inputmode="tel" />
            </div>
            <div class="field">
              <label for="g-email">Email publique</label>
              <input type="email" id="g-email" placeholder="info@restaurant.be" />
            </div>
            <div class="field field-emails">
              <label>Emails du formulaire de contact<span class="lab-hint">Chaque adresse reçoit les messages envoyés depuis la page Contact.</span></label>
              <div class="dyn-col">
                <div class="kemails" id="cemails"></div>
                <button type="button" class="kemail-add" id="cemail-add">+ Ajouter un email</button>
              </div>
            </div>
            <div class="field" style="margin-top:1.2rem">
              <label for="g-nlfrom">Email expéditeur newsletter<span class="lab-hint">Doit appartenir au domaine vérifié sur Resend.</span></label>
              <input type="email" id="g-nlfrom" placeholder="info@restaurant.be" />
            </div>
            <div class="field">
              <label for="g-wa">Numéro WhatsApp<span class="lab-hint">Réservé à la future intégration WhatsApp.</span></label>
              <input type="text" id="g-wa" placeholder="+32 4xx xx xx xx" autocomplete="tel" inputmode="tel" />
            </div>
          </div>

          <div class="section" data-tab="horaire" style="display:none">
            <h2>Horaires d'ouverture (take-away)</h2>
            <div id="days"></div>
          </div>

          <div class="section" data-tab="horaire" style="display:none">
            <h2>Jours spéciaux</h2>
            <div class="sp-list" id="sp-list"></div>
            <div class="sp-add">
              <div class="sp-row">
                <span class="sp-type">
                  <button type="button" id="sp-t-closed" class="is-active">Fermé</button>
                  <button type="button" id="sp-t-open">Ouvert</button>
                </span>
              </div>
              <div class="sp-row sp-dates">
                <input type="text" id="sp-from" placeholder="jj/mm/aaaa" readonly />
                <span class="hint">→</span>
                <input type="text" id="sp-to" placeholder="jj/mm/aaaa" readonly />
              </div>
              <div id="sp-hours" style="display:none">
                <div class="sp-row">
                  <span class="sp-type">
                    <button type="button" id="sp-m-continu" class="is-active">Continu</button>
                    <button type="button" id="sp-m-coupe">Coupé</button>
                  </span>
                </div>
                <div class="sp-row">
                  <span class="band-label" id="sp-lab-midi">Midi</span>
                  <input type="time" id="sp-lo" value="11:00" />
                  <span class="hint">→</span>
                  <input type="time" id="sp-lc" value="23:30" />
                </div>
                <div class="sp-row" id="sp-soir" style="display:none">
                  <span class="band-label">Soir</span>
                  <input type="time" id="sp-do" value="18:00" />
                  <span class="hint">→</span>
                  <input type="time" id="sp-dc" value="23:00" />
                </div>
              </div>
              <div class="sp-row">
                <input type="text" id="sp-note" placeholder="Note (ex. Vacances d'été)" maxlength="200" />
                <button type="button" class="sp-addbtn" id="sp-add">Ajouter</button>
              </div>
              <span class="msg" id="sp-msg"></span>
            </div>
          </div>

          <div class="section" data-tab="reservations" style="display:none">
            <h2>Réservations</h2>
            <div class="field field-zones">
              <label>Sections &amp; couverts<span class="lab-hint">Ex. Intérieur 40, Terrasse 60. Le total est la somme des sections.</span></label>
              <div class="dyn-col">
                <div class="rzones" id="r-zones"></div>
                <button type="button" class="kemail-add" id="r-zone-add">+ Ajouter une section</button>
              </div>
            </div>
            <div class="field">
              <label for="r-hold">Durée d'occupation d'une table (min)<span class="lab-hint">Une table de 19:00 se libère à 19:00 + durée.</span></label>
              <input type="number" id="r-hold" min="15" max="360" step="15" placeholder="90" />
            </div>
            <div class="field" style="margin-top:1.2rem">
              <label for="r-from">Email expéditeur (confirmations clients)</label>
              <input type="email" id="r-from" placeholder="info@restaurant.be" />
            </div>
            <div class="field">
              <label for="r-notify">Email de réception des demandes</label>
              <input type="email" id="r-notify" placeholder="info@restaurant.be" />
            </div>
          </div>

          <div class="section" data-tab="cuisine" style="display:none">
            <h2>Cuisine</h2>
            <div class="field">
              <label for="prep">Temps de préparation (min)</label>
              <input type="number" id="prep" min="0" max="240" step="5" />
            </div>
            <div class="field">
              <label for="slot">Durée d'un créneau (min)</label>
              <input type="number" id="slot" min="5" max="120" step="5" />
            </div>
            <div class="field field-emails">
              <label>Emails cuisine (commandes)<span class="lab-hint">Chaque adresse reçoit une notification à chaque commande payée.</span></label>
              <div class="dyn-col">
                <div class="kemails" id="kemails"></div>
                <button type="button" class="kemail-add" id="kemail-add">+ Ajouter un email</button>
              </div>
            </div>
          </div>

          <div class="section" data-tab="liens" style="display:none">
            <h2>Liens</h2>
            {LNK.map((l) => (
              <div class="lnk-field">
                <label class="lnk-lab" for={"lnk-" + l.k}>
                  <span class="lnk-ico" set:html={l.icon} />
                  {l.label}
                </label>
                <input type="url" id={"lnk-" + l.k} placeholder={l.ph} />
              </div>
            ))}
            <p class="hint">Le lien Google est le lien « Laisser un avis » de la fiche Google Business du restaurant.</p>
          </div>

          <div class="section" data-tab="team" style="display:none">
            <div class="tm-head">
              <div class="tm-head-txt">
                <h2>Team</h2>
                <p class="hint">Répertoire des personnes liées au restaurant : personnel, fournisseurs, techniciens, comptable, partenaires… (contacts uniquement pour l'instant).</p>
              </div>
              <button type="button" class="kemail-add tm-add" id="tm-add">+ Ajouter un contact</button>
            </div>
            <div class="tm-filters" id="tm-filters"></div>
            <div class="tm-list" id="tm-list"></div>
            <p class="hint tm-empty" id="tm-empty" style="display:none">Aucun contact pour le moment.</p>
          </div>

          <div class="save-bar">
            <button class="save" id="save-btn">Enregistrer</button>
            <span class="msg" id="msg"></span>
          </div>
        </div>
      </main>
      <AdminFooter />
    </div>

    <!-- Modale contact Team -->
    <div class="overlay" id="tm-overlay">
      <div class="modal">
        <button class="m-close" id="tm-close" type="button" aria-label="Fermer">×</button>
        <h2 id="tm-title">Nouveau contact</h2>

        <div class="tm-avatar-edit">
          <span class="tm-avatar tm-avatar-lg" id="tm-avatar-prev"></span>
          <div class="tm-avatar-side">
            <button type="button" class="tm-upl" id="tm-upload">Téléverser une photo</button>
            <button type="button" class="tm-upl tm-upl-rm" id="tm-photo-rm" style="display:none">Retirer la photo</button>
            <input type="file" id="tm-file" accept="image/*" style="display:none" />
            <p class="tm-upl-state" id="tm-upload-state"></p>
          </div>
        </div>

        <label class="f-lab" for="tm-name">Nom *</label>
        <input type="text" class="f-input" id="tm-name" placeholder="Nom et prénom / société" />

        <div class="f-row2">
          <div>
            <label class="f-lab" for="tm-cat">Catégorie</label>
            <select class="f-input" id="tm-cat"></select>
          </div>
          <div>
            <label class="f-lab" for="tm-role">Fonction / rôle</label>
            <input type="text" class="f-input" id="tm-role" placeholder="ex. Pizzaiolo, Comptable…" />
          </div>
        </div>

        <div class="f-row2">
          <div>
            <label class="f-lab" for="tm-phone">Téléphone</label>
            <input type="text" class="f-input" id="tm-phone" placeholder="+32…" />
          </div>
          <div>
            <label class="f-lab" for="tm-email">Email</label>
            <input type="text" class="f-input" id="tm-email" placeholder="email@…" />
          </div>
        </div>

        <div class="f-row2">
          <div>
            <label class="f-lab" for="tm-phone2">Téléphone 2</label>
            <input type="text" class="f-input" id="tm-phone2" placeholder="(optionnel)" />
          </div>
          <div>
            <label class="f-lab" for="tm-email2">Email 2</label>
            <input type="text" class="f-input" id="tm-email2" placeholder="(optionnel)" />
          </div>
        </div>

        <div class="f-row2">
          <div>
            <label class="f-lab" for="tm-company">Société / entreprise</label>
            <input type="text" class="f-input" id="tm-company" placeholder="(fournisseurs, externes…)" />
          </div>
          <div>
            <label class="f-lab" for="tm-website">Site / lien</label>
            <input type="text" class="f-input" id="tm-website" placeholder="https://…" />
          </div>
        </div>

        <label class="f-lab" for="tm-notes">Notes</label>
        <textarea class="f-input" id="tm-notes" rows="3" placeholder="Notes internes…"></textarea>

        <div class="tm-foot">
          <button class="save tm-save" id="tm-save" type="button">Enregistrer</button>
          <span class="sw-wrap"><label class="switch"><input type="checkbox" id="tm-emp" /><span class="track"></span></label><span class="sw-lab">Employé</span></span>
          <span class="sw-wrap"><label class="switch"><input type="checkbox" id="tm-active" checked /><span class="track"></span></label><span class="sw-lab">Actif</span></span>
          <span class="msg err" id="tm-err"></span>
        </div>
      </div>
    </div>

    <AdminNav current="settings" />

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";

      type Giorno = {
        day_of_week: number;
        lunch_active: boolean;
        lunch_open: string | null;
        lunch_close: string | null;
        dinner_active: boolean;
        dinner_open: string | null;
        dinner_close: string | null;
      };

      const NOMI = ["Dimanche", "Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi"];
      // Ordine di visualizzazione: lunedì -> domenica
      const ORDINE = [1, 2, 3, 4, 5, 6, 0];

      function hhmm(t: string | null): string {
        return t ? t.slice(0, 5) : "";
      }

      // Modalità del giorno derivata dai dati: closed / continu / coupe
      function modeDi(g: Giorno): string {
        if (!g.lunch_active && !g.dinner_active) return "closed";
        return g.dinner_active ? "coupe" : "continu";
      }

      function rigaGiorno(g: Giorno): string {
        const mode = modeDi(g);
        const aperto = mode !== "closed";
        return `
          <div class="day-row ${aperto ? "is-open" : ""}" data-day="${g.day_of_week}" data-mode="${mode === "closed" ? "continu" : mode}">
            <div class="day-head">
              <span class="day-name">${NOMI[g.day_of_week]}</span>
              <span class="mode">
                <button type="button" class="m-continu ${mode !== "coupe" ? "is-active" : ""}">Continu</button>
                <button type="button" class="m-coupe ${mode === "coupe" ? "is-active" : ""}">Coupé</button>
              </span>
              <label class="switch">
                <input type="checkbox" class="d-active" ${aperto ? "checked" : ""} />
                <span class="track"></span>
              </label>
            </div>
            <div class="bands">
              <div class="band band-midi">
                <span class="band-label">Midi</span>
                <input type="time" class="t-lunch-open" value="${hhmm(g.lunch_open)}" />
                <span class="hint">→</span>
                <input type="time" class="t-lunch-close" value="${hhmm(g.lunch_close)}" />
              </div>
              <div class="band band-soir">
                <span class="band-label">Soir</span>
                <input type="time" class="t-dinner-open" value="${hhmm(g.dinner_open)}" />
                <span class="hint">→</span>
                <input type="time" class="t-dinner-close" value="${hhmm(g.dinner_close)}" />
              </div>
            </div>
          </div>`;
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const contentEl = document.getElementById("content") as HTMLDivElement;
        const daysEl = document.getElementById("days") as HTMLDivElement;
        const prepEl = document.getElementById("prep") as HTMLInputElement;
        const slotEl = document.getElementById("slot") as HTMLInputElement;
        const kemailsBox = document.getElementById("kemails") as HTMLDivElement;
        const kemailAdd = document.getElementById("kemail-add") as HTMLButtonElement;

        function aggiungiRigaEmail(valore = "") {
          const riga = document.createElement("div");
          riga.className = "kemail-row";
          riga.innerHTML =
            '<input type="email" placeholder="cuisine@restaurant.be" />' +
            '<button type="button" class="kemail-del" aria-label="Supprimer">×</button>';
          const inp = riga.querySelector("input") as HTMLInputElement;
          inp.value = valore;
          inp.addEventListener("input", dirty);
          (riga.querySelector(".kemail-del") as HTMLButtonElement).addEventListener("click", () => {
            riga.remove();
            if (!kemailsBox.querySelector(".kemail-row")) aggiungiRigaEmail();
            dirty();
          });
          kemailsBox.appendChild(riga);
        }

        function emailsCucina(): string {
          return Array.from(kemailsBox.querySelectorAll<HTMLInputElement>("input"))
            .map((i) => i.value.trim())
            .filter(Boolean)
            .join(", ");
        }

        kemailAdd.addEventListener("click", () => {
          aggiungiRigaEmail();
          dirty();
        });

        // --- Tab Général ---
        const G_CAMPI: [string, string][] = [
          ["company_name", "g-name"],
          ["company_street", "g-street"],
          ["company_zip", "g-zip"],
          ["company_city", "g-city"],
          ["company_country", "g-country"],
          ["company_vat", "g-vat"],
          ["company_iban", "g-iban"],
          ["public_phone", "g-phone"],
          ["public_email", "g-email"],
          ["newsletter_from_email", "g-nlfrom"],
          ["whatsapp_number", "g-wa"],
        ];
        const gEls = new Map(G_CAMPI.map(([k, id]) => [k, document.getElementById(id) as HTMLInputElement]));
        gEls.forEach((el) => el.addEventListener("input", dirty));

        const cemailsBox = document.getElementById("cemails") as HTMLDivElement;
        const cemailAdd = document.getElementById("cemail-add") as HTMLButtonElement;

        function aggiungiRigaEmailContact(valore = "") {
          const riga = document.createElement("div");
          riga.className = "kemail-row";
          riga.innerHTML =
            '<input type="email" placeholder="info@restaurant.be" />' +
            '<button type="button" class="kemail-del" aria-label="Supprimer">×</button>';
          const inp = riga.querySelector("input") as HTMLInputElement;
          inp.value = valore;
          inp.addEventListener("input", dirty);
          (riga.querySelector(".kemail-del") as HTMLButtonElement).addEventListener("click", () => {
            riga.remove();
            if (!cemailsBox.querySelector(".kemail-row")) aggiungiRigaEmailContact();
            dirty();
          });
          cemailsBox.appendChild(riga);
        }
        function emailsContact(): string {
          return Array.from(cemailsBox.querySelectorAll<HTMLInputElement>("input"))
            .map((i) => i.value.trim())
            .filter(Boolean)
            .join(", ");
        }
        cemailAdd.addEventListener("click", () => {
          aggiungiRigaEmailContact();
          dirty();
        });

        // --- Tab Réservations ---
        const R_CAMPI: [string, string][] = [
          ["reservation_hold_minutes", "r-hold"],
          ["reservation_from_email", "r-from"],
          ["reservation_notify_email", "r-notify"],
        ];
        const rEls = new Map(R_CAMPI.map(([k, id]) => [k, document.getElementById(id) as HTMLInputElement]));
        rEls.forEach((el) => el.addEventListener("input", dirty));

        // Sezioni della sala (nome + coperti), righe dinamiche
        const rZonesBox = document.getElementById("r-zones") as HTMLDivElement;
        const rZoneAdd = document.getElementById("r-zone-add") as HTMLButtonElement;

        function aggiungiRigaZona(nome = "", posti = "") {
          const riga = document.createElement("div");
          riga.className = "rz-row";
          riga.innerHTML =
            '<input type="text" class="rz-name" placeholder="Ex. Intérieur" />' +
            '<input type="number" class="rz-seats" min="1" max="500" step="1" placeholder="40" />' +
            '<button type="button" class="kemail-del" aria-label="Supprimer">×</button>';
          const iNome = riga.querySelector(".rz-name") as HTMLInputElement;
          const iPosti = riga.querySelector(".rz-seats") as HTMLInputElement;
          iNome.value = nome;
          iPosti.value = posti;
          iNome.addEventListener("input", dirty);
          iPosti.addEventListener("input", dirty);
          (riga.querySelector(".kemail-del") as HTMLButtonElement).addEventListener("click", () => {
            riga.remove();
            if (!rZonesBox.querySelector(".rz-row")) aggiungiRigaZona();
            dirty();
          });
          rZonesBox.appendChild(riga);
        }
        function zonesJSON(): string {
          const zone = Array.from(rZonesBox.querySelectorAll<HTMLElement>(".rz-row"))
            .map((r) => ({
              name: (r.querySelector(".rz-name") as HTMLInputElement).value.trim(),
              seats: Number((r.querySelector(".rz-seats") as HTMLInputElement).value),
            }))
            .filter((z) => z.name || z.seats);
          return zone.length ? JSON.stringify(zone) : "";
        }
        rZoneAdd.addEventListener("click", () => {
          aggiungiRigaZona();
          dirty();
        });

        // --- Link social / recensioni (tab Liens) ---
        const CHIAVI_LINK = ["facebook", "instagram", "tiktok", "linkedin", "x", "google_review"];
        const lnkEls = new Map(
          CHIAVI_LINK.map((k) => [k, document.getElementById("lnk-" + k) as HTMLInputElement])
        );
        lnkEls.forEach((el) => el.addEventListener("input", dirty));
        const saveBtn = document.getElementById("save-btn") as HTMLButtonElement;
        const msgEl = document.getElementById("msg") as HTMLSpanElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        const token = session.access_token ?? "";
        const headers = { Authorization: `Bearer ${token}` };

        // --- Carica i valori attuali ---
        let dati: { days: Giorno[]; prep_time_minutes: number; slot_duration_minutes: number; kitchen_email: string; links?: Record<string, string>; general?: Record<string, string>; reservations?: Record<string, string> };
        try {
          const res = await fetch("/api/admin/settings", { headers });
          if (!res.ok) { stateEl.textContent = "Erreur de chargement."; return; }
          dati = await res.json();
        } catch {
          stateEl.textContent = "Erreur de connexion.";
          return;
        }

        const mappa = new Map(dati.days.map((g) => [g.day_of_week, g]));
        daysEl.innerHTML = ORDINE.map((d) => rigaGiorno(mappa.get(d)!)).join("");
        prepEl.value = String(dati.prep_time_minutes);
        slotEl.value = String(dati.slot_duration_minutes);
        kemailsBox.innerHTML = "";
        const listaEmail = String(dati.kitchen_email ?? "").split(",").map((x: string) => x.trim()).filter(Boolean);
        if (listaEmail.length === 0) aggiungiRigaEmail();
        else listaEmail.forEach((e: string) => aggiungiRigaEmail(e));
        for (const k of CHIAVI_LINK) {
          const el = lnkEls.get(k);
          if (el) el.value = dati.links?.[k] ?? "";
        }
        gEls.forEach((el, k) => {
          el.value = dati.general?.[k] ?? "";
        });
        rEls.forEach((el, k) => {
          el.value = dati.reservations?.[k] ?? "";
        });
        rZonesBox.innerHTML = "";
        try {
          const zone = JSON.parse(dati.reservations?.reservation_zones || "[]") as { name: string; seats: number }[];
          if (zone.length === 0) aggiungiRigaZona();
          else zone.forEach((z) => aggiungiRigaZona(z.name, String(z.seats)));
        } catch {
          aggiungiRigaZona();
        }
        cemailsBox.innerHTML = "";
        const listaContact = String(dati.general?.contact_emails ?? "").split(",").map((x: string) => x.trim()).filter(Boolean);
        if (listaContact.length === 0) aggiungiRigaEmailContact();
        else listaContact.forEach((e: string) => aggiungiRigaEmailContact(e));

        stateEl.style.display = "none";
        contentEl.style.display = "grid";

        // Bottone flottante: appare alla prima modifica
        const saveBar = document.querySelector(".save-bar") as HTMLElement;
        // function declaration: è "hoisted", quindi utilizzabile anche
        // dal codice della lista email che gira prima di questa riga.
        function dirty() {
          saveBar.classList.add("is-visible");
        }
        daysEl.addEventListener("change", dirty);
        daysEl.addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          if (t.classList.contains("m-continu") || t.classList.contains("m-coupe")) dirty();
        });
        [prepEl, slotEl].forEach((el) => el.addEventListener("input", dirty));

        // --- Jours spéciaux (salvataggio immediato, indipendente da Enregistrer) ---
        type SpecialDay = {
          id: string; type: "closed" | "open";
          date_from: string; date_to: string;
          lunch_open: string | null; lunch_close: string | null;
          dinner_open: string | null; dinner_close: string | null;
          note: string;
        };
        const spList = document.getElementById("sp-list") as HTMLDivElement;
        const spFrom = document.getElementById("sp-from") as HTMLInputElement;
        const spTo = document.getElementById("sp-to") as HTMLInputElement;
        const spNote = document.getElementById("sp-note") as HTMLInputElement;
        const spHours = document.getElementById("sp-hours") as HTMLElement;
        const spLo = document.getElementById("sp-lo") as HTMLInputElement;
        const spLc = document.getElementById("sp-lc") as HTMLInputElement;
        const spSoir = document.getElementById("sp-soir") as HTMLElement;
        const spDo = document.getElementById("sp-do") as HTMLInputElement;
        const spDc = document.getElementById("sp-dc") as HTMLInputElement;
        const spLabMidi = document.getElementById("sp-lab-midi") as HTMLElement;
        const spMContinu = document.getElementById("sp-m-continu") as HTMLButtonElement;
        const spMCoupe = document.getElementById("sp-m-coupe") as HTMLButtonElement;
        let spMode: "continu" | "coupe" = "continu";
        const spAddBtn = document.getElementById("sp-add") as HTMLButtonElement;
        const spMsg = document.getElementById("sp-msg") as HTMLSpanElement;
        const spTClosed = document.getElementById("sp-t-closed") as HTMLButtonElement;
        const spTOpen = document.getElementById("sp-t-open") as HTMLButtonElement;
        let spType: "closed" | "open" = "closed";

        function fmtData(iso: string): string {
          const [y, m, d] = iso.split("-");
          return `${d}/${m}/${y}`;
        }
        function spItemHTML(s: SpecialDay): string {
          const dates = s.date_from === s.date_to
            ? fmtData(s.date_from)
            : `${fmtData(s.date_from)} → ${fmtData(s.date_to)}`;
          let ore = "";
          if (s.type === "open" && s.lunch_open && s.lunch_close) {
            ore = ` · ${s.lunch_open.slice(0, 5)}–${s.lunch_close.slice(0, 5)}`;
            if (s.dinner_open && s.dinner_close) {
              ore += ` / ${s.dinner_open.slice(0, 5)}–${s.dinner_close.slice(0, 5)}`;
            }
          }
          const nota = s.note ? ` · ${s.note}` : "";
          const badge = s.type === "closed"
            ? '<span class="sp-badge sp-b-closed">Fermé</span>'
            : '<span class="sp-badge sp-b-open">Ouvert</span>';
          return `<div class="sp-item">${badge}<span class="sp-txt">${dates}${ore}${nota}</span><button type="button" class="sp-del" data-id="${s.id}" aria-label="Supprimer">×</button></div>`;
        }
        async function caricaSpecial() {
          try {
            const res = await fetch("/api/admin/special-days", { headers });
            if (!res.ok) return;
            const j = await res.json();
            const items = (j.days as SpecialDay[]) ?? [];
            spList.innerHTML = items.length
              ? items.map(spItemHTML).join("")
              : '<p class="hint">Aucun jour spécial programmé.</p>';
          } catch { /* silenzioso: la lista resta com'era */ }
        }
        spTClosed.addEventListener("click", () => {
          spType = "closed";
          spTClosed.classList.add("is-active");
          spTOpen.classList.remove("is-active");
          spHours.style.display = "none";
        });
        spTOpen.addEventListener("click", () => {
          spType = "open";
          spTOpen.classList.add("is-active");
          spTClosed.classList.remove("is-active");
          spHours.style.display = "flex";
        });
        spMContinu.addEventListener("click", () => {
          spMode = "continu";
          spMContinu.classList.add("is-active");
          spMCoupe.classList.remove("is-active");
          spSoir.style.display = "none";
          spLabMidi.style.display = "none";
          if (spLc.value === "14:30") spLc.value = "23:30";
        });
        spMCoupe.addEventListener("click", () => {
          spMode = "coupe";
          spMCoupe.classList.add("is-active");
          spMContinu.classList.remove("is-active");
          spSoir.style.display = "flex";
          spLabMidi.style.display = "";
          if (spLc.value === "23:30") spLc.value = "14:30";
          if (!spDo.value) spDo.value = "18:00";
          if (!spDc.value) spDc.value = "23:00";
        });
        // All'avvio la modalità è Continu: etichetta Midi nascosta
        spLabMidi.style.display = "none";
        spAddBtn.addEventListener("click", async () => {
          spMsg.textContent = "";
          spMsg.className = "msg";
          if (!spFrom.dataset.iso) {
            spMsg.textContent = "Choisis une date.";
            spMsg.classList.add("err");
            return;
          }
          spAddBtn.disabled = true;
          try {
            const res = await fetch("/api/admin/special-days", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({
                type: spType,
                date_from: spFrom.dataset.iso,
                date_to: spTo.dataset.iso || spFrom.dataset.iso,
                lunch_open: spType === "open" ? spLo.value : null,
                lunch_close: spType === "open" ? spLc.value : null,
                dinner_open: spType === "open" && spMode === "coupe" ? spDo.value : null,
                dinner_close: spType === "open" && spMode === "coupe" ? spDc.value : null,
                note: spNote.value.trim(),
              }),
            });
            const j = await res.json();
            if (!res.ok) {
              spMsg.textContent = j.error ?? "Erreur.";
              spMsg.classList.add("err");
            } else {
              spFrom.value = ""; spTo.value = ""; spNote.value = "";
              delete spFrom.dataset.iso; delete spTo.dataset.iso;
              await caricaSpecial();
            }
          } catch {
            spMsg.textContent = "Erreur de connexion.";
            spMsg.classList.add("err");
          } finally {
            spAddBtn.disabled = false;
          }
        });
        spList.addEventListener("click", async (e) => {
          const t = e.target as HTMLElement;
          if (!t.classList.contains("sp-del")) return;
          try {
            await fetch("/api/admin/special-days?id=" + t.dataset.id, { method: "DELETE", headers });
            await caricaSpecial();
          } catch { /* la lista resta com'era */ }
        });
        await caricaSpecial();

        // Campi ORA: un tap apre subito il picker nativo.
        document.addEventListener("click", (e) => {
          const t = e.target as HTMLInputElement;
          if (t instanceof HTMLInputElement && t.type === "time" && !t.disabled) {
            try {
              t.showPicker?.();
            } catch {
              /* browser senza showPicker: resta il comportamento nativo */
            }
          }
        });

        // --- Datepicker custom (brand) per i campi data ---
        const MESI = ["janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre"];
        const DOW = ["L", "M", "M", "J", "V", "S", "D"];
        let dpTarget: HTMLInputElement | null = null;
        let dpAnno = 0;
        let dpMese = 0; // 0-11
        const dpPanel = document.createElement("div");
        dpPanel.className = "dp-panel";
        dpPanel.style.display = "none";
        document.body.appendChild(dpPanel);

        function isoOggi(): string {
          const d = new Date();
          return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
        }
        function isoDi(y: number, m: number, g: number): string {
          return `${y}-${String(m + 1).padStart(2, "0")}-${String(g).padStart(2, "0")}`;
        }
        function fmtFr(iso: string): string {
          const [y, m, d] = iso.split("-");
          return `${d}/${m}/${y}`;
        }
        function dpRender() {
          const oggi = isoOggi();
          const sel = dpTarget?.dataset.iso ?? "";
          const offset = (new Date(dpAnno, dpMese, 1).getDay() + 6) % 7; // lunedì=0
          const nGiorni = new Date(dpAnno, dpMese + 1, 0).getDate();
          const oy = Number(oggi.slice(0, 4));
          const om = Number(oggi.slice(5, 7)) - 1;
          const prevOff = dpAnno < oy || (dpAnno === oy && dpMese <= om);
          let celle = "";
          for (let i = 0; i < offset; i++) celle += '<span class="dp-cell dp-vuota"></span>';
          for (let g = 1; g <= nGiorni; g++) {
            const iso = isoDi(dpAnno, dpMese, g);
            const cls = ["dp-cell"];
            if (iso < oggi) cls.push("dp-off");
            if (iso === oggi) cls.push("dp-today");
            if (iso === sel) cls.push("dp-sel");
            celle += `<button type="button" class="${cls.join(" ")}" data-iso="${iso}" ${iso < oggi ? "disabled" : ""}>${g}</button>`;
          }
          dpPanel.innerHTML = `
            <div class="dp-head">
              <button type="button" class="dp-nav" data-nav="-1" ${prevOff ? "disabled" : ""}>‹</button>
              <span class="dp-title">${MESI[dpMese]} ${dpAnno}</span>
              <button type="button" class="dp-nav" data-nav="1">›</button>
            </div>
            <div class="dp-dow">${DOW.map((g) => `<span>${g}</span>`).join("")}</div>
            <div class="dp-grid">${celle}</div>`;
        }
        function dpApri(target: HTMLInputElement) {
          dpTarget = target;
          const base = target.dataset.iso || isoOggi();
          dpAnno = Number(base.slice(0, 4));
          dpMese = Number(base.slice(5, 7)) - 1;
          dpRender();
          dpPanel.style.display = "block";
          const r = target.getBoundingClientRect();
          const pw = dpPanel.offsetWidth || 308;
          dpPanel.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - pw - 8))}px`;
          dpPanel.style.top = `${r.bottom + 6}px`;
        }
        function dpChiudi() {
          dpPanel.style.display = "none";
          dpTarget = null;
        }
        dpPanel.addEventListener("click", (e) => {
          e.stopPropagation();
          const t = e.target as HTMLElement;
          if (t.classList.contains("dp-nav")) {
            dpMese += Number(t.dataset.nav);
            if (dpMese < 0) { dpMese = 11; dpAnno--; }
            if (dpMese > 11) { dpMese = 0; dpAnno++; }
            dpRender();
            return;
          }
          if (t.classList.contains("dp-cell") && t.dataset.iso && dpTarget) {
            const iso = t.dataset.iso;
            dpTarget.dataset.iso = iso;
            dpTarget.value = fmtFr(iso);
            // se la fine manca o è prima dell'inizio, allineala
            const fromIso = spFrom.dataset.iso ?? "";
            const toIso = spTo.dataset.iso ?? "";
            if (dpTarget === spFrom && (!toIso || toIso < fromIso)) {
              spTo.dataset.iso = iso;
              spTo.value = fmtFr(iso);
            }
            dpChiudi();
          }
        });
        [spFrom, spTo].forEach((el) => {
          el.addEventListener("click", (e) => {
            e.stopPropagation();
            dpApri(el);
          });
        });
        document.addEventListener("click", (e) => {
          if (dpPanel.style.display !== "none" && !dpPanel.contains(e.target as Node)) dpChiudi();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") dpChiudi();
        });

        // --- Interazioni ---
        daysEl.addEventListener("change", (e) => {
          const t = e.target as HTMLInputElement;
          if (!t.classList.contains("d-active")) return;
          const row = t.closest(".day-row") as HTMLElement;
          row.classList.toggle("is-open", t.checked);
          if (t.checked) {
            // Default sensato quando si riapre un giorno
            const lo = row.querySelector(".t-lunch-open") as HTMLInputElement;
            const lc = row.querySelector(".t-lunch-close") as HTMLInputElement;
            if (!lo.value) lo.value = "11:00";
            if (!lc.value) lc.value = "23:30";
          }
        });

        daysEl.addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          const row = t.closest(".day-row") as HTMLElement | null;
          if (!row) return;
          if (t.classList.contains("m-continu") || t.classList.contains("m-coupe")) {
            const coupe = t.classList.contains("m-coupe");
            row.dataset.mode = coupe ? "coupe" : "continu";
            row.querySelector(".m-continu")!.classList.toggle("is-active", !coupe);
            row.querySelector(".m-coupe")!.classList.toggle("is-active", coupe);
            if (coupe) {
              // Default sensati per il servizio spezzato
              const lo = row.querySelector(".t-lunch-open") as HTMLInputElement;
              const lc = row.querySelector(".t-lunch-close") as HTMLInputElement;
              const so = row.querySelector(".t-dinner-open") as HTMLInputElement;
              const sc = row.querySelector(".t-dinner-close") as HTMLInputElement;
              if (!lo.value) lo.value = "12:00";
              if (lc.value === "23:30" || !lc.value) lc.value = "14:30";
              if (!so.value) so.value = "18:00";
              if (!sc.value) sc.value = "23:00";
            }
          }
        });

        // --- Salva ---
        saveBtn.addEventListener("click", async () => {
          msgEl.textContent = "";
          msgEl.className = "msg";

          const days = Array.from(daysEl.querySelectorAll<HTMLElement>(".day-row")).map((row) => {
            const aperto = (row.querySelector(".d-active") as HTMLInputElement).checked;
            const coupe = row.dataset.mode === "coupe";
            const v = (sel: string) => (row.querySelector(sel) as HTMLInputElement).value || null;
            return {
              day_of_week: Number(row.dataset.day),
              lunch_active: aperto,
              lunch_open: aperto ? v(".t-lunch-open") : null,
              lunch_close: aperto ? v(".t-lunch-close") : null,
              dinner_active: aperto && coupe,
              dinner_open: aperto && coupe ? v(".t-dinner-open") : null,
              dinner_close: aperto && coupe ? v(".t-dinner-close") : null,
            };
          });

          saveBtn.disabled = true;
          saveBtn.classList.add("is-loading");
          try {
            const res = await fetch("/api/admin/settings", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({
                days,
                prep_time_minutes: Number(prepEl.value),
                slot_duration_minutes: Number(slotEl.value),
                kitchen_email: emailsCucina(),
                links: Object.fromEntries(
                  CHIAVI_LINK.map((k) => [k, (lnkEls.get(k)?.value ?? "").trim()])
                ),
                general: {
                  ...Object.fromEntries(
                    Array.from(gEls.entries()).map(([k, el]) => [k, el.value.trim()])
                  ),
                  contact_emails: emailsContact(),
                },
                reservations: {
                  ...Object.fromEntries(
                    Array.from(rEls.entries()).map(([k, el]) => [k, el.value.trim()])
                  ),
                  reservation_zones: zonesJSON(),
                },
              }),
            });
            const json = await res.json();
            if (!res.ok) {
              msgEl.textContent = json.error ?? "Erreur d'enregistrement.";
              msgEl.classList.add("err");
            } else {
              saveBtn.classList.add("is-saved");
              saveBtn.textContent = "Sauvegardé ✓";
              setTimeout(() => {
                saveBar.classList.remove("is-visible");
                // reset del bottone dopo la dissolvenza
                setTimeout(() => {
                  saveBtn.classList.remove("is-saved");
                  saveBtn.textContent = "Enregistrer";
                }, 300);
              }, 1800);
            }
          } catch {
            msgEl.textContent = "Erreur de connexion.";
            msgEl.classList.add("err");
          } finally {
            saveBtn.disabled = false;
            saveBtn.classList.remove("is-loading");
          }
        });

        // ============================================================
        // ----- Team (rubrica contatti) -----
        // ============================================================
        const TM_CATS: { k: string; label: string }[] = [
          { k: "direction", label: "Direction" },
          { k: "cuisine", label: "Cuisine" },
          { k: "salle", label: "Salle & Bar" },
          { k: "admin", label: "Administration" },
          { k: "fournisseurs", label: "Fournisseurs" },
          { k: "technique", label: "Technique & Maintenance" },
          { k: "marketing", label: "Marketing & Digital" },
          { k: "consultants", label: "Consultants" },
          { k: "partenaires", label: "Partenaires" },
        ];

        interface TeamMember {
          id: string; name: string; category: string; role: string | null;
          is_employee: boolean; phone: string | null; email: string | null;
          phone2: string | null; email2: string | null; company: string | null;
          website: string | null; photo_url: string | null; notes: string | null; active: boolean;
        }

        const tmListEl = document.getElementById("tm-list") as HTMLDivElement;
        const tmEmptyEl = document.getElementById("tm-empty") as HTMLParagraphElement;
        const tmFiltersEl = document.getElementById("tm-filters") as HTMLDivElement;
        const tmOverlay = document.getElementById("tm-overlay") as HTMLDivElement;
        const tmTitle = document.getElementById("tm-title") as HTMLHeadingElement;
        const tmName = document.getElementById("tm-name") as HTMLInputElement;
        const tmCat = document.getElementById("tm-cat") as HTMLSelectElement;
        const tmRole = document.getElementById("tm-role") as HTMLInputElement;
        const tmPhone = document.getElementById("tm-phone") as HTMLInputElement;
        const tmEmail = document.getElementById("tm-email") as HTMLInputElement;
        const tmPhone2 = document.getElementById("tm-phone2") as HTMLInputElement;
        const tmEmail2 = document.getElementById("tm-email2") as HTMLInputElement;
        const tmCompany = document.getElementById("tm-company") as HTMLInputElement;
        const tmWebsite = document.getElementById("tm-website") as HTMLInputElement;
        const tmNotes = document.getElementById("tm-notes") as HTMLTextAreaElement;
        const tmAvatarPrev = document.getElementById("tm-avatar-prev") as HTMLSpanElement;
        const tmUpload = document.getElementById("tm-upload") as HTMLButtonElement;
        const tmPhotoRm = document.getElementById("tm-photo-rm") as HTMLButtonElement;
        const tmFile = document.getElementById("tm-file") as HTMLInputElement;
        const tmUploadState = document.getElementById("tm-upload-state") as HTMLParagraphElement;
        const tmEmp = document.getElementById("tm-emp") as HTMLInputElement;
        const tmActive = document.getElementById("tm-active") as HTMLInputElement;
        const tmSave = document.getElementById("tm-save") as HTMLButtonElement;
        const tmErr = document.getElementById("tm-err") as HTMLSpanElement;

        tmCat.innerHTML = TM_CATS.map((c) => `<option value="${c.k}">${c.label}</option>`).join("");

        let team: TeamMember[] = [];
        let tmEditId: string | null = null;
        let tmFiltro = "all";
        let tmPhotoUrl = "";

        function tmEsc(s: string): string {
          return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        // Avatar: foto se presente, altrimenti pastiglia rotonda con le iniziali
        // (colore stabile derivato dal nome).
        function tmInitiali(name: string): string {
          const parts = name.trim().split(/\s+/).filter(Boolean);
          if (parts.length === 0) return "";
          if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
          return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        }
        function tmColore(name: string): string {
          let h = 0;
          for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) % 360;
          return `hsl(${h}, 42%, 40%)`;
        }
        function tmAvatarHTML(m: TeamMember): string {
          if (m.photo_url) return `<span class="tm-avatar"><img src="${tmEsc(m.photo_url)}" alt="" loading="lazy" /></span>`;
          return `<span class="tm-avatar" style="background:${tmColore(m.name)}">${tmEsc(tmInitiali(m.name))}</span>`;
        }
        function tmRenderAvatarPreview() {
          if (tmPhotoUrl) {
            tmAvatarPrev.innerHTML = `<img src="${tmEsc(tmPhotoUrl)}" alt="" />`;
            tmAvatarPrev.style.background = "";
            tmPhotoRm.style.display = "";
          } else {
            const name = tmName.value;
            tmAvatarPrev.textContent = tmInitiali(name);
            tmAvatarPrev.style.background = name.trim() ? tmColore(name) : "";
            tmPhotoRm.style.display = "none";
          }
        }

        function tmRenderFiltri() {
          const usate = new Set(team.map((m) => m.category));
          const chips = [`<button type="button" class="tm-fil${tmFiltro === "all" ? " is-on" : ""}" data-f="all">Tous</button>`];
          for (const c of TM_CATS) {
            if (!usate.has(c.k)) continue;
            chips.push(`<button type="button" class="tm-fil${tmFiltro === c.k ? " is-on" : ""}" data-f="${c.k}">${c.label}</button>`);
          }
          tmFiltersEl.innerHTML = chips.join("");
        }

        const TM_ICO_PHONE = `<svg class="tm-ico-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.98.36 1.92.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.34 1.83.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`;
        const TM_ICO_MAIL = `<svg class="tm-ico-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><polyline points="22 6 12 13 2 6"/></svg>`;
        const TM_ICO_GLOBE = `<svg class="tm-ico-svg" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`;
        function tmCardHTML(m: TeamMember): string {
          // Righe con icona in colonna fissa (icone allineate verticalmente).
          const lines: string[] = [];
          if (m.phone) {
            const p2 = m.phone2 ? ` · <a href="tel:${tmEsc(m.phone2)}">${tmEsc(m.phone2)}</a>` : "";
            lines.push(`<div class="tm-card-line"><span class="tm-card-ico">${TM_ICO_PHONE}</span><span><a href="tel:${tmEsc(m.phone)}">${tmEsc(m.phone)}</a>${p2}</span></div>`);
          } else if (m.phone2) {
            lines.push(`<div class="tm-card-line"><span class="tm-card-ico">${TM_ICO_PHONE}</span><span><a href="tel:${tmEsc(m.phone2)}">${tmEsc(m.phone2)}</a></span></div>`);
          }
          const mail = m.email || m.email2;
          if (mail) lines.push(`<div class="tm-card-line"><span class="tm-card-ico">${TM_ICO_MAIL}</span><span><a href="mailto:${tmEsc(mail)}">${tmEsc(mail)}</a></span></div>`);
          if (m.website) {
            const u = /^https?:\/\//.test(m.website) ? m.website : "https://" + m.website;
            const disp = m.website.replace(/^https?:\/\//, "").replace(/\/+$/, "");
            lines.push(`<div class="tm-card-line"><span class="tm-card-ico">${TM_ICO_GLOBE}</span><span><a href="${tmEsc(u)}" target="_blank" rel="noopener">${tmEsc(disp)}</a></span></div>`);
          }
          const dettInner =
            (m.company ? `<div class="tm-card-company">${tmEsc(m.company)}</div>` : "") +
            lines.join("") +
            (m.notes ? `<div class="tm-card-note">${tmEsc(m.notes)}</div>` : "");
          const dettagli = dettInner ? `<div class="tm-card-details">${dettInner}</div>` : "";
          return `
            <div class="tm-card${m.active ? "" : " is-off"}">
              <div class="tm-card-head">
                ${tmAvatarHTML(m)}
                <div class="tm-card-id">
                  <div class="tm-card-nameline">
                    <span class="tm-card-name">${tmEsc(m.name)}</span>
                    ${m.is_employee ? `<span class="tm-badge emp">Employé</span>` : ""}
                  </div>
                  ${m.role ? `<span class="tm-card-role">${tmEsc(m.role)}</span>` : ""}
                  ${dettagli}
                </div>
              </div>
              <div class="tm-card-actions">
                <button type="button" class="tm-ibtn edit" data-edit="${m.id}" aria-label="Modifier">✎</button>
                <button type="button" class="tm-ibtn del" data-del="${m.id}" aria-label="Supprimer">✕</button>
              </div>
            </div>`;
        }

        function tmRender() {
          tmRenderFiltri();
          const visibili = team.filter((m) => tmFiltro === "all" || m.category === tmFiltro);
          if (visibili.length === 0) {
            tmListEl.innerHTML = "";
            tmEmptyEl.style.display = "block";
            return;
          }
          tmEmptyEl.style.display = "none";
          const html: string[] = [];
          for (const c of TM_CATS) {
            const membri = visibili.filter((m) => m.category === c.k);
            if (membri.length === 0) continue;
            html.push(
              `<div class="tm-group"><div class="tm-group-title">${c.label}</div><div class="tm-cards">${membri.map(tmCardHTML).join("")}</div></div>`
            );
          }
          tmListEl.innerHTML = html.join("");
        }

        async function tmCarica() {
          try {
            const res = await fetch("/api/admin/team", { headers });
            const j = await res.json();
            team = j.team ?? [];
            tmRender();
          } catch {
            tmListEl.innerHTML = "";
            tmEmptyEl.textContent = "Erreur de chargement.";
            tmEmptyEl.style.display = "block";
          }
        }

        function tmApri(m: TeamMember | null) {
          tmEditId = m?.id ?? null;
          tmTitle.textContent = m ? "Modifier le contact" : "Nouveau contact";
          tmErr.textContent = "";
          tmName.value = m?.name ?? "";
          tmCat.value = m?.category ?? "direction";
          tmRole.value = m?.role ?? "";
          tmPhone.value = m?.phone ?? "";
          tmEmail.value = m?.email ?? "";
          tmPhone2.value = m?.phone2 ?? "";
          tmEmail2.value = m?.email2 ?? "";
          tmCompany.value = m?.company ?? "";
          tmWebsite.value = m?.website ?? "";
          tmNotes.value = m?.notes ?? "";
          tmEmp.checked = m?.is_employee ?? false;
          tmActive.checked = m ? m.active : true;
          tmPhotoUrl = m?.photo_url ?? "";
          tmUploadState.textContent = "";
          tmRenderAvatarPreview();
          tmOverlay.classList.add("is-open");
        }
        function tmChiudi() {
          tmOverlay.classList.remove("is-open");
        }

        document.getElementById("tm-add")?.addEventListener("click", () => tmApri(null));
        document.getElementById("tm-close")?.addEventListener("click", tmChiudi);
        tmOverlay.addEventListener("click", (e) => {
          if (e.target === tmOverlay) tmChiudi();
        });

        // Aggiorna le iniziali mentre si scrive il nome (se non c'è foto)
        tmName.addEventListener("input", () => {
          if (!tmPhotoUrl) tmRenderAvatarPreview();
        });

        // Upload foto (riusa /api/admin/upload, bucket popups)
        tmUpload.addEventListener("click", () => tmFile.click());
        tmFile.addEventListener("change", async () => {
          const file = tmFile.files?.[0];
          if (!file) return;
          if (file.size > 4 * 1024 * 1024) {
            tmUploadState.textContent = "Fichier trop lourd (max 4 Mo).";
            return;
          }
          tmUpload.disabled = true;
          tmUploadState.textContent = "Téléversement…";
          try {
            const base64 = await new Promise<string>((res, rej) => {
              const r = new FileReader();
              r.onload = () => res(String(r.result).split(",")[1] ?? "");
              r.onerror = () => rej(new Error());
              r.readAsDataURL(file);
            });
            const resp = await fetch("/api/admin/upload", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ filename: file.name, data: base64 }),
            });
            const j = await resp.json();
            if (!resp.ok) {
              tmUploadState.textContent = j.error ?? "Erreur de téléversement";
              return;
            }
            tmPhotoUrl = j.url;
            tmRenderAvatarPreview();
            tmUploadState.textContent = "Photo téléversée ✓";
          } catch {
            tmUploadState.textContent = "Erreur de connexion";
          } finally {
            tmUpload.disabled = false;
            tmFile.value = "";
          }
        });
        tmPhotoRm.addEventListener("click", () => {
          tmPhotoUrl = "";
          tmUploadState.textContent = "";
          tmRenderAvatarPreview();
        });

        tmFiltersEl.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".tm-fil") as HTMLElement | null;
          if (!el) return;
          tmFiltro = el.dataset.f ?? "all";
          tmRender();
        });

        tmSave.addEventListener("click", async () => {
          const payload = {
            id: tmEditId ?? undefined,
            name: tmName.value.trim(),
            category: tmCat.value,
            role: tmRole.value.trim(),
            phone: tmPhone.value.trim(),
            email: tmEmail.value.trim(),
            phone2: tmPhone2.value.trim(),
            email2: tmEmail2.value.trim(),
            company: tmCompany.value.trim(),
            website: tmWebsite.value.trim(),
            photo_url: tmPhotoUrl,
            notes: tmNotes.value.trim(),
            is_employee: tmEmp.checked,
            active: tmActive.checked,
          };
          if (!payload.name) {
            tmErr.textContent = "Le nom est obligatoire.";
            return;
          }
          tmErr.textContent = "";
          tmSave.disabled = true;
          try {
            const res = await fetch("/api/admin/team", {
              method: tmEditId ? "PUT" : "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const j = await res.json();
            if (!res.ok) {
              tmErr.textContent = j.error ?? "Enregistrement impossible";
              return;
            }
            tmChiudi();
            await tmCarica();
          } catch {
            tmErr.textContent = "Erreur de connexion";
          } finally {
            tmSave.disabled = false;
          }
        });

        let tmDelPending: string | null = null;
        let tmDelTimer: number | undefined;
        tmListEl.addEventListener("click", async (e) => {
          const t = e.target as HTMLElement;
          const edit = t.closest("[data-edit]") as HTMLElement | null;
          if (edit) {
            const m = team.find((x) => x.id === edit.dataset.edit);
            if (m) tmApri(m);
            return;
          }
          const del = t.closest("[data-del]") as HTMLElement | null;
          if (del) {
            const id = del.dataset.del!;
            if (tmDelPending === id) {
              window.clearTimeout(tmDelTimer);
              tmDelPending = null;
              try {
                const res = await fetch("/api/admin/team?id=" + id, { method: "DELETE", headers });
                if (res.ok) await tmCarica();
              } catch {
                /* noop */
              }
              return;
            }
            tmDelPending = id;
            del.classList.add("confirm");
            del.textContent = "Confirmer ?";
            window.clearTimeout(tmDelTimer);
            tmDelTimer = window.setTimeout(() => {
              tmDelPending = null;
              del.classList.remove("confirm");
              del.textContent = "✕";
            }, 3000);
          }
        });

        tmCarica();
      })();
    
  // ----- Tab della pagina (Horaire / Cuisine / Liens / Team) -----
  const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("#tabs button"));
  const TAB_KEY = "lm-adm-settings-tab";

  function mostraTab(t: string) {
    tabBtns.forEach((b) => b.classList.toggle("is-active", b.dataset.t === t));
    document.querySelectorAll<HTMLElement>("#content .section[data-tab]").forEach((sec) => {
      sec.style.display = sec.dataset.tab === t ? "" : "none";
    });
    const contenuto = document.getElementById("content");
    if (contenuto) contenuto.dataset.tab = t;
    // Enregistrer serve solo dove ci sono campi da salvare
    const bar = document.querySelector<HTMLElement>(".save-bar");
    if (bar) bar.style.display = t === "general" || t === "horaire" || t === "reservations" || t === "cuisine" || t === "liens" ? "" : "none";
    try {
      sessionStorage.setItem(TAB_KEY, t);
    } catch {
      /* storage non disponibile: pazienza */
    }
  }

  tabBtns.forEach((b) => b.addEventListener("click", () => mostraTab(b.dataset.t ?? "horaire")));

  let tabIniziale = "general";
  try {
    const salvato = sessionStorage.getItem(TAB_KEY);
    if (salvato && tabBtns.some((b) => b.dataset.t === salvato)) tabIniziale = salvato;
  } catch {
    /* niente ripristino */
  }
  mostraTab(tabIniziale);
</script>
  </body>
</html>
