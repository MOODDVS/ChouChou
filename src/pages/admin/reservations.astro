        });

        // ---- Modale cestino: Annuler (email cliente) / Supprimer (silenzioso) ----
        const rmOverlay = document.getElementById("rm-overlay") as HTMLDivElement;
        let rmId = "";
        function apriRm(id: string) {
          rmId = id;
          const r = rese.find((x) => x.id === id);
          const already = !!r && (r.status === "cancelled" || r.status === "noshow");
          const choices = document.getElementById("rm-choices") as HTMLDivElement;
          const reasonBox = document.getElementById("rm-reason-box") as HTMLDivElement;
          choices.style.display = "block";
          reasonBox.style.display = "none";
          (document.getElementById("rm-cancel-email") as HTMLElement).style.display = already ? "none" : "block";
          rmOverlay.classList.add("is-open");
        }
        function chiudiRm() {
          rmOverlay.classList.remove("is-open");
          rmId = "";
        }
        const rmChoices = document.getElementById("rm-choices") as HTMLDivElement;
        const rmReasonBox = document.getElementById("rm-reason-box") as HTMLDivElement;
        const rmReason = document.getElementById("rm-reason") as HTMLTextAreaElement;
        function rmMostraScelte() { rmChoices.style.display = "block"; rmReasonBox.style.display = "none"; }
        (document.getElementById("rm-close") as HTMLElement).addEventListener("click", chiudiRm);
        rmOverlay.addEventListener("click", (e) => { if (e.target === rmOverlay) chiudiRm(); });
        // "Annuler et prévenir": mostra il textarea per la ragione (facoltativa).
        function nomeLingua(code: string): string {
          const c = (code || "").trim();
          if (!c) return "";
          try {
            const n = new Intl.DisplayNames([LANG], { type: "language" }).of(c);
            return n ? n.charAt(0).toUpperCase() + n.slice(1) : c.toUpperCase();
          } catch {
            return c.toUpperCase();
          }
        }
        (document.getElementById("rm-cancel-email") as HTMLElement).addEventListener("click", () => {
          rmReason.value = "";
          const r = rese.find((x) => x.id === rmId);
          const lh = document.getElementById("rm-lang-hint") as HTMLElement;
          const nome = r?.lang ? nomeLingua(r.lang) : "";
          if (nome) { lh.innerHTML = `${esc(tr("res.delReasonLang"))} <span style="display:inline-block;background:color-mix(in srgb, var(--c-accent) 16%, transparent);color:var(--c-accent);padding:3px 11px;border-radius:999px;font-size:0.82rem;font-weight:700;margin-left:4px;">${esc(nome)}</span>`; lh.style.display = "block"; }
          else { lh.style.display = "none"; }
          rmChoices.style.display = "none";
          rmReasonBox.style.display = "block";
          rmReason.focus();
        });
        (document.getElementById("rm-back") as HTMLElement).addEventListener("click", rmMostraScelte);
        (document.getElementById("rm-confirm-cancel") as HTMLElement).addEventListener("click", () => {
          const id = rmId;
          const reason = rmReason.value.trim();
          chiudiRm();
          if (id) void cambiaStato(id, "cancelled", reason || undefined);
        });
        (document.getElementById("rm-delete") as HTMLElement).addEventListener("click", () => {
          const id = rmId; chiudiRm(); if (id) void eliminaResa(id);
        });

        // ---- Modale No-show: storico cliente + notifica facoltativa + blocco ----
        const nsOverlay = document.getElementById("ns-overlay") as HTMLDivElement;
        const nsBlock = document.getElementById("ns-block") as HTMLInputElement;
        let nsId = "";
        function chiudiNs() { nsOverlay.classList.remove("is-open"); nsId = ""; }
        async function apriNs(id: string) {
          nsId = id;
          const r = rese.find((x) => x.id === id);
          nsBlock.checked = false;
          (document.getElementById("ns-name") as HTMLElement).textContent =
            r ? (`${r.first_name} ${r.last_name}`.trim() || tr("res.reservation")) : "";
          const lab = document.getElementById("ns-hist-lab") as HTMLElement;
          const cnt = document.getElementById("ns-count") as HTMLElement;
          lab.textContent = "…"; cnt.textContent = "";
          nsOverlay.classList.add("is-open");
          // Storico no-show del cliente (per email/telefono), best-effort.
          try {
            const qs = new URLSearchParams({ client_stats: "1" });
            if (r?.email) qs.set("client_email", r.email);
            if (r?.phone) qs.set("client_phone", r.phone);
            const res = await fetch("/api/admin/reservations?" + qs.toString(), { headers });
            const j = await res.json();
            const n = Number(j?.noshows ?? 0);
            if (nsId !== id) return; // modale chiuso/cambiato nel frattempo
            if (n > 0) { lab.textContent = tr("res.nsPrevLabel"); cnt.textContent = String(n); }
            else { lab.textContent = tr("res.nsFirst"); cnt.textContent = ""; }
          } catch {
            lab.textContent = tr("res.nsFirst"); cnt.textContent = "";
          }
        }
        // Blocca il cliente per le prossime prenotazioni (riusa /api/admin/clients).
        async function bloccaCliente(r: Resa) {
          try {
            await fetch("/api/admin/clients", {
              method: "PATCH",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({
                match_email: r.email || "",
                match_phone: r.phone || "",
                name: `${r.first_name} ${r.last_name}`.trim() || (r.email || r.phone || "—"),
                email: r.email || "",
                phone: r.phone || "",
                blocked: true,
              }),
            });
            toast(tr("res.nsBlockedOk"), "ok");
          } catch { /* best-effort: il no-show resta comunque salvato */ }
        }
        async function confermaNs(notify: boolean) {
          const id = nsId;
          const r = rese.find((x) => x.id === id);
          const blocca = nsBlock.checked;
          chiudiNs();
          if (!id) return;
          if (blocca && r) await bloccaCliente(r);
          await cambiaStato(id, "noshow", undefined, notify);
        }
        (document.getElementById("ns-close") as HTMLElement).addEventListener("click", chiudiNs);
        nsOverlay.addEventListener("click", (e) => { if (e.target === nsOverlay) chiudiNs(); });
        (document.getElementById("ns-notify") as HTMLElement).addEventListener("click", () => void confermaNs(true));
        (document.getElementById("ns-silent") as HTMLElement).addEventListener("click", () => void confermaNs(false));

        // ---- Viste Semaine (7 jours) / Mois (30 jours, calendrier) ----
        const semEl = document.getElementById("vista-sem") as HTMLDivElement;
        const moisEl = document.getElementById("vista-mois") as HTMLDivElement;
        const btnSem = document.getElementById("d-sem") as HTMLButtonElement;
        const btnMois = document.getElementById("d-mois") as HTMLButtonElement;
        const VISTA_ST: Record<string, { lab: string; col: string }> = {
          pending: { lab: tr("res.stPending"), col: "var(--c-accent)" },
          confirmed: { lab: tr("res.stConfirmed"), col: "#2e9e6b" },
          seated: { lab: tr("res.stSeated"), col: "#3b82f6" },
          done: { lab: tr("res.stDone"), col: "var(--c-muted)" },
        };
        let vistaSeq = 0;

        function vaiVista(v: "jour" | "semaine" | "mois") {
          vista = v;
          btnSem.classList.toggle("is-on", v === "semaine");
          btnMois.classList.toggle("is-on", v === "mois");
          semEl.style.display = v === "semaine" ? "" : "none";
          moisEl.style.display = v === "mois" ? "" : "none";
          const fs = document.getElementById("f-serv") as HTMLElement | null;
          if (fs) fs.style.display = v === "jour" ? "" : "none";
          if (v === "jour") {
            render();
          } else {
            rowsEl.style.display = "none";
            emptyEl.style.display = "none";
            stateEl.style.display = "none";
            const lb = document.getElementById("d-label") as HTMLElement;
            lb.textContent = v === "semaine" ? tr("res.next7Days") : tr("res.next30Days");
            lb.classList.remove("is-today");
            (document.getElementById("d-today") as HTMLElement).classList.remove("is-now");
            void caricaVista();
          }
        }

        async function caricaVista() {
          const v = vista;
          if (v === "jour") return;
          const seq = ++vistaSeq;
          const cont = v === "semaine" ? semEl : moisEl;
          cont.innerHTML = `<p class="state">${tr("sup.loading")}</p>`;
          const da = isoOggi();
          const a = isoPiuGiorni(da, v === "semaine" ? 6 : 29);
          try {
            const res = await fetch(`/api/admin/reservations?from=${da}&to=${a}`, { headers });
            if (!res.ok) throw new Error();
            const j = (await res.json()) as { reservations?: Resa[] };
            if (seq !== vistaSeq || vista !== v) return; // vista cambiata nel frattempo
            const lista = (j.reservations ?? []).filter((r) => r.status !== "cancelled" && r.status !== "noshow");
            if (v === "semaine") renderSemaine(lista, da);
            else renderMois(lista, da);
            const attive = lista.filter((r) => r.status === "confirmed" || r.status === "seated");
            const couverts = attive.reduce((t, r) => t + r.people, 0);
            const attesa = lista.filter((r) => r.status === "pending").length;
            (document.getElementById("d-stats") as HTMLElement).innerHTML =
              `<b>${couverts}</b> ${tr("res.covers")} · ${attive.length} ${attive.length > 1 ? tr("res.resaMany") : tr("res.resaOne")}${attesa ? ` · <b style="color:var(--c-accent)">${attesa}</b> ${tr("res.waiting")}` : ""}`;
          } catch {
            if (seq === vistaSeq) cont.innerHTML = `<p class="state">${tr("sup.load.error")}</p>`;
          }
        }

        function renderSemaine(lista: Resa[], da: string) {
          const perGiorno = new Map<string, Resa[]>();
          for (const r of lista) {
            if (!perGiorno.has(r.date)) perGiorno.set(r.date, []);
            perGiorno.get(r.date)!.push(r);
          }
          let html = "";
          for (let i = 0; i < 7; i++) {
            const iso = isoPiuGiorni(da, i);
            const arr = (perGiorno.get(iso) ?? []).sort((x, y) => (x.heure < y.heure ? -1 : x.heure > y.heure ? 1 : 0));
            const attive = arr.filter((r) => r.status === "confirmed" || r.status === "seated");
            const cop = attive.reduce((t, r) => t + r.people, 0);
            const att = arr.filter((r) => r.status === "pending").length;
            const conte = arr.length
              ? `<b>${cop}</b> ${tr("res.covers")} · ${attive.length} ${attive.length > 1 ? tr("res.resaMany") : tr("res.resaOne")}${att ? ` · <i>${att} ${tr("res.waiting")}</i>` : ""}`
              : tr("res.noResaLower");
            html += `<div class="vs-head${iso === isoOggi() ? " is-today" : ""}" data-date="${iso}">${labelGiorno(iso)}<span class="vs-n">${conte}</span></div>`;
            html += arr
              .map((r) => {
                const st = VISTA_ST[r.status] ?? { lab: r.status, col: "var(--c-muted)" };
                const tav = etichettaTavoli(r);
                return `<div class="vs-row" data-date="${iso}"><span class="vs-h">${esc(r.heure.slice(0, 5))}</span><span class="vs-nome">${esc(`${r.first_name} ${r.last_name}`.trim())}</span><span class="vs-p"><b>${r.people}</b> ${tr("res.pers")}</span><span class="vs-z">${esc(tav || r.zone || "")}</span><span class="vs-st" style="color:${st.col}">${st.lab}</span></div>`;
              })
              .join("");
          }
          semEl.innerHTML = html;
        }

        function renderMois(lista: Resa[], da: string) {
          const per = new Map<string, { att: number; cop: number; pend: number }>();
          for (const r of lista) {
            const c = per.get(r.date) ?? { att: 0, cop: 0, pend: 0 };
            if (r.status === "pending") c.pend++;
            else { c.att++; c.cop += r.people; }
            per.set(r.date, c);
          }
          const fmtMois = new Intl.DateTimeFormat(LOC, { month: "short" });
          const dowPrimo = (new Date(da + "T12:00:00").getDay() + 6) % 7; // lunedì=0
          let html = '<div class="vm-dow">' + tr("res.dowInitials").split(",").map((g) => `<span>${g}</span>`).join("") + "</div>";
          html += '<div class="vm-grid">';
          for (let i = 0; i < dowPrimo; i++) html += '<span class="vm-cell vm-vuota"></span>';
          for (let i = 0; i < 30; i++) {
            const iso = isoPiuGiorni(da, i);
            const d = Number(iso.slice(8, 10));
            const mois = i === 0 || d === 1 ? ` <span class="vm-mois">${fmtMois.format(new Date(iso + "T12:00:00"))}</span>` : "";
            const info = per.get(iso);
            const dentro = info
              ? `<span class="vm-c"><b>${info.cop}</b> ${tr("home.covers")}</span><span class="vm-r">${info.att} ${tr("res.resaOne")}${info.pend ? ` · <i>${info.pend} ${tr("res.waitingShort")}</i>` : ""}</span>`
              : "";
            html += `<div class="vm-cell${iso === isoOggi() ? " is-today" : ""}" data-date="${iso}"><span class="vm-d">${d}${mois}</span>${dentro}</div>`;
          }
          html += "</div>";
          moisEl.innerHTML = html;
        }

        function vaiAlGiorno(iso: string) {
