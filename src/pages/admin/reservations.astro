        znList.addEventListener("pointerdown", (e) => {
          const grip = (e.target as HTMLElement).closest(".zn-grip") as HTMLElement | null;
          if (!grip) return;
          const row = grip.closest(".sv-row") as HTMLElement | null;
          if (!row) return;
          e.preventDefault();
          znDrag = row;
          row.classList.add("zn-dragging");
          try { grip.setPointerCapture(e.pointerId); } catch { /* ok */ }
        });
        znList.addEventListener("pointermove", (e) => {
          if (!znDrag) return;
          const righe = [...znList.querySelectorAll(".sv-row")] as HTMLElement[];
          let posato = false;
          for (const r of righe) {
            if (r === znDrag) continue;
            const b = r.getBoundingClientRect();
            if (e.clientY < b.top + b.height / 2) {
              if (r !== znDrag.nextElementSibling) znList.insertBefore(znDrag, r);
              posato = true;
              break;
            }
          }
          if (!posato && znList.lastElementChild !== znDrag) znList.appendChild(znDrag);
          znNumeri();
        });
        const znFineDrag = () => {
          if (!znDrag) return;
          znDrag.classList.remove("zn-dragging");
          znDrag = null;
          znNumeri();
          void znSalvaPrio();
        };
        znList.addEventListener("pointerup", znFineDrag);
        znList.addEventListener("pointercancel", () => {
