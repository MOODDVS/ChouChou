        <div id="zn-future"></div>
      </div>
    </div>

    <!-- Modale services du jour: chiusure par service -->
    <div class="overlay" id="sv-overlay">
      <div class="modal">
        <button class="m-close" id="sv-close" aria-label="Fermer">×</button>
        <h2>Services</h2>
        <span class="f-label">Date</span>
        <div class="nm-days sv-days">
          <button type="button" class="nm-pill" id="sv-auj">Aujourd'hui</button>
          <button type="button" class="nm-pill" id="sv-dem">Demain</button>
        </div>
        <input type="text" id="sv-datein" class="nm-datein" readonly />
        <div id="sv-list"></div>
        <span class="f-label sv-fut-lab">Fermetures à venir</span>
        <div id="sv-future"></div>
      </div>
    </div>

    <!-- Modale prenotazione manuale (walk-in / telefono), stile widget -->
    <div class="overlay" id="m-overlay">
      <div class="modal modal-resa">
        <button class="m-close" id="m-close" aria-label="Fermer">×</button>
        <h2 id="m-title">Nouvelle réservation</h2>
        <div class="nm-grid">
          <div class="nm-col">
            <span class="f-label" id="nm-type-lab">Type</span>
            <div class="nm-days" id="nm-type-row">
              <button type="button" class="nm-pill nm-pill-ico is-on" id="nm-walkin"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m20 15h-6a1 1 0 0 1 -1-.9l-.6-6a4.62 4.62 0 1 1 9.2 0l-.6 6a1 1 0 0 1 -1 .9zm-5.1-2h4.2l.51-5.12a2.59 2.59 0 0 0 -.67-2 2.68 2.68 0 0 0 -3.88 0 2.59 2.59 0 0 0 -.67 2zm2.1 10a4 4 0 0 1 -4-4v-2a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2a4 4 0 0 1 -4 4zm-2-5v1a2 2 0 0 0 4 0v-1zm-5-5h-6a1 1 0 0 1 -1-.9l-.6-6a4.62 4.62 0 1 1 9.2 0l-.6 6a1 1 0 0 1 -1 .9zm-5.1-2h4.2l.51-5.12a2.59 2.59 0 0 0 -.67-2 2.68 2.68 0 0 0 -3.88 0 2.59 2.59 0 0 0 -.67 2zm2.1 10a4 4 0 0 1 -4-4v-2a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2a4 4 0 0 1 -4 4zm-2-5v1a2 2 0 0 0 4 0v-1z"/></svg>Walk-in</button>
              <button type="button" class="nm-pill nm-pill-ico" id="nm-phone"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="m31.9 14.2c-2.8-6.4-7.9-11.5-14.2-14.1-.5-.2-1.1 0-1.3.6-.2.5 0 1.2.6 1.4 5.9 2.5 10.5 7.1 13.1 13 .2.4.5.6.9.6.1 0 .3 0 .4-.1.5-.2.7-.8.5-1.4z"/><path d="m16.4 7.8c3.6 1.5 6.4 4.3 8 7.9.2.4.5.6.9.6.1 0 .3 0 .4-.1.5-.2.7-.8.5-1.4-1.8-4.1-5-7.3-9-9-.5-.2-1.1 0-1.3.6-.3.5 0 1.1.5 1.4z"/><path d="m26.5 20.2c-.6-.6-1.2-.8-1.8-.8s-1.3.3-1.8.8c-.9.9-1.7 1.7-2.6 2.6-.1.1-.3.2-.4.2s-.2 0-.3-.1c-.6-.3-1.2-.6-1.7-.9-2.5-1.6-4.6-3.6-6.4-5.9-.9-1.1-1.7-2.3-2.3-3.7-.3-.2-.2-.4 0-.6.9-.8 1.7-1.7 2.6-2.5 1.2-1.2 1.2-2.6 0-3.8-.7-.7-1.3-1.3-2-2-.8-.8-1.5-1.5-2.2-2.1-.5-.6-1.2-.9-1.8-.9s-1.3.3-1.8.8c-.9.9-1.8 1.8-2.7 2.6-.8.8-1.2 1.8-1.3 2.9-.1 1.8.3 3.5.9 5.2 1.3 3.4 3.2 6.5 5.6 9.3 3.2 3.8 7 6.8 11.4 8.9 2 1 4.1 1.7 6.3 1.8h.4c1.4 0 2.6-.4 3.6-1.5.7-.8 1.6-1.6 2.4-2.4 1.2-1.2 1.2-2.6 0-3.8-1.4-1.3-2.7-2.7-4.1-4.1z"/></svg>Téléphone</button>
            </div>
            <span class="f-label nm-gap">Date</span>
            <div class="nm-days">
              <button type="button" class="nm-pill" id="nm-auj">Aujourd'hui</button>
              <button type="button" class="nm-pill" id="nm-dem">Demain</button>
            </div>
            <input type="text" id="m-date" class="nm-datein" readonly placeholder="Choisir une date…" />
            <span class="f-label nm-gap">Personnes</span>
            <div class="nm-pers" id="nm-pers"></div>
            <span class="f-label nm-gap">Service &amp; heure</span>
            <div class="nm-stabs" id="nm-stabs"></div>
            <div class="nm-closed-note" id="nm-closed-note" style="display:none"></div>
            <div class="nm-slots" id="nm-slots"></div>
            <span class="f-label nm-gap" id="nm-zone-lab">Section</span>
            <div class="nm-zones" id="nm-zones"></div>
          </div>
          <div class="nm-col">
            <span class="f-label">Client</span>
            <div class="nm-frow">
              <input type="text" class="nm-in" id="m-fname" maxlength="60" autocomplete="off" placeholder="Prénom" />
              <input type="text" class="nm-in" id="m-lname" maxlength="60" autocomplete="off" placeholder="Nom" />
            </div>
            <div class="nm-frow">
              <select class="nm-in nm-tel-prefix" id="m-prefix"></select>
              <input type="text" class="nm-in" id="m-tel" maxlength="30" autocomplete="off" inputmode="tel" placeholder="Téléphone" />
            </div>
            <div class="nm-frow">
              <input type="text" class="nm-in" id="m-email" maxlength="160" autocomplete="off" inputmode="email" placeholder="Email" />
            </div>
            <span class="f-label">Options</span>
            <div class="nm-opts">
              <button type="button" class="nm-opt" id="m-opt-chaise">Chaise bébé</button>
              <button type="button" class="nm-opt" id="m-opt-calme">Endroit calme</button>
              <button type="button" class="nm-opt" id="m-opt-biz">Business</button>
            </div>
            <div class="nm-frow" id="m-soc-row" style="display:none">
              <input type="text" class="nm-in" id="m-societe" maxlength="120" autocomplete="off" placeholder="Nom de la société" />
            </div>
            <div class="nm-frow">
              <textarea class="nm-in" id="m-notes" maxlength="500" rows="3" placeholder="Notes…"></textarea>
            </div>
          </div>
        </div>
        <div class="m-actions">
          <span class="m-msg" id="m-msg"></span>
          <button class="m-cancel" id="m-cancel">Annuler</button>
          <button class="m-save" id="m-save">Ajouter</button>
        </div>
      </div>
    </div>

    <div class="toast" id="toast"></div>

    <AdminNav current="reservations" />

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { SERVIZI_WIDGET } from "../../lib/reservationI18n";
      import { PREFISSI, separaPrefisso } from "../../lib/prefissi";
      import { CLIENT } from "../../config/client";

      interface Resa {
        id: string;
        date: string;
        heure: string;
        service_key: string | null;
        people: number;
        zone: string | null;
        first_name: string;
        last_name: string;
        phone: string;
        email: string;
        lang: string;
        high_chair: boolean;
        quiet: boolean;
        business: boolean;
        company: string | null;
        notes: string | null;
        status: string;
        source?: string | null;
      }

      // Origine della prenotazione: walk-in, téléphone, sito web, Google
      const ICO_SRC: Record<string, string> = {
        walkin: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m20 15h-6a1 1 0 0 1 -1-.9l-.6-6a4.62 4.62 0 1 1 9.2 0l-.6 6a1 1 0 0 1 -1 .9zm-5.1-2h4.2l.51-5.12a2.59 2.59 0 0 0 -.67-2 2.68 2.68 0 0 0 -3.88 0 2.59 2.59 0 0 0 -.67 2zm2.1 10a4 4 0 0 1 -4-4v-2a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2a4 4 0 0 1 -4 4zm-2-5v1a2 2 0 0 0 4 0v-1zm-5-5h-6a1 1 0 0 1 -1-.9l-.6-6a4.62 4.62 0 1 1 9.2 0l-.6 6a1 1 0 0 1 -1 .9zm-5.1-2h4.2l.51-5.12a2.59 2.59 0 0 0 -.67-2 2.68 2.68 0 0 0 -3.88 0 2.59 2.59 0 0 0 -.67 2zm2.1 10a4 4 0 0 1 -4-4v-2a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2a4 4 0 0 1 -4 4zm-2-5v1a2 2 0 0 0 4 0v-1z"/></svg>',
        phone: '<svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="m31.9 14.2c-2.8-6.4-7.9-11.5-14.2-14.1-.5-.2-1.1 0-1.3.6-.2.5 0 1.2.6 1.4 5.9 2.5 10.5 7.1 13.1 13 .2.4.5.6.9.6.1 0 .3 0 .4-.1.5-.2.7-.8.5-1.4z"/><path d="m16.4 7.8c3.6 1.5 6.4 4.3 8 7.9.2.4.5.6.9.6.1 0 .3 0 .4-.1.5-.2.7-.8.5-1.4-1.8-4.1-5-7.3-9-9-.5-.2-1.1 0-1.3.6-.3.5 0 1.1.5 1.4z"/><path d="m26.5 20.2c-.6-.6-1.2-.8-1.8-.8s-1.3.3-1.8.8c-.9.9-1.7 1.7-2.6 2.6-.1.1-.3.2-.4.2s-.2 0-.3-.1c-.6-.3-1.2-.6-1.7-.9-2.5-1.6-4.6-3.6-6.4-5.9-.9-1.1-1.7-2.3-2.3-3.7-.3-.2-.2-.4 0-.6.9-.8 1.7-1.7 2.6-2.5 1.2-1.2 1.2-2.6 0-3.8-.7-.7-1.3-1.3-2-2-.8-.8-1.5-1.5-2.2-2.1-.5-.6-1.2-.9-1.8-.9s-1.3.3-1.8.8c-.9.9-1.8 1.8-2.7 2.6-.8.8-1.2 1.8-1.3 2.9-.1 1.8.3 3.5.9 5.2 1.3 3.4 3.2 6.5 5.6 9.3 3.2 3.8 7 6.8 11.4 8.9 2 1 4.1 1.7 6.3 1.8h.4c1.4 0 2.6-.4 3.6-1.5.7-.8 1.6-1.6 2.4-2.4 1.2-1.2 1.2-2.6 0-3.8-1.4-1.3-2.7-2.7-4.1-4.1z"/></svg>',
        web: '<svg viewBox="0 0 51 51" fill="currentColor" aria-hidden="true"><g clip-rule="evenodd" fill-rule="evenodd"><path d="m25.75 5.83301c-10.643 0-19.27081 8.62789-19.27081 19.27079 0 10.643 8.62781 19.2709 19.27081 19.2709.863 0 1.5625.6995 1.5625 1.5625 0 .8629-.6995 1.5625-1.5625 1.5625-12.3689 0-22.39581-10.027-22.39581-22.3959 0-12.3688 10.02691-22.39579 22.39581-22.39579s22.3959 10.02699 22.3959 22.39579c0 .863-.6996 1.5625-1.5625 1.5625-.863 0-1.5625-.6995-1.5625-1.5625 0-10.6429-8.6279-19.27079-19.2709-19.27079z"/><path d="m26.8884 3.12887c.6873-.52188 1.6675-.38782 2.1893.29943l-1.2443.94495c1.2443-.94495 1.2447-.94447 1.2451-.94396l.0009.00117.0022.00292.0061.00812.0189.02531c.0154.0209.0367.04981.0633.08663.0532.07362.1279.17889.221.31482.1862.2718.4463.66657.7553 1.17654.6178 1.01943 1.4334 2.50252 2.2467 4.387 1.6256 3.7663 3.253 9.1611 3.253 15.6719 0 .863-.6996 1.5625-1.5625 1.5625-.863 0-1.5625-.6995-1.5625-1.5625 0-5.9891-1.4977-10.9596-2.9971-14.4335-.7492-1.73567-1.4961-3.09144-2.0502-4.00585-.2769-.45695-.5051-.80284-.6607-1.02997-.0778-.11354-.1374-.19731-.1757-.25035l-.0412-.05636-.007-.00947c-.5212-.68721-.3876-1.66765.2994-2.18933z"/><path d="m23.6667 4.37325c-1.2444-.94495-1.2448-.94447-1.2451-.94396l-.0009.00117-.0022.00292-.0061.00812-.0189.02531c-.0155.0209-.0367.04981-.0634.08663-.0532.07362-.1279.17889-.221.31482-.1862.2718-.4462.66657-.7553 1.17654-.6177 1.01943-1.4333 2.50252-2.2467 4.387-1.6256 3.7663-3.2529 9.1611-3.2529 15.6719 0 6.5109 1.6273 11.9057 3.2529 15.6719.8134 1.8845 1.629 3.3676 2.2467 4.387.3091.51.5691.9048.7553 1.1766.0931.1359.1678.2412.221.3148.0267.0368.0479.0657.0634.0866l.0188.0253.0062.0082.0022.0029.0009.0011c.0003.0006.0007.001 1.2451-.9439l-1.2444.9449c.5219.6873 1.5021.8213 2.1893.2995.687-.5217.8212-1.5014.3001-2.1886l-.0077-.0102-.0412-.0564c-.0383-.053-.0979-.1368-.1756-.2503-.1556-.2272-.3839-.5731-.6608-1.03-.5541-.9144-1.301-2.2702-2.0501-4.0058-1.4995-3.474-2.9971-8.4444-2.9971-14.4336 0-5.9891 1.4976-10.9595 2.9971-14.4335.7491-1.73567 1.496-3.09144 2.0501-4.00585.2769-.45695.5052-.80284.6608-1.02997.0777-.11354.1373-.19731.1756-.25035l.0412-.05636.0077-.01027z"/><path d="m4.66593 32.3955c0-.8629.69956-1.5625 1.5625-1.5625h19.52167c.8629 0 1.5625.6996 1.5625 1.5625 0 .863-.6996 1.5625-1.5625 1.5625h-19.52167c-.86294 0-1.5625-.6995-1.5625-1.5625z"/><path d="m4.66593 17.8122c0-.863.69956-1.5625 1.5625-1.5625h39.04327c.863 0 1.5625.6995 1.5625 1.5625 0 .8629-.6995 1.5625-1.5625 1.5625h-39.04327c-.86294 0-1.5625-.6996-1.5625-1.5625z"/><path d="m33.1715 29.308c.883-.6183 2.0049-.5728 2.8994-.0225l11.0788 6.8153c1.0167.6255 1.5204 1.7142 1.4786 2.7338-.0433 1.0556-.7424 2.2758-2.2154 2.4428l-4.5029.5104-2.0198 4.0568c-.6607 1.3271-2.0464 1.5666-3.0532 1.2463-.9724-.3094-1.8232-1.1551-2.0632-2.3244l-2.6151-12.7417c-.2112-1.0287.1298-2.0985 1.0128-2.7168z"/></g></svg>',
        google: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36" /><path d="M21 12h-9" /></svg>',
      };
      const SRC_TITRE: Record<string, string> = {
        walkin: "Walk-in",
        phone: "Par téléphone",
        web: "Depuis le site",
        google: "Via Google",
      };

      const ICO_EDIT =
        '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z" /></svg>';

      const ICO_TRASH =
        '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /></svg>';

      const ICO_TEL =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>';
      const ICO_MAIL =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>';
      const ICO_BIZ =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>';

      function esc(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }

      const toastEl = document.getElementById("toast") as HTMLDivElement;
      let toastTimer: number | undefined;
      function toast(msg: string, tipo: "" | "ok" | "err" = "") {
        toastEl.textContent = msg;
        toastEl.className = "toast show" + (tipo ? " " + tipo : "");
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toastEl.classList.remove("show"), 2500);
      }

      // ----- Giorno corrente (fuso Bruxelles) -----
      let fusoOrario = "Europe/Brussels"; // dai Réglages → Général (config API)
      function isoOggi(): string {
        return new Intl.DateTimeFormat("en-CA", { timeZone: fusoOrario }).format(new Date());
      }
      function isoPiuGiorni(iso: string, g: number): string {
        const d = new Date(iso + "T12:00:00");
        d.setDate(d.getDate() + g);
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      }
      function labelGiorno(iso: string): string {
        return new Date(iso + "T12:00:00").toLocaleDateString("fr-BE", {
          weekday: "long",
          day: "numeric",
          month: "long",
          year: "numeric",
        });
      }

      let giorno = isoOggi();
      let modoRicerca = false; // il campo di ricerca sta mostrando risultati
      let filtroServ = ""; // "" = tutti i services, altrimenti la key (midi, soir…)
      function dataFr(iso: string): string {
        const [y, m, d] = iso.split("-");
        return `${d}/${m}/${y}`;
      }
      // Chiusure di servizio del giorno mostrato (pillole + bottone cloche)
      let chiusureOggi: { service_key: string; reason: string }[] = [];
      let chiusureZoneOggi: { zone: string; reason: string }[] = [];
      const RAGIONE_FR: Record<string, string> = { full: "Complet", closed: "Fermeture exceptionnelle" };
      function aggiornaChiusureUI() {
        const box = document.getElementById("d-closed") as HTMLElement;
        box.innerHTML =
          chiusureOggi
            .map((c) => {
              const nome = SERVIZI_WIDGET[c.service_key]?.fr ?? c.service_key;
              return `<span class="d-closed-pill">${esc(nome)} — ${RAGIONE_FR[c.reason] ?? c.reason}<button type="button" class="d-closed-x" data-tipo="service" data-k="${esc(c.service_key)}" aria-label="Rouvrir">×</button></span>`;
            })
            .join("") +
          chiusureZoneOggi
            .map(
              (c) =>
                `<span class="d-closed-pill">${esc(c.zone)} — ${RAGIONE_FR[c.reason] ?? c.reason}<button type="button" class="d-closed-x" data-tipo="zone" data-k="${esc(c.zone)}" aria-label="Rouvrir">×</button></span>`
            )
            .join("");
        (document.getElementById("fab-serv") as HTMLElement).classList.toggle("has-closed", chiusureOggi.length > 0);
        (document.getElementById("fab-zone") as HTMLElement).classList.toggle("has-closed", chiusureZoneOggi.length > 0);
      }
      let rese: Resa[] = [];
      let holdMinutes = 90;
      let nmCfg: {
        slot_minutes: number;
        services: { key: string; from: string; to: string; hold?: number; slot?: number }[];
        zones: string[];
        capacity?: number;
        zone_seats?: Record<string, number>;
        timezone?: string;
      } = {
        slot_minutes: 30,
        services: [],
        zones: [],
      };
      let headers: Record<string, string> = {};

      function minutiDa(hhmm: string): number {
        const m = /^(\d{1,2}):(\d{2})/.exec(hhmm);
        return m ? Number(m[1]) * 60 + Number(m[2]) : -1;
      }
      function minutiOra(): number {
        const [h, m] = new Intl.DateTimeFormat("en-GB", {
          timeZone: fusoOrario,
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        })
          .format(new Date())
          .split(":");
        return Number(h) * 60 + Number(m);
      }
      /** Durée d'occupation della prenotazione: dal suo service (fallback globale). */
      function holdDi(serviceKey: string | null): number {
        const sv = nmCfg.services?.find((x) => x.key === serviceKey);
        const n = Math.floor(Number(sv?.hold));
        return Number.isFinite(n) && n >= 15 && n <= 360 ? n : holdMinutes;
      }
      /** Fase temporale di una CONFERMATA: future | encours | passe */
      function fase(r: Resa): "future" | "encours" | "passe" {
        const oggi = isoOggi();
        if (r.date > oggi) return "future";
        if (r.date < oggi) return "passe";
        const adesso = minutiOra();
        const inizio = minutiDa(r.heure);
        if (adesso >= inizio + holdDi(r.service_key)) return "passe";
        if (adesso >= inizio) return "encours";
        return "future";
      }

      const stateEl = document.getElementById("state") as HTMLDivElement;
      const rowsEl = document.getElementById("rows") as HTMLDivElement;
      const emptyEl = document.getElementById("empty") as HTMLParagraphElement;
      const labelEl = document.getElementById("d-label") as HTMLDivElement;
      const statsEl = document.getElementById("d-stats") as HTMLDivElement;

      function badge(r: Resa): string {
        // Sempre cliccabile: apre il menu con tutti gli stati
        if (r.status === "cancelled") return '<button class="r-badge ko" data-act="status">Annulée</button>';
        if (r.status === "noshow") return '<button class="r-badge ns" data-act="status">No-show</button>';
        if (r.status === "done") return '<button class="r-badge gr" data-act="status">Fini</button>';
        // Confermata: lo stato segue l'orologio
        const f = fase(r);
        if (f === "encours") return '<button class="r-badge bl" data-act="status">En cours</button>';
        if (f === "passe") return '<button class="b-fini" data-act="status">Fini ?</button>';
        return '<button class="r-badge ok" data-act="status">Confirmée</button>';
      }

      function tagsOpzioni(r: Resa): string {
        const tags: string[] = [];
        if (r.high_chair) tags.push("Chaise bébé");
        if (r.quiet) tags.push("Endroit calme");
        if (r.business && !r.company) tags.push("Business");
        return tags.length
          ? `<span class="r-tags">${tags.map((t) => `<span class="r-tag">${t}</span>`).join("")}</span>`
          : "";
      }

      function riga(r: Resa): string {
        const off = r.status === "cancelled" ? " is-off" : "";
        const tel = esc(r.phone);
        const mail = esc(r.email);
        const parti: string[] = [];
        if (tel) parti.push(`<span class="r-c">${ICO_TEL}<a href="tel:${tel.replace(/\s/g, "")}">${tel}</a></span>`);
        if (mail) parti.push(`<span class="r-c">${ICO_MAIL}<a href="mailto:${mail}">${mail}</a></span>`);
        if (r.business && r.company) parti.push(`<span class="r-c">${ICO_BIZ}<span>${esc(r.company)}</span></span>`);
        const contatti = parti.join("");
        const cestino =
          r.status === "confirmed"
            ? `<button class="i-btn b-annule" data-act="cancel" title="Annuler">${ICO_TRASH}</button>`
            : "";
        const matita =
          r.status === "confirmed"
            ? `<button class="i-btn b-edit" data-act="edit" title="Modifier">${ICO_EDIT}</button>`
            : "";
        return `
          <div class="res${off}${r.notes ? "" : " no-note"}" data-id="${r.id}">
            <div class="r-time">
              <div class="r-heure">${esc(r.heure)}</div>
              ${modoRicerca ? `<div class="r-date">${dataFr(r.date)}</div>` : ""}
              ${
                r.source && ICO_SRC[r.source]
                  ? `<div class="r-time-src" title="${SRC_TITRE[r.source] ?? ""}">${ICO_SRC[r.source]}</div>`
                  : ""
              }
            </div>
            <div class="r-main">
              <div class="r-name">${esc(`${r.first_name} ${r.last_name}`.trim()) || "—"}${tagsOpzioni(r)}</div>
              ${contatti ? `<div class="r-sub">${contatti}</div>` : ""}
            </div>
            <div class="r-note-col">${r.notes ? `<svg class="r-note-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg><span>${esc(r.notes)}</span>` : ""}</div>
            <div class="r-zone">${esc(r.zone ?? "")}</div>
            <div class="r-pers"><b>${r.people}</b><span>pers.</span></div>
            <span class="r-state-col">${badge(r)}</span>
            <span class="r-del">${matita}${cestino}</span>
          </div>`;
      }

      const ICO_TUTTI =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>';
      function renderFiltroServ() {
        const box = document.getElementById("f-serv") as HTMLDivElement;
        const servizi = (nmCfg.services ?? []).filter((sv) => SERVIZI_WIDGET[sv.key]);
        if (servizi.length < 2) {
          box.innerHTML = "";
          filtroServ = "";
          return;
        }
        if (filtroServ && !servizi.some((sv) => sv.key === filtroServ)) filtroServ = "";
        box.innerHTML =
          `<button type="button" class="fs-pill${filtroServ === "" ? " is-on" : ""}" data-k="" title="Tous les services">${ICO_TUTTI}</button>` +
          servizi
            .map(
              (sv) =>
                `<button type="button" class="fs-pill${filtroServ === sv.key ? " is-on" : ""}" data-k="${sv.key}">${esc(SERVIZI_WIDGET[sv.key]?.fr ?? sv.key)}</button>`
            )
            .join("");
      }

      function render() {
        const filtrate = rese.filter((r) => !filtroServ || r.service_key === filtroServ);
        if (modoRicerca) {
          labelEl.textContent = `Recherche — ${filtrate.length} résultat${filtrate.length === 1 ? "" : "s"}`;
          labelEl.classList.remove("is-today");
          statsEl.innerHTML = "";
        } else {
          labelEl.textContent = labelGiorno(giorno);
          labelEl.classList.toggle("is-today", giorno === isoOggi());
          const attive = filtrate.filter((r) => r.status === "confirmed");
          const couverts = attive.reduce((s, r) => s + r.people, 0);
          statsEl.innerHTML = filtrate.length
            ? `<b>${couverts}</b> couverts · ${attive.length} résa${attive.length > 1 ? "s" : ""}`
            : "";
        }
        if (!filtrate.length) {
          rowsEl.style.display = "none";
          emptyEl.style.display = "";
          return;
        }
        emptyEl.style.display = "none";
        rowsEl.style.display = "";
        const perOra = (a: Resa, b: Resa) =>
          modoRicerca && a.date !== b.date
            ? a.date < b.date
              ? 1
              : -1
            : a.heure < b.heure
              ? -1
              : a.heure > b.heure
                ? 1
                : 0;
        const inCorso = filtrate.filter((r) => r.status === "confirmed").sort(perOra);
        const chiuse = filtrate.filter((r) => r.status !== "confirmed").sort(perOra);
        rowsEl.innerHTML =
          inCorso.map(riga).join("") +
          (chiuse.length
            ? `<div class="r-closed-head">Terminées &amp; annulées</div><div class="r-closed">${chiuse.map(riga).join("")}</div>`
            : "");
