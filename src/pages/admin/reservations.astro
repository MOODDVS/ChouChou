        // ---- Ricerca prenotazioni (nome / email / telefono) ----
        const dSearch = document.getElementById("d-search") as HTMLInputElement;
        let searchTimer = 0;
        async function cercaRese(q: string) {
          stateEl.style.display = "";
          stateEl.textContent = tr("res.searching");
          rowsEl.style.display = "none";
          emptyEl.style.display = "none";
          try {
            const res = await fetch("/api/admin/reservations?q=" + encodeURIComponent(q), { headers });
            if (!res.ok) throw new Error();
            const j = (await res.json()) as { reservations?: Resa[] };
            if (vista !== "jour") vaiVista("jour");
            modoRicerca = true;
            rese = j.reservations ?? [];
            stateEl.style.display = "none";
            emptyEl.textContent = tr("res.noneFound");
            render();
          } catch {
            stateEl.textContent = tr("res.searchError");
          }
        }
        const dSearchX = document.getElementById("d-search-x") as HTMLButtonElement;
        dSearchX.addEventListener("click", () => {
          dSearch.value = "";
          dSearchX.style.display = "none";
          window.clearTimeout(searchTimer);
          if (modoRicerca) void carica();
          dSearch.focus();
        });
        dSearch.addEventListener("input", () => {
          dSearchX.style.display = dSearch.value ? "" : "none";
          window.clearTimeout(searchTimer);
          searchTimer = window.setTimeout(() => {
            const q = dSearch.value.trim();
            if (q.length < 2) {
              if (modoRicerca) void carica();
              return;
            }
            void cercaRese(q);
          }, 300);
        });

        // ---- Prenotazione manuale (walk-in / telefono), stile widget ----
        const mOverlay = document.getElementById("m-overlay") as HTMLDivElement;
        const mMsg = document.getElementById("m-msg") as HTMLSpanElement;
        const mSave = document.getElementById("m-save") as HTMLButtonElement;
        const campo = (id: string) => document.getElementById(id) as HTMLInputElement;
        function fmtFr(iso: string): string {
          const [y, m, d] = iso.split("-");
          return `${d}/${m}/${y}`;
        }
        function nmSetData(iso: string) {
          const el = campo("m-date");
