        let cestinoArmato: HTMLElement | null = null;
        let cestinoTimer = 0; // senza conferma entro pochi secondi, torna il cestino
        function disarmaCestino() {
          window.clearTimeout(cestinoTimer);
          if (!cestinoArmato) return;
          cestinoArmato.classList.remove("confirm");
          cestinoArmato.innerHTML = ICO_TRASH;
          cestinoArmato = null;
        }
        // ---- Modale dettagli (click sulla card) con timer live ----
        const dtOverlay = document.getElementById("dt-overlay") as HTMLDivElement;
        let dtTimerInt = 0;
        let dtId = ""; // resa mostrata nel modale (per scartare risposte in ritardo)
        function chiudiDettagli() {
          dtOverlay.classList.remove("is-open");
          if (dtTimerInt) {
            clearInterval(dtTimerInt);
            dtTimerInt = 0;
          }
        }
        function hhmmDa(min: number): string {
          return `${String(Math.floor(min / 60) % 24).padStart(2, "0")}:${String(min % 60).padStart(2, "0")}`;
        }
        function apriDettagli(id: string) {
          const r = rese.find((x) => x.id === id);
          if (!r) return;
          dtId = r.id;
          (document.getElementById("dt-title") as HTMLElement).textContent =
            `${r.first_name} ${r.last_name}`.trim() || tr("res.reservation");

          // Badge di stato (stessi colori del menu stati; confirmed passata l'ora = En cours)
          const stKey = r.status === "confirmed" && fase(r) === "encours" ? "seated" : r.status;
          const st = STATI_MENU.find((x) => x.st === stKey) ?? STATI_MENU.find((x) => x.st === r.status);
          const stHtml = st
            ? `<span class="dt-badge" style="background:${st.colore}">${st.label}</span>`
            : "";
          const enCours = r.status === "seated" || (r.status === "confirmed" && fase(r) === "encours");
          const conBlocco = r.status === "confirmed" || r.status === "seated" || r.status === "done";

          // Dettagli (se c'è il timer, data/ora/service/persone salgono nel blocco)
          const svLbl = SERVIZI_WIDGET[r.service_key ?? ""] ? nomeServizio(r.service_key ?? "", LANG) : "";
          const righe: string[] = [];
          const dett = (k: string, v: string) => righe.push(`<div class="dt-row"><span class="k">${k}</span><span class="v">${v}</span></div>`);
          if (!conBlocco) {
            dett(tr("home.date"), esc(dataFr(r.date)));
            dett(tr("res.hour"), esc(r.heure));
            if (svLbl) dett(tr("res.service"), esc(svLbl));
            dett(tr("res.people"), String(r.people));
          }
          if (!conBlocco && r.zone) dett(tr("res.section"), esc(r.zone));
          if (!conBlocco) {
            const tv = etichettaTavoli(r);
            if (tv) dett(tr("res.tables"), esc(tv));
          }
          const contattiDt: string[] = [];
          if (r.phone)
            contattiDt.push(`<span class="r-c">${ICO_TEL}<a href="tel:${esc(r.phone).replace(/\s/g, "")}">${esc(r.phone)}</a></span>`);
          if (r.email)
            contattiDt.push(`<span class="r-c">${ICO_MAIL}<a href="mailto:${esc(r.email)}">${esc(r.email)}</a></span>`);
          (document.getElementById("dt-contacts") as HTMLElement).innerHTML = contattiDt.join("");
          if (!conBlocco && r.source && SRC_TITRE[r.source]) dett(tr("res.origin"), esc(SRC_TITRE[r.source]));
          const opz: string[] = [];
          if (r.high_chair) opz.push(tr("res.optHighchair"));
          if (r.quiet) opz.push(tr("res.optQuiet"));
          if (r.business) opz.push(tr("res.optBusiness") + (r.company ? ` (${r.company})` : ""));
          if (r.birthday) opz.push(tr("res.optBirthday"));
          if (r.special_event) opz.push(tr("res.optEvent"));
          if (!conBlocco && opz.length) dett(tr("res.options"), esc(opz.join(" · ")));
          (document.getElementById("dt-opts") as HTMLElement).innerHTML = conBlocco
            ? opz.map((o) => `<span class="tag">${esc(o)}</span>`).join("")
            : "";

          (document.getElementById("dt-note") as HTMLElement).innerHTML = r.notes
            ? `<svg class="r-note-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg><span>${esc(r.notes)}</span>`
            : "";
          (document.getElementById("dt-rows") as HTMLElement).innerHTML = righe.join("");

          // Timer live (solo En cours). Ancore in ms calcolate UNA volta partendo
          // dal fuso del ristorante; poi il tick usa solo differenze Date.now().
          if (dtTimerInt) {
            clearInterval(dtTimerInt);
            dtTimerInt = 0;
          }
          const timerBox = document.getElementById("dt-timer") as HTMLDivElement;
          const srcIco =
            r.source && ICO_SRC[r.source]
              ? `<span class="src" title="${esc(SRC_TITRE[r.source] ?? "")}">${ICO_SRC[r.source]}</span>`
              : "";
          (document.getElementById("dt-meta") as HTMLElement).innerHTML = conBlocco
            ? srcIco +
              [dataFr(r.date), r.heure, svLbl, `${r.people} ${tr("res.pers")}`, r.zone]
                .filter(Boolean)
                .map((v) => esc(String(v)))
                .join('<span class="sep">·</span>')
            : "";
          if (enCours) {
            const hold = holdDi(r.service_key);
            const inizioMin = minutiDa(r.heure);
            const arrivoMs = r.status === "seated" && r.seated_at ? Date.parse(r.seated_at) : NaN;
            const startMs = Number.isFinite(arrivoMs)
              ? arrivoMs
              : Date.now() - Math.max(0, minutiOra() - inizioMin) * 60000;
            const fineMs = Date.now() + (inizioMin + hold - minutiOra()) * 60000;
            (document.getElementById("dt-fin") as HTMLElement).textContent =
              `${tr("res.endExpected")} ${hhmmDa(inizioMin + hold)} · ${tr("res.duration")} ${hold} min`;
            const labEc = document.getElementById("dt-tlab") as HTMLElement;
            labEc.style.display = "";
            labEc.textContent = tr("res.seatedSince");
            (document.getElementById("dt-spend") as HTMLElement).style.display = "none";
            (document.getElementById("dt-clock") as HTMLElement).style.display = "";
            (document.getElementById("dt-track") as HTMLElement).style.display = "";
            const clockEl = document.getElementById("dt-clock") as HTMLElement;
            const fillEl = document.getElementById("dt-fill") as HTMLElement;
            const tick = () => {
              const sec = Math.max(0, Math.floor((Date.now() - startMs) / 1000));
              const h = Math.floor(sec / 3600);
              const m = Math.floor((sec % 3600) / 60);
              const ss = sec % 60;
              clockEl.textContent =
                (h > 0 ? `${h}:${String(m).padStart(2, "0")}` : String(m)) + `:${String(ss).padStart(2, "0")}`;
              const pct = Math.max(0, Math.min(100, ((Date.now() - startMs) / Math.max(60000, fineMs - startMs)) * 100));
              fillEl.style.width = `${pct.toFixed(2)}%`;
            };
            tick();
            dtTimerInt = window.setInterval(tick, 1000);
            timerBox.style.display = "";
          } else if (r.status === "done") {
            // Fini: stesso blocco, durata REGISTRATA (table_minutes) al posto del live
            const lab = document.getElementById("dt-tlab") as HTMLElement;
            const clockEl = document.getElementById("dt-clock") as HTMLElement;
            const trackEl = document.getElementById("dt-track") as HTMLElement;
            (document.getElementById("dt-fin") as HTMLElement).textContent = "";
            const tm =
              r.table_minutes != null && r.table_minutes > 0
                ? Math.round(r.table_minutes)
                : holdDi(r.service_key) + 15; // vecchie senza dato: durée prevista + 15 (auto-Fini)
            lab.style.display = "";
            lab.textContent = tr("res.tableTime");
            clockEl.style.display = "";
            clockEl.textContent = tm < 90 ? `${tm} min` : `${Math.floor(tm / 60)} h ${String(tm % 60).padStart(2, "0")}`;
            trackEl.style.display = "";
            (document.getElementById("dt-fill") as HTMLElement).style.width = "100%";
            (document.getElementById("dt-spend") as HTMLElement).style.display = "";
            (document.getElementById("dt-spend-in") as HTMLInputElement).value =
              r.spent_cents != null ? `${(r.spent_cents / 100).toFixed(2).replace(".", ",")} €` : "";
            timerBox.style.display = "";
          } else if (r.status === "confirmed") {
            // Confirmée non ancora iniziata: stesso blocco, timer fermo a zero
            const lab = document.getElementById("dt-tlab") as HTMLElement;
            lab.style.display = "";
            lab.textContent = tr("res.seatedSince");
            const clockEl = document.getElementById("dt-clock") as HTMLElement;
            clockEl.style.display = "";
            clockEl.textContent = "0:00";
            (document.getElementById("dt-track") as HTMLElement).style.display = "";
            (document.getElementById("dt-fill") as HTMLElement).style.width = "0%";
            const holdC = holdDi(r.service_key);
            (document.getElementById("dt-fin") as HTMLElement).textContent =
              `${tr("res.endExpected")} ${hhmmDa(minutiDa(r.heure) + holdC)} · ${tr("res.duration")} ${holdC} min`;
            (document.getElementById("dt-spend") as HTMLElement).style.display = "none";
            timerBox.style.display = "";
          } else {
            timerBox.style.display = "none";
          }
          (document.getElementById("dt-tstatus") as HTMLElement).innerHTML = conBlocco ? stHtml : "";
          (document.getElementById("dt-status") as HTMLElement).innerHTML = conBlocco ? "" : stHtml;

          // Statistiche cliente (async, arrivano dopo l'apertura)
          const statsBox = document.getElementById("dt-stats") as HTMLDivElement;
          statsBox.innerHTML = "";
          if (r.email || r.phone) {
            const qs = new URLSearchParams({ client_stats: "1" });
            if (r.email) qs.set("client_email", r.email);
            if (r.phone) qs.set("client_phone", r.phone);
            const mioId = r.id;
            fetch(`/api/admin/reservations?${qs.toString()}`, { headers })
              .then(async (res) => {
                if (!res.ok || dtId !== mioId) return;
                const j = (await res.json()) as {
                  total: number; visites: number; noshows: number; cancelled: number;
                  avg_people: number | null; avg_lead_min: number | null;
                  avg_table_min: number | null; avg_spent_cents: number | null;
                };
                if (j.total <= 1 && j.visites <= 1 && !j.noshows && !j.cancelled) {
                  (document.getElementById("dt-title") as HTMLElement).insertAdjacentHTML(
                    "beforeend",
                    `<span class="dt-new">${tr("res.new")}</span>`
                  );
                }
                const fmtMin = (m: number): string =>
                  m < 90 ? `${Math.max(1, Math.round(m))} min` : `${Math.floor(m / 60)} h ${String(Math.round(m) % 60).padStart(2, "0")}`;
                const righeSt: string[] = [];
                const rigaSt = (k: string, v: string) =>
                  righeSt.push(`<div class="dt-row"><span class="k">${k}</span><span class="v">${v}</span></div>`);
                rigaSt(tr("nav.reservations"), `<b>${j.total}</b>`);
                rigaSt(tr("res.cancellations"), `<b>${j.cancelled}</b>`);
                rigaSt(tr("res.stNoshow"), j.noshows > 0 ? `<b style="color:#ff8a8f">${j.noshows}</b>` : `<b>0</b>`);
                if (j.avg_table_min != null) rigaSt(tr("res.tableTimeAvg"), `<b>~${fmtMin(j.avg_table_min)}</b>`);
                if (j.avg_people != null) {
                  const m = Math.round(j.avg_people * 10) / 10;
                  rigaSt(tr("res.peopleAvg"), `<b>${String(m).replace(".", ",")}</b>`);
                }
                if (j.avg_lead_min != null) {
                  const min = j.avg_lead_min;
                  const lbl =
                    min < 90
                      ? `${Math.max(1, Math.round(min))} min`
                      : min < 2880
                        ? `${Math.round(min / 60)} h`
                        : `${Math.round(min / 1440)} j`;
                  rigaSt(tr("res.bookInAdvance"), `<b>~${lbl}</b>`);
                }
                if (j.avg_spent_cents != null) {
                  const eur = (j.avg_spent_cents / 100).toFixed(j.avg_spent_cents % 100 ? 2 : 0).replace(".", ",");
                  rigaSt(tr("res.spendAvg"), `<b>~${eur} €</b>`);
                }
                if (dtId === mioId) statsBox.innerHTML = righeSt.join("");
              })
              .catch(() => { /* niente stats: il modale resta utilizzabile */ });
          }

          dtOverlay.classList.add("is-open");
        }
        (document.getElementById("dt-spend-save") as HTMLButtonElement).addEventListener("click", async () => {
          const r = rese.find((x) => x.id === dtId);
          if (!r) return;
          const grezzo = (document.getElementById("dt-spend-in") as HTMLInputElement).value
            .trim()
            .replace(/[€\s]/g, "")
            .replace(",", ".");
          let cents: number | null = null;
          if (grezzo !== "") {
            const n = Number(grezzo);
            if (!Number.isFinite(n) || n < 0 || n > 100000) {
              toast(tr("res.invalidAmount"), "err");
              return;
            }
            cents = Math.round(n * 100);
          }
          try {
            const res = await fetch("/api/admin/reservations", {
              method: "PATCH",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id: dtId, spent_cents: cents }),
            });
            if (!res.ok) throw new Error();
            r.spent_cents = cents;
            toast(tr("res.billSaved"));
          } catch {
