        let nmChaise = false;
        let nmCalme = false;
        let nmBiz = false;
        let nmAnniv = false;
        let nmEvent = false;
        function nmRenderOpts() {
          (document.getElementById("m-opt-chaise") as HTMLButtonElement).classList.toggle("is-on", nmChaise);
          (document.getElementById("m-opt-calme") as HTMLButtonElement).classList.toggle("is-on", nmCalme);
          (document.getElementById("m-opt-biz") as HTMLButtonElement).classList.toggle("is-on", nmBiz);
          (document.getElementById("m-opt-anniv") as HTMLButtonElement).classList.toggle("is-on", nmAnniv);
          (document.getElementById("m-opt-event") as HTMLButtonElement).classList.toggle("is-on", nmEvent);
          (document.getElementById("m-soc-row") as HTMLDivElement).style.display = nmBiz ? "" : "none";
        }
        (document.getElementById("m-opt-chaise") as HTMLButtonElement).addEventListener("click", () => {
          nmChaise = !nmChaise;
          nmRenderOpts();
        });
        (document.getElementById("m-opt-calme") as HTMLButtonElement).addEventListener("click", () => {
          nmCalme = !nmCalme;
          nmRenderOpts();
        });
        (document.getElementById("m-opt-biz") as HTMLButtonElement).addEventListener("click", () => {
          nmBiz = !nmBiz;
          nmRenderOpts();
        });
        (document.getElementById("m-opt-anniv") as HTMLButtonElement).addEventListener("click", () => {
          nmAnniv = !nmAnniv;
          nmRenderOpts();
        });
        (document.getElementById("m-opt-event") as HTMLButtonElement).addEventListener("click", () => {
          nmEvent = !nmEvent;
          nmRenderOpts();
        });

        let nmServIdx = 0;
        let nmServKey = ""; // key del service attivo (tab visibili = servizi filtrati)
        let nmServPref = ""; // key da riselezionare all'apertura (modalità edit)
        let nmEditId: string | null = null; // id della prenotazione in modifica
        let nmSrcEditable = true; // il tipo walk-in/téléphone è modificabile
        let nmEspanso = false; // orari: mostra oltre le prime 3 righe
        let nmHeure = "";
        let nmPers = 2;

        // Plan de salle: max persone "insieme" per sezione (tavolo singolo più
        // grande o catena di liaison più capiente). null = plan mode spento.
        let planMax: Map<string, number> | null = null;
        let planTavoli: { id: string; zone: string; name: string; seats: number }[] = [];
        let planAuto = true;    // reservation_auto_tables ("0" = attribuzione manuale)
        let planModeOn = false; // reservation_plan_mode
        let nmTavSel = new Set<string>(); // tavoli scelti a mano nel modale
        async function caricaPlanMax() {
          try {
            const r = await fetch("/api/admin/tables", { headers });
            if (!r.ok) return;
            const j = await r.json();
            const tutti = (j.tables ?? []) as { id: string; name: string; zone: string; seats: number }[];
            planNomi = new Map(tutti.map((t) => [String(t.id), String(t.name ?? "")]));
            planZoneTav = new Map(tutti.map((t) => [String(t.id), String(t.zone ?? "")]));
            planTavoli = tutti.map((t) => ({ id: String(t.id), zone: String(t.zone ?? "").trim(), name: String(t.name ?? ""), seats: Math.floor(Number(t.seats)) || 0 }));
            planAuto = j.auto_tables !== false;
            planModeOn = !!j.plan_mode;
            znPrio = Array.isArray(j.priority) ? (j.priority as unknown[]).map(String) : [];
            if (!j.plan_mode) { planMax = null; return; }
            const tavoli = (j.tables ?? []) as { id: string; zone: string; seats: number }[];
            const postiId = new Map(tavoli.map((t) => [t.id, Math.floor(Number(t.seats)) || 0]));
            const m = new Map<string, number>();
            for (const t of tavoli) {
              const z = String(t.zone ?? "").trim();
              if (z) m.set(z, Math.max(m.get(z) ?? 0, Math.floor(Number(t.seats)) || 0));
            }
            const legami = (j.links ?? {}) as Record<string, string[][]>;
            for (const [z, gruppi] of Object.entries(legami)) {
              if (!Array.isArray(gruppi)) continue;
              for (const g of gruppi) {
                if (!Array.isArray(g)) continue;
                const somma = g.reduce((t, id) => t + (postiId.get(String(id)) ?? 0), 0);
                m.set(z, Math.max(m.get(z) ?? 0, somma));
              }
            }
            planMax = planAuto ? m : null; // manuale: niente avvisi combinazione
          } catch { planMax = null; }
          // Nomi arrivati dopo il primo render della lista: etichette tavoli
          try { render(); } catch { /* lista non ancora pronta */ }
        }
        void caricaPlanMax();

        let nmMsgResto = "";
        function nmAggiornaAvviso() {
          const el = document.getElementById("nm-warn") as HTMLElement | null;
          if (!el) return;
          const msg: string[] = [];
          if (planMax && planMax.size > 0) {
            let max = 0;
            if (nmZone) max = planMax.get(nmZone) ?? 0;
            else for (const val of planMax.values()) max = Math.max(max, val);
            if (max > 0 && nmPers > max) {
              msg.push(`⚠ ${tr("res.noTableCombo")} ${nmPers} ${tr("res.pers")}${nmZone ? ` ${tr("res.inZone")} ${nmZone}` : ""} (max ${max} ${tr("res.together")}) — ${tr("res.canStillSave")}.`);
            }
          }
          if (nmMsgResto) msg.push(nmMsgResto);
          if (msg.length) {
            el.innerHTML = msg.map((m) => m.replace(/&/g, "&amp;").replace(/</g, "&lt;")).join("<br />");
            el.style.display = "";
          } else {
            el.style.display = "none";
          }
        }
        let nmZone = "";

        function nmServizi(): { key: string; label: string; da: number; a: number; hold: number; slot: number; days: number[] }[] {
          const daCfg = (nmCfg.services ?? [])
            .map((sv) => ({
              key: sv.key,
              label: nomeServizio(sv.key, LANG),
              da: minutiDa(sv.from),
              a: minutiDa(sv.to),
              hold: holdDi(sv.key),
              slot: (() => {
                const n = Math.floor(Number(sv.slot));
                return Number.isFinite(n) && n >= 10 && n <= 120 ? n : nmCfg.slot_minutes || 30;
              })(),
              days: Array.isArray(sv.days) ? sv.days : [],
            }))
            .filter((sv) => sv.da >= 0 && sv.a > sv.da);
          return daCfg.length
            ? daCfg
            : [
                { key: "midi", label: "Midi", da: 12 * 60, a: 14 * 60, hold: holdMinutes, slot: nmCfg.slot_minutes || 30, days: [] },
                { key: "soir", label: "Soir", da: 18 * 60, a: 21 * 60 + 30, hold: holdMinutes, slot: nmCfg.slot_minutes || 30, days: [] },
              ];
        }
        /** Il service è attivo quel giorno della settimana? (days vuoto = tutti). */
        function nmServeGiorno(sv: { days: number[] }, iso: string): boolean {
          if (!sv.days || sv.days.length === 0) return true;
          return sv.days.includes(new Date(iso + "T12:00:00").getDay());
        }
        function slotHHMM(min: number): string {
          return `${String(Math.floor(min / 60)).padStart(2, "0")}:${String(min % 60).padStart(2, "0")}`;
        }

        function nmRenderGiorni() {
          const v = campo("m-date").dataset.iso ?? "";
          (document.getElementById("nm-auj") as HTMLButtonElement).classList.toggle("is-on", v === isoOggi());
          (document.getElementById("nm-dem") as HTMLButtonElement).classList.toggle("is-on", v === isoPiuGiorni(isoOggi(), 1));
        }

        function nmRenderOre() {
          nmAggiornaAvviso();
          // Oggi: si mostrano solo gli orari non ancora passati (fuso del
          // ristorante); lo slot in corso resta selezionabile per i walk-in.
          // Ogni service usa il SUO créneau e la SUA durée d'occupation.
          const selIso = campo("m-date").dataset.iso ?? "";
          const oggiSel = selIso === isoOggi() && !nmEditId;
          const datiGiorno = nmReseDel(selIso);
          const spOpen = datiGiorno?.spOpen ?? false;
          const spServ = spOpen ? (datiGiorno?.spServ ?? null) : null;
          const servizi = nmServizi()
            // Service attivo quel giorno della settimana (jour spécial ouvert = tutti)
            .filter((sv) => (spOpen ? svAttivoSp(sv, spServ) : nmServeGiorno(sv, selIso)))
            .map((sv) => {
              const soglia = oggiSel ? minutiOra() - sv.slot : -1;
              const slots: string[] = [];
              for (let m = sv.da; m <= sv.a; m += sv.slot) if (m >= soglia) slots.push(slotHHMM(m));
              return { ...sv, slots };
            })
            .filter((sv) => sv.slots.length > 0);
          if (nmServPref) {
            const i = servizi.findIndex((sv) => sv.key === nmServPref);
            if (i >= 0) nmServIdx = i;
            nmServPref = "";
          }
          if (nmServIdx >= servizi.length) nmServIdx = 0;
          const stabs = document.getElementById("nm-stabs") as HTMLDivElement;
          stabs.style.display = servizi.length > 1 ? "" : "none";
          const svChiusiGiorno = (datiGiorno?.svCh ?? []).map((c) => c.service_key);
          const ICO_SV_CHIUSO =
            '<svg class="nm-tab-closed" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><line x1="5.8" y1="5.8" x2="18.2" y2="18.2" /></svg>';
          stabs.innerHTML = servizi
            .map((sv, i) => {
              const chiuso = svChiusiGiorno.includes(sv.key);
              return `<button type="button" class="nm-pill${i === nmServIdx ? " is-on" : ""}" data-i="${i}"${chiuso ? ` title="${tr("res.closedPublicDay")}"` : ""}>${esc(sv.label)}${chiuso ? ICO_SV_CHIUSO : ""}</button>`;
            })
            .join("");
          // Con un solo service ma chiuso, i tab restano visibili (per l'icona)
          if (svChiusiGiorno.some((k) => servizi.some((sv) => sv.key === k))) stabs.style.display = "";
          // Banner sotto i tab quando il service ATTIVO è chiuso al pubblico
          const chSv = (datiGiorno?.svCh ?? []).find((c) => c.service_key === (servizi[nmServIdx]?.key ?? ""));
          const noteEl = document.getElementById("nm-closed-note") as HTMLDivElement;
          if (chSv) {
            noteEl.style.display = "";
            noteEl.textContent = `${tr("res.serviceClosedPublic")} — ${RAGIONE_FR[chSv.reason] ?? chSv.reason}. ${tr("res.widgetNoBookings")}`;
          } else {
            noteEl.style.display = "none";
          }
          const att = servizi[nmServIdx];
          nmServKey = att?.key ?? "";
          if (nmHeure && !att?.slots.includes(nmHeure)) nmHeure = "";
          // Orari pieni: occupazione (prenotazioni che si sovrappongono allo
          // slot per la durata del tavolo) + persone scelte > capienza sala
          const reseGiorno = datiGiorno?.rese ?? [];
          const zoneCh = datiGiorno?.zoneCh ?? [];
          // Capienza del giorno: senza i coperti delle sections chiuse
          const capienza =
            (nmCfg.capacity ?? 0) -
            zoneCh.reduce((t, c) => t + (nmCfg.zone_seats?.[c.zone] ?? 0), 0);
          const zonaChiusa = nmZone !== "" && zoneCh.some((c) => c.zone === nmZone);
          // Con una section scelta vale anche il SUO limite: le prenotazioni
          // "Indifférent" contano solo sul totale (le piazza il ristoratore)
          const postiZona = nmZone ? (nmCfg.zone_seats?.[nmZone] ?? 0) : 0;
          const holdNuovo = att?.hold ?? holdMinutes; // durée del service attivo
          const occPerZona = (sMin: number): Map<string, number> => {
            const m = new Map<string, number>();
            for (const rr of reseGiorno) {
              if (nmEditId && rr.id === nmEditId) continue;
              const rMin = minutiDa(rr.heure);
              const rHold = holdDi(rr.service_key);
              if (rMin < sMin + holdNuovo && rMin + rHold > sMin) {
                const rz = (rr.zone ?? "").trim();
                if (rz) m.set(rz, (m.get(rz) ?? 0) + rr.people);
              }
            }
            return m;
          };
          const slotPieno = (hh: string): boolean => {
            if (zonaChiusa) return true; // section fermée quel giorno: tutto ✕ (bypass possibile)
            // Tutte le sections chiuse: nessun coperto disponibile quel giorno
            if ((nmCfg.capacity ?? 0) > 0 && capienza <= 0) return true;
            if (capienza <= 0) return false;
            const sMin = minutiDa(hh);
            let occTot = 0;
            let occZona = 0;
            for (const rr of reseGiorno) {
              if (nmEditId && rr.id === nmEditId) continue; // in edit non conta sé stessa
              const rMin = minutiDa(rr.heure);
              const rHold = holdDi(rr.service_key); // durée del service della prenotazione
              if (rMin < sMin + holdNuovo && rMin + rHold > sMin) {
                occTot += rr.people;
                if (nmZone && (rr.zone ?? "") === nmZone) occZona += rr.people;
              }
            }
            if (occTot + nmPers > capienza) return true;
            if (postiZona > 0 && occZona + nmPers > postiZona) return true;
            if (!nmZone && (nmCfg.zones ?? []).length > 0) {
              const okz = (nmCfg.zones ?? []).some(
                (z) => !zoneCh.some((c) => c.zone === z) && (occPerZona(sMin).get(z) ?? 0) + nmPers <= (nmCfg.zone_seats?.[z] ?? 0)
              );
              if (!okz) return true;
            }
            return false;
          };
          const LIMITE = 12; // 3 righe da 4 colonne
          const tutti = att ? att.slots : [];
          const visibili = nmEspanso ? tutti : tutti.slice(0, LIMITE);
          let html = visibili
            .map((hh) => {
              const pieno = slotPieno(hh);
              return `<button type="button" class="nm-slot${pieno ? " nm-slot-full" : ""}${hh === nmHeure ? " is-on" : ""}" data-h="${hh}"${pieno ? ` title="${tr("res.full")}"` : ""}>${hh}</button>`;
            })
            .join("");
          if (tutti.length > LIMITE) {
            html += `<button type="button" class="nm-more">${nmEspanso ? tr("res.showLess") : tr("res.showAll")}<svg class="nm-more-ico${nmEspanso ? " is-up" : ""}" viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg></button>`;
          }
          if (!att) html = `<p class="nm-noslot">${tr("res.noHourAvail")}</p>`;
          (document.getElementById("nm-slots") as HTMLDivElement).innerHTML = html;

          // Posti RESTANTI all'ora scelta: se nessuna section può ospitare
          // l'intera tavolata → avviso (l'admin può comunque registrare)
          nmMsgResto = "";
          if (nmHeure && capienza > 0) {
            const occ = occPerZona(minutiDa(nmHeure));
            const zoneAperte = (nmCfg.zones ?? []).filter((z) => !zoneCh.some((c) => c.zone === z));
            const resto = (z: string) => Math.max(0, (nmCfg.zone_seats?.[z] ?? 0) - (occ.get(z) ?? 0));
            const ok = nmZone
              ? zoneAperte.includes(nmZone) && resto(nmZone) >= nmPers
              : zoneAperte.some((z) => resto(z) >= nmPers);
            if (!ok && zoneAperte.length > 0) {
              const dett = zoneAperte.map((z) => `${z} : ${resto(z)}`).join(" · ");
              nmMsgResto = `⚠ ${tr("res.notEnoughPlaces")} ${nmPers} ${tr("res.pers")} ${tr("home.at")} ${nmHeure}${nmZone ? ` ${tr("res.inZone")} ${nmZone}` : ""} (${tr("res.remaining")} — ${dett}). ${tr("res.canStillSaveCap")}.`;
            }
          }
          nmAggiornaAvviso();
          void nmAggiornaTavoli();
        }

        // Plan de salle: quali tavoli riceverebbe la prenotazione (anteprima
        // live dal server, stesso algoritmo del salvataggio). Contatore per
        // scartare le risposte arrivate fuori ordine.
        let nmTavSeq = 0;
        async function nmAggiornaTavoli() {
          const el = document.getElementById("nm-tables") as HTMLElement | null;
          if (!el) return;
          // Attribuzione MANUALE: chips dei tavoli al posto dell'anteprima
          if (planModeOn && !planAuto) {
            nmRenderTavoliManuali();
            return;
          }
          el.classList.remove("nm-tables-man");
          const date = campo("m-date").dataset.iso ?? "";
          if (!planMax || planMax.size === 0 || !nmHeure || !date) {
            el.style.display = "none";
            return;
          }
          const seq = ++nmTavSeq;
          try {
            const par = new URLSearchParams({ assign: "1", date, heure: nmHeure, people: String(nmPers) });
            if (nmZone) par.set("zone", nmZone);
            if (nmServKey) par.set("service", nmServKey);
            if (nmEditId) par.set("exclude", nmEditId);
            const r = await fetch(`/api/admin/tables?${par}`, { headers });
            if (seq !== nmTavSeq) return; // nel frattempo è cambiato qualcosa
            if (!r.ok) { el.style.display = "none"; return; }
            const j = await r.json();
            const p = j.proposal as { names: string[]; zone: string } | null;
            if (p && Array.isArray(p.names) && p.names.length) {
              const nomi = p.names.map((n) => String(n).replace(/&/g, "&amp;").replace(/</g, "&lt;")).join(" + ");
              const z = String(p.zone ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;");
              el.innerHTML = `${tr("res.tablesAssigned")} <b>${nomi}</b>${z ? ` · ${z}` : ""}`;
              el.style.display = "";
            } else {
              el.innerHTML = tr("res.noFreeTable");
              el.style.display = "";
            }
          } catch {
            if (seq === nmTavSeq) el.style.display = "none";
          }
        }

        // ---- Attribuzione MANUALE dei tavoli (reservation_auto_tables = "0") ----
        // Tavoli occupati nella finestra dell'ora scelta (stesse regole hold)
        function nmTavoliOccupati(): Set<string> {
          const occ = new Set<string>();
          const selIso = campo("m-date").dataset.iso ?? "";
          const dati = nmReseDel(selIso);
          if (!dati || !nmHeure) return occ;
          const sMin = minutiDa(nmHeure);
          const holdNuovo = holdDi(nmServKey || null);
          for (const rr of dati.rese) {
            if (nmEditId && rr.id === nmEditId) continue;
            const rMin = minutiDa(rr.heure);
            const rHold = holdDi(rr.service_key);
            if (rMin < sMin + holdNuovo && rMin + rHold > sMin && Array.isArray(rr.tables)) {
              for (const idT of rr.tables) occ.add(String(idT));
            }
          }
          return occ;
        }
        function nmRenderTavoliManuali() {
          const el = document.getElementById("nm-tables") as HTMLElement | null;
          if (!el) return;
          const visibili = planTavoli.filter((t) => !nmZone || t.zone === nmZone);
          if (!visibili.length || !nmHeure) { el.style.display = "none"; return; }
          const occ = nmTavoliOccupati();
          for (const idT of [...nmTavSel]) if (occ.has(idT)) nmTavSel.delete(idT);
          const perZona = new Map<string, typeof visibili>();
          for (const t of visibili) {
            if (!perZona.has(t.zone)) perZona.set(t.zone, []);
            perZona.get(t.zone)!.push(t);
          }
          let html = `<span class="nm-tv-lab">${tr("res.tablesLabel")}</span>`;
          for (const [z, lista] of perZona) {
            if (perZona.size > 1) html += `<span class="nm-tv-z">${esc(z)}</span>`;
            html += lista
              .map((t) => {
                const busy = occ.has(t.id);
                const on = nmTavSel.has(t.id);
                return `<button type="button" class="nm-tv${on ? " is-on" : ""}${busy ? " is-busy" : ""}" data-tv="${t.id}"${busy ? " disabled" : ""}>${esc(t.name)} · ${t.seats}</button>`;
              })
              .join("");
          }
          if (nmTavSel.size) {
            const posti = [...nmTavSel].reduce((tot, idT) => tot + (planTavoli.find((t) => t.id === idT)?.seats ?? 0), 0);
            html += `<span class="nm-tv-tot">${posti} ${tr("res.placesShort")} ${tr("res.for")} ${nmPers}</span>`;
          }
          el.classList.add("nm-tables-man");
          el.innerHTML = html;
          el.style.display = "";
        }
        (document.getElementById("nm-tables") as HTMLElement).addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".nm-tv[data-tv]") as HTMLButtonElement | null;
          if (!b || b.disabled) return;
          const idT = b.dataset.tv ?? "";
          if (nmTavSel.has(idT)) nmTavSel.delete(idT);
          else nmTavSel.add(idT);
          nmRenderTavoliManuali();
        });

        function nmRenderPers() {
          const box = document.getElementById("nm-pers") as HTMLDivElement;
          let html = "";
          for (let n = 1; n <= 8; n++) {
            html += `<button type="button" class="nm-p${nmPers === n ? " is-on" : ""}" data-n="${n}">${n}</button>`;
          }
          // Oltre 8: bottone "−", input numero, bottone "+"
          html +=
            `<span class="nm-step${nmPers > 8 ? " is-on" : ""}">` +
            `<button type="button" class="nm-p-meno" id="nm-p-meno" aria-label="${tr("res.removePerson")}">−</button>` +
            `<input type="number" min="1" max="100" class="nm-p nm-p-libre" id="nm-p-libre" placeholder="9+" value="${nmPers > 8 ? nmPers : ""}" />` +
            `<button type="button" class="nm-p-piu" id="nm-p-piu" aria-label="${tr("res.addPerson")}">+</button>` +
            `</span>`;
          box.innerHTML = html;
          (document.getElementById("nm-p-libre") as HTMLInputElement).addEventListener("input", (e) => {
            const n = Math.floor(Number((e.target as HTMLInputElement).value));
            if (Number.isFinite(n) && n >= 1) {
              nmPers = Math.min(n, 100);
              box.querySelectorAll(".nm-p[data-n]").forEach((el) => el.classList.remove("is-on"));
              (e.target as HTMLInputElement).closest(".nm-step")?.classList.add("is-on");
              nmRenderOre();
            }
          });
          (document.getElementById("nm-p-piu") as HTMLButtonElement).addEventListener("click", () => {
            nmPers = Math.min(nmPers >= 9 ? nmPers + 1 : 9, 100);
            nmRenderPers();
            nmRenderOre();
          });
          (document.getElementById("nm-p-meno") as HTMLButtonElement).addEventListener("click", () => {
            if (nmPers > 1) nmPers -= 1;
            nmRenderPers();
            nmRenderOre();
          });
        }

        function nmRenderZone() {
          const zone = nmCfg.zones ?? [];
          const lab = document.getElementById("nm-zone-lab") as HTMLElement;
          const box = document.getElementById("nm-zones") as HTMLDivElement;
          if (!zone.length) {
            lab.style.display = "none";
            box.style.display = "none";
            return;
          }
          lab.style.display = "";
          box.style.display = "";
          box.innerHTML =
            `<button type="button" class="nm-zone${nmZone === "" ? " is-on" : ""}" data-z="">${tr("res.any")}</button>` +
            zone
              .map((z) => `<button type="button" class="nm-zone${nmZone === z ? " is-on" : ""}" data-z="${esc(z)}">${esc(z)}</button>`)
              .join("");
        }

        function apriModale(resa?: Resa) {
          nmEditId = resa?.id ?? null;
          nmReseCache.clear();
          nmReseFetching = "";
          // Pre-scalda i dati di domani (chiusure/occupazione già pronti al click su "Demain")
          setTimeout(() => nmReseDel(isoPiuGiorni(isoOggi(), 1)), 0);
          // Il tipo si può cambiare solo per le prenotazioni gestite a mano
          nmSrcEditable = !resa || !resa.source || resa.source === "walkin" || resa.source === "phone";
          (document.getElementById("nm-type-lab") as HTMLElement).style.display = nmSrcEditable ? "" : "none";
          (document.getElementById("nm-type-row") as HTMLElement).style.display = nmSrcEditable ? "" : "none";
          dpCache.clear();
          nmHeure = resa ? resa.heure.slice(0, 5) : "";
          nmServIdx = 0;
          nmServPref = resa?.service_key ?? "";
          nmEspanso = false;
          nmPers = resa?.people ?? 2;
          nmTavSel = new Set((resa?.tables ?? []).map(String));
          nmTipo = resa?.source === "phone" ? "phone" : "walkin";
          nmRenderTipo();
          nmChaise = resa?.high_chair ?? false;
          nmCalme = resa?.quiet ?? false;
          nmBiz = resa?.business ?? false;
          nmAnniv = resa?.birthday ?? false;
          nmEvent = resa?.special_event ?? false;
          (document.getElementById("m-societe") as HTMLInputElement).value = resa?.company ?? "";
          nmRenderOpts();
          nmZone = resa?.zone ?? "";
          campo("m-fname").value = resa?.first_name ?? "";
          campo("m-lname").value = resa?.last_name ?? "";
          campo("m-tel").value = "";
          mPrefix.value = PREFISSO_DEFAULT;
          if (resa?.phone) {
            const sep = separaPrefisso(resa.phone);
            if (sep) {
              mPrefix.value = sep.dial;
              campo("m-tel").value = sep.resto;
            } else {
              campo("m-tel").value = resa.phone;
            }
          }
          campo("m-email").value = resa?.email ?? "";
          (document.getElementById("m-notes") as HTMLTextAreaElement).value = resa?.notes ?? "";
          mMsg.textContent = "";
          (document.getElementById("m-title") as HTMLElement).textContent = resa
            ? tr("res.editReservation")
            : tr("res.newReservation");
          mSave.textContent = resa ? tr("common.save") : tr("common.add");
          nmSetData(resa?.date ?? giorno);
          nmRenderPers();
          nmRenderZone();
          mOverlay.classList.add("is-open");
        }
        function chiudiModale() {
          dpChiudi();
          mOverlay.classList.remove("is-open");
        }
        (document.getElementById("fab-add") as HTMLButtonElement).addEventListener("click", () => apriModale());
        (document.getElementById("m-close") as HTMLButtonElement).addEventListener("click", chiudiModale);
        (document.getElementById("m-cancel") as HTMLButtonElement).addEventListener("click", chiudiModale);
        mOverlay.addEventListener("click", (e) => {
          if (e.target === mOverlay) chiudiModale();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key !== "Escape") return;
          if (dpPanel.style.display !== "none") {
            dpChiudi();
            return;
          }
          chiudiModale();
        });

        (document.getElementById("nm-auj") as HTMLButtonElement).addEventListener("click", () => {
          nmSetData(isoOggi());
          dpChiudi();
        });
        (document.getElementById("nm-dem") as HTMLButtonElement).addEventListener("click", () => {
          nmSetData(isoPiuGiorni(isoOggi(), 1));
          dpChiudi();
        });

        // ---- Datepicker brand, identico al widget ----
        const MESI = Array.from({ length: 12 }, (_, m) => new Date(2000, m, 1).toLocaleDateString(LOC, { month: "long" }));
        const DOW = tr("res.dowInitials").split(",");
        let dpAnno = 0;
        let dpMese = 0; // 0-11
        let dpTarget: HTMLInputElement | null = null; // campo data a cui è agganciato
        let dpLibero = false; // true = salto data (passato consentito)
        const dpPanel = document.createElement("div");
        dpPanel.className = "dp-panel";
        dpPanel.style.display = "none";
        document.body.appendChild(dpPanel);

        // Disponibilità del mese: giorni chiusi + giorni fully booked
        // Prenotazioni + sections chiuse del giorno scelto nel modale
        type NmGiorno = {
          rese: Resa[];
          zoneCh: { zone: string; reason: string }[];
          svCh: { service_key: string; reason: string }[];
          spOpen: boolean;
          spServ: string[] | null;
        };
        const nmReseCache = new Map<string, NmGiorno>();
        let nmReseFetching = "";
        function nmReseDel(iso: string): NmGiorno | null {
          if (iso === giorno) {
            return { rese: rese.filter((r) => r.status === "confirmed" || r.status === "seated"), zoneCh: chiusureZoneOggi, svCh: chiusureOggi, spOpen: spOpenOggi, spServ: spServiziOggi };
          }
          if (nmReseCache.has(iso)) return nmReseCache.get(iso) ?? null;
          if (nmReseFetching !== iso) {
            nmReseFetching = iso;
            fetch("/api/admin/reservations?date=" + iso, { headers })
              .then((r) => (r.ok ? r.json() : null))
              .then((j) => {
                if (!j) return;
                nmReseCache.set(iso, {
                  rese: ((j.reservations ?? []) as Resa[]).filter((x) => x.status === "confirmed" || x.status === "seated"),
                  zoneCh: (j.zone_closures ?? []) as { zone: string; reason: string }[],
                  svCh: (j.closures ?? []) as { service_key: string; reason: string }[],
                  spOpen: Boolean(j.special_open),
                  spServ: (j.special_services ?? null) as string[] | null,
                });
                if (mOverlay.classList.contains("is-open")) nmRenderOre();
              })
              .catch(() => { /* senza dati: nessuno sbarrato */ });
          }
          return null;
        }

        const dpCache = new Map<string, { closed: string[]; full: string[]; busy: string[]; taux: Record<string, number> }>();
        function dpChiave(): string {
          return `${dpAnno}-${String(dpMese + 1).padStart(2, "0")}`;
        }
        async function dpCarica() {
          const chiave = dpChiave();
          if (dpCache.has(chiave)) return;
          try {
            const res = await fetch(`/api/admin/reservations?month=${chiave}`, { headers });
            if (!res.ok) return;
            const j = (await res.json()) as { closed?: string[]; full?: string[]; busy?: string[]; taux?: Record<string, number> };
            dpCache.set(chiave, { closed: j.closed ?? [], full: j.full ?? [], busy: j.busy ?? [], taux: j.taux ?? {} });
            // Se il calendario è ancora aperto sullo stesso mese, si aggiorna
            if (dpPanel.style.display !== "none" && dpChiave() === chiave) dpRender();
          } catch { /* calendario senza indicazioni */ }
        }

        function dpRender() {
          const oggi = isoOggi();
          const sel = dpTarget?.dataset.iso ?? "";
          const offset = (new Date(dpAnno, dpMese, 1).getDay() + 6) % 7; // lunedi=0
          const nGiorni = new Date(dpAnno, dpMese + 1, 0).getDate();
          const oy = Number(oggi.slice(0, 4));
          const om = Number(oggi.slice(5, 7)) - 1;
          const prevOff = !dpLibero && (dpAnno < oy || (dpAnno === oy && dpMese <= om));
          let celle = "";
          for (let i = 0; i < offset; i++) celle += '<span class="dp-cell dp-vuota"></span>';
          for (let g = 1; g <= nGiorni; g++) {
            const iso = `${dpAnno}-${String(dpMese + 1).padStart(2, "0")}-${String(g).padStart(2, "0")}`;
            const cls = ["dp-cell"];
            const info = dpCache.get(dpChiave());
            const chiuso = (dpLibero || iso >= oggi) && (info?.closed.includes(iso) ?? false);
            const pieno = (dpLibero || iso >= oggi) && (info?.full.includes(iso) ?? false);
            const off = iso < oggi || chiuso;
            const punto = dpLibero && (info?.busy.includes(iso) ?? false);
            // Colore del pallino: verde ≤30% · oro 31-80% · rosso 81%+
            const tx = info?.taux?.[iso] ?? 0;
            const dotCls = tx > 80 ? " dp-dot--alto" : tx > 30 ? " dp-dot--medio" : "";
            if (off) cls.push("dp-off");
            if (pieno) cls.push("dp-full");
            if (iso === oggi) cls.push("dp-today");
            if (iso === sel) cls.push("dp-sel");
            const hint = chiuso ? ` title="${tr("home.tagClosed")}"` : pieno ? ` title="${tr("res.full")}"` : "";
            celle += `<button type="button" class="${cls.join(" ")}" data-iso="${iso}" ${off && !dpLibero ? "disabled" : ""}${hint}>${g}${punto ? `<span class="dp-dot${dotCls}"></span>` : ""}</button>`;
          }
          dpPanel.innerHTML = `
            <div class="dp-head">
              <button type="button" class="dp-nav" data-nav="-1" ${prevOff ? "disabled" : ""}>‹</button>
              <span class="dp-title">${MESI[dpMese]} ${dpAnno}</span>
              <button type="button" class="dp-nav" data-nav="1">›</button>
            </div>
            <div class="dp-dow">${DOW.map((g) => `<span>${g}</span>`).join("")}</div>
            <div class="dp-grid">${celle}</div>`;
        }
        function dpApri(target: HTMLInputElement) {
          dpTarget = target;
          dpLibero = (target as unknown as HTMLElement) === labelEl;
          const base = target.dataset.iso || isoOggi();
          dpAnno = Number(base.slice(0, 4));
          dpMese = Number(base.slice(5, 7)) - 1;
          dpRender();
          void dpCarica();
          dpPanel.style.display = "block";
          const r = target.getBoundingClientRect();
          const pw = dpPanel.offsetWidth || 308;
          dpPanel.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - pw - 8))}px`;
          dpPanel.style.top = `${Math.min(r.bottom + 6, window.innerHeight - dpPanel.offsetHeight - 8)}px`;
        }
        function dpChiudi() {
          dpPanel.style.display = "none";
        }
        dpPanel.addEventListener("click", (e) => {
          e.stopPropagation();
          const t = e.target as HTMLElement;
          if (t.classList.contains("dp-nav")) {
            dpMese += Number(t.dataset.nav);
            if (dpMese < 0) { dpMese = 11; dpAnno--; }
            if (dpMese > 11) { dpMese = 0; dpAnno++; }
            dpRender();
            void dpCarica();
            return;
          }
          if (t.classList.contains("dp-cell") && t.dataset.iso && dpTarget) {
            if ((dpTarget as unknown as HTMLElement) === labelEl) {
              giorno = t.dataset.iso;
              dSearch.value = "";
              if (vista !== "jour") vaiVista("jour");
              void carica();
            } else if (dpTarget === campo("m-date")) {
              nmSetData(t.dataset.iso);
            } else {
              dpTarget.dataset.iso = t.dataset.iso;
              dpTarget.value = fmtFr(t.dataset.iso);
              dpTarget.dispatchEvent(new Event("change"));
            }
            dpChiudi();
          }
        });
        campo("m-date").addEventListener("click", (e) => {
          e.stopPropagation();
          dpApri(campo("m-date"));
        });
        document.addEventListener("click", (e) => {
          if (dpPanel.style.display !== "none" && !dpPanel.contains(e.target as Node)) dpChiudi();
        });

        (document.getElementById("nm-stabs") as HTMLDivElement).addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".nm-pill") as HTMLElement | null;
          if (!t) return;
          nmServIdx = Number(t.dataset.i);
          nmHeure = "";
          nmEspanso = false;
          nmRenderOre();
        });
        (document.getElementById("nm-slots") as HTMLDivElement).addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest(".nm-more")) {
            nmEspanso = !nmEspanso;
            nmRenderOre();
            return;
          }
          const t = (e.target as HTMLElement).closest(".nm-slot") as HTMLElement | null;
          if (!t) return;
          nmHeure = t.dataset.h ?? "";
          nmRenderOre();
        });
        (document.getElementById("nm-pers") as HTMLDivElement).addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".nm-p[data-n]") as HTMLElement | null;
          if (!t) return;
          nmPers = Number(t.dataset.n);
          nmRenderPers();
          nmRenderOre();
        });
        (document.getElementById("nm-zones") as HTMLDivElement).addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".nm-zone") as HTMLElement | null;
          if (!t) return;
          nmZone = t.dataset.z ?? "";
          nmRenderZone();
          nmRenderOre(); // il pieno dipende anche dalla section scelta
        });

        mSave.addEventListener("click", async () => {
          mMsg.textContent = "";
          if (!nmHeure) {
            mMsg.textContent = tr("res.chooseHour");
            return;
          }
          if (!campo("m-lname").value.trim()) {
            mMsg.textContent = tr("res.nameRequired");
            campo("m-lname").focus();
            return;
          }
          if (nmTipo === "phone" && !campo("m-tel").value.trim()) {
            mMsg.textContent = tr("res.phoneRequired");
            campo("m-tel").focus();
            return;
          }
          mSave.disabled = true;
          try {
            const corpo: Record<string, unknown> = {
              date: campo("m-date").dataset.iso ?? "",
              heure: nmHeure,
              service_key: nmServKey,
              people: nmPers,
              zone: nmZone,
              first_name: campo("m-fname").value.trim(),
              last_name: campo("m-lname").value.trim(),
              phone: (() => {
                const grezzo = campo("m-tel").value.trim();
                if (!grezzo) return "";
                return grezzo.startsWith("+") ? grezzo : `${mPrefix.value} ${grezzo.replace(/^0/, "")}`;
              })(),
              email: campo("m-email").value,
              notes: (document.getElementById("m-notes") as HTMLTextAreaElement).value,
              high_chair: nmChaise,
              quiet: nmCalme,
              business: nmBiz,
              company: nmBiz ? (document.getElementById("m-societe") as HTMLInputElement).value.trim() : "",
              birthday: nmAnniv,
              special_event: nmEvent,
            };
            if (nmSrcEditable) corpo.source = nmTipo === "phone" ? "phone" : "walkin";
            if (planModeOn && !planAuto) corpo.tables = [...nmTavSel];
            if (nmEditId) corpo.id = nmEditId;
            const res = await fetch("/api/admin/reservations", {
              method: nmEditId ? "PATCH" : "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify(corpo),
            });
            const j = await res.json();
            if (!res.ok) {
              mMsg.textContent = j.error ?? tr("res.saveError");
              return;
            }
            chiudiModale();
            nmReseCache.clear();
            nmReseFetching = "";
            toast(nmEditId ? tr("res.resaModified") : tr("res.resaSaved"), "ok");
            await carica();
          } catch {
            mMsg.textContent = tr("common.netErr");
          } finally {
            mSave.disabled = false;
          }
        });
      })();
    </script>
  </body>
</html>
