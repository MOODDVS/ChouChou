        // Chiusura/riapertura «jusqu'à réouverture» di una section
        async function znSalvaPerm(zona: string, closed: boolean) {
          if (!zona) return;
          try {
            const res = await fetch("/api/admin/zone-closures", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ permanent_zone: zona, closed }),
            });
            const j = await res.json();
            if (!res.ok) {
              toast(j.error ?? tr("common.saveErr"), "err");
              return;
            }
            znPerm = (j.permanent ?? []) as string[];
            toast(closed ? tr("res.sectionClosedReopen") : tr("res.sectionReopened"), "ok");
          } catch {
            toast(tr("res.connErr"), "err");
            return;
          }
          znRender();
          await carica(); // pillole del giorno + occupazione aggiornate
        }
        let znFutArmato: HTMLElement | null = null;
        let znFutTimer = 0;
        function znFutDisarma() {
          window.clearTimeout(znFutTimer);
          if (!znFutArmato) return;
          znFutArmato.classList.remove("confirm");
          znFutArmato.innerHTML = ICO_TRASH;
          znFutArmato = null;
        }
        znFutureBox.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest("[data-date]") as HTMLElement | null;
          if (!b) {
            znFutDisarma();
            return;
          }
          e.stopPropagation();
          if (znFutArmato !== b) {
            znFutDisarma();
            znFutArmato = b;
            b.classList.add("confirm");
            b.textContent = tr("common.confirm");
            znFutTimer = window.setTimeout(znFutDisarma, 4000);
            return;
          }
          znFutDisarma();
          const dataDel = b.dataset.date ?? "";
          const zona = b.dataset.z ?? "";
          void (async () => {
            try {
              await fetch(`/api/admin/zone-closures?date=${dataDel}&zone=${encodeURIComponent(zona)}`, {
                method: "POST",
                headers: { ...headers, "X-Method-Override": "DELETE" },
              });
            } catch { /* la lista resta com'era */ }
            if (dataDel === znData) {
              znLista = znLista.filter((c) => c.zone !== zona);
              znRender();
            }
            if (dataDel === giorno) {
              chiusureZoneOggi = chiusureZoneOggi.filter((c) => c.zone !== zona);
              aggiornaChiusureUI();
            }
            void znFutureCarica();
          })();
