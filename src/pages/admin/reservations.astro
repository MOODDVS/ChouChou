        async function znCarica() {
          try {
            const res = await fetch("/api/admin/zone-closures?date=" + znData, { headers });
            const j = await res.json();
            znLista = j.closures ?? [];
          } catch {
            znLista = [];
          }
          if (znData === giorno) {
            chiusureZoneOggi = znLista;
            aggiornaChiusureUI();
          }
          znRender();
        }

        async function znFutureCarica() {
          try {
            const res = await fetch("/api/admin/zone-closures?future=1", { headers });
            const j = (await res.json()) as { closures?: { date: string; zone: string; reason: string }[] };
            const lista = j.closures ?? [];
            znFutureBox.innerHTML = lista.length
              ? lista
                  .map(
                    (c) => `<div class="sv-fut-row">
                        <span class="sv-fut-date">${fmtFr(c.date)}</span>
                        <span class="sv-fut-info"><b>${esc(c.zone)}</b> — ${RAGIONE_FR[c.reason] ?? c.reason}</span>
                        <button type="button" class="i-btn b-annule" data-date="${c.date}" data-z="${esc(c.zone)}" title="Rouvrir">${ICO_TRASH}</button>
                      </div>`
                  )
                  .join("")
              : '<p class="sv-vuoto">Aucune fermeture programmée.</p>';
          } catch {
            znFutureBox.innerHTML = "";
          }
        }

        function znImpostaData(iso: string) {
          znData = iso;
          znDateIn.dataset.iso = iso;
          znDateIn.value = fmtFr(iso);
          (document.getElementById("zn-auj") as HTMLButtonElement).classList.toggle("is-on", iso === isoOggi());
          (document.getElementById("zn-dem") as HTMLButtonElement).classList.toggle("is-on", iso === isoPiuGiorni(isoOggi(), 1));
          znList.innerHTML = "";
          void znCarica();
        }

        async function znSalva(zona: string, reason: string | null) {
          try {
            const res = reason
              ? await fetch("/api/admin/zone-closures", {
                  method: "POST",
                  headers: { ...headers, "Content-Type": "application/json" },
                  body: JSON.stringify({ date: znData, zone: zona, reason }),
                })
              : await fetch(`/api/admin/zone-closures?date=${znData}&zone=${encodeURIComponent(zona)}`, {
                  method: "DELETE",
                  headers,
                });
            const j = await res.json();
            if (!res.ok) {
              toast(j.error ?? "Enregistrement impossible", "err");
            } else if (reason) {
              znLista = znLista.filter((c) => c.zone !== zona).concat([{ zone: zona, reason }]);
            } else {
              znLista = znLista.filter((c) => c.zone !== zona);
            }
          } catch {
            toast("Erreur de connexion", "err");
          }
          if (znData === giorno) {
            chiusureZoneOggi = znLista;
            aggiornaChiusureUI();
          }
          znRender();
          void znFutureCarica();
        }

        (document.getElementById("fab-zone") as HTMLButtonElement).addEventListener("click", () => {
          znOverlay.classList.add("is-open");
          znImpostaData(giorno);
          void znFutureCarica();
        });
        (document.getElementById("zn-close") as HTMLButtonElement).addEventListener("click", () => {
          znOverlay.classList.remove("is-open");
        });
        (document.getElementById("zn-auj") as HTMLButtonElement).addEventListener("click", () => {
          znImpostaData(isoOggi());
        });
        (document.getElementById("zn-dem") as HTMLButtonElement).addEventListener("click", () => {
          znImpostaData(isoPiuGiorni(isoOggi(), 1));
