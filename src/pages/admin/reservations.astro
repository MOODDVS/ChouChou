        function svImpostaData(iso: string) {
          svData = iso;
          svDateIn.dataset.iso = iso;
          svDateIn.value = fmtFr(iso);
          (document.getElementById("sv-auj") as HTMLButtonElement).classList.toggle("is-on", iso === isoOggi());
          (document.getElementById("sv-dem") as HTMLButtonElement).classList.toggle("is-on", iso === isoPiuGiorni(isoOggi(), 1));
          svList.innerHTML = "";
