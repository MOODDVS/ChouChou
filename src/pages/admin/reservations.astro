            znList.innerHTML = '<p class="sv-vuoto">Aucune section configurée dans Réglages → Réservations.</p>';
            return;
          }
          znList.innerHTML = zone
            .map((z) => {
              const chiusa = znLista.find((c) => c.zone === z);
              const posti = nmCfg.zone_seats?.[z] ?? 0;
              const raisons = chiusa
                ? `<div class="sv-raisons">
                     <button type="button" class="sv-raison${chiusa.reason === "full" ? " is-on" : ""}" data-z="${esc(z)}" data-r="full">Complet</button>
                     <button type="button" class="sv-raison${chiusa.reason === "closed" ? " is-on" : ""}" data-z="${esc(z)}" data-r="closed">Fermeture exceptionnelle</button>
                   </div>`
                : "";
              return `<div class="sv-row">
                  <div class="sv-info">
                    <div class="sv-nom">${esc(z)}</div>
                    <div class="sv-heures">${posti ? `${posti} couverts` : ""}</div>
                  </div>
                  <span class="sv-state">${chiusa ? "Fermée" : "Ouverte"}</span>
                  <label class="sv-switch">
                    <input type="checkbox" data-z="${esc(z)}" ${chiusa ? "" : "checked"} />
                    <span class="sv-track"></span>
                  </label>
                  ${raisons}
                </div>`;
            })
            .join("");
