          }
          const id = (btn.closest(".res") as HTMLElement | null)?.dataset.id ?? "";
          if (!id) return;
          const act = btn.dataset.act;
          if (act === "cancel") {
            e.stopPropagation(); // il testo sostituisce l'icona: senza stop il "click fuori" disarmerebbe subito
            // Primo tap: chiede conferma; secondo tap: annulla davvero
            if (cestinoArmato === btn) {
              disarmaCestino();
              void cambiaStato(id, "cancelled");
            } else {
              disarmaCestino();
              cestinoArmato = btn;
              btn.classList.add("confirm");
              btn.textContent = "Confirmer ?";
              cestinoTimer = window.setTimeout(disarmaCestino, 4000);
            }
            return;
          }
          disarmaCestino();
          if (act === "status") {
            e.stopPropagation(); // il click fuori non deve richiudere subito il menu
            apriStMenu(btn, id);
          }
          if (act === "edit") {
            const r = rese.find((x) => x.id === id);
            if (r) apriModale(r);
