        });

        rowsEl.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest("[data-act]") as HTMLElement | null;
          if (!btn) {
            disarmaCestino();
            const card = (e.target as HTMLElement).closest(".res") as HTMLElement | null;
            if (card?.dataset.id && !(e.target as HTMLElement).closest("a")) apriDettagli(card.dataset.id);
            return;
          }
          const id = (btn.closest(".res") as HTMLElement | null)?.dataset.id ?? "";
          if (!id) return;
          const act = btn.dataset.act;
          if (act === "delete") {
            e.stopPropagation();
            // Modale a due scelte: annullare (con email al cliente) o eliminare (silenzioso).
            apriRm(id);
            return;
          }
          disarmaCestino();
          if (act === "status") {
            e.stopPropagation(); // il click fuori non deve richiudere subito il menu
            apriStMenu(btn, id);
