      async function carica() {
        modoRicerca = false;
        stateEl.style.display = "";
        rowsEl.style.display = "none";
        emptyEl.style.display = "none";
        try {
          const res = await fetch("/api/admin/reservations?date=" + giorno, { headers });
          if (!res.ok) throw new Error();
          const j = (await res.json()) as {
            reservations: Resa[];
            closures?: { service_key: string; reason: string }[];
            zone_closures?: { zone: string; reason: string }[];
            hold_minutes?: number;
            config?: typeof nmCfg;
            missing?: boolean;
          };
          rese = j.reservations;
          chiusureOggi = j.closures ?? [];
          chiusureZoneOggi = j.zone_closures ?? [];
          aggiornaChiusureUI();
          if (j.hold_minutes) holdMinutes = j.hold_minutes;
          if (j.config) {
            nmCfg = j.config;
            if (j.config.timezone) fusoOrario = j.config.timezone;
          }
          renderFiltroServ();
          stateEl.style.display = "none";
          if (j.missing) {
            emptyEl.textContent = "Table `reservations` absente — lancer la migration supabase/reservations.sql.";
          } else {
            emptyEl.textContent = "Aucune réservation ce jour.";
          }
          render();
        } catch {
          stateEl.textContent = "Erreur de chargement.";
        }
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        headers = { Authorization: `Bearer ${session.access_token ?? ""}` };
        await carica();
        // Gli stati temporali (En cours / Fini ?) si aggiornano da soli
        setInterval(render, 60_000);

        // ---- Azioni sulle card: stato, no-show, cestino a due tap, edit ----
        async function cambiaStato(id: string, status: string) {
          try {
            const res = await fetch("/api/admin/reservations", {
              method: "PATCH",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id, status }),
            });
            if (!res.ok) throw new Error();
            await carica();
          } catch {
            toast("Modification impossible", "err");
          }
        }
        // ---- Menu degli stati (badge cliccabile) ----
        const STATI_MENU: { st: string; label: string; colore: string }[] = [
          { st: "confirmed", label: "Confirmée", colore: "#2e9e6b" },
          { st: "done", label: "Fini", colore: "#b3aca6" },
          { st: "noshow", label: "No-show", colore: "#dfab4e" },
          { st: "cancelled", label: "Annulée", colore: "#ed1c24" },
        ];
        const stMenu = document.createElement("div");
        stMenu.className = "st-menu";
        document.body.appendChild(stMenu);
        let stMenuId = "";
        function chiudiStMenu() {
          stMenu.style.display = "none";
          stMenuId = "";
        }
        function apriStMenu(anchor: HTMLElement, id: string) {
          const r = rese.find((x) => x.id === id);
          stMenuId = id;
          stMenu.innerHTML = STATI_MENU.map(
            (v) =>
              `<button type="button" data-st="${v.st}" class="${r?.status === v.st ? "is-cur" : ""}"><span class="st-dot" style="background:${v.colore}"></span>${v.label}</button>`
          ).join("");
          stMenu.style.display = "block";
          const rect = anchor.getBoundingClientRect();
          const mw = stMenu.offsetWidth || 150;
          const mh = stMenu.offsetHeight || 160;
          stMenu.style.left = `${Math.max(8, Math.min(rect.left, window.innerWidth - mw - 8))}px`;
          stMenu.style.top = `${Math.min(rect.bottom + 6, window.innerHeight - mh - 8)}px`;
        }
        stMenu.addEventListener("click", (e) => {
          e.stopPropagation();
          const b = (e.target as HTMLElement).closest("[data-st]") as HTMLElement | null;
          if (!b || !stMenuId) return;
          const id = stMenuId;
          chiudiStMenu();
          void cambiaStato(id, b.dataset.st ?? "");
        });
        document.addEventListener("click", (e) => {
          if (stMenu.style.display !== "none" && !stMenu.contains(e.target as Node)) chiudiStMenu();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") chiudiStMenu();
        });

        // ---- Services du jour: chiusure par service ----
        const svOverlay = document.getElementById("sv-overlay") as HTMLDivElement;
        const svList = document.getElementById("sv-list") as HTMLDivElement;
        const svFutureBox = document.getElementById("sv-future") as HTMLDivElement;
        const svDateIn = document.getElementById("sv-datein") as HTMLInputElement;
        let svData = giorno; // data su cui agisce il modale (anche futura)
        let svLista: { service_key: string; reason: string }[] = [];

        function svRender() {
          const servizi = nmServizi();
          if (!servizi.length) {
            svList.innerHTML = '<p class="sv-vuoto">Aucun service configuré dans Réglages → Réservations.</p>';
            return;
          }
          const oggi = svData === isoOggi();
          const adesso = minutiOra();
          svList.innerHTML = servizi
            .map((sv) => {
              const chiusa = svLista.find((c) => c.service_key === sv.key);
              const passato = oggi && sv.a < adesso;
              const raisons = chiusa
                ? `<div class="sv-raisons">
                     <button type="button" class="sv-raison${chiusa.reason === "full" ? " is-on" : ""}" data-k="${sv.key}" data-r="full">Complet</button>
                     <button type="button" class="sv-raison${chiusa.reason === "closed" ? " is-on" : ""}" data-k="${sv.key}" data-r="closed">Fermeture exceptionnelle</button>
                   </div>`
                : "";
              return `<div class="sv-row${passato ? " is-past" : ""}">
                  <div class="sv-info">
                    <div class="sv-nom">${esc(sv.label)}</div>
                    <div class="sv-heures">${slotHHMM(sv.da)} – ${slotHHMM(sv.a)}</div>
                  </div>
                  ${passato ? '<span class="sv-past-lab">Service terminé</span>' : `<span class="sv-state">${chiusa ? "Fermé" : "Ouvert"}</span>`}
                  <label class="sv-switch">
                    <input type="checkbox" data-k="${sv.key}" ${chiusa ? "" : "checked"} ${passato ? "disabled" : ""} />
                    <span class="sv-track"></span>
                  </label>
                  ${raisons}
                </div>`;
            })
            .join("");
