        });
        btnSem.addEventListener("click", () => vaiVista(vista === "semaine" ? "jour" : "semaine"));
        btnMois.addEventListener("click", () => vaiVista(vista === "mois" ? "jour" : "mois"));

        // ---- Navigazione del giorno ----
        (document.getElementById("d-prev") as HTMLButtonElement).addEventListener("click", () => {
