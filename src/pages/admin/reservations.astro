        async function svSalva(key: string, reason: string | null) {
          try {
            const res = reason
              ? await fetch("/api/admin/service-closures", {
                  method: "POST",
                  headers: { ...headers, "Content-Type": "application/json" },
                  body: JSON.stringify({ date: svData, service_key: key, reason }),
                })
              : await fetch(`/api/admin/service-closures?date=${svData}&service_key=${key}`, {
                  method: "DELETE",
                  headers,
                });
            const j = await res.json();
            if (!res.ok) {
              toast(j.error ?? "Enregistrement impossible", "err");
            } else if (reason) {
              svLista = svLista.filter((c) => c.service_key !== key).concat([{ service_key: key, reason }]);
            } else {
              svLista = svLista.filter((c) => c.service_key !== key);
            }
          } catch {
            toast("Erreur de connexion", "err");
          }
          if (svData === giorno) {
            chiusureOggi = svLista;
            aggiornaChiusureUI();
          }
          svRender();
          void svFutureCarica();
        }

        (document.getElementById("fab-serv") as HTMLButtonElement).addEventListener("click", () => {
          svOverlay.classList.add("is-open");
          svImpostaData(giorno);
          void svFutureCarica();
        });
        (document.getElementById("sv-auj") as HTMLButtonElement).addEventListener("click", () => {
          svImpostaData(isoOggi());
        });
        (document.getElementById("sv-dem") as HTMLButtonElement).addEventListener("click", () => {
          svImpostaData(isoPiuGiorni(isoOggi(), 1));
        });
        svDateIn.addEventListener("click", (e) => {
          e.stopPropagation();
          dpApri(svDateIn);
        });
        svDateIn.addEventListener("change", () => {
          if (svDateIn.dataset.iso) svImpostaData(svDateIn.dataset.iso);
        });
        let svFutArmato: HTMLElement | null = null; // bin in attesa di conferma
        let svFutTimer = 0;
        function svFutDisarma() {
          window.clearTimeout(svFutTimer);
          if (!svFutArmato) return;
          svFutArmato.classList.remove("confirm");
          svFutArmato.innerHTML = ICO_TRASH;
          svFutArmato = null;
        }
        svFutureBox.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest("[data-date]") as HTMLElement | null;
          if (!b) {
            svFutDisarma();
            return;
          }
          e.stopPropagation(); // idem: il target si stacca sostituendo l'icona
          // Primo tap: chiede conferma; secondo tap: annulla la fermeture
          if (svFutArmato !== b) {
            svFutDisarma();
            svFutArmato = b;
            b.classList.add("confirm");
            b.textContent = "Confirmer ?";
            svFutTimer = window.setTimeout(svFutDisarma, 4000);
            return;
          }
          svFutDisarma();
          const dataDel = b.dataset.date ?? "";
          const key = b.dataset.k ?? "";
          void (async () => {
            try {
              await fetch(`/api/admin/service-closures?date=${dataDel}&service_key=${key}`, {
                method: "DELETE",
                headers,
              });
            } catch { /* la lista resta com'era */ }
            if (dataDel === svData) {
              svLista = svLista.filter((c) => c.service_key !== key);
              svRender();
            }
            if (dataDel === giorno) {
              chiusureOggi = chiusureOggi.filter((c) => c.service_key !== key);
              aggiornaChiusureUI();
            }
            void svFutureCarica();
          })();
        });
        (document.getElementById("sv-close") as HTMLButtonElement).addEventListener("click", () => {
          svOverlay.classList.remove("is-open");
        });
        svOverlay.addEventListener("click", (e) => {
          if (e.target === svOverlay) svOverlay.classList.remove("is-open");
          if (!(e.target as HTMLElement).closest("[data-date]")) svFutDisarma();
        });
        svList.addEventListener("change", (e) => {
          const t = e.target as HTMLInputElement;
          if (t.type !== "checkbox" || !t.dataset.k) return;
          // Spento = chiuso (ragione di default: Complet)
          void svSalva(t.dataset.k, t.checked ? null : "full");
        });
        svList.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".sv-raison") as HTMLElement | null;
          if (!b) return;
          void svSalva(b.dataset.k ?? "", b.dataset.r ?? "full");
        });

        // La X sulle pillole riapre subito il service / la section
        (document.getElementById("d-closed") as HTMLElement).addEventListener("click", (e) => {
          const x = (e.target as HTMLElement).closest(".d-closed-x") as HTMLElement | null;
          if (!x) return;
          const k = x.dataset.k ?? "";
          void (async () => {
            try {
              if (x.dataset.tipo === "service") {
                await fetch(`/api/admin/service-closures?date=${giorno}&service_key=${k}`, { method: "DELETE", headers });
                chiusureOggi = chiusureOggi.filter((c) => c.service_key !== k);
              } else {
                await fetch(`/api/admin/zone-closures?date=${giorno}&zone=${encodeURIComponent(k)}`, { method: "DELETE", headers });
                chiusureZoneOggi = chiusureZoneOggi.filter((c) => c.zone !== k);
              }
            } catch { /* la pillola resta */ }
            aggiornaChiusureUI();
          })();
        });

        // ---- Sections: chiusure par section (speculare ai services) ----
        const znOverlay = document.getElementById("zn-overlay") as HTMLDivElement;
        const znList = document.getElementById("zn-list") as HTMLDivElement;
        const znFutureBox = document.getElementById("zn-future") as HTMLDivElement;
        const znDateIn = document.getElementById("zn-datein") as HTMLInputElement;
        let znData = giorno;
        let znLista: { zone: string; reason: string }[] = [];

        function znRender() {
