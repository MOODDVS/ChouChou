        const mPrefix = document.getElementById("m-prefix") as HTMLSelectElement;
        const PREFISSO_DEFAULT = PREFISSI.find((pf) => pf.code === CLIENT.paese)?.dial ?? PREFISSI[0].dial;
        mPrefix.innerHTML = PREFISSI.map(
          (pf) => `<option value="${pf.dial}" title="${pf.nome}">${pf.flag} ${pf.dial}</option>`
        ).join("");
        mPrefix.value = PREFISSO_DEFAULT;
        // "+33 6…" o "0033…" digitato nel numero → prefisso in tendina, numero pulito
        campo("m-tel").addEventListener("input", () => {
          const tel = campo("m-tel");
          const sep = separaPrefisso(tel.value);
          if (!sep) return;
          mPrefix.value = sep.dial;
          tel.value = sep.resto;
        });

        let nmTipo: "walkin" | "phone" = "walkin";
        function nmRenderTipo() {
          (document.getElementById("nm-walkin") as HTMLButtonElement).classList.toggle("is-on", nmTipo === "walkin");
          (document.getElementById("nm-phone") as HTMLButtonElement).classList.toggle("is-on", nmTipo === "phone");
          campo("m-fname").placeholder = tr("ord.firstName");
          campo("m-lname").placeholder = tr("ord.lastNameReq");
          campo("m-tel").placeholder = nmTipo === "phone" ? tr("res.phoneReq") : tr("ord.phone");
        }
        (document.getElementById("nm-walkin") as HTMLButtonElement).addEventListener("click", () => {
          nmTipo = "walkin";
          nmRenderTipo();
        });
        (document.getElementById("nm-phone") as HTMLButtonElement).addEventListener("click", () => {
          nmTipo = "phone";
          nmRenderTipo();
