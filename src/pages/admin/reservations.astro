        // ---- FAB allineati con l'isola dei link (stessa base e altezza) ----
        function posizionaFabs() {
          const barra = document.querySelector(".admin-nav") as HTMLElement | null;
          if (!barra) return;
          const largo = window.matchMedia("(min-width: 521px)").matches;
          const pill = document.getElementById("fab-add") as HTMLElement | null;
          const cerchi = [
            document.getElementById("fab-serv") as HTMLElement | null,
            document.getElementById("fab-zone") as HTMLElement | null,
          ];
          if (!largo) {
            if (pill) {
              pill.style.height = "";
              pill.style.bottom = "";
            }
            for (const c of cerchi)
              if (c) {
                c.style.width = "";
                c.style.height = "";
                c.style.bottom = "";
              }
            return; // mobile: barra a tutta larghezza, i FAB restano sopra
          }
          const r = barra.getBoundingClientRect();
          const base = `${window.innerHeight - r.bottom}px`;
          if (pill) {
            pill.style.height = `${r.height}px`;
            pill.style.bottom = base;
          }
          for (const c of cerchi)
            if (c) {
              c.style.width = `${r.height}px`;
              c.style.height = `${r.height}px`;
              c.style.bottom = base;
            }
        }
        posizionaFabs();
        window.addEventListener("resize", posizionaFabs);

        // ---- Filtro per service (icona = tutti) ----
        (document.getElementById("f-serv") as HTMLDivElement).addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".fs-pill") as HTMLElement | null;
          if (!b) return;
