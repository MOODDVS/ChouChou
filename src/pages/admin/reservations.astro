          dpApri(znDateIn);
        });
        znDateIn.addEventListener("change", () => {
          if (znDateIn.dataset.iso) znImpostaData(znDateIn.dataset.iso);
        });
        znList.addEventListener("change", (e) => {
          const t = e.target as HTMLInputElement;
          if (t.type !== "checkbox" || !t.dataset.z) return;
          // Spento = chiusa (ragione di default: Fermeture exceptionnelle)
          void znSalva(t.dataset.z, t.checked ? null : "closed");
        });
        znList.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".sv-raison") as HTMLElement | null;
          if (!b || !b.dataset.z) return;
          void znSalva(b.dataset.z, b.dataset.r ?? "closed");
        });
        let znFutArmato: HTMLElement | null = null;
        let znFutTimer = 0;
        function znFutDisarma() {
