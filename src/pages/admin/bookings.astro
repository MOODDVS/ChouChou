---
// Pannello admin — prenotazioni.
// Desktop (>600px): striscia settimana lun→dom con frecce.
// Mobile (≤600px): striscia continua da oggi-14 a oggi+30, oggi centrato,
//                  scroll orizzontale libero, frecce nascoste.
import AdminNav from "../../components/AdminNav.astro";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Réservations — Admin Pizzeria 77</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-bg: #000000;
        --c-text: #ffffff;
        --c-muted: #b3b3b3;
        --c-line: #2a2a2a;
        --c-card: #0e0e0e;
        --font-title: "Bebas Neue", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
        --hdr-h: 64px;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: var(--c-bg);
        color: var(--c-text);
        font-family: var(--font-body);
        min-height: 100vh;
      }
      #app { display: none; min-height: 100vh; flex-direction: column; }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--c-line);
        position: sticky;
        top: 0;
        background: var(--c-bg);
        z-index: 10;
        height: var(--hdr-h);
      }
      .brand { display: flex; align-items: center; gap: 0.75rem; }
      .brand img { width: 32px; height: 32px; filter: invert(1); }
      .brand a {
        font-family: var(--font-title);
        font-size: 1.3rem;
        letter-spacing: 0.04em;
        color: var(--c-text);
        text-decoration: none;
      }
      .user { display: flex; align-items: center; gap: 1rem; font-size: 0.8rem; color: var(--c-muted); }
      .logout {
        background: transparent;
        border: 1px solid var(--c-line);
        color: var(--c-text);
        font-family: var(--font-body);
        font-size: 0.78rem;
        padding: 0.4rem 0.8rem;
        cursor: pointer;
      }
      .logout:hover { background: var(--c-text); color: var(--c-bg); }

      main { flex: 1; padding: 0 1.5rem 7rem; width: 100%; }

      .week {
        display: flex;
        align-items: stretch;
        gap: 0.4rem;
        position: sticky;
        top: var(--hdr-h);
        background: var(--c-bg);
        margin: 0 -1.5rem;
        padding: 0.8rem 1.5rem;
        border-bottom: 1px solid var(--c-line);
        z-index: 9;
      }
      .week-arrow {
        flex: 0 0 auto;
        background: transparent;
        border: 1px solid var(--c-line);
        color: var(--c-text);
        font-size: 1.2rem;
        padding: 0 0.9rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: background 0.2s, color 0.2s;
      }
      .week-arrow:hover { background: var(--c-text); color: var(--c-bg); }
      .week-days {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.4rem;
      }
      /* La striscia continua (mobile) è nascosta su desktop. */
      .strip { display: none; }

      .day-cell {
        background: var(--c-card);
        border: 1px solid var(--c-line);
        padding: 0.7rem 0.4rem;
        text-align: center;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s;
      }
      .day-cell:hover { border-color: var(--c-muted); }
      .day-cell.selected { background: var(--c-text); border-color: var(--c-text); }
      .day-cell.selected .dc-dow,
      .day-cell.selected .dc-num,
      .day-cell.selected .dc-count { color: #000; }
      .dc-dow {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--c-muted);
      }
      .dc-num {
        font-family: var(--font-title);
        font-size: 1.5rem;
        line-height: 1.1;
        color: var(--c-text);
      }
      .dc-count {
        font-size: 0.68rem;
        color: var(--c-muted);
        margin-top: 0.15rem;
        min-height: 0.9rem;
      }
      .day-cell.today .dc-num { text-decoration: underline; }

      .content { padding-top: 1.5rem; }
      .selected-label {
        font-family: var(--font-title);
        font-size: 1.5rem;
        letter-spacing: 0.03em;
        text-transform: capitalize;
        margin-bottom: 1rem;
      }
      .state { color: var(--c-muted); text-align: center; padding: 3rem 1rem; }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
      }
      .card {
        background: var(--c-card);
        border: 1px solid var(--c-line);
        padding: 1.1rem 1.25rem;
      }
      .card-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        margin-bottom: 0.6rem;
      }
      .time { font-family: var(--font-title); font-size: 1.4rem; letter-spacing: 0.03em; }
      .people {
        font-size: 0.8rem;
        color: var(--c-text);
        border: 1px solid var(--c-line);
        padding: 0.2rem 0.55rem;
        white-space: nowrap;
      }
      .name { font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; }
      .row { font-size: 0.88rem; color: var(--c-muted); margin-bottom: 0.2rem; }
      .row a { color: var(--c-text); text-decoration: none; }
      .row a:hover { text-decoration: underline; }
      .notes {
        margin-top: 0.6rem;
        padding-top: 0.6rem;
        border-top: 1px solid var(--c-line);
        font-size: 0.88rem;
        color: var(--c-text);
        white-space: pre-wrap;
      }
      .badge {
        display: inline-block;
        font-size: 0.68rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 0.12rem 0.45rem;
        border: 1px solid var(--c-line);
        color: var(--c-muted);
        margin-left: 0.5rem;
      }

      /* MOBILE: nascondo la settimana+frecce, mostro la striscia continua. */
      @media (max-width: 600px) {
        main { padding: 0 1rem 7rem; }
        .week {
          margin: 0 -1rem;
          padding: 0.7rem 0;
          gap: 0;
          display: block;
        }
        .week-arrow, .week-days { display: none; }

        .strip {
          display: flex;
          gap: 0.4rem;
          overflow-x: auto;
          padding: 0 50%;
          scroll-snap-type: x mandatory;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
        }
        .strip::-webkit-scrollbar { display: none; }
        .strip .day-cell {
          flex: 0 0 30%;
          scroll-snap-align: center;
        }
        .cnt-word { display: none; }
      }
    </style>
  </head>
  <body>
    <div id="app">
      <header>
        <div class="brand">
          <img src="/logo77.svg" alt="Pizzeria 77" />
          <a href="/admin">Admin</a>
        </div>
        <div class="user">
          <span id="user-email"></span>
          <button class="logout" id="logout-btn">Déconnexion</button>
        </div>
      </header>
      <main>
        <div class="week">
          <button class="week-arrow" id="prev-week" aria-label="Semaine précédente">‹</button>
          <div class="week-days" id="week-days"></div>
          <button class="week-arrow" id="next-week" aria-label="Semaine suivante">›</button>
          <!-- Striscia continua (mobile): popolata da JS -->
          <div class="strip" id="strip"></div>
        </div>

        <div class="content">
          <p class="selected-label" id="selected-label"></p>
          <div class="state" id="state">Chargement…</div>
          <div class="grid" id="grid"></div>
        </div>
      </main>
    </div>

    <AdminNav current="bookings" />

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";

      type Booking = {
        id: string;
        status: string | null;
        customer_name: string;
        customer_email: string;
        customer_phone: string | null;
        booking_date: string;
        booking_time: string;
        people: number;
        company: string | null;
        notes: string | null;
        lang: string | null;
        source: string | null;
        created_at: string;
      };

      function esc(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }
      function dayKey(d: Date): string {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, "0");
        const g = String(d.getDate()).padStart(2, "0");
        return `${y}-${m}-${g}`;
      }
      function lunediDi(d: Date): Date {
        const x = new Date(d);
        x.setHours(0, 0, 0, 0);
        const dow = (x.getDay() + 6) % 7;
        x.setDate(x.getDate() - dow);
        return x;
      }

      const DOW = ["lun", "mar", "mer", "jeu", "ven", "sam", "dim"];
      const DOW_FROM_SUNDAY = ["dim", "lun", "mar", "mer", "jeu", "ven", "sam"];

      let tutte: Booking[] = [];
      const perGiorno = new Map<string, Booking[]>();
      const oggiKey = dayKey(new Date());
      let lunediCorrente = lunediDi(new Date());
      let selezionato = oggiKey;
      let stripCentrato = false;

      function cellHTML(d: Date, dowLabel: string): string {
        const key = dayKey(d);
        const lista = perGiorno.get(key) ?? [];
        const n = lista.length;
        const classes = [
          "day-cell",
          key === selezionato ? "selected" : "",
          key === oggiKey ? "today" : "",
        ].filter(Boolean).join(" ");
        const countTxt = n > 0 ? `${n}<span class="cnt-word"> résa${n > 1 ? "s" : ""}</span>` : "—";
        return `
          <div class="${classes}" data-key="${key}">
            <div class="dc-dow">${dowLabel}</div>
            <div class="dc-num">${d.getDate()}</div>
            <div class="dc-count">${countTxt}</div>
          </div>`;
      }

      function cardHTML(b: Booking): string {
        const phone = b.customer_phone
          ? `<p class="row">Tél : <a href="tel:${esc(b.customer_phone)}">${esc(b.customer_phone)}</a></p>`
          : "";
        const company = b.company ? `<p class="row">Société : ${esc(b.company)}</p>` : "";
        const notes = b.notes ? `<div class="notes">${esc(b.notes)}</div>` : "";
        const langBadge = b.lang ? `<span class="badge">${esc(b.lang)}</span>` : "";
        return `
          <div class="card">
            <div class="card-top">
              <span class="time">${esc(b.booking_time)}</span>
              <span class="people">${b.people} pers.</span>
            </div>
            <p class="name">${esc(b.customer_name)}${langBadge}</p>
            <p class="row">Email : <a href="mailto:${esc(b.customer_email)}">${esc(b.customer_email)}</a></p>
            ${phone}
            ${company}
            ${notes}
          </div>`;
      }

      function attachCellClicks(container: HTMLElement) {
        container.querySelectorAll<HTMLElement>(".day-cell").forEach((cell) => {
          cell.addEventListener("click", () => {
            selezionato = cell.dataset.key ?? oggiKey;
            renderWeek();
            renderStrip();
            renderDay();
          });
        });
      }

      // Desktop: settimana lun→dom
      function renderWeek() {
        const weekEl = document.getElementById("week-days") as HTMLDivElement;
        let html = "";
        for (let i = 0; i < 7; i++) {
          const d = new Date(lunediCorrente);
          d.setDate(d.getDate() + i);
          html += cellHTML(d, DOW[i]);
        }
        weekEl.innerHTML = html;
        attachCellClicks(weekEl);
      }

      // Mobile: striscia continua da oggi-14 a oggi+30
      function renderStrip() {
        const stripEl = document.getElementById("strip") as HTMLDivElement;
        const base = new Date();
        base.setHours(0, 0, 0, 0);
        let html = "";
        for (let off = -14; off <= 30; off++) {
          const d = new Date(base);
          d.setDate(d.getDate() + off);
          html += cellHTML(d, DOW_FROM_SUNDAY[d.getDay()]);
        }
        stripEl.innerHTML = html;
        attachCellClicks(stripEl);

        // Centra oggi all'apertura (una sola volta, senza animazione).
        if (!stripCentrato) {
          const todayCell = stripEl.querySelector<HTMLElement>(`.day-cell[data-key="${oggiKey}"]`);
          if (todayCell) {
            todayCell.scrollIntoView({ inline: "center", block: "nearest" });
            stripCentrato = true;
          }
        }
      }

      function renderDay() {
        const gridEl = document.getElementById("grid") as HTMLDivElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const labelEl = document.getElementById("selected-label") as HTMLParagraphElement;

        const d = new Date(selezionato + "T00:00:00");
        let label = d.toLocaleDateString("fr-BE", {
          weekday: "long",
          day: "numeric",
          month: "long",
        });
        if (selezionato === oggiKey) label = "Aujourd'hui — " + label;
        labelEl.textContent = label;

        const lista = (perGiorno.get(selezionato) ?? []).slice().sort((a, b) =>
          a.booking_time < b.booking_time ? -1 : 1
        );

        if (lista.length === 0) {
          stateEl.textContent = "Aucune réservation ce jour.";
          stateEl.style.display = "block";
          gridEl.innerHTML = "";
          return;
        }
        stateEl.style.display = "none";
        gridEl.innerHTML = lista.map(cardHTML).join("");
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        document.getElementById("prev-week")?.addEventListener("click", () => {
          lunediCorrente.setDate(lunediCorrente.getDate() - 7);
          lunediCorrente = new Date(lunediCorrente);
          renderWeek();
        });
        document.getElementById("next-week")?.addEventListener("click", () => {
          lunediCorrente.setDate(lunediCorrente.getDate() + 7);
          lunediCorrente = new Date(lunediCorrente);
          renderWeek();
        });

        const { data: userData, error: userErr } = await supabaseBrowser.auth.getUser();
        if (userErr || !userData.user) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = userData.user.email ?? "";
        app.style.display = "flex";

        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const token = sessionData.session?.access_token ?? "";

        try {
          const res = await fetch("/api/admin/bookings", {
            headers: { Authorization: `Bearer ${token}` },
          });
          if (!res.ok) {
            stateEl.textContent = "Erreur de chargement.";
            return;
          }
          const json = await res.json();
          tutte = json.bookings as Booking[];
          for (const b of tutte) {
            if (!perGiorno.has(b.booking_date)) perGiorno.set(b.booking_date, []);
            perGiorno.get(b.booking_date)!.push(b);
          }
          renderWeek();
          renderStrip();
          renderDay();
        } catch {
          stateEl.textContent = "Erreur de connexion.";
        }
      })();
    </script>
  </body>
</html>
