---
/**
 * PRENDERE UN ORDINE DAL PALMARE — /admin/salle/order?id=<tavolo> (23/10/2026).
 *
 * Si arriva da «Commander» sulla scheda di un tavolo OCCUPATO. Il menu e'
 * quello della sala (`getMenuSala`: tutto il visibile, coi prezzi che il
 * cliente vedrebbe col QR). Un tocco su un piatto = +1; un piatto con piu'
 * formati apre la scelta del formato. In fondo il carrello: «Récap» apre il
 * riepilogo, dove si cambia la quantita', si scrive la nota per la cucina e
 * si manda (`/api/admin/salle-order`, regole in `ordineCameriere.ts`).
 *
 * ⚠️ LIMITE NOTO (lo stesso del QR, `getMenuSala`): un piatto a formati
 * mostra solo i formati ordinabili online.
 * ⚠️ Non ci sono ancora le portate («Envoyer la suite»): tutto quello che si
 * manda parte adesso. Vedi i prossimi passi in `claude/palmare.md`.
 */
import PalmareHead from "../../../components/admin/PalmareHead.astro";
import IsolaTavolo from "../../../components/admin/IsolaTavolo.astro";
import Immagine from "../../../components/Immagine.astro";
import { linguaPalmare } from "../../../lib/admin/linguaPalmare";
import { adminT, ADMIN_LOCALE } from "../../../i18n/admin";
import { claimsDaToken } from "../../../lib/admin/adminAuth";
import { ambitoDiRichiesta } from "../../../lib/admin/sede";
import { schedaTavolo, type SchedaTavolo } from "../../../lib/admin/schedaTavolo";
import { getMenuSala, type MenuCategoria } from "../../../lib/db";
import { importoDa } from "../../../lib/soldi";
import { cronometro } from "../../../lib/admin/letturaSala";
import { ICONA_CIBO, ICONA_BEVANDA } from "../../../lib/iconeSala";

export const prerender = false;

// La lingua del cameriere (il suo telefono), o quella dell'admin.
const lang = await linguaPalmare(Astro.request);
const t = adminT(lang);
const LOC = ADMIN_LOCALE[lang] ?? "fr-BE";
const euro = (c: number) => importoDa(c, LOC);

const id = Astro.url.searchParams.get("id") ?? "";
let s: SchedaTavolo | null = null;
let menu: MenuCategoria[] = [];
// ⚠️ VELOCITA' (23/10/2026): il tavolo e il menu INSIEME, non uno dopo
// l'altro. Il menu si legge anche se poi non serve: e' in cache quasi sempre.
const crono = cronometro();
try {
  const staff = await claimsDaToken(Astro.cookies.get("mdd_at")?.value ?? "");
  const ambito = await ambitoDiRichiesta(Astro.request, staff);
  const [scheda, carta] = await Promise.all([
    schedaTavolo(ambito, id),
    getMenuSala(ambito).catch(() => [] as MenuCategoria[]),
  ]);
  s = scheda;
  if (s && (s.sessione || s.conto?.stato === "open")) menu = carta;
} catch { s = null; }
crono.tappa("tavolo+menu");
Astro.response.headers.set("Server-Timing", crono.intestazione());

/** Si puo' ordinare? Solo su un tavolo occupato, e su un conto gia' validato. */
const bloccato = !s ? t("sal.tb.notFound")
  : s.conto?.stato === "pending" ? t("sal.ord.err.validate")
  : !s.conto && !s.sessione ? t("sal.ord.err.free")
  : "";
const nomiTavoli = s?.gruppo ? s.gruppo.nomi.join(" + ") : (s?.tavolo.name ?? "");
const titolo = s ? `${t("sal.tb.table")} ${nomiTavoli}` : t("sal.title");
const ritorno = `/admin/salle/table?id=${encodeURIComponent(id)}`;

/* Le categorie con almeno un piatto. Per il browser: id, nome, prezzo, e i
   formati ordinabili (gli esauriti si vedono ma non si scelgono). */
const categorie = menu.filter((c) => c.items.length > 0);
/* CIBO / BEVANDE (Enzo, 25/10/2026): due bottoni fermi a sinistra delle
   categorie; si vedono solo le categorie (e i piatti) del tipo scelto. Il
   tipo e' quello di Menu (`menu_categories.kind`); senza tipo = cibo. I
   bottoni ci sono solo se il menu ha tutti e due i tipi. */
const tipoDi = (c: MenuCategoria): "food" | "drink" => (c.kind === "drink" ? "drink" : "food");
const haTipi = categorie.some((c) => tipoDi(c) === "drink") && categorie.some((c) => tipoDi(c) === "food");
const tipoIniziale = "food";
const nascosta = (c: MenuCategoria) => haTipi && tipoDi(c) !== tipoIniziale;
const datiMenu = JSON.stringify(
  categorie.flatMap((c) => c.items).map((p) => ({
    id: p.id,
    nome: p.name,
    prezzo: p.price_cents,
    esaurito: p.is_sold_out,
    formati: (p.variants ?? []).filter((v) => v.orderable).map((v) => ({
      key: v.key,
      nome: v.label_i18n?.[lang] || v.label_i18n?.fr || Object.values(v.label_i18n ?? {})[0] || v.key,
      prezzo: v.price_cents,
      esaurito: v.sold_out,
    })),
  })),
).replace(/</g, "\\u003c");
const ancora = (i: number) => `cat-${i}`;
---

<html lang={lang}>
  <head>
    <PalmareHead titolo={`${titolo} · ${t("sal.ord.title")}`} />
    <style is:global>
      body { min-height: 100vh; min-height: 100dvh; }
      /* ---------- la testa: l'isola, come nella scheda del tavolo ---------- */
      .od-testa {
        position: sticky; top: 0; z-index: 10;
        display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
        padding: max(0.75rem, env(safe-area-inset-top)) 0 0.3rem;
        background: linear-gradient(var(--c-bg) 80%, transparent);
      }
      /* La freccia sta IN BASSO, sotto il pollice, come nella scheda del tavolo. */
      .od-indietro {
        width: 54px; height: 54px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
        background: var(--c-card); color: var(--c-text); border: 1px solid var(--c-line);
      }
      .od-indietro svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
      /* Le categorie: pillole che scorrono, in basso sopra i bottoni. Da bordo
         a bordo dello schermo (il margine negativo annulla quello della barra). */
      .od-cat {
        position: relative; z-index: 0;
        display: flex; gap: 0.4rem; overflow-x: auto; padding: 0 1rem; margin: 0 -1rem;
        scrollbar-width: none; -webkit-overflow-scrolling: touch;
      }
      .od-cat::-webkit-scrollbar { display: none; }
      .od-cat a[hidden] { display: none; }
      /* CIBO / BEVANDE: fermi a sinistra, le categorie scorrono accanto. */
      .od-cat-riga { display: flex; align-items: center; gap: 0.4rem; margin-right: -1rem; }
      .od-cat-riga .od-cat { flex: 1; min-width: 0; margin: 0; padding: 0 1rem 0 0; }
      .od-tipo { flex: none; display: flex; gap: 0.3rem; }
      .od-tipo-btn {
        width: 44px; height: 44px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--c-line); background: var(--c-bg); color: var(--c-text); cursor: pointer;
        transition: background .25s ease, color .25s ease;
      }
      .od-tipo-btn svg { width: 20px; height: 20px; display: block; }
      .od-tipo-btn[aria-pressed="true"] { background: var(--c-accent); color: var(--c-bg); border-color: transparent; }
      .od-cat a {
        flex: 0 0 auto; height: 44px; padding: 0 1.15rem; border-radius: 999px; display: inline-flex; align-items: center;
        border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-text);
        font-size: 0.92rem; font-weight: 700; text-decoration: none; white-space: nowrap;
      }
      /* Le parole stanno SOPRA il segno che scivola; il fondo delle pillole sotto. */
      .od-cat a > span { position: relative; z-index: 2; }
      .od-cat a { transition: color .3s ease, border-color .3s ease; }
      .od-cat a.is-on { color: var(--c-bg); border-color: transparent; }
      .od-cat-segno {
        position: absolute; left: 0; top: 0; z-index: 1; height: 44px; width: 0; border-radius: 999px;
        background: var(--c-text); pointer-events: none; opacity: 0;
        transition: transform .38s cubic-bezier(.3, .9, .3, 1), width .38s cubic-bezier(.3, .9, .3, 1), opacity .2s;
      }
      .od-cat-segno.is-pronto { opacity: 1; }
      /* Senza il segno (prima che lo script parta) la pillola accesa ha il suo fondo. */
      .od-cat:not(.ha-segno) a.is-on { background: var(--c-text); }

      /* ---------- i piatti ---------- */
      /* Il contenuto subito sotto l'isola (Enzo, 25/10/2026): il margine del
         primo titolo visibile (qualunque sia, col filtro cibo/bevande) si
         mangia col margine negativo. */
      .od { padding: 0 1rem calc(175px + env(safe-area-inset-bottom)); margin-top: -0.9rem; }
      .od h2 { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-muted); margin: 1.1rem 0 0.5rem; scroll-margin-top: 92px; }
      /* align-items start: un piatto senza foto accanto a uno con la foto non si allunga a vuoto. */
      .od-griglia { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; align-items: start; }
      .od-piatto {
        position: relative; min-height: 76px; padding: 0.65rem 0.75rem; border-radius: 16px; text-align: left;
        display: flex; flex-direction: column; justify-content: space-between; gap: 0.3rem;
        border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-text); font: inherit; cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }
      /* Il tocco: la scheda si abbassa un attimo e torna (23/10/2026). */
      .od-piatto { transition: transform .12s ease, border-color .2s ease, box-shadow .2s ease; }
      .od-piatto:active { transform: scale(0.96); }
      .od-piatto b { font-size: 0.92rem; line-height: 1.2; padding-right: 1.6rem; }
      .od-piatto span { font-size: 0.8rem; color: var(--c-muted); }
      /* Scelto: il bordo accent senza cambiare misura (niente salti). */
      .od-piatto.ha-qty { border-color: var(--c-accent); box-shadow: inset 0 0 0 1px var(--c-accent); }
      /* La foto in cima alla scheda, da bordo a bordo. */
      .od-foto { display: block; margin: -0.65rem -0.75rem 0.15rem; border-radius: 15px 15px 0 0; overflow: hidden; background: var(--c-bg); }
      .od-foto img { display: block; object-fit: cover; }
      .od-piatto:disabled { opacity: 0.4; cursor: default; }
      .od-piatto:disabled b { text-decoration: line-through; }
      .od-qty {
        position: absolute; top: 8px; right: 8px; min-width: 24px; height: 24px; padding: 0 6px; border-radius: 12px;
        display: none; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800;
        background: var(--c-accent); color: var(--c-bg);
      }
      .od-piatto.ha-qty .od-qty { display: inline-flex; }
      /* ⚠️ `.od-piatto span` (il prezzo, grigio) vinceva sul numero: qui il colore torna pieno. */
      .od-piatto .od-qty { color: var(--c-bg); }
      /* Il numero «salta» quando cambia, e anche il bottone del Récap. */
      @keyframes od-pop { 0% { transform: scale(.6); } 60% { transform: scale(1.18); } 100% { transform: scale(1); } }
      @keyframes od-batti { 0% { transform: scale(1); } 40% { transform: scale(1.04); } 100% { transform: scale(1); } }
      .od-qty.is-pop { animation: od-pop .32s cubic-bezier(.3, .9, .3, 1.2); }
      .od-recap-btn.is-pop { animation: od-batti .3s ease; }
      /* I piatti entrano salendo appena, quando arrivano sullo schermo. La
         classe la mette lo script: senza script si vede tutto subito. */
      .od-anima .od-piatto { opacity: 0; transform: translateY(10px); }
      .od-anima .od-piatto.is-visto { opacity: 1; transform: none; transition: opacity .35s ease, transform .35s ease, border-color .2s ease, box-shadow .2s ease; }
      .od-anima .od-piatto.is-visto:active { transform: scale(0.96); transition: transform .12s ease; }
      .od-anima .od-piatto:disabled.is-visto { opacity: 0.4; }
      @media (prefers-reduced-motion: reduce) {
        .od-cat-segno, .od-cat a, .od-piatto, .od-anima .od-piatto.is-visto { transition: none !important; }
        .od-qty.is-pop, .od-recap-btn.is-pop { animation: none; }
        .od-anima .od-piatto { opacity: 1; transform: none; }
        .od-anima .od-piatto:disabled { opacity: 0.4; }
      }
      .od-blocco { margin: 2rem 1rem; padding: 1rem; border-radius: 18px; background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted); line-height: 1.5; }

      /* ---------- il carrello in basso ---------- */
      /* Flottante, come le isole: niente barra piena, una sfumatura del fondo. */
      .od-barra {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
        display: flex; flex-direction: column; gap: 0.6rem;
        padding: 1.5rem 1rem calc(env(safe-area-inset-bottom) + 0.6rem);
        background: linear-gradient(transparent, var(--c-bg) 45%); pointer-events: none;
      }
      .od-barra > * { pointer-events: auto; }
      .od-barra-riga { display: flex; align-items: center; gap: 0.5rem; }
      .od-recap-btn {
        flex: 1; min-width: 0; height: 54px; border-radius: 999px; border: none; padding: 0 1.25rem;
        display: flex; align-items: center; justify-content: space-between;
        background: var(--c-accent); color: var(--c-bg); font: inherit; font-weight: 800; font-size: 1rem; cursor: pointer;
      }
      .od-recap-btn:disabled { opacity: 0.45; }

      /* ---------- i fogli dal basso: formato e riepilogo ---------- */
      .od-foglio { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(0, 0, 0, 0.55); }
      .od-foglio[hidden] { display: none; }
      .od-foglio-box {
        width: 100%; max-height: 88dvh; overflow-y: auto; border-radius: 24px 24px 0 0;
        background: var(--c-card); padding: 0.6rem 1rem calc(env(safe-area-inset-bottom) + 1rem);
        display: flex; flex-direction: column; gap: 0.75rem;
      }
      .od-maniglia { width: 44px; height: 5px; border-radius: 3px; background: var(--c-line); align-self: center; }
      .od-foglio-testa { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
      .od-foglio-testa h2 { font-size: 1.1rem; margin: 0; }
      .od-chiudi { width: 40px; height: 40px; border-radius: 50%; border: none; background: color-mix(in srgb, var(--c-text) 10%, transparent); color: var(--c-text); font-size: 1.2rem; cursor: pointer; }
      .od-formato {
        min-height: 52px; border-radius: 14px; padding: 0 1rem; display: flex; align-items: center; justify-content: space-between;
        border: 1px solid var(--c-line); background: var(--c-bg); color: var(--c-text); font: inherit; font-weight: 700; cursor: pointer;
      }
      .od-formato:disabled { opacity: 0.4; }
      /* ---------- il recap: una pagina ---------- */
      .od-recap-pagina { display: flex; flex-direction: column; gap: 0.6rem; padding: 0 1rem calc(190px + env(safe-area-inset-bottom)); }
      .od-recap-pagina[hidden], .od-barra-recap[hidden] { display: none; }
      body.is-recap main.od, body.is-recap .od-barra:not(.od-barra-recap) { display: none; }
      .od-recap-tit { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-muted); margin: 0.2rem 0 -0.1rem; } /* alla stessa altezza dei titoli delle categorie */
      .od-righe { display: flex; flex-direction: column; gap: 0.6rem; }
      .od-riga { display: flex; flex-direction: column; gap: 0.55rem; padding: 0.8rem 0.9rem; border-radius: 18px; background: var(--c-card); border: 1px solid var(--c-line); }
      .od-com-btn {
        align-self: flex-start; height: 36px; padding: 0 0.9rem; border-radius: 999px; cursor: pointer;
        border: 1px dashed var(--c-line); background: transparent; color: var(--c-muted); font: inherit; font-size: 0.85rem; font-weight: 700;
      }
      .od-com-btn[hidden] { display: none; }
      .od-barra-recap .od-invia { flex: 1; min-width: 0; }
      .od-totale-pill {
        align-self: center; display: inline-flex; align-items: baseline; gap: 0.75rem; min-height: 44px; padding: 0.55rem 1.25rem;
        border-radius: 999px; background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
      }
      .od-totale-pill span { font-size: 0.8rem; color: var(--c-muted); }
      .od-totale-pill strong { font-size: 1.15rem; font-weight: 800; font-variant-numeric: tabular-nums; }
      button.od-indietro { cursor: pointer; font: inherit; }
      .od-riga-su { display: flex; align-items: center; gap: 0.6rem; }
      .od-riga-nome { flex: 1; min-width: 0; font-weight: 700; }
      .od-riga-nome small { display: block; font-weight: 400; color: var(--c-muted); font-size: 0.8rem; }
      .od-passo { display: flex; align-items: center; background: var(--c-bg); border-radius: 12px; }
      .od-passo button { width: 40px; height: 40px; border: none; background: transparent; color: var(--c-text); font-size: 1.2rem; cursor: pointer; }
      .od-passo b { min-width: 1.6rem; text-align: center; }
      .od-nota {
        width: 100%; min-height: 64px; resize: vertical; border-radius: 12px; border: 1px solid var(--c-line);
        background: var(--c-bg); color: var(--c-text); font: inherit; font-size: 16px; padding: 0.6rem 0.75rem; line-height: 1.35;
      }
      .od-nota[hidden] { display: none; }
      .od-nota:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 1px; }
      .od-totale { display: flex; justify-content: space-between; font-weight: 800; font-size: 1.05rem; }
      .od-invia { height: 54px; border-radius: 999px; border: none; background: var(--c-accent); color: var(--c-bg); font: inherit; font-weight: 800; font-size: 1rem; cursor: pointer; }
      .od-invia:disabled { opacity: 0.5; }
      .od-errore { color: #ff8a80; font-size: 0.85rem; text-align: center; min-height: 1em; }
      /* Vuoto non occupa posto: freccia e «Envoyer» stanno alla stessa altezza
         della freccia e del «Récap» della pagina dei piatti (Enzo, 25/10/2026). */
      .od-errore:empty { display: none; }
    </style>
  </head>
  <body>
    <header class="od-testa">
      {/* La STESSA isola della scheda del tavolo (Enzo, 23/10/2026: «deve
          essere sempre uguale»): `components/admin/IsolaTavolo.astro`. */}
      <IsolaTavolo scheda={s} lang={lang} />
    </header>

    {bloccato ? (
      <Fragment>
        <p class="od-blocco">{bloccato}</p>
        <div class="od-barra">
          <a class="od-indietro" href={ritorno} aria-label={t("sal.tb.back")}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          </a>
        </div>
      </Fragment>
    ) : (
      <main class="od">
        {categorie.map((c, i) => (
          <section data-tipo={tipoDi(c)} hidden={nascosta(c)}>
            <h2 id={ancora(i)}>{c.category}</h2>
            <div class="od-griglia">
              {c.items.map((p) => (
                <button type="button" class:list={["od-piatto", { "ha-foto": Boolean(p.image_url) }]} data-id={p.id} disabled={p.is_sold_out}>
                  {/* La foto del piatto, se c'e' (Enzo, 23/10/2026): si riconosce prima
                      di leggere. Posto riservato (16/10) e caricata solo quando arriva
                      sullo schermo, come in tutto il motore (`Immagine`). */}
                  {p.image_url && <span class="od-foto"><Immagine src={p.image_url} alt="" rapporto="16/10" /></span>}
                  <b>{p.name}</b>
                  <span>{p.is_sold_out ? t("sal.ord.soldOut") : `${(p.variants ?? []).filter((v) => v.orderable).length > 1 ? "≥ " : ""}${euro(p.price_cents)}`}</span>
                  <span class="od-qty" aria-hidden="true"></span>
                </button>
              ))}
            </div>
          </section>
        ))}
      </main>
    )}

    {!bloccato && (
      <Fragment>
        <div class="od-barra">
          {/* Le categorie IN BASSO, sopra i bottoni (Enzo, 23/10/2026): sotto
              il pollice, come tutto quello che si tocca spesso. */}
          {(categorie.length > 1 || haTipi) && (
            <div class="od-cat-riga">
              {haTipi && (
                <div class="od-tipo" role="group" aria-label={t("sal.ord.title")}>
                  <button type="button" class="od-tipo-btn" data-tipo="food" aria-pressed="true" aria-label={t("tab.menu.food")} title={t("tab.menu.food")} set:html={ICONA_CIBO} />
                  <button type="button" class="od-tipo-btn" data-tipo="drink" aria-pressed="false" aria-label={t("tab.menu.drink")} title={t("tab.menu.drink")} set:html={ICONA_BEVANDA} />
                </div>
              )}
              <nav class="od-cat" aria-label={t("sal.ord.title")}>
                {/* La pillola accesa e' un segno che SCIVOLA da una categoria
                    all'altra (Enzo, 23/10/2026), sotto le parole. */}
                <span class="od-cat-segno" id="od-cat-segno" aria-hidden="true"></span>
                {categorie.map((c, i) => <a href={`#${ancora(i)}`} data-cat={ancora(i)} data-tipo={tipoDi(c)} hidden={nascosta(c)} class:list={[{ "is-on": i === categorie.findIndex((x) => !nascosta(x)) }]}><span>{c.category}</span></a>)}
              </nav>
            </div>
          )}
          <div class="od-barra-riga">
            <a class="od-indietro" href={ritorno} aria-label={t("sal.tb.back")}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
            </a>
            <button type="button" class="od-recap-btn" id="od-recap-btn" disabled>
              <span id="od-conta">{t("sal.ord.items").replace("{n}", "0")}</span>
              <span>{t("sal.ord.recap")} →</span>
            </button>
          </div>
        </div>

        <div class="od-foglio" id="od-formati" hidden>
          <div class="od-foglio-box" role="dialog" aria-modal="true" aria-labelledby="od-formati-tit">
            <span class="od-maniglia" aria-hidden="true"></span>
            <div class="od-foglio-testa">
              <h2 id="od-formati-tit"></h2>
              <button type="button" class="od-chiudi" data-chiudi aria-label={t("sal.ord.close")}>×</button>
            </div>
            <p class="tb-sotto">{t("sal.ord.chooseFormat")}</p>
            <div id="od-formati-lista" style="display:flex;flex-direction:column;gap:0.5rem"></div>
          </div>
        </div>

        {/* IL RECAP E' UNA PAGINA, non un modale (Enzo, 24/10/2026): i piatti
            scelti in schede, − / + e un COMMENTO per piatto. Il commento va
            sull'ordine (`notes` del piatto): esce sul ticket della cucina, in
            grande, e nel riepilogo degli ordini del tavolo. La freccia torna
            al menu senza perdere niente (anche il «indietro» del telefono). */}
        <section class="od-recap-pagina" id="od-recap" hidden aria-labelledby="od-recap-tit">
          <h2 class="od-recap-tit" id="od-recap-tit">{t("sal.ord.recap")}</h2>
          <div class="od-righe" id="od-righe"></div>
        </section>
        <div class="od-barra od-barra-recap" id="od-barra-recap" hidden>
          <p class="od-totale-pill"><span>{t("sal.tb.total")}</span><strong id="od-totale"></strong></p>
          <div class="od-barra-riga">
            <button type="button" class="od-indietro" id="od-recap-indietro" aria-label={t("sal.tb.back")}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
            </button>
            <button type="button" class="od-invia" id="od-invia">{t("sal.ord.send")}</button>
          </div>
          <p class="od-errore" id="od-errore" role="status"></p>
        </div>

        <script type="application/json" id="od-dati" is:inline set:html={datiMenu}></script>
        <div id="od-parole" hidden
          data-tavolo={id}
          data-ritorno={ritorno}
          data-loc={LOC}
          data-items={t("sal.ord.items")}
          data-note={t("sal.ord.notePh")}
          data-add-note={t("sal.ord.addNote")}
          data-sending={t("sal.ord.sending")}
          data-send={t("sal.ord.send")}
          data-sold={t("sal.ord.soldOut")}
          data-error={t("sal.ord.err.save")}></div>
      </Fragment>
    )}

    <script>
      import { authFresh } from "../../../lib/admin/auth";
      import { importoDa } from "../../../lib/soldi";

      type Formato = { key: string; nome: string; prezzo: number; esaurito: boolean };
      type Piatto = { id: string; nome: string; prezzo: number; esaurito: boolean; formati: Formato[] };
      type Riga = { chiave: string; id: string; nome: string; formato: string; formatoNome: string; prezzo: number; qty: number; nota: string };

      const datiEl = document.getElementById("od-dati");
      const P = (document.getElementById("od-parole")?.dataset ?? {}) as Record<string, string>;
      if (datiEl) {
        const piatti = new Map((JSON.parse(datiEl.textContent || "[]") as Piatto[]).map((p) => [p.id, p]));
        const euro = (c: number) => importoDa(c, P.loc || "fr-BE");
        const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));
        // Il carrello: una riga per piatto + formato. La nota si scrive nel riepilogo.
        const carrello: Riga[] = [];

        const aggiungi = (p: Piatto, f: Formato | null) => {
          const chiave = `${p.id}|${f?.key ?? ""}`;
          const r = carrello.find((x) => x.chiave === chiave);
          if (r) r.qty += 1;
          else carrello.push({ chiave, id: p.id, nome: p.nome, formato: f?.key ?? "", formatoNome: f?.nome ?? "", prezzo: f ? f.prezzo : p.prezzo, qty: 1, nota: "" });
          aggiorna();
        };
        // Rifa' partire l'animazione «pop» (togliere, ridisegnare, rimettere).
        const salta = (el: HTMLElement) => {
          el.classList.remove("is-pop");
          void el.offsetWidth;
          el.classList.add("is-pop");
        };
        let pezziPrima = 0;
        const aggiorna = () => {
          const pezzi = carrello.reduce((n, r) => n + r.qty, 0);
          const conta = document.getElementById("od-conta");
          if (conta) conta.textContent = `${(P.items ?? "").replace("{n}", String(pezzi))} · ${euro(carrello.reduce((t, r) => t + r.prezzo * r.qty, 0))}`;
          const btn = document.getElementById("od-recap-btn") as HTMLButtonElement | null;
          if (btn) btn.disabled = pezzi === 0;
          if (btn && pezzi > pezziPrima) salta(btn);
          pezziPrima = pezzi;
          // Il numero sul piatto: tutti i suoi formati insieme.
          document.querySelectorAll<HTMLElement>(".od-piatto").forEach((b) => {
            const q = carrello.filter((r) => r.id === b.dataset.id).reduce((n, r) => n + r.qty, 0);
            b.classList.toggle("ha-qty", q > 0);
            const badge = b.querySelector<HTMLElement>(".od-qty");
            if (!badge) return;
            const prima = badge.textContent ?? "";
            badge.textContent = q ? String(q) : "";
            if (q && badge.textContent !== prima) salta(badge);
          });
        };

        // ---- I fogli ----
        const apri = (id: string) => { const f = document.getElementById(id); if (f) f.hidden = false; };
        const chiudi = (f: Element | null) => { if (f instanceof HTMLElement) f.hidden = true; };
        document.querySelectorAll(".od-foglio").forEach((f) => {
          f.addEventListener("click", (e) => {
            const t = e.target as HTMLElement;
            if (t === f || t.closest("[data-chiudi]")) chiudi(f);
          });
        });

        // ---- Un tocco = +1; con piu' formati, si sceglie il formato ----
        document.querySelectorAll<HTMLButtonElement>(".od-piatto").forEach((b) => b.addEventListener("click", () => {
          const p = piatti.get(b.dataset.id ?? "");
          if (!p || p.esaurito) return;
          if (p.formati.length <= 1) { aggiungi(p, p.formati[0] ?? null); return; }
          const tit = document.getElementById("od-formati-tit");
          const lista = document.getElementById("od-formati-lista");
          if (tit) tit.textContent = p.nome;
          if (lista) {
            lista.innerHTML = p.formati.map((f, i) => `<button type="button" class="od-formato" data-i="${i}" ${f.esaurito ? "disabled" : ""}>
              <span>${esc(f.nome)}</span><span>${f.esaurito ? esc(P.sold ?? "") : esc(euro(f.prezzo))}</span></button>`).join("");
            lista.querySelectorAll<HTMLButtonElement>(".od-formato").forEach((fb) => fb.addEventListener("click", () => {
              const f = p.formati[Number(fb.dataset.i)];
              if (f && !f.esaurito) aggiungi(p, f);
              chiudi(document.getElementById("od-formati"));
            }));
          }
          apri("od-formati");
        }));

        // ---- Il riepilogo: quantita' e nota per riga ----
        const disegnaRiepilogo = () => {
          const box = document.getElementById("od-righe");
          if (!box) return;
          box.innerHTML = carrello.map((r, i) => `
            <div class="od-riga">
              <div class="od-riga-su">
                <span class="od-riga-nome">${esc(r.nome)}${r.formatoNome ? `<small>${esc(r.formatoNome)}</small>` : ""}</span>
                <span class="od-passo">
                  <button type="button" data-meno="${i}" aria-label="−">−</button><b>${r.qty}</b><button type="button" data-piu="${i}" aria-label="+">+</button>
                </span>
              </div>
              <button type="button" class="od-com-btn" data-com="${i}"${r.nota ? " hidden" : ""}>${esc(P.addNote ?? "")}</button>
              <textarea class="od-nota" data-nota="${i}" maxlength="200" rows="2" placeholder="${esc(P.note ?? "")}"${r.nota ? "" : " hidden"}>${esc(r.nota)}</textarea>
            </div>`).join("");
          // «+ Commentaire»: apre il campo di quel piatto, gia' pronto a scrivere.
          box.querySelectorAll<HTMLButtonElement>("[data-com]").forEach((b) => b.addEventListener("click", () => {
            const campo = box.querySelector<HTMLTextAreaElement>(`[data-nota="${b.dataset.com}"]`);
            b.hidden = true;
            if (campo) { campo.hidden = false; campo.focus(); }
          }));
          box.querySelectorAll<HTMLButtonElement>("[data-meno]").forEach((b) => b.addEventListener("click", () => {
            const i = Number(b.dataset.meno);
            if (!carrello[i]) return;
            carrello[i].qty -= 1;
            if (carrello[i].qty <= 0) carrello.splice(i, 1);
            aggiorna(); disegnaRiepilogo();
            if (!carrello.length) chiudiRecap();
          }));
          box.querySelectorAll<HTMLButtonElement>("[data-piu]").forEach((b) => b.addEventListener("click", () => {
            const r = carrello[Number(b.dataset.piu)];
            if (r) { r.qty += 1; aggiorna(); disegnaRiepilogo(); }
          }));
          box.querySelectorAll<HTMLTextAreaElement>("[data-nota]").forEach((inp) => inp.addEventListener("input", () => {
            const r = carrello[Number(inp.dataset.nota)];
            if (r) r.nota = inp.value;
          }));
          const tot = document.getElementById("od-totale");
          if (tot) tot.textContent = euro(carrello.reduce((t, r) => t + r.prezzo * r.qty, 0));
        };
        // ---- Il recap come PAGINA: si apre al posto del menu; la freccia e
        // l'«indietro» del telefono tornano ai piatti, il carrello resta. ----
        const recap = document.getElementById("od-recap");
        const barraRecap = document.getElementById("od-barra-recap");
        const mostraRecap = (si: boolean) => {
          if (recap) recap.hidden = !si;
          if (barraRecap) barraRecap.hidden = !si;
          document.body.classList.toggle("is-recap", si);
          window.scrollTo(0, 0);
        };
        const chiudiRecap = () => {
          if (history.state && (history.state as { recap?: boolean }).recap) history.back();
          else mostraRecap(false);
        };
        window.addEventListener("popstate", () => mostraRecap(Boolean((history.state as { recap?: boolean } | null)?.recap)));
        document.getElementById("od-recap-btn")?.addEventListener("click", () => {
          disegnaRiepilogo();
          history.pushState({ recap: true }, "");
          mostraRecap(true);
        });
        document.getElementById("od-recap-indietro")?.addEventListener("click", chiudiRecap);

        // ---- Mandare in cucina ----
        const invia = document.getElementById("od-invia") as HTMLButtonElement | null;
        const errore = document.getElementById("od-errore");
        invia?.addEventListener("click", async () => {
          if (!carrello.length) return;
          invia.disabled = true;
          invia.textContent = P.sending ?? "";
          if (errore) errore.textContent = "";
          try {
            const res = await fetch("/api/admin/salle-order", {
              method: "POST",
              headers: await authFresh(),
              body: JSON.stringify({
                table: P.tavolo,
                items: carrello.map((r) => ({ id: r.id, qty: r.qty, variant: r.formato || undefined, note: r.nota.trim() || undefined })),
              }),
            });
            const j = (await res.json().catch(() => ({}))) as { error?: string };
            if (res.ok) { window.location.replace(`${P.ritorno}&inviato=1`); return; }
            if (errore) errore.textContent = j.error ?? P.error ?? "";
          } catch {
            if (errore) errore.textContent = P.error ?? "";
          }
          invia.disabled = false;
          invia.textContent = P.send ?? "";
        });

        // ---- LE CATEGORIE (23/10/2026): il segno scivola, la fila scorre
        // morbida, e toccare una categoria ci porta piano, non a salti. ----
        const pillole = [...document.querySelectorAll<HTMLAnchorElement>(".od-cat a")];
        const fila = document.querySelector<HTMLElement>(".od-cat");
        const segno = document.getElementById("od-cat-segno");
        const morbido: ScrollBehavior = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
        const accendi = (id: string) => {
          const a = pillole.find((x) => x.dataset.cat === id);
          if (!a || !fila) return;
          pillole.forEach((x) => x.classList.toggle("is-on", x === a));
          if (segno) {
            segno.style.width = `${a.offsetWidth}px`;
            segno.style.transform = `translate(${a.offsetLeft}px, ${a.offsetTop}px)`;
          }
          // La fila scorre da sola, senza muovere la pagina.
          fila.scrollTo({ left: a.offsetLeft - (fila.clientWidth - a.offsetWidth) / 2, behavior: morbido });
        };
        if (fila && segno && pillole.length) {
          fila.classList.add("ha-segno");
          accendi(pillole.find((x) => x.classList.contains("is-on"))?.dataset.cat ?? pillole[0].dataset.cat ?? "");
          // Prima posizione senza scivolare, poi si accende.
          requestAnimationFrame(() => segno.classList.add("is-pronto"));
        }
        let mentreScorre = 0;
        // CIBO / BEVANDE: si vedono solo le categorie (e i piatti) del tipo.
        const tipi = [...document.querySelectorAll<HTMLButtonElement>(".od-tipo-btn")];
        tipi.forEach((b) => b.addEventListener("click", () => {
          const tipo = b.dataset.tipo ?? "food";
          if (b.getAttribute("aria-pressed") === "true") return;
          tipi.forEach((x) => x.setAttribute("aria-pressed", x === b ? "true" : "false"));
          document.querySelectorAll<HTMLElement>(".od section[data-tipo], .od-cat a[data-tipo]").forEach((el) => {
            el.hidden = el.dataset.tipo !== tipo;
          });
          window.scrollTo({ top: 0, behavior: "auto" });
          mentreScorre = Date.now() + 400;
          fila?.scrollTo({ left: 0, behavior: "auto" });
          const prima = pillole.find((x) => !x.hidden);
          if (prima) accendi(prima.dataset.cat ?? "");
        }));
        pillole.forEach((a) => a.addEventListener("click", (e) => {
          const meta = document.getElementById(a.dataset.cat ?? "");
          if (!meta) return;
          e.preventDefault();
          accendi(a.dataset.cat ?? "");
          // Durante lo scorrimento morbido la pillola resta quella toccata.
          mentreScorre = Date.now() + 900;
          meta.scrollIntoView({ behavior: morbido, block: "start" });
        }));
        if (pillole.length && "IntersectionObserver" in window) {
          const occhio = new IntersectionObserver((voci) => {
            if (Date.now() < mentreScorre) return;
            // La PRIMA categoria visibile (all'apertura arrivano tutte insieme:
            // prendere l'ultima accendeva «Pasta» con gli antipasti in cima).
            const prima = voci.filter((v) => v.isIntersecting)
              .sort((x, y) => x.boundingClientRect.top - y.boundingClientRect.top)[0];
            if (prima) accendi((prima.target as HTMLElement).id);
          }, { rootMargin: "-85px 0px -55% 0px" });
          document.querySelectorAll(".od h2[id]").forEach((h) => occhio.observe(h));
        }

        // ---- I PIATTI entrano salendo appena, una volta sola ----
        const lista = document.querySelector<HTMLElement>(".od");
        if (lista && "IntersectionObserver" in window && morbido === "smooth") {
          lista.classList.add("od-anima");
          const vista = new IntersectionObserver((voci) => {
            voci.forEach((v) => {
              if (!v.isIntersecting) return;
              const el = v.target as HTMLElement;
              // In fila: il secondo della riga arriva un soffio dopo il primo.
              const i = [...(el.parentElement?.children ?? [])].indexOf(el);
              el.style.transitionDelay = `${(i % 2) * 60}ms`;
              el.classList.add("is-visto");
              vista.unobserve(el);
              // Il ritardo serve solo all'entrata: dopo, il tocco risponde subito.
              window.setTimeout(() => { el.style.transitionDelay = ""; }, 500);
            });
          }, { rootMargin: "0px 0px -20px 0px" });
          lista.querySelectorAll(".od-piatto").forEach((p) => vista.observe(p));
        }
      }
    </script>
  </body>
</html>
