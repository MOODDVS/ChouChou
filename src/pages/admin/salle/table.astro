---
/**
 * LA SCHEDA DEL TAVOLO SUL PALMARE — /admin/salle/table?id=… (22/10/2026).
 *
 * Si apre toccando un tavolo sulla piantina di /admin/salle. Pagina intera,
 * con la freccia per tornare alla sala (deciso con Enzo).
 *
 * Cosa dice, in quest'ordine (le regole in `lib/admin/schedaTavolo.ts`):
 *  - il tavolo: nome, sala, posti;
 *  - se qualcuno chiama o chiede l'addizione;
 *  - lo stato: conto aperto (da validare / aperto, con codice, chi ha
 *    ordinato, totale / pagato / resto e gli invii), oppure la sessione seduta
 *    con i suoi ordini, oppure «Libre»;
 *  - la prossima prenotazione di oggi su questo tavolo.
 * In fondo i bottoni del cameriere: per ora SOLO DISEGNO, spenti — Commander,
 * Addition, Encaisser, Déplacer arrivano dopo, un passo alla volta.
 *
 * UN TAVOLO LIBERO (23/10/2026): «quanti siete?», poi le proposte — il tavolo
 * da solo se basta, altrimenti i tavoli COLLEGATI (le catene del piano) — e
 * «Installer», che crea la prenotazione seduta e blocca i tavoli scelti
 * (`/api/admin/salle-seat`, l'unica API del palmare). Le proposte si
 * ricalcolano nel browser a ogni tocco: le regole sono pure
 * (`lib/salaInstallaRegole.ts`) e i dati arrivano nella pagina.
 *
 * IL MODALE DELL'ISOLA (23/10/2026): su un tavolo occupato l'isola in alto e'
 * un bottone. Apre le PERSONE (− / + e «Enregistrer») e «Déplacer», con le
 * tre possibilita': cambiare tavolo, aggiungerne uno, liberarne uno
 * (`/api/admin/salle-seat`, azioni «persone» e «sposta»).
 *
 * ⚠️ Pagina del palmare: chiave «salle» (chiavePagina prende il primo pezzo
 * del percorso), quindi aperta al ruolo palmare come la sala. Tutto si legge
 * QUI nel render: il palmare non ha API.
 */
import PalmareHead from "../../../components/admin/PalmareHead.astro";
import { linguaPalmare } from "../../../lib/admin/linguaPalmare";
import { adminT, ADMIN_LOCALE } from "../../../i18n/admin";
import { claimsDaToken } from "../../../lib/admin/adminAuth";
import { ambitoDiRichiesta } from "../../../lib/admin/sede";
import { schedaTavolo, type SchedaTavolo } from "../../../lib/admin/schedaTavolo";
import { importoDa } from "../../../lib/soldi";
import { contestoInstallazione, contestoSpostamento, type ContestoInstallazione, type ContestoSpostamento } from "../../../lib/admin/installaTavolo";
import { letturaSala, cronometro } from "../../../lib/admin/letturaSala";
import IsolaTavolo from "../../../components/admin/IsolaTavolo.astro";
import { ICONA_TAVOLO, ICONA_MATITA, ICONA_STAMPA, ICONA_NOTA, ICONA_CESTINO, ICONA_MONETE, ICONA_CARTA, ICONA_QR } from "../../../lib/iconeSala";
import { pagamentoOnlineAttivo } from "../../../lib/admin/sede";

export const prerender = false;

// La lingua del cameriere (il suo telefono), o quella dell'admin.
const lang = await linguaPalmare(Astro.request);
const t = adminT(lang);
const LOC = ADMIN_LOCALE[lang] ?? "fr-BE";
const euro = (c: number) => importoDa(c, LOC);

const id = Astro.url.searchParams.get("id") ?? "";
let s: SchedaTavolo | null = null;
let inst: ContestoInstallazione | null = null;
let mv: ContestoSpostamento | null = null;
/* ⚠️ VELOCITA' (23/10/2026): UNA lettura parallela della sala
   (`letturaSala`), riusata dalla scheda, dalle proposte di «Installer» e dal
   modale: prima erano una decina di letture in fila. Il tempo speso sta in
   `Server-Timing` (strumenti del browser → Rete). */
const crono = cronometro();
let qrAttivo = false;
try {
  const staff = await claimsDaToken(Astro.cookies.get("mdd_at")?.value ?? "");
  const ambito = await ambitoDiRichiesta(Astro.request, staff);
  const lettura = await letturaSala(ambito, { conti: true, chiamate: true });
  crono.tappa("sala");
  s = await schedaTavolo(ambito, id, lettura);
  crono.tappa("tavolo");
  // Solo per un tavolo libero: e' li' che si chiede «quanti siete?».
  if (s && !s.conto && !s.sessione) inst = await contestoInstallazione(ambito, id, lettura);
  // Occupato: il modale dell'isola (persone, «Déplacer») ha bisogno delle sale.
  else if (s) mv = await contestoSpostamento(ambito, id, lettura);
  // Il QR per pagare al tavolo: solo se c'e' da incassare e Stripe e' pronto.
  // ⚠️ Un errore qui non deve spegnere la scheda: senza QR restano contanti e carta.
  if (s?.sessione?.ordini.some((o) => o.modificabile)) qrAttivo = await pagamentoOnlineAttivo(ambito).catch(() => false);
} catch { s = null; }
Astro.response.headers.set("Server-Timing", crono.intestazione());
const libero = Boolean(s && !s.conto && !s.sessione);
/* Seduti ma NESSUN ordine, e nessun conto: se se ne vanno, si annulla e i
   tavoli tornano liberi (23/10/2026). Con un ordine fatto no: c'e' da
   incassare o da annullare l'ordine, ed e' un'altra storia. */
const annullabile = Boolean(s && !s.conto && s.sessione && s.sessione.ordini.length === 0);
/** I dati per il browser: le proposte si calcolano li', a ogni tocco. */
const datiInst = inst && s
  ? JSON.stringify({ tavoloId: s.tavolo.id, nome: s.tavolo.name, ...inst }).replace(/</g, "\\u003c")
  : "";
const NUMERI = [1, 2, 3, 4, 5, 6, 7, 8];
/* IL MODALE DELL'ISOLA (23/10/2026, Enzo): toccando l'isola di un tavolo
   occupato si cambiano le persone e si SPOSTA la tavolata (cambiare tavolo,
   aggiungerne uno, liberarne uno). «Déplacer» non e' piu' un bottone in basso. */
const personeAdesso = s?.conto ? s.conto.persone : (s?.sessione?.persone ?? 0);
const datiMv = mv && s
  ? JSON.stringify({ tavoloId: s.tavolo.id, persone: personeAdesso, ...mv }).replace(/</g, "\\u003c")
  : "";
const cliccabile = Boolean(datiMv);
const haOrdini = Boolean((s?.conto && s.conto.invii.length > 0) || (s?.sessione && s.sessione.ordini.length > 0));

const conto = s?.conto ?? null;
const sessione = s?.sessione ?? null;
/* Il titolo dice TUTTI i tavoli di chi e' seduto qui: un gruppo a T1+T4
   occupa anche T4, e la scheda di T1 lo deve dire (23/10/2026). */
const nomiTavoli = s?.gruppo ? s.gruppo.nomi.join(" + ") : (s?.tavolo.name ?? "");
const titolo = s ? `${t("sal.tb.table")} ${nomiTavoli}` : t("sal.title");
/* L'ISOLA (chi e' seduto, quanti, da quando, timer) la disegna
   `components/admin/IsolaTavolo.astro`, la stessa dell'ordine. */
const personeIsola = personeAdesso;
---

<html lang={lang}>
  <head>
    <PalmareHead titolo={titolo} />
    <style is:global>
      :root { --tb-azioni-h: 110px; }
      body { min-height: 100vh; min-height: 100dvh; }

      /* ---------- la testa: un'ISOLA ferma, come la pillola del cameriere
         nella sala (23/10/2026, coerenza grafica): stessa forma, stesso
         fondo, stessa ombra. Dentro: la freccia tonda, il tavolo, la sala. */
      .tb-testa {
        position: sticky; top: 0; z-index: 20;
        display: flex; justify-content: center;
        padding: max(0.75rem, env(safe-area-inset-top)) 1rem 0.75rem;
        background: linear-gradient(var(--c-bg) 70%, transparent);
      }

      /* ---------- il modale dell'isola: persone e «Déplacer» ---------- */
      .tb-pannello {
        position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%);
        width: calc(100vw - 2rem); max-width: 480px; max-height: calc(100dvh - 120px); overflow-y: auto;
        padding: 16px 12px; border-radius: 20px; display: flex; flex-direction: column; gap: 10px;
        border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-text);
        /* Il modale SI' ha l'ombra (Enzo, 23/10/2026): sta sopra la pagina e
           deve staccarsene. Le altre ombre portate restano tolte. */
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5);
      }
      .tb-pannello[hidden] { display: none; }
      /* Piu' aria fra le sezioni (Enzo, 25/10/2026: «troppo compatto»). */
      .tb-pan-tit + .tb-pan-num, .tb-pan-tit + .tb-ext-btns { margin-top: 2px; }
      .tb-pannello > .tb-pan-tit:not(:first-child), .tb-pannello > .tb-sposta, .tb-pannello > .tb-libera { margin-top: 14px; }
      .tb-pan-tit { padding: 2px 4px 0; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-muted); }
      /* Le persone: 1–9 da toccare, «10+» apre un campo (23/10/2026, Enzo). */
      .tb-pan-num { grid-template-columns: repeat(5, minmax(0, 1fr)); }
      .tb-campo {
        width: 100%; height: 52px; box-sizing: border-box; border-radius: 14px; border: 1px solid var(--c-line);
        background: var(--c-bg); color: var(--c-text); font: inherit; font-size: 1.3rem; font-weight: 800; text-align: center;
      }
      .tb-campo { appearance: textfield; -moz-appearance: textfield; }
      .tb-campo::-webkit-inner-spin-button, .tb-campo::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
      .tb-campo:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 2px; }
      .tb-passo { display: grid; grid-template-columns: 52px minmax(0, 1fr) 52px; gap: 8px; align-items: center; }
      .tb-passo-btn { height: 52px; font-size: 1.5rem; }
      .tb-passo[hidden], #tb-p-salva[hidden], #tb-sposta-ok[hidden] { display: none; }
      #tb-p-salva { flex: none; height: 52px; width: 100%; }
      .tb-sposta {
        display: flex; align-items: center; justify-content: center; gap: 0.6rem; width: 100%;
        min-height: 54px; border-radius: 999px;
        /* Piu' chiaro della scheda e con un bordo che si vede (Enzo, 23/10/2026). */
        border: 2px solid color-mix(in srgb, var(--c-text) 35%, transparent);
        background: color-mix(in srgb, var(--c-text) 12%, var(--c-card));
        color: var(--c-text); font: inherit; font-size: 1rem; font-weight: 800; cursor: pointer;
      }
      .tb-sposta-ico { display: inline-flex; }
      .tb-sposta-ico svg { display: block; width: auto; height: 1.15em; }
      .tb-sposta[aria-expanded="true"] { background: var(--c-text); color: var(--c-bg); border-color: transparent; }
      .tb-modi-box { display: flex; flex-direction: column; gap: 10px; }
      .tb-modi-box[hidden] { display: none; }
      .tb-modi { display: grid; grid-auto-columns: minmax(0, 1fr); grid-auto-flow: column; gap: 8px; }
      .tb-modo {
        min-height: 56px; padding: 0.4rem 0.5rem; border-radius: 14px; border: 1px solid var(--c-line);
        background: var(--c-bg); color: var(--c-text); font: inherit; font-size: 0.85rem; font-weight: 800; line-height: 1.2; cursor: pointer;
      }
      .tb-modo[aria-pressed="true"] { background: var(--c-accent); color: var(--c-bg); border-color: transparent; }
      .tb-zona { padding: 4px 4px 0; font-size: 0.78rem; font-weight: 800; color: var(--c-muted); }
      #tb-sposta-ok { flex: none; height: 52px; width: 100%; }
      .tb-libera { flex: none; width: 100%; height: 52px; }
      .tb-libera-nota { padding: 0 4px; font-size: 0.78rem; line-height: 1.4; color: var(--c-muted); }

      .tb { display: flex; flex-direction: column; gap: 0.75rem; padding: 0.15rem 1rem calc(var(--tb-azioni-h) + env(safe-area-inset-bottom) + 1rem); }

      /* ---------- gli avvisi ---------- */
      .tb-avvisi { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .tb-avviso {
        display: inline-flex; align-items: center; gap: 0.45rem;
        height: 34px; padding: 0 0.85rem; border-radius: 999px;
        font-size: 0.82rem; font-weight: 800; background: var(--c-text); color: var(--c-bg);
      }
      .tb-avviso svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

      /* ---------- le schede ---------- */
      .tb-card { border-radius: 18px; background: var(--c-card); border: 1px solid var(--c-line); padding: 0.95rem 1rem; display: flex; flex-direction: column; gap: 0.6rem; }
      .tb-riga { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
      .tb-stato { align-self: flex-start; display: inline-flex; align-items: center; height: 28px; padding: 0 0.7rem; border-radius: 999px; font-size: 0.78rem; font-weight: 800; }
      .tb-stato.is-attesa { background: #ff9f43; color: #241200; }
      .tb-stato.is-aperto { background: #4cc38a; color: #0b1f14; }
      .tb-stato.is-libero { background: transparent; color: var(--c-muted); border: 1px solid var(--c-line); }
      .tb-sotto { font-size: 0.85rem; color: var(--c-muted); }
      .tb-cifre { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; padding-top: 0.2rem; }
      .tb-cifre div { display: flex; flex-direction: column; gap: 2px; }
      .tb-cifre span { font-size: 0.75rem; color: var(--c-muted); }
      .tb-cifre strong { font-size: 1.05rem; }
      .tb-cifre .is-resto strong { color: var(--c-accent); }
      .tb-libero { font-family: var(--font-title); font-size: 1.5rem; }

      .tb-titolo { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-muted); margin-top: 0; }
      .tb-invio-stato { font-size: 0.78rem; font-weight: 800; }
      .tb-invio-stato.is-partito { color: #4fbe8c; }
      .tb-invio-stato.is-attesa { color: #f0a040; }
      .tb-persona { font-size: 0.8rem; font-weight: 700; color: var(--c-muted); }
      .tb-piatto { display: flex; justify-content: space-between; gap: 0.75rem; font-size: 0.95rem; line-height: 1.35; }
      .tb-piatto em { font-style: normal; color: var(--c-muted); }
      /* Il commento per la cucina, sotto il piatto (come sul ticket, dove esce in grande). */
      /* La VARIANTE e' una pillola, come in Commandes (`.v-chip`); il COMMENTO
         del cameriere ha il fumetto delle note davanti, nel grigio del motore
         (Enzo, 25/10/2026). */
      .tb-variante {
        display: inline-block; margin-left: 0.45rem; vertical-align: 1px;
        font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; line-height: 1.4;
        color: var(--c-accent); border: 1px solid var(--c-accent);
        border-radius: 999px; padding: 0.05rem 0.55rem; white-space: nowrap;
      }
      .tb-piatto-nota { display: flex; align-items: center; gap: 0.35rem; margin-top: 3px; font-size: 0.85rem; color: var(--c-muted); }
      .tb-nota-ico { display: inline-flex; flex: none; }
      .tb-nota-ico svg { width: 14px; height: 14px; display: block; }
      .tb-prossima { display: flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; }
      .tb-prossima svg { width: 20px; height: 20px; flex-shrink: 0; fill: none; stroke: var(--c-muted); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

      /* ---------- i bottoni del cameriere: FLOTTANTI, sotto il pollice ----------
         (23/10/2026) Come le isole: niente barra piena, i bottoni galleggiano
         sopra una sfumatura del fondo. La FRECCIA per tornare alla sala sta
         qui e non in alto: e' il gesto piu' frequente, e in alto il pollice
         non ci arriva. */
      .tb-azioni {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
        display: flex; flex-direction: column; gap: 0.5rem;
        padding: 1.5rem 1rem calc(env(safe-area-inset-bottom) + 0.6rem);
        background: linear-gradient(transparent, var(--c-bg) 40%);
        pointer-events: none;
      }
      .tb-azioni > * { pointer-events: auto; }
      /* Una riga di bottoni: la freccia tonda fissa, gli altri si dividono il resto. */
      .tb-azioni .tb-riga { display: flex; align-items: center; justify-content: flex-start; gap: 0.5rem; }
      .tb-azioni .tb-riga > .tb-btn { flex: 1; min-width: 0; }
      /* Una riga sola: tutti alti come la freccia, il testo non va a capo. */
      .tb-riga-una > .tb-btn { height: 52px; padding: 0 0.4rem; font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .tb-riga-una > .tb-btn.is-primo { flex: 1.35; font-size: 0.92rem; }
      .tb-indietro {
        width: 52px; height: 52px; border-radius: 50%; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        background: var(--c-card); color: var(--c-text); border: 1px solid var(--c-line);
      }
      .tb-indietro svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
      .tb-btn {
        height: 46px; border-radius: 999px; border: 1px solid var(--c-line);
        background: var(--c-card); color: var(--c-text); font: inherit; font-size: 0.88rem; font-weight: 700;
        cursor: pointer;
      }
      .tb-btn.is-primo { flex: 1; height: 52px; background: var(--c-accent); color: var(--c-bg); border-color: transparent; font-size: 1rem; font-weight: 800; }
      .tb-btn:disabled { opacity: 0.45; }
      /* Annuler e Refuser: lo stesso ROSSO del cestino e di «Disconnetti». */
      .tb-btn.is-annulla, #tb-rifiuta { background: #a3320f; color: #fff; border-color: transparent; }
      .tb-presto { text-align: center; font-size: 0.72rem; color: var(--c-muted); }
      .tb-ord-chi { display: inline-flex; align-items: center; gap: 0.5rem; min-width: 0; }
      /* Il punto separa ora e nome del cliente; la faccina basta da sola. */
      .tb-ord-chi > span + span:not(.tb-cam)::before { content: "·"; margin-right: 0.5rem; color: var(--c-muted); }
      .tb-cam { display: inline-flex; align-items: center; gap: 0.4rem; min-width: 0; }
      /* La faccina del cameriere: la foto del Team, o l'iniziale come nella sua pillola. */
      .tb-faccina {
        width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0; object-fit: cover;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--c-accent); color: #fff; font-size: 0.7rem; font-weight: 800;
      }
      /* ---------- modificare un ordine (togliere) ---------- */
      .tb-vista { display: flex; align-items: stretch; justify-content: space-between; gap: 0.75rem; }
      .tb-vista-piatti { align-self: flex-end; }
      .tb-vista-dx { position: relative; flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem; }
      .tb-vista-dx .tb-ord-tot { margin-top: auto; }
      /* Il CESTINO: come la matita sopra; il primo tocco lo fa rosso con
         «Confirmer ?», il secondo annulla (come Annuler e Refuser). */
      .tb-ord-annulla {
        height: 36px; min-width: 36px; padding: 0; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem;
        border: 1px solid var(--c-line); background: var(--c-bg); color: var(--c-text); font: inherit; font-size: 0.8rem; font-weight: 800; cursor: pointer;
        transition: background .2s ease, padding .2s ease;
      }
      .tb-oa-ico { display: inline-flex; }
      .tb-oa-ico svg { width: 17px; height: 17px; display: block; }
      .tb-oa-txt { display: none; white-space: nowrap; }
      .tb-ord-annulla.is-armato { position: absolute; top: 0; right: 0; z-index: 2; padding: 0 0.8rem; background: #a3320f; color: #fff; border-color: transparent; }
      .tb-ord-annulla.is-armato .tb-oa-txt { display: inline; }
      .tb-vista-piatti { min-width: 0; display: flex; flex-direction: column; gap: 0.3rem; }
      .tb-vista .tb-ord-tot { flex-shrink: 0; }
      .tb-ord-tot { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; line-height: 1.1; }
      .tb-ord-tot span { font-size: 0.7rem; color: var(--c-muted); }
      .tb-ord-tot strong { font-size: 1.05rem; font-variant-numeric: tabular-nums; }
      .tb-ord-dx { display: inline-flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
      .tb-ed-apri {
        width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--c-line); background: var(--c-bg); color: var(--c-text); cursor: pointer;
      }
      .tb-ed-apri svg { width: 17px; height: 17px; }
      .tb-ed-apri[aria-expanded="true"] { background: var(--c-accent); color: var(--c-bg); border-color: transparent; }
      .tb-vista[hidden], .tb-ed[hidden] { display: none; }
      .tb-ed { display: flex; flex-direction: column; gap: 0.5rem; }
      .tb-ed-riga { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
      .tb-ed-nome { min-width: 0; font-size: 0.95rem; }
      .tb-ed-nome em { font-style: normal; color: var(--c-muted); }
      .tb-ed-riga.is-zero .tb-ed-nome { text-decoration: line-through; color: var(--c-muted); }
      .tb-ed-passo { display: inline-flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
      .tb-ed-passo .tb-n { width: 44px; height: 44px; font-size: 1.3rem; }
      .tb-ed-passo .tb-n:disabled { opacity: 0.35; }
      .tb-ed-passo b { min-width: 1.6rem; text-align: center; font-variant-numeric: tabular-nums; }
      .tb-ed-azioni { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
      .tb-ed-azioni a.tb-btn, .tb-ed-azioni .tb-btn { height: 48px; font-size: 0.88rem; }
      .tb-ed-salva:disabled { opacity: 0.45; }
      /* «+ Commande», sotto gli ordini: non a tutta larghezza, bordino e testo
         corallo (l'accent) — Enzo, 24/10/2026. */
      a.tb-btn.tb-ordina {
        flex: none; align-self: center; height: 48px; padding: 0 1.6rem; margin-top: 0.25rem;
        background: transparent; color: var(--c-accent); border: 2px solid var(--c-accent);
        font-size: 0.95rem; font-weight: 800;
      }
      a.tb-btn.tb-ordina:active { transform: scale(0.97); }
      /* Il totale accanto alla freccia: una pillola che si prende lo spazio. */
      /* Corallo, come «Récap» nella pagina dei piatti: «Total» a sinistra, la
         cifra a destra (Enzo, 25/10/2026). */
      .tb-riga-una > .tb-totale {
        flex: 1.3; min-width: 0; height: 52px; align-items: center; justify-content: space-between; padding: 0 1.25rem; gap: 0.5rem;
        background: var(--c-accent); color: var(--c-bg); border-color: transparent;
      }
      .tb-riga-una > .tb-totale span { color: var(--c-bg); font-size: 1rem; font-weight: 800; }
      .tb-riga-una > .tb-totale[aria-expanded="true"] { border-color: transparent; }
      .tb-riga-una > .tb-totale strong { font-size: 1.05rem; white-space: nowrap; }
      .tb-totale {
        align-self: center; display: inline-flex; align-items: baseline; gap: 0.75rem;
        min-height: 44px; padding: 0.55rem 1.25rem; border-radius: 999px;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
      }
      .tb-totale span { font-size: 0.8rem; color: var(--c-muted); }
      button.tb-totale { font: inherit; cursor: pointer; }
      .tb-totale[aria-expanded="true"] { border-color: var(--c-accent); }
      /* Il modale del conto: sopra la riga, con l'ombra come gli altri modali. */
      .tb-pan-conto {
        display: flex; flex-direction: column; gap: 10px; padding: 12px; border-radius: 20px;
        border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-text);
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5);
      }
      .tb-pan-conto[hidden] { display: none; }
      /* Evidenti come «Déplacer»: fondo piu' chiaro, bordo di 2px, icona sopra. */
      /* Addition / Encaisser: gli stessi bottoni pillola del palmare, con l'icona del motore. */
      /* «Addition»: la pillola del palmare, sfondo scuro (Enzo, 24/10/2026). */
      .tb-addizione {
        width: 100%; height: 54px; display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
        background: var(--c-bg); border-color: var(--c-line); font-size: 1rem; font-weight: 800;
      }
      .tb-addizione:active { transform: scale(0.98); }
      .tb-pay-home { display: flex; flex-direction: column; gap: 10px; }
      /* ⚠️ `is-primo` ha `flex: 1`: in una colonna si schiaccerebbe. */
      .tb-pay-home > .tb-btn { flex: none; height: 54px; }
      .tb-pay-home[hidden], .tb-pay-modi[hidden], .tb-pay-qr[hidden] { display: none; }
      .tb-pay-modi, .tb-pay-qr { display: flex; flex-direction: column; gap: 10px; }
      /* I modi d'incasso: bottoni grandi da scegliere (fondo scuro), come i
         numeri del modale; un tocco = fatto. */
      .tb-pay-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
      .tb-pay-grid.is-tre { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .tb-pay-modo {
        min-height: 78px; border-radius: 16px; border: 1px solid var(--c-line); background: var(--c-bg); color: var(--c-text);
        font: inherit; font-weight: 800; font-size: 0.95rem; cursor: pointer;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
      }
      .tb-pay-modo span { display: inline-flex; }
      .tb-pay-modo svg { width: 26px; height: 26px; display: block; }
      .tb-pay-modo:active { transform: scale(0.97); }
      .tb-pay-modo:disabled { opacity: 0.5; }
      .tb-pay-indietro { align-self: flex-start; background: none; border: none; color: var(--c-muted); font: inherit; font-size: 0.85rem; font-weight: 700; padding: 2px 4px; cursor: pointer; }
      .tb-qr-img { align-self: center; width: min(70vw, 260px); aspect-ratio: 1; border-radius: 14px; overflow: hidden; background: #fff; }
      .tb-qr-img svg { width: 100%; height: 100%; display: block; }
      .tb-qr-tot { text-align: center; font-size: 1.4rem; font-weight: 800; }
      .tb-conto-esito { text-align: center; font-size: 0.85rem; font-weight: 700; color: #4cc38a; }
      .tb-conto-esito.is-attesa { color: var(--c-muted); }
      .tb-conto-esito.is-errore { color: #ffb59f; }
      .tb-conto-esito[hidden] { display: none; }
      .tb-conto-ico { display: inline-flex; }
      .tb-conto-ico svg { width: auto; height: 20px; display: block; }
      .tb-totale strong { font-size: 1.15rem; font-weight: 800; font-variant-numeric: tabular-nums; }
      .tb-info {
        align-self: center; padding: 0.35rem 0.85rem; border-radius: 999px;
        background: var(--c-card); border: 1px solid var(--c-line); font-size: 0.78rem; color: var(--c-muted);
      }
      a.tb-btn { display: flex; align-items: center; justify-content: center; text-decoration: none; }
      .tb-decidi { display: grid; grid-template-columns: 1fr 2fr; gap: 0.5rem; }
      .tb-btn.is-valida { background: #ff9f43; color: #241200; }
      /* Armato (il primo tocco): piu' acceso, con un alone — il secondo tocco fa. */
      .tb-ext-tit { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }
      .tb-ext-fine { text-transform: none; letter-spacing: 0; font-weight: 700; font-size: 0.8rem; color: var(--c-text); }
      .tb-ext-btns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
      .tb-ext-btn { height: 48px; font-size: 0.95rem; }
      .tb-ext-btn.is-armato { background: #c23b12; color: #fff; border-color: transparent; }
      .tb-ext-btn.is-fatto { background: #4cc38a; color: #0b1f14; border-color: transparent; }
      .tb-ext-avviso { font-size: 0.82rem; line-height: 1.4; color: #ffb59f; padding: 0 4px; }
      .tb-ext-avviso[hidden] { display: none; }
      .tb-btn.is-armato { background: #c23b12; color: #fff; border-color: transparent; box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.35); }
      .tb-avviso-ok { align-self: center; padding: 0.55rem 1rem; border-radius: 999px; background: #4cc38a; color: #0b1f14; font-size: 0.85rem; font-weight: 800; }

      /* ---------- un tavolo libero: quanti sono, e dove ---------- */
      .tb-num { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.45rem; }
      /* I bottoni da scegliere (persone, 1–9 / 10+): PIU' SCURI della scheda
         che li contiene, e la scelta nel colore accent — come la lingua nel
         menu del cameriere (Enzo, 23/10/2026). Vale anche per «quanti siete?». */
      .tb-n {
        height: 48px; border-radius: 14px; border: 1px solid var(--c-line);
        background: var(--c-bg); color: var(--c-text); font: inherit; font-size: 1.05rem; font-weight: 800; cursor: pointer;
      }
      .tb-n[aria-pressed="true"] { background: var(--c-accent); color: var(--c-bg); border-color: transparent; }
      .tb-piu { display: flex; align-items: center; justify-content: center; gap: 0.75rem; }
      .tb-piu[hidden] { display: none; }
      .tb-piu button { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-text); font: inherit; font-size: 1.4rem; cursor: pointer; }
      .tb-piu strong { min-width: 3ch; text-align: center; font-size: 1.4rem; }
      .tb-proposte { display: flex; flex-direction: column; gap: 0.5rem; }
      .tb-prop {
        display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
        min-height: 56px; padding: 0.6rem 1rem; border-radius: 16px; text-align: left;
        border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-text); font: inherit; cursor: pointer;
      }
      .tb-prop[aria-pressed="true"] { border: 2px solid var(--c-accent); }
      .tb-prop-nomi { font-weight: 800; font-size: 1rem; }
      .tb-prop-posti { font-size: 0.82rem; color: var(--c-muted); white-space: nowrap; }
      /* Stretti di una sedia: arancione, si puo' ma va detto. */
      .tb-prop-tag.is-stretto { background: #ff9f43; color: #241200; }
      .tb-prop-tag { display: inline-block; margin-left: 0.4rem; padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.7rem; font-weight: 800; background: #4cc38a; color: #0b1f14; }
      .tb-prop.is-forzata { border-style: dashed; }
      .tb-nessuna { font-size: 0.88rem; color: var(--c-muted); line-height: 1.5; }
      .tb-errore { color: #ff8a80; font-size: 0.85rem; text-align: center; }
      /* Vuoto non occupa posto: i bottoni stanno giu', vicino al pollice. */
      .tb-errore:empty { display: none; }
    </style>
  </head>
  <body>
    <header class="tb-testa">
      {/* L'isola e' la stessa dell'ordine: `components/admin/IsolaTavolo`. */}
      <IsolaTavolo scheda={s} lang={lang} cliccabile={cliccabile}>

      {/* IL MODALE DELL'ISOLA: persone e «Déplacer» (23/10/2026). Largo
          quanto lo schermo, come il menu della pillola del cameriere. */}
      {cliccabile && (
        <div class="tb-pannello" id="tb-pannello" hidden>
          <p class="tb-pan-tit">{t("sal.mv.people")}</p>
          <div class="tb-num tb-pan-num" role="group" aria-label={t("sal.mv.people")}>
            {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => (
              <button type="button" class="tb-n tb-pn" data-n={n} aria-pressed={n === personeIsola ? "true" : "false"}>{n}</button>
            ))}
            <button type="button" class="tb-n tb-pn" data-n="piu" aria-pressed={personeIsola >= 10 ? "true" : "false"}>10+</button>
          </div>
          {/* «10+»: il campo, con − e + ai lati (Enzo, 23/10/2026). */}
          <div class="tb-passo" id="tb-p-passo" hidden={personeIsola < 10}>
            <button type="button" class="tb-n tb-passo-btn" id="tb-p-meno" aria-label="−">−</button>
            <input type="number" class="tb-campo" id="tb-p-campo" inputmode="numeric" min="1" max="100"
              value={personeIsola >= 10 ? personeIsola : 10} aria-label={t("sal.mv.people")} />
            <button type="button" class="tb-n tb-passo-btn" id="tb-p-piu" aria-label="+">+</button>
          </div>
          <button type="button" class="tb-btn is-primo" id="tb-p-salva" hidden>{t("sal.mv.save")}</button>

          {/* PIU' TEMPO AL TAVOLO (Enzo, 23/10/2026): come «Prolonger» in
              Réservations. Se una prenotazione arriva su quei tavoli, il primo
              tocco lo dice e il secondo conferma. */}
          <p class="tb-pan-tit tb-ext-tit">
            <span>{t("sal.ext.title")}</span>
            {mv?.fine && <span class="tb-ext-fine" id="tb-ext-fine" data-tpl={t("sal.ext.end")}>{t("sal.ext.end").replace("{h}", mv.fine)}</span>}
          </p>
          <div class="tb-ext-btns">
            {[15, 30, 45].map((m) => (
              <button type="button" class="tb-n tb-ext-btn" data-min={m} data-testo={`+${m} min`} data-conferma={t("sal.seat.cancelConfirm")}>+{m} min</button>
            ))}
          </div>
          <p class="tb-ext-avviso" id="tb-ext-avviso" role="status" hidden></p>

          <button type="button" class="tb-sposta" id="tb-sposta" aria-expanded="false" aria-controls="tb-modi">
            {/* L'icona del tavolo del motore (`lib/iconeSala.ts`), la stessa di Réservations. */}
            <span class="tb-sposta-ico" aria-hidden="true" set:html={ICONA_TAVOLO} />
            {t("sal.tb.act.move")}
          </button>
          <div class="tb-modi-box" id="tb-modi" hidden>
            <div class="tb-modi" role="group" aria-label={t("sal.tb.act.move")}>
              <button type="button" class="tb-modo" data-modo="cambia" aria-pressed="false">{t("sal.mv.change")}</button>
              <button type="button" class="tb-modo" data-modo="aggiungi" aria-pressed="false">{t("sal.mv.add")}</button>
              {mv && mv.attuali.length > 1 && <button type="button" class="tb-modo" data-modo="libera" aria-pressed="false">{t("sal.mv.free")}</button>}
            </div>
            <div class="tb-proposte" id="tb-opzioni"></div>
            {haOrdini && <p class="tb-nessuna" id="tb-mv-ticket" hidden>{t("sal.mv.tickets")}</p>}
            <button type="button" class="tb-btn is-primo" id="tb-sposta-ok" hidden></button>
          </div>
          {/* LIBERARE IL TAVOLO (25/10/2026): se ne vanno, o cambiano tutto.
              Rosso, doppio tocco. Non per il conto aperto del QR. */}
          {sessione && sessione.ordini.length > 0 && (
            <Fragment>
              <button type="button" class="tb-btn is-annulla tb-libera" id="tb-libera"
                data-testo={t("sal.tb.release")} data-conferma={t("sal.seat.cancelConfirm")}>{t("sal.tb.release")}</button>
              <p class="tb-libera-nota">{t("sal.tb.releaseHint")}</p>
            </Fragment>
          )}
          <p class="tb-errore" id="tb-pan-err" role="status"></p>
        </div>
      )}
      </IsolaTavolo>
    </header>

    <main class="tb">
      {!s ? (
        <section class="tb-card"><p class="tb-sotto">{t("sal.tb.notFound")}</p></section>
      ) : (
        <Fragment>
          {Astro.url.searchParams.get("inviato") === "1" && <p class="tb-avviso-ok" role="status">{t("sal.ord.sent")}</p>}
          {(s.chiamata || s.addizione) && (
            <div class="tb-avvisi">
              {s.chiamata && (
                <span class="tb-avviso">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
                  {t("sal.tb.call")}
                </span>
              )}
              {s.addizione && <span class="tb-avviso">€ {t("sal.tb.bill")}</span>}
            </div>
          )}

          {conto ? (
            <Fragment>
              <section class="tb-card">
                {/* Stato e ora stanno nell'isola in alto. */}
                <div class="tb-riga">
                  <span class="tb-sotto">{t("sal.tb.ordered").replace("{a}", String(conto.ordinato)).replace("{b}", String(conto.persone))}</span>
                  {conto.codice && <span class="tb-sotto">{t("sal.tb.code").replace("{c}", conto.codice)}</span>}
                </div>
                <div class="tb-cifre">
                  <div><span>{t("sal.tb.total")}</span><strong>{euro(conto.totale_cents)}</strong></div>
                  <div><span>{t("sal.tb.paid")}</span><strong>{euro(conto.pagato_cents)}</strong></div>
                  <div class="is-resto"><span>{t("sal.tb.rest")}</span><strong>{euro(conto.resto_cents)}</strong></div>
                </div>
              </section>

              {conto.invii.map((inv) => (
                <section class="tb-card">
                  <div class="tb-riga">
                    <strong>{t("sal.tb.round").replace("{n}", String(inv.numero))}</strong>
                    <span class:list={["tb-invio-stato", inv.partito ? "is-partito" : "is-attesa"]}>
                      {inv.partito ? t("sal.tb.roundSent") : conto.stato === "pending" ? t("sal.val.waiting") : t("sal.tb.roundWaiting")}
                    </span>
                  </div>
                  {inv.righe.map((r) => (
                    <Fragment>
                      {r.nome && <p class="tb-persona">{r.nome}</p>}
                      {r.piatti.map((p) => (
                        <p class="tb-piatto"><span>{p.qty}× {p.nome}{p.variante && <span class="tb-variante">{p.variante}</span>}{p.nota && <span class="tb-piatto-nota"><span class="tb-nota-ico" set:html={ICONA_NOTA} />{p.nota}</span>}</span></p>
                      ))}
                    </Fragment>
                  ))}
                </section>
              ))}
              {/* «Commander» SOTTO gli ordini (Enzo, 24/10/2026): si legge cosa
                  c'e', e subito sotto si aggiunge. */}
              {conto.stato !== "pending" && <a class="tb-btn tb-ordina" href={`/admin/salle/order?id=${encodeURIComponent(s.tavolo.id)}`}>{t("sal.tb.act.addOrder")}</a>}
            </Fragment>
          ) : sessione ? (
            <Fragment>
              {/* Stato, chi, quanti e da quando stanno nell'isola in alto. */}
              {/* Il totale sta in basso, in una pillola sopra i bottoni. */}
              <p class="tb-titolo">{t("sal.tb.orders")}</p>
              {sessione.ordini.length === 0 ? (
                <p class="tb-sotto">{t("sal.tb.noOrders")}</p>
              ) : sessione.ordini.map((o) => (
                <section class="tb-card">
                  <div class="tb-riga">
                    {/* Chi l'ha preso, con la sua faccina (Enzo, 23/10/2026): «Walk-in»
                        non dice niente. Senza cameriere (QR, sito): il nome del
                        cliente, se non e' «Walk-in». */}
                    <strong class="tb-ord-chi">
                      <span>{o.ora}</span>
                      {o.cameriere ? (
                        <span class="tb-cam">
                          {o.cameriere.foto
                            ? <img class="tb-faccina" src={o.cameriere.foto} alt="" width="22" height="22" loading="lazy" />
                            : <span class="tb-faccina" aria-hidden="true">{o.cameriere.nome.slice(0, 1).toUpperCase()}</span>}
                          {o.cameriere.nome}
                        </span>
                      ) : (o.nome && o.nome !== "Walk-in" && <span>{o.nome}</span>)}
                    </strong>
                    <span class="tb-ord-dx">
                      {/* MODIFICARE (23/10/2026): solo togliere, e solo da incassare.
                          Aggiungere = un ordine nuovo, cosi' la cucina riceve il ticket. */}
                      {o.modificabile && (
                        <button type="button" class="tb-ed-apri" aria-expanded="false" title={t("sal.ed.edit")} aria-label={t("sal.ed.edit")} set:html={ICONA_MATITA} />
                      )}
                    </span>
                  </div>
                  {/* I piatti a sinistra, il totale in basso a destra accanto a loro:
                      niente riga in piu' sotto (Enzo, 23/10/2026). */}
                  <div class="tb-vista">
                    <div class="tb-vista-piatti">
                      {o.piatti.map((p) => (
                        <p class="tb-piatto"><span>{p.qty}× {p.nome}{p.variante && <span class="tb-variante">{p.variante}</span>}{p.nota && <span class="tb-piatto-nota"><span class="tb-nota-ico" set:html={ICONA_NOTA} />{p.nota}</span>}</span></p>
                      ))}
                    </div>
                    {/* A destra: il CESTINO sotto la matita (25/10/2026, doppio tocco),
                        e «Total» piccolo SOPRA il numero, in basso (23/10/2026). */}
                    <div class="tb-vista-dx">
                      {o.modificabile && (
                        <button type="button" class="tb-ord-annulla" data-ordine={o.id} title={t("sal.ord.cancel")} aria-label={t("sal.ord.cancel")}>
                          <span class="tb-oa-ico" aria-hidden="true" set:html={ICONA_CESTINO} />
                          <span class="tb-oa-txt">{t("sal.seat.cancelConfirm")}</span>
                        </button>
                      )}
                      <p class="tb-ord-tot"><span>{t("sal.tb.total")}</span><strong>{euro(o.totale_cents)}</strong></p>
                    </div>
                  </div>
                  {o.modificabile && (
                    <div class="tb-ed" data-ordine={o.id} hidden>
                      {o.righe.map((r) => (
                        <div class="tb-ed-riga" data-i={r.i} data-max={r.qty} data-prezzo={r.prezzo}>
                          <span class="tb-ed-nome">{r.nome}{r.variante && <span class="tb-variante">{r.variante}</span>}</span>
                          <span class="tb-ed-passo">
                            <button type="button" class="tb-n" data-d="-1" aria-label="−">−</button>
                            <b>{r.qty}</b>
                            <button type="button" class="tb-n" data-d="1" aria-label="+">+</button>
                          </span>
                        </div>
                      ))}
                      <p class="tb-ord-tot"><span>{t("sal.tb.total")}</span><strong class="tb-ed-tot">{euro(o.totale_cents)}</strong></p>
                      <p class="tb-nessuna tb-ed-avviso" hidden>{t("sal.ed.kitchen")}</p>
                      <p class="tb-nessuna tb-ed-piu" hidden>{t("sal.ed.added")}</p>
                      <p class="tb-nessuna tb-ed-vuoto" hidden>{t("sal.ed.allGone")}</p>
                      <div class="tb-ed-azioni">
                        <a class="tb-btn" href={`/admin/salle/order?id=${encodeURIComponent(s.tavolo.id)}`}>+ {t("sal.ed.add")}</a>
                        <button type="button" class="tb-btn is-primo tb-ed-salva" disabled>{t("sal.mv.save")}</button>
                      </div>
                      <p class="tb-errore tb-ed-err" role="status"></p>
                    </div>
                  )}
                </section>
              ))}
              <a class="tb-btn tb-ordina" href={`/admin/salle/order?id=${encodeURIComponent(s.tavolo.id)}`}>{t("sal.tb.act.addOrder")}</a>
            </Fragment>
          ) : (
            <Fragment>
              <section class="tb-card">
                <span class="tb-stato is-libero">{t("sal.tb.free")}</span>
                <p class="tb-sotto">{t("sal.tb.freeHint")}</p>
              </section>
              {datiInst && (
                <section class="tb-card" id="tb-inst">
                  <p class="tb-titolo" id="tb-quanti">{t("sal.seat.howMany")}</p>
                  <div class="tb-num" role="group" aria-labelledby="tb-quanti">
                    {NUMERI.map((n) => <button type="button" class="tb-n" data-n={n} aria-pressed="false">{n}</button>)}
                    <button type="button" class="tb-n" data-n="piu" aria-pressed="false" aria-label={t("sal.seat.more")}>9+</button>
                  </div>
                  <div class="tb-piu" id="tb-piu" hidden>
                    <button type="button" id="tb-meno" aria-label="−">−</button>
                    <strong id="tb-piu-n">9</strong>
                    <button type="button" id="tb-ancora" aria-label="+">+</button>
                  </div>
                  <p class="tb-titolo" id="tb-dove" hidden>{t("sal.seat.where")}</p>
                  <div class="tb-proposte" id="tb-proposte" role="group" aria-labelledby="tb-dove"></div>
                </section>
              )}
            </Fragment>
          )}

          {s.prossima && (
            <section class="tb-card">
              <p class="tb-prossima">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                <span>
                  <strong>{t("sal.tb.next").replace("{h}", s.prossima.heure)}</strong>
                  {[s.prossima.persone > 0 ? t("sal.tb.people").replace("{n}", String(s.prossima.persone)) : "", s.prossima.nome].filter(Boolean).map((x) => ` · ${x}`).join("")}
                </span>
              </p>
            </section>
          )}
        </Fragment>
      )}
    </main>

    {/* I BOTTONI DEL CAMERIERE, una barra sola che cambia col tavolo:
        - libero → «Installer» (le proposte sono sopra);
        - conto del QR da validare → «Valider et envoyer», e «Refuser» col
          secondo tocco (annulla il conto e i suoi ordini);
        - occupato → «Commander»; se NESSUN ordine e' stato fatto e i clienti
          se ne vanno, «Annuler» libera i tavoli (secondo tocco). Conto e
          Incassa arrivano dopo. «Déplacer» sta nel modale dell'isola.
        La freccia per tornare alla sala e' sempre la prima, a sinistra. */}
    {s && (
      <nav class="tb-azioni" aria-label={titolo}>
        {conto?.stato === "pending" && (
          <p class="tb-info">
            {t("sal.tb.ordered").replace("{a}", String(conto.ordinato)).replace("{b}", String(conto.persone))}
            {conto.codice && ` · ${t("sal.tb.code").replace("{c}", conto.codice)}`}
          </p>
        )}
        {/* ⚠️ La freccia sta sempre sull'ULTIMA riga, la piu' vicina al pollice
            (23/10/2026); l'azione principale sopra, larga. */}
        {(() => {
          const freccia = (
            <a class="tb-indietro" href="/admin/salle" aria-label={t("sal.tb.back")}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
            </a>
          );
          if (libero && datiInst) {
            return <div class="tb-riga">{freccia}<button type="button" class="tb-btn is-primo" id="tb-installa" disabled>{t("sal.seat.btn")}</button></div>;
          }
          if (conto?.stato === "pending") {
            return (
              <Fragment>
                <div class="tb-riga"><button type="button" class="tb-btn is-primo is-valida" id="tb-valida">{t("sal.val.ok")}</button></div>
                <div class="tb-riga">
                  {freccia}
                  <button type="button" class="tb-btn" id="tb-rifiuta" data-testo={t("sal.val.refuse")} data-conferma={t("sal.val.refuseConfirm")}>{t("sal.val.refuse")}</button>
                </div>
              </Fragment>
            );
          }
          if ((sessione || conto) && !libero) {
            /* Una riga sola (Enzo, 24/10/2026): la freccia e ACCANTO il totale.
               Toccando il totale si apre il modale del conto con «Addition» e
               «Encaisser» (per ora spenti: da fare). Senza ordini: «Annuler».
               «Commander» sta sotto gli ordini, nella pagina. */
            const conOrdini = Boolean(sessione && sessione.ordini.length > 0);
            return (
              <Fragment>
                {conOrdini && (
                  <div class="tb-pan-conto" id="tb-pan-conto" hidden>
                    {/* IL CONTO (Enzo, 26/10/2026 — `lib/admin/incassoSeduta.ts`):
                        «Paiement en caisse» = addizione in cassa + richiesta
                        d'addizione (tavolo blu finche' qualcuno incassa);
                        «Encaisser» = contanti / carta (pagato e tavolo libero
                        subito) o QR (paga il cliente, il tavolo si libera da solo). */}
                    <div class="tb-pay-home" id="tb-pay-home">
                      <button type="button" class="tb-btn tb-addizione" id="tb-cassa">
                        <span class="tb-conto-ico" aria-hidden="true" set:html={ICONA_STAMPA} /><span>{t("sal.pay.desk")}</span>
                      </button>
                      {sessione!.ordini.some((o) => o.modificabile) && (
                        <button type="button" class="tb-btn is-primo tb-addizione" id="tb-incassa">
                          <span class="tb-conto-ico" aria-hidden="true" set:html={ICONA_MONETE} /><span>{t("sal.tb.act.pay")}</span>
                        </button>
                      )}
                    </div>
                    <div class="tb-pay-modi" id="tb-pay-modi" hidden>
                      <p class="tb-pan-tit">{t("sal.tb.act.pay")}</p>
                      <div class:list={["tb-pay-grid", { "is-tre": qrAttivo }]}>
                        <button type="button" class="tb-pay-modo" data-metodo="cash"><span set:html={ICONA_MONETE} />{t("ord.payCash")}</button>
                        <button type="button" class="tb-pay-modo" data-metodo="card"><span set:html={ICONA_CARTA} />{t("ord.payCard")}</button>
                        {qrAttivo && <button type="button" class="tb-pay-modo" data-metodo="qr"><span set:html={ICONA_QR} />{t("ord.payQr")}</button>}
                      </div>
                      <button type="button" class="tb-pay-indietro" id="tb-pay-indietro">← {t("sal.pay.back")}</button>
                    </div>
                    <div class="tb-pay-qr" id="tb-pay-qr" hidden>
                      <p class="tb-pan-tit">{t("ord.qrTitle")}</p>
                      <div class="tb-qr-img" id="tb-qr-img"></div>
                      <p class="tb-qr-tot" id="tb-qr-tot"></p>
                    </div>
                    <p class="tb-conto-esito" id="tb-conto-esito" role="status" hidden
                      data-wait={t("ord.qrWait")} data-paid={t("ord.qrPaid")} data-done={t("sal.pay.done")}></p>
                  </div>
                )}
                <div class="tb-riga tb-riga-una">
                  {freccia}
                  {conOrdini && (
                    <button type="button" class="tb-totale" id="tb-totale" aria-expanded="false" aria-controls="tb-pan-conto">
                      <span>{t("sal.tb.total")}</span><strong>{euro(sessione!.totale_cents)}</strong>
                    </button>
                  )}
                  {annullabile && <button type="button" class="tb-btn is-annulla" id="tb-annulla" data-testo={t("sal.seat.cancel")} data-conferma={t("sal.seat.cancelConfirm")}>{t("sal.seat.cancel")}</button>}
                </div>
              </Fragment>
            );
          }
          return <div class="tb-riga">{freccia}<button type="button" class="tb-btn is-primo" disabled>{t("sal.tb.act.order")}</button></div>;
        })()}
        <p class="tb-errore" id="tb-errore" role="status"></p>
      </nav>
    )}
    {datiInst && <script type="application/json" id="tb-dati" is:inline set:html={datiInst}></script>}
    {datiMv && <script type="application/json" id="tb-dati-mv" is:inline set:html={datiMv}></script>}
    <div id="tb-parole" hidden
      data-places={t("sal.tb.places")}
      data-perfect={t("sal.seat.perfect")}
      data-squeeze={t("sal.seat.squeeze")}
      data-none={t("sal.seat.none")}
      data-force={t("sal.seat.force")}
      data-force-hint={t("sal.seat.forceHint")}
      data-btn={t("sal.seat.btn")}
      data-btn-scelta={t("sal.seat.btnSummary")}
      data-saving={t("sal.seat.saving")}
      data-error={t("sal.seat.error")}
      data-move={t("sal.tb.act.move")}
      data-mv-none={t("sal.mv.none")}
      data-mv-saving={t("sal.mv.saving")}
      data-mv-error={t("sal.mv.error")}
      data-loc={LOC}></div>

    <script>
      // IL MODALE DEL CONTO: toccando il totale in basso (Enzo, 24/10/2026).
      import { authFresh as authC } from "../../../lib/admin/auth";
      import { importoDa } from "../../../lib/soldi";
      const totBtn = document.getElementById("tb-totale");
      const panConto = document.getElementById("tb-pan-conto");
      if (totBtn && panConto) {
        const apriConto = (si: boolean) => {
          panConto.hidden = !si;
          totBtn.setAttribute("aria-expanded", si ? "true" : "false");
        };
        totBtn.addEventListener("click", (e) => { e.stopPropagation(); apriConto(panConto.hidden === true); });
        document.addEventListener("click", (e) => {
          if (!panConto.hidden && !panConto.contains(e.target as Node)) apriConto(false);
        });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") apriConto(false); });
        // ---- IL CONTO (26/10/2026): «Paiement en caisse» e «Encaisser» ----
        const esito = document.getElementById("tb-conto-esito");
        const tavoloA = new URLSearchParams(location.search).get("id") ?? "";
        const home = document.getElementById("tb-pay-home");
        const modi = document.getElementById("tb-pay-modi");
        const qrBox = document.getElementById("tb-pay-qr");
        const vista = (quale: "home" | "modi" | "qr") => {
          if (home) home.hidden = quale !== "home";
          if (modi) modi.hidden = quale !== "modi";
          if (qrBox) qrBox.hidden = quale !== "qr";
        };
        const dici = (testo: string, tipo: "ok" | "errore" | "attesa") => {
          if (!esito) return;
          esito.textContent = testo;
          esito.classList.toggle("is-errore", tipo === "errore");
          esito.classList.toggle("is-attesa", tipo === "attesa");
          esito.hidden = !testo;
        };
        const chiedi = async (corpo: Record<string, unknown>) => {
          const res = await fetch("/api/admin/salle-seat", { method: "POST", headers: await authC(), body: JSON.stringify(corpo) });
          const j = (await res.json().catch(() => ({}))) as { error?: string; message?: string; svg?: string; totale?: number; pagato?: boolean };
          return { ok: res.ok, j };
        };
        const soldi = (c: number) => importoDa(c, document.getElementById("tb-parole")?.dataset.loc || "fr-BE");
        // Chiudere il modale riporta alla prima scelta.
        totBtn.addEventListener("click", () => { vista("home"); dici("", "ok"); });

        // 1. Paiement en caisse: l'addizione in cassa, e il tavolo diventa blu.
        const cassa = document.getElementById("tb-cassa") as HTMLButtonElement | null;
        cassa?.addEventListener("click", async () => {
          if (cassa.disabled) return;
          cassa.disabled = true;
          try {
            const { ok, j } = await chiedi({ azione: "cassa", table: tavoloA });
            if (ok) { dici(j.message || "OK", "ok"); setTimeout(() => location.reload(), 1500); return; }
            dici(j.error || "Erreur", "errore");
          } catch { dici("…", "errore"); }
          cassa.disabled = false;
        });

        // 2. Encaisser: contanti / carta subito, QR al tavolo.
        document.getElementById("tb-incassa")?.addEventListener("click", () => { vista("modi"); dici("", "ok"); });
        document.getElementById("tb-pay-indietro")?.addEventListener("click", (e) => { e.stopPropagation(); vista("home"); dici("", "ok"); });
        let giro = 0;
        document.querySelectorAll<HTMLButtonElement>(".tb-pay-modo").forEach((b) => b.addEventListener("click", async () => {
          const metodo = b.dataset.metodo ?? "";
          const tutti = [...document.querySelectorAll<HTMLButtonElement>(".tb-pay-modo")];
          tutti.forEach((x) => (x.disabled = true));
          try {
            if (metodo === "qr") {
              const { ok, j } = await chiedi({ azione: "qr", table: tavoloA });
              if (!ok || !j.svg) { dici(j.error || "Erreur", "errore"); tutti.forEach((x) => (x.disabled = false)); return; }
              const img = document.getElementById("tb-qr-img");
              if (img) img.innerHTML = j.svg;
              const tot = document.getElementById("tb-qr-tot");
              if (tot) tot.textContent = soldi(Number(j.totale));
              vista("qr");
              dici(esito?.dataset.wait ?? "", "attesa");
              window.clearInterval(giro);
              giro = window.setInterval(async () => {
                if (panConto.hidden) return;
                try {
                  const r = await chiedi({ azione: "qr-stato", table: tavoloA });
                  if (r.ok && r.j.pagato) {
                    window.clearInterval(giro);
                    dici(`✓ ${esito?.dataset.paid ?? ""}`, "ok");
                    setTimeout(() => location.replace("/admin/salle"), 1800);
                  }
                } catch { /* niente rete: al prossimo giro */ }
              }, 3000);
              return;
            }
            const { ok, j } = await chiedi({ azione: "incassa", table: tavoloA, metodo });
            if (ok) {
              dici(`✓ ${(esito?.dataset.done ?? "{t}").replace("{t}", soldi(Number(j.totale)))}`, "ok");
              setTimeout(() => location.replace("/admin/salle"), 1500);
              return;
            }
            dici(j.error || "Erreur", "errore");
          } catch { dici("…", "errore"); }
          tutti.forEach((x) => (x.disabled = false));
        }));
      }
    </script>
    <script>
      // VALIDARE / RIFIUTARE il conto del QR (`/api/admin/salle-tab`).
      import { authFresh as authV } from "../../../lib/admin/auth";
      const valida = document.getElementById("tb-valida") as HTMLButtonElement | null;
      const rifiuta = document.getElementById("tb-rifiuta") as HTMLButtonElement | null;
      const errV = document.getElementById("tb-errore");
      const tavoloV = new URLSearchParams(location.search).get("id") ?? "";
      const decidi = async (azione: "valida" | "rifiuta", btn: HTMLButtonElement) => {
        btn.disabled = true;
        if (errV) errV.textContent = "";
        try {
          const res = await fetch("/api/admin/salle-tab", { method: "POST", headers: await authV(), body: JSON.stringify({ table: tavoloV, azione }) });
          if (res.ok) { location.replace(azione === "valida" ? location.pathname + location.search : "/admin/salle"); return; }
          const j = (await res.json().catch(() => ({}))) as { error?: string };
          if (errV) errV.textContent = j.error ?? "";
        } catch { if (errV) errV.textContent = "…"; }
        btn.disabled = false;
      };
      valida?.addEventListener("click", () => void decidi("valida", valida));

      /* IL DOPPIO TOCCO (25/10/2026): il primo arma (rosso, «Confirmer ?»),
         il secondo fa; dopo 3 secondi si disarma da solo. */
      const doppio = (btn: HTMLButtonElement, arma: (si: boolean) => void, fai: () => Promise<void>) => {
        let armato = 0;
        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          if (btn.disabled) return;
          if (!armato) {
            arma(true);
            armato = window.setTimeout(() => { armato = 0; arma(false); }, 3000);
            return;
          }
          window.clearTimeout(armato);
          armato = 0;
          btn.disabled = true;
          await fai();
          btn.disabled = false;
          arma(false);
        });
      };
      const chiedi = async (corpo: Record<string, unknown>, err: HTMLElement | null): Promise<boolean> => {
        if (err) err.textContent = "";
        try {
          const res = await fetch("/api/admin/salle-order", { method: "POST", headers: await authV(), body: JSON.stringify(corpo) });
          if (res.ok) return true;
          const j = (await res.json().catch(() => ({}))) as { error?: string };
          if (err) err.textContent = j.error ?? "";
        } catch { if (err) err.textContent = "…"; }
        return false;
      };
      // ANNULLARE UN ORDINE: il cestino della card.
      document.querySelectorAll<HTMLButtonElement>(".tb-ord-annulla").forEach((b) => {
        doppio(b, (si) => b.classList.toggle("is-armato", si), async () => {
          if (await chiedi({ azione: "annulla", table: tavoloV, order: b.dataset.ordine }, errV)) location.reload();
        });
      });
      // LIBERARE IL TAVOLO: dal modale dell'isola.
      const libera = document.getElementById("tb-libera") as HTMLButtonElement | null;
      if (libera) {
        doppio(libera, (si) => {
          libera.classList.toggle("is-armato", si);
          libera.textContent = (si ? libera.dataset.conferma : libera.dataset.testo) ?? "";
        }, async () => {
          if (await chiedi({ azione: "libera", table: tavoloV }, document.getElementById("tb-pan-err"))) location.replace("/admin/salle");
        });
      }

      // ANNULLARE: seduti senza nessun ordine, se ne vanno. Secondo tocco.
      const annulla = document.getElementById("tb-annulla") as HTMLButtonElement | null;
      let armatoA = 0;
      annulla?.addEventListener("click", async () => {
        if (!annulla) return;
        if (!armatoA) {
          annulla.classList.add("is-armato");
          annulla.textContent = annulla.dataset.conferma ?? "";
          armatoA = window.setTimeout(() => {
            armatoA = 0;
            annulla.classList.remove("is-armato");
            annulla.textContent = annulla.dataset.testo ?? "";
          }, 3000);
          return;
        }
        window.clearTimeout(armatoA);
        armatoA = 0;
        annulla.disabled = true;
        if (errV) errV.textContent = "";
        try {
          const res = await fetch("/api/admin/salle-seat", { method: "POST", headers: await authV(), body: JSON.stringify({ azione: "annulla", table: tavoloV }) });
          if (res.ok) { location.replace("/admin/salle"); return; }
          const j = (await res.json().catch(() => ({}))) as { error?: string };
          if (errV) errV.textContent = j.error ?? "";
        } catch { if (errV) errV.textContent = "…"; }
        annulla.disabled = false;
        annulla.classList.remove("is-armato");
        annulla.textContent = annulla.dataset.testo ?? "";
      });
      // Il secondo tocco: il primo arma, dopo tre secondi si disarma da solo.
      let armato = 0;
      rifiuta?.addEventListener("click", () => {
        if (!rifiuta) return;
        if (armato) { window.clearTimeout(armato); armato = 0; void decidi("rifiuta", rifiuta); return; }
        rifiuta.classList.add("is-armato");
        rifiuta.textContent = rifiuta.dataset.conferma ?? "";
        armato = window.setTimeout(() => {
          armato = 0;
          rifiuta.classList.remove("is-armato");
          rifiuta.textContent = rifiuta.dataset.testo ?? "";
        }, 3000);
      });
    </script>
    <script>
      import { proposteInstallazione, type Proposta } from "../../../lib/salaInstallaRegole";
      import { authFresh } from "../../../lib/admin/auth";

      /* QUANTI SIETE, E DOVE — tutto qui, senza chiedere niente al server
         finche' non si tocca «Installer». */
      const datiEl = document.getElementById("tb-dati");
      const P = (document.getElementById("tb-parole")?.dataset ?? {}) as Record<string, string>;
      if (datiEl) {
        const d = JSON.parse(datiEl.textContent || "{}") as {
          tavoloId: string; nome: string;
          tavoli: { id: string; name: string; seats: number }[];
          catene: string[][]; occupati: string[]; prenotati: string[];
        };
        const numeri = [...document.querySelectorAll<HTMLButtonElement>("#tb-inst .tb-n")];
        const piu = document.getElementById("tb-piu");
        const piuN = document.getElementById("tb-piu-n");
        const dove = document.getElementById("tb-dove");
        const box = document.getElementById("tb-proposte");
        const btn = document.getElementById("tb-installa") as HTMLButtonElement | null;
        const errore = document.getElementById("tb-errore");
        let persone = 0;
        let extra = 9;
        let scelta: Proposta | null = null;

        const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));
        const nomi = (p: Proposta) => p.nomi.join(" + ");
        // «Parfait» (verde) o «+1 chaise» (arancione, stretti di una sedia).
        const etichetta = (spreco: number) => spreco === 0
          ? `<span class="tb-prop-tag">${esc(P.perfect ?? "")}</span>`
          : spreco < 0 ? `<span class="tb-prop-tag is-stretto">${esc(P.squeeze ?? "")}</span>` : "";
        /* La combinazione scelta si vede SUBITO nella testa: «Tavolo T1 + T4 ·
           6 posti». Senza scelta torna quella del tavolo toccato. */
        const titoloEl = document.getElementById("tb-titolo");
        const sottoEl = document.getElementById("tb-sottotitolo");
        const aggiornaTesta = () => {
          if (titoloEl) {
            titoloEl.textContent = scelta && persone > 0 ? nomi(scelta) : (titoloEl.dataset.base ?? "");
          }
          if (sottoEl) {
            sottoEl.textContent = scelta && persone > 0
              ? (P.places ?? "").replace("{n}", String(scelta.posti))
              : (sottoEl.dataset.base ?? "");
          }
        };
        const aggiornaBottone = () => {
          aggiornaTesta();
          if (!btn) return;
          btn.disabled = !scelta || persone < 1;
          btn.textContent = scelta && persone > 0
            ? (P.btnScelta ?? "").replace("{n}", String(persone)).replace("{t}", nomi(scelta))
            : (P.btn ?? "");
        };
        const disegna = () => {
          if (!box || !dove) return;
          dove.hidden = persone < 1;
          if (persone < 1) { box.innerHTML = ""; scelta = null; aggiornaBottone(); return; }
          // ⚠️ Fuori sia chi e' seduto sia chi arriva fra poco: proporre un
          // tavolo prenotato vorrebbe dire lasciare in piedi chi ha prenotato.
          const proposte = proposteInstallazione({
            tavoli: d.tavoli, catene: d.catene, occupati: [...d.occupati, ...d.prenotati],
            tavoloId: d.tavoloId, persone,
          });
          let html = proposte.map((p, i) => `
            <button type="button" class="tb-prop" data-i="${i}" aria-pressed="${i === 0}">
              <span class="tb-prop-nomi">${esc(nomi(p))}${etichetta(p.spreco)}</span>
              <span class="tb-prop-posti">${esc((P.places ?? "").replace("{n}", String(p.posti)))}</span>
            </button>`).join("");
          // Nessuna proposta: si dice perche', e si lascia decidere il cameriere.
          const tavolo = d.tavoli.find((x) => x.id === d.tavoloId);
          const forzata: Proposta | null = proposte.length || !tavolo ? null
            : { ids: [d.tavoloId], nomi: [d.nome], posti: tavolo.seats, spreco: tavolo.seats - persone };
          if (forzata) {
            html = `<p class="tb-nessuna">${esc((P.none ?? "").replace("{t}", d.nome).replace("{n}", String(persone)))}</p>
              <button type="button" class="tb-prop is-forzata" data-i="0" aria-pressed="false">
                <span class="tb-prop-nomi">${esc((P.force ?? "").replace("{t}", d.nome))}</span>
                <span class="tb-prop-posti">${esc((P.places ?? "").replace("{n}", String(tavolo?.seats ?? 0)))}</span>
              </button>
              <p class="tb-nessuna">${esc(P.forceHint ?? "")}</p>`;
          }
          box.innerHTML = html;
          const lista = forzata ? [forzata] : proposte;
          // La piu' plausibile e' gia' scelta; quella forzata no, la si tocca apposta.
          scelta = forzata ? null : (lista[0] ?? null);
          box.querySelectorAll<HTMLButtonElement>(".tb-prop").forEach((b) => b.addEventListener("click", () => {
            scelta = lista[Number(b.dataset.i)] ?? null;
            box.querySelectorAll(".tb-prop").forEach((x) => x.setAttribute("aria-pressed", x === b ? "true" : "false"));
            aggiornaBottone();
          }));
          aggiornaBottone();
        };
        const scegliNumero = (n: number, bottone: HTMLButtonElement) => {
          persone = n;
          numeri.forEach((x) => x.setAttribute("aria-pressed", x === bottone ? "true" : "false"));
          disegna();
        };
        numeri.forEach((b) => b.addEventListener("click", () => {
          if (b.dataset.n === "piu") {
            if (piu) piu.hidden = false;
            scegliNumero(extra, b);
          } else {
            if (piu) piu.hidden = true;
            scegliNumero(Number(b.dataset.n), b);
          }
        }));
        const cambiaExtra = (delta: number) => {
          extra = Math.min(60, Math.max(9, extra + delta));
          if (piuN) piuN.textContent = String(extra);
          const b = numeri.find((x) => x.dataset.n === "piu");
          if (b) scegliNumero(extra, b);
        };
        document.getElementById("tb-meno")?.addEventListener("click", () => cambiaExtra(-1));
        document.getElementById("tb-ancora")?.addEventListener("click", () => cambiaExtra(1));

        btn?.addEventListener("click", async () => {
          if (!scelta || persone < 1 || !btn) return;
          btn.disabled = true;
          btn.textContent = P.saving ?? "";
          if (errore) errore.textContent = "";
          try {
            const res = await fetch("/api/admin/salle-seat", {
              method: "POST",
              headers: await authFresh(),
              body: JSON.stringify({ tables: scelta.ids, people: persone }),
            });
            const j = (await res.json().catch(() => ({}))) as { error?: string };
            // Il primo ordine si fa SUBITO: dritti ai piatti (23/10/2026).
            if (res.ok) { window.location.replace(`/admin/salle/order?id=${encodeURIComponent(d.tavoloId)}`); return; }
            if (errore) errore.textContent = j.error ?? P.error ?? "";
            // Occupato nel frattempo: la pagina si rifa' con la sala di adesso.
            if (res.status === 409) { window.setTimeout(() => window.location.reload(), 1800); return; }
          } catch {
            if (errore) errore.textContent = P.error ?? "";
          }
          aggiornaBottone();
        });
      }
    </script>
    <script>
      /* IL MODALE DELL'ISOLA (23/10/2026): persone e «Déplacer».
         Le proposte si calcolano qui a ogni tocco (regole pure in
         `lib/salaInstallaRegole.ts`); il server ricontrolla tutto. */
      import { proposteCambio, tavoliDaAggiungere, tavoliDaLiberare, type Proposta, type Ritocco, type ZonaSala } from "../../../lib/salaInstallaRegole";
      import { authFresh as authM } from "../../../lib/admin/auth";

      const isola = document.getElementById("tb-isola");
      const pannello = document.getElementById("tb-pannello");
      const datiMv = document.getElementById("tb-dati-mv");
      if (isola && pannello && datiMv) {
        const d = JSON.parse(datiMv.textContent || "{}") as {
          tavoloId: string; persone: number; zona: string; zone: ZonaSala[];
          occupati: string[]; prenotati: string[]; attuali: string[];
        };
        const P = (document.getElementById("tb-parole")?.dataset ?? {}) as Record<string, string>;
        const err = document.getElementById("tb-pan-err");
        const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));
        const posti = (n: number) => (P.places ?? "").replace("{n}", String(n));
        const nomeDi = new Map(d.zone.flatMap((z) => z.tavoli.map((t) => [t.id, t.name] as const)));
        const perNome = (a: string, b: string) => a.localeCompare(b, undefined, { numeric: true });
        const nomiAdesso = d.attuali.map((id) => nomeDi.get(id) ?? "?").sort(perNome).join(" + ");
        // ⚠️ Chi arriva fra poco non si propone, come per «Installer».
        const presi = [...d.occupati, ...d.prenotati];

        // ---- aprire / chiudere ----
        const apri = (si: boolean) => {
          pannello.hidden = !si;
          isola.setAttribute("aria-expanded", si ? "true" : "false");
        };
        isola.addEventListener("click", (e) => { e.stopPropagation(); apri(pannello.hidden === true); });
        document.addEventListener("click", (e) => {
          if (!pannello.hidden && !pannello.contains(e.target as Node)) apri(false);
        });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") apri(false); });

        const invia = async (corpo: Record<string, unknown>): Promise<boolean> => {
          if (err) err.textContent = "";
          try {
            const res = await fetch("/api/admin/salle-seat", { method: "POST", headers: await authM(), body: JSON.stringify(corpo) });
            if (res.ok) return true;
            const j = (await res.json().catch(() => ({}))) as { error?: string };
            if (err) err.textContent = j.error ?? P.mvError ?? "";
            if (res.status === 409) window.setTimeout(() => location.reload(), 1800);
          } catch {
            if (err) err.textContent = P.mvError ?? "";
          }
          return false;
        };

        // ---- le persone ----
        const iniziale = Math.max(1, d.persone || 1);
        let persone = iniziale;
        const salva = document.getElementById("tb-p-salva") as HTMLButtonElement | null;
        const numeriP = [...document.querySelectorAll<HTMLButtonElement>(".tb-pn")];
        const campo = document.getElementById("tb-p-campo") as HTMLInputElement | null;
        const passo = document.getElementById("tb-p-passo");
        const imposta = (n: number) => {
          persone = Math.min(100, Math.max(1, Math.floor(n) || 1));
          numeriP.forEach((b) => b.setAttribute("aria-pressed",
            (b.dataset.n === "piu" ? persone >= 10 : Number(b.dataset.n) === persone) ? "true" : "false"));
          if (salva) salva.hidden = persone === iniziale;
          if (modo === "cambia") disegna();
        };
        numeriP.forEach((b) => b.addEventListener("click", () => {
          if (b.dataset.n === "piu") {
            // «10+»: il campo, gia' a 10 (o al numero di adesso), pronto da scrivere.
            if (passo) passo.hidden = false;
            if (campo) { campo.focus(); campo.select(); }
            imposta(Math.max(10, Number(campo?.value) || 10));
          } else {
            if (passo) passo.hidden = true;
            imposta(Number(b.dataset.n));
          }
        }));
        campo?.addEventListener("input", () => {
          const v = Math.floor(Number(campo.value));
          if (v >= 1) imposta(v);
        });
        // − e + accanto al campo: da 10 in su (sotto ci sono i bottoni 1–9).
        const passa = (delta: number) => {
          if (!campo) return;
          const n = Math.min(100, Math.max(10, (Math.floor(Number(campo.value)) || 10) + delta));
          campo.value = String(n);
          imposta(n);
        };
        document.getElementById("tb-p-meno")?.addEventListener("click", () => passa(-1));
        document.getElementById("tb-p-piu")?.addEventListener("click", () => passa(1));
        salva?.addEventListener("click", async () => {
          salva.disabled = true;
          const testo = salva.textContent;
          salva.textContent = P.mvSaving ?? "";
          if (await invia({ azione: "persone", table: d.tavoloId, people: persone })) { location.reload(); return; }
          salva.disabled = false;
          salva.textContent = testo;
        });

        // ---- Piu' tempo al tavolo: +15 / +30 / +45 ----
        const finEl = document.getElementById("tb-ext-fine");
        const avvisoExt = document.getElementById("tb-ext-avviso");
        let armatoExt: { b: HTMLButtonElement; t: number } | null = null;
        const disarma = () => {
          if (!armatoExt) return;
          window.clearTimeout(armatoExt.t);
          armatoExt.b.classList.remove("is-armato");
          armatoExt.b.textContent = armatoExt.b.dataset.testo ?? "";
          armatoExt = null;
        };
        document.querySelectorAll<HTMLButtonElement>(".tb-ext-btn").forEach((b) => b.addEventListener("click", async () => {
          const forza = armatoExt?.b === b;
          if (!forza) disarma();
          b.disabled = true;
          if (avvisoExt && !forza) avvisoExt.hidden = true;
          try {
            const res = await fetch("/api/admin/salle-seat", {
              method: "POST", headers: await authM(),
              body: JSON.stringify({ azione: "estendi", table: d.tavoloId, minuti: Number(b.dataset.min), forza }),
            });
            const j = (await res.json().catch(() => ({}))) as { fine?: string | null; conflitto?: boolean; error?: string };
            if (res.ok) {
              disarma();
              if (avvisoExt) avvisoExt.hidden = true;
              if (finEl && j.fine) finEl.textContent = (finEl.dataset.tpl ?? "").replace("{h}", j.fine);
              b.classList.add("is-fatto");
              window.setTimeout(() => b.classList.remove("is-fatto"), 900);
            } else if (j.conflitto) {
              // Una prenotazione arriva: si dice chi, e il secondo tocco conferma.
              if (avvisoExt) { avvisoExt.textContent = j.error ?? ""; avvisoExt.hidden = false; }
              b.classList.add("is-armato");
              b.textContent = b.dataset.conferma ?? "";
              armatoExt = { b, t: window.setTimeout(() => { disarma(); if (avvisoExt) avvisoExt.hidden = true; }, 5000) };
            } else if (avvisoExt) {
              avvisoExt.textContent = j.error ?? P.mvError ?? "";
              avvisoExt.hidden = false;
            }
          } catch {
            if (avvisoExt) { avvisoExt.textContent = P.mvError ?? ""; avvisoExt.hidden = false; }
          }
          b.disabled = false;
        }));

        // ---- «Déplacer»: prima le tre possibilita', poi le proposte ----
        const sposta = document.getElementById("tb-sposta");
        const modi = document.getElementById("tb-modi");
        const box = document.getElementById("tb-opzioni");
        const ok = document.getElementById("tb-sposta-ok") as HTMLButtonElement | null;
        const ticket = document.getElementById("tb-mv-ticket");
        let modo = "";
        let scelta: string[] | null = null;
        sposta?.addEventListener("click", () => {
          const si = modi?.hidden ?? false;
          if (modi) modi.hidden = !si;
          sposta.setAttribute("aria-expanded", si ? "true" : "false");
        });

        const aggiornaOk = () => {
          if (!ok) return;
          ok.hidden = !scelta;
          if (ticket) ticket.hidden = !scelta;
          if (!scelta) return;
          const dopo = scelta.map((id) => nomeDi.get(id) ?? "?").sort(perNome).join(" + ");
          ok.textContent = `${P.move ?? ""} · ${nomiAdesso} → ${dopo}`;
        };
        const bottone = (i: number, nomi: string, sotto: string, spreco: number | null = null) => `
          <button type="button" class="tb-prop" data-i="${i}" aria-pressed="false">
            <span class="tb-prop-nomi">${esc(nomi)}${spreco === null ? "" : spreco === 0
              ? `<span class="tb-prop-tag">${esc(P.perfect ?? "")}</span>`
              : spreco < 0 ? `<span class="tb-prop-tag is-stretto">${esc(P.squeeze ?? "")}</span>` : ""}</span>
            <span class="tb-prop-posti">${esc(sotto)}</span>
          </button>`;
        const disegna = () => {
          if (!box) return;
          scelta = null;
          const zonaMia = d.zone.find((z) => z.zona === d.zona) ?? { zona: d.zona, tavoli: [], catene: [] };
          let html = "";
          let lista: string[][] = [];
          if (modo === "cambia") {
            for (const g of proposteCambio({ zone: d.zone, occupati: presi, attuali: d.attuali, persone })) {
              html += `<p class="tb-zona">${esc(g.zona)}</p>`;
              html += g.proposte.map((p: Proposta) => {
                lista.push(p.ids);
                return bottone(lista.length - 1, p.nomi.join(" + "), posti(p.posti), p.spreco);
              }).join("");
            }
          } else if (modo === "aggiungi" || modo === "libera") {
            const r: Ritocco[] = modo === "aggiungi"
              ? tavoliDaAggiungere({ tavoli: zonaMia.tavoli, catene: zonaMia.catene, occupati: presi, attuali: d.attuali })
              : tavoliDaLiberare({ tavoli: zonaMia.tavoli, catene: zonaMia.catene, attuali: d.attuali });
            lista = r.map((x) => x.ids);
            html = r.map((x, i) => bottone(i, `${modo === "aggiungi" ? "+" : "−"} ${x.tavolo.name}`, `${x.nomi.join(" + ")} · ${posti(x.posti)}`)).join("");
          }
          box.innerHTML = html || `<p class="tb-nessuna">${esc(P.mvNone ?? "")}</p>`;
          box.querySelectorAll<HTMLButtonElement>(".tb-prop").forEach((b) => b.addEventListener("click", () => {
            scelta = lista[Number(b.dataset.i)] ?? null;
            box.querySelectorAll(".tb-prop").forEach((x) => x.setAttribute("aria-pressed", x === b ? "true" : "false"));
            aggiornaOk();
          }));
          aggiornaOk();
        };
        document.querySelectorAll<HTMLButtonElement>(".tb-modo").forEach((b) => b.addEventListener("click", () => {
          modo = b.dataset.modo ?? "";
          document.querySelectorAll(".tb-modo").forEach((x) => x.setAttribute("aria-pressed", x === b ? "true" : "false"));
          disegna();
        }));

        ok?.addEventListener("click", async () => {
          if (!scelta) return;
          const ids = scelta;
          ok.disabled = true;
          ok.textContent = P.mvSaving ?? "";
          /* ⚠️ Le persone scelte nello stesso modale partono INSIEME ai tavoli
             (Enzo, 26/10/2026: 4 → 6 e un tavolo in piu', restavano 4 perche'
             «Enregistrer» non era stato toccato). */
          const corpo: Record<string, unknown> = { azione: "sposta", table: d.tavoloId, tables: ids };
          if (persone !== iniziale) corpo.people = persone;
          if (await invia(corpo)) {
            // Lasciato il tavolo di questa pagina: si va alla scheda del nuovo.
            const dove = ids.includes(d.tavoloId) ? d.tavoloId : ids[0];
            location.replace(`/admin/salle/table?id=${encodeURIComponent(dove)}`);
            return;
          }
          ok.disabled = false;
          aggiornaOk();
        });
      }
    </script>
    <script>
      /* MODIFICARE UN ORDINE (23/10/2026): la matita apre le righe con − / +,
         il totale si aggiorna, «Enregistrer» manda le quantita' nuove. Il
         server toglie cio' che scende e manda cio' che sale come ordine
         nuovo (ticket solo dei piatti in piu'). Un piatto che non c'era passa
         da «Ajouter des plats» → Commander. */
      import { authFresh as authE } from "../../../lib/admin/auth";
      import { importoDa } from "../../../lib/soldi";
      const PE = (document.getElementById("tb-parole")?.dataset ?? {}) as Record<string, string>;
      const euroE = (c: number) => importoDa(c, PE.loc || "fr-BE");
      const tavoloE = new URLSearchParams(location.search).get("id") ?? "";
      document.querySelectorAll<HTMLButtonElement>(".tb-ed-apri").forEach((apri) => {
        const card = apri.closest(".tb-card");
        const ed = card?.querySelector<HTMLElement>(".tb-ed");
        const vista = card?.querySelector<HTMLElement>(".tb-vista");
        if (!card || !ed || !vista) return;
        const righe = [...ed.querySelectorAll<HTMLElement>(".tb-ed-riga")];
        const qty = new Map(righe.map((r) => [r, Number(r.dataset.max) || 0]));
        const salva = ed.querySelector<HTMLButtonElement>(".tb-ed-salva");
        const err = ed.querySelector<HTMLElement>(".tb-ed-err");
        const disegna = () => {
          let tot = 0;
          let cambiato = false;
          let meno = false;
          let piuDi = false;
          righe.forEach((r) => {
            const q = qty.get(r) ?? 0;
            const max = Number(r.dataset.max) || 0;
            tot += q * (Number(r.dataset.prezzo) || 0);
            if (q !== max) cambiato = true;
            if (q < max) meno = true;
            if (q > max) piuDi = true;
            const b = r.querySelector("b");
            if (b) b.textContent = String(q);
            r.classList.toggle("is-zero", q === 0);
            const bMeno = r.querySelector<HTMLButtonElement>('[data-d="-1"]');
            const bPiu = r.querySelector<HTMLButtonElement>('[data-d="1"]');
            if (bMeno) bMeno.disabled = q <= 0;
            // Lo stesso tetto del server (MAX_QTY_RIGA): un dito che scivola non ordina 50 pizze.
            if (bPiu) bPiu.disabled = q >= 50;
          });
          const totEl = ed.querySelector(".tb-ed-tot");
          if (totEl) totEl.textContent = euroE(tot);
          const vuoto = righe.every((r) => (qty.get(r) ?? 0) === 0);
          ed.querySelector<HTMLElement>(".tb-ed-avviso")!.hidden = !meno || vuoto;
          ed.querySelector<HTMLElement>(".tb-ed-piu")!.hidden = !piuDi;
          ed.querySelector<HTMLElement>(".tb-ed-vuoto")!.hidden = !vuoto;
          if (salva) salva.disabled = !cambiato;
        };
        righe.forEach((r) => r.querySelectorAll<HTMLButtonElement>("[data-d]").forEach((b) => b.addEventListener("click", () => {
          qty.set(r, Math.min(50, Math.max(0, (qty.get(r) ?? 0) + Number(b.dataset.d))));
          disegna();
        })));
        apri.addEventListener("click", () => {
          const si = ed.hidden;
          ed.hidden = !si;
          vista.hidden = si;
          apri.setAttribute("aria-expanded", si ? "true" : "false");
          if (!si) { righe.forEach((r) => qty.set(r, Number(r.dataset.max) || 0)); disegna(); }
        });
        salva?.addEventListener("click", async () => {
          salva.disabled = true;
          if (err) err.textContent = "";
          const nuove: Record<string, number> = {};
          righe.forEach((r) => { nuove[r.dataset.i ?? ""] = qty.get(r) ?? 0; });
          try {
            const res = await fetch("/api/admin/salle-order", {
              method: "POST", headers: await authE(),
              body: JSON.stringify({ azione: "togli", table: tavoloE, order: ed.dataset.ordine, qty: nuove }),
            });
            if (res.ok) { location.reload(); return; }
            const j = (await res.json().catch(() => ({}))) as { error?: string };
            if (err) err.textContent = j.error ?? "";
          } catch { if (err) err.textContent = "…"; }
          salva.disabled = false;
        });
      });
    </script>
  </body>
</html>
