            <div class="nc-cart" id="nc-cart"><div class="nc-cart-empty">Panier vide</div></div>
            <div class="nc-total"><span>Total</span><b id="nc-total">0,00 €</b></div>
            <button type="button" class="nc-send" id="nc-send">Créer &amp; envoyer le lien de paiement</button>
