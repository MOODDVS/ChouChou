              <button class="prep-btn prep-close" type="button" id="btn-close-orders" title="Fermer les commandes en ligne">
                <svg viewBox="0 0 30 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="15" cy="12" r="8.5" />
