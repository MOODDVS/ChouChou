---
// Pannello admin — ordini take-away di OGGI.
// In alto gli ordini ATTIVI (paid), dal ritiro più vicino al più lontano.
// Sotto, spenti (opacità ridotta), i terminati (done) e gli annullati
// (cancelled, con etichetta rossa). Bottoni per carta: "Terminée" e
// "Annuler" (conferma in 2 tocchi) → PATCH /api/admin/orders.
// In testata: bottoni rapidi tempo di preparazione
// (coniglio 15 / cane 30 / tartaruga 45) → PATCH /api/admin/settings.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHead from "../../components/admin/AdminHead.astro";
import { CLIENT } from "../../config/client";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import { DateTime } from "luxon";
import { supabaseAdmin } from "../../lib/db";
import { verificaTokenLocale } from "../../lib/admin/adminAuth";
import { aggiornaTimezone } from "../../lib/slots";
import { caricaBootAdmin } from "../../lib/admin/adminBoot";
import { LINGUE_PUBBLICHE } from "../../lib/admin/superAdmin";
import { opzioniPrefisso } from "../../lib/prefissi";
import { adminT } from "../../i18n/admin";
import "../../styles/datepicker.css";
import "../../styles/select.css";

// Boot admin (cache 60s): lingua admin + lingue pubbliche della regola super.
const boot = await caricaBootAdmin();
const lang = boot.lang;
const t = adminT(lang);
// Pillole "Lingua dell'email" del modale ordine = lingue pubbliche ATTIVE,
// nell'ordine canonico, con etichetta+bandiera da LINGUE_PUBBLICHE.
const linguePillole = LINGUE_PUBBLICHE.filter((l) => boot.publicLangs.includes(l.code));
const linguaDefault = boot.publicLangDefault;

export const prerender = false;

// --- SSR (Fase 2): se il cookie di sessione è valido, carichiamo i primi
// ordini GIÀ sul server → la pagina arriva coi dati (niente pagina vuota→fetch).
// Stessa query di GET /api/admin/orders. Se il cookie manca/è scaduto o c'è un
// errore, ssrOrders resta null e il client carica come prima (nessun rischio).
let ssrOrders: unknown[] | null = null;
try {
  const token = Astro.cookies.get("mdd_at")?.value ?? "";
  const staff = token ? await verificaTokenLocale(token) : null;
  if (staff) {
    const soglia = DateTime.now()
      .setZone(await aggiornaTimezone())
      .minus({ days: 7 })
      .startOf("day")
      .toISO();
    const { data } = await supabaseAdmin
      .from("orders")
      .select(
        "id, status, pickup_time, customer_name, customer_email, customer_phone, items, total_cents, lang, created_at, refunded_cents, stripe_session_id"
      )
      .in("status", ["paid", "done", "cancelled"])
      .gte("pickup_time", soglia)
      .order("pickup_time", { ascending: true });
    ssrOrders = data ?? [];
  }
} catch {
  ssrOrders = null;
}
const ssrOrdersJson = ssrOrders ? JSON.stringify(ssrOrders).replace(/</g, "\\u003c") : "";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("nav.orders") + " — " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@700&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-hover: #e04f00;
        --c-input: #e6e6e6;
        --c-bg: #ffffff;
        --c-text: #666666;
        --c-accent: #ff7300;
        --c-muted: #a6a6a6;
        --c-line: #ebebeb;
        --c-card: #ffffff;
        --c-red: #ed1c24;
        --font-title: "Quicksand", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; }
      #app { display: none; min-height: 100vh; flex-direction: column; }

      main { flex: 1; padding: 2rem 2rem 7rem; width: 100%; }
      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.25rem; }
      h1 svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .today-label { font-family: var(--font-title); font-size: 1.2rem; letter-spacing: 0.03em; text-transform: capitalize; color: var(--c-muted); margin-bottom: 0.5rem; }
      .count { color: var(--c-muted); font-size: 0.85rem; }
      .state { color: var(--c-muted); text-align: center; padding: 3rem 1rem; }

      /* --- Testata: titolo a sinistra, préparation rapide a destra --- */
      .head-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.25rem; flex-wrap: wrap; margin-bottom: 2rem; }
      .prep { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
      .prep .o-search-wrap { margin-right: 1.4rem; }
      .prep-lab { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.07em; color: var(--c-muted); }
      .prep-note { text-transform: none; letter-spacing: 0; color: #2e9e6b; font-weight: 700; margin-left: 0.4rem; }
      .prep-note.err { color: #ff6b6b; }
      .prep-btns { display: flex; gap: 0.6rem; }
      .prep-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.95rem;
        border-radius: 999px;
        background: var(--c-card);
        border: 1px solid var(--c-line);
        color: var(--c-muted);
        font-family: var(--font-body);
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15)));
        transition: border-color 0.2s, background 0.2s;
      }
      .prep-btn svg { width: 24px; height: 24px; display: block; }
      .prep-close svg { width: 26px; height: 21px; } /* icône X : garde son ratio */
      .prep-btn .m { font-size: 0.8rem; color: var(--c-muted); }
      .prep-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .prep-btn.active { border-color: var(--c-accent); background: color-mix(in srgb, var(--c-accent) 14%, transparent); color: var(--c-accent); }
      .prep-btn.active .m { color: var(--c-accent); font-weight: 700; }
      .prep-btn:disabled { opacity: 0.5; cursor: wait; }
      /* Ricerca ordini (convenzione campo compatto con lente) */
      .o-search {
        height: 38px; width: 250px; max-width: 100%; box-sizing: border-box;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        border-radius: 999px; padding: 0 2.1rem 0 2.3rem; font-family: var(--font-body); font-size: 0.88rem;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23b3aca6' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='8'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg>");
        background-repeat: no-repeat; background-position: 0.85rem center; background-size: 14px;
      }
      .o-search::placeholder { color: var(--c-muted); }
      .o-search:focus { outline: none; border-color: var(--c-accent); }
      .o-search-wrap { position: relative; display: inline-flex; }
      .o-search-x {
        position: absolute; right: 0.55rem; top: 50%; transform: translateY(-50%);
        width: 22px; height: 22px; border-radius: 50%; border: none; cursor: pointer;
        background: var(--c-input); color: var(--c-text); font-size: 1rem; line-height: 1;
        display: flex; align-items: center; justify-content: center; padding: 0 0 2px;
      }
      .o-search-x:hover { background: var(--c-accent); color: var(--c-bg); }
      .card .time .o-date { color: var(--c-text); font-size: 0.72rem; font-weight: 400; }
      /* Bottone "Fermer": chiude/riapre le commandes online */
      .prep-close .m { color: var(--c-muted); }
      .prep-close:hover { border-color: #ed1c24; }
      .prep-close.closed { border-color: #ed1c24; background: rgba(237, 28, 36, 0.18); color: #ff6b6b; }
      .prep-close.closed .m { color: #ff6b6b; font-weight: 700; }

      /* --- Card ordine --- */
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
      .card { position: relative; background: var(--c-card); border: 1px solid var(--c-line); padding: 1.25rem; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); }
      /* --- Aura « ritardo ritiro »: alone pulsante DIETRO la card ---
         Comincia 5 min dopo l'ora di ritiro (bianco), 10 min → arancione,
         15 min → rosso. L'alone è uno pseudo-elemento z-index:-1 col box-shadow
         animato (da soft a forte e ritorno): più tardi = più intenso e più rapido. */
      @keyframes ncAura1 { 0%, 100% { box-shadow: 0 0 5px 1px rgba(255, 255, 255, 0.22); } 50% { box-shadow: 0 0 15px 3px rgba(255, 255, 255, 0.58); } }
      @keyframes ncAura2 { 0%, 100% { box-shadow: 0 0 7px 1px rgba(255, 146, 38, 0.28); } 50% { box-shadow: 0 0 19px 4px rgba(255, 146, 38, 0.68); } }
      @keyframes ncAura3 { 0%, 100% { box-shadow: 0 0 9px 2px rgba(237, 28, 36, 0.32); } 50% { box-shadow: 0 0 23px 6px rgba(237, 28, 36, 0.78); } }
      .card.nc-late::after { content: ""; position: absolute; inset: -1px; z-index: -1; border-radius: 3px; pointer-events: none; }
      .card.nc-late-1::after { animation: ncAura1 1.8s ease-in-out infinite; }
      .card.nc-late-2::after { animation: ncAura2 1.5s ease-in-out infinite; }
      .card.nc-late-3::after { animation: ncAura3 1.1s ease-in-out infinite; }
      @media (prefers-reduced-motion: reduce) {
        .card.nc-late-1::after { animation: none; box-shadow: 0 0 12px 3px rgba(255, 255, 255, 0.45); }
        .card.nc-late-2::after { animation: none; box-shadow: 0 0 15px 4px rgba(255, 146, 38, 0.55); }
        .card.nc-late-3::after { animation: none; box-shadow: 0 0 18px 5px rgba(237, 28, 36, 0.62); }
      }
      /* Card annulée/terminée : contenuto sbiadito, MA icone di stato e
         bottoni assoluti restano 100% opachi (dim per-elemento, mai sulla card). */
      .card.off > *:not(.btn-refund):not(.btn-rollback):not(.card-top) { opacity: 0.45; }
      .card.off .card-top .time,
      .card.off .card-top .tag:not(.tag-refund),
      .card.off .card-top .total,
      .card.off .card-top .btn-print { opacity: 0.45; }
      .card.refundable { padding-bottom: 3.6rem; } /* spazio per il bottone assoluto */
      .card.done { padding-bottom: 3.4rem; } /* spazio rollback */
      .card.done > *:not(.btn-rollback):not(.card-top) { opacity: 0.62; }
      .card.done .card-top .time,
      .card.done .card-top .tag,
      .card.done .card-top .total,
      .card.done .card-top .btn-print { opacity: 0.62; }
      .card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; }
      .ct-left { display: flex; align-items: center; gap: 0.6rem; }
      .time { font-family: var(--font-title); font-size: 1.6rem; letter-spacing: 0.03em; color: var(--c-accent); }
      .total { font-family: var(--font-title); font-size: 1.2rem; letter-spacing: 0.03em; }
      .tag { display: inline-block; padding: 0.15rem 0.5rem; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
      .tag-done { border: 1px solid var(--c-line); color: var(--c-muted); }
      .tag-cancel { background: rgba(237, 28, 36, 0.25); color: #ff6b6b; }
      .name { font-weight: 700; margin-bottom: 0.4rem; }
      .badge { display: inline-block; margin-left: 0.5rem; padding: 0.1rem 0.45rem; border: 1px solid var(--c-line); color: var(--c-muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .row { font-size: 0.85rem; color: var(--c-muted); margin-bottom: 0.2rem; }
      .row a { color: var(--c-text); text-decoration: none; }

      .items { border-top: 1px solid var(--c-line); margin-top: 0.9rem; padding-top: 0.9rem; display: flex; flex-direction: column; gap: 0.5rem; }
      .item { display: flex; gap: 0.6rem; align-items: baseline; font-size: 1.15rem; }
      .item-qty { color: var(--c-accent); font-weight: 700; }
      .item-name { flex: 1; color: var(--c-text); }
      .item-sub { color: var(--c-muted); font-size: 0.8rem; white-space: nowrap; }

      .order-note { margin-top: 0.9rem; padding: 0.7rem 0.9rem; background: var(--c-card); border-left: 2px solid var(--c-accent); font-size: 0.9rem; }

      /* --- Azioni sulla card attiva --- */
      .actions { display: flex; gap: 0.6rem; border-top: 1px solid var(--c-line); margin-top: 1rem; padding-top: 1rem; }
      .actions button {
        background: transparent;
        font-family: var(--font-title);
        font-size: 1.05rem;
        letter-spacing: 0.05em;
        padding: 0.5rem 0.6rem;
        cursor: pointer;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .actions button:disabled { opacity: 0.5; cursor: wait; }
      /* .actions .btn-done: specificita' > `.actions button` per non farsi azzerare il background */
      .actions .btn-done { flex: 1; border: 1px solid var(--c-accent); background: var(--c-accent); color: var(--c-bg); font-weight: 700; border-radius: 8px; }
      .btn-done:hover { filter: brightness(1.08); }
      .btn-done:active { transform: scale(0.98); }
      /* Annuler : cestino compatto; al primo tocco si allarga in "Annuler ?" rosso */
      .btn-cancel { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 46px; padding: 0.5rem; border: 1px solid rgba(237, 28, 36, 0.5); color: #ff6b6b; border-radius: 8px; }
      .btn-cancel svg { width: 20px; height: 20px; }
      .btn-cancel:hover { border-color: var(--c-red); background: rgba(237, 28, 36, 0.12); }
      .btn-cancel.confirm { flex: 1; gap: 0.4rem; background: rgba(237, 28, 36, 0.25); border-color: var(--c-red); color: #fff; }
      /* Matita: modifica ordine (apre il modale precompilato). Icona compatta. */
      .btn-edit { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 46px; padding: 0.5rem; border: 1px solid var(--c-line); color: var(--c-muted); border-radius: 8px; }
      .btn-edit svg { width: 19px; height: 19px; }
      .btn-edit:hover { border-color: var(--c-accent); color: var(--c-accent); }
      /* Card terminée : ✓ blanc rond sur fond vert, à côté du prix */
      .ct-right { display: inline-flex; align-items: center; gap: 0.5rem; }
      .badge-ok {
        display: inline-flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        background: #2e9e6b; color: #fff; font-size: 0.78rem; font-weight: 800; line-height: 1;
      }
      /* Card annulée : ✕ blanc rond sur fond rouge, à côté du prix */
      .badge-ko {
        display: inline-flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        background: var(--c-red); color: #fff; font-size: 0.78rem; font-weight: 800; line-height: 1;
      }
      /* Rollback : rond doré, position absolue en bas à droite de la card */
      .btn-rollback {
        position: absolute; right: 0.9rem; bottom: 0.9rem;
        width: 40px; height: 40px; border-radius: 50%; border: none;
        background: var(--c-accent); color: var(--c-bg);
        font-size: 1.2rem; line-height: 1; display: inline-flex;
        align-items: center; justify-content: center; cursor: pointer;
        box-shadow: 0 3px 10px rgba(0, 0, 0, calc(0.35 * var(--sh, 0.15)));
        transition: transform 0.1s, filter 0.15s;
      }
      .btn-rollback:hover { filter: brightness(1.08); }
      .btn-rollback:active { transform: scale(0.94); }
      .btn-rollback:disabled { opacity: 0.5; cursor: wait; }
      /* Bottone stampante (ristampa ticket) — predisposto, mostrato solo quando attivo */
      .btn-print {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; padding: 0; border-radius: 8px;
        border: 1px solid var(--c-line); background: transparent; color: var(--c-muted);
        cursor: pointer; transition: border-color 0.15s, color 0.15s;
      }
      .btn-print:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .btn-print svg { width: 17px; height: 17px; }
      /* Remboursement : tag stato in alto + bottone doré absolu en bas à droite */
      .tag-refund {
        border: 1px solid var(--c-accent); color: var(--c-accent);
        font-size: 0.6rem; padding: 0.08rem 0.45rem; border-radius: 999px;
      }
      .btn-refund {
        position: absolute; right: 0.9rem; bottom: 0.9rem; z-index: 2;
        font-family: var(--font-title); font-size: 0.9rem; letter-spacing: 0.03em;
        padding: 0.5rem 0.95rem; border-radius: 999px; border: none;
        background: var(--c-accent); color: var(--c-bg); font-weight: 700;
        cursor: pointer; box-shadow: 0 3px 10px rgba(0, 0, 0, calc(0.35 * var(--sh, 0.15)));
        transition: transform 0.1s, filter 0.15s;
      }
      .btn-refund:hover { filter: brightness(1.08); }
      .btn-refund:active { transform: scale(0.96); }
      .btn-refund:disabled { opacity: 0.6; cursor: wait; }
      /* Bottone "rimborsa differenza" (modifica al ribasso su ordine pagato online) */
      .btn-diffrefund { display: block; width: 100%; margin-top: 0.7rem; padding: 0.7rem 0.6rem; border: 1px solid #d98a2b; background: #f0a24b; color: #3a2708; font-family: var(--font-title); font-weight: 700; font-size: 0.95rem; letter-spacing: 0.02em; border-radius: 8px; cursor: pointer; }
      .btn-diffrefund:hover { filter: brightness(1.05); }
      .btn-diffrefund:active { transform: scale(0.99); }
      .btn-diffrefund:disabled { opacity: 0.6; cursor: wait; }
      .btn-diffrefund.confirm { background: #ed6a1c; border-color: #ed6a1c; color: #ffffff; }
      /* Tag differenza dopo modifica: da pagare (ambra) / pagata (verde) */
      .tag-suppdue { background: #7a4a12; color: #ffcf8f; }
      .tag-supppaid { background: #1f5c3a; color: #9fe6c0; }
      /* Modale remboursement */
      /* ---- Nouvelle commande (manuale, link di pagamento) ---- */
      .tag-pending { background: #5d5555; color: #fff; border-radius: 999px; white-space: nowrap; }
      .tag-paid { background: #2e9e6b; color: #fff; border-radius: 999px; white-space: nowrap; }
      .btn-resend { flex: 1; border: 1px solid rgba(255, 255, 255, 0.65); color: var(--c-text); white-space: nowrap; }
      .btn-resend:hover { background: var(--c-text); color: var(--c-bg); border-color: var(--c-text); }
      .nc-add {
        position: fixed; right: 1.5rem; bottom: 1.25rem; z-index: 90;
        display: inline-flex; align-items: center; box-sizing: border-box;
        background: var(--c-accent); color: var(--c-bg); border: 2px solid var(--c-accent);
        font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.06em;
        padding: 0 1.1rem; border-radius: 999px; cursor: pointer;
        box-shadow: 0 8px 24px rgba(0, 0, 0, calc(0.45 * var(--sh, 0.15)));
        transition: background 0.2s, color 0.2s, transform 0.15s, border-color 0.2s;
      }
      .nc-add:hover { background: var(--c-hover); border-color: var(--c-hover); transform: scale(0.94); }
      @media (max-width: 520px) { .nc-add { bottom: calc(1.25rem + 72px); } }
      .nc-overlay {
        position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7); display: none;
        align-items: center; justify-content: center; z-index: 1000; padding: 3vh 1rem; overflow-y: auto;
        backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
      }
      .nc-overlay.is-open { display: flex; }
      .nc-modal {
        background: var(--c-bg); border: 1px solid var(--c-line); padding: 1.75rem;
        width: 100%; max-width: 960px; position: relative; margin: auto;
      }
      .nc-modal h2 { font-family: var(--font-title); font-size: 1.6rem; letter-spacing: 0.04em; margin-bottom: 1.2rem; }
      .nc-close { position: absolute; top: 0.8rem; right: 1rem; background: none; border: none; color: var(--c-muted); font-size: 1.6rem; cursor: pointer; line-height: 1; }
      .nc-close:hover { color: var(--c-text); }
      .nc-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 1.6rem; }
      /* le colonne non devono MAI allargarsi oltre il modale (min-width:auto
         della grid): senza questo le pillole categorie sfondano il layout */
      .nc-grid > * { min-width: 0; }
      @media (max-width: 760px) { .nc-grid { grid-template-columns: 1fr; } }
      /* Wizard multi-step del modale ordine */
      .nc-steps { display: flex; gap: 0.35rem; margin-bottom: 1.5rem; }
      .nc-step { flex: 1; text-align: center; min-width: 56px; font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-muted); border-bottom: 2px solid var(--c-line); padding: 0.3rem 0 0.7rem; cursor: pointer; transition: color 0.15s, border-color 0.15s; }
      .nc-step:hover { color: var(--c-text); }
      .nc-step.is-on { color: var(--c-accent); border-color: var(--c-accent); }
      .nc-step.done { color: var(--c-text); border-color: var(--c-accent); }
      .nc-panel { min-height: 300px; }
      .nc-nav { display: flex; justify-content: space-between; gap: 0.8rem; margin-top: 1.5rem; }
      .nc-nav-btn { padding: 0.7rem 1.7rem; border-radius: 10px; cursor: pointer; font-family: var(--font-title); font-size: 0.95rem; letter-spacing: 0.03em; background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text); transition: border-color 0.15s, color 0.15s; }
      .nc-nav-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .nc-nav-next { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .nc-nav-next:hover { background: transparent; color: var(--c-accent); }
      .nc-recap { display: flex; flex-direction: column; margin-bottom: 0.6rem; }
      .nc-recap-row { display: flex; justify-content: space-between; gap: 1rem; color: var(--c-text); font-size: 0.95rem; padding: 0.4rem 0; border-bottom: 1px solid color-mix(in srgb, var(--c-line) 55%, transparent); }
      .nc-lab { display: block; font-size: 0.72rem; color: var(--c-muted); letter-spacing: 0.05em; text-transform: uppercase; margin: 0.9rem 0 0.4rem; }
      .nc-lab:first-child { margin-top: 0; }
      .nc-row { display: flex; gap: 0.5rem; }
      .nc-tel { display: flex; gap: 0.5rem; }
      .nc-tel .nc-in { margin-bottom: 0.55rem; }
      .nc-tel-prefix { flex: 0 0 104px; cursor: pointer; }
      .nc-tel input.nc-in { flex: 1; min-width: 0; }
      .nc-in {
        width: 100%; min-width: 0; box-sizing: border-box; background-color: var(--c-input); border: 1px solid var(--c-line);
        color: var(--c-text); padding: 0.55rem 0.7rem; font-size: 0.9rem; border-radius: 8px;
        font-family: var(--font-body); margin-bottom: 0.55rem;
      }
      .nc-in:focus { outline: none; border-color: var(--c-accent); }
      .nc-in::placeholder { color: #8f8781; }
      .nc-pills { display: flex; gap: 0.4rem; flex-wrap: wrap; }
      .nc-pill {
        background: var(--c-input); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-body); font-size: 0.95rem; padding: 0.6rem 1.25rem;
        border-radius: 999px; cursor: pointer;
      }
      .nc-pill:hover { border-color: var(--c-accent); color: var(--c-text); }
      .nc-pill.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); font-weight: 700; }
      .nc-slots { display: flex; gap: 0.35rem; flex-wrap: wrap; }
      .nc-svcs { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
      .nc-dates { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
      .nc-pay { display: flex; gap: 0.5rem; margin: 0.2rem 0 0.5rem; }
      .nc-pay button {
        flex: 1; padding: 0.7rem 0.5rem; border-radius: 10px; cursor: pointer;
        font-family: var(--font-title); font-size: 0.95rem; letter-spacing: 0.03em;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        transition: border-color 0.15s, color 0.15s;
      }
      .nc-pay button:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .nc-pay button:disabled { opacity: 0.6; cursor: wait; }
      .nc-pay-link { width: 100%; margin-bottom: 0.5rem; padding: 0.7rem 0.5rem; border-radius: 10px; cursor: pointer;
        font-family: var(--font-title); font-size: 0.95rem; letter-spacing: 0.03em;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        transition: border-color 0.15s, color 0.15s; }
      .nc-pay-link:hover { border-color: var(--c-accent); color: var(--c-accent); }
      /* Metodo di pagamento SELEZIONATO */
      .nc-pay-btn.is-on { border-color: var(--c-accent); color: var(--c-accent); background: color-mix(in srgb, var(--c-accent) 12%, transparent); }
      #nc-lang-block { margin-top: 0.3rem; }
      .nc-more { border-color: var(--c-accent); color: var(--c-accent); }
      .nc-slots .nc-pill { padding: 0.5rem 1rem; font-size: 0.9rem; }
      .nc-slots-empty { color: var(--c-muted); font-size: 0.85rem; }
      .nc-cats {
        display: flex; gap: 0.35rem; overflow-x: auto; flex-wrap: nowrap;
        margin-bottom: 0.55rem; padding-bottom: 0.35rem;
        scrollbar-width: thin; scrollbar-color: var(--c-line) transparent;
      }
      .nc-cats::-webkit-scrollbar { height: 5px; }
      .nc-cats::-webkit-scrollbar-thumb { background: var(--c-line); border-radius: 999px; }
      .nc-cats .nc-pill { flex: 0 0 auto; white-space: nowrap; }
      .nc-items { max-height: 320px; overflow-y: auto; border: 1px solid var(--c-line); border-radius: 8px; }
      .nc-item { display: flex; align-items: center; gap: 0.6rem; padding: 0.85rem 0.8rem; border-bottom: 1px solid var(--c-line); font-size: 0.88rem; }
      .nc-item:last-child { border-bottom: none; }
      .nc-item .n { flex: 1; min-width: 0; }
      .nc-item .p { color: var(--c-muted); white-space: nowrap; }
      .nc-plus {
        width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--c-accent);
        background: transparent; color: var(--c-accent); font-size: 1rem; line-height: 1;
        cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      }
      .nc-plus:hover { background: var(--c-accent); color: var(--c-bg); }
      .nc-cart { min-height: 44px; display: flex; flex-direction: column; gap: 1rem; }
      .nc-cart-empty { color: var(--c-muted); font-size: 0.85rem; padding: 0.4rem 0; }
      .nc-cline { border-bottom: 1px solid var(--c-line); padding-bottom: 1rem; }
      .nc-cline-top {
        display: flex; justify-content: space-between; gap: 0.8rem;
        font-weight: 700; margin-bottom: 0.5rem; color: var(--c-text); font-size: 0.95rem;
      }
      .nc-cline-controls { display: flex; align-items: center; gap: 0.5rem; }
      .nc-cline-controls button {
        width: 30px; height: 30px; border: 1px solid var(--c-line); background: transparent;
        color: var(--c-text); cursor: pointer; font-size: 1.1rem; border-radius: 8px;
        transition: border-color 0.2s ease;
      }
      .nc-cline-controls button:hover { border-color: var(--c-accent); }
      .nc-cline-qty { min-width: 22px; text-align: center; color: var(--c-text); font-weight: 700; }
      .nc-cline-remove {
        margin-left: auto; display: inline-flex; align-items: center; justify-content: center;
        background: rgba(237, 28, 36, 0.25) !important; border: 1px solid rgba(237, 28, 36, 0.35) !important;
        color: var(--c-text) !important; border-radius: 8px;
        transition: background 0.2s ease, border-color 0.2s ease;
      }
      .nc-cline-remove:hover { background: rgba(237, 28, 36, 0.55) !important; border-color: #ed1c24 !important; }
      .nc-cline-remove svg {
        width: 14px; height: 14px; fill: none; stroke: currentColor;
        stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
      }
      .nc-total { display: flex; justify-content: space-between; align-items: center; margin-top: 0.7rem; font-size: 1rem; }
      .nc-total b { color: var(--c-accent); font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; }
      .nc-send {
        width: 100%; margin-top: 0.9rem; background: var(--c-accent); color: var(--c-bg);
        border: 2px solid var(--c-accent); font-family: var(--font-title); font-size: 1rem;
        letter-spacing: 0.05em; padding: 0.7rem; border-radius: 999px; cursor: pointer;
        transition: background 0.2s, color 0.2s;
      }
      .nc-send:hover { background: transparent; color: var(--c-accent); }
      .nc-send:disabled { opacity: 0.6; cursor: wait; }
      .nc-toast {
        position: fixed; top: 1rem; left: 50%; transform: translateX(-50%) translateY(-200%);
        z-index: 2000; background: #2e9e6b; color: #fff; font-weight: 700; font-size: 0.9rem;
        padding: 0.7rem 1.4rem; border-radius: 999px; box-shadow: 0 8px 24px rgba(0, 0, 0, calc(0.4 * var(--sh, 0.15)));
        transition: transform 0.35s ease, opacity 0.35s ease; pointer-events: none;
        opacity: 0; visibility: hidden;
      }
      .nc-toast.err { background: #b3261e; }
      .nc-toast.show { transform: translateX(-50%) translateY(0); opacity: 1; visibility: visible; }
      .rf-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.62); display: none; align-items: center; justify-content: center; z-index: 1000; padding: 1rem; }
      .rf-overlay.is-open { display: flex; }
      .rf-modal { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1.5rem; width: 100%; max-width: 380px; box-shadow: 0 20px 60px rgba(0, 0, 0, calc(0.6 * var(--sh, 0.15))); }
      .rf-title { font-family: var(--font-title); font-size: 1.4rem; margin: 0 0 0.3rem; color: var(--c-accent); }
      .rf-sub { color: var(--c-muted); font-size: 0.9rem; margin: 0 0 1.1rem; }
      .rf-label { display: block; font-size: 0.8rem; color: var(--c-muted); margin-bottom: 0.4rem; }
      .rf-inputrow { display: flex; align-items: center; gap: 0.5rem; }
      .rf-euro { color: var(--c-muted); font-size: 1.2rem; }
      .rf-amount { flex: 0 1 170px; background: var(--c-input); border: 1px solid var(--c-line); color: var(--c-text); font-size: 1.15rem; padding: 0.6rem 0.7rem; border-radius: 8px; }
      .rf-all { background: transparent; border: 2px solid var(--c-accent); color: var(--c-accent); font-weight: 700; padding: 0.55rem 1.05rem; border-radius: 8px; cursor: pointer; white-space: nowrap; transition: background 0.15s, color 0.15s; }
      .rf-all:hover { background: var(--c-accent); color: var(--c-bg); }
      .rf-msg { min-height: 1.1rem; font-size: 0.85rem; margin: 0.7rem 0 0; color: #ff8a8f; }
      .rf-msg.ok { color: #2e9e6b; }
      .rf-actions { display: flex; gap: 0.7rem; margin-top: 1.3rem; }
      .rf-actions button { flex: 1; font-family: var(--font-title); font-size: 1rem; padding: 0.6rem; cursor: pointer; border-radius: 8px; }
      .rf-cancel { background: var(--c-red); border: 1px solid var(--c-red); color: #fff; font-weight: 700; }
      .rf-cancel:hover { filter: brightness(1.08); }
      .rf-confirm { background: var(--c-accent); border: 1px solid var(--c-accent); color: var(--c-bg); font-weight: 700; }
      .rf-confirm:disabled { opacity: 0.5; cursor: wait; }

      /* --- Sezione terminati/annullati --- */
      .done-title {
        font-family: var(--font-title);
        font-size: 1.4rem;
        letter-spacing: 0.04em;
        color: var(--c-muted);
        border-top: 1px solid var(--c-line);
        margin-top: 2.5rem;
        padding-top: 1.75rem;
        margin-bottom: 1rem;
      }

      @media (max-width: 640px) {
        main { padding: 1.5rem 1rem 7rem; }
        .head-row { margin-bottom: 1.5rem; }
      }
    </style>
    <AdminHead />
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <div class="head-row">
          <div>
            <h1><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 4 6v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6l-2-4Z" /><path d="M4 6h16" /><path d="M9 10a3 3 0 0 0 6 0" /></svg>{t("nav.orders")}</h1>
            <p class="today-label" id="today-label"></p>
            <p class="count" id="count"></p>
          </div>
          <div class="prep">
            <span class="o-search-wrap">
              <input type="text" id="o-search" class="o-search" placeholder={t("ord.searchPh")} autocomplete="off" />
              <button type="button" class="o-search-x" id="o-search-x" aria-label={t("ord.clearSearch")} style="display:none">×</button>
            </span>
            <p class="prep-lab">{t("home.prep")}<span class="prep-note" id="prep-note"></span></p>
            <div class="prep-btns" role="group" aria-label={t("ord.prepTime")}>
              <button class="prep-btn" type="button" data-min="15" title={t("ord.prepFast")}>
                <svg viewBox="0 0 64 64" fill="currentColor" aria-hidden="true"><path d="m58.982 46.321c.006-.145.018-.289.018-.436 0-8.567-5.834-16.111-13.57-17.547-5.452-1.011-11.985.293-17.476 3.49a22.546 22.546 0 0 0 -2.954 2.006 13.213 13.213 0 0 0 -.28-2.848 24.743 24.743 0 0 0 10.68-3.715c7.111-4.216 11.028-9.833 9.111-13.067-1.3-2.187-4.836-2.549-9.188-1.255 1.2-4.05.8-7.121-1.169-8.39-1.615-1.041-3.953-.616-6.576 1.2a26.723 26.723 0 0 0 -6.814 7.422c-2.589 4.024-4.1 8.259-4.133 11.392a18.094 18.094 0 0 0 -5.718 1.636c-3.031 1.329-6.4 3.027-8.03 6.372a9.658 9.658 0 0 0 .288 8.637c2.261 4.1 6.449 4.791 9.32 4.791a23.373 23.373 0 0 0 2.353-.134l.484-.052c.322-.036.639-.088.951-.15.681 2.185 2.826 7.315 8.388 9.266 1.752.615 2.263 1.465 2.389 2.057h-1.056a4 4 0 0 0 -4 4 1 1 0 0 0 1 1h26.786a2.372 2.372 0 0 0 2.214-2.496 2.607 2.607 0 0 0 -.941-2.045 15.182 15.182 0 0 0 3.187-2 5.045 5.045 0 0 0 2.546.691 5.153 5.153 0 0 0 2.19-9.823zm-53.275-6.614-.689.689c-.029-.049-.065-.089-.093-.139a7.453 7.453 0 0 1 -.711-1.885l.079-.079a1 1 0 0 1 1.414 1.414zm8.175-5.825a1 1 0 0 1 -1.414 0 .978.978 0 0 0 -.842-.274.8.8 0 0 0 -.6.41c-.031.074-.029.065-.029-.013a1 1 0 0 1 -1.997-.005 2.011 2.011 0 0 1 .26-.914 2.777 2.777 0 0 1 2.066-1.455 2.988 2.988 0 0 1 2.556.837 1 1 0 0 1 0 1.414zm9.469-6.134c-1.821-.393-.679-1.913-.051-2.711a22.629 22.629 0 0 1 14.508-8.316c3.919-.721 3.681 2.123 2.2 3.651a24.945 24.945 0 0 1 -6.063 4.414c-3.964 2.125-7.958 3.172-10.594 2.962zm10.984 29.466a8.894 8.894 0 0 1 -5.335-8.006c0-.069 0-.138 0-.208 0-6.085 3.366-8.189 6.374-8.857a9.969 9.969 0 0 0 -1.039 17.071z"/></svg>
                <span class="m">15 min</span>
              </button>
              <button class="prep-btn" type="button" data-min="30" title={t("ord.prepNormal")}>
                <svg viewBox="0 0 441.23 441.23" fill="currentColor" aria-hidden="true"><path d="M440.651,132.739c-0.888-2.354-2.721-4.229-5.054-5.171L396.39,111.75c-2.435-12.666-12.056-22.81-24.436-26.008l-2.115-24.363c-0.309-3.565-2.701-6.608-6.093-7.751c-3.391-1.142-7.137-0.167-9.541,2.484l-10.062,11.099l-6.22-21.766c-1.072-3.752-4.44-6.386-8.341-6.521c-3.924-0.139-7.444,2.258-8.773,5.928L274.34,173.047c0,0-172.127,8.035-172.199,8.039c-35.296,2.121-68.735-16.765-85.167-48.119c-2.309-4.402-7.748-6.102-12.149-3.794c-4.403,2.308-6.101,7.747-3.794,12.149c14.69,28.03,40.708,47.75,70.541,54.93c-3.097,3.609-9.751,12.554-13.642,26.617c-4.231,15.291-5.756,39.667,9.801,70.619L42.499,327.76c-1.474,2.001-2.054,4.523-1.603,6.968l11.105,60.218c0.787,4.268,4.51,7.367,8.851,7.367h11.312c2.669,0,5.2-1.185,6.911-3.233c1.71-2.05,2.422-4.753,1.944-7.378l-7.032-38.627l74.401-55.853c0.131-0.099-0.126,0.107,0,0c7.114-5.975,12.278-12.556,15.972-19.322c38.777,6.808,91.844,16.02,125.857,21.498l14.986,95.314c0.689,4.377,4.46,7.602,8.891,7.602h9.308c4.971,0,9-4.029,9-9V296.56c8.449-5.77,11.469-15.42,13.472-24.871c0.063-0.297,20.022-92.416,20.022-92.416c3.762,0.627,7.561,0.956,11.388,0.956c26.356,0,50.492-15.431,62.987-40.271C441.401,137.712,441.539,135.094,440.651,132.739z"/></svg>
                <span class="m">30 min</span>
              </button>
              <button class="prep-btn" type="button" data-min="45" title={t("ord.prepBusy")}>
                <svg viewBox="0 0 100 100" fill="currentColor" aria-hidden="true"><path d="m83.9 23.3h-3.9c-5.5 0-10 4.5-10 10v10c0 11-17.9 20-40 20h-17.6c-1.3 0-2.4 1.1-2.4 2.4v1.9c0 1.3 1.1 2.4 2.4 2.4 1.7 0 2.8 1.7 2.3 3.2 0 .1-.1.2-.1.2-.6 1.6.6 3.2 2.2 3.2h2c1 0 1.9-.6 2.3-1.6.4-1.1.8-2.3 1.1-3.4.3-1 1.2-1.7 2.3-1.7h8.9c10.1 0 19.3-1.7 26.7-4.6 1.4-.5 2.9.2 3.2 1.7.7 2.7 1.4 5.4 2.3 8 .3 1 1.3 1.6 2.3 1.6h2c1.7 0 2.8-1.6 2.2-3.2-1.3-3.5-2.3-7.1-3.1-10.8-.2-.9.2-1.9.9-2.4 4.8-3.4 8-7.6 9.4-12.2.3-.9 1-1.5 1.9-1.7 5.1-.9 8.8-3.4 8.8-6.3v-10.5c0-3.4-2.7-6.2-6.1-6.2zm-3.3 12.5c-1.9.4-3.5-1.2-3-3 .2-.9.9-1.6 1.8-1.8 1.9-.5 3.5 1.2 3.1 3.1-.3.7-1 1.5-1.9 1.7z"/><path d="m10.2 53.3c-.2 1.8 1.2 3.3 3 3.3h16.8c20.3 0 33.3-7.9 33.3-13.3v-11.7c0-1-.5-1.9-1.4-2.5-5.3-3.6-11.7-5.7-18.6-5.7-17.2-.1-31.5 13.1-33.1 29.9z"/></svg>
                <span class="m">45 min</span>
              </button>
              <button class="prep-btn prep-close" type="button" id="btn-close-orders" title={t("ord.closeOnline")}>
                <svg viewBox="0 0 30 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="15" cy="12" r="8.5" />
                  <path d="M9 6 L21 18" />
                </svg>
                <span class="m" id="close-orders-label">{t("common.close")}</span>
              </button>
            </div>
          </div>
        </div>
        <div class="state" id="state">{t("sup.loading")}</div>
        <div class="grid" id="grid"></div>
        <h2 class="done-title" id="done-title" style="display:none">{t("ord.doneCancelled")}</h2>
        <div class="grid" id="grid-done"></div>
      </main>
      <AdminFooter />
    </div>

    <!-- Modale Remboursement -->
    <div class="rf-overlay" id="rf-overlay" role="dialog" aria-modal="true" aria-labelledby="rf-title">
      <div class="rf-modal">
        <h2 class="rf-title" id="rf-title">{t("ord.refundTitle")}</h2>
        <p class="rf-sub" id="rf-sub"></p>
        <label class="rf-label" for="rf-amount">{t("ord.refundAmount")}</label>
        <div class="rf-inputrow">
          <span class="rf-euro">€</span>
          <input class="rf-amount" id="rf-amount" type="number" inputmode="decimal" min="0" step="0.01" />
          <button class="rf-all" type="button" id="rf-all">{t("ord.all")}</button>
        </div>
        <p class="rf-msg" id="rf-msg"></p>
        <div class="rf-actions">
          <button class="rf-cancel" type="button" id="rf-cancel">{t("common.cancel")}</button>
          <button class="rf-confirm" type="button" id="rf-confirm">{t("ord.refund")}</button>
        </div>
      </div>
    </div>

    <!-- Nouvelle commande (manuale con link di pagamento) -->
    <button class="nc-add" id="nc-add" type="button" style="display:none"><span class="fab-plus">+</span>{t("ord.order")}</button>
    <div class="nc-overlay" id="nc-overlay" role="dialog" aria-modal="true">
      <div class="nc-modal">
        <button class="nc-close" id="nc-close" aria-label={t("common.close")}>×</button>
        <h2 id="nc-title">{t("ord.newOrder")}</h2>

        {/* Stepper: Prodotti → Ritiro → Cliente → Pagamento */}
        <div class="nc-steps" id="nc-steps">
          <span class="nc-step is-on" data-s="1">{t("ord.step1")}</span>
          <span class="nc-step" data-s="2">{t("ord.step2")}</span>
          <span class="nc-step" data-s="3">{t("ord.step3")}</span>
        </div>

        {/* STEP 1 — Prodotti (menu + carrello) */}
        <div class="nc-panel" data-panel="1">
          <div class="nc-grid">
            <div>
              <span class="nc-lab">{t("nav.menu")}</span>
              <div class="nc-cats" id="nc-cats"></div>
              <div class="nc-items" id="nc-items"></div>
            </div>
            <div>
              <span class="nc-lab">{t("ord.cart")}</span>
              <div class="nc-cart" id="nc-cart"><div class="nc-cart-empty">{t("ord.cartEmpty")}</div></div>
              <div class="nc-total"><span>{t("ord.total")}</span><b id="nc-total">0,00 €</b></div>
            </div>
          </div>
        </div>

        {/* STEP 2 — Ritiro (servizio + orario + nota) */}
        <div class="nc-panel" data-panel="2" hidden>
          <span class="nc-lab">{t("ord.date")}</span>
          <div class="nc-dates" id="nc-dates">
            <button type="button" class="nc-pill is-on" data-date="today">{t("ord.today")}</button>
            <button type="button" class="nc-pill" data-date="tomorrow">{t("ord.tomorrow")}</button>
            <button type="button" class="nc-pill nc-date-pick" id="nc-date-pick" data-date="pick">{t("ord.otherDate")}</button>
          </div>
          <span class="nc-lab">{t("ord.pickupTime")}</span>
          <div class="nc-svcs" id="nc-svcs"></div>
          <div class="nc-slots" id="nc-slots"><span class="nc-slots-empty">{t("sup.loading")}</span></div>
          <span class="nc-lab">{t("ord.note")}</span>
          <textarea class="nc-in" id="nc-note" rows="3"></textarea>
        </div>

        {/* STEP 3 — Cliente + Pagamento (due colonne) */}
        <div class="nc-panel" data-panel="3" hidden>
          <div class="nc-grid">
            <div>
              <span class="nc-lab">{t("ord.client")}</span>
              {/* Form dedicato: l'autofill del browser (nome→email/tel) riempie
                  QUESTI campi, non la ricerca dietro il modale. */}
              <form id="nc-cli-form" autocomplete="on" novalidate>
                <div class="nc-row">
                  <input type="text" class="nc-in" id="nc-prenom" autocomplete="given-name" placeholder={t("ord.firstName")} />
                  <input type="text" class="nc-in" id="nc-nom" autocomplete="family-name" placeholder={t("ord.lastNameReq")} />
                </div>
                <input type="email" class="nc-in" id="nc-email" autocomplete="email" placeholder={t("ord.emailReq")} />
                <div class="nc-tel">
                  <select class="nc-in nc-tel-prefix brand-select" id="nc-tel-prefix" aria-label="Prefisso" set:html={opzioniPrefisso(CLIENT.paese)}></select>
                  <input type="tel" class="nc-in" id="nc-tel" autocomplete="tel" placeholder={t("ord.phone")} />
                </div>
              </form>
            </div>
            <div>
              <span class="nc-lab">{t("ord.cart")}</span>
              <div class="nc-recap" id="nc-recap"></div>
              <div class="nc-total"><span>{t("ord.total")}</span><b id="nc-total-2">0,00 €</b></div>
              <span class="nc-lab" id="nc-pay-lab">{t("ord.payLabel")}</span>
              <div class="nc-pay">
                <button type="button" class="nc-pay-btn" id="nc-cash" data-pay="cash">{t("ord.payCash")}</button>
                <button type="button" class="nc-pay-btn" id="nc-card" data-pay="card">{t("ord.payCard")}</button>
              </div>
              <button type="button" class="nc-pay-btn nc-pay-link" id="nc-link" data-pay="link">{t("ord.payLinkShort")}</button>
              {/* Scelta lingua: compare SOLO dopo aver scelto il metodo di pagamento */}
              <div id="nc-lang-block" style="display:none">
                <span class="nc-lab">{t("ord.emailLang")}</span>
                <div class="nc-pills" id="nc-langs" data-default={linguaDefault}>
                  {linguePillole.map((l) => (
                    <button type="button" class={"nc-pill" + (l.code === linguaDefault ? " is-on" : "")} data-lang={l.code}>{l.label}</button>
                  ))}
                </div>
              </div>
              {/* Conferma: compare dopo la scelta del metodo; l'etichetta cambia */}
              <button type="button" class="nc-send" id="nc-send" style="display:none">{t("ord.createSend")}</button>
            </div>
          </div>
        </div>

        {/* Navigazione */}
        <div class="nc-nav">
          <button type="button" class="nc-nav-btn" id="nc-prev">{t("mk.prev")}</button>
          <button type="button" class="nc-nav-btn nc-nav-next" id="nc-next">{t("mk.next")}</button>
        </div>
      </div>
    </div>
    <div class="nc-toast" id="nc-toast"></div>

    <AdminNav current="orders" />

    <!-- Dati SSR (Fase 2): ordini pre-caricati dal server, letti dal client. -->
    <script id="ssr-orders" type="application/json" is:inline set:html={ssrOrdersJson}></script>

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { telefonoCompleto, collegaPrefissoTel, separaPrefisso } from "../../lib/prefissi";
      import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";

      const LANG = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(LANG);
      const LOC = ADMIN_LOCALE[LANG] ?? "fr-BE";

      type Item = { id: string; name: string; qty: number; price_cents: number; notes: string };
      type Order = {
        id: string;
        status: string;
        pickup_time: string;
        customer_name: string;
        customer_email: string;
        customer_phone: string | null;
        items: Item[];
        total_cents: number;
        lang: string | null;
        created_at: string;
        refunded_cents?: number;
        stripe_session_id?: string | null;
        supplement_due_cents?: number;
        refund_due_cents?: number;
        supplement_paid_at?: string | null;
      };

      function esc(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }
      function euro(cents: number): string {
        return (cents / 100).toLocaleString(LOC, { style: "currency", currency: "EUR" });
      }
      // Fuso del ristorante, esposto dall'header (data-tz)
      const TZ_LOCALE = (document.querySelector(".ah-header") as HTMLElement | null)?.dataset.tz || "Europe/Brussels";
      // Chiave-giorno (YYYY-MM-DD) di un istante ISO, nel fuso del ristorante.
      function dayKeyBrussels(iso: string): string {
        return new Date(iso).toLocaleDateString("en-CA", { timeZone: TZ_LOCALE });
      }
      // Ora HH:MM di un istante ISO, nel fuso di Bruxelles.
      function oraBrussels(iso: string): string {
        return new Date(iso).toLocaleTimeString(LOC, {
          timeZone: TZ_LOCALE,
          hour: "2-digit",
          minute: "2-digit",
        });
      }

      // Ristampa ticket — PREDISPOSTO ma NASCOSTO (§4.5 stampante termica).
      // Domani, con la stampa automatica attiva: mettere STAMPA_TICKET = true
      // per mostrare il bottone, e collegare ristampaTicket() a /api/admin/print.
      const STAMPA_TICKET = false;
      const ICON_PRINT = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6"/><path d="M6 18H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="7" rx="1"/></svg>`;

      // Cestino (annulla ordine) — coerente con lo stile di ICON_PRINT.
      const ICON_BIN = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>`;

      // Matita (modifica ordine).
      const ICON_PENCIL = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>`;

      // Ricerca: filtra su nome/email/tel in TUTTI gli ordini caricati (7 giorni)
      let ricerca = "";
      const dataBrussels = (iso: string): string =>
        new Date(iso).toLocaleDateString(LOC, { weekday: "short", day: "2-digit", month: "2-digit", timeZone: TZ_LOCALE });

      // Livello di ritardo sull'ora di ritiro, SOLO per ordini attivi:
      // 0 = in tempo · 1 = ≥5 min (bianco) · 2 = ≥10 min (arancio) · 3 = ≥15 min (rosso).
      function ncLivelloRitardo(pickupIso: string, status: string): number {
        if (status !== "paid" && status !== "pending") return 0;
        const diffMin = (Date.now() - new Date(pickupIso).getTime()) / 60000;
        if (diffMin >= 15) return 3;
        if (diffMin >= 10) return 2;
        if (diffMin >= 5) return 1;
        return 0;
      }
      function cardHTML(o: Order): string {
        const note = o.items.find((i) => i.id === "note");
        const piatti = o.items.filter((i) => i.id !== "note");

        const phone = o.customer_phone
          ? `<p class="row">${tr("ord.telLabel")} : <a href="tel:${esc(o.customer_phone)}">${esc(o.customer_phone)}</a></p>`
          : "";
        const langBadge = o.lang ? `<span class="badge">${esc(o.lang)}</span>` : "";

        const itemsHTML = piatti
          .map((i) => {
            const sub = i.notes ? ` <span class="item-sub">(${esc(i.notes)})</span>` : "";
            return `
              <div class="item">
                <span class="item-qty">${i.qty}×</span>
                <span class="item-name">${esc(i.name)}${sub}</span>
              </div>`;
          })
          .join("");

        const noteHTML = note?.notes ? `<div class="order-note">📝 ${esc(note.notes)}</div>` : "";

        // Etichetta di stato (solo per le card spente)
        let tag = "";
        if (o.status === "done") tag = `<span class="tag tag-done">${tr("ord.terminee")}</span>`;
        if (o.status === "pending") tag = `<span class="tag tag-pending" title="${tr("ord.awaitingPayment")}">${tr("ord.awaitingShort")}</span>`;
        if (o.status === "paid") tag = `<span class="tag tag-paid">${tr("ord.paid")}</span>`;
        // Differenza dopo una modifica: da incassare (supplemento) o gia' saldata.
        if (o.status === "paid" && (o.supplement_due_cents ?? 0) > 0) {
          tag += `<span class="tag tag-suppdue" title="${tr("ord.diffDueTitle")}">${tr("ord.diffDue")} ${euro(o.supplement_due_cents ?? 0)}</span>`;
        } else if (o.status === "paid" && o.supplement_paid_at) {
          tag += `<span class="tag tag-supppaid" title="${tr("ord.diffPaidTitle")}">${tr("ord.diffPaid")} ✓</span>`;
        }


        // Ordini attivi: Terminée + Annuler.
        // Ordini terminati: ✓ vert rond à côté du prix + bouton rollback doré
        // (position absolue, en bas à droite) pour remettre « en cours ».
        const actions =
          o.status === "paid"
            ? `<div class="actions">
                 <button class="btn-done" type="button" data-id="${o.id}" data-act="done">✓ ${tr("ord.terminee")}</button>
                 <button class="btn-edit" type="button" data-id="${o.id}" data-act="edit" title="${tr("ord.edit")}" aria-label="${tr("ord.edit")}">${ICON_PENCIL}</button>
                 <button class="btn-cancel" type="button" data-id="${o.id}" data-act="cancel" title="${tr("common.cancel")}" aria-label="${tr("common.cancel")}">${ICON_BIN}</button>
               </div>`
            : o.status === "pending"
              ? `<div class="actions">
                   <button class="btn-resend" type="button" data-id="${o.id}" data-act="resend" title="${tr("ord.resendEmail")}">${tr("ord.resendShort")}</button>
                   <button class="btn-edit" type="button" data-id="${o.id}" data-act="edit" title="${tr("ord.edit")}" aria-label="${tr("ord.edit")}">${ICON_PENCIL}</button>
                   <button class="btn-cancel" type="button" data-id="${o.id}" data-act="cancel" title="${tr("common.cancel")}" aria-label="${tr("common.cancel")}">${ICON_BIN}</button>
                 </div>`
              : "";

        const badgeOk = o.status === "done" ? `<span class="badge-ok" title="${tr("ord.terminee")}">✓</span>` : "";
        const badgeKo = o.status === "cancelled" ? `<span class="badge-ko" title="${tr("ord.annulee")}">✕</span>` : "";
        // Bottone stampante (ristampa ticket): reso solo se STAMPA_TICKET = true.
        const stampaBtn = STAMPA_TICKET
          ? `<button class="btn-print" type="button" data-id="${o.id}" data-act="print" title="${tr("ord.reprint")}" aria-label="${tr("ord.reprint")}">${ICON_PRINT}</button>`
          : "";
        const rollback =
          o.status === "done"
            ? `<button class="btn-rollback" type="button" data-id="${o.id}" data-act="rollback" title="${tr("ord.putBack")}" aria-label="${tr("ord.putBack")}">↩</button>`
            : "";
        // Ordini ANNULÉS pagati con Stripe: rimborso (totale o parziale).
        // Stato rimborso = tag in alto; bottone "Rembourser" = assoluto in basso
        // a destra (come il rollback), 100% opaco.
        const refunded = o.refunded_cents ?? 0;
        const residuo = o.total_cents - refunded;
        // Rimborsabile solo se PAGATO davvero: dopo il webhook stripe_session_id
        // è l'id cs_… ; un pending annullato ha ancora l'URL del link (mai incassato).
        const isStripe = o.status === "cancelled" && /^cs_/.test(String(o.stripe_session_id ?? ""));
        if (isStripe && refunded > 0) {
          tag += residuo > 0
            ? `<span class="tag tag-refund">${tr("ord.refunded")} ${euro(refunded)}</span>`
            : `<span class="tag tag-refund">${tr("ord.refunded")} ✓</span>`;
        }
        const refundBtn =
          isStripe && residuo > 0
            ? `<button class="btn-refund" type="button" data-id="${o.id}" data-act="refund" data-residuo="${residuo}">${tr("ord.refund")}</button>`
            : "";
        // Modifica al ribasso su ordine pagato online: bottone "rimborsa differenza"
        // (1 clic + conferma). Importo esatto = refund_due_cents (tracciato lato server).
        const diffRefundBtn =
          o.status === "paid" && (o.refund_due_cents ?? 0) > 0
            ? `<button class="btn-diffrefund" type="button" data-id="${o.id}" data-act="diffrefund" data-diff="${o.refund_due_cents ?? 0}">${tr("ord.refundDiff")} · ${euro(o.refund_due_cents ?? 0)}</button>`
            : "";
        const lr = ncLivelloRitardo(o.pickup_time, o.status);
        const cardCls =
          (o.status === "paid" || o.status === "pending" ? "" : o.status === "done" ? " done" : " off") +
          (refundBtn ? " refundable" : "") +
          (lr ? ` nc-late nc-late-${lr}` : "");

        return `
          <div class="card${cardCls}" data-id="${o.id}">
            <div class="card-top">
              <div class="ct-left">
                <span class="time">${esc(oraBrussels(o.pickup_time))}${ricerca ? `<span class="o-date"> · ${esc(dataBrussels(o.pickup_time))}</span>` : ""}</span>
                ${tag}
              </div>
              <span class="ct-right">${stampaBtn}${badgeOk}${badgeKo}<span class="total">${euro(o.total_cents)}</span></span>
            </div>
            <p class="name">${esc(o.customer_name)}${langBadge}</p>
            <p class="row">${tr("ord.emailLabel")} : <a href="mailto:${esc(o.customer_email)}">${esc(o.customer_email)}</a></p>
            ${phone}
            <div class="items">${itemsHTML}</div>
            ${noteHTML}
            ${actions}
            ${diffRefundBtn}
            ${refundBtn}
            ${rollback}
          </div>`;
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const gridEl = document.getElementById("grid") as HTMLDivElement;
        const gridDoneEl = document.getElementById("grid-done") as HTMLDivElement;
        const doneTitleEl = document.getElementById("done-title") as HTMLHeadingElement;
        const countEl = document.getElementById("count") as HTMLParagraphElement;
        const labelEl = document.getElementById("today-label") as HTMLParagraphElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        const token = session.access_token ?? "";
        const headers = { Authorization: `Bearer ${token}` };

        // --- Bottoni rapidi tempo di preparazione (15/30/45) ---
        const prepBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".prep-btn"));
        const prepNote = document.getElementById("prep-note") as HTMLSpanElement;

        function segnaAttivo(min: number) {
          prepBtns.forEach((b) => b.classList.toggle("active", Number(b.dataset.min) === min));
        }

        // Stato attuale (stesso valore dei Réglages)
        fetch("/api/admin/settings", { headers })
          .then((r) => (r.ok ? r.json() : null))
          .then((j) => {
            if (j && typeof j.prep_time_minutes === "number") segnaAttivo(j.prep_time_minutes);
            if (j && typeof j.orders_closed === "boolean") {
              ordiniChiusi = j.orders_closed;
              segnaChiusura();
            }
          })
          .catch(() => {});

        prepBtns.forEach((btn) => {
          btn.addEventListener("click", async () => {
            const min = Number(btn.dataset.min);
            prepBtns.forEach((b) => (b.disabled = true));
            prepNote.textContent = "";
            prepNote.classList.remove("err");
            try {
              // Scegliere un tempo di preparazione RIAPRE anche il servizio
              // se era stato chiuso col bottone "Fermer".
              const r = await fetch("/api/admin/settings", {
                method: "PATCH",
                headers: { ...headers, "Content-Type": "application/json" },
                body: JSON.stringify({ prep_time_minutes: min, orders_closed: false }),
              });
              if (!r.ok) throw new Error();
              segnaAttivo(min);
              ordiniChiusi = false;
              segnaChiusura();
              prepNote.textContent = "✓";
              setTimeout(() => {
                prepNote.textContent = "";
              }, 2000);
            } catch {
              prepNote.textContent = tr("ord.errShort");
              prepNote.classList.add("err");
            } finally {
              prepBtns.forEach((b) => (b.disabled = false));
              btn.blur();
            }
          });
        });

        // --- Bottone "Fermer": chiude/riapre le commandes online ---
        const btnClose = document.getElementById("btn-close-orders") as HTMLButtonElement;
        const lblClose = document.getElementById("close-orders-label") as HTMLSpanElement;
        let ordiniChiusi = false;

        function segnaChiusura() {
          btnClose.classList.toggle("closed", ordiniChiusi);
          lblClose.textContent = ordiniChiusi ? tr("ord.closed") : tr("common.close");
          btnClose.title = ordiniChiusi
            ? tr("ord.reopenOnline")
            : tr("ord.closeOnline");
        }

        btnClose.addEventListener("click", async () => {
          btnClose.disabled = true;
          prepNote.textContent = "";
          prepNote.classList.remove("err");
          try {
            const r = await fetch("/api/admin/settings", {
              method: "PATCH",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ orders_closed: !ordiniChiusi }),
            });
            if (!r.ok) throw new Error();
            ordiniChiusi = !ordiniChiusi;
            segnaChiusura();
            prepNote.textContent = "✓";
            setTimeout(() => {
              prepNote.textContent = "";
            }, 2000);
          } catch {
            prepNote.textContent = tr("ord.errShort");
            prepNote.classList.add("err");
          } finally {
            btnClose.disabled = false;
            btnClose.blur();
          }
        });

        // --- Ordini di oggi ---
        let ordini: Order[] = [];
        // Conferma "Annuler" in 2 tocchi
        let confirmId: string | null = null;
        let diffConfirmId: string | null = null;
        let confirmTimer: number | undefined;

        function resetConfirm() {
          confirmId = null;
          diffConfirmId = null;
          if (confirmTimer) clearTimeout(confirmTimer);
          document.querySelectorAll<HTMLButtonElement>(".btn-cancel.confirm").forEach((b) => {
            b.classList.remove("confirm");
            b.innerHTML = ICON_BIN;
          });
          document.querySelectorAll<HTMLButtonElement>(".btn-diffrefund.confirm").forEach((b) => {
            b.classList.remove("confirm");
            const d = Math.max(0, Math.round(Number(b.dataset.diff ?? "0")));
            b.textContent = `${tr("ord.refundDiff")} · ${euro(d)}`;
          });
        }

        function render() {
          const oggi = new Date();
          const oggiKey = dayKeyBrussels(oggi.toISOString());

          // Modalità RICERCA: tutti gli ordini caricati (non solo oggi), flat
          if (ricerca) {
            const q = ricerca;
            const trovati = ordini
              .filter((o) => `${o.customer_name ?? ""} ${o.customer_email ?? ""} ${o.customer_phone ?? ""}`.toLowerCase().includes(q))
              .sort((a, b) => (a.pickup_time > b.pickup_time ? -1 : 1));
            labelEl.textContent = `${tr("ord.search")} — ${trovati.length} ${trovati.length === 1 ? tr("ord.result") : tr("ord.results")}`;
            countEl.textContent = "";
            if (trovati.length === 0) {
              stateEl.textContent = tr("ord.noneFound");
              stateEl.style.display = "block";
            } else {
              stateEl.style.display = "none";
            }
            gridEl.innerHTML = trovati.map(cardHTML).join("");
            gridDoneEl.innerHTML = "";
            doneTitleEl.style.display = "none";
            return;
          }

          labelEl.textContent =
            tr("ord.today") + " — " +
            oggi.toLocaleDateString(LOC, { weekday: "long", day: "numeric", month: "long" });

          // Solo oggi, dal ritiro più vicino al più lontano
          const ordOggi = ordini
            .filter((o) => dayKeyBrussels(o.pickup_time) === oggiKey)
            .sort((a, b) => (a.pickup_time < b.pickup_time ? -1 : 1));

          // I pending MANUALI (link di pagamento inviato) stanno tra gli attivi
          const attivi = ordOggi.filter((o) => o.status === "paid" || o.status === "pending");
          const spenti = ordOggi.filter((o) => o.status === "done" || o.status === "cancelled");

          // Conteggio e totale: solo il denaro INCASSATO (paid + done);
          // i pending si contano a parte ("en attente")
          const incassati = ordOggi.filter((o) => o.status === "paid" || o.status === "done");
          const pendenti = ordOggi.filter((o) => o.status === "pending").length;
          const tot = incassati.reduce((s, o) => s + o.total_cents, 0);
          const parti: string[] = [];
          if (incassati.length)
            parti.push(`${incassati.length} ${incassati.length === 1 ? tr("ord.commandeSg") : tr("home.ordersWord")}` + ` · ${euro(tot)}`);
          if (pendenti) parti.push(`${pendenti} ${tr("ord.pending")}`);
          countEl.textContent = parti.join(" · ");

          if (ordOggi.length === 0) {
            stateEl.textContent = tr("ord.nonePaidToday");
            stateEl.style.display = "block";
          } else if (attivi.length === 0) {
            stateEl.textContent = tr("ord.noneInProgress");
            stateEl.style.display = "block";
          } else {
            stateEl.style.display = "none";
          }

          gridEl.innerHTML = attivi.map(cardHTML).join("");
          gridDoneEl.innerHTML = spenti.map(cardHTML).join("");
          doneTitleEl.style.display = spenti.length > 0 ? "block" : "none";
        }

        // --- Campo ricerca ---
        const oSearch = document.getElementById("o-search") as HTMLInputElement | null;
        const oSearchX = document.getElementById("o-search-x") as HTMLButtonElement | null;
        const aggiornaRicerca = () => {
          ricerca = (oSearch?.value ?? "").trim().toLowerCase();
          if (oSearchX) oSearchX.style.display = ricerca ? "" : "none";
          render();
        };
        oSearch?.addEventListener("input", aggiornaRicerca);
        oSearchX?.addEventListener("click", () => {
          if (oSearch) oSearch.value = "";
          aggiornaRicerca();
          oSearch?.focus();
        });

        async function cambiaStato(id: string, status: string, btn: HTMLButtonElement) {
          const card = btn.closest(".card");
          card?.querySelectorAll("button").forEach((b) => (b.disabled = true));
          try {
            const r = await fetch("/api/admin/orders", {
              method: "PATCH",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id, status }),
            });
            if (!r.ok) throw new Error();
            const ord = ordini.find((o) => o.id === id);
            if (ord) ord.status = status;
            resetConfirm();
            render();
          } catch {
            btn.textContent = tr("ord.errShort");
            setTimeout(() => {
              resetConfirm();
              render();
            }, 1500);
          }
        }

        // Rimborso "differenza" (1 clic dopo conferma): rimborsa esattamente la
        // parte tolta con la modifica, sul pagamento Stripe originale.
        async function rimborsaDifferenza(id: string, diff: number, btn: HTMLButtonElement) {
          const card = btn.closest(".card");
          card?.querySelectorAll("button").forEach((b) => (b.disabled = true));
          btn.textContent = tr("ord.refunding");
          try {
            const r = await fetch("/api/admin/refund", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id, amount_cents: diff, difference: true }),
            });
            const j = (await r.json().catch(() => ({}))) as { error?: string; amount?: number; refunded_cents?: number };
            if (!r.ok) throw new Error(j.error || tr("ord.refundFailed"));
            const ord = ordini.find((o) => o.id === id);
            if (ord) {
              ord.refunded_cents = Number(j.refunded_cents ?? (ord.refunded_cents ?? 0) + diff);
              ord.refund_due_cents = 0;
            }
            resetConfirm();
            render();
            ncToast(`${tr("ord.refunded")} : ${euro(Number(j.amount ?? diff))} ✓`);
          } catch (e2) {
            resetConfirm();
            render();
            ncToast(e2 instanceof Error ? e2.message : tr("ord.refundFailed"), true);
          }
        }

        // Ristampa ticket — PREDISPOSTO ma inattivo finché non c'è la stampa
        // automatica. Domani: implementare qui la POST verso /api/admin/print.
        function ristampaTicket(id: string) {
          // TODO (§4.5 stampante): await fetch("/api/admin/print", { method:"POST",
          //   headers:{...headers,"Content-Type":"application/json"}, body:JSON.stringify({ id }) });
          void id;
        }

        gridEl.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-act]");
          if (!btn || btn.disabled) return;
          const id = btn.dataset.id ?? "";

          if (btn.dataset.act === "print") {
            ristampaTicket(id);
            return;
          }
          if (btn.dataset.act === "done") {
            cambiaStato(id, "done", btn);
            return;
          }
          if (btn.dataset.act === "edit") {
            const ord = ordini.find((o) => o.id === id);
            if (ord) void apriNcEdit(ord);
            return;
          }
          if (btn.dataset.act === "resend") {
            btn.disabled = true;
            fetch("/api/admin/orders", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ resend_id: id }),
            })
              .then(async (r) => {
                const j = (await r.json()) as { error?: string };
                if (!r.ok) throw new Error(j.error || tr("ord.sendFailed"));
                ncToast(tr("ord.paymentResent"));
              })
              .catch((e2) => ncToast(e2 instanceof Error ? e2.message : tr("ord.sendFailed"), true))
              .finally(() => {
                btn.disabled = false;
              });
            return;
          }
          if (btn.dataset.act === "diffrefund") {
            const diff = Math.max(0, Math.round(Number(btn.dataset.diff ?? "0")));
            if (diffConfirmId === id && btn.classList.contains("confirm")) {
              void rimborsaDifferenza(id, diff, btn);
            } else {
              resetConfirm();
              diffConfirmId = id;
              btn.classList.add("confirm");
              btn.textContent = tr("ord.confirmRefundDiff");
              confirmTimer = window.setTimeout(resetConfirm, 4000);
            }
            return;
          }
          // Annuler: primo tocco arma la conferma, secondo tocco conferma
          if (confirmId === id && btn.classList.contains("confirm")) {
            cambiaStato(id, "cancelled", btn);
          } else {
            resetConfirm();
            confirmId = id;
            btn.classList.add("confirm");
            btn.innerHTML = tr("ord.cancelQ");
            confirmTimer = window.setTimeout(resetConfirm, 4000);
          }
        });

        // Card TERMINÉE : rollback (→ paid) + ristampa ticket (predisposta).
        gridDoneEl.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-act]");
          if (!btn || btn.disabled) return;
          if (btn.dataset.act === "print") {
            ristampaTicket(btn.dataset.id ?? "");
            return;
          }
          if (btn.dataset.act === "refund") {
            apriRimborso(btn);
            return;
          }
          if (btn.dataset.act === "rollback") {
            cambiaStato(btn.dataset.id ?? "", "paid", btn);
          }
        });

        // ---- Modale Remboursement (rimborso Stripe, totale o parziale) ----
        const rfOverlay = document.getElementById("rf-overlay") as HTMLDivElement;
        const rfSub = document.getElementById("rf-sub") as HTMLParagraphElement;
        const rfAmount = document.getElementById("rf-amount") as HTMLInputElement;
        const rfMsg = document.getElementById("rf-msg") as HTMLParagraphElement;
        const rfConfirm = document.getElementById("rf-confirm") as HTMLButtonElement;
        const rfCancel = document.getElementById("rf-cancel") as HTMLButtonElement;
        const rfAll = document.getElementById("rf-all") as HTMLButtonElement;
        let rfId = "";
        let rfResiduo = 0;

        function apriRimborso(btn: HTMLButtonElement) {
          rfId = btn.dataset.id ?? "";
          rfResiduo = Math.max(0, Math.round(Number(btn.dataset.residuo ?? "0")));
          rfMsg.textContent = "";
          rfMsg.classList.remove("ok");
          rfSub.textContent = `${tr("ord.refundable")} : ${euro(rfResiduo)}`;
          rfAmount.value = (rfResiduo / 100).toFixed(2);
          rfAmount.max = (rfResiduo / 100).toFixed(2);
          rfConfirm.disabled = false;
          rfOverlay.classList.add("is-open");
          rfAmount.focus();
          rfAmount.select();
        }
        function chiudiRimborso() {
          rfOverlay.classList.remove("is-open");
        }
        rfCancel.addEventListener("click", chiudiRimborso);
        rfOverlay.addEventListener("click", (e) => {
          if (e.target === rfOverlay) chiudiRimborso();
        });
        rfAll.addEventListener("click", () => {
          rfAmount.value = (rfResiduo / 100).toFixed(2);
        });

        rfConfirm.addEventListener("click", async () => {
          const euros = Number(String(rfAmount.value).replace(",", "."));
          const cents = Math.round(euros * 100);
          if (!Number.isFinite(cents) || cents <= 0) {
            rfMsg.classList.remove("ok");
            rfMsg.textContent = tr("ord.invalidAmount");
            return;
          }
          if (cents > rfResiduo) {
            rfMsg.classList.remove("ok");
            rfMsg.textContent = `${tr("ord.maximum")} : ${euro(rfResiduo)}.`;
            return;
          }
          rfConfirm.disabled = true;
          rfMsg.classList.remove("ok");
          rfMsg.textContent = tr("ord.refunding");
          try {
            const r = await fetch("/api/admin/refund", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id: rfId, amount_cents: cents }),
            });
            const j = await r.json().catch(() => ({}) as any);
            if (!r.ok) {
              rfMsg.classList.remove("ok");
              rfMsg.textContent = j.error || tr("ord.refundFailed");
              rfConfirm.disabled = false;
              return;
            }
            const ord = ordini.find((o) => o.id === rfId);
            if (ord) ord.refunded_cents = Number(j.refunded_cents ?? (ord.refunded_cents ?? 0) + cents);
            rfMsg.classList.add("ok");
            rfMsg.textContent = `${tr("ord.refunded")} : ${euro(Number(j.amount ?? cents))} ✓`;
            render();
            setTimeout(chiudiRimborso, 1200);
          } catch {
            rfMsg.classList.remove("ok");
            rfMsg.textContent = tr("common.netErr");
            rfConfirm.disabled = false;
          }
        });

        // Firma compatta: serve a capire se un refresh silenzioso ha portato
        // davvero delle novità. Se non cambia, non si tocca il DOM.
        let firmaOrdini = "";
        function firmaDa(list: Order[]): string {
          return JSON.stringify(
            list.map((o) => [o.id, o.status, o.pickup_time, o.total_cents, o.customer_name])
          );
        }

        // `silenzioso = true` → aggiornamento in background: niente messaggio di
        // caricamento e si ridisegna SOLO se qualcosa è cambiato. Così un nuovo
        // ordine appare da solo, senza ricaricare la pagina e senza lampeggìo.
        async function carica(silenzioso = false) {
          try {
            const res = await fetch("/api/admin/orders", { headers });
            if (!res.ok) {
              if (!silenzioso) stateEl.textContent = tr("sup.load.error");
              return;
            }
            const json = await res.json();
            const list = (json.orders as Order[]) ?? [];
            const firma = firmaDa(list);
            if (silenzioso && firma === firmaOrdini) return;
            firmaOrdini = firma;
            ordini = list;
            render();
          } catch {
            if (!silenzioso) stateEl.textContent = tr("common.netErr");
          }
        }

        // Aggiornamento live silenzioso: non interrompe una conferma "Annuler".
        function refreshLive() {
          if (document.visibilityState !== "visible") return;
          if (confirmId) return;
          void carica(true);
        }

        // Primo render: se il server ha già fornito gli ordini (SSR, Fase 2),
        // li usiamo SUBITO senza fetch; altrimenti carichiamo come prima.
        const ssrEl = document.getElementById("ssr-orders");
        const ssrRaw = ssrEl?.textContent?.trim();
        let ssrOk = false;
        if (ssrRaw) {
          try {
            const list = JSON.parse(ssrRaw) as Order[];
            ordini = list;
            firmaOrdini = firmaDa(list);
            render();
            ssrOk = true;
          } catch {
            ssrOk = false;
          }
        }
        if (!ssrOk) {
          await carica(); // nessun dato SSR → comportamento attuale
        } else {
          void carica(true); // già mostrato: riallinea in background, silenzioso
        }

        // 1) evento da AdminNav all'arrivo di un nuovo ordine pagato
        window.addEventListener("moodd:new-order", () => refreshLive());
        // 2) quando torni sulla scheda dell'admin
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible") refreshLive();
        });
        // 3) rete di sicurezza ogni 25s, SILENZIOSA: ridisegna solo se qualcosa
        //    è cambiato (es. stato modificato da un altro dispositivo).
        setInterval(refreshLive, 25_000);

        // Aura « ritardo »: aggiorna le classi sulle card già a schermo ogni 30s,
        // così l'alone sale di livello (bianco→arancio→rosso) senza ridisegnare
        // tutto (niente fetch, niente perdita dello stato "Annuler ?").
        function aggiornaAure() {
          document.querySelectorAll<HTMLElement>(".card[data-id]").forEach((el) => {
            const o = ordini.find((x) => x.id === el.dataset.id);
            if (!o) return;
            const lr = ncLivelloRitardo(o.pickup_time, o.status);
            el.classList.toggle("nc-late", lr > 0);
            el.classList.toggle("nc-late-1", lr === 1);
            el.classList.toggle("nc-late-2", lr === 2);
            el.classList.toggle("nc-late-3", lr === 3);
          });
        }
        setInterval(aggiornaAure, 30_000);

        // ---- Nouvelle commande MANUALE (link di pagamento Stripe via email) ----
        const ncOverlay = document.getElementById("nc-overlay") as HTMLDivElement;
        const ncToastEl = document.getElementById("nc-toast") as HTMLDivElement;
        let ncToastTimer = 0;
        function ncToast(msg: string, err = false) {
          ncToastEl.textContent = msg;
          ncToastEl.classList.toggle("err", err);
          ncToastEl.classList.add("show");
          window.clearTimeout(ncToastTimer);
          ncToastTimer = window.setTimeout(() => ncToastEl.classList.remove("show"), 3500);
        }
        type VoceMenu = {
          id: string; name: string; category: string; price_cents: number;
          available: boolean; orderable?: boolean;
          discount_type?: string | null; discount_value?: number | null;
        };
        let ncMenu: VoceMenu[] = [];
        const ncCart = new Map<string, { voce: VoceMenu; qty: number }>();
        // Lingua email dell'ordine: parte dalla predefinita della regola (data-default),
// e può cambiare solo tra le lingue pubbliche ATTIVE (pillole renderizzate SSR).
const NC_LANG_DEFAULT = (document.getElementById("nc-langs") as HTMLElement | null)?.dataset.default || "fr";
let ncLang: string = NC_LANG_DEFAULT;
        // Metodo di pagamento scelto (vuoto finché non si clicca un pulsante).
        let ncPayment: "" | "cash" | "card" | "link" = "";
        // Modifica: id dell'ordine in corso di modifica ("" = creazione nuova) e suo stato.
        let ncEditId = "";
        let ncEditStatus = "";
        let ncSlot = "";
        // Slot separati per servizio (Midi/Soir): si sceglie il servizio, poi l'ora.
        let ncLunch: string[] = [];
        let ncDinner: string[] = [];
        let ncSvc: "lunch" | "dinner" = "lunch";
        let ncSlotsEstesi = false;
        // Data del ritiro (ISO YYYY-MM-DD, fuso del ristorante). Default: oggi.
        let ncDate = "";
        function ncSlotsCorrente(): string[] {
          return ncSvc === "dinner" ? ncDinner : ncLunch;
        }
        function ncRenderSvcs() {
          const box = document.getElementById("nc-svcs") as HTMLDivElement;
          const tabs: string[] = [];
          if (ncLunch.length) tabs.push(`<button type="button" class="nc-pill${ncSvc === "lunch" ? " is-on" : ""}" data-svc="lunch">${tr("ord.svcLunch")}</button>`);
          if (ncDinner.length) tabs.push(`<button type="button" class="nc-pill${ncSvc === "dinner" ? " is-on" : ""}" data-svc="dinner">${tr("ord.svcDinner")}</button>`);
          box.innerHTML = tabs.join("");
        }
        function ncRenderSlots() {
          const slotsBox = document.getElementById("nc-slots") as HTMLDivElement;
          const slots = ncSlotsCorrente();
          if (!slots.length) {
            slotsBox.innerHTML = `<span class="nc-slots-empty">${tr("ord.noSlotsToday")}</span>`;
            return;
          }
          const LIM = 17; // ~3 righe; l'ultima cella è la pillola "+N"
          const visibili = ncSlotsEstesi ? slots : slots.slice(0, LIM);
          slotsBox.innerHTML =
            visibili
              .map((sl) => `<button type="button" class="nc-pill${sl === ncSlot ? " is-on" : ""}" data-slot="${sl}">${sl}</button>`)
              .join("") +
            (slots.length > LIM
              ? `<button type="button" class="nc-pill nc-more" data-more="1">${ncSlotsEstesi ? tr("ord.less") : `+${slots.length - LIM}`}</button>`
              : "");
        }
        // Stesso calcolo di lib/pricing.ts (il server ricalcola comunque dal DB)
        function ncPrezzo(v: VoceMenu): number {
          const val = Math.round(Number(v.discount_value ?? 0));
          if (!v.discount_type || val <= 0) return v.price_cents;
          if (v.discount_type === "fixed") return Math.min(v.price_cents, val);
          if (v.discount_type === "percent") return Math.max(0, Math.round(v.price_cents * (1 - Math.min(val, 100) / 100)));
          return v.price_cents;
        }
        let ncCat = "";
        function ncRenderCats() {
          const catte: string[] = [];
          for (const v of ncMenu) if (!catte.includes(v.category)) catte.push(v.category);
          if (!ncCat && catte.length) ncCat = catte[0];
          (document.getElementById("nc-cats") as HTMLDivElement).innerHTML = catte
            .map((c) => `<button type="button" class="nc-pill${c === ncCat ? " is-on" : ""}" data-cat="${esc(c)}">${esc(c)}</button>`)
            .join("");
        }
        function ncRenderItems() {
          (document.getElementById("nc-items") as HTMLDivElement).innerHTML = ncMenu
            .filter((v) => v.category === ncCat)
            .map(
              (v) =>
                `<div class="nc-item"><span class="n">${esc(v.name)}</span><span class="p">${euro(ncPrezzo(v))}</span><button type="button" class="nc-plus" data-add="${v.id}">+</button></div>`
            )
            .join("");
        }
        function ncRenderCart() {
          const box = document.getElementById("nc-cart") as HTMLDivElement;
          const righe = [...ncCart.values()];
          const ICO_BIN =
            '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>';
          box.innerHTML = righe.length
            ? righe
                .map(
                  ({ voce, qty }) =>
                    `<div class="nc-cline">
                       <div class="nc-cline-top"><span>${esc(voce.name)}</span><span>${euro(ncPrezzo(voce) * qty)}</span></div>
                       <div class="nc-cline-controls">
                         <button type="button" data-meno="${voce.id}" aria-label="${tr("ord.less")}">−</button>
                         <span class="nc-cline-qty">${qty}</span>
                         <button type="button" data-piu="${voce.id}" aria-label="${tr("ord.more")}">+</button>
                         <button type="button" class="nc-cline-remove" data-del="${voce.id}" aria-label="${tr("ord.remove")}">${ICO_BIN}</button>
                       </div>
                     </div>`
                )
                .join("")
            : `<div class="nc-cart-empty">${tr("ord.cartEmpty")}</div>`;
          const tot = righe.reduce((t, r) => t + ncPrezzo(r.voce) * r.qty, 0);
          (document.getElementById("nc-total") as HTMLElement).textContent = euro(tot);
        }
        async function apriNc() {
          ncCart.clear();
          ncSlot = "";
          ncLang = NC_LANG_DEFAULT;
          // Torna in modalità CREAZIONE: titolo, pagamento visibile, niente edit.
          ncEditId = "";
          ncEditStatus = "";
          (document.getElementById("nc-title") as HTMLElement).textContent = tr("ord.newOrder");
          (document.getElementById("nc-pay-lab") as HTMLElement).style.display = "";
          (document.querySelector(".nc-pay") as HTMLElement).style.display = "";
          (document.getElementById("nc-link") as HTMLElement).style.display = "";
          mostraStep(1);
          for (const id of ["nc-prenom", "nc-nom", "nc-email", "nc-tel", "nc-note"])
            (document.getElementById(id) as HTMLInputElement).value = "";
          document
            .querySelectorAll("#nc-langs .nc-pill")
            .forEach((b) => b.classList.toggle("is-on", (b as HTMLElement).dataset.lang === NC_LANG_DEFAULT));
          // Prefisso telefono: torna al default del ristorante a ogni apertura.
          const ncTp = document.getElementById("nc-tel-prefix") as HTMLSelectElement | null;
          const ncTpDef = ncTp?.querySelector("option[selected]") as HTMLOptionElement | null;
          if (ncTp && ncTpDef) ncTp.value = ncTpDef.value;
          // Reset pagamento: nessun metodo scelto, lingua + conferma nascoste.
          ncPayment = "";
          ["nc-cash", "nc-card", "nc-link"].forEach((id) => document.getElementById(id)?.classList.remove("is-on"));
          (document.getElementById("nc-lang-block") as HTMLElement).style.display = "none";
          (document.getElementById("nc-send") as HTMLElement).style.display = "none";
          (document.getElementById("nc-email") as HTMLInputElement).placeholder = tr("ord.emailReq");
          ncRenderCart();
          ncOverlay.classList.add("is-open");
          // Data = oggi, pillole resettate, poi carico gli slot di quella data.
          ncDate = isoOggi();
          document.querySelectorAll<HTMLElement>("#nc-dates [data-date]").forEach((b) => b.classList.toggle("is-on", b.dataset.date === "today"));
          resetPickLabel();
          void caricaSlot();
          await ncCaricaMenu();
        }
        // Carica il menu una sola volta (solo piatti ordinabili) e disegna
        // categorie + articoli. Estratto perché serve anche in modifica.
        async function ncCaricaMenu() {
          if (!ncMenu.length) {
            try {
              const r = await fetch("/api/admin/menu", { headers });
              if (r.ok) {
                const j = (await r.json()) as { items: VoceMenu[] };
                ncMenu = (j.items ?? []).filter((v) => v.available && v.orderable !== false);
              }
            } catch { /* menu assente: lista vuota */ }
          }
          ncRenderCats();
          ncRenderItems();
        }
        // Apre il modale in modalità MODIFICA, precompilato dall'ordine scelto.
        async function apriNcEdit(o: Order) {
          ncEditId = o.id;
          ncEditStatus = o.status;
          await ncCaricaMenu();               // serve per ricostruire il carrello
          ncCart.clear();
          ncSlot = "";
          ncLang = o.lang && ["fr", "en", "it", "nl", "es"].includes(o.lang) ? o.lang : NC_LANG_DEFAULT;
          mostraStep(1);
          (document.getElementById("nc-title") as HTMLElement).textContent = tr("ord.editOrder");
          // Carrello dai piatti dell'ordine (esclude la riga "note")
          for (const it of o.items) {
            if (it.id === "note") continue;
            const voce = ncMenu.find((v) => v.id === it.id);
            if (voce) ncCart.set(voce.id, { voce, qty: Math.max(1, Math.floor(Number(it.qty) || 1)) });
          }
          ncRenderCart();
          // Cliente: ultima parola = cognome (campo obbligatorio), resto = nome
          const parti = (o.customer_name || "").trim().split(/\s+/).filter(Boolean);
          const cognome = parti.length ? parti[parti.length - 1] : "";
          const nome = parti.slice(0, -1).join(" ");
          (document.getElementById("nc-prenom") as HTMLInputElement).value = nome;
          (document.getElementById("nc-nom") as HTMLInputElement).value = cognome;
          (document.getElementById("nc-email") as HTMLInputElement).value = o.customer_email || "";
          const nota = o.items.find((i) => i.id === "note");
          (document.getElementById("nc-note") as HTMLTextAreaElement).value = nota?.notes || "";
          // Telefono: separa prefisso + resto se il prefisso è tra le opzioni
          const tp = document.getElementById("nc-tel-prefix") as HTMLSelectElement;
          const tel = document.getElementById("nc-tel") as HTMLInputElement;
          const tpDef = tp.querySelector("option[selected]") as HTMLOptionElement | null;
          if (tpDef) tp.value = tpDef.value;
          const sep = separaPrefisso(o.customer_phone || "");
          if (sep && Array.from(tp.options).some((op) => op.value === sep.dial)) {
            tp.value = sep.dial;
            tel.value = sep.resto;
          } else {
            tel.value = o.customer_phone || "";
          }
          // Lingua email
          document.querySelectorAll("#nc-langs .nc-pill").forEach((b) => b.classList.toggle("is-on", (b as HTMLElement).dataset.lang === ncLang));
          // Pagamento BLOCCATO in modifica: nascondo la scelta, mostro lingua + "Salva"
          ncPayment = "";
          (document.getElementById("nc-pay-lab") as HTMLElement).style.display = "none";
          (document.querySelector(".nc-pay") as HTMLElement).style.display = "none";
          (document.getElementById("nc-link") as HTMLElement).style.display = "none";
          (document.getElementById("nc-lang-block") as HTMLElement).style.display = "block";
          const send = document.getElementById("nc-send") as HTMLButtonElement;
          send.style.display = "block";
          send.textContent = tr("ord.saveChanges");
          (document.getElementById("nc-email") as HTMLInputElement).placeholder = ncEditStatus === "pending" ? tr("ord.emailReq") : tr("ord.emailOpt");
          ncOverlay.classList.add("is-open");
          // Data + orario dal pickup_time
          const dayKey = dayKeyBrussels(o.pickup_time);
          const hhmm = oraBrussels(o.pickup_time);
          ncDate = dayKey;
          const btnToday = document.querySelector('#nc-dates [data-date="today"]') as HTMLElement;
          const btnTom = document.querySelector('#nc-dates [data-date="tomorrow"]') as HTMLElement;
          const btnPick = document.getElementById("nc-date-pick") as HTMLElement;
          resetPickLabel();
          if (dayKey === isoOggi()) attivaData(btnToday);
          else if (dayKey === isoDomani()) attivaData(btnTom);
          else { btnPick.textContent = fmtDataPick(dayKey); attivaData(btnPick); }
          await caricaSlot();
          // Orario originale dell'ordine: resta SELEZIONATO anche se ormai e'
          // passato (non piu' tra gli slot disponibili). Lo reinserisco nel
          // servizio giusto e lo pre-seleziono, sempre modificabile.
          const minutiSlot = (sl: string): number => {
            const [H, M] = sl.split(":").map((n) => parseInt(n, 10));
            return (H < 5 ? H + 24 : H) * 60 + M; // dopo mezzanotte (cena) in coda
          };
          if (ncLunch.includes(hhmm)) {
            ncSvc = "lunch"; ncSlot = hhmm;
          } else if (ncDinner.includes(hhmm)) {
            ncSvc = "dinner"; ncSlot = hhmm;
          } else if (/^\d{2}:\d{2}$/.test(hhmm)) {
            const h = parseInt(hhmm.slice(0, 2), 10);
            const svc: "lunch" | "dinner" = h >= 17 || h < 5 ? "dinner" : "lunch";
            const arr = svc === "dinner" ? ncDinner : ncLunch;
            if (!arr.includes(hhmm)) { arr.push(hhmm); arr.sort((a, b) => minutiSlot(a) - minutiSlot(b)); }
            ncSvc = svc; ncSlot = hhmm;
          }
          ncRenderSvcs();
          ncRenderSlots();
        }
        // Salva le modifiche (PUT) invece di creare un nuovo ordine.
        async function salvaModifiche() {
          const nom = (document.getElementById("nc-nom") as HTMLInputElement).value.trim();
          const emailCl = (document.getElementById("nc-email") as HTMLInputElement).value.trim();
          const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailCl);
          if (!nom) { ncToast(tr("ord.nameEmailReq"), true); return; }
          if (ncEditStatus === "pending" && !emailOk) { ncToast(tr("ord.nameEmailReq"), true); return; }
          if (emailCl && !emailOk) { ncToast(tr("ord.nameEmailReq"), true); return; }
          if (!ncSlot) { ncToast(tr("ord.chooseSlot"), true); return; }
          if (!ncCart.size) { ncToast(tr("ord.cartIsEmpty"), true); return; }
          const send = document.getElementById("nc-send") as HTMLButtonElement;
          send.disabled = true;
          try {
            const res = await fetch("/api/admin/orders", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({
                id: ncEditId,
                first_name: (document.getElementById("nc-prenom") as HTMLInputElement).value,
                last_name: nom,
                email: emailCl,
                phone: telefonoCompleto((document.getElementById("nc-tel-prefix") as HTMLSelectElement).value, (document.getElementById("nc-tel") as HTMLInputElement).value) ?? "",
                lang: ncLang,
                date: ncDate,
                slot: ncSlot,
                note: (document.getElementById("nc-note") as HTMLTextAreaElement).value,
                items: [...ncCart.values()].map((r) => ({ id: r.voce.id, qty: r.qty })),
              }),
            });
            const j = (await res.json()) as { error?: string };
            if (!res.ok) throw new Error(j.error || tr("ord.createFailed"));
            ncOverlay.classList.remove("is-open");
            ncToast(tr("ord.orderUpdated"));
            void carica(true);
          } catch (e2) {
            ncToast(e2 instanceof Error ? e2.message : tr("ord.createFailed"), true);
          } finally {
            send.disabled = false;
          }
        }
        (document.getElementById("nc-add") as HTMLButtonElement).addEventListener("click", () => void apriNc());
        (document.getElementById("nc-close") as HTMLButtonElement).addEventListener("click", () => ncOverlay.classList.remove("is-open"));
        ncOverlay.addEventListener("click", (e) => {
          if (e.target === ncOverlay) ncOverlay.classList.remove("is-open");
        });
        (document.getElementById("nc-cats") as HTMLDivElement).addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".nc-pill") as HTMLElement | null;
          if (!b || !b.dataset.cat) return;
          ncCat = b.dataset.cat;
          ncRenderCats();
          ncRenderItems();
        });
        (document.getElementById("nc-langs") as HTMLDivElement).addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".nc-pill") as HTMLElement | null;
          if (!b) return;
          if (!b.dataset.lang) return;
          ncLang = b.dataset.lang;
          document.querySelectorAll("#nc-langs .nc-pill").forEach((x) => x.classList.toggle("is-on", x === b));
        });
        (document.getElementById("nc-svcs") as HTMLDivElement).addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".nc-pill") as HTMLElement | null;
          if (!b || !b.dataset.svc) return;
          ncSvc = b.dataset.svc === "dinner" ? "dinner" : "lunch";
          ncSlot = "";
          ncSlotsEstesi = false;
          ncRenderSvcs();
          ncRenderSlots();
        });

        // ---- Data del ritiro: Oggi / Domani / datepicker ----
        const isoOf = (dt: Date) => `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, "0")}-${String(dt.getDate()).padStart(2, "0")}`;
        // "oggi" nel fuso del RISTORANTE (non del browser dell'admin).
        const isoOggi = (): string => dayKeyBrussels(new Date().toISOString());
        const isoDomani = (): string => {
          const [y, m, d] = isoOggi().split("-").map(Number);
          const dt = new Date(y, m - 1, d);
          dt.setDate(dt.getDate() + 1);
          return isoOf(dt);
        };
        const fmtDataPick = (iso: string): string => {
          const [y, m, d] = iso.split("-").map(Number);
          return new Date(y, m - 1, d).toLocaleDateString(LOC, { weekday: "short", day: "2-digit", month: "2-digit" });
        };
        function resetPickLabel() {
          (document.getElementById("nc-date-pick") as HTMLElement).textContent = tr("ord.otherDate");
        }
        function attivaData(el: HTMLElement) {
          document.querySelectorAll<HTMLElement>("#nc-dates [data-date]").forEach((b) => b.classList.toggle("is-on", b === el));
        }
        // Carica gli slot della data scelta (stessa fonte del sito, con ?date=).
        async function caricaSlot() {
          const slotsBox = document.getElementById("nc-slots") as HTMLDivElement;
          slotsBox.innerHTML = `<span class="nc-slots-empty">${tr("sup.loading")}</span>`;
          (document.getElementById("nc-svcs") as HTMLDivElement).innerHTML = "";
          ncLunch = [];
          ncDinner = [];
          ncSlot = "";
          ncSlotsEstesi = false;
          try {
            const r = await fetch("/api/slots?date=" + encodeURIComponent(ncDate));
            if (!r.ok) throw new Error();
            const j = (await r.json()) as { lunch: string[]; dinner: string[] };
            ncLunch = j.lunch ?? [];
            ncDinner = j.dinner ?? [];
            ncSvc = ncLunch.length ? "lunch" : "dinner";
            ncRenderSvcs();
            ncRenderSlots();
          } catch {
            slotsBox.innerHTML = `<span class="nc-slots-empty">${tr("ord.slotsUnavailable")}</span>`;
          }
        }
        (document.getElementById("nc-dates") as HTMLDivElement).addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest("[data-date]") as HTMLElement | null;
          if (!b) return;
          if (b.dataset.date === "pick") { dpApri(); return; }
          ncDate = b.dataset.date === "tomorrow" ? isoDomani() : isoOggi();
          attivaData(b);
          resetPickLabel();
          void caricaSlot();
        });

        // ---- Datepicker brand (copia locale, sopra il modale) ----
        const MESI_DP = Array.from({ length: 12 }, (_, i) => new Date(2021, i, 1).toLocaleDateString(LOC, { month: "long" }));
        const DOW_DP = Array.from({ length: 7 }, (_, i) => new Date(2021, 2, 1 + i).toLocaleDateString(LOC, { weekday: "narrow" }));
        let dpAnno = 0;
        let dpMese = 0;
        const ncClosedSet = new Set<string>();   // giorni chiusi al take-away (grigi nel datepicker)
        const ncMesiFetch = new Set<string>();    // mesi già interrogati (evita fetch doppi)
        async function caricaChiusi(anno: number, mese: number) {
          const key = `${anno}-${String(mese + 1).padStart(2, "0")}`;
          if (ncMesiFetch.has(key)) return;
          ncMesiFetch.add(key);
          try {
            const r = await fetch("/api/slots?month=" + key);
            if (!r.ok) return;
            const j = (await r.json()) as { closed?: string[] };
            (j.closed ?? []).forEach((d) => ncClosedSet.add(d));
            dpRender();
          } catch { /* rete assente: nessun giorno chiuso segnato */ }
        }
        const dpPanel = document.createElement("div");
        dpPanel.className = "dp-panel";
        dpPanel.style.display = "none";
        document.body.appendChild(dpPanel);
        const isoDiDp = (y: number, m: number, g: number): string => `${y}-${String(m + 1).padStart(2, "0")}-${String(g).padStart(2, "0")}`;
        function dpRender() {
          const oggi = isoOggi();
          const sel = ncDate;
          const offset = (new Date(dpAnno, dpMese, 1).getDay() + 6) % 7;
          const nGiorni = new Date(dpAnno, dpMese + 1, 0).getDate();
          const oy = Number(oggi.slice(0, 4));
          const om = Number(oggi.slice(5, 7)) - 1;
          const prevOff = dpAnno < oy || (dpAnno === oy && dpMese <= om);
          let celle = "";
          for (let i = 0; i < offset; i++) celle += '<span class="dp-cell dp-vuota"></span>';
          for (let g = 1; g <= nGiorni; g++) {
            const iso = isoDiDp(dpAnno, dpMese, g);
            const off = iso < oggi || ncClosedSet.has(iso); // passato o chiuso
            const cls = ["dp-cell"];
            if (off) cls.push("dp-off");
            if (iso === oggi) cls.push("dp-today");
            if (iso === sel && !off) cls.push("dp-sel");
            celle += `<button type="button" class="${cls.join(" ")}" data-iso="${iso}" ${off ? "disabled" : ""}>${g}</button>`;
          }
          dpPanel.innerHTML = `
            <div class="dp-head">
              <button type="button" class="dp-nav" data-nav="-1" ${prevOff ? "disabled" : ""}>‹</button>
              <span class="dp-title">${MESI_DP[dpMese]} ${dpAnno}</span>
              <button type="button" class="dp-nav" data-nav="1">›</button>
            </div>
            <div class="dp-dow">${DOW_DP.map((g) => `<span>${g}</span>`).join("")}</div>
            <div class="dp-grid">${celle}</div>`;
        }
        function dpApri() {
          const base = ncDate || isoOggi();
          dpAnno = Number(base.slice(0, 4));
          dpMese = Number(base.slice(5, 7)) - 1;
          dpRender();
          void caricaChiusi(dpAnno, dpMese);
          dpPanel.style.display = "block";
          const r = (document.getElementById("nc-date-pick") as HTMLElement).getBoundingClientRect();
          const pw = dpPanel.offsetWidth || 308;
          const ph = dpPanel.offsetHeight || 360;
          dpPanel.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - pw - 8))}px`;
          dpPanel.style.top = `${Math.max(8, Math.min(r.bottom + 6, window.innerHeight - ph - 8))}px`;
        }
        function dpChiudi() { dpPanel.style.display = "none"; }
        dpPanel.addEventListener("click", (e) => {
          e.stopPropagation();
          const t = e.target as HTMLElement;
          if (t.classList.contains("dp-nav")) {
            dpMese += Number(t.dataset.nav);
            if (dpMese < 0) { dpMese = 11; dpAnno--; }
            if (dpMese > 11) { dpMese = 0; dpAnno++; }
            dpRender();
            void caricaChiusi(dpAnno, dpMese);
            return;
          }
          if (t.classList.contains("dp-cell") && t.dataset.iso) {
            ncDate = t.dataset.iso;
            const pick = document.getElementById("nc-date-pick") as HTMLElement;
            pick.textContent = fmtDataPick(ncDate);
            attivaData(pick);
            dpChiudi();
            void caricaSlot();
          }
        });
        document.addEventListener("click", (e) => {
          const pick = document.getElementById("nc-date-pick");
          if (dpPanel.style.display !== "none" && !dpPanel.contains(e.target as Node) && e.target !== pick && !(pick && pick.contains(e.target as Node))) dpChiudi();
        });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") dpChiudi(); });
        (document.getElementById("nc-slots") as HTMLDivElement).addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".nc-pill") as HTMLElement | null;
          if (!b) return;
          if (b.dataset.more) {
            ncSlotsEstesi = !ncSlotsEstesi;
            ncRenderSlots();
            return;
          }
          if (!b.dataset.slot) return;
          ncSlot = b.dataset.slot;
          ncRenderSlots();
        });
        (document.getElementById("nc-items") as HTMLDivElement).addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest("[data-add]") as HTMLElement | null;
          if (!b) return;
          const voce = ncMenu.find((v) => v.id === b.dataset.add);
          if (!voce) return;
          const cur = ncCart.get(voce.id);
          ncCart.set(voce.id, { voce, qty: (cur?.qty ?? 0) + 1 });
          ncRenderCart();
        });
        (document.getElementById("nc-cart") as HTMLDivElement).addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          const del = t.closest("[data-del]") as HTMLElement | null;
          if (del) {
            ncCart.delete(del.dataset.del ?? "");
            ncRenderCart();
            return;
          }
          const piu = t.closest("[data-piu]") as HTMLElement | null;
          const meno = t.closest("[data-meno]") as HTMLElement | null;
          const idv = piu?.dataset.piu ?? meno?.dataset.meno ?? "";
          const riga = ncCart.get(idv);
          if (!riga) return;
          riga.qty += piu ? 1 : -1;
          if (riga.qty <= 0) ncCart.delete(idv);
          ncRenderCart();
        });
        // payment: "cash"/"card" = pagato in cassa (ordine subito confermato) ·
        // "link" = invio del link di pagamento Stripe via email.
        async function inviaOrdine(payment: "cash" | "card" | "link") {
          if (!payment) { ncToast(tr("ord.payLabel"), true); return; }
          const nom = (document.getElementById("nc-nom") as HTMLInputElement).value.trim();
          const emailCl = (document.getElementById("nc-email") as HTMLInputElement).value.trim();
          const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailCl);
          if (!nom) { ncToast(tr("ord.nameEmailReq"), true); return; }
          // Email obbligatoria solo per il link; per cash/card facoltativa ma, se
          // scritta, dev'essere valida.
          if (payment === "link" && !emailOk) { ncToast(tr("ord.nameEmailReq"), true); return; }
          if (emailCl && !emailOk) { ncToast(tr("ord.nameEmailReq"), true); return; }
          if (!ncSlot) { ncToast(tr("ord.chooseSlot"), true); return; }
          if (!ncCart.size) { ncToast(tr("ord.cartIsEmpty"), true); return; }
          const btns = ["nc-cash", "nc-card", "nc-link", "nc-send"].map((id) => document.getElementById(id) as HTMLButtonElement);
          btns.forEach((b) => (b.disabled = true));
          try {
            const res = await fetch("/api/admin/orders", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({
                first_name: (document.getElementById("nc-prenom") as HTMLInputElement).value,
                last_name: nom,
                email: emailCl,
                phone: telefonoCompleto((document.getElementById("nc-tel-prefix") as HTMLSelectElement).value, (document.getElementById("nc-tel") as HTMLInputElement).value) ?? "",
                lang: ncLang,
                payment,
                date: ncDate,
                slot: ncSlot,
                note: (document.getElementById("nc-note") as HTMLTextAreaElement).value,
                items: [...ncCart.values()].map((r) => ({ id: r.voce.id, qty: r.qty })),
              }),
            });
            const j = (await res.json()) as { error?: string };
            if (!res.ok) throw new Error(j.error || tr("ord.createFailed"));
            ncOverlay.classList.remove("is-open");
            ncToast(payment === "link" ? tr("ord.orderCreated") : tr("ord.orderPaid"));
            void carica(true);
          } catch (e2) {
            ncToast(e2 instanceof Error ? e2.message : tr("ord.createFailed"), true);
          } finally {
            btns.forEach((b) => (b.disabled = false));
          }
        }
        // Scelta del metodo: NON invia, ma rivela la scelta della lingua email e
        // il pulsante di conferma. Email obbligatoria solo per il link.
        function selezionaPagamento(method: "cash" | "card" | "link") {
          ncPayment = method;
          ["nc-cash", "nc-card", "nc-link"].forEach((id) => {
            const b = document.getElementById(id) as HTMLElement;
            b.classList.toggle("is-on", b.dataset.pay === method);
          });
          (document.getElementById("nc-lang-block") as HTMLElement).style.display = "block";
          const send = document.getElementById("nc-send") as HTMLButtonElement;
          send.style.display = "block";
          send.textContent = method === "link" ? tr("ord.createSend") : tr("ord.confirmOrder");
          const email = document.getElementById("nc-email") as HTMLInputElement;
          email.placeholder = method === "link" ? tr("ord.emailReq") : tr("ord.emailOpt");
        }
        (document.getElementById("nc-cash") as HTMLButtonElement).addEventListener("click", () => selezionaPagamento("cash"));
        (document.getElementById("nc-card") as HTMLButtonElement).addEventListener("click", () => selezionaPagamento("card"));
        (document.getElementById("nc-link") as HTMLButtonElement).addEventListener("click", () => selezionaPagamento("link"));
        (document.getElementById("nc-send") as HTMLButtonElement).addEventListener("click", () => {
          if (ncEditId) { void salvaModifiche(); return; }
          if (ncPayment) void inviaOrdine(ncPayment);
        });

        // ---- Wizard multi-step: Prodotti → Ritiro → Cliente → Pagamento ----
        let ncStep = 1;
        function ncRenderRecap() {
          const box = document.getElementById("nc-recap") as HTMLDivElement;
          const righe = [...ncCart.values()];
          box.innerHTML = righe.length
            ? righe.map((r) => `<div class="nc-recap-row"><span>${r.qty}× ${esc(r.voce.name)}</span><span>${euro(ncPrezzo(r.voce) * r.qty)}</span></div>`).join("")
            : `<div class="nc-cart-empty">${tr("ord.cartEmpty")}</div>`;
          const tot = righe.reduce((t, r) => t + ncPrezzo(r.voce) * r.qty, 0);
          (document.getElementById("nc-total-2") as HTMLElement).textContent = euro(tot);
        }
        function mostraStep(n: number) {
          ncStep = n;
          document.querySelectorAll<HTMLElement>(".nc-panel").forEach((p2) => { p2.hidden = Number(p2.dataset.panel) !== n; });
          document.querySelectorAll<HTMLElement>(".nc-step").forEach((st) => {
            const sN = Number(st.dataset.s);
            st.classList.toggle("is-on", sN === n);
            st.classList.toggle("done", sN < n);
          });
          const prev = document.getElementById("nc-prev") as HTMLButtonElement;
          const next = document.getElementById("nc-next") as HTMLButtonElement;
          prev.style.visibility = n === 1 ? "hidden" : "visible";
          next.style.display = n === 3 ? "none" : "inline-block";
          if (n === 3) ncRenderRecap();
        }
        // Validazione minima per avanzare (l'email è richiesta solo al pagamento link)
        function validaStep(n: number): boolean {
          if (n === 1 && !ncCart.size) { ncToast(tr("ord.cartIsEmpty"), true); return false; }
          if (n === 2 && !ncSlot) { ncToast(tr("ord.chooseSlot"), true); return false; }
          if (n === 3) {
            const nom = (document.getElementById("nc-nom") as HTMLInputElement).value.trim();
            const email = (document.getElementById("nc-email") as HTMLInputElement).value.trim();
            if (!nom) { ncToast(tr("ord.nameEmailReq"), true); return false; }
            if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { ncToast(tr("ord.nameEmailReq"), true); return false; }
          }
          return true;
        }
        (document.getElementById("nc-next") as HTMLButtonElement).addEventListener("click", () => {
          if (ncStep < 3 && validaStep(ncStep)) mostraStep(ncStep + 1);
        });
        (document.getElementById("nc-prev") as HTMLButtonElement).addEventListener("click", () => {
          if (ncStep > 1) mostraStep(ncStep - 1);
        });
        // Titoli dello stepper cliccabili: salto diretto alla sezione.
        (document.getElementById("nc-steps") as HTMLDivElement).addEventListener("click", (e) => {
          const st = (e.target as HTMLElement).closest(".nc-step") as HTMLElement | null;
          if (st?.dataset.s) mostraStep(Number(st.dataset.s));
        });
        // Il form cliente serve solo a raggruppare i campi per l'autofill: mai inviarlo.
        document.getElementById("nc-cli-form")?.addEventListener("submit", (e) => e.preventDefault());
        // Riconoscimento automatico del prefisso digitato nel campo numero.
        {
          const tp = document.getElementById("nc-tel-prefix") as HTMLSelectElement | null;
          const ti = document.getElementById("nc-tel") as HTMLInputElement | null;
          if (tp && ti) collegaPrefissoTel(tp, ti);
        }
        function posizionaNcAdd() {
          const barra = document.querySelector(".admin-nav") as HTMLElement | null;
          const btn = document.getElementById("nc-add") as HTMLElement | null;
          if (!barra || !btn) return;
          if (!window.matchMedia("(min-width: 521px)").matches) {
            btn.style.height = "";
            btn.style.bottom = "";
            return; // mobile: la barra è a tutta larghezza, il bottone resta sopra
          }
          const r = barra.getBoundingClientRect();
          btn.style.height = `${r.height}px`;
          btn.style.bottom = `${window.innerHeight - r.bottom}px`;
        }
        (document.getElementById("nc-add") as HTMLElement).style.display = "inline-flex";
        posizionaNcAdd();
        window.addEventListener("resize", posizionaNcAdd);
      })();
    </script>
  </body>
</html>
