                <span class="m">15 min</span>
              </button>
              <button class="prep-btn" type="button" data-min="30" title="Normal — 30 minutes">
                <svg viewBox="0 0 441.23 441.23" fill="currentColor" aria-hidden="true"><path d="M440.651,132.739c-0.888-2.354-2.721-4.229-5.054-5.171L396.39,111.75c-2.435-12.666-12.056-22.81-24.436-26.008l-2.115-24.363c-0.309-3.565-2.701-6.608-6.093-7.751c-3.391-1.142-7.137-0.167-9.541,2.484l-10.062,11.099l-6.22-21.766c-1.072-3.752-4.44-6.386-8.341-6.521c-3.924-0.139-7.444,2.258-8.773,5.928L274.34,173.047c0,0-172.127,8.035-172.199,8.039c-35.296,2.121-68.735-16.765-85.167-48.119c-2.309-4.402-7.748-6.102-12.149-3.794c-4.403,2.308-6.101,7.747-3.794,12.149c14.69,28.03,40.708,47.75,70.541,54.93c-3.097,3.609-9.751,12.554-13.642,26.617c-4.231,15.291-5.756,39.667,9.801,70.619L42.499,327.76c-1.474,2.001-2.054,4.523-1.603,6.968l11.105,60.218c0.787,4.268,4.51,7.367,8.851,7.367h11.312c2.669,0,5.2-1.185,6.911-3.233c1.71-2.05,2.422-4.753,1.944-7.378l-7.032-38.627l74.401-55.853c0.131-0.099-0.126,0.107,0,0c7.114-5.975,12.278-12.556,15.972-19.322c38.777,6.808,91.844,16.02,125.857,21.498l14.986,95.314c0.689,4.377,4.46,7.602,8.891,7.602h9.308c4.971,0,9-4.029,9-9V296.56c8.449-5.77,11.469-15.42,13.472-24.871c0.063-0.297,20.022-92.416,20.022-92.416c3.762,0.627,7.561,0.956,11.388,0.956c26.356,0,50.492-15.431,62.987-40.271C441.401,137.712,441.539,135.094,440.651,132.739z"/></svg>
                <span class="m">30 min</span>
              </button>
              <button class="prep-btn" type="button" data-min="45" title="Chargé — 45 minutes">
                <svg viewBox="0 0 100 100" fill="currentColor" aria-hidden="true"><path d="m83.9 23.3h-3.9c-5.5 0-10 4.5-10 10v10c0 11-17.9 20-40 20h-17.6c-1.3 0-2.4 1.1-2.4 2.4v1.9c0 1.3 1.1 2.4 2.4 2.4 1.7 0 2.8 1.7 2.3 3.2 0 .1-.1.2-.1.2-.6 1.6.6 3.2 2.2 3.2h2c1 0 1.9-.6 2.3-1.6.4-1.1.8-2.3 1.1-3.4.3-1 1.2-1.7 2.3-1.7h8.9c10.1 0 19.3-1.7 26.7-4.6 1.4-.5 2.9.2 3.2 1.7.7 2.7 1.4 5.4 2.3 8 .3 1 1.3 1.6 2.3 1.6h2c1.7 0 2.8-1.6 2.2-3.2-1.3-3.5-2.3-7.1-3.1-10.8-.2-.9.2-1.9.9-2.4 4.8-3.4 8-7.6 9.4-12.2.3-.9 1-1.5 1.9-1.7 5.1-.9 8.8-3.4 8.8-6.3v-10.5c0-3.4-2.7-6.2-6.1-6.2zm-3.3 12.5c-1.9.4-3.5-1.2-3-3 .2-.9.9-1.6 1.8-1.8 1.9-.5 3.5 1.2 3.1 3.1-.3.7-1 1.5-1.9 1.7z"/><path d="m10.2 53.3c-.2 1.8 1.2 3.3 3 3.3h16.8c20.3 0 33.3-7.9 33.3-13.3v-11.7c0-1-.5-1.9-1.4-2.5-5.3-3.6-11.7-5.7-18.6-5.7-17.2-.1-31.5 13.1-33.1 29.9z"/></svg>
                <span class="m">45 min</span>
              </button>
              <button class="prep-btn prep-close" type="button" id="btn-close-orders" title="Fermer les commandes en ligne">
                <svg viewBox="0 0 30 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="15" cy="12" r="8.5" />
                  <path d="M9 6 L21 18" />
                </svg>
                <span class="m" id="close-orders-label">Fermer</span>
              </button>
            </div>
          </div>
        </div>
        <div class="state" id="state">Chargement…</div>
        <div class="grid" id="grid"></div>
        <h2 class="done-title" id="done-title" style="display:none">Terminées &amp; annulées</h2>
        <div class="grid" id="grid-done"></div>
      </main>
    </div>

    <!-- Modale Remboursement -->
    <div class="rf-overlay" id="rf-overlay" role="dialog" aria-modal="true" aria-labelledby="rf-title">
      <div class="rf-modal">
        <h2 class="rf-title" id="rf-title">Rembourser la commande</h2>
        <p class="rf-sub" id="rf-sub"></p>
        <label class="rf-label" for="rf-amount">Montant à rembourser</label>
        <div class="rf-inputrow">
          <span class="rf-euro">€</span>
          <input class="rf-amount" id="rf-amount" type="number" inputmode="decimal" min="0" step="0.01" />
          <button class="rf-all" type="button" id="rf-all">Tout</button>
        </div>
        <p class="rf-msg" id="rf-msg"></p>
        <div class="rf-actions">
          <button class="rf-cancel" type="button" id="rf-cancel">Annuler</button>
          <button class="rf-confirm" type="button" id="rf-confirm">Rembourser</button>
        </div>
      </div>
    </div>

    <AdminNav current="orders" />

    <!-- Dati SSR (Fase 2): ordini pre-caricati dal server, letti dal client. -->
    <script id="ssr-orders" type="application/json" is:inline set:html={ssrOrdersJson}></script>

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";

      type Item = { id: string; name: string; qty: number; price_cents: number; notes: string };
      type Order = {
        id: string;
        status: string;
        pickup_time: string;
        customer_name: string;
        customer_email: string;
        customer_phone: string | null;
        items: Item[];
        total_cents: number;
        lang: string | null;
        created_at: string;
        refunded_cents?: number;
        stripe_session_id?: string | null;
      };

      function esc(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }
      function euro(cents: number): string {
        return (cents / 100).toLocaleString("fr-BE", { style: "currency", currency: "EUR" });
      }
      // Chiave-giorno (YYYY-MM-DD) di un istante ISO, nel fuso di Bruxelles.
      function dayKeyBrussels(iso: string): string {
        return new Date(iso).toLocaleDateString("en-CA", { timeZone: "Europe/Brussels" });
      }
      // Ora HH:MM di un istante ISO, nel fuso di Bruxelles.
      function oraBrussels(iso: string): string {
        return new Date(iso).toLocaleTimeString("fr-BE", {
          timeZone: "Europe/Brussels",
          hour: "2-digit",
          minute: "2-digit",
        });
      }

      // Ristampa ticket — PREDISPOSTO ma NASCOSTO (§4.5 stampante termica).
      // Domani, con la stampa automatica attiva: mettere STAMPA_TICKET = true
      // per mostrare il bottone, e collegare ristampaTicket() a /api/admin/print.
      const STAMPA_TICKET = false;
      const ICON_PRINT = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6"/><path d="M6 18H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="7" rx="1"/></svg>`;

      function cardHTML(o: Order): string {
        const note = o.items.find((i) => i.id === "note");
        const piatti = o.items.filter((i) => i.id !== "note");

        const phone = o.customer_phone
          ? `<p class="row">Tél : <a href="tel:${esc(o.customer_phone)}">${esc(o.customer_phone)}</a></p>`
          : "";
        const langBadge = o.lang ? `<span class="badge">${esc(o.lang)}</span>` : "";

        const itemsHTML = piatti
          .map((i) => {
            const sub = i.notes ? ` <span class="item-sub">(${esc(i.notes)})</span>` : "";
            return `
              <div class="item">
                <span class="item-qty">${i.qty}×</span>
                <span class="item-name">${esc(i.name)}${sub}</span>
              </div>`;
          })
          .join("");

        const noteHTML = note?.notes ? `<div class="order-note">📝 ${esc(note.notes)}</div>` : "";

        // Etichetta di stato (solo per le card spente)
        let tag = "";
        if (o.status === "done") tag = `<span class="tag tag-done">Terminée</span>`;
        if (o.status === "cancelled") tag = `<span class="tag tag-cancel">Annulée</span>`;

        // Ordini attivi: Terminée + Annuler.
        // Ordini terminati: ✓ vert rond à côté du prix + bouton rollback doré
        // (position absolue, en bas à droite) pour remettre « en cours ».
        const actions =
          o.status === "paid"
            ? `<div class="actions">
                 <button class="btn-done" type="button" data-id="${o.id}" data-act="done">✓ Terminée</button>
                 <button class="btn-cancel" type="button" data-id="${o.id}" data-act="cancel">Annuler</button>
               </div>`
            : "";

        const badgeOk = o.status === "done" ? `<span class="badge-ok" title="Terminée">✓</span>` : "";
        // Bottone stampante (ristampa ticket): reso solo se STAMPA_TICKET = true.
        const stampaBtn = STAMPA_TICKET
          ? `<button class="btn-print" type="button" data-id="${o.id}" data-act="print" title="Ré-imprimer le ticket" aria-label="Ré-imprimer le ticket">${ICON_PRINT}</button>`
          : "";
        const rollback =
          o.status === "done"
            ? `<button class="btn-rollback" type="button" data-id="${o.id}" data-act="rollback" title="Remettre en cours" aria-label="Remettre en cours">↩</button>`
            : "";
        // Ordini ANNULÉS pagati con Stripe: rimborso (totale o parziale).
        // Stato rimborso = tag in alto; bottone "Rembourser" = assoluto in basso
        // a destra (come il rollback), 100% opaco.
        const refunded = o.refunded_cents ?? 0;
        const residuo = o.total_cents - refunded;
        const isStripe = o.status === "cancelled" && !!o.stripe_session_id;
        if (isStripe && refunded > 0) {
          tag += residuo > 0
            ? `<span class="tag tag-refund">Remboursé ${euro(refunded)}</span>`
            : `<span class="tag tag-refund">Remboursé ✓</span>`;
        }
        const refundBtn =
          isStripe && residuo > 0
            ? `<button class="btn-refund" type="button" data-id="${o.id}" data-act="refund" data-residuo="${residuo}">Rembourser</button>`
            : "";
        const cardCls =
          (o.status === "paid" ? "" : o.status === "done" ? " done" : " off") +
          (refundBtn ? " refundable" : "");

        return `
          <div class="card${cardCls}">
            <div class="card-top">
              <div class="ct-left">
                <span class="time">${esc(oraBrussels(o.pickup_time))}</span>
                ${tag}
              </div>
              <span class="ct-right">${stampaBtn}${badgeOk}<span class="total">${euro(o.total_cents)}</span></span>
            </div>
            <p class="name">${esc(o.customer_name)}${langBadge}</p>
            <p class="row">Email : <a href="mailto:${esc(o.customer_email)}">${esc(o.customer_email)}</a></p>
            ${phone}
            <div class="items">${itemsHTML}</div>
            ${noteHTML}
            ${actions}
            ${refundBtn}
            ${rollback}
          </div>`;
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const gridEl = document.getElementById("grid") as HTMLDivElement;
        const gridDoneEl = document.getElementById("grid-done") as HTMLDivElement;
        const doneTitleEl = document.getElementById("done-title") as HTMLHeadingElement;
        const countEl = document.getElementById("count") as HTMLParagraphElement;
        const labelEl = document.getElementById("today-label") as HTMLParagraphElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        const token = session.access_token ?? "";
        const headers = { Authorization: `Bearer ${token}` };

        // --- Bottoni rapidi tempo di preparazione (15/30/45) ---
        const prepBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".prep-btn"));
        const prepNote = document.getElementById("prep-note") as HTMLSpanElement;

        function segnaAttivo(min: number) {
          prepBtns.forEach((b) => b.classList.toggle("active", Number(b.dataset.min) === min));
        }

        // Stato attuale (stesso valore dei Réglages)
        fetch("/api/admin/settings", { headers })
          .then((r) => (r.ok ? r.json() : null))
          .then((j) => {
            if (j && typeof j.prep_time_minutes === "number") segnaAttivo(j.prep_time_minutes);
            if (j && typeof j.orders_closed === "boolean") {
              ordiniChiusi = j.orders_closed;
              segnaChiusura();
            }
          })
          .catch(() => {});

        prepBtns.forEach((btn) => {
          btn.addEventListener("click", async () => {
            const min = Number(btn.dataset.min);
            prepBtns.forEach((b) => (b.disabled = true));
            prepNote.textContent = "";
            prepNote.classList.remove("err");
            try {
              // Scegliere un tempo di preparazione RIAPRE anche il servizio
              // se era stato chiuso col bottone "Fermer".
              const r = await fetch("/api/admin/settings", {
                method: "PATCH",
                headers: { ...headers, "Content-Type": "application/json" },
                body: JSON.stringify({ prep_time_minutes: min, orders_closed: false }),
              });
              if (!r.ok) throw new Error();
              segnaAttivo(min);
              ordiniChiusi = false;
              segnaChiusura();
              prepNote.textContent = "✓";
              setTimeout(() => {
                prepNote.textContent = "";
              }, 2000);
            } catch {
              prepNote.textContent = "Erreur";
              prepNote.classList.add("err");
            } finally {
              prepBtns.forEach((b) => (b.disabled = false));
              btn.blur();
            }
          });
        });

        // --- Bottone "Fermer": chiude/riapre le commandes online ---
        const btnClose = document.getElementById("btn-close-orders") as HTMLButtonElement;
        const lblClose = document.getElementById("close-orders-label") as HTMLSpanElement;
        let ordiniChiusi = false;

        function segnaChiusura() {
          btnClose.classList.toggle("closed", ordiniChiusi);
          lblClose.textContent = ordiniChiusi ? "Fermé" : "Fermer";
          btnClose.title = ordiniChiusi
            ? "Rouvrir les commandes en ligne"
            : "Fermer les commandes en ligne";
        }

        btnClose.addEventListener("click", async () => {
          btnClose.disabled = true;
          prepNote.textContent = "";
          prepNote.classList.remove("err");
          try {
            const r = await fetch("/api/admin/settings", {
              method: "PATCH",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ orders_closed: !ordiniChiusi }),
            });
            if (!r.ok) throw new Error();
            ordiniChiusi = !ordiniChiusi;
            segnaChiusura();
            prepNote.textContent = "✓";
            setTimeout(() => {
              prepNote.textContent = "";
            }, 2000);
          } catch {
            prepNote.textContent = "Erreur";
            prepNote.classList.add("err");
          } finally {
            btnClose.disabled = false;
            btnClose.blur();
          }
        });

        // --- Ordini di oggi ---
        let ordini: Order[] = [];
        // Conferma "Annuler" in 2 tocchi
        let confirmId: string | null = null;
        let confirmTimer: number | undefined;

        function resetConfirm() {
          confirmId = null;
          if (confirmTimer) clearTimeout(confirmTimer);
          document.querySelectorAll<HTMLButtonElement>(".btn-cancel.confirm").forEach((b) => {
            b.classList.remove("confirm");
            b.textContent = "Annuler";
          });
        }

        function render() {
          const oggi = new Date();
          const oggiKey = dayKeyBrussels(oggi.toISOString());

          labelEl.textContent =
            "Aujourd'hui — " +
            oggi.toLocaleDateString("fr-BE", { weekday: "long", day: "numeric", month: "long" });

          // Solo oggi, dal ritiro più vicino al più lontano
          const ordOggi = ordini
            .filter((o) => dayKeyBrussels(o.pickup_time) === oggiKey)
            .sort((a, b) => (a.pickup_time < b.pickup_time ? -1 : 1));

          const attivi = ordOggi.filter((o) => o.status === "paid");
          const spenti = ordOggi.filter((o) => o.status === "done" || o.status === "cancelled");

          // Conteggio e totale: attivi + terminati (gli annullati non contano)
          const validi = ordOggi.filter((o) => o.status !== "cancelled");
          const tot = validi.reduce((s, o) => s + o.total_cents, 0);
          countEl.textContent =
            validi.length > 0
              ? (validi.length === 1 ? "1 commande" : `${validi.length} commandes`) + ` · ${euro(tot)}`
              : "";

          if (ordOggi.length === 0) {
            stateEl.textContent = "Aucune commande payée aujourd'hui.";
            stateEl.style.display = "block";
          } else if (attivi.length === 0) {
            stateEl.textContent = "Aucune commande en cours.";
            stateEl.style.display = "block";
          } else {
            stateEl.style.display = "none";
          }

          gridEl.innerHTML = attivi.map(cardHTML).join("");
          gridDoneEl.innerHTML = spenti.map(cardHTML).join("");
          doneTitleEl.style.display = spenti.length > 0 ? "block" : "none";
        }

        async function cambiaStato(id: string, status: string, btn: HTMLButtonElement) {
          const card = btn.closest(".card");
          card?.querySelectorAll("button").forEach((b) => (b.disabled = true));
          try {
            const r = await fetch("/api/admin/orders", {
              method: "PATCH",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id, status }),
            });
            if (!r.ok) throw new Error();
            const ord = ordini.find((o) => o.id === id);
            if (ord) ord.status = status;
            resetConfirm();
            render();
          } catch {
            btn.textContent = "Erreur";
            setTimeout(() => {
              resetConfirm();
              render();
            }, 1500);
          }
        }

        // Ristampa ticket — PREDISPOSTO ma inattivo finché non c'è la stampa
        // automatica. Domani: implementare qui la POST verso /api/admin/print.
        function ristampaTicket(id: string) {
          // TODO (§4.5 stampante): await fetch("/api/admin/print", { method:"POST",
          //   headers:{...headers,"Content-Type":"application/json"}, body:JSON.stringify({ id }) });
          void id;
        }

        gridEl.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-act]");
          if (!btn || btn.disabled) return;
          const id = btn.dataset.id ?? "";

          if (btn.dataset.act === "print") {
            ristampaTicket(id);
            return;
          }
          if (btn.dataset.act === "done") {
            cambiaStato(id, "done", btn);
            return;
          }
          // Annuler: primo tocco arma la conferma, secondo tocco conferma
          if (confirmId === id && btn.classList.contains("confirm")) {
            cambiaStato(id, "cancelled", btn);
          } else {
            resetConfirm();
            confirmId = id;
            btn.classList.add("confirm");
            btn.textContent = "Confirmer ?";
            confirmTimer = window.setTimeout(resetConfirm, 4000);
          }
        });

        // Card TERMINÉE : rollback (→ paid) + ristampa ticket (predisposta).
        gridDoneEl.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-act]");
          if (!btn || btn.disabled) return;
          if (btn.dataset.act === "print") {
            ristampaTicket(btn.dataset.id ?? "");
            return;
          }
          if (btn.dataset.act === "refund") {
            apriRimborso(btn);
            return;
          }
          if (btn.dataset.act === "rollback") {
            cambiaStato(btn.dataset.id ?? "", "paid", btn);
          }
        });

        // ---- Modale Remboursement (rimborso Stripe, totale o parziale) ----
        const rfOverlay = document.getElementById("rf-overlay") as HTMLDivElement;
        const rfSub = document.getElementById("rf-sub") as HTMLParagraphElement;
        const rfAmount = document.getElementById("rf-amount") as HTMLInputElement;
        const rfMsg = document.getElementById("rf-msg") as HTMLParagraphElement;
        const rfConfirm = document.getElementById("rf-confirm") as HTMLButtonElement;
        const rfCancel = document.getElementById("rf-cancel") as HTMLButtonElement;
        const rfAll = document.getElementById("rf-all") as HTMLButtonElement;
        let rfId = "";
        let rfResiduo = 0;

        function apriRimborso(btn: HTMLButtonElement) {
          rfId = btn.dataset.id ?? "";
          rfResiduo = Math.max(0, Math.round(Number(btn.dataset.residuo ?? "0")));
          rfMsg.textContent = "";
          rfMsg.classList.remove("ok");
          rfSub.textContent = `Montant remboursable : ${euro(rfResiduo)}`;
          rfAmount.value = (rfResiduo / 100).toFixed(2);
          rfAmount.max = (rfResiduo / 100).toFixed(2);
          rfConfirm.disabled = false;
          rfOverlay.classList.add("is-open");
          rfAmount.focus();
          rfAmount.select();
        }
        function chiudiRimborso() {
          rfOverlay.classList.remove("is-open");
        }
        rfCancel.addEventListener("click", chiudiRimborso);
        rfOverlay.addEventListener("click", (e) => {
          if (e.target === rfOverlay) chiudiRimborso();
        });
        rfAll.addEventListener("click", () => {
          rfAmount.value = (rfResiduo / 100).toFixed(2);
        });

        rfConfirm.addEventListener("click", async () => {
          const euros = Number(String(rfAmount.value).replace(",", "."));
          const cents = Math.round(euros * 100);
          if (!Number.isFinite(cents) || cents <= 0) {
            rfMsg.classList.remove("ok");
            rfMsg.textContent = "Montant invalide.";
            return;
          }
          if (cents > rfResiduo) {
            rfMsg.classList.remove("ok");
            rfMsg.textContent = `Maximum : ${euro(rfResiduo)}.`;
            return;
          }
          rfConfirm.disabled = true;
          rfMsg.classList.remove("ok");
          rfMsg.textContent = "Remboursement en cours…";
          try {
            const r = await fetch("/api/admin/refund", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id: rfId, amount_cents: cents }),
            });
            const j = await r.json().catch(() => ({}) as any);
            if (!r.ok) {
              rfMsg.classList.remove("ok");
              rfMsg.textContent = j.error || "Remboursement impossible.";
              rfConfirm.disabled = false;
              return;
            }
            const ord = ordini.find((o) => o.id === rfId);
            if (ord) ord.refunded_cents = Number(j.refunded_cents ?? (ord.refunded_cents ?? 0) + cents);
            rfMsg.classList.add("ok");
            rfMsg.textContent = `Remboursé : ${euro(Number(j.amount ?? cents))} ✓`;
            render();
            setTimeout(chiudiRimborso, 1200);
          } catch {
            rfMsg.classList.remove("ok");
            rfMsg.textContent = "Erreur de connexion.";
            rfConfirm.disabled = false;
          }
        });

        // Firma compatta: serve a capire se un refresh silenzioso ha portato
        // davvero delle novità. Se non cambia, non si tocca il DOM.
        let firmaOrdini = "";
        function firmaDa(list: Order[]): string {
          return JSON.stringify(
            list.map((o) => [o.id, o.status, o.pickup_time, o.total_cents, o.customer_name])
          );
        }

        // `silenzioso = true` → aggiornamento in background: niente messaggio di
        // caricamento e si ridisegna SOLO se qualcosa è cambiato. Così un nuovo
        // ordine appare da solo, senza ricaricare la pagina e senza lampeggìo.
        async function carica(silenzioso = false) {
          try {
            const res = await fetch("/api/admin/orders", { headers });
            if (!res.ok) {
              if (!silenzioso) stateEl.textContent = "Erreur de chargement.";
              return;
            }
            const json = await res.json();
            const list = (json.orders as Order[]) ?? [];
            const firma = firmaDa(list);
            if (silenzioso && firma === firmaOrdini) return;
            firmaOrdini = firma;
            ordini = list;
            render();
          } catch {
            if (!silenzioso) stateEl.textContent = "Erreur de connexion.";
          }
        }

        // Aggiornamento live silenzioso: non interrompe una conferma "Annuler".
        function refreshLive() {
          if (document.visibilityState !== "visible") return;
          if (confirmId) return;
          void carica(true);
        }

        // Primo render: se il server ha già fornito gli ordini (SSR, Fase 2),
        // li usiamo SUBITO senza fetch; altrimenti carichiamo come prima.
        const ssrEl = document.getElementById("ssr-orders");
        const ssrRaw = ssrEl?.textContent?.trim();
        let ssrOk = false;
        if (ssrRaw) {
          try {
            const list = JSON.parse(ssrRaw) as Order[];
            ordini = list;
            firmaOrdini = firmaDa(list);
            render();
            ssrOk = true;
          } catch {
            ssrOk = false;
          }
        }
        if (!ssrOk) {
          await carica(); // nessun dato SSR → comportamento attuale
        } else {
          void carica(true); // già mostrato: riallinea in background, silenzioso
        }

        // 1) evento da AdminNav all'arrivo di un nuovo ordine pagato
        window.addEventListener("moodd:new-order", () => refreshLive());
        // 2) quando torni sulla scheda dell'admin
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible") refreshLive();
        });
        // 3) rete di sicurezza ogni 25s, SILENZIOSA: ridisegna solo se qualcosa
        //    è cambiato (es. stato modificato da un altro dispositivo).
        setInterval(refreshLive, 25_000);
      })();
    </script>
  </body>
</html>
