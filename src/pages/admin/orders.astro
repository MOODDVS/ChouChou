    <!-- Nouvelle commande (manuale con link di pagamento) -->
    <button class="nc-add" id="nc-add" type="button" style="display:none"><span class="fab-plus">+</span>Commande</button>
    <div class="nc-overlay" id="nc-overlay" role="dialog" aria-modal="true">
      <div class="nc-modal">
        <button class="nc-close" id="nc-close" aria-label="Fermer">×</button>
