---
// Pannello admin — ordini take-away di OGGI.
// In alto gli ordini ATTIVI (paid), dal ritiro più vicino al più lontano.
// Sotto, spenti (opacità ridotta), i terminati (done) e gli annullati
// (cancelled, con etichetta rossa). Bottoni per carta: "Terminée" e
// "Annuler" (conferma in 2 tocchi) → PATCH /api/admin/orders.
// In testata: bottoni rapidi tempo di preparazione
// (coniglio 15 / cane 30 / tartaruga 45) → PATCH /api/admin/settings.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import { DateTime } from "luxon";
import { supabaseAdmin } from "../../lib/db";
import { verificaTokenLocale } from "../../lib/admin/adminAuth";

export const prerender = false;

// --- SSR (Fase 2): se il cookie di sessione è valido, carichiamo i primi
// ordini GIÀ sul server → la pagina arriva coi dati (niente pagina vuota→fetch).
// Stessa query di GET /api/admin/orders. Se il cookie manca/è scaduto o c'è un
// errore, ssrOrders resta null e il client carica come prima (nessun rischio).
let ssrOrders: unknown[] | null = null;
try {
  const token = Astro.cookies.get("mdd_at")?.value ?? "";
  const staff = token ? await verificaTokenLocale(token) : null;
  if (staff) {
    const soglia = DateTime.now()
      .setZone("Europe/Brussels")
      .minus({ days: 7 })
      .startOf("day")
      .toISO();
    const { data } = await supabaseAdmin
      .from("orders")
      .select(
        "id, status, pickup_time, customer_name, customer_email, customer_phone, items, total_cents, lang, created_at, refunded_cents, stripe_session_id"
      )
      .in("status", ["paid", "done", "cancelled"])
      .gte("pickup_time", soglia)
      .order("pickup_time", { ascending: true });
    ssrOrders = data ?? [];
  }
} catch {
  ssrOrders = null;
}
const ssrOrdersJson = ssrOrders ? JSON.stringify(ssrOrders).replace(/</g, "\\u003c") : "";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Commandes — Admin La Molisana</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#231f20" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-bg: #231f20;
        --c-text: #ffffff;
        --c-accent: #dfab4e;
        --c-muted: #b3aca6;
        --c-line: #3a3335;
        --c-card: #362c28;
        --c-red: #ed1c24;
        --font-title: "Bebas Neue", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; }
      #app { display: none; min-height: 100vh; flex-direction: column; }

      main { flex: 1; padding: 2rem 2rem 7rem; width: 100%; }
      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.25rem; }
      h1 svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .today-label { font-family: var(--font-title); font-size: 1.2rem; letter-spacing: 0.03em; text-transform: capitalize; color: var(--c-muted); margin-bottom: 0.5rem; }
      .count { color: var(--c-muted); font-size: 0.85rem; }
      .state { color: var(--c-muted); text-align: center; padding: 3rem 1rem; }

      /* --- Testata: titolo a sinistra, préparation rapide a destra --- */
      .head-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.25rem; flex-wrap: wrap; margin-bottom: 2rem; }
      .prep { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
      .prep-lab { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); }
      .prep-note { text-transform: none; letter-spacing: 0; color: #2e9e6b; font-weight: 700; margin-left: 0.4rem; }
      .prep-note.err { color: #ff6b6b; }
      .prep-btns { display: flex; gap: 0.6rem; }
      .prep-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.75rem;
        background: var(--c-card);
        border: 1px solid var(--c-line);
        color: var(--c-accent);
        font-family: var(--font-body);
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
        transition: border-color 0.2s, background 0.2s;
      }
      .prep-btn svg { width: 24px; height: 24px; display: block; }
      .prep-close svg { width: 26px; height: 21px; } /* icône X : garde son ratio */
      .prep-btn .m { font-size: 0.8rem; color: var(--c-muted); }
      .prep-btn:hover { border-color: var(--c-accent); }
      .prep-btn.active { border-color: var(--c-accent); background: rgba(223, 171, 78, 0.14); }
      .prep-btn.active .m { color: var(--c-accent); font-weight: 700; }
      .prep-btn:disabled { opacity: 0.5; cursor: wait; }
      /* Bottone "Fermer": chiude/riapre le commandes online */
      .prep-close .m { color: var(--c-muted); }
      .prep-close:hover { border-color: #ed1c24; }
      .prep-close.closed { border-color: #ed1c24; background: rgba(237, 28, 36, 0.18); color: #ff6b6b; }
      .prep-close.closed .m { color: #ff6b6b; font-weight: 700; }

      /* --- Card ordine --- */
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
      .card { position: relative; background: var(--c-card); border: 1px solid var(--c-line); padding: 1.25rem; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28); }
      /* Card annulée : contenuto sbiadito, MA i bottoni assoluti restano opachi.
         (Dim sul contenuto, non sull'intera card, così .btn-refund è 100% opaco.) */
      .card.off > *:not(.btn-refund):not(.btn-rollback) { opacity: 0.45; }
      .card.refundable { padding-bottom: 3.6rem; } /* spazio per il bottone assoluto */
      .card.done { padding-bottom: 3.4rem; opacity: 0.62; } /* spazio rollback + leggermente trasparente */
      .card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; }
      .ct-left { display: flex; align-items: center; gap: 0.6rem; }
      .time { font-family: var(--font-title); font-size: 1.6rem; letter-spacing: 0.03em; color: var(--c-accent); }
      .total { font-family: var(--font-title); font-size: 1.2rem; letter-spacing: 0.03em; }
      .tag { display: inline-block; padding: 0.15rem 0.5rem; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
      .tag-done { border: 1px solid var(--c-line); color: var(--c-muted); }
      .tag-cancel { background: rgba(237, 28, 36, 0.25); color: #ff6b6b; }
      .name { font-weight: 700; margin-bottom: 0.4rem; }
      .badge { display: inline-block; margin-left: 0.5rem; padding: 0.1rem 0.45rem; border: 1px solid var(--c-line); color: var(--c-muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .row { font-size: 0.85rem; color: var(--c-muted); margin-bottom: 0.2rem; }
      .row a { color: var(--c-text); text-decoration: none; }

      .items { border-top: 1px solid var(--c-line); margin-top: 0.9rem; padding-top: 0.9rem; display: flex; flex-direction: column; gap: 0.5rem; }
      .item { display: flex; gap: 0.6rem; align-items: baseline; font-size: 1.15rem; }
      .item-qty { color: var(--c-accent); font-weight: 700; }
      .item-name { flex: 1; color: var(--c-text); }
      .item-sub { color: var(--c-muted); font-size: 0.8rem; white-space: nowrap; }

      .order-note { margin-top: 0.9rem; padding: 0.7rem 0.9rem; background: #362c28; border-left: 2px solid var(--c-accent); font-size: 0.9rem; }

      /* --- Azioni sulla card attiva --- */
      .actions { display: flex; gap: 0.6rem; border-top: 1px solid var(--c-line); margin-top: 1rem; padding-top: 1rem; }
      .actions button {
        flex: 1;
        background: transparent;
        font-family: var(--font-title);
        font-size: 1.05rem;
        letter-spacing: 0.05em;
        padding: 0.5rem 0.6rem;
        cursor: pointer;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .actions button:disabled { opacity: 0.5; cursor: wait; }
      .btn-done { border: 1px solid var(--c-accent); color: var(--c-accent); }
      .btn-done:hover { background: var(--c-accent); color: var(--c-bg); }
      .btn-cancel { border: 1px solid rgba(237, 28, 36, 0.5); color: #ff6b6b; }
      .btn-cancel:hover { border-color: var(--c-red); }
      .btn-cancel.confirm { background: rgba(237, 28, 36, 0.25); border-color: var(--c-red); color: #fff; }
      /* Card terminée : ✓ blanc rond sur fond vert, à côté du prix */
      .ct-right { display: inline-flex; align-items: center; gap: 0.5rem; }
      .badge-ok {
        display: inline-flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; border-radius: 50%;
        background: #2e9e6b; color: #fff; font-size: 0.78rem; font-weight: 800; line-height: 1;
      }
      /* Rollback : rond doré, position absolue en bas à droite de la card */
      .btn-rollback {
        position: absolute; right: 0.9rem; bottom: 0.9rem;
        width: 40px; height: 40px; border-radius: 50%; border: none;
        background: var(--c-accent); color: var(--c-bg);
        font-size: 1.2rem; line-height: 1; display: inline-flex;
        align-items: center; justify-content: center; cursor: pointer;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
        transition: transform 0.1s, filter 0.15s;
      }
      .btn-rollback:hover { filter: brightness(1.08); }
      .btn-rollback:active { transform: scale(0.94); }
      .btn-rollback:disabled { opacity: 0.5; cursor: wait; }
      /* Bottone stampante (ristampa ticket) — predisposto, mostrato solo quando attivo */
      .btn-print {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; padding: 0; border-radius: 8px;
        border: 1px solid var(--c-line); background: transparent; color: var(--c-muted);
        cursor: pointer; transition: border-color 0.15s, color 0.15s;
      }
      .btn-print:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .btn-print svg { width: 17px; height: 17px; }
      /* Remboursement : tag stato in alto + bottone doré absolu en bas à droite */
      .tag-refund { border: 1px solid #2e9e6b; color: #2e9e6b; }
      .btn-refund {
        position: absolute; right: 0.9rem; bottom: 0.9rem; z-index: 2;
        font-family: var(--font-title); font-size: 0.9rem; letter-spacing: 0.03em;
        padding: 0.5rem 0.95rem; border-radius: 999px; border: none;
        background: var(--c-accent); color: var(--c-bg); font-weight: 700;
        cursor: pointer; box-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
        transition: transform 0.1s, filter 0.15s;
      }
      .btn-refund:hover { filter: brightness(1.08); }
      .btn-refund:active { transform: scale(0.96); }
      .btn-refund:disabled { opacity: 0.6; cursor: wait; }
      /* Modale remboursement */
      .rf-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.62); display: none; align-items: center; justify-content: center; z-index: 1000; padding: 1rem; }
      .rf-overlay.is-open { display: flex; }
      .rf-modal { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1.5rem; width: 100%; max-width: 380px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6); }
      .rf-title { font-family: var(--font-title); font-size: 1.4rem; margin: 0 0 0.3rem; color: var(--c-accent); }
      .rf-sub { color: var(--c-muted); font-size: 0.9rem; margin: 0 0 1.1rem; }
      .rf-label { display: block; font-size: 0.8rem; color: var(--c-muted); margin-bottom: 0.4rem; }
      .rf-inputrow { display: flex; align-items: center; gap: 0.5rem; }
      .rf-euro { color: var(--c-muted); font-size: 1.2rem; }
      .rf-amount { flex: 0 1 170px; background: #1c1819; border: 1px solid var(--c-line); color: #fff; font-size: 1.15rem; padding: 0.6rem 0.7rem; border-radius: 8px; }
      .rf-all { background: transparent; border: 2px solid var(--c-accent); color: var(--c-accent); font-weight: 700; padding: 0.55rem 1.05rem; border-radius: 8px; cursor: pointer; white-space: nowrap; transition: background 0.15s, color 0.15s; }
      .rf-all:hover { background: var(--c-accent); color: var(--c-bg); }
      .rf-msg { min-height: 1.1rem; font-size: 0.85rem; margin: 0.7rem 0 0; color: #ff8a8f; }
      .rf-msg.ok { color: #2e9e6b; }
      .rf-actions { display: flex; gap: 0.7rem; margin-top: 1.3rem; }
      .rf-actions button { flex: 1; font-family: var(--font-title); font-size: 1rem; padding: 0.6rem; cursor: pointer; border-radius: 8px; }
      .rf-cancel { background: var(--c-red); border: 1px solid var(--c-red); color: #fff; font-weight: 700; }
      .rf-cancel:hover { filter: brightness(1.08); }
      .rf-confirm { background: var(--c-accent); border: 1px solid var(--c-accent); color: var(--c-bg); font-weight: 700; }
      .rf-confirm:disabled { opacity: 0.5; cursor: wait; }

      /* --- Sezione terminati/annullati --- */
      .done-title {
        font-family: var(--font-title);
        font-size: 1.4rem;
        letter-spacing: 0.04em;
        color: var(--c-muted);
        border-top: 1px solid var(--c-line);
        margin-top: 2.5rem;
        padding-top: 1.75rem;
        margin-bottom: 1rem;
      }

      @media (max-width: 640px) {
        main { padding: 1.5rem 1rem 7rem; }
        .head-row { margin-bottom: 1.5rem; }
      }
    </style>
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <div class="head-row">
          <div>
            <h1><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 4 6v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6l-2-4Z" /><path d="M4 6h16" /><path d="M9 10a3 3 0 0 0 6 0" /></svg>Commandes</h1>
            <p class="today-label" id="today-label"></p>
            <p class="count" id="count"></p>
          </div>
          <div class="prep">
            <p class="prep-lab">Préparation<span class="prep-note" id="prep-note"></span></p>
            <div class="prep-btns" role="group" aria-label="Temps de préparation">
              <button class="prep-btn" type="button" data-min="15" title="Rapide — 15 minutes">
