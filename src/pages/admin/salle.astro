---
/**
 * LA SALA DEL PALMARE — /admin/salle (22/10/2026).
 *
 * E' l'unica pagina dell'admin che il ruolo «palmare» puo' aprire
 * (`PAGINE_PALMARE` in permessiRegole): il middleware ci rimanda il palmare
 * da qualunque altra pagina, /admin compresa.
 *
 * Com'e' fatta (deciso con Enzo il 22/10/2026):
 *  - in alto una PILLOLA ferma: foto (dal Team) o iniziali, nome, pallino
 *    della rete. Toccandola si apre il menu con «Disconnetti»: il logout non
 *    e' un bottone diretto, perche' in sala un tocco sbagliato con le mani
 *    occupate capita, e uscire a meta' servizio e' peggio di un tocco in piu';
 *  - in basso la NAVIGAZIONE, dove arriva il pollice: Sala, Ordini, Notifiche,
 *    Shifts. Per ora e' SOLO DISEGNO: le quattro voci non portano ancora da
 *    nessuna parte (vedi `claude/palmare.md` nel progetto);
 *  - sopra la navigazione, piccole PILLOLE con le sale, e al centro la
 *    PIANTINA della sala scelta: quella disegnata in Réglages → Réservations,
 *    col lato lungo sempre sul lato lungo del telefono (`pianoVerticale`).
 *    Per ora i tavoli sono tutti «spenti»: i colori dello stato arrivano dopo.
 *    Toccare un tavolo apre la sua scheda (`/admin/salle/table?id=`).
 *    Fra le sale si passa anche con uno swipe orizzontale.
 *
 * ⚠️ Niente AdminNav: la nav chiede /api/admin/pages e mostra le pagine
 * dell'admin, che il palmare non ha.
 * ⚠️ Nome, foto e piantina si leggono QUI, nel render, non da un'API: il
 * palmare non ha API (API_PALMARE e' vuota). Claims illeggibili → niente
 * nome, mai un errore.
 */
import PalmareHead from "../../components/admin/PalmareHead.astro";
import { CLIENT } from "../../config/client";
import { linguaPalmare } from "../../lib/admin/linguaPalmare";
import { COOKIE_LINGUA_PALMARE } from "../../lib/admin/linguaPalmareRegole";
import { adminT, LINGUE_ADMIN } from "../../i18n/admin";
import { claimsDaToken } from "../../lib/admin/adminAuth";
import { supabaseAdmin } from "../../lib/db";
import { ambitoDiRichiesta, leggi, leggiConfig } from "../../lib/admin/sede";
import { saleDelPalmare, pianoVerticale, type SalaPalmare } from "../../lib/pianoPalmare";
import { tavoliNonDisponibili } from "../../lib/salaInstallaRegole";
import { durateDelServizio } from "../../lib/pianoSalaRegole";
import { fusoDi } from "../../lib/fuso";
import { DateTime } from "luxon";

export const prerender = false;

// La lingua del cameriere (il suo telefono), o quella dell'admin.
const lang = await linguaPalmare(Astro.request);
const t = adminT(lang);

const staff = await claimsDaToken(Astro.cookies.get("mdd_at")?.value ?? "");
let nomeIntero = "";
let foto = "";
if (staff?.employee_id) {
  // Il palmare di un dipendente: nome e foto sono quelli del Team.
  try {
    const { data } = await supabaseAdmin.from("team").select("name, photo_url").eq("id", staff.employee_id).maybeSingle();
    const riga = (data ?? null) as { name?: string; photo_url?: string | null } | null;
    nomeIntero = String(riga?.name ?? "").trim();
    foto = String(riga?.photo_url ?? "").trim();
  } catch { nomeIntero = ""; }
}
// Il palmare del locale (o un dipendente cancellato dal Team): il nome
// dell'utente, scritto in Super.
if (!nomeIntero) nomeIntero = staff?.nome ?? "";
const iniziali = nomeIntero
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((p) => p[0]?.toUpperCase() ?? "")
  .join("") || "·";

// LE SALE E LE LORO PIANTINE — lette una volta, tutte: si cambia sala senza
// tornare al server. ⚠️ Nell'ambito di chi guarda: un palmare legato a una
// sede vede solo le sale della sua.
let sale: SalaPalmare[] = [];
/* CHI E' SEDUTO ADESSO (23/10/2026): i tavoli occupati in verde, e quelli
   uniti per una sola tavolata legati da una striscia. La regola e' la stessa
   delle proposte di «Installer» (`tavoliNonDisponibili`): un tavolo verde
   qui non viene mai proposto la'. */
let occupati = new Set<string>();
let gruppi: string[][] = [];
try {
  const ambito = await ambitoDiRichiesta(Astro.request, staff);
  const ora = DateTime.now().setZone(await fusoDi(ambito));
  const [{ data: righe }, { valori }, { data: seduti }] = await Promise.all([
    leggi("restaurant_tables", ambito, "id, zone, name, seats, shape, x, y, w, h"),
    leggiConfig(ambito, ["reservation_zones", "reservation_plan_areas", "reservation_plan_decor", "reservation_hold_minutes", "reservation_services"]),
    leggi("reservations", ambito, "heure, status, tables, service_key, extra_minutes, tab_status")
      .eq("date", ora.toFormat("yyyy-MM-dd"))
      .eq("status", "seated"),
  ]);
  sale = saleDelPalmare({
    righe,
    sezioni: valori.get("reservation_zones"),
    aree: valori.get("reservation_plan_areas"),
    decori: valori.get("reservation_plan_decor"),
  });
  const durate = durateDelServizio(valori.get("reservation_services"), valori.get("reservation_hold_minutes"));
  const stato = tavoliNonDisponibili({
    righe: (seduti ?? []) as unknown as Record<string, unknown>[],
    adessoHHmm: ora.toFormat("HH:mm"),
    durataNuova: durate.ripiego,
    durate,
  });
  occupati = stato.occupati;
  gruppi = stato.gruppi;
} catch { sale = []; }
const piante = sale.map((s, i) => {
  const p = pianoVerticale(s);
  // Il centro di ogni tavolo, gia' girato: da qui passa la striscia del legame.
  const centro = new Map(p.tavoli.map((tv) => [tv.id, [tv.x + tv.w / 2, tv.y + tv.h / 2] as const]));
  const legami = gruppi
    .map((g) => g.map((id) => centro.get(id)).filter((c): c is readonly [number, number] => Boolean(c)))
    .filter((punti) => punti.length > 1)
    .map((punti) => punti.map(([x, y]) => `${x},${y}`).join(" "));
  return { i, zona: s.zona, p, legami };
});
/** Il nome del tavolo: grande quanto il tavolo permette, ma leggibile sempre. */
const corpoNome = (w: number, h: number) => Math.round(Math.max(16, Math.min(30, Math.min(w, h) * 0.36)));
const COLORE_MURO: Record<string, string> = { white: "#e8e4de", black: "#1c1c1c", brown: "#4a4038" };

// La navigazione. `attiva` = la voce di questa pagina. Per ora solo disegno:
// le voci sono bottoni senza destinazione, e lo dicono (aria-disabled).
const VOCI = [
  { k: "salle", label: t("sal.nav.salle"), attiva: true,
    ico: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>' },
  { k: "orders", label: t("sal.nav.orders"), attiva: false,
    ico: '<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/>' },
  { k: "notif", label: t("sal.nav.notif"), attiva: false,
    ico: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>' },
  { k: "shifts", label: t("sal.nav.shifts"), attiva: false,
    ico: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
];
---

<html lang={lang}>
  <head>
    <PalmareHead titolo={t("sal.title")} />
    <style is:global>
      /* I colori di ripiego e il reset stanno in PalmareHead. */
      :root {
        /* L'altezza della pillola di navigazione e quella delle pillole delle
           sale: da qui la piantina sa quanto spazio lasciare in fondo. */
        --sal-nav-h: 58px;
        --sal-sale-h: 34px;
        --sal-nav-bottom: calc(env(safe-area-inset-bottom) + 1rem);
      }
      body {
        /* Una schermata sola, come un'app: la piantina si adatta, la pagina
           non scorre. */
        height: 100vh; height: 100dvh; overflow: hidden;
        display: flex; flex-direction: column;
      }

      /* ---------- la pillola, ferma in alto ---------- */
      .sal-testa {
        position: sticky; top: 0; z-index: 20;
        display: flex; justify-content: center;
        padding: max(0.75rem, env(safe-area-inset-top)) 1rem 0.75rem;
        background: linear-gradient(var(--c-bg) 70%, transparent);
      }
      .sal-pillola-box { position: relative; }
      .sal-pillola {
        display: flex; align-items: center; gap: 0.6rem;
        min-height: 48px; max-width: min(92vw, 360px);
        padding: 5px 14px 5px 5px; border-radius: 999px;
        border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-text);
        font: inherit; cursor: pointer;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
      }
      .sal-foto, .sal-iniz {
        width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0; object-fit: cover;
      }
      .sal-iniz {
        display: flex; align-items: center; justify-content: center;
        background: var(--c-accent); color: #fff; font-weight: 800; font-size: 0.9rem; letter-spacing: 0.02em;
      }
      .sal-chi { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      /* Il pallino della rete: verde collegato, arancione fuori linea. */
      .sal-rete { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; background: #4fbe8c; box-shadow: 0 0 0 3px color-mix(in srgb, #4fbe8c 25%, transparent); }
      .sal-rete.is-off { background: #f0a040; box-shadow: 0 0 0 3px color-mix(in srgb, #f0a040 25%, transparent); }
      .sal-freccia { width: 16px; height: 16px; flex-shrink: 0; fill: none; stroke: var(--c-muted); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s; }
      .sal-pillola[aria-expanded="true"] .sal-freccia { transform: rotate(180deg); }

      /* Il menu largo quanto lo schermo (meno il margine): bottoni grandi, da
         toccare col pollice. La pillola e' al centro, quindi lo e' anche lui. */
      .sal-menu {
        position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%);
        width: calc(100vw - 2rem); max-width: 480px; padding: 10px; border-radius: 20px;
        border: 1px solid var(--c-line); background: var(--c-card);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
      }
      .sal-menu-rete { padding: 10px 12px 8px; font-size: 0.8rem; color: var(--c-muted); }
      .sal-menu-tit { padding: 6px 12px 4px; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-muted); }
      .sal-lingue { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; padding: 2px 2px 14px; }
      .sal-lingua {
        height: 56px; border-radius: 14px; border: 1px solid var(--c-line); background: transparent;
        color: var(--c-text); font: inherit; font-size: 1.05rem; font-weight: 800; cursor: pointer;
      }
      /* La lingua scelta: il corallo dell'admin, come la voce attiva della nav. */
      .sal-lingua[aria-pressed="true"] { background: var(--c-accent); color: var(--c-bg); border-color: transparent; }
      /* Disconnetti: un bottone pieno, ROSSO come quello del cestino e di
         «Annuler» — e' un gesto che chiude, e si deve vedere. */
      .sal-esci {
        display: flex; align-items: center; justify-content: center; gap: 0.6rem; width: 100%;
        min-height: 54px; padding: 0 16px; border-radius: 999px; border: none;
        background: #a3320f; color: #fff; font: inherit; font-size: 1rem; font-weight: 800; cursor: pointer;
      }
      .sal-esci:hover { background: #8c2a0c; }
      .sal-esci svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .sal-esci[aria-busy="true"] { opacity: .6; }

      /* ---------- la piantina ---------- */
      .sal-mappa {
        flex: 1; min-height: 0; position: relative;
        padding: 0.25rem 0 calc(var(--sal-nav-bottom) + var(--sal-nav-h) + var(--sal-sale-h) + 1.4rem);
      }
      /* LE SALE UNA ACCANTO ALL'ALTRA: si passa dall'una all'altra col dito
         (swipe orizzontale) o con le pillole. Lo scorrimento e' quello del
         browser, con lo scatto su ogni sala: niente gesti scritti a mano, e
         il tocco su un tavolo resta un tocco. */
      .pm-binario {
        height: 100%; display: flex;
        overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch;
      }
      .pm-binario::-webkit-scrollbar { display: none; }
      .pm-sala {
        flex: 0 0 100%; height: 100%; padding: 0 0.75rem;
        scroll-snap-align: center; scroll-snap-stop: always;
      }
      .pm-sala svg { display: block; width: 100%; height: 100%; }
      .pm-area { fill: color-mix(in srgb, var(--c-text) 4%, transparent); stroke: var(--c-line); stroke-width: 3; stroke-linejoin: round; }
      /* Il tavolo «spento» = libero. I colori dello stato arrivano dopo. */
      .pm-tav-forma { fill: color-mix(in srgb, var(--c-card) 70%, var(--c-bg)); stroke: color-mix(in srgb, var(--c-text) 22%, transparent); stroke-width: 2.5; }
      /* Toccare un tavolo apre la sua scheda: il tocco si vede. */
      .pm-tav { cursor: pointer; -webkit-tap-highlight-color: transparent; }
      .pm-tav:active .pm-tav-forma, .pm-tav:focus-visible .pm-tav-forma { stroke: var(--c-accent); stroke-width: 4; }
      /* Occupato = verde, come deciso per la mappa del palmare. ⚠️ Il nome resta
         scuro sul verde: il colore da solo non basta, il numero si deve leggere. */
      .pm-tav.is-occupato .pm-tav-forma { fill: #4cc38a; stroke: #2f8f61; }
      .pm-tav.is-occupato .pm-tav-nome { fill: #0b1f14; }
      /* Il legame fra i tavoli di una sola tavolata: una striscia verde sotto. */
      .pm-legame { fill: none; stroke: #2f8f61; stroke-width: 22; stroke-linecap: round; stroke-linejoin: round; }
      .pm-tav-nome { fill: var(--c-muted); font-family: var(--font-body); font-weight: 800; text-anchor: middle; dominant-baseline: central; }
      .pm-vuoto {
        height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6rem;
        text-align: center; color: var(--c-muted); line-height: 1.55; padding: 0 1.5rem;
      }
      .pm-vuoto strong { color: var(--c-text); font-size: 1.05rem; }

      /* ---------- le pillole delle sale, sopra la navigazione ---------- */
      .sal-sale {
        position: fixed; left: 0; right: 0; z-index: 19;
        bottom: calc(var(--sal-nav-bottom) + var(--sal-nav-h) + 0.6rem);
        display: flex; justify-content: safe center; gap: 0.4rem;
        padding: 0 1rem; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
      }
      .sal-sale::-webkit-scrollbar { display: none; }
      .sal-sala {
        flex: 0 0 auto; height: var(--sal-sale-h); padding: 0 0.95rem; border-radius: 999px;
        border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-text);
        font: inherit; font-size: 0.78rem; font-weight: 700; cursor: pointer; white-space: nowrap;
      }
      .sal-sala[aria-pressed="true"] { background: var(--c-text); color: var(--c-bg); border-color: transparent; }

      /* ---------- la navigazione, in basso sotto il pollice ----------
         ⚠️ La stessa pillola della barra dell'admin (`.admin-nav` in
         AdminNav.astro): galleggia, fondo dell'header, voce attiva piena col
         colore attivo. Il palmare e' un pezzo dell'admin e deve sembrarlo.
         Copiata e non importata: AdminNav porta con se' la logica delle
         pagine dell'admin, che il palmare non ha. Se cambia il disegno di
         la', si cambia anche qui. */
      .sal-nav {
        position: fixed; left: 50%; transform: translateX(-50%); z-index: 20;
        bottom: calc(env(safe-area-inset-bottom) + 1rem);
        display: flex; gap: 0.25rem; padding: 0.35rem;
        max-width: calc(100vw - 2rem);
        border-radius: 999px;
        background: var(--c-header, var(--c-bg));
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow:
          0 8px 32px rgba(0, 0, 0, calc(0.55 * var(--sh, 0.15))),
          inset 0 1px 0 rgba(255, 255, 255, 0.18);
      }
      html.glass .sal-nav {
        background: color-mix(in srgb, var(--c-header, var(--c-bg)) 82%, transparent);
        -webkit-backdrop-filter: blur(26px) saturate(150%); backdrop-filter: blur(26px) saturate(150%);
      }
      .sal-voce {
        display: flex; flex: 0 0 auto; flex-direction: column; align-items: center; gap: 0.18rem;
        min-width: 64px; padding: 0.42rem 0.85rem; border-radius: 999px; border: none;
        background: transparent; color: var(--c-hmuted, var(--c-muted));
        font-family: var(--font-body, system-ui, sans-serif);
        font-size: 0.56rem; letter-spacing: 0.03em; text-transform: uppercase;
        cursor: pointer; transition: background 0.2s, color 0.2s;
      }
      .sal-voce svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .sal-voce[aria-current="page"] {
        background: var(--c-hactive, var(--c-accent));
        color: var(--c-hactive-text, var(--c-bg));
      }
    </style>
  </head>
  <body>
    <header class="sal-testa">
      <div class="sal-pillola-box">
        <button type="button" class="sal-pillola" id="sal-pillola" aria-haspopup="true" aria-expanded="false" aria-controls="sal-menu">
          {foto
            ? <img class="sal-foto" src={foto} alt="" />
            : <span class="sal-iniz" aria-hidden="true">{iniziali}</span>}
          <span class="sal-chi">{nomeIntero || CLIENT.nome}</span>
          <span class="sal-rete" id="sal-rete" role="img" aria-label={t("sal.online")}></span>
          <svg class="sal-freccia" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
        <div class="sal-menu" id="sal-menu" hidden data-cookie={COOKIE_LINGUA_PALMARE}>
          <p class="sal-menu-rete" id="sal-menu-rete" data-on={t("sal.online")} data-off={t("sal.offline")}>{t("sal.online")}</p>
          {/* LA LINGUA DEL CAMERIERE (23/10/2026): sul suo telefono, non per
              tutto il locale — l'admin puo' essere in italiano e lui parlare
              solo inglese. */}
          <p class="sal-menu-tit">{t("sal.lang")}</p>
          <div class="sal-lingue" role="group" aria-label={t("sal.lang")}>
            {LINGUE_ADMIN.map((l) => (
              <button type="button" class="sal-lingua" data-lingua={l.code} aria-pressed={l.code === lang ? "true" : "false"} title={l.label}>{l.code.toUpperCase()}</button>
            ))}
          </div>
          <button type="button" class="sal-esci" id="sal-esci">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="M16 17l5-5-5-5" /><path d="M21 12H9" /></svg>
            {t("hdr.logout")}
          </button>
        </div>
      </div>
    </header>

    <main class="sal-mappa">
      {piante.length === 0 ? (
        <div class="pm-vuoto">
          <strong>{t("sal.noPlan")}</strong>
          <span>{t("sal.noPlanHint")}</span>
        </div>
      ) : (
        <div class="pm-binario" id="pm-binario">
        {piante.map(({ zona, p, legami }) => (
        <div class="pm-sala" data-zona={zona}>
          <svg viewBox={`0 0 ${p.larghezza} ${p.altezza}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={zona}>
            {p.area && <polygon class="pm-area" points={p.area.map(([x, y]) => `${x},${y}`).join(" ")} />}
            {p.decor.map((d) => d.type === "plant"
              ? <image href="/restohub/plant.svg" x={d.x} y={d.y} width={d.w} height={d.h} />
              : <rect x={d.x} y={d.y} width={d.w} height={d.h} rx="3" fill={COLORE_MURO[d.color]} />)}
            {/* Il legame sta SOTTO i tavoli: si vede fra un tavolo e l'altro. */}
            {legami.map((punti) => <polyline class="pm-legame" points={punti} />)}
            {p.tavoli.map((tv) => (
              <a class:list={["pm-tav", { "is-occupato": occupati.has(tv.id) }]} href={`/admin/salle/table?id=${encodeURIComponent(tv.id)}`} aria-label={tv.name}>
                {tv.shape === "round"
                  ? <ellipse class="pm-tav-forma" cx={tv.x + tv.w / 2} cy={tv.y + tv.h / 2} rx={tv.w / 2} ry={tv.h / 2} />
                  : <rect class="pm-tav-forma" x={tv.x} y={tv.y} width={tv.w} height={tv.h} rx="10" />}
                <text class="pm-tav-nome" x={tv.x + tv.w / 2} y={tv.y + tv.h / 2} font-size={corpoNome(tv.w, tv.h)}>{tv.name}</text>
              </a>
            ))}
          </svg>
        </div>
        ))}
        </div>
      )}
    </main>

    {piante.length > 0 && (
      <div class="sal-sale" role="group" aria-label={t("sal.rooms")}>
        {piante.map(({ i, zona }) => (
          <button type="button" class="sal-sala" data-zona={zona} aria-pressed={i === 0 ? "true" : "false"}>{zona}</button>
        ))}
      </div>
    )}

    <nav class="sal-nav" aria-label={t("sal.title")}>
      {VOCI.map((v) => (
        <button type="button" class="sal-voce" aria-current={v.attiva ? "page" : undefined} aria-disabled={v.attiva ? undefined : "true"}>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={v.ico}></svg>
          {v.label}
        </button>
      ))}
    </nav>

    <script>
      import { collegaLogout } from "../../lib/admin/logout";

      // ---- Il menu della pillola: si apre e si chiude, il fuori lo chiude ----
      const pillola = document.getElementById("sal-pillola");
      const menu = document.getElementById("sal-menu");
      const apri = (si: boolean) => {
        if (!pillola || !menu) return;
        menu.hidden = !si;
        pillola.setAttribute("aria-expanded", si ? "true" : "false");
      };
      pillola?.addEventListener("click", (e) => {
        e.stopPropagation();
        apri(menu?.hidden === true);
      });
      document.addEventListener("click", (e) => {
        if (menu && !menu.hidden && !menu.contains(e.target as Node)) apri(false);
      });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") apri(false); });
      collegaLogout(document.getElementById("sal-esci"));

      // La lingua: un cookie del telefono per un anno, e la pagina si rifa'.
      document.querySelectorAll<HTMLButtonElement>(".sal-lingua").forEach((b) => b.addEventListener("click", () => {
        const l = b.dataset.lingua ?? "";
        document.cookie = `${document.getElementById("sal-menu")?.dataset.cookie ?? ""}=${encodeURIComponent(l)}; path=/; max-age=31536000; samesite=lax`;
        location.reload();
      }));

      // ---- La sala: swipe o pillole, e il telefono se la ricorda ----
      // Le sale stanno una accanto all'altra nel binario: lo SWIPE e' lo
      // scorrimento del browser (scatto su ogni sala), le pillole ci portano
      // con un tocco. La pillola accesa segue la sala che sta al centro.
      // ⚠️ La memoria e' del telefono, non della persona: e' giusto cosi',
      // il cameriere che lavora in terrazza la ritrova al prossimo avvio.
      const CHIAVE_SALA = "mdd-palmare-sala";
      const binario = document.getElementById("pm-binario");
      const pillole = [...document.querySelectorAll<HTMLButtonElement>(".sal-sala")];
      const piante = [...document.querySelectorAll<HTMLElement>(".pm-sala")];
      let corrente = 0;
      const evidenzia = (i: number) => {
        const zona = piante[i]?.dataset.zona;
        if (!zona) return;
        corrente = i;
        pillole.forEach((b, j) => b.setAttribute("aria-pressed", j === i ? "true" : "false"));
        pillole[i]?.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });
        try { localStorage.setItem(CHIAVE_SALA, zona); } catch { /* resta per questa visita */ }
      };
      const vai = (i: number, liscio = true) => {
        if (!binario || !piante[i]) return;
        binario.scrollTo({ left: i * binario.clientWidth, behavior: liscio ? "smooth" : "auto" });
        evidenzia(i);
      };
      pillole.forEach((b, i) => b.addEventListener("click", () => vai(i)));
      binario?.addEventListener("scroll", () => {
        const i = Math.round(binario.scrollLeft / Math.max(1, binario.clientWidth));
        if (i !== corrente) evidenzia(i);
      }, { passive: true });
      try {
        const ricordata = localStorage.getItem(CHIAVE_SALA);
        const i = piante.findIndex((p) => p.dataset.zona === ricordata);
        if (i > 0) vai(i, false);
      } catch { /* niente memoria: resta la prima */ }

      // ---- Il pallino della rete ----
      // Per ora dice solo se il telefono ha la rete. Quando arriveranno gli
      // invii in coda, dira' anche se ce n'e' qualcuno che aspetta.
      const rete = document.getElementById("sal-rete");
      const reteTesto = document.getElementById("sal-menu-rete");
      const aggiornaRete = () => {
        const on = navigator.onLine;
        rete?.classList.toggle("is-off", !on);
        const testo = (on ? reteTesto?.dataset.on : reteTesto?.dataset.off) ?? "";
        rete?.setAttribute("aria-label", testo);
        if (reteTesto) reteTesto.textContent = testo;
      };
      window.addEventListener("online", aggiornaRete);
      window.addEventListener("offline", aggiornaRete);
      aggiornaRete();
    </script>
  </body>
</html>
