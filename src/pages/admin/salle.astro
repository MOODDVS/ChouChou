---
/**
 * LA SALA DEL PALMARE — /admin/salle (22/10/2026).
 *
 * E' l'unica pagina dell'admin che il ruolo «palmare» puo' aprire
 * (`PAGINE_PALMARE` in permessiRegole): il middleware ci rimanda il palmare
 * da qualunque altra pagina, /admin compresa.
 *
 * Com'e' fatta (deciso con Enzo il 22/10/2026):
 *  - in alto una PILLOLA ferma: foto (dal Team) o iniziali, nome, pallino
 *    della rete. Toccandola si apre il menu con «Disconnetti»: il logout non
 *    e' un bottone diretto, perche' in sala un tocco sbagliato con le mani
 *    occupate capita, e uscire a meta' servizio e' peggio di un tocco in piu';
 *  - in basso la NAVIGAZIONE, dove arriva il pollice: Sala, Ordini, Notifiche,
 *    Shifts. Per ora e' SOLO DISEGNO: le quattro voci non portano ancora da
 *    nessuna parte (vedi `claude/palmare.md` nel progetto);
 *  - sopra la navigazione, piccole PILLOLE con le sale, e al centro la
 *    PIANTINA della sala scelta: quella disegnata in Réglages → Réservations,
 *    col lato lungo sempre sul lato lungo del telefono (`pianoVerticale`).
 *    I tavoli hanno gli stati di `lib/statoTavoliRegole.ts` (25/10/2026).
 *    Toccare un tavolo apre la sua scheda (`/admin/salle/table?id=`).
 *    Fra le sale si passa anche con uno swipe orizzontale.
 *
 * ⚠️ Niente AdminNav: la nav chiede /api/admin/pages e mostra le pagine
 * dell'admin, che il palmare non ha.
 * ⚠️ Nome, foto e piantina si leggono QUI, nel render, non da un'API: il
 * palmare non ha API (API_PALMARE e' vuota). Claims illeggibili → niente
 * nome, mai un errore.
 */
import PalmareHead from "../../components/admin/PalmareHead.astro";
import PalmareTesta from "../../components/admin/PalmareTesta.astro";
import PalmareNav from "../../components/admin/PalmareNav.astro";
import { cameriereDellaPillola } from "../../lib/admin/cameriereCorrente";
import { CLIENT } from "../../config/client";
import { linguaPalmare } from "../../lib/admin/linguaPalmare";
import { adminT } from "../../i18n/admin";
import { claimsDaToken } from "../../lib/admin/adminAuth";
import { ambitoDiRichiesta, leggi } from "../../lib/admin/sede";
import { configInCache, cronometro, seduteConOrdini } from "../../lib/admin/letturaSala";
import { saleDelPalmare, pianoVerticale, type SalaPalmare } from "../../lib/pianoPalmare";
import { tavoliNonDisponibili } from "../../lib/salaInstallaRegole";
import { statiTavoli, type StatoTavolo, type IconaTavolo } from "../../lib/statoTavoliRegole";
import { contiApertiDellaSala } from "../../lib/admin/contiSala";
import { ICONA_QR, ICONA_CARTA, ICONA_STAMPA } from "../../lib/iconeSala";
import { durateDelServizio } from "../../lib/pianoSalaRegole";
import { fusoDi } from "../../lib/fuso";
import { DateTime } from "luxon";

export const prerender = false;

// La lingua del cameriere (il suo telefono), o quella dell'admin.
const lang = await linguaPalmare(Astro.request);
const t = adminT(lang);

const staff = await claimsDaToken(Astro.cookies.get("mdd_at")?.value ?? "");
/* ⚠️ VELOCITA' (23/10/2026): il nome del cameriere e la sala si leggono
   INSIEME, non uno dopo l'altro; la configurazione del piano arriva dalla
   cache (30 s, svuotata a ogni salvataggio). Il tempo in `Server-Timing`. */
const crono = cronometro();

// LE SALE E LE LORO PIANTINE — lette una volta, tutte: si cambia sala senza
// tornare al server. ⚠️ Nell'ambito di chi guarda: un palmare legato a una
// sede vede solo le sale della sua.
let sale: SalaPalmare[] = [];
/* CHI E' SEDUTO ADESSO (23/10/2026): i tavoli occupati in verde, e quelli
   uniti per una sola tavolata legati da una striscia. La regola e' la stessa
   delle proposte di «Installer» (`tavoliNonDisponibili`): un tavolo verde
   qui non viene mai proposto la'. */
let gruppi: string[][] = [];
/* GLI STATI DEI TAVOLI (25/10/2026): colore, bordo, icone, timer — le regole
   in `lib/statoTavoliRegole.ts`. */
let stati = new Map<string, StatoTavolo>();
let fuso = "Europe/Brussels";
const leggiSale = async () => {
  try {
    const ambito = await ambitoDiRichiesta(Astro.request, staff);
    fuso = await fusoDi(ambito);
    const ora = DateTime.now().setZone(fuso);
    const [{ data: righe }, valori, { data: giornoRaw }, conti, { data: chiamateRaw }, conOrdini] = await Promise.all([
      leggi("restaurant_tables", ambito, "id, zone, name, seats, shape, x, y, w, h"),
      configInCache(ambito, ["reservation_zones", "reservation_plan_areas", "reservation_plan_decor", "reservation_hold_minutes", "reservation_services"]),
      // Oggi: chi e' seduto E chi deve arrivare (il bordo bianco, il rosso).
      leggi("reservations", ambito, "id, heure, status, tables, service_key, extra_minutes, tab_status, tab_table_id")
        .eq("date", ora.toFormat("yyyy-MM-dd"))
        .in("status", ["pending", "confirmed", "seated"]),
      contiApertiDellaSala(ambito),
      // «L'addition» chiesta dal tavolo (le ultime 12 ore, come la scheda).
      leggi("table_calls", ambito, "table_id, reason")
        .eq("status", "open")
        .gte("created_at", ora.minus({ hours: 12 }).toUTC().toISO() as string),
      // Chi ha ancora da pagare: occupato anche oltre il suo tempo.
      seduteConOrdini(ambito, ora),
    ]);
    const giorno = (giornoRaw ?? []) as unknown as { id: string; status: string; tab_status: string | null }[];
    const seduti = giorno.filter((r) => r.status === "seated");
    /* Il QR con pagamento diretto: una seduta SENZA conto con un ordine fuori
       dagli invii pagato online (`payment_method` vuoto e non piu' `pending`:
       un `pending` senza metodo e' un carrello abbandonato). Il cameriere
       scrive `onsite`, il conto `tab`. */
    const senzaConto = seduti.filter((r) => r.tab_status !== "pending" && r.tab_status !== "open").map((r) => r.id);
    const qrDiretti = new Set<string>();
    if (senzaConto.length) {
      const { data: oRaw } = await leggi("orders", ambito, "reservation_id, payment_method, status")
        .in("reservation_id", senzaConto)
        .is("round_id", null)
        .neq("status", "cancelled");
      for (const o of (oRaw ?? []) as unknown as { reservation_id: string; payment_method: string | null; status: string }[]) {
        if (!o.payment_method && o.status !== "pending") qrDiretti.add(String(o.reservation_id));
      }
    }
    sale = saleDelPalmare({
      righe,
      sezioni: valori.get("reservation_zones"),
      aree: valori.get("reservation_plan_areas"),
      decori: valori.get("reservation_plan_decor"),
    });
    const durate = durateDelServizio(valori.get("reservation_services"), valori.get("reservation_hold_minutes"));
    const stato = tavoliNonDisponibili({
      righe: (seduti ?? []) as unknown as Record<string, unknown>[],
      adessoHHmm: ora.toFormat("HH:mm"),
      durataNuova: durate.ripiego,
      durate,
      conOrdini,
    });
    gruppi = stato.gruppi;
    stati = statiTavoli({
      tavoli: ((righe ?? []) as unknown as { id: string }[]).map((r) => String(r.id)),
      righe: giorno,
      conti,
      chiamate: (chiamateRaw ?? []) as unknown as { table_id: string | null; reason: string | null }[],
      qrDiretti,
      adessoHHmm: ora.toFormat("HH:mm"),
      durate,
      conOrdini,
    });
  } catch { sale = []; }
};
const [cameriere] = await Promise.all([cameriereDellaPillola(staff, CLIENT.nome), leggiSale()]);
crono.tappa("sala");
Astro.response.headers.set("Server-Timing", crono.intestazione());
const piante = sale.map((s, i) => {
  const p = pianoVerticale(s);
  // Il centro di ogni tavolo, gia' girato: da qui passa la striscia del legame.
  const centro = new Map(p.tavoli.map((tv) => [tv.id, [tv.x + tv.w / 2, tv.y + tv.h / 2] as const]));
  const legami = gruppi
    .map((g) => g.map((id) => centro.get(id)).filter((c): c is readonly [number, number] => Boolean(c)))
    .filter((punti) => punti.length > 1)
    .map((punti) => punti.map(([x, y]) => `${x},${y}`).join(" "));
  return { i, zona: s.zona, p, legami };
});
/** Il nome del tavolo: grande quanto il tavolo permette, ma leggibile sempre. */
const corpoNome = (w: number, h: number) => Math.round(Math.max(16, Math.min(30, Math.min(w, h) * 0.36)));
const LIBERO: StatoTavolo = { colore: "libero", bordo: false, icone: [], arrivo: null, sforo: null };
const ICONE_STATO: Record<IconaTavolo, string> = { qr: ICONA_QR, carta: ICONA_CARTA, addizione: ICONA_STAMPA };
/** Le misure dei bollini e del timer, nelle unita' della piantina. */
const BOLLO_R = 13, ICONA_L = 15, TIMER_H = 24;
/** «42 min» fino all'arrivo, «+12 min · 20:30» dopo la fine (il rosso). */
const adessoMin = (() => { const o = DateTime.now().setZone(fuso); return o.hour * 60 + o.minute; })();
const min = (hhmm: string) => { const [h, m] = hhmm.split(":").map(Number); return h * 60 + m; };
const delta = (da: number, a: number) => { let d = a - da; if (d > 720) d -= 1440; if (d < -720) d += 1440; return d; };
const testoArrivo = (hhmm: string) => `${delta(adessoMin, min(hhmm))} min`;
const testoSforo = (s: { fine: string; prossima: string }) => `+${Math.max(0, delta(min(s.fine), adessoMin))} min · ${s.prossima}`;
const COLORE_MURO: Record<string, string> = { white: "#e8e4de", black: "#1c1c1c", brown: "#4a4038" };

---

<html lang={lang}>
  <head>
    <PalmareHead titolo={t("sal.title")} />
    <style is:global>
      /* I colori di ripiego e il reset stanno in PalmareHead. */
      :root {
        /* L'altezza della pillola di navigazione e quella delle pillole delle
           sale: da qui la piantina sa quanto spazio lasciare in fondo. */
        --sal-nav-h: 58px;
        --sal-sale-h: 34px;
        --sal-nav-bottom: calc(env(safe-area-inset-bottom) + 1rem);
      }
      body {
        /* Una schermata sola, come un'app: la piantina si adatta, la pagina
           non scorre. */
        height: 100vh; height: 100dvh; overflow: hidden;
        display: flex; flex-direction: column;
      }

      /* ---------- la piantina ---------- */
      .sal-mappa {
        flex: 1; min-height: 0; position: relative;
        padding: 0.25rem 0 calc(var(--sal-nav-bottom) + var(--sal-nav-h) + var(--sal-sale-h) + 1.4rem);
      }
      /* LE SALE UNA ACCANTO ALL'ALTRA: si passa dall'una all'altra col dito
         (swipe orizzontale) o con le pillole. Lo scorrimento e' quello del
         browser, con lo scatto su ogni sala: niente gesti scritti a mano, e
         il tocco su un tavolo resta un tocco. */
      .pm-binario {
        height: 100%; display: flex;
        overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch;
      }
      .pm-binario::-webkit-scrollbar { display: none; }
      .pm-sala {
        flex: 0 0 100%; height: 100%; padding: 0 0.75rem;
        scroll-snap-align: center; scroll-snap-stop: always;
      }
      .pm-sala > svg { display: block; width: 100%; height: 100%; }
      .pm-area { fill: color-mix(in srgb, var(--c-text) 4%, transparent); stroke: var(--c-line); stroke-width: 3; stroke-linejoin: round; }
      /* Il tavolo «spento» = libero. I colori dello stato arrivano dopo. */
      .pm-tav-forma { fill: color-mix(in srgb, var(--c-card) 70%, var(--c-bg)); stroke: color-mix(in srgb, var(--c-text) 22%, transparent); stroke-width: 2.5; }
      /* Toccare un tavolo apre la sua scheda: il tocco si vede. */
      .pm-tav { cursor: pointer; -webkit-tap-highlight-color: transparent; }
      .pm-tav:active .pm-tav-forma, .pm-tav:focus-visible .pm-tav-forma { stroke: var(--c-accent); stroke-width: 4; }
      /* GLI STATI (Enzo, 25/10/2026 — `lib/statoTavoliRegole.ts`). ⚠️ Il nome
         resta leggibile su ogni colore: il colore da solo non basta. */
      .pm-tav.is-verde .pm-tav-forma { fill: #4cc38a; stroke: #2f8f61; }
      .pm-tav.is-verde .pm-tav-nome { fill: #0b1f14; }
      .pm-tav.is-arancio .pm-tav-forma { fill: #ff9f43; stroke: #c77a2c; }
      .pm-tav.is-arancio .pm-tav-nome { fill: #241200; }
      .pm-tav.is-rosso .pm-tav-forma { fill: #e5484d; stroke: #a8282d; }
      .pm-tav.is-rosso .pm-tav-nome { fill: #fff; }
      .pm-tav.is-blu .pm-tav-forma { fill: #3e8ef7; stroke: #2563c4; }
      .pm-tav.is-blu .pm-tav-nome { fill: #fff; }
      /* Prenotato entro l'ora: bordo bianco spesso (anche sopra un colore). */
      .pm-tav.is-bordo .pm-tav-forma { stroke: #fff; stroke-width: 6; }
      .pm-tav.is-libero.is-bordo .pm-tav-nome { fill: var(--c-text); }
      /* I bollini delle icone (in alto a destra) e il timer (sotto). */
      .pm-bollo { fill: var(--c-bg); stroke: var(--c-card); stroke-width: 2; }
      .pm-bollo-ico { color: #fff; overflow: visible; }
      .pm-timer-fondo { fill: var(--c-bg); stroke: var(--c-card); stroke-width: 2; }
      .pm-timer-testo { fill: #fff; font-family: var(--font-body); font-weight: 800; font-size: 13px; text-anchor: middle; dominant-baseline: central; font-variant-numeric: tabular-nums; }
      .pm-timer.is-rosso .pm-timer-fondo { fill: #fff; }
      .pm-timer.is-rosso .pm-timer-testo { fill: #c22d32; }
      /* Il legame fra i tavoli di una sola tavolata: una striscia verde sotto. */
      .pm-legame { fill: none; stroke: #2f8f61; stroke-width: 22; stroke-linecap: round; stroke-linejoin: round; }
      .pm-tav-nome { fill: var(--c-muted); font-family: var(--font-body); font-weight: 800; text-anchor: middle; dominant-baseline: central; }
      .pm-vuoto {
        height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6rem;
        text-align: center; color: var(--c-muted); line-height: 1.55; padding: 0 1.5rem;
      }
      .pm-vuoto strong { color: var(--c-text); font-size: 1.05rem; }

      /* ---------- le pillole delle sale, sopra la navigazione ---------- */
      .sal-sale {
        position: fixed; left: 0; right: 0; z-index: 19;
        bottom: calc(var(--sal-nav-bottom) + var(--sal-nav-h) + 0.6rem);
        display: flex; justify-content: safe center; gap: 0.4rem;
        padding: 0 1rem; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
      }
      .sal-sale::-webkit-scrollbar { display: none; }
      .sal-sala {
        flex: 0 0 auto; height: var(--sal-sale-h); padding: 0 0.95rem; border-radius: 999px;
        border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-text);
        font: inherit; font-size: 0.78rem; font-weight: 700; cursor: pointer; white-space: nowrap;
      }
      .sal-sala[aria-pressed="true"] { background: var(--c-text); color: var(--c-bg); border-color: transparent; }

    </style>
  </head>
  <body>
    <PalmareTesta lang={lang} cameriere={cameriere} />

    <main class="sal-mappa">
      {piante.length === 0 ? (
        <div class="pm-vuoto">
          <strong>{t("sal.noPlan")}</strong>
          <span>{t("sal.noPlanHint")}</span>
        </div>
      ) : (
        <div class="pm-binario" id="pm-binario" data-fuso={fuso}>
        {piante.map(({ zona, p, legami }) => (
        <div class="pm-sala" data-zona={zona}>
          <svg viewBox={`0 0 ${p.larghezza} ${p.altezza}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={zona}>
            {p.area && <polygon class="pm-area" points={p.area.map(([x, y]) => `${x},${y}`).join(" ")} />}
            {p.decor.map((d) => d.type === "plant"
              ? <image href="/restohub/plant.svg" x={d.x} y={d.y} width={d.w} height={d.h} />
              : <rect x={d.x} y={d.y} width={d.w} height={d.h} rx="3" fill={COLORE_MURO[d.color]} />)}
            {/* Il legame sta SOTTO i tavoli: si vede fra un tavolo e l'altro. */}
            {legami.map((punti) => <polyline class="pm-legame" points={punti} />)}
            {p.tavoli.map((tv) => {
              const st = stati.get(tv.id) ?? LIBERO;
              const cx = tv.x + tv.w / 2;
              const tw = st.sforo ? 112 : 66;
              return (
              <a class:list={["pm-tav", `is-${st.colore}`, { "is-bordo": st.bordo }]} href={`/admin/salle/table?id=${encodeURIComponent(tv.id)}`} aria-label={tv.name}>
                {tv.shape === "round"
                  ? <ellipse class="pm-tav-forma" cx={cx} cy={tv.y + tv.h / 2} rx={tv.w / 2} ry={tv.h / 2} />
                  : <rect class="pm-tav-forma" x={tv.x} y={tv.y} width={tv.w} height={tv.h} rx="10" />}
                <text class="pm-tav-nome" x={cx} y={tv.y + tv.h / 2} font-size={corpoNome(tv.w, tv.h)}>{tv.name}</text>
                {/* Le icone: bollini scuri sull'angolo in alto a destra. */}
                {st.icone.map((ic, k) => {
                  const bx = tv.x + tv.w - 2 - (st.icone.length - 1 - k) * (BOLLO_R * 2 + 3); // nell'ordine: QR, poi carta
                  const by = tv.y + 2;
                  return (
                    <g>
                      <circle class="pm-bollo" cx={bx} cy={by} r={BOLLO_R} />
                      <svg class="pm-bollo-ico" x={bx - ICONA_L / 2} y={by - ICONA_L / 2} width={ICONA_L} height={ICONA_L} set:html={ICONE_STATO[ic]} />
                    </g>
                  );
                })}
                {/* Il timer: fino all'arrivo (bordo), o lo sforo (rosso). */}
                {(st.sforo || st.arrivo) && (
                  <g class:list={["pm-timer", { "is-rosso": Boolean(st.sforo) }]}
                    data-arrivo={st.sforo ? undefined : st.arrivo} data-fine={st.sforo?.fine} data-prossima={st.sforo?.prossima}>
                    <rect class="pm-timer-fondo" x={cx - tw / 2} y={tv.y + tv.h - TIMER_H / 2} width={tw} height={TIMER_H} rx={TIMER_H / 2} />
                    <text class="pm-timer-testo" x={cx} y={tv.y + tv.h}>{st.sforo ? testoSforo(st.sforo) : testoArrivo(st.arrivo!)}</text>
                  </g>
                )}
              </a>
              );
            })}
          </svg>
        </div>
        ))}
        </div>
      )}
    </main>

    {piante.length > 0 && (
      <div class="sal-sale" role="group" aria-label={t("sal.rooms")}>
        {piante.map(({ i, zona }) => (
          <button type="button" class="sal-sala" data-zona={zona} aria-pressed={i === 0 ? "true" : "false"}>{zona}</button>
        ))}
      </div>
    )}


    <PalmareNav lang={lang} attiva="salle" />

    <script>
      // ---- La sala: swipe o pillole, e il telefono se la ricorda ----
      // Le sale stanno una accanto all'altra nel binario: lo SWIPE e' lo
      // scorrimento del browser (scatto su ogni sala), le pillole ci portano
      // con un tocco. La pillola accesa segue la sala che sta al centro.
      // ⚠️ La memoria e' del telefono, non della persona: e' giusto cosi',
      // il cameriere che lavora in terrazza la ritrova al prossimo avvio.
      /* ⚠️ iPHONE E iPAD (28/10/2026): le pillole non cambiavano sala. Su
         Safari uno `scrollTo({ behavior: "smooth" })` dentro un contenitore
         con `scroll-snap-type: x mandatory` viene ri-agganciato subito alla
         sala di partenza, e lo scorrimento liscio della pillola che si
         centra interrompeva quello gia' partito. Su Chrome tutto
         funzionava, ed e' per questo che non si era visto.
         Adesso il passaggio lo anima la pagina: lo scatto si spegne, lo
         scorrimento va da solo fino alla sala, lo scatto si riaccende. Mentre
         va, gli eventi di scorrimento non cambiano la pillola accesa. E la
         fila delle pillole si centra spostando SOLO lei, mai la pagina. */
      const CHIAVE_SALA = "mdd-palmare-sala";
      const binario = document.getElementById("pm-binario");
      const filaSale = document.querySelector<HTMLElement>(".sal-sale");
      const pillole = [...document.querySelectorAll<HTMLButtonElement>(".sal-sala")];
      const piante = [...document.querySelectorAll<HTMLElement>(".pm-sala")];
      let corrente = 0;
      let inViaggio = false;
      const centraPillola = (i: number) => {
        const b = pillole[i];
        if (!filaSale || !b || filaSale.scrollWidth <= filaSale.clientWidth) return;
        filaSale.scrollLeft = Math.max(0, b.offsetLeft - (filaSale.clientWidth - b.offsetWidth) / 2);
      };
      const evidenzia = (i: number) => {
        const zona = piante[i]?.dataset.zona;
        if (!zona) return;
        corrente = i;
        pillole.forEach((b, j) => b.setAttribute("aria-pressed", j === i ? "true" : "false"));
        centraPillola(i);
        try { localStorage.setItem(CHIAVE_SALA, zona); } catch { /* resta per questa visita */ }
      };
      let animazione = 0;
      const vai = (i: number, liscio = true) => {
        if (!binario || !piante[i]) return;
        evidenzia(i);
        const arrivo = i * binario.clientWidth;
        cancelAnimationFrame(animazione);
        binario.style.scrollSnapType = "none";
        inViaggio = true;
        const fine = () => {
          binario.scrollLeft = arrivo;
          binario.style.scrollSnapType = "";
          inViaggio = false;
        };
        const partenza = binario.scrollLeft;
        const ridotto = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
        if (!liscio || ridotto || Math.abs(arrivo - partenza) < 2) { fine(); return; }
        const durata = 280;
        const t0 = performance.now();
        const passo = (t: number) => {
          const k = Math.min(1, (t - t0) / durata);
          binario.scrollLeft = partenza + (arrivo - partenza) * (1 - Math.pow(1 - k, 3));
          if (k < 1) animazione = requestAnimationFrame(passo);
          else fine();
        };
        animazione = requestAnimationFrame(passo);
      };
      pillole.forEach((b, i) => b.addEventListener("click", () => vai(i)));
      binario?.addEventListener("scroll", () => {
        if (inViaggio) return;
        const i = Math.round(binario.scrollLeft / Math.max(1, binario.clientWidth));
        if (i !== corrente) evidenzia(i);
      }, { passive: true });
      try {
        const ricordata = localStorage.getItem(CHIAVE_SALA);
        const i = piante.findIndex((p) => p.dataset.zona === ricordata);
        if (i > 0) vai(i, false);
      } catch { /* niente memoria: resta la prima */ }

      // ---- I timer dei tavoli e gli stati, sempre freschi ----
      // Ogni 30 secondi i minuti dei timer; ogni minuto, a pagina visibile,
      // la piantina si rilegge dal server (solo i disegni delle sale: la sala
      // scelta, lo swipe e il menu restano dove sono).
      const fusoSala = binario?.dataset.fuso || undefined;
      const adessoMinuti = () => {
        const [h, m] = new Intl.DateTimeFormat("en-GB", { timeZone: fusoSala, hour: "2-digit", minute: "2-digit", hourCycle: "h23" })
          .format(new Date()).split(":").map(Number);
        return h * 60 + m;
      };
      const minDi = (s: string) => { const [h, m] = s.split(":").map(Number); return h * 60 + m; };
      const scarto = (da: number, a: number) => { let d = a - da; if (d > 720) d -= 1440; if (d < -720) d += 1440; return d; };
      const aggiornaTimer = () => {
        const ora = adessoMinuti();
        document.querySelectorAll<SVGGElement>(".pm-timer").forEach((g) => {
          const testo = g.querySelector("text");
          if (!testo) return;
          const { arrivo, fine, prossima } = g.dataset;
          if (arrivo) testo.textContent = `${scarto(ora, minDi(arrivo))} min`;
          else if (fine) testo.textContent = `+${Math.max(0, scarto(minDi(fine), ora))} min · ${prossima ?? ""}`;
        });
      };
      setInterval(() => { if (document.visibilityState === "visible") aggiornaTimer(); }, 30_000);
      const rileggi = async () => {
        if (document.visibilityState !== "visible" || !navigator.onLine) return;
        try {
          const res = await fetch(location.href, { cache: "no-store", credentials: "same-origin" });
          if (!res.ok) return;
          const doc = new DOMParser().parseFromString(await res.text(), "text/html");
          doc.querySelectorAll<HTMLElement>(".pm-sala").forEach((nuova) => {
            const qui = piante.find((p) => p.dataset.zona === nuova.dataset.zona);
            const svg = nuova.querySelector(":scope > svg");
            const vecchio = qui?.querySelector(":scope > svg");
            if (svg && vecchio) vecchio.replaceWith(document.importNode(svg, true));
          });
          aggiornaTimer();
        } catch { /* niente rete: si riprova al prossimo giro */ }
      };
      setInterval(() => { void rileggi(); }, 60_000);
      document.addEventListener("visibilitychange", () => { if (document.visibilityState === "visible") void rileggi(); });

    </script>
  </body>
</html>
