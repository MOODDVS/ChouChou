    <!-- Modale : fiche d'un établissement -->
    <Modal id="loc-overlay" title={t("loc.new")} titleId="loc-title" width="680px">
      <!-- IDENTITA' — com'e' fatta la sede e dove sta nel sito.
           Indirizzo, telefono, societa' e IVA NON stanno qui: sono dati del
           ristoratore, e questa scheda lui non la vede. Si scrivono da
           Réglages → Général, sulla sede scelta in alto. -->
      <div class="f-field">
        <span class="f-label">{t("loc.image")}</span>
        <div class="f-img-row">
          <span class="f-img-prev" id="loc-prev"></span>
          <button type="button" class="btn" id="loc-img-up">{t("cli.uploadPhoto")}</button>
          <button type="button" class="btn" id="loc-img-lib">{t("menu.library")}</button>
          <button type="button" class="btn btn-danger" id="loc-img-rm" style="display: none">{t("ord.remove")}</button>
          <input type="file" id="loc-img-file" accept=".jpg,.jpeg,.png,.webp" style="display: none" />
          <span class="f-label" id="loc-img-state"></span>
        </div>
      </div>
      <p class="f-note">{t("loc.imageHint")}</p>

      <!-- Nome e ordine sulla stessa riga: il secondo e' un numero corto, e
           da solo lasciava mezza riga vuota. -->
      <div class="f-line">
        <div class="f-field loc-f-nome">
          <label class="f-label" for="loc-name">{t("loc.name")}</label>
          <input type="text" id="loc-name" maxlength="60" autocomplete="off" />
        </div>
        <div class="f-field loc-cap">
          <label class="f-label" for="loc-order">{t("loc.order")}</label>
          <input type="number" id="loc-order" min="0" max="999" />
        </div>
      </div>
      <p class="f-note">{t("loc.nameHint")}</p>

      <!-- Lo slug si SCRIVE DA SOLO dal nome: nessuno ha voglia di inventarlo,
           ed e' un concetto tecnico. Resta visibile e modificabile perche' una
           volta pubblicato non si tocca piu', e chi lo cambia deve poterlo
           vedere. Su una sede che esiste gia' non si aggiorna mai da solo. -->
      <div class="f-field">
        <label class="f-label" for="loc-slug">{t("loc.slug")}</label>
        <input type="text" id="loc-slug" maxlength="40" autocomplete="off" />
      </div>
      <p class="f-note">{t("loc.slugHint")}<br /><span class="loc-url" id="loc-url"></span></p>

      <!-- PAGAMENTI — segreti: si scrivono, non si rileggono mai. Il segnale
           accanto all'etichetta dice solo SE c'e' qualcosa, non che cosa. -->
      <p class="itg-niv">{t("loc.sezPagamenti")}</p>
      <div class="f-line">
        <div class="f-field">
          <label class="f-label" for="loc-stripe">{t("loc.stripe")} <span class="loc-chip" id="loc-stripe-stato"></span></label>
          <input type="password" id="loc-stripe" autocomplete="new-password" />
        </div>
        <div class="f-field">
          <label class="f-label" for="loc-hook">{t("loc.webhook")} <span class="loc-chip" id="loc-hook-stato"></span></label>
          <input type="password" id="loc-hook" autocomplete="new-password" />
        </div>
      </div>
      <p class="f-note">{t("loc.secretHint")}</p>
      <p class="f-note is-avviso" id="loc-cifra" hidden>{t("loc.cifraKo")}</p>

      <!-- GOOGLE — la scheda e il Place ID di QUESTO punto. L'autorizzazione
           invece e' una sola per installazione e si fa in Integrazioni. -->
      <p class="itg-niv">{t("loc.sezGoogle")}</p>
      <div class="f-field">
        <label class="f-label" for="loc-place">{t("loc.placeId")}</label>
        <div class="loc-riga">
          <input type="text" id="loc-place" placeholder="ChIJ…" autocomplete="off" />
          <button type="button" id="loc-place-test" class="btn">{t("common.verify")}</button>
        </div>
      </div>
      <p class="f-note" id="loc-place-res">{t("loc.placeIdHint")}</p>

      <div class="f-field">
        <label class="f-label" for="loc-greview">{t("loc.reviewUrl")}</label>
        <input type="url" id="loc-greview" placeholder="https://g.page/r/.../review" autocomplete="off" />
      </div>
      <p class="f-note">{t("loc.reviewUrlHint")}</p>

      <div class="f-field">
        <span class="f-label">{t("gg.pickTitle")}</span>
        <div class="loc-riga">
          <span class="loc-g-cur" id="loc-g-cur"></span>
          <button type="button" id="loc-g-pick" class="btn">{t("gg.change")}</button>
        </div>
        <div id="loc-g-list"></div>
      </div>

      <!-- IMPRESSION — la stampante di QUESTO punto. ⚠️ Il numero NON e' un
           segreto come le chiavi Stripe qui sopra: si vede, e si SCEGLIE da
           una tendina. Un numero battuto a mano e' un ticket che non esce, e
           nessuno che sappia perche'. -->
      <p class="itg-niv">{t("loc.sezStampa")}</p>
      <div class="f-field">
        <label class="f-label" for="loc-printer">{t("loc.printer")}</label>
        <div class="loc-riga">
          <select id="loc-printer"><option value="">{t("loc.printOff")}</option></select>
          <button type="button" id="loc-print-test" class="btn">{t("loc.printTest")}</button>
        </div>
      </div>
      <p class="f-note" id="loc-print-res">{t("loc.printerHint")}</p>
      <div class="f-field">
        <span class="sw-wrap"><label class="switch"><input type="checkbox" id="loc-print-auto" /><span class="track"></span></label><span class="sw-lab">{t("loc.printAuto")}</span></span>
      </div>

      <!-- PIU' STAMPANTI — una riga per destinazione. ⚠️ La principale qui
           sopra non ha categorie e prende tutto il resto: e' lei che
           impedisce a un piatto nuovo di finire da nessuna parte. -->
      <p class="itg-niv">{t("loc.sezDest")}</p>
      <div id="loc-dest"></div>
      <div class="loc-riga">
        <button type="button" id="loc-dest-add" class="btn">+ {t("loc.destAdd")}</button>
      </div>
      <p class="f-note">{t("loc.destHint")}</p>

      <Fragment slot="foot">
        <span class="sw-wrap"><label class="switch"><input type="checkbox" id="loc-active" checked /><span class="track"></span></label><span class="sw-lab">{t("loc.active")}</span></span>
        <span class="loc-err" id="loc-err"></span>
        <button type="button" class="md-btn" data-md-close>{t("common.cancel")}</button>
        <button type="button" class="md-btn md-btn-primary" id="loc-save">{t("common.save")}</button>
      </Fragment>
    </Modal>

    <!-- Lo storico di prima del multi-sede. Compare SOLO se c'e' davvero
         qualcosa da attribuire: su un'installazione nuova non c'e', e una
         domanda che ha sempre la stessa risposta si impara a saltare. -->
    <Modal id="st-overlay" title={t("loc.st.title")} width="560px">
      <p>{t("loc.st.intro")}</p>
      <p class="note">{t("loc.st.why")}</p>
      <div class="f-field st-scelta">
        <label class="f-label" for="st-sede">{t("loc.st.which")}</label>
        <select id="st-sede"></select>
      </div>
      <p class="note st-conteggi" id="st-conteggi"></p>
      <p class="st-avviso">⚠ {t("loc.st.warn")}</p>
      <Fragment slot="foot">
        <span class="loc-err" id="st-err"></span>
        <button type="button" class="md-btn" id="st-cancel">{t("common.cancel")}</button>
        <button type="button" class="md-btn md-btn-primary" id="st-go">{t("loc.st.go")}</button>
      </Fragment>
    </Modal>

    <ImagePicker />

    <div class="toast" id="toast"></div>

    <button class="fab-add fab-pill" id="loc-add" type="button" style="display:none" title={t("loc.new")}><span class="fab-plus">+</span>{t("loc.add")}</button>

    <AdminNav current="super" />

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { conAttesa } from "../../lib/admin/attesa";
      import { collegaLogout } from "../../lib/admin/logout";
      import { isSuperUser, PAGINE_ADMIN, TABS_ADMIN, FUNZIONI_OPZIONALI, TEMA_DEFAULT, TEMA_CHIAVI, LINGUE_PUBBLICHE } from "../../lib/admin/superAdmin";
      import { PAGINE_SOLO_ADMIN as SOLO_ADMIN } from "../../lib/admin/permessiRegole";
      import { adminT, type AdminLang } from "../../i18n/admin";

      (async () => {
        // Traduttore lato client: la lingua è già in <html lang>.
        const tr = adminT((document.documentElement.lang || "fr") as AdminLang);
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const rowsEl = document.getElementById("rows") as HTMLDivElement;
        const toastEl = document.getElementById("toast") as HTMLDivElement;

        collegaLogout(logoutBtn);

        // --- Onglets (Design | Réglages) : l'onglet ouvert est mémorisé ---
        const supTabs = document.getElementById("sup-tabs") as HTMLDivElement | null;
        function mostraPane(t: string) {
          supTabs?.querySelectorAll<HTMLElement>("button").forEach((b) =>
            b.classList.toggle("is-active", b.dataset.t === t)
          );
          document.querySelectorAll<HTMLElement>(".pane").forEach((p2) => {
            p2.hidden = p2.dataset.pane !== t;
          });
          // Il FAB appartiene a UN pannello: si mostra con lui, come nelle
          // altre pagine dove ogni tab ha il suo.
          const fabSedi = document.getElementById("loc-add") as HTMLButtonElement | null;
          if (fabSedi) fabSedi.style.display = t === "sedi" ? "" : "none";
          try { localStorage.setItem("mdd_super_tab", t); } catch { /* storage plein */ }
        }
        supTabs?.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest("button") as HTMLElement | null;
          if (b?.dataset.t) mostraPane(b.dataset.t);
        });
        try {
          const salvato = localStorage.getItem("mdd_super_tab");
          if (salvato && supTabs?.querySelector(`button[data-t="${salvato}"]`)) mostraPane(salvato);
        } catch { /* niente cache */ }

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        // Pagina riservata al super admin MOODD
        if (!isSuperUser(session.user)) {
          window.location.replace("/admin");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        let headers = {
          Authorization: `Bearer ${session.access_token ?? ""}`,
          "Content-Type": "application/json",
        };

        // Il token Supabase SCADE (di norma dopo un'ora). Con l'header fissato
        // una volta sola al caricamento, un tab lasciato aperto continuava a
        // mandare il token vecchio: ogni salvataggio tornava «Non autorisé»,
        // e in certi punti il campo spariva senza spiegazione. supabase-js
        // rinnova il token da solo in background: qui ci limitiamo ad
        // ASCOLTARLO e a riscrivere l'header. Nessuna chiamata da cambiare.
        supabaseBrowser.auth.onAuthStateChange((_evento, sessione) => {
          if (sessione?.access_token) headers = { Authorization: `Bearer ${sessione.access_token}`, "Content-Type": "application/json" };
        });

        let toastTimer: number | undefined;
        function toast(msg: string, isErr = false) {
          toastEl.textContent = msg;
          toastEl.classList.toggle("is-error", isErr);
          toastEl.classList.add("is-on");
          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => toastEl.classList.remove("is-on"), 2200);
        }

        // Testi tradotti passati dal server (JSON in pagina).
        const SUP = (() => {
          try { return JSON.parse(document.getElementById("sup-i18n")?.textContent || "{}"); }
          catch { return {}; }
        })() as {
          temaLabels?: Record<string, string>;
          glassTitle?: string; glassOn?: string; glassOff?: string; shadowTitle?: string;
          visible?: string; hidden?: string; loadError?: string; loading?: string; sito?: string;
          on?: string; off?: string;
          pageLabels?: Record<string, string>; tabLabels?: Record<string, string>;
          featureLabels?: Record<string, string>;
          /** Nomi delle tabelle nel conteggio dello storico senza sede. */
          stTabLabels?: Record<string, string>;
          pwaNoIcon?: string; pwaReinstall?: string; pwaNomeCliente?: string;
          /** Testi del pannello Établissements (multi-sede). */
          loc?: Record<string, string>;
        };

        let nascoste: string[] = [];
        let nascosteTab: string[] = [];
        let funzioni: string[] = [];

        // ---- Funzioni opzionali (spente di default: chi non le usa non le vede) ----
        const featRowsEl = document.getElementById("feat-rows") as HTMLDivElement;
        function renderFunzioni() {
          featRowsEl.innerHTML = FUNZIONI_OPZIONALI.map((f) => {
            const attiva = funzioni.includes(f.key);
            return `
            <div class="rowwrap" data-f="${f.key}">
              <div class="row${attiva ? "" : " is-off"}">
                <span class="row-name">${SUP.featureLabels?.[f.key] ?? f.label}</span>
                <span class="row-state">${attiva ? (SUP.on ?? "Actif") : (SUP.off ?? "Inactif")}</span>
                <label class="switch"><input type="checkbox" class="t-feat" ${attiva ? "checked" : ""} /><span class="track"></span></label>
              </div>
            </div>`;
          }).join("");
        }
        featRowsEl.addEventListener("change", async (e) => {
          const cb = (e.target as HTMLElement).closest<HTMLInputElement>(".t-feat");
          if (!cb) return;
          const key = cb.closest<HTMLElement>(".rowwrap")?.dataset.f ?? "";
          if (!key) return;
          const prima = [...funzioni];
          funzioni = cb.checked ? [...new Set([...funzioni, key])] : funzioni.filter((k) => k !== key);
          renderFunzioni();
          try {
            const res = await fetch("/api/admin/pages", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ features: funzioni }),
            });
            if (!res.ok) throw new Error();
          } catch {
            funzioni = prima; // salvataggio fallito: si torna com'era
            renderFunzioni();
          }
        });

        // ---- Marchio dell'app installata (PWA) ----
        // L'interruttore si accende solo se l'icona del cliente esiste davvero:
        // senza, l'app resterebbe senza icona invece di ripiegare su RestoHub.
        const pwaSw = document.getElementById("pwa-sw") as HTMLInputElement | null;
        const pwaRow = document.getElementById("pwa-row") as HTMLElement | null;
        const pwaState = document.getElementById("pwa-state") as HTMLElement | null;
        const pwaMsg = document.getElementById("pwa-msg") as HTMLElement | null;
        let pwaBrand: "restohub" | "client" = "restohub";
        let pwaIcona = false;

        function renderPwa() {
          if (!pwaSw || !pwaRow || !pwaState || !pwaMsg) return;
          const acceso = pwaBrand === "client";
          pwaSw.checked = acceso;
          pwaSw.disabled = !pwaIcona;
          pwaRow.classList.toggle("is-off", !acceso);
          pwaState.textContent = acceso ? (SUP.pwaNomeCliente || "Client") : "RestoHub";
          // Un interruttore spento senza spiegazione sembra un guasto: qui dice
          // sempre perche' e' spento, o cosa succede se lo accendi.
          pwaMsg.textContent = pwaIcona ? (SUP.pwaReinstall ?? "") : (SUP.pwaNoIcon ?? "");
        }
        pwaSw?.addEventListener("change", async () => {
          const prima = pwaBrand;
          pwaBrand = pwaSw.checked ? "client" : "restohub";
          renderPwa();
          try {
            const res = await fetch("/api/admin/pages", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ pwaBrand }),
            });
            if (!res.ok) throw new Error();
            toast(tr("common.saved"));
          } catch {
            pwaBrand = prima; // salvataggio fallito: si torna com'era
            renderPwa();
            toast(tr("common.saveErr"), true);
          }
        });

        function render() {
          rowsEl.innerHTML = PAGINE_ADMIN.map((p) => {
            const visibile = !nascoste.includes(p.key);
            const tabs = TABS_ADMIN[p.key] ?? [];
            const sub = tabs.length && visibile
              ? `<div class="subrows">${tabs
                  .map((tb) => {
                    const tk = `${p.key}:${tb.key}`;
                    const vis = !nascosteTab.includes(tk);
                    return `
              <div class="subrow${vis ? "" : " is-off"}" data-tk="${tk}">
                <span class="subrow-name">${SUP.tabLabels?.[tk] ?? tb.label}</span>
                <label class="switch"><input type="checkbox" class="t-tab" ${vis ? "checked" : ""} /><span class="track"></span></label>
              </div>`;
                  })
                  .join("")}</div>`
              : "";
            return `
            <div class="rowwrap" data-k="${p.key}">
              <div class="row${visibile ? "" : " is-off"}">
                <span class="row-name">${SUP.pageLabels?.[p.key] ?? p.label}</span>
                <span class="row-state">${visibile ? (SUP.visible ?? "Visible") : (SUP.hidden ?? "Masquée")}</span>
                <label class="switch"><input type="checkbox" class="t-vis" ${visibile ? "checked" : ""} /><span class="track"></span></label>
              </div>
              ${sub}
            </div>`;
          }).join("");
        }

        async function salva() {
          try {
            const res = await fetch("/api/admin/pages", {
              method: "PUT",
              headers,
              body: JSON.stringify({ hidden: nascoste, hiddenTabs: nascosteTab }),
            });
            if (!res.ok) throw new Error();
            toast(tr("common.saved"));
          } catch {
            toast(tr("common.saveErr"), true);
          }
        }

        // ---- Langue de l'admin ----
        // Salva la lingua globale e ricarica: i testi sono resi lato server.
        const langSel = document.getElementById("admin-lang-sel") as HTMLSelectElement | null;
        if (langSel) {
          langSel.addEventListener("change", async () => {
            langSel.disabled = true;
            try {
              const res = await fetch("/api/admin/pages", {
                method: "PUT",
                headers,
                body: JSON.stringify({ lang: langSel.value }),
              });
              if (!res.ok) throw new Error();
              location.reload();
            } catch {
              langSel.disabled = false;
              toast(tr("common.saveErr"), true);
            }
          });
        }

        // ---- Lingue pubbliche (cliente) ----
        const publangEl = document.getElementById("publang-list") as HTMLDivElement | null;
        let publicLangs: string[] = [];
        let publicDefault = "fr";

        function renderPublang() {
          if (!publangEl) return;
          publangEl.innerHTML = LINGUE_PUBBLICHE.map((l) => {
            const attiva = publicLangs.includes(l.code);
            const isDef = attiva && l.code === publicDefault;
            const defBtn = isDef
              ? `<span class="publang-def" title="${tr("sup.publang.default")}" aria-label="${tr("sup.publang.default")}">★</span>`
              : `<button type="button" class="publang-set" data-def="${l.code}" aria-label="${tr("sup.publang.setDefault")}" title="${tr("sup.publang.setDefault")}">☆</button>`;
            return `
            <div class="publang-row${attiva ? "" : " is-off"}${isDef ? " is-default" : ""}" data-code="${l.code}">
              <span class="publang-name"><span class="publang-flag">${l.flag}</span><span class="publang-name-txt">${l.label}</span></span>
              ${defBtn}
              <label class="switch"><input type="checkbox" class="publang-on" ${attiva ? "checked" : ""} /><span class="track"></span></label>
            </div>`;
          }).join("");
        }

        async function salvaPublang() {
          try {
            const res = await fetch("/api/admin/pages", {
              method: "PUT",
              headers,
              body: JSON.stringify({ publicLangs, publicLangDefault: publicDefault }),
            });
            if (!res.ok) throw new Error();
            toast(tr("common.saved"));
          } catch {
            toast(tr("common.saveErr"), true);
          }
        }

        publangEl?.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest("button[data-def]") as HTMLElement | null;
          if (!b) return;
          const code = b.dataset.def!;
          // Impostare come predefinita: la attiva se serve, poi la marca.
          if (!publicLangs.includes(code)) publicLangs = LINGUE_PUBBLICHE.map((l) => l.code).filter((c) => publicLangs.includes(c) || c === code);
          publicDefault = code;
          renderPublang();
          void salvaPublang();
        });

        publangEl?.addEventListener("change", (e) => {
          const t = e.target as HTMLInputElement;
          if (!t.classList.contains("publang-on")) return;
          const code = (t.closest(".publang-row") as HTMLElement).dataset.code!;
          if (t.checked) {
            // attiva, mantenendo l'ordine canonico
            publicLangs = LINGUE_PUBBLICHE.map((l) => l.code).filter((c) => publicLangs.includes(c) || c === code);
          } else {
            // regole: non l'ultima, non la predefinita
            if (publicLangs.length <= 1) { t.checked = true; toast(tr("sup.publang.minOne"), true); return; }
            if (code === publicDefault) { t.checked = true; toast(tr("sup.publang.defaultLocked"), true); return; }
            publicLangs = publicLangs.filter((c) => c !== code);
          }
          renderPublang();
          void salvaPublang();
        });

        rowsEl.addEventListener("change", async (e) => {
          const t = e.target as HTMLInputElement;
          if (t.classList.contains("t-vis")) {
            const k = (t.closest(".rowwrap") as HTMLElement).dataset.k!;
            nascoste = t.checked ? nascoste.filter((x) => x !== k) : [...nascoste, k];
            render();
            await salva();
          } else if (t.classList.contains("t-tab")) {
            const tk = (t.closest(".subrow") as HTMLElement).dataset.tk!;
            nascosteTab = t.checked ? nascosteTab.filter((x) => x !== tk) : [...nascosteTab, tk];
            render();
            await salva();
          }
        });

        // ---- Couleurs du brand ----
        const temaRowsEl = document.getElementById("tema-rows") as HTMLDivElement;
        const temaResetEl = document.getElementById("tema-reset") as HTMLButtonElement;
        const TEMA_LABEL: Record<string, string> = SUP.temaLabels || {};
        let tema: Record<string, string> = {};

        // Applica SUBITO i colori a questa pagina (anteprima live) + cache
        function applicaTema() {
          const root = document.documentElement;
          for (const k of TEMA_CHIAVI) {
            if (tema[k]) root.style.setProperty("--c-" + k, tema[k]);
            else root.style.removeProperty("--c-" + k);
          }
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", tema.bg ?? "#ffffff");
          root.classList.toggle("glass", tema.glass === "on");
          if (tema.shadow !== undefined) root.style.setProperty("--sh", String(Number(tema.shadow) / 100));
          else root.style.removeProperty("--sh");
          try { localStorage.setItem("mdd_theme", JSON.stringify(tema)); } catch { /* pieno */ }
        }

        function renderTema() {
          const glassOn = tema.glass === "on";
          temaRowsEl.innerHTML =
            TEMA_CHIAVI.map((k) => {
              const v = tema[k] ?? TEMA_DEFAULT[k];
              return `
            <div class="tema-card" data-tk="${k}">
              <input type="color" class="tema-pick tema-sw" value="${v}" />
              <div class="tema-meta">
                <span class="tema-nom">${TEMA_LABEL[k] ?? k}</span>
                <span class="tema-hex">${v}</span>
              </div>
            </div>`;
            }).join("") +
            `
            <div class="tema-card wide">
              <span class="tema-nom">${SUP.glassTitle ?? "Effet verre (transparences)"}</span>
              <span class="tema-hex">${glassOn ? (SUP.glassOn ?? "oui") : (SUP.glassOff ?? "opaque")}</span>
              <label class="switch"><input type="checkbox" id="tema-glass" ${glassOn ? "checked" : ""} /><span class="track"></span></label>
            </div>
            <div class="tema-card wide">
              <span class="tema-nom">${SUP.shadowTitle ?? "Ombres"}</span>
              <span class="tema-hex" id="tema-shadow-v">${tema.shadow ?? "15"}%</span>
              <input type="range" class="tema-range" id="tema-shadow" min="0" max="100" step="5" value="${tema.shadow ?? "15"}" />
            </div>`;
          document.getElementById("tema-shadow")?.addEventListener("input", (e) => {
            const v = (e.target as HTMLInputElement).value;
            if (v === "15") delete tema.shadow;
            else tema.shadow = v;
            const lbl = document.getElementById("tema-shadow-v");
            if (lbl) lbl.textContent = v + "%";
            applicaTema();
            salvaTema();
          });
          document.getElementById("tema-glass")?.addEventListener("change", (e) => {
            const on = (e.target as HTMLInputElement).checked;
            if (on) tema.glass = "on";
            else delete tema.glass;
            renderTema();
            applicaTema();
            salvaTema();
          });
        }

        let temaTimer: number | undefined;
        function salvaTema() {
          window.clearTimeout(temaTimer);
          temaTimer = window.setTimeout(async () => {
            try {
              const res = await fetch("/api/admin/pages", {
                method: "PUT",
                headers,
                body: JSON.stringify({ hidden: nascoste, hiddenTabs: nascosteTab, theme: tema }),
              });
              if (!res.ok) throw new Error();
              toast(tr("sup.tema.saved"));
            } catch {
              toast(tr("common.saveErr"), true);
            }
          }, 500);
        }

        temaRowsEl.addEventListener("input", (e) => {
          const t = e.target as HTMLInputElement;
          if (!t.classList.contains("tema-pick")) return;
          const k = (t.closest(".tema-card") as HTMLElement).dataset.tk!;
          tema[k] = t.value.toLowerCase();
          const hex = (t.closest(".tema-card") as HTMLElement).querySelector(".tema-hex");
          if (hex) hex.textContent = tema[k];
          applicaTema();
          salvaTema();
        });

        // --- Google Business ---
        const gState = document.getElementById("g-state") as HTMLSpanElement | null;
        const gConnect = document.getElementById("g-connect") as HTMLButtonElement | null;
        const gOauthNote = document.getElementById("g-oauth-note") as HTMLSpanElement | null;


        // Collegamento OAuth (livello 2)
        const gDisconnect = document.getElementById("g-disconnect") as HTMLButtonElement | null;
        gConnect?.addEventListener("click", async () => {
          gConnect.disabled = true;
          try {
            const res = await fetch("/api/google/connect", { method: "POST", headers });
            const j = await res.json();
            if (!res.ok || !j.url) { toast(j.error ?? tr("itg.g.connErr"), true); return; }
            window.location.href = j.url; // schermata di consenso Google
          } catch {
            toast(tr("common.netErr"), true);
          } finally {
            gConnect.disabled = false;
          }
        });

        // --- Scheda Google: il RINVIO al modale della sede -------------------
        // La scelta della scheda e' passata nel modale del punto (deciso
        // 15/09/2026): tutto quello che appartiene a una sede si modifica
        // nella sua scheda, non in una pagina che parla dell'installazione.
        // Qui resta solo il collegamento, che e' uno per tutte le sedi.
        const gRinvio = document.getElementById("g-sedi-rinvio") as HTMLElement | null;
        function escG(x: unknown): string {
          return String(x ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }
        const gUnicaBox = document.getElementById("g-unica") as HTMLElement | null;
        const gUnicaCur = document.getElementById("g-unica-cur") as HTMLElement | null;
        const gUnicaPick = document.getElementById("g-unica-pick") as HTMLButtonElement | null;
        const gUnicaList = document.getElementById("g-unica-list") as HTMLElement | null;

        /** ⚠️ Legge `sedi`, che la riempie `locCarica()`: per questo NON si
         *  chiama qui (`sedi` sarebbe ancora nella sua zona morta e lancerebbe)
         *  ma in fondo a `locCarica`, quando l'elenco c'e' davvero. */
        async function gCaricaSedeStato() {
          try {
            const res = await fetch("/api/admin/google/locations", { headers });
            const j = await res.json();
            const conSedi = sedi.length > 0;
            if (gRinvio) gRinvio.style.display = j.connected && conSedi ? "block" : "none";
            if (gUnicaBox) gUnicaBox.style.display = j.connected && !conSedi ? "block" : "none";
            if (gUnicaCur) gUnicaCur.textContent = j.current?.title || (SUP.loc?.gNessuna ?? "");
          } catch { /* best-effort */ }
        }

        gUnicaPick?.addEventListener("click", async () => {
          if (!gUnicaList) return;
          gUnicaList.textContent = SUP.loading ?? "";
          try {
            const res = await fetch("/api/admin/google/locations", { headers });
            const j = await res.json();
            if (j.error) { gUnicaList.textContent = String(j.error); return; }
            const schede = (j.sedi ?? []) as { path: string; title: string; address: string }[];
            const cur = j.current?.path ?? "";
            if (!schede.length) { gUnicaList.textContent = SUP.loc?.gVuoto ?? ""; return; }
            gUnicaList.innerHTML = schede
              .map((sd) => `<button type="button" class="us-ghost gscheda-unica" data-path="${escG(sd.path)}" data-title="${escG(sd.title)}" style="display:block;width:100%;text-align:left;margin-bottom:0.4rem${sd.path === cur ? ";border-color:var(--c-accent)" : ""}">${escG(sd.title || sd.path)}${sd.address ? ` — <span class="note">${escG(sd.address)}</span>` : ""}</button>`)
              .join("");
          } catch {
            gUnicaList.textContent = SUP.loc?.netErr ?? "";
          }
        });

        gUnicaList?.addEventListener("click", async (ev) => {
          const b = (ev.target as HTMLElement).closest(".gscheda-unica") as HTMLElement | null;
          if (!b) return;
          try {
            // ⚠️ Nessun `sede` nel corpo: e' proprio quello che manda l'API
            // sul livello marchio. Metterci un id sarebbe inventare una sede.
            const res = await fetch("/api/admin/google/locations", {
              method: "POST", headers,
              body: JSON.stringify({ path: b.dataset.path ?? "", title: b.dataset.title ?? "" }),
            });
            const j = await res.json();
            if (!res.ok) { toast(j.error ?? SUP.loc?.netErr ?? "", true); return; }
            if (j.reviewError) toast(String(j.reviewError), true);
            else toast(SUP.loc?.gSalvata ?? "");
            if (gUnicaList) gUnicaList.innerHTML = "";
            await gCaricaSedeStato();
          } catch {
            toast(SUP.loc?.netErr ?? "", true);
          }
        });
        gDisconnect?.addEventListener("click", async () => {
          try {
            const res = await fetch("/api/google/connect", {
              method: "POST",
              headers: { ...headers, "X-Method-Override": "DELETE" },
            });
            if (!res.ok) { toast(tr("itg.g.disErr"), true); return; }
            toast(tr("itg.g.disconnected"));
            void itgCarica();
          } catch { toast(tr("common.netErr"), true); }
        });

        // Esito del ritorno da Google (?google=ok|refus|etat|echec|erreur)
        (() => {
          const q = new URLSearchParams(window.location.search).get("google");
          if (!q) return;
          const testi: Record<string, string> = {
            ok: tr("itg.g.ret.ok"),
            refus: tr("itg.g.ret.refus"),
            etat: tr("itg.g.ret.etat"),
            echec: tr("itg.g.ret.echec"),
            erreur: tr("itg.g.ret.erreur"),
          };
          toast(testi[q] ?? q, q !== "ok");
          const u = new URL(window.location.href);
          u.searchParams.delete("google");
          window.history.replaceState({}, "", u.toString());
        })();


        async function itgCarica() {
          try {
            const res = await fetch("/api/admin/integrations", { headers });
            if (!res.ok) return;
            const j = (await res.json()) as {
              google?: { place_id: string; connected: boolean; oauth_ready: boolean };
              search_console?: { site: string; ready: boolean; robot: string };
              newsletter?: { monthly_quota: number };
            };
            const g = j.google;
            if (g) {
              if (gState) {
                gState.textContent = g.connected ? tr("itg.g.connected") : g.place_id ? tr("itg.g.reviewsActive") : tr("itg.g.off");
                gState.classList.toggle("ext", g.connected || Boolean(g.place_id));
              }
              if (gConnect) {
                gConnect.disabled = !g.oauth_ready;
                gConnect.textContent = g.connected ? tr("itg.g.reconnect") : tr("itg.g.connect");
              }
              if (gDisconnect) gDisconnect.style.display = g.connected ? "" : "none";
              if (gOauthNote) {
                gOauthNote.textContent = !g.oauth_ready
                  ? tr("itg.g.pending")
                  : g.connected
                    ? tr("itg.g.connectedNote")
                    : tr("itg.g.authNote");
              }
            }
            const sc = j.search_console;
            if (sc) {
              if (scSite) scSite.value = sc.site ?? "";
              if (scState) {
                scState.textContent = !sc.ready ? tr("itg.sc.noKey") : sc.site ? tr("itg.sc.active") : tr("itg.sc.off");
                scState.classList.toggle("ext", sc.ready && Boolean(sc.site));
              }
              // email del robot: mostrata solo se il super admin la riceve
              if (sc.robot && scRobot && scRobotRow && scRobotWrap) {
                scRobot.value = sc.robot;
                scRobotRow.style.display = "";
                scRobotWrap.style.display = "";
              }
              if (!sc.ready && scRes) {
                scRes.textContent = tr("itg.sc.noServerKey");
              }
            }
            const nl = j.newsletter;
            if (nl && nlQuota) nlQuota.value = String(nl.monthly_quota ?? 1000);
          } catch { /* rete assente */ }
        }

        // --- Search Console ---
        const scSite = document.getElementById("sc-site") as HTMLInputElement | null;
        const scRobot = document.getElementById("sc-robot") as HTMLInputElement | null;
        const scRobotRow = document.getElementById("sc-robot-row") as HTMLElement | null;
        const scRobotWrap = document.getElementById("sc-robot-wrap") as HTMLElement | null;
        const scState = document.getElementById("sc-state") as HTMLSpanElement | null;
        const scRes = document.getElementById("sc-res") as HTMLParagraphElement | null;
        const scSave = document.getElementById("sc-save") as HTMLButtonElement | null;
        const scErr = document.getElementById("sc-err") as HTMLSpanElement | null;
        const scTest = document.getElementById("sc-test") as HTMLButtonElement | null;
        const scCopy = document.getElementById("sc-copy") as HTMLButtonElement | null;

        // --- Newsletter : quota mensile incluso ---
        const nlQuota = document.getElementById("nl-quota") as HTMLInputElement | null;
        const nlSave = document.getElementById("nl-save") as HTMLButtonElement | null;
        const nlErr = document.getElementById("nl-err") as HTMLSpanElement | null;

        nlSave?.addEventListener("click", async () => {
          if (!nlErr) return;
          nlErr.textContent = "";
          const n = Math.floor(Number(nlQuota?.value));
          if (!Number.isFinite(n) || n < 0) { nlErr.textContent = tr("itg.nl.invalid"); return; }
          nlSave.disabled = true;
          try {
            const res = await fetch("/api/admin/integrations", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ newsletter_quota: n }),
            });
            const j = await res.json();
            if (!res.ok) { nlErr.textContent = j.error ?? tr("common.saveErr"); return; }
            toast(tr("itg.nl.saved"));
          } catch {
            nlErr.textContent = tr("common.netErr");
          } finally {
            nlSave.disabled = false;
          }
        });

        scCopy?.addEventListener("click", async () => {
          if (!scRobot?.value) return;
          try { await navigator.clipboard.writeText(scRobot.value); toast(tr("itg.sc.emailCopied")); }
          catch { scRobot.select(); }
        });

        scSave?.addEventListener("click", async () => {
          if (!scErr) return;
          scErr.textContent = "";
          scSave.disabled = true;
          try {
            const res = await fetch("/api/admin/integrations", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ gsc_site: scSite?.value.trim() ?? "" }),
            });
            const j = await res.json();
            if (!res.ok) { scErr.textContent = j.error ?? tr("common.saveErr"); return; }
            toast(tr("itg.sc.saved"));
          } catch {
            scErr.textContent = tr("common.netErr");
          } finally {
            scSave.disabled = false;
          }
        });

        scTest?.addEventListener("click", async () => {
          const site = scSite?.value.trim() ?? "";
          if (!site) { if (scRes) scRes.textContent = tr("itg.sc.needSite"); return; }
          scTest.disabled = true;
          if (scRes) scRes.textContent = tr("common.verifying");
          try {
            // ⚠️ PROVA e basta. Prima questo bottone SALVAVA `gsc_site` di
            // nascosto — era l'unico modo di far leggere il sito all'API — e
            // poi interrogava: una prova andata male lasciava registrata la
            // proprieta' sbagliata, senza che nessuno l'avesse chiesto.
            // Adesso la proprieta' viaggia nell'indirizzo e non si scrive
            // niente; a salvare ci pensa «Enregistrer», che e' li' accanto.
            const res = await fetch(`/api/admin/search-console?site=${encodeURIComponent(site)}`, { headers });
            const j = await res.json();
            if (!res.ok) { if (scRes) scRes.textContent = j.error ?? tr("common.netErr"); return; }
            if (j.error) { if (scRes) scRes.textContent = j.error; return; }
            if (!j.configured) { if (scRes) scRes.textContent = tr("itg.sc.notFound"); return; }
            // ⚠️ Qui NON si ricarica la scheda: rileggerebbe il valore
            // SALVATO e riscriverebbe il campo, cancellando la proprieta'
            // appena provata.
            if (scRes) scRes.textContent = `OK ✓ ${j.clicks} ${tr("itg.sc.okStats").replace("{imp}", String(j.impressions ?? 0))} ${tr("itg.sc.okNotSaved")}`;
          } catch {
            if (scRes) scRes.textContent = tr("common.netErr");
          } finally {
            scTest.disabled = false;
          }
        });


        void itgCarica();

        // ---------- Users (accessi all'admin) ----------
        const usList = document.getElementById("us-list") as HTMLDivElement | null;
        const usEmail = document.getElementById("us-email") as HTMLInputElement | null;
        const usPass = document.getElementById("us-pass") as HTMLInputElement | null;
        const usAdd = document.getElementById("us-add") as HTMLButtonElement | null;
        const usFname = document.getElementById("us-fname") as HTMLInputElement | null;
        const usLname = document.getElementById("us-lname") as HTMLInputElement | null;
        const usOverlay = document.getElementById("us-overlay") as HTMLDivElement | null;
        const usOpen = document.getElementById("us-open") as HTMLButtonElement | null;
        const usErr = document.getElementById("us-err") as HTMLSpanElement | null;
        const usRoles = document.getElementById("us-roles") as HTMLDivElement | null;
        const usRoleHint = document.getElementById("us-role-hint") as HTMLParagraphElement | null;
        const RUOLO_TESTO: Record<string, string> = {
          super: tr("role.super.desc"),
          admin: tr("role.admin.desc"),
          user: tr("role.user.desc"),
        };
        function usRuoloSel(): string {
          return (usRoles?.querySelector(".us-role.is-on") as HTMLElement | null)?.dataset.role ?? "admin";
        }
        // ---- Pagine permesse (solo ruolo "user") ------------------------
        // La stessa forma dei bottoni del ruolo: non si inventa un controllo
        // nuovo per una cosa che e' ancora «scegli fra queste voci».
        const usPagineBox = document.getElementById("us-pagine-box") as HTMLElement | null;
        const usPagine = document.getElementById("us-pagine") as HTMLElement | null;
        function usDisegnaPagine(scelte: string[] | null) {
          if (!usPagine) return;
          // `null` = mai deciso → si mostra spuntato il default storico, cosi'
          // chi apre il modale vede quello che quell'utente vede DAVVERO.
          const attive = new Set(scelte ?? PAGINE_ADMIN.filter((pg) => !SOLO_ADMIN.includes(pg.key)).map((pg) => pg.key));
          // ⚠️ `SUP` e non `L`, e un escape locale: `L` ed `esc` sono
          // dichiarati PIU' SOTTO in questo stesso script, e una `const` non
          // esiste prima della sua riga. Usarli qui non darebbe un errore di
          // compilazione: darebbe un ReferenceError all'apertura del modale,
          // cioe' un modale che non si apre piu' e nessuno sa perche'.
          const escP = (v: unknown) =>
            String(v).replace(/[&<>"']/g, (c) => (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }) as Record<string, string>)[c]);
          usPagine.innerHTML = PAGINE_ADMIN.map((pg) =>
            `<button type="button" class="us-role${attive.has(pg.key) ? " is-on" : ""}" data-pagina="${pg.key}">${escP(SUP.pageLabels?.[pg.key] ?? pg.label)}</button>`
          ).join("");
        }
        usPagine?.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest("[data-pagina]") as HTMLButtonElement | null;
          if (b) b.classList.toggle("is-on");
        });
        function usPagineScelte(): string[] {
          return [...(usPagine?.querySelectorAll<HTMLElement>("[data-pagina].is-on") ?? [])]
            .map((b) => b.dataset.pagina ?? "");
        }

        function usSetRuolo(r: string) {
          usRoles?.querySelectorAll<HTMLElement>(".us-role").forEach((b) =>
            b.classList.toggle("is-on", b.dataset.role === r)
          );
          if (usRoleHint) usRoleHint.textContent = RUOLO_TESTO[r] ?? "";
          if (usPagineBox) usPagineBox.hidden = r !== "user";
        }
        usRoles?.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".us-role") as HTMLButtonElement | null;
          if (!b || b.disabled) return;
          usSetRuolo(b.dataset.role ?? "admin");
        });
        const usGen = document.getElementById("us-gen") as HTMLButtonElement | null;
        const usMsg = document.getElementById("us-msg") as HTMLParagraphElement | null;
        const ICO_TRASH =
          '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /></svg>';
        const ICO_PEN = "\u270E";
        const ICO_KEY =
          '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5" /><line x1="10.7" y1="12.3" x2="21" y2="2" /><line x1="18" y1="5" x2="20.5" y2="7.5" /><line x1="15" y1="8" x2="17.5" y2="10.5" /></svg>';
        let usDelPending: string | null = null;
        let usDelTimer: number | undefined;
        let usEditId: string | null = null;
        let usCache: { id: string; first_name?: string; last_name?: string; email: string; role?: string; is_moodd?: boolean; location_id?: string | null }[] = [];

        // ---- Sede dell'utente (multi-sede) ----
        // L'elenco arriva dalla stessa API delle Sedi, gia' caricata da questo
        // pannello: nessuna chiamata in piu'.
        const usSedeBox = document.getElementById("us-sede-box") as HTMLElement | null;
        const usSedeHint = document.getElementById("us-sede-hint") as HTMLElement | null;
        const usSedeSel = document.getElementById("us-sede") as HTMLSelectElement | null;
        function usRiempiSedi(scelta: string) {
          if (!usSedeBox || !usSedeSel) return;
          // Con meno di due sedi non c'e' niente da scegliere: il campo
          // «a quale punto appartiene» non serve e si nasconde.
          const attivo = sedi.length > 1;
          usSedeBox.hidden = !attivo;
          if (usSedeHint) usSedeHint.hidden = !attivo;
          if (!attivo) return;
          usSedeSel.innerHTML =
            `<option value="">${esc(L.sedeTutte ?? "")}</option>` +
            sedi.map((s) => `<option value="${esc(s.id)}">${esc(s.name)}</option>`).join("");
          usSedeSel.value = scelta;
        }

        function usData(iso: string | null): string {
          if (!iso) return tr("us.never");
          const d = new Date(iso);
          return d.toLocaleDateString("fr-BE", { day: "2-digit", month: "2-digit", year: "2-digit" });
        }
        function usPwd(): string {
          const alf = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789";
          const a = new Uint32Array(14);
          crypto.getRandomValues(a);
          return Array.from(a, (n) => alf[n % alf.length]).join("");
        }
        async function usCarica() {
          if (!usList) return;
          try {
            const res = await fetch("/api/admin/users", { headers });
            if (!res.ok) { usList.innerHTML = `<p class="note">${tr("us.loadErr")}</p>`; return; }
            const j = (await res.json()) as {
              users: { id: string; nome?: string; first_name?: string; last_name?: string; email: string; created_at: string; last_sign_in_at: string | null; role?: string; is_moodd?: boolean; location_id?: string | null }[];
            };
            usCache = j.users ?? [];
            usList.innerHTML = (j.users ?? [])
              .map((u) => `
                <div class="us-row" data-uid="${u.id}">
                  <span class="us-cell nom">${[u.first_name, u.last_name].filter(Boolean).join(" ") || "—"}${u.is_moodd ? '<span class="us-tag">MOODD</span>' : u.role === "super" ? '<span class="us-tag">SUPER</span>' : u.role === "user" ? '<span class="us-tag role-user">USER</span>' : '<span class="us-tag role-admin">ADMIN</span>'}</span>
                  <span class="us-cell" title="${u.email}">${u.email}${
                    u.location_id ? `<span class="us-tag role-user">${esc(sedi.find((s) => s.id === u.location_id)?.name ?? "?")}</span>` : ""
                  }</span>
                  <span class="us-cell dim">${usData(u.created_at)}</span>
                  <span class="us-cell dim">${usData(u.last_sign_in_at)}</span>
                  <span class="us-acts">
                    <button type="button" class="i-btn" data-pass="${u.id}" title="${tr("us.newPassTitle")}">${ICO_KEY}</button>
                    <button type="button" class="i-btn i-edit" data-edit="${u.id}" title="${tr("common.edit")}">${ICO_PEN}</button>
                    ${u.is_moodd ? '<span class="i-slot"></span>' : `<button type="button" class="i-btn i-del" data-del="${u.id}" title="${tr("common.delete")}">${ICO_TRASH}</button>`}
                  </span>
                </div>`)
              .join("");
          } catch {
            usList.innerHTML = `<p class="note">${tr("common.netErr")}</p>`;
          }
        }

        usGen?.addEventListener("click", () => {
          if (usPass) usPass.value = usPwd();
        });

        function usApri(u?: { id: string; first_name?: string; last_name?: string; email: string; role?: string; is_moodd?: boolean; location_id?: string | null; pages?: string[] | null }) {
          usEditId = u?.id ?? null;
          if (usErr) usErr.textContent = "";
          if (usFname) usFname.value = u?.first_name ?? "";
          if (usLname) usLname.value = u?.last_name ?? "";
          if (usEmail) usEmail.value = u?.email ?? "";
          if (usPass) usPass.value = u ? "" : usPwd(); // in modifica: vuoto = invariata
          const titre = document.getElementById("us-titre");
          const hint = document.getElementById("us-hint");
          const passLab = document.getElementById("us-pass-lab");
          if (titre) titre.textContent = u ? tr("us.editTitle") : tr("us.new");
          if (hint) hint.textContent = u ? tr("us.editHint") : tr("us.newHint");
          if (passLab) passLab.textContent = u ? tr("us.passOpt") : tr("us.pass");
          usSetRuolo(u?.role ?? "admin");
          // Prima di usSetRuolo il blocco e' nascosto: si disegna comunque,
          // cosi' se poi si passa a «utente» le caselle sono gia' quelle sue.
          usDisegnaPagine(u?.pages ?? null);
          usRiempiSedi(u?.location_id ?? "");
          usRoles?.querySelectorAll<HTMLButtonElement>(".us-role").forEach((b) => {
            b.disabled = u?.is_moodd === true; // l'accès MOODD reste super
          });
          if (usAdd) usAdd.textContent = u ? tr("common.save") : tr("us.createBtn");
          if (usOverlay) usOverlay.hidden = false;
          usFname?.focus();
        }
        usOpen?.addEventListener("click", () => usApri());
        // Chiusura: le ancore del guscio condiviso (sfondo, ×, Annulla).
        usOverlay?.querySelectorAll("[data-md-close]").forEach((el) => {
          el.addEventListener("click", () => { if (usOverlay) usOverlay.hidden = true; });
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") if (usOverlay) usOverlay.hidden = true;
        });

        usAdd?.addEventListener("click", async () => {
          if (!usEmail || !usPass || !usMsg || !usErr) return;
          usErr.textContent = "";
          const email = usEmail.value.trim();
          const password = usPass.value;
          if (!email) { usErr.textContent = tr("us.emailReq"); return; }
          if (password && password.length < 8) {
            usErr.textContent = tr(usEditId ? "us.pass8opt" : "us.pass8");
            return;
          }
          usAdd.disabled = true;
          try {
            const corpo: Record<string, unknown> = {
              email,
              first_name: usFname?.value.trim() ?? "",
              last_name: usLname?.value.trim() ?? "",
            };
            corpo.role = usRuoloSel();
            // Solo per «utente»: per gli altri l'API le ignora comunque, ma
            // mandarle darebbe l'idea che contino.
            if (corpo.role === "user") corpo.pages = usPagineScelte();
            // Si manda solo se il campo esiste: su un cliente a sede unica
            // non deve arrivare all'API nemmeno come stringa vuota.
            if (usSedeBox && !usSedeBox.hidden) corpo.location_id = usSedeSel?.value ?? "";
            if (usEditId) corpo.id = usEditId;
            if (password) corpo.password = password;
            const res = await fetch("/api/admin/users", {
              method: usEditId ? "PUT" : "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify(corpo),
            });
            const j = await res.json();
            if (!res.ok) { usErr.textContent = j.error ?? tr("common.saveErr"); return; }
            if (usOverlay) usOverlay.hidden = true;
            usMsg.textContent = password
              ? `${usEditId ? tr("us.modified") : tr("us.created")} — ${tr("us.passLabel")} : ${password}`
              : (usEditId ? tr("us.userModifiedDot") : tr("us.invited"));
            await usCarica();
            toast(usEditId ? tr("us.userModified") : tr("us.created"));
          } catch {
            usErr.textContent = tr("common.netErr");
          } finally {
            usAdd.disabled = false;
          }
        });

        usList?.addEventListener("click", async (e) => {
          const t = e.target as HTMLElement;

          const pass = t.closest("[data-pass]") as HTMLElement | null;
          if (pass) {
            const id = pass.dataset.pass as string;
            const nuova = usPwd();
            try {
              const res = await fetch("/api/admin/users", {
                method: "PUT",
                headers: { ...headers, "Content-Type": "application/json" },
                body: JSON.stringify({ id, password: nuova }),
              });
              const j = await res.json();
              if (!res.ok) { toast(j.error ?? tr("us.editErr"), true); return; }
              try {
                await navigator.clipboard.writeText(nuova);
                toast(tr("us.newPassCopied"));
              } catch {
                toast(tr("us.passChanged"));
              }
              if (usMsg) usMsg.textContent = `${tr("us.newPassLabel")} : ${nuova}`;
            } catch { toast(tr("common.netErr"), true); }
            return;
          }

          const edit = t.closest("[data-edit]") as HTMLElement | null;
          if (edit) {
            const u = usCache.find((x) => x.id === edit.dataset.edit);
            if (u) usApri(u);
            return;
          }

          const del = t.closest("[data-del]") as HTMLElement | null;
          if (del) {
            const id = del.dataset.del as string;
            if (usDelPending === id) {
              window.clearTimeout(usDelTimer);
              usDelPending = null;
              await conAttesa(del, async () => {
                try {
                  const res = await fetch(`/api/admin/users?id=${id}`, {
                    method: "POST",
                    headers: { ...headers, "X-Method-Override": "DELETE" },
                  });
                  const j = await res.json();
                  if (!res.ok) { toast(j.error ?? tr("us.delErr"), true); return; }
                  toast(tr("us.deleted"));
                  await usCarica();
                } catch { toast(tr("common.netErr"), true); }
              });
              return;
            }
            usDelPending = id;
            del.classList.add("confirm");
            del.textContent = tr("common.confirm");
            window.clearTimeout(usDelTimer);
            usDelTimer = window.setTimeout(() => {
              usDelPending = null;
              del.classList.remove("confirm");
              del.innerHTML = ICO_TRASH;
            }, 3000);
          }
        });

        temaResetEl.addEventListener("click", () => {
          tema = {};
          renderTema();
          applicaTema();
          salvaTema();
        });

        try {
          const res = await fetch("/api/admin/pages", { headers });
          if (!res.ok) throw new Error();
          const dati = (await res.json()) as {
            hidden: string[];
            hiddenTabs?: string[];
            features?: string[];
            theme?: Record<string, string>;
            publicLangs?: string[];
            publicLangDefault?: string;
            pwaBrand?: string;
            appIcon?: string | null;
          };
          nascoste = dati.hidden ?? [];
          nascosteTab = dati.hiddenTabs ?? [];
          funzioni = dati.features ?? [];
          tema = dati.theme ?? {};
          publicLangs = Array.isArray(dati.publicLangs) && dati.publicLangs.length ? dati.publicLangs : ["fr", "en"];
          publicDefault = dati.publicLangDefault && publicLangs.includes(dati.publicLangDefault) ? dati.publicLangDefault : publicLangs[0];
          pwaBrand = dati.pwaBrand === "client" ? "client" : "restohub";
          pwaIcona = Boolean(dati.appIcon);
          stateEl.style.display = "none";
          rowsEl.style.display = "grid";
          featRowsEl.style.display = "grid";
          temaRowsEl.style.display = "grid";
          temaResetEl.style.display = "inline-block";
          if (publangEl) publangEl.style.display = "grid";
          render();
          renderFunzioni();
          renderPublang();
          renderTema();
          renderPwa();
          applicaTema();
        } catch {
          stateEl.textContent = SUP.loadError ?? "Erreur de chargement.";
        }

        // ============================================================
        // ÉTABLISSEMENTS (multi-sede)
        // ------------------------------------------------------------
        // Le chiavi Stripe si SCRIVONO e non si rileggono: l'API rende solo
        // un booleano «c'e' / non c'e'», e qui si mostra una pastiglia. Per
        // sostituirne una si incolla la nuova; per toglierla si salva vuoto.
        // ============================================================
        const L = SUP.loc ?? {};
        const locList = document.getElementById("loc-list") as HTMLDivElement;
        const locState = document.getElementById("loc-state") as HTMLParagraphElement;
        const locOverlay = document.getElementById("loc-overlay") as HTMLDivElement;
        const locTitle = document.getElementById("loc-title") as HTMLHeadingElement;
        const locErr = document.getElementById("loc-err") as HTMLSpanElement;
        const locSave = document.getElementById("loc-save") as HTMLButtonElement;
        const LOC_MATITA = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>';
        const LOC_CESTINO = '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>';

        interface Sede {
          id: string; name: string; slug: string;
          image_url: string | null;
          sort_order: number; active: boolean;
        }
        let sedi: Sede[] = [];
        let segreti: Record<string, Record<string, boolean>> = {};
        // Place ID per sede: non e' un segreto, si rilegge e si mostra.
        let placeIds: Record<string, string> = {};
        let reviewUrls: Record<string, string> = {};
        let stampanti: Record<string, { printer_id: string; auto: boolean; dest?: { nome: string; cat: string[]; printer: string }[] }> = {};
        /** L'elenco vero delle stampanti, chiesto UNA volta al server. Il
         *  browser non vede mai le chiavi del servizio di stampa. */
        let elencoStampanti: { id: number; nome: string; stato: string; station: string }[] = [];
        let stampantiChieste = false;
        let erroreStampanti = "";
        /** ⚠️ Separato da `stampantiChieste`, e non si azzera mai. Il
         *  riepilogo ridisegna quando l'elenco arriva; se il tentativo
         *  fallisse e questo tornasse falso, ogni ridisegno rifarebbe la
         *  domanda e il ridisegno — una rotella infinita di chiamate di rete
         *  su un pannello aperto tutto il giorno. */
        let stampantiTentate = false;
        /** Le categorie del menu, per le tendine delle destinazioni. Chieste
         *  una volta sola, alla prima scheda aperta. */
        let categorieMenu: string[] = [];
        let categorieChieste = false;
        /** ⚠️ Separato dall'elenco vuoto, come per le stampanti: «il menu non
         *  ha categorie» e «la lista non e' arrivata» portano a cercare il
         *  guasto in due posti diversi, e le caselle mancano uguale. */
        let erroreCategorie = "";
        // Titolo della scheda Google collegata a ogni sede, e se il .env ha
        // un ripiego per ciascun segreto (solo se c'e', mai il valore).
        let schedeGoogle: Record<string, string> = {};
        let ripiego: Record<string, boolean> = {};
        /** Le chiavi che ogni sede ha scritto DI SUO: il resto e' ereditato dal
         *  marchio, e per la scheda Google ereditare vuol dire sbagliata. */
        let propri: Record<string, string[]> = {};
        let sedeAperta: Sede | null = null;
        let locImgUrl: string | null = null;

        /** Iniziali della sede: ripiego quando non c'e' una foto. Due lettere
         *  bastano a distinguere Jourdan da Stockel in un elenco. */
        const iniziali = (nome: string) =>
          nome.trim().split(/\s+/).slice(0, 2).map((w) => w[0] ?? "").join("").toUpperCase() || "?";

        /** Pastiglia della sede nelle schede: foto se c'e', iniziali se no.
         *  Nel modale invece si usa il campo foto di casa (.f-img-prev), che
         *  mostra l'icona «immagine»: li' si sta scegliendo un file, qui si
         *  sta riconoscendo una sede. */
        function avatar(s: { name: string; image_url?: string | null }): string {
          return s.image_url
            ? `<span class="sede-avatar"><img src="${esc(s.image_url)}" alt="" loading="lazy" /></span>`
            : `<span class="sede-avatar">${esc(iniziali(s.name))}</span>`;
        }

        const esc = (s: unknown) =>
          String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

        /** Una riga di stato: pallino, etichetta corta, valore.
         *  `liv` e' il colore del pallino, e dice quanto conta. */
        function riga(etichetta: string, liv: "ok" | "no" | "ko", valore: string): string {
          return `<li class="is-${liv}"><span class="loc-st-k">${esc(etichetta)}</span>` +
            `<span class="loc-st-v">${esc(valore)}</span></li>`;
        }

        /** Un segreto della sede ha TRE stati, non due.
         *
         *  ⚠️ «vuoto» non voleva dire niente. Una sede senza chiave Stripe
         *  incassa con quella del .env — funziona, ed e' giusto per un
         *  ristorante solo. Ma in un gruppo di tre societa' vuol dire che i
         *  soldi di quel punto arrivano sul conto di un altro, e il pannello
         *  lo diceva con la stessa pastiglia grigia di «non serve». */
        function statoSegreto(idSede: string, chiave: string): [("ok" | "no" | "ko"), string] {
          if (segreti[idSede]?.[chiave] === true) return ["ok", String(L.secretSet ?? "")];
          if (ripiego[chiave] === true) return ["no", String(L.stDaEnv ?? "")];
          return ["ko", String(L.stManca ?? "")];
        }

        /** Un dato Google della sede. Verde SOLO se e' suo: un valore
         *  ereditato dal marchio e' l'attivita' di qualcun altro. */
        function statoGoogle(idSede: string, chiave: string, valore: string, vuoto: string): [("ok" | "no"), string] {
          if (!valore) return ["no", vuoto];
          if (!(propri[idSede] ?? []).includes(chiave)) return ["no", String(L.stDaMarchio ?? "")];
          return ["ok", valore];
        }

        /** La stampante di QUESTO punto, per il riepilogo.
         *
         *  ⚠️ TRE stati, non due. «Configurata» e «configurata ma spenta» sono
         *  due situazioni diverse, e la seconda e' quella che inganna: il
         *  numero c'e', la scheda sembra a posto, e in cucina non esce niente.
         *  Verde solo quando la stampa parte davvero — e' la stessa coppia di
         *  condizioni di `stampaAttiva` lato server, vista da qui. */
        function statoStampante(idSede: string): [("ok" | "no" | "ko"), string] {
          const st = stampanti[idSede];
          const num = String(st?.printer_id ?? "").trim();
          if (!num) return ["ko", String(L.stManca ?? "")];
          // Il nome, se l'elenco e' arrivato; se no il numero, che e' sempre
          // meglio di «configurata» — dice QUALE.
          const nome = elencoStampanti.find((p) => String(p.id) === num)?.nome || `#${num}`;
          if (!st?.auto) return ["no", `${nome} · ${String(L.printPaused ?? "")}`];
          return ["ok", nome];
        }

        function locRender() {
          if (sedi.length === 0) {
            locState.style.display = "";
            locState.textContent = L.empty ?? "";
            locList.innerHTML = "";
            return;
          }
          locState.style.display = "none";
          // I nomi delle stampanti arrivano dopo: si chiede una volta e si
          // ridisegna. Fino ad allora il riepilogo mostra il numero, che e'
          // comunque meglio di «configurata» — dice QUALE.
          if (!stampantiTentate) {
            stampantiTentate = true;
            void chiediStampanti().then(() => locRender());
          }
          locList.innerHTML = sedi.map((s) => `
            <div class="loc-card${s.active ? "" : " is-off"}" data-id="${esc(s.id)}">
              <div class="loc-head">
                ${avatar(s)}
                <span class="loc-ident">
                  <span class="loc-nome">${esc(s.name)}</span>
                  <span class="loc-slug">/${esc(s.slug)}</span>
                </span>
              </div>
              <ul class="loc-stato">
                ${riga("Stripe", ...statoSegreto(s.id, "stripe_secret_key"))}
                ${riga("Webhook", ...statoSegreto(s.id, "stripe_webhook_secret"))}
                ${riga("Google Business", ...statoGoogle(s.id, "google_location_title", schedeGoogle[s.id] ?? "", String(L.stNonColl ?? "")))}
                ${riga("Place ID", ...statoGoogle(s.id, "google_place_id", placeIds[s.id] ? String(L.stConf ?? "") : "", String(L.stManca ?? "")))}
                ${riga(L.reviewShort ?? "", ...statoGoogle(s.id, "link_google_review", reviewUrls[s.id] ? String(L.stConf ?? "") : "", String(L.stManca ?? "")))}
                ${riga(L.printShort ?? "", ...statoStampante(s.id))}
              </ul>
              <div class="loc-actions">
                <span class="sw-wrap">
                  <label class="switch"><input type="checkbox" class="loc-att"${s.active ? " checked" : ""} /><span class="track"></span></label>
                  <span class="sw-lab">${esc(L.active)}</span>
                </span>
                <span class="loc-spacer"></span>
                <button type="button" class="ibtn loc-edit" title="${esc(L.edit)}" aria-label="${esc(L.edit)}">${LOC_MATITA}</button>
                <button type="button" class="ibtn ibtn-danger loc-del" title="${esc(L.del)}" aria-label="${esc(L.del)}">${LOC_CESTINO}</button>
              </div>
            </div>`).join("");
        }

        /**
         * RICARICA LA PAGINA dopo aver cambiato l'ELENCO delle sedi.
         *
         * ⚠️ Non e' pigrizia: creare, eliminare, attivare o disattivare una
         * sede cambia l'AMBITO di tutta l'applicazione, e tre cose nascono
         * lato server e non si aggiornano da sole —
         *  1. il selettore delle sedi nell'header (compare, sparisce, o
         *     cambia nome e logo);
         *  2. i dati pre-caricati della pagina, calcolati con l'ambito di
         *     prima;
         *  3. il poller degli ordini della barra, che tiene un elenco di id
         *     «gia' visti» costruito con l'ambito di prima: cambiando il
         *     filtro, ordini mai visti ricompaiono e suonano come nuovi.
         *
         * Il ritardo serve a far leggere il toast: senza, il messaggio
         * sparisce prima di essere letto e l'operazione sembra non aver
         * fatto niente.
         */
        function ricaricaPagina() {
          setTimeout(() => location.reload(), 1400);
        }

        async function locCarica() {
          try {
            const res = await fetch("/api/admin/locations", { headers });
            if (!res.ok) throw new Error();
            const j = await res.json();
            sedi = (j.locations ?? []) as Sede[];
            segreti = j.secrets ?? {};
            // ⚠️ Si dice PRIMA, non dopo il salvataggio: quando l'avviso
            // servirebbe davvero, la chiave e' gia' stata incollata.
            const av = document.getElementById("loc-cifra") as HTMLElement | null;
            if (av) av.hidden = j.cifratura !== false;
            placeIds = j.placeIds ?? {};
            reviewUrls = j.reviewUrls ?? {};
            stampanti = j.stampanti ?? {};
            schedeGoogle = j.google ?? {};
            ripiego = j.ambiente ?? {};
            propri = j.propri ?? {};
            storicoOrfano = j.storico ?? {};
            locRender();
            // La scheda Google: solo adesso si sa se ci sono sedi, e quindi se
            // la scelta va nel modale del punto o qui in Intégrations.
            void gCaricaSedeStato();
            stRenderAvviso();
          } catch {
            locState.style.display = "";
            locState.textContent = SUP.loadError ?? "";
          }
        }

        const campo = (id: string) => document.getElementById(id) as HTMLInputElement;

        function locApri(s: Sede | null) {
          sedeAperta = s;
          slugAMano = !!s; // su una sede esistente lo slug non si muove da solo
          locErr.textContent = "";
          locTitle.textContent = (s ? L.edit : L.neu) ?? "";
          campo("loc-name").value = s?.name ?? "";
          campo("loc-slug").value = s?.slug ?? "";
          mostraUrl();
          locImgUrl = s?.image_url ?? null;
          disegnaFoto();
          (document.getElementById("loc-img-state") as HTMLSpanElement).textContent = "";
          campo("loc-order").value = String(s?.sort_order ?? sedi.length + 1);
          campo("loc-active").checked = s ? s.active : true;
          // I campi segreti partono SEMPRE vuoti: non c'e' niente da
          // riproporre, e un campo vuoto che non salva nulla e' meno
          // pericoloso di un finto valore che qualcuno cancella per sbaglio.
          campo("loc-stripe").value = "";
          campo("loc-hook").value = "";
          const st = document.getElementById("loc-stripe-stato") as HTMLSpanElement;
          const hk = document.getElementById("loc-hook-stato") as HTMLSpanElement;
          const dato = (k: string) => (s && segreti[s.id]?.[k] === true);
          // ⚠️ Pallini nel SEGNAPOSTO, non nel valore. Il segreto non si
          // rilegge da nessuna parte: mettere dei finti caratteri nel campo
          // vorrebbe dire rispedirli al salvataggio e sostituire la chiave
          // vera con dei pallini. Cosi' invece il campo resta vuoto — cioe'
          // «non cambiare niente» — e si vede lo stesso che una chiave c'e'.
          const segna = (el: HTMLInputElement, c: boolean, vuoto: string) => {
            el.placeholder = c ? (L.secretSetPh ?? "") : vuoto;
          };
          const cStripe = !!dato("stripe_secret_key");
          const cHook = !!dato("stripe_webhook_secret");
          st.textContent = String((cStripe ? L.secretSet : L.secretNone) ?? "");
          st.classList.toggle("is-set", cStripe);
          hk.textContent = String((cHook ? L.secretSet : L.secretNone) ?? "");
          hk.classList.toggle("is-set", cHook);
          segna(campo("loc-stripe"), cStripe, String(L.secretPh ?? ""));
          segna(campo("loc-hook"), cHook, "whsec_…");
          campo("loc-place").value = s ? (placeIds[s.id] ?? "") : "";
          campo("loc-greview").value = s ? (reviewUrls[s.id] ?? "") : "";
          (document.getElementById("loc-place-res") as HTMLElement).textContent = L.placeHint ?? "";
          void riempiStampanti(s ? (stampanti[s.id]?.printer_id ?? "") : "").then(async () => {
            await chiediCategorie();
            disegnaDest(s ? (stampanti[s.id]?.dest ?? []) : []);
          });
          (document.getElementById("loc-print-auto") as HTMLInputElement).checked = s ? Boolean(stampanti[s.id]?.auto) : false;
          (document.getElementById("loc-print-res") as HTMLElement).textContent = String(L.printerHint ?? "");
          void gSedeStato();
          locOverlay.hidden = false;
        }

        // ---- LE STAMPANTI ---------------------------------------------------
        // ⚠️ L'elenco lo chiede il SERVER al servizio di stampa: le chiavi
        // stanno nell'ambiente del cliente e non devono MAI arrivare qui. Si
        // chiede una volta sola, alla prima scheda aperta.
        /** Chiede l'elenco al server UNA volta sola. Separata da chi riempie
         *  la tendina perche' serve anche al RIEPILOGO, che deve poter
         *  scrivere il nome della stampante invece del suo numero. */
        async function chiediStampanti(): Promise<void> {
          if (stampantiChieste) return;
          stampantiChieste = true;
          try {
            const r = await fetch("/api/admin/printers", { headers });
            const j = await r.json();
            elencoStampanti = Array.isArray(j?.stampanti) ? j.stampanti : [];
            // ⚠️ Un elenco vuoto perche' il servizio non risponde e uno vuoto
            // perche' non c'e' nessuna stampante NON sono la stessa cosa: si
            // cercherebbe il guasto dalla parte sbagliata.
            erroreStampanti = String(j?.errore ?? "");
          } catch {
            stampantiChieste = false;
            erroreStampanti = String(L.netErr ?? "");
          }
        }

        async function riempiStampanti(scelta: string, idSel = "loc-printer", idRes = "loc-print-res"): Promise<void> {
          const sel = document.getElementById(idSel) as HTMLSelectElement | null;
          const res = document.getElementById(idRes) as HTMLElement | null;
          if (!sel || !res) return;
          await chiediStampanti();
          if (erroreStampanti) res.textContent = erroreStampanti;
          sel.innerHTML =
            `<option value="">${escG(L.printOff ?? "")}</option>` +
            elencoStampanti.map((p) => {
              const dove = p.station ? ` · ${escG(p.station)}` : "";
              const stato = p.stato && p.stato !== "online" ? ` (${escG(p.stato)})` : "";
              return `<option value="${p.id}">${escG(p.nome)}${dove}${stato}</option>`;
            }).join("");
          // ⚠️ Una stampante salvata che non compare piu' nell'elenco NON deve
          // sparire in silenzio: resterebbe scritta nel database mentre la
          // scheda mostra «nessuna», e si salverebbe il vuoto senza accorgersene.
          if (scelta && !elencoStampanti.some((p) => String(p.id) === scelta)) {
            sel.insertAdjacentHTML("beforeend", `<option value="${escG(scelta)}">#${escG(scelta)} — ?</option>`);
          }
          sel.value = scelta;
          if (!elencoStampanti.length && !res.textContent) res.textContent = String(L.printNone ?? "");
        }

        // ---- LE DESTINAZIONI (piu' stampanti) -------------------------------
        /** ⚠️ Le stesse funzioni servono DUE pannelli: la scheda della sede e
         *  Intégrations (l'installazione, dove i clienti a sede unica
         *  configurano la stampa). Per questo prendono il contenitore invece
         *  di cercarlo per id: due copie del disegno divergerebbero, e si
         *  scoprirebbe sul cliente che ne usa una sola. */
        const destBox = (box?: HTMLElement) => box ?? (document.getElementById("loc-dest") as HTMLElement);

        /** Lo stato sta nel DOM: si rilegge invece di tenerne una copia a
         *  fianco. Due copie della stessa cosa divergono, e qui divergerebbero
         *  proprio mentre qualcuno sta scrivendo. */
        function raccogliDest(box?: HTMLElement): { nome: string; cat: string[]; printer: string }[] {
          return [...destBox(box).querySelectorAll(".dd-r")].map((r) => ({
            nome: (r.querySelector(".dd-nome") as HTMLInputElement).value.trim(),
            cat: [...r.querySelectorAll<HTMLInputElement>(".dd-c input:checked")].map((i) => i.value),
            printer: (r.querySelector(".dd-pr") as HTMLSelectElement).value,
          }));
        }

        function opzioniStampante(scelta: string): string {
          const vuoto = `<option value="">${escG(L.printOff ?? "")}</option>`;
          const righe = elencoStampanti.map((p) => {
            const dove = p.station ? ` · ${escG(p.station)}` : "";
            return `<option value="${p.id}"${String(p.id) === scelta ? " selected" : ""}>${escG(p.nome)}${dove}</option>`;
          }).join("");
          const sconosciuta = scelta && !elencoStampanti.some((p) => String(p.id) === scelta)
            ? `<option value="${escG(scelta)}" selected>#${escG(scelta)} — ?</option>` : "";
          return vuoto + righe + sconosciuta;
        }

        function disegnaDest(righe: { nome: string; cat: string[]; printer: string }[], box?: HTMLElement): void {
          destBox(box).innerHTML = righe.map((d) => {
            // ⚠️ Una categoria presa da un'altra riga non si puo' scegliere
            // qui: due righe sulla stessa categoria vogliono dire due comande,
            // cioe' due pizze. Si impedisce prima di salvare, non dopo.
            const altrove = new Set(righe.filter((x) => x !== d).flatMap((x) => x.cat));
            const casella = (c: string, orfana = false) => {
              const scelta = d.cat.includes(c);
              const presa = !scelta && altrove.has(c);
              return `<label class="dd-c${presa ? " is-presa" : ""}">
                <input type="checkbox" value="${escG(c)}"${scelta ? " checked" : ""}${presa ? " disabled" : ""} />
                <span>${escG(c)}${orfana ? " — ?" : ""}</span>
              </label>`;
            };
            const opzCat = categorieMenu.map((c) => casella(c)).join("");
            // ⚠️ Una categoria configurata che nel menu non esiste piu'
            // (rinominata, cancellata) resta visibile e marcata: se sparisse
            // in silenzio, il salvataggio successivo la butterebbe via e quei
            // piatti cambierebbero stampante senza che nessuno l'abbia deciso.
            const orfane = d.cat.filter((c) => !categorieMenu.includes(c)).map((c) => casella(c, true)).join("");
            // ⚠️ Una riga di destinazione senza caselle sembra un guasto del
            // pannello. Si dice se il menu non ha categorie o se l'elenco non
            // e' arrivato: sono due cose diverse e si riparano in due posti
            // diversi.
            const avviso = categorieMenu.length
              ? ""
              : `<span class="hint">${escG(erroreCategorie || L.catVuote || "")}</span>`;
            return `<div class="dd-r">
              <input class="dd-nome fld" type="text" maxlength="24" placeholder="${escG(L.destNome ?? "")}" value="${escG(d.nome)}" />
              <div class="dd-cat" role="group" aria-label="${escG(L.destCat ?? "")}">${avviso}${opzCat}${orfane}</div>
              <select class="dd-pr fld" aria-label="${escG(L.printer ?? "")}">${opzioniStampante(d.printer)}</select>
              <button type="button" class="ibtn dd-del" title="${escG(L.destDel ?? "")}" aria-label="${escG(L.destDel ?? "")}">${LOC_CESTINO}</button>
            </div>`;
          }).join("");
        }

        /** Le categorie del menu. Senza, le tendine sarebbero vuote e si
         *  salverebbero destinazioni senza categorie — cioe' righe che non
         *  stampano niente. */
        async function chiediCategorie(): Promise<void> {
          if (categorieChieste) return;
          categorieChieste = true;
          try {
            const r = await fetch("/api/admin/categories", { headers });
            const j = await r.json().catch(() => ({}));
            // ⚠️ L'ESITO SI GUARDA. Un 403 o un 500 lasciavano l'elenco vuoto
            // con il flag «gia' chieste» acceso: le caselle non comparivano
            // MAI PIU' fino al ricarico della pagina, e niente diceva perche'.
            // Il flag torna indietro apposta — qui non c'e' nessun ridisegno
            // automatico che possa farne una rotella di chiamate: si riprova
            // alla prossima scheda aperta.
            if (!r.ok) {
              categorieChieste = false;
              erroreCategorie = String(j?.error ?? L.netErr ?? "");
              return;
            }
            erroreCategorie = "";
            categorieMenu = (Array.isArray(j?.categories) ? j.categories : [])
              .map((c: { name?: unknown }) => String(c?.name ?? "").trim())
              .filter(Boolean);
          } catch {
            categorieChieste = false;
            erroreCategorie = String(L.netErr ?? "");
          }
        }

        function legaDest(idBox: string, idAdd: string): void {
          const box = document.getElementById(idBox) as HTMLElement | null;
          if (!box) return;
          box.addEventListener("click", (e) => {
            const b = (e.target as HTMLElement).closest(".dd-del");
            if (!b) return;
            const righe = raccogliDest(box);
            const i = [...box.querySelectorAll(".dd-r")].indexOf(b.closest(".dd-r") as Element);
            if (i >= 0) righe.splice(i, 1);
            disegnaDest(righe, box);
          });
          // Spuntare una categoria la toglie alle altre righe: si ridisegna.
          box.addEventListener("change", (e) => {
            if ((e.target as HTMLElement).closest(".dd-cat")) disegnaDest(raccogliDest(box), box);
          });
          document.getElementById(idAdd)?.addEventListener("click", () => {
            disegnaDest([...raccogliDest(box), { nome: "", cat: [], printer: "" }], box);
          });
        }
        legaDest("loc-dest", "loc-dest-add");
        legaDest("itg-dest", "itg-dest-add");

        function legaProva(idBtn: string, idSel: string, idRes: string, sedeDi: () => string): void {
          document.getElementById(idBtn)?.addEventListener("click", async () => {
          const sel = document.getElementById(idSel) as HTMLSelectElement;
          const res = document.getElementById(idRes) as HTMLElement;
          const printerId = Number(sel.value);
          if (!printerId) { res.textContent = String(L.printNone ?? ""); return; }
          res.textContent = "…";
          try {
            const r = await fetch("/api/admin/printers", {
              method: "POST", headers,
              // ⚠️ La sede e' quella APERTA nel modale, non quella scelta
              // nell'header: si sta provando la stampante di QUESTO punto.
              body: JSON.stringify({ printerId, location_id: sedeDi() }),
            });
            const j = await r.json().catch(() => ({}));
            // ⚠️ «Inviato», non «stampato»: la carta esce qualche secondo dopo,
            // o non esce affatto. Promettere la stampa qui vorrebbe dire far
            // credere che una stampante spenta abbia funzionato.
            // ⚠️ Si mostra anche l'INDIRIZZO spedito. Un lavoro «inviato» che
            // non stampa non lascia nessuna traccia da guardare: con
            // l'indirizzo sotto gli occhi si vede in un colpo se il tablet
            // puo' davvero aprirlo, o se e' un 127.0.0.1 che non uscira' mai.
            const dove = j?.url ? ` — ${String(j.url)}` : "";
            res.textContent = (r.ok && j?.ok
              ? String(L.printSent ?? "")
              : `${String(L.printKo ?? "")} ${String(j?.errore ?? "")}`.trim()) + dove;
          } catch {
            res.textContent = String(L.netErr ?? "");
          }
          });
        }
        legaProva("loc-print-test", "loc-printer", "loc-print-res", () => sedeAperta?.id ?? "");
        legaProva("itg-print-test", "itg-printer", "itg-print-res", () => "");

        // ---- LA STAMPA DELL'INSTALLAZIONE (Intégrations) --------------------
        // ⚠️ Esiste per i cinque clienti su sei che hanno un locale solo: la
        // scheda della sede non c'e' proprio, e senza questo non avrebbero
        // nessun posto dove configurare la stampante. Con piu' sedi resta il
        // livello di partenza, che ogni scheda sovrascrive.
        /** Il messaggio della scheda Impression di Intégrations: uno solo,
         *  quello accanto al bottone, cosi' non si cerca l'esito in due
         *  posti a seconda di cosa e' andato storto. */
        function itgMsgStampa(testo: string): void {
          const m = document.getElementById("itg-print-msg");
          if (m) m.textContent = testo;
        }

        async function caricaStampaInstallazione(): Promise<void> {
          if (!document.getElementById("itg-printer")) return;
          await chiediCategorie();
          try {
            const r = await fetch("/api/admin/printers", { headers });
            const j = await r.json().catch(() => ({}));
            // ⚠️ Senza questo controllo un errore si leggeva come «niente di
            // configurato»: tendina su «aucune», nessuna destinazione, come
            // se nessuno avesse mai salvato. E' lo stesso inganno del
            // salvataggio che si crede riuscito, dal lato della lettura.
            if (!r.ok) { itgMsgStampa(String(j?.error ?? L.netErr ?? "")); return; }
            const c = (j?.config ?? {}) as { printer_id?: string; auto?: boolean; dest?: { nome: string; cat: string[]; printer: string }[] };
            await riempiStampanti(String(c.printer_id ?? ""), "itg-printer", "itg-print-res");
            (document.getElementById("itg-print-auto") as HTMLInputElement).checked = Boolean(c.auto);
            disegnaDest(Array.isArray(c.dest) ? c.dest : [], document.getElementById("itg-dest") as HTMLElement);
          } catch { itgMsgStampa(String(L.netErr ?? "")); }
        }
        void caricaStampaInstallazione();

        document.getElementById("itg-print-save")?.addEventListener("click", async () => {
          itgMsgStampa("…");
          try {
            const r = await fetch("/api/admin/printers", {
              method: "PUT", headers,
              body: JSON.stringify({
                printer_id: (document.getElementById("itg-printer") as HTMLSelectElement).value,
                print_auto: (document.getElementById("itg-print-auto") as HTMLInputElement).checked,
                destinazioni: raccogliDest(document.getElementById("itg-dest") as HTMLElement),
              }),
            });
            const j = await r.json().catch(() => ({}));
            // ⚠️ L'esito si GUARDA. Il 05/10 una scrittura rifiutata passava
            // per salvata e la stampante spariva al riapri, senza un errore da
            // nessuna parte.
            itgMsgStampa(r.ok ? String(L.saved ?? "") : String(j?.error ?? L.netErr ?? ""));
          } catch {
            itgMsgStampa(String(L.netErr ?? ""));
          }
        });

        // ---- SCHEDA GOOGLE DI QUESTA SEDE -----------------------------------
        // ⚠️ La sede viaggia ESPLICITA (`?sede=`), non nel cookie dell'header:
        // qui si sta modificando il punto aperto nel modale, che puo' essere
        // diverso da quello selezionato in alto. Su una sede NUOVA (non ancora
        // salvata) non c'e' ancora un id a cui agganciare la scheda: si dice, e
        // si sceglie dopo il primo salvataggio.
        const gCur = document.getElementById("loc-g-cur") as HTMLElement;
        const gPick = document.getElementById("loc-g-pick") as HTMLButtonElement;
        const gList = document.getElementById("loc-g-list") as HTMLDivElement;
        const gUrl = (id: string | null) => "/api/admin/google/locations" + (id ? `?sede=${encodeURIComponent(id)}` : "");

        async function gSedeStato() {
          gList.innerHTML = "";
          gPick.style.display = "none";
          gCur.textContent = "";
          if (!sedeAperta) { gCur.textContent = L.gNuova ?? ""; return; }
          try {
            const res = await fetch(gUrl(sedeAperta.id), { headers });
            const j = await res.json();
            if (!j.connected) { gCur.textContent = L.gNonCollegato ?? ""; return; }
            gPick.style.display = "";
            // Il nome della scheda e basta: «Scheda attuale:» davanti era una
            // didascalia che ripeteva l'etichetta gia' scritta sopra.
            gCur.textContent = j.current?.title || (L.gNessuna ?? "");
          } catch {
            gCur.textContent = L.netErr ?? "";
          }
        }

        const placeTest = document.getElementById("loc-place-test") as HTMLButtonElement;
        const placeRes = document.getElementById("loc-place-res") as HTMLElement;
        placeTest.addEventListener("click", async () => {
          const id = campo("loc-place").value.trim();
          if (!id) { placeRes.textContent = L.placeVuoto ?? ""; return; }
          // Errore tipico: incollare la CHIAVE API invece del Place ID.
          if (/^AIza/.test(id)) { placeRes.textContent = L.placeChiave ?? ""; return; }
          placeTest.disabled = true;
          placeRes.textContent = SUP.loading ?? "";
          try {
            const res = await fetch(`/api/admin/google-place?place_id=${encodeURIComponent(id)}`, { headers });
            const j = await res.json();
            placeRes.textContent = res.ok
              ? `${j.name} — ${j.rating ?? "?"}/5 · ${j.reviews ?? 0}`
              : (j.error ?? L.netErr ?? "");
          } catch {
            placeRes.textContent = L.netErr ?? "";
          } finally {
            placeTest.disabled = false;
          }
        });

        gPick.addEventListener("click", async () => {
          if (!sedeAperta) return;
          gList.textContent = SUP.loading ?? "";
          try {
            const res = await fetch(gUrl(sedeAperta.id), { headers });
            const j = await res.json();
            if (j.error) { gList.textContent = String(j.error); return; }
            const schede = (j.sedi ?? []) as { path: string; title: string; address: string }[];
            const cur = j.current?.path ?? "";
            if (!schede.length) { gList.textContent = L.gVuoto ?? ""; return; }
            gList.innerHTML = schede
              .map((sd) => `<button type="button" class="us-ghost gscheda" data-path="${escG(sd.path)}" data-title="${escG(sd.title)}" style="display:block;width:100%;text-align:left;margin-bottom:0.4rem${sd.path === cur ? ";border-color:var(--c-accent)" : ""}">${escG(sd.title || sd.path)}${sd.address ? ` — <span class="note">${escG(sd.address)}</span>` : ""}</button>`)
              .join("");
          } catch {
            gList.textContent = L.netErr ?? "";
          }
        });

        gList.addEventListener("click", async (ev) => {
          const b = (ev.target as HTMLElement).closest(".gscheda") as HTMLElement | null;
          if (!b || !sedeAperta) return;
          try {
            const res = await fetch("/api/admin/google/locations", {
              method: "POST", headers,
              body: JSON.stringify({ path: b.dataset.path ?? "", title: b.dataset.title ?? "", sede: sedeAperta.id }),
            });
            const j = await res.json();
            if (!res.ok) { toast(j.error ?? L.netErr ?? "", true); return; }
            if (j.reviewError) toast(String(j.reviewError), true);
            else toast(L.gSalvata ?? "");
            await gSedeStato();
          } catch {
            toast(L.netErr ?? "", true);
          }
        });

        // Lo slug segue il nome mentre si scrive, e SOLO su una sede nuova:
        // su una che esiste gia' cambiarlo romperebbe i link del sito
        // pubblico, quindi lo tocca solo chi lo decide a mano.
        // Si smette di seguirlo appena qualcuno ci mette le mani.
        let slugAMano = false;
        const sluggifica = (s: string) =>
          s.normalize("NFD").replace(/[\u0300-\u036f]/g, "")   // via gli accenti
           .toLowerCase()
           .replace(/[^a-z0-9]+/g, "-")
           .replace(/^-+|-+$/g, "")
           .slice(0, 40);
        const locUrl = document.getElementById("loc-url") as HTMLSpanElement;
        function mostraUrl() {
          const s = campo("loc-slug").value.trim();
          locUrl.textContent = s ? `${SUP.sito ?? ""}/${s}` : "";
        }
        campo("loc-slug").addEventListener("input", () => { slugAMano = true; mostraUrl(); });
        campo("loc-name").addEventListener("input", () => {
          if (sedeAperta || slugAMano) return;
          campo("loc-slug").value = sluggifica(campo("loc-name").value);
          mostraUrl();
        });

        // ---- Foto della sede ----
        const locImgUp = document.getElementById("loc-img-up") as HTMLButtonElement;
        const locImgRm = document.getElementById("loc-img-rm") as HTMLButtonElement;
        const locImgFile = document.getElementById("loc-img-file") as HTMLInputElement;
        const locImgState = document.getElementById("loc-img-state") as HTMLSpanElement;
        const locPrev = document.getElementById("loc-prev") as HTMLSpanElement;

        const ICO_IMG =
          '<svg class="ph-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>';

        function disegnaFoto() {
          locPrev.innerHTML = locImgUrl ? `<img src="${esc(locImgUrl)}" alt="" />` : ICO_IMG;
          locImgRm.style.display = locImgUrl ? "" : "none";
        }

        // Libreria: stesso componente del modale piatto. La guardia sul
        // modale chiuso e' obbligatoria — l'evento e' globale, e senza di
        // essa una foto scelta altrove finirebbe qui.
        (document.getElementById("loc-img-lib") as HTMLButtonElement).addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent("imgpick:open"));
        });
        window.addEventListener("imgpick:pick", (e) => {
          if (locOverlay.hidden) return;
          locImgUrl = (e as CustomEvent<{ url: string }>).detail.url;
          disegnaFoto();
          locImgState.textContent = "";
        });

        locImgUp.addEventListener("click", () => locImgFile.click());
        locImgRm.addEventListener("click", () => {
          // Toglie solo il collegamento: il file resta nello storage, e
          // cancellarlo qui vorrebbe dire perderlo anche se si annulla.
          locImgUrl = null;
          disegnaFoto();
        });
        locImgFile.addEventListener("change", () => conAttesa(locImgUp, async () => {
          const file = locImgFile.files?.[0];
          locImgFile.value = "";
          if (!file) return;
          locImgState.textContent = L.sending ?? "";
          try {
            const b64 = await new Promise<string>((resolve, reject) => {
              const r = new FileReader();
              r.onload = () => resolve(String(r.result).split(",")[1] ?? "");
              r.onerror = () => reject(new Error());
              r.readAsDataURL(file);
            });
            const res = await fetch("/api/admin/upload", {
              method: "POST", headers,
              body: JSON.stringify({ filename: file.name, data: b64, bucket: "brand", folder: "sedi" }),
            });
            const j = await res.json();
            if (!res.ok) throw new Error(j.error ?? "");
            locImgUrl = String(j.url ?? "") || null;
            disegnaFoto();
            locImgState.textContent = "";
          } catch (err) {
            locImgState.textContent = (err instanceof Error && err.message) || L.imgErr || "";
          }
        }));

        (document.getElementById("loc-add") as HTMLButtonElement).addEventListener("click", () => locApri(null));
        locOverlay.querySelectorAll("[data-md-close]").forEach((el) =>
          el.addEventListener("click", () => { locOverlay.hidden = true; })
        );
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !locOverlay.hidden) locOverlay.hidden = true;
        });

        /**
         * UNA PATCH, UN ESITO — e l'esito si GUARDA, sempre.
         *
         * ⚠️ L'API delle sedi fa una cosa per chiamata: salvare una scheda
         * vuol dire mandarne cinque (campi, Place ID, link recensioni,
         * stampante, segreti). Tre partivano «a perdere»: nessuno leggeva la
         * risposta. Se una falliva, il modale si chiudeva dicendo «salvato» e
         * il dato non c'era. Con la chiave Stripe vuol dire pagamenti che non
         * funzionano e nessun segno da nessuna parte.
         *
         * Qui la risposta si legge e un errore LANCIA: chi chiama si ferma
         * alla prima che non passa, mostra il messaggio del server e non
         * chiude niente. Il corpo torna indietro perche' a qualcuno serve
         * (quante righe di storico ha preso la sede).
         *
         * ⚠️ E' l'UNICO posto da cui parte una PATCH sulle sedi. Un test lo
         * pretende: una seconda, scritta a mano, sarebbe di nuovo una
         * scrittura di cui nessuno controlla l'esito.
         */
        async function patchSede(corpo: Record<string, unknown>): Promise<Record<string, unknown>> {
          const r = await fetch("/api/admin/locations", {
            method: "PATCH", headers,
            body: JSON.stringify(corpo),
          });
          const j = (await r.json().catch(() => ({}))) as Record<string, unknown>;
          if (!r.ok) throw new Error(String(j?.error ?? L.netErr ?? ""));
          return j;
        }

        locSave.addEventListener("click", () => conAttesa(locSave, async () => {
          locErr.textContent = "";
          const corpo: Record<string, unknown> = {
            name: campo("loc-name").value.trim(),
            slug: campo("loc-slug").value.trim().toLowerCase(),
            image_url: locImgUrl,
            sort_order: Number(campo("loc-order").value || 0),
            active: campo("loc-active").checked,
          };
          try {
            const res = await fetch("/api/admin/locations", {
              method: sedeAperta ? "PATCH" : "POST",
              headers,
              body: JSON.stringify(sedeAperta ? { id: sedeAperta.id, ...corpo } : corpo),
            });
            const j = await res.json();
            if (!res.ok) { locErr.textContent = j.error ?? ""; return; }
            const id = String(j.location?.id ?? sedeAperta?.id ?? "");

            // Place ID e link recensioni si mandano SEMPRE, anche vuoti:
            // svuotare il campo deve poterli togliere. I segreti no — la'
            // vuoto vuol dire «non cambiare», e un campo lasciato in bianco
            // non cancella la chiave gia' registrata.
            //
            // La stampante e il suo interruttore viaggiano INSIEME: scritti in
            // due chiamate, un salvataggio a meta' lascerebbe la stampa accesa
            // su una stampante che non c'e' piu', cioe' una coda che si riempie
            // di ticket che nessuno stampera' mai.
            await patchSede({ id, place_id: campo("loc-place").value.trim() });
            await patchSede({ id, review_url: campo("loc-greview").value.trim() });
            await patchSede({
              id,
              printer_id: (document.getElementById("loc-printer") as HTMLSelectElement).value,
              print_auto: (document.getElementById("loc-print-auto") as HTMLInputElement).checked,
              destinazioni: raccogliDest(),
            });
            for (const [idCampo, chiave] of [["loc-stripe", "stripe_secret_key"], ["loc-hook", "stripe_webhook_secret"]]) {
              const v = campo(idCampo).value.trim();
              if (!v) continue;
              await patchSede({ id, secret_key: chiave, secret_value: v });
            }
            locOverlay.hidden = true;
            const n = Number(j.assegnate ?? 0);
            toast(n > 0 ? (L.stDone ?? "").replace("{n}", String(n)) : (L.saved ?? ""));
            ricaricaPagina();
          } catch (err) {
            // ⚠️ Il messaggio del SERVER, quando c'e'. Prima qui finiva
            // «errore di rete» qualunque cosa fosse successa, e un rifiuto
            // motivato («manca la chiave di cifratura») arrivava come un
            // guasto di linea. Il modale resta aperto e non dice «salvato»:
            // si corregge e si ripreme, le scritture riscrivono gli stessi
            // valori.
            locErr.textContent = (err instanceof Error && err.message) || L.netErr || "";
          }
        }));

        // ---- LO STORICO RIMASTO SENZA SEDE ----------------------------------
        // La migrazione aggiunge `location_id` ma non la riempie: quando gira,
        // le sedi non esistono ancora. Creata la prima sede il filtro si
        // accende, e quelle righe — ordini, prenotazioni, TAVOLI — sparirebbero
        // da ogni punto: il filtro e' `location_id = <id>`, e NULL non lo
        // soddisfa.
        //
        // ⚠️ E' uno STATO, non un evento. Prima la domanda arrivava
        // nell'istante in cui si accendeva un interruttore; se la si
        // annullava, lo storico restava invisibile e non lo diceva piu'
        // nessuno. Ora l'avviso resta nel pannello finche' c'e' qualcosa da
        // assegnare. Con la PRIMA sede non compare proprio: li' il travaso e'
        // automatico, perche' non c'e' niente da scegliere.
        const stOverlay = document.getElementById("st-overlay") as HTMLDivElement;
        const stSede = document.getElementById("st-sede") as HTMLSelectElement;
        const stConteggi = document.getElementById("st-conteggi") as HTMLElement;
        const stErr = document.getElementById("st-err") as HTMLElement;
        const stBox = document.getElementById("loc-storico") as HTMLElement;
        const stNum = document.getElementById("loc-storico-n") as HTMLElement;

        /** Righe orfane dell'ultimo caricamento: { tabella: quante }. */
        let storicoOrfano: Record<string, number> = {};

        function stRighe(): [string, number][] {
          return Object.entries(storicoOrfano).filter(([, n]) => Number(n) > 0);
        }
        function stDettaglio(): string {
          return stRighe()
            .map(([t2, n]) => `<b>${Number(n).toLocaleString(document.documentElement.lang || "fr")}</b> ${esc(SUP.stTabLabels?.[t2] ?? t2)}`)
            .join(" · ");
        }
        function stRenderAvviso() {
          const righe = stRighe();
          // Con una sede sola non si chiede niente: il travaso e' gia' avvenuto
          // creandola. L'avviso ha senso solo se c'e' una scelta da fare.
          const serve = righe.length > 0 && sedi.filter((x) => x.active !== false).length > 1;
          stBox.style.display = serve ? "block" : "none";
          if (serve) stNum.innerHTML = `${esc(L.stCount ?? "")} ${stDettaglio()}`;
        }

        document.getElementById("loc-storico-btn")?.addEventListener("click", () => {
          const attive = sedi.filter((x) => x.active !== false);
          stErr.textContent = "";
          stSede.innerHTML = attive
            .map((x) => `<option value="${esc(x.id)}">${esc(x.name)}</option>`)
            .join("");
          stConteggi.innerHTML = `${esc(L.stCount ?? "")} ${stDettaglio()}`;
          stOverlay.hidden = false;
        });

        document.getElementById("st-cancel")?.addEventListener("click", () => {
          stOverlay.hidden = true;
        });

        const stGo = document.getElementById("st-go") as HTMLButtonElement | null;
        stGo?.addEventListener("click", () => conAttesa(stGo, async () => {
          stErr.textContent = "";
          try {
            const j = await patchSede({ storico_sede: stSede.value });
            const n = Number(j.assegnate ?? 0);
            toast((L.stDone ?? "").replace("{n}", String(n)));
            stOverlay.hidden = true;
            ricaricaPagina();
          } catch (err) {
            // Nel campo errore del modale, non in un toast che passa: il
            // modale e' ancora li' davanti, ed e' li' che si guarda.
            stErr.textContent = (err instanceof Error && err.message) || L.netErr || "";
          }
        }));

        // Cestino a due tempi, UNO SOLO armato alla volta: stessa guardia
        // di Documenti e Ordini.
        let locCestino: HTMLButtonElement | null = null;
        let locCestinoTimer = 0;
        function locDisarma() {
          window.clearTimeout(locCestinoTimer);
          if (!locCestino) return;
          locCestino.classList.remove("confirm");
          locCestino.innerHTML = LOC_CESTINO;
          locCestino = null;
        }
        // L'interruttore salva da solo: e' uno stato, non una modifica da
        // confermare. Se il server rifiuta, torna com'era.
        locList.addEventListener("change", async (e) => {
          const sw = e.target as HTMLInputElement;
          if (!sw.classList.contains("loc-att")) return;
          const card = sw.closest(".loc-card") as HTMLElement | null;
          if (!card) return;
          const attiva = sw.checked;
          try {
            await patchSede({ id: card.dataset.id ?? "", active: attiva });
            card.classList.toggle("is-off", !attiva);
            toast(L.saved ?? "");
            // Una sede disattivata esce da `elencoSedi()`: il selettore in alto
            // cambia, e con una sede sola sparisce del tutto.
            ricaricaPagina();
          } catch (err) {
            // L'interruttore torna com'era: mostrare acceso cio' che il
            // server non ha acceso e' una bugia che dura fino al ricarico.
            sw.checked = !attiva;
            toast((err instanceof Error && err.message) || L.netErr || "", true);
          }
        });

        locList.addEventListener("click", async (e) => {
          const bersaglio = e.target as HTMLElement;
          const card = bersaglio.closest(".loc-card") as HTMLElement | null;
          if (!card) return;
          const id = card.dataset.id ?? "";

          if (bersaglio.closest(".loc-edit")) {
            locDisarma();
            const s = sedi.find((x) => x.id === id);
            if (s) locApri(s);
            return;
          }
          const del = bersaglio.closest(".loc-del") as HTMLButtonElement | null;
          if (!del) return;
          if (del !== locCestino) {
            locDisarma();
            locCestino = del;
            del.classList.add("confirm");
            del.textContent = L.confirm ?? "?";
            locCestinoTimer = window.setTimeout(locDisarma, 3000);
            return;
          }
          locDisarma();
          await conAttesa(del, async () => {
            try {
              const res = await fetch("/api/admin/locations?id=" + encodeURIComponent(id), {
                method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" },
              });
              const j = await res.json();
              if (!res.ok) { toast(j.error ?? "", true); return; }
              toast(L.deleted ?? "");
              ricaricaPagina();
            } catch {
              toast(L.netErr ?? "", true);
            }
          });
        });

        // Prima le sedi, poi gli utenti: la riga utente mostra il nome della sua
        // sede, e senza l'elenco gia' pronto mostrerebbe "?" a seconda di chi
        // dei due risponde per primo.
        void locCarica().then(() => usCarica());
      })();
    </script>

    <style is:global>
      .pane[data-pane="print"] .pr-list { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); align-items: start; }
      .pr-card { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px; padding: 1rem 1.2rem 1.2rem; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); }
      .pr-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 0.9rem; }
      .pr-titles { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
      .pr-name { font-family: var(--font-title); font-size: 1.1rem; letter-spacing: 0.03em; color: var(--c-text); }
      .pr-route { font-size: 0.78rem; color: var(--c-muted); }
      .pr-name-in { width: 100%; padding: 0.4rem 0.55rem; border: 1px solid var(--c-line); border-radius: 8px; background: var(--c-bg); color: var(--c-text); font-family: var(--font-title); font-size: 1.05rem; letter-spacing: 0.03em; }
      .pr-name-in:focus { outline: none; border-color: var(--c-accent); }
      .pr-warn { margin-top: 0.6rem; font-size: 0.78rem; color: #c0392b; }
      .pr-found { border: 1px dashed var(--c-line); border-radius: 12px; padding: 1rem 1.2rem; margin-bottom: 1.4rem; }
      .pr-found-t { font-family: var(--font-title); font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--c-muted); margin-bottom: 0.4rem; }
      .pr-found-hint { font-size: 0.85rem; color: var(--c-muted); margin: 0 0 0.6rem; }
      .pr-found-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-top: 1px solid var(--c-line); }
      .pr-found-row .pr-add { margin-top: 0; flex-shrink: 0; }
      .pr-toggle { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
      .pr-toggle-lbl { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); }
      .pr-tiers { width: 100%; border-collapse: collapse; }
      .pr-tiers th { text-align: left; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-muted); font-weight: 700; padding: 0 0.4rem 0.4rem; }
      .pr-tiers th:last-child { width: 40px; }
      .pr-tiers td { padding: 0.25rem 0.4rem; }
      .pr-tiers input { width: 100%; padding: 0.45rem 0.6rem; border: 1px solid var(--c-line); border-radius: 8px; background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); font-size: 0.95rem; }
      .pr-tiers input:focus { outline: none; border-color: var(--c-accent); }
      .pr-del { width: 30px; height: 30px; border: 1px solid var(--c-line); background: var(--c-input); color: var(--c-muted); border-radius: 8px; cursor: pointer; font-size: 1.1rem; line-height: 1; transition: color 0.15s, border-color 0.15s; }
      .pr-del:hover { color: #c0392b; border-color: #c0392b; }
      .pr-delprod { flex-shrink: 0; }
      .pr-nota { font-size: 0.85rem; color: var(--c-muted); margin-top: 0.5rem; }
      .pr-add { margin-top: 0.7rem; background: none; border: 1px dashed var(--c-line); color: var(--c-muted); border-radius: 8px; padding: 0.45rem 0.9rem; cursor: pointer; font-family: var(--font-body); font-size: 0.85rem; transition: color 0.15s, border-color 0.15s; }
      .pr-add:hover { color: var(--c-accent); border-color: var(--c-accent); }
      .pane[data-pane="print"] .pr-actions { display: flex; gap: 0.7rem; align-items: center; margin-top: 1.4rem; flex-wrap: wrap; }
      .pr-state-msg { font-size: 0.85rem; }
      .pr-meta { margin-top: 1.1rem; padding-top: 0.9rem; border-top: 1px solid var(--c-line); }
      .pr-meta-t { font-family: var(--font-title); font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--c-muted); margin-bottom: 0.6rem; }
      .pr-meta-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
      .pr-m-f { display: flex; flex-direction: column; gap: 0.25rem; }
      .pr-m-f span { font-size: 0.72rem; color: var(--c-muted); }
      .pr-m-f input { padding: 0.45rem 0.6rem; border: 1px solid var(--c-line); border-radius: 8px; background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); font-size: 0.9rem; }
      .pr-m-f input:focus { outline: none; border-color: var(--c-accent); }
      @media (max-width: 640px) { .pr-meta-grid { grid-template-columns: minmax(0, 1fr); } }
    </style>

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      // ⚠️ Dalle REGOLE pure, non da `printRoutes`: quello contiene
      // `import.meta.glob`, e importarlo qui trascinerebbe le pagine del sito
      // dentro il pacchetto del browser.
      import { confrontaCatalogo } from "../../lib/admin/printRegole";

      const paneEl = document.querySelector('.pane[data-pane="print"]');
      if (paneEl) {
        const PR = (() => { try { return JSON.parse(document.getElementById("pr-i18n")?.textContent || "{}"); } catch { return {}; } })() as Record<string, any>;
        const listEl = document.getElementById("pr-list") as HTMLDivElement;
        const saveBtn = document.getElementById("pr-save") as HTMLButtonElement;
        const resetBtn = document.getElementById("pr-reset") as HTMLButtonElement;
        const stateEl = document.getElementById("pr-state") as HTMLSpanElement;

        let catalogo: any[] = [];
        let defaults: any[] = [];
        let token = "";
        // Stesso motivo dell'altro script: il token scade, e qui il salvataggio
        // riusa quello letto al caricamento del catalogo. Se ne arriva uno
        // nuovo si prende quello.
        supabaseBrowser.auth.onAuthStateChange((_evento, sessione) => {
          if (sessione?.access_token) token = sessione.access_token;
        });
        // Le pagine `/print/` che il sito di questo cliente ha davvero, lette
        // dal filesystem in build e portate qui dal GET.
        let pagine: { slug: string; route: string }[] = [];
        let nuove: { slug: string; route: string }[] = [];
        let senzaPagina = new Set<string>();

        const esc = (v: unknown) => String(v).replace(/[&<>"']/g, (c) => (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }) as Record<string, string>)[c]);
        const eur = (cents: number) => (Math.max(0, Math.round(cents)) / 100).toFixed(2);
        const toCents = (v: unknown) => { const n = Math.round(parseFloat(String(v).replace(",", ".")) * 100); return Number.isFinite(n) && n >= 0 ? n : 0; };
        const toQty = (v: unknown) => { const n = Math.floor(Number(v)); return Number.isFinite(n) && n > 0 ? n : 0; };

        function msg(text: string, isErr = false) {
          if (!stateEl) return;
          stateEl.textContent = text;
          stateEl.style.color = isErr ? "#c0392b" : "var(--c-accent)";
          if (text) window.setTimeout(() => { if (stateEl.textContent === text) stateEl.textContent = ""; }, 4000);
        }

        // Precompila i campi caratteristiche vuoti col valore consigliato del seed
        // (restano da salvare: sync() legge il value dell'input).
        function metaVal(p: any, k: string): string {
          const seed = (defaults.find((d: any) => d.slug === p.slug)?.meta) || {};
          return (p.meta && p.meta[k]) || seed[k] || "";
        }

        function render() {
          listEl.innerHTML = catalogo.map((p, pi) => `
            <div class="pr-card" data-p="${pi}">
              <div class="pr-head">
                <div class="pr-titles">
                  <input type="text" class="pr-name-in" value="${esc(p.label)}" placeholder="${esc(PR.name)}" aria-label="${esc(PR.name)}" />
                  <span class="pr-route">${esc(p.route || "")}</span>
                </div>
                <label class="pr-toggle">
                  <span class="pr-toggle-lbl">${p.visible ? esc(PR.visible) : esc(PR.hidden)}</span>
                  <span class="switch"><input type="checkbox" class="pr-vis" ${p.visible ? "checked" : ""} /><span class="track"></span></span>
                </label>
                <button type="button" class="pr-del pr-delprod" title="${esc(PR.removeProd)}" aria-label="${esc(PR.removeProd)}">\u00d7</button>
              </div>
              ${senzaPagina.has(p.slug) ? `<div class="pr-warn">${esc(PR.missing)}</div>` : ""}
              <table class="pr-tiers">
                <thead><tr><th>${esc(PR.colQty)}</th><th>${esc(PR.colPrice)}</th><th></th></tr></thead>
                <tbody>
                  ${p.tiers.map((t: any, ti: number) => `
                    <tr data-t="${ti}">
                      <td><input type="number" min="1" step="1" class="pr-qty" value="${t.qty}" /></td>
                      <td><input type="text" inputmode="decimal" class="pr-price" value="${eur(t.price_cents)}" /></td>
                      <td><button type="button" class="pr-del" title="${esc(PR.removeTier)}" aria-label="${esc(PR.removeTier)}">\u00d7</button></td>
                    </tr>`).join("")}
                </tbody>
              </table>
              <button type="button" class="pr-add">${esc(PR.addTier)}</button>
              ${p.tiers.length === 0 ? `<p class="pr-nota">${esc(PR.noTiers)}</p>` : ""}
              <div class="pr-meta">
                <div class="pr-meta-t">${esc(PR.metaTitle)}</div>
                <div class="pr-meta-grid">
                  <label class="pr-m-f"><span>${esc(PR.metaFormat)}</span><input type="text" class="pr-m" data-m="format" value="${esc(metaVal(p, "format"))}" /></label>
                  <label class="pr-m-f"><span>${esc(PR.metaPages)}</span><input type="text" class="pr-m" data-m="pages" value="${esc(metaVal(p, "pages"))}" /></label>
                  <label class="pr-m-f"><span>${esc(PR.metaPaper)}</span><input type="text" class="pr-m" data-m="paper" value="${esc(metaVal(p, "paper"))}" /></label>
                  <label class="pr-m-f"><span>${esc(PR.metaColor)}</span><input type="text" class="pr-m" data-m="color" value="${esc(metaVal(p, "color"))}" /></label>
                </div>
              </div>
            </div>`).join("");
        }

        // Quali pagine non sono ancora a catalogo, e quali prodotti puntano a
        // una pagina che non esiste. La REGOLA e' quella del server, importata:
        // due copie della stessa condizione prima o poi divergono.
        function ricalcola() {
          const c = confrontaCatalogo(catalogo.map((p) => ({ slug: p.slug, route: p.route || "" })), pagine);
          nuove = c.nuove;
          senzaPagina = new Set(c.senzaPagina);
        }

        function renderTrovate() {
          const box = document.getElementById("pr-found") as HTMLElement | null;
          const list = document.getElementById("pr-found-list") as HTMLElement | null;
          if (!box || !list) return;
          // Nessuna pagina trovata = cliente senza pagine di stampa: il riquadro
          // non ha niente da dire e sparisce, invece di annunciare il vuoto.
          if (pagine.length === 0) { box.hidden = true; return; }
          box.hidden = false;
          list.innerHTML = nuove.length === 0
            ? `<p class="pr-found-hint">${esc(PR.foundNone)}</p>`
            : nuove.map((pg) => `
              <div class="pr-found-row">
                <span class="pr-route">${esc(pg.route)}</span>
                <button type="button" class="pr-add pr-addprod" data-slug="${esc(pg.slug)}" data-route="${esc(pg.route)}">${esc(PR.addProd)}</button>
              </div>`).join("");
        }

        document.getElementById("pr-found-list")?.addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          if (!t.classList.contains("pr-addprod")) return;
          const slug = t.dataset.slug || "";
          const route = t.dataset.route || "";
          if (!slug || catalogo.some((p: any) => p.slug === slug)) return;
          // Nasce nascosto e senza prezzi, come i prodotti del seed: l'API
          // rifiuta un prodotto visibile senza nemmeno una quantita'.
          sync();
          catalogo.push({ slug, label: slug, route, visible: false, meta: {}, tiers: [] });
          ricalcola();
          render();
          renderTrovate();
        });

        // Legge gli input nel modello senza re-render (per non perdere il focus).
        function sync() {
          listEl.querySelectorAll<HTMLElement>(".pr-card").forEach((card) => {
            const pi = Number(card.dataset.p);
            const p = catalogo[pi];
            if (!p) return;
            p.visible = (card.querySelector(".pr-vis") as HTMLInputElement | null)?.checked ?? false;
            // Il nome e' un campo libero: lo scrive il super admin nella lingua
            // del cliente. Se lo svuota si ripiega sullo slug, perche' una card
            // senza nome non si distingue dalle altre.
            p.label = ((card.querySelector(".pr-name-in") as HTMLInputElement | null)?.value ?? "").trim() || p.slug;
            card.querySelectorAll<HTMLElement>("tbody tr").forEach((tr) => {
              const ti = Number(tr.dataset.t);
              if (!p.tiers[ti]) return;
              p.tiers[ti].qty = toQty((tr.querySelector(".pr-qty") as HTMLInputElement | null)?.value);
              p.tiers[ti].price_cents = toCents((tr.querySelector(".pr-price") as HTMLInputElement | null)?.value);
            });
            p.meta = p.meta || {};
            card.querySelectorAll<HTMLInputElement>(".pr-m").forEach((inp) => {
              const key = inp.dataset.m;
              if (key) (p.meta as Record<string, string>)[key] = inp.value.trim();
            });
          });
        }

        listEl.addEventListener("input", (e) => {
          const t = e.target as HTMLElement;
          if (t.classList.contains("pr-vis")) { sync(); render(); }
        });
        listEl.addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          const card = t.closest(".pr-card") as HTMLElement | null;
          if (!card) return;
          const pi = Number(card.dataset.p);
          if (t.classList.contains("pr-delprod")) {
            // ⚠️ Niente conferma, come per le quantita': non si perde niente
            // finche' non si preme Enregistrer, e ricaricare la pagina annulla.
            // Un prodotto tolto e salvato NON torna col seed: i default valgono
            // solo per un cliente che non ha ancora un listino suo.
            sync();
            catalogo.splice(pi, 1);
            ricalcola();
            render();
            renderTrovate();
          } else if (t.classList.contains("pr-add")) {
            sync();
            catalogo[pi].tiers.push({ qty: 0, price_cents: 0 });
            render();
          } else if (t.classList.contains("pr-del")) {
            sync();
            const tr = t.closest("tr") as HTMLElement | null;
            if (!tr) return;
            catalogo[pi].tiers.splice(Number(tr.dataset.t), 1);
            render();
          }
        });

        function pulisci(cat: any[]) {
          return cat.map((p) => ({ ...p, tiers: p.tiers.filter((t: any) => t.qty > 0).sort((a: any, b: any) => a.qty - b.qty) }));
        }

        async function carica() {
          try {
            const { data } = await supabaseBrowser.auth.getSession();
            token = data.session?.access_token ?? "";
            const res = await fetch("/api/admin/print-catalog", { headers: { Authorization: `Bearer ${token}` } });
            if (!res.ok) throw new Error();
            const body = await res.json();
            catalogo = Array.isArray(body.catalog) ? body.catalog : [];
            defaults = Array.isArray(body.defaults) ? body.defaults : [];
            pagine = Array.isArray(body.pagine) ? body.pagine : [];
            ricalcola();
            render();
            renderTrovate();
          } catch {
            msg(PR.loadError, true);
          }
        }

        async function salva() {
          sync();
          catalogo = pulisci(catalogo);
          render();
          saveBtn.disabled = true;
          try {
            const res = await fetch("/api/admin/print-catalog", {
              method: "PUT",
              headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
              body: JSON.stringify({ catalog: catalogo }),
            });
            const body = await res.json().catch(() => ({}));
            if (!res.ok) { msg(body.error || PR.saveError, true); return; }
            if (Array.isArray(body.catalog)) { catalogo = body.catalog; ricalcola(); render(); renderTrovate(); }
            msg(PR.saved);
          } catch {
            msg(PR.saveError, true);
          } finally {
            saveBtn.disabled = false;
          }
        }

        saveBtn?.addEventListener("click", salva);
        resetBtn?.addEventListener("click", () => {
          catalogo = JSON.parse(JSON.stringify(defaults));
          ricalcola();
          render();
          renderTrovate();
          msg(PR.resetDone);
        });

        carica();
      }
    </script>
  </body>
</html>
