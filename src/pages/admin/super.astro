    <script>
      // ⚠️ Dalle REGOLE pure, non da `printRoutes`: quello contiene
      // `import.meta.glob`, e importarlo qui trascinerebbe le pagine del sito
      // dentro il pacchetto del browser.
      import { confrontaCatalogo } from "../../lib/admin/printRegole";
      import { authFresh } from "../../lib/admin/auth";
      import { conAttesa } from "../../lib/admin/attesa";
      import { esc } from "../../lib/esc";

      const paneEl = document.querySelector('.pane[data-pane="print"]');
      if (paneEl) {
        const PR = (() => { try { return JSON.parse(document.getElementById("pr-i18n")?.textContent || "{}"); } catch { return {}; } })() as Record<string, any>;
        const listEl = document.getElementById("pr-list") as HTMLDivElement;
        const saveBtn = document.getElementById("pr-save") as HTMLButtonElement;
        const resetBtn = document.getElementById("pr-reset") as HTMLButtonElement;
        const stateEl = document.getElementById("pr-state") as HTMLSpanElement;

        let catalogo: any[] = [];
        let defaults: any[] = [];
        // Le pagine `/print/` che il sito di questo cliente ha davvero, lette
        // dal filesystem in build e portate qui dal GET.
        let pagine: { slug: string; route: string }[] = [];
        let nuove: { slug: string; route: string }[] = [];
        let senzaPagina = new Set<string>();

        const eur = (cents: number) => (Math.max(0, Math.round(cents)) / 100).toFixed(2);
        const toCents = (v: unknown) => { const n = Math.round(parseFloat(String(v).replace(",", ".")) * 100); return Number.isFinite(n) && n >= 0 ? n : 0; };
        const toQty = (v: unknown) => { const n = Math.floor(Number(v)); return Number.isFinite(n) && n > 0 ? n : 0; };

        function msg(text: string, isErr = false) {
          if (!stateEl) return;
          stateEl.textContent = text;
          stateEl.style.color = isErr ? "#c0392b" : "var(--c-accent)";
          if (text) window.setTimeout(() => { if (stateEl.textContent === text) stateEl.textContent = ""; }, 4000);
        }

        // Precompila i campi caratteristiche vuoti col valore consigliato del seed
        // (restano da salvare: sync() legge il value dell'input).
        function metaVal(p: any, k: string): string {
          const seed = (defaults.find((d: any) => d.slug === p.slug)?.meta) || {};
          return (p.meta && p.meta[k]) || seed[k] || "";
        }

        function render() {
          listEl.innerHTML = catalogo.map((p, pi) => `
            <div class="pr-card" data-p="${pi}">
              <div class="pr-head">
                <div class="pr-titles">
                  <input type="text" class="pr-name-in" value="${esc(p.label)}" placeholder="${esc(PR.name)}" aria-label="${esc(PR.name)}" />
                  <span class="pr-route">${esc(p.route || "")}</span>
                </div>
                <label class="pr-toggle">
                  <span class="pr-toggle-lbl">${p.visible ? esc(PR.visible) : esc(PR.hidden)}</span>
                  <span class="switch"><input type="checkbox" class="pr-vis" ${p.visible ? "checked" : ""} /><span class="track"></span></span>
                </label>
                <button type="button" class="pr-del pr-delprod" title="${esc(PR.removeProd)}" aria-label="${esc(PR.removeProd)}">\u00d7</button>
              </div>
              ${senzaPagina.has(p.slug) ? `<div class="pr-warn">${esc(PR.missing)}</div>` : ""}
              <table class="pr-tiers">
                <thead><tr><th>${esc(PR.colQty)}</th><th>${esc(PR.colPrice)}</th><th></th></tr></thead>
                <tbody>
                  ${p.tiers.map((t: any, ti: number) => `
                    <tr data-t="${ti}">
                      <td><input type="number" min="1" step="1" class="pr-qty" value="${t.qty}" /></td>
                      <td><input type="text" inputmode="decimal" class="pr-price" value="${eur(t.price_cents)}" /></td>
                      <td><button type="button" class="pr-del" title="${esc(PR.removeTier)}" aria-label="${esc(PR.removeTier)}">\u00d7</button></td>
                    </tr>`).join("")}
                </tbody>
              </table>
              <button type="button" class="pr-add">${esc(PR.addTier)}</button>
              ${p.tiers.length === 0 ? `<p class="pr-nota">${esc(PR.noTiers)}</p>` : ""}
              <div class="pr-meta">
                <div class="pr-meta-t">${esc(PR.metaTitle)}</div>
                <div class="pr-meta-grid">
                  <label class="pr-m-f"><span>${esc(PR.metaFormat)}</span><input type="text" class="pr-m" data-m="format" value="${esc(metaVal(p, "format"))}" /></label>
                  <label class="pr-m-f"><span>${esc(PR.metaPages)}</span><input type="text" class="pr-m" data-m="pages" value="${esc(metaVal(p, "pages"))}" /></label>
                  <label class="pr-m-f"><span>${esc(PR.metaPaper)}</span><input type="text" class="pr-m" data-m="paper" value="${esc(metaVal(p, "paper"))}" /></label>
                  <label class="pr-m-f"><span>${esc(PR.metaColor)}</span><input type="text" class="pr-m" data-m="color" value="${esc(metaVal(p, "color"))}" /></label>
                </div>
              </div>
            </div>`).join("");
        }

        // Quali pagine non sono ancora a catalogo, e quali prodotti puntano a
        // una pagina che non esiste. La REGOLA e' quella del server, importata:
        // due copie della stessa condizione prima o poi divergono.
        function ricalcola() {
          const c = confrontaCatalogo(catalogo.map((p) => ({ slug: p.slug, route: p.route || "" })), pagine);
          nuove = c.nuove;
          senzaPagina = new Set(c.senzaPagina);
        }

        function renderTrovate() {
          const box = document.getElementById("pr-found") as HTMLElement | null;
          const list = document.getElementById("pr-found-list") as HTMLElement | null;
          if (!box || !list) return;
          // Nessuna pagina trovata = cliente senza pagine di stampa: il riquadro
          // non ha niente da dire e sparisce, invece di annunciare il vuoto.
          if (pagine.length === 0) { box.hidden = true; return; }
          box.hidden = false;
          list.innerHTML = nuove.length === 0
            ? `<p class="pr-found-hint">${esc(PR.foundNone)}</p>`
            : nuove.map((pg) => `
              <div class="pr-found-row">
                <span class="pr-route">${esc(pg.route)}</span>
                <button type="button" class="pr-add pr-addprod" data-slug="${esc(pg.slug)}" data-route="${esc(pg.route)}">${esc(PR.addProd)}</button>
              </div>`).join("");
        }

        document.getElementById("pr-found-list")?.addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          if (!t.classList.contains("pr-addprod")) return;
          const slug = t.dataset.slug || "";
          const route = t.dataset.route || "";
          if (!slug || catalogo.some((p: any) => p.slug === slug)) return;
          // Nasce nascosto e senza prezzi, come i prodotti del seed: l'API
          // rifiuta un prodotto visibile senza nemmeno una quantita'.
          sync();
          catalogo.push({ slug, label: slug, route, visible: false, meta: {}, tiers: [] });
          ricalcola();
          render();
          renderTrovate();
        });

        // Legge gli input nel modello senza re-render (per non perdere il focus).
        function sync() {
          listEl.querySelectorAll<HTMLElement>(".pr-card").forEach((card) => {
            const pi = Number(card.dataset.p);
            const p = catalogo[pi];
            if (!p) return;
            p.visible = (card.querySelector(".pr-vis") as HTMLInputElement | null)?.checked ?? false;
            // Il nome e' un campo libero: lo scrive il super admin nella lingua
            // del cliente. Se lo svuota si ripiega sullo slug, perche' una card
            // senza nome non si distingue dalle altre.
            p.label = ((card.querySelector(".pr-name-in") as HTMLInputElement | null)?.value ?? "").trim() || p.slug;
            card.querySelectorAll<HTMLElement>("tbody tr").forEach((tr) => {
              const ti = Number(tr.dataset.t);
              if (!p.tiers[ti]) return;
              p.tiers[ti].qty = toQty((tr.querySelector(".pr-qty") as HTMLInputElement | null)?.value);
              p.tiers[ti].price_cents = toCents((tr.querySelector(".pr-price") as HTMLInputElement | null)?.value);
            });
            p.meta = p.meta || {};
            card.querySelectorAll<HTMLInputElement>(".pr-m").forEach((inp) => {
              const key = inp.dataset.m;
              if (key) (p.meta as Record<string, string>)[key] = inp.value.trim();
            });
          });
        }

        listEl.addEventListener("input", (e) => {
          const t = e.target as HTMLElement;
          if (t.classList.contains("pr-vis")) { sync(); render(); }
        });
        listEl.addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          const card = t.closest(".pr-card") as HTMLElement | null;
          if (!card) return;
          const pi = Number(card.dataset.p);
          if (t.classList.contains("pr-delprod")) {
            // ⚠️ Niente conferma, come per le quantita': non si perde niente
            // finche' non si preme Enregistrer, e ricaricare la pagina annulla.
            // Un prodotto tolto e salvato NON torna col seed: i default valgono
            // solo per un cliente che non ha ancora un listino suo.
            sync();
            catalogo.splice(pi, 1);
            ricalcola();
            render();
            renderTrovate();
          } else if (t.classList.contains("pr-add")) {
            sync();
            catalogo[pi].tiers.push({ qty: 0, price_cents: 0 });
            render();
          } else if (t.classList.contains("pr-del")) {
            sync();
            const tr = t.closest("tr") as HTMLElement | null;
            if (!tr) return;
            catalogo[pi].tiers.splice(Number(tr.dataset.t), 1);
            render();
          }
        });

        function pulisci(cat: any[]) {
          return cat.map((p) => ({ ...p, tiers: p.tiers.filter((t: any) => t.qty > 0).sort((a: any, b: any) => a.qty - b.qty) }));
        }

        async function carica() {
          try {
            // ⚠️ Nessun token tenuto da parte: questo blocco ne aveva uno
            // SUO, letto al caricamento del catalogo, e il salvataggio di
            // un'ora dopo mandava quello. Due verita' sullo stesso token
            // nella stessa pagina.
            const res = await fetch("/api/admin/print-catalog", { headers: await authFresh() });
            if (!res.ok) throw new Error();
            const body = await res.json();
            catalogo = Array.isArray(body.catalog) ? body.catalog : [];
            defaults = Array.isArray(body.defaults) ? body.defaults : [];
            pagine = Array.isArray(body.pagine) ? body.pagine : [];
            ricalcola();
            render();
            renderTrovate();
          } catch {
            msg(PR.loadError, true);
          }
        }

        async function salva() {
          sync();
          catalogo = pulisci(catalogo);
          render();
          try {
            const res = await fetch("/api/admin/print-catalog", {
              method: "PUT",
              headers: await authFresh(),
              body: JSON.stringify({ catalog: catalogo }),
            });
            const body = await res.json().catch(() => ({}));
            if (!res.ok) { msg(body.error || PR.saveError, true); return; }
            if (Array.isArray(body.catalog)) { catalogo = body.catalog; ricalcola(); render(); renderTrovate(); }
            msg(PR.saved);
          } catch {
            msg(PR.saveError, true);
          }
        }

        // ⚠️ `conAttesa` come ogni altro salvataggio del pannello: la rotella
        // nel bottone e il secondo click ignorato. Qui c'era un `disabled`
        // scritto a mano, che spegne il bottone ma non dice che sta
        // lavorando — su rete lenta sembra che il click non sia passato, e si
        // riclicca.
        saveBtn?.addEventListener("click", () => conAttesa(saveBtn, salva));
        resetBtn?.addEventListener("click", () => {
          catalogo = JSON.parse(JSON.stringify(defaults));
          ricalcola();
          render();
          renderTrovate();
          msg(PR.resetDone);
        });

        carica();
      }
    </script>

    <!-- ===== INTÉGRATIONS → SUPABASE (5/11/2026) =====
         Lo stato del database e i quattro passi di «Tout préparer». Script a
         parte: la casella non dipende dal resto della pagina, e il resto
         della pagina non dipende da lei. -->
    <script>
      import { authFresh } from "../../lib/admin/auth";
      import { conAttesa } from "../../lib/admin/attesa";
      import { SEGNO, esito } from "../../lib/admin/casellaUi";
      import { esc } from "../../lib/esc";
      import { adminT, type AdminLang } from "../../i18n/admin";

      type Livello = "ok" | "parz" | "no" | "ignoto";
      type Stato = {
        progetto: { ref: string; mascherato: string; dashboard: string };
        chiavi: { url: string; anon: string; service: string };
        token: boolean;
        sito: { raggiungibile: boolean };
        migrazioni: { livello: Livello; applicate: number; totale: number; mancanti: { numero: number; nome: string }[]; registro: boolean; baseVuota: boolean };
        bucket: { livello: Livello; presenti: number; totale: number; mancanti: string[]; daCorreggere: string[] };
        cron: { livello: Livello; giusti: number; totale: number; daRifare: string[]; domini: string[]; motivo: string };
        estensioni: { livello: Livello; presenti: string[]; mancanti: string[]; motivo: string };
        casella: { livello: Livello; daFare: number };
      };
      type Esito = { ok: true; fatte: number; restano: number } | { ok: false; errore: string; numero?: number; messaggio?: string };
      type Passo = "estensioni" | "migrazioni" | "bucket" | "cron";

      const tr = adminT((document.documentElement.lang || "fr") as AdminLang);
      const $ = (id: string) => document.getElementById(id);
      const tile = $("sb-tile");
      const overlay = $("sb-overlay");
      let stato: Stato | null = null;
      let occupato = false;

      const lista = (v: string[]) => v.map((x) => `<b>${esc(x)}</b>`).join(", ");

      function renderCasella() {
        const segno = $("sb-segno");
        const pill = $("sb-pill");
        if (!segno || !pill) return;
        if (!stato) { segno.className = "itg-segno is-no"; segno.innerHTML = SEGNO.no; pill.className = "itg-pill is-no"; pill.textContent = tr("itg.sb.down"); return; }
        const { livello, daFare } = stato.casella;
        segno.className = `itg-segno is-${livello}`;
        segno.innerHTML = livello === "ignoto" ? "" : SEGNO[livello];
        pill.className = `itg-pill is-${livello === "ignoto" ? "parz" : livello}`;
        pill.textContent = stato.migrazioni.baseVuota ? tr("itg.sb.empty")
          : livello === "ok" ? tr("itg.sb.ok")
          : livello === "ignoto" ? tr("itg.sb.toCheck")
          : daFare <= 1 ? tr("itg.sb.todo1") : tr("itg.sb.todo").replace("{n}", String(daFare));
      }

      /** Una riga dei controlli. `passo` vuoto = niente bottone. */
      function riga(livello: Livello, titolo: string, dettaglio: string, passo: Passo | "", etichetta = ""): string {
        const bottone = passo && (livello === "parz" || livello === "no")
          ? `<button type="button" class="btn" data-passo="${passo}">${esc(etichetta)}</button>` : "<span></span>";
        return `<li><span class="sb-ic is-${livello}">${SEGNO[livello]}</span><div><p class="sb-t">${esc(titolo)}</p><p class="sb-d">${dettaglio}</p></div>${bottone}</li>`;
      }

      function renderModale() {
        if (!stato) return;
        const s = stato;
        const ref = $("sb-ref"); if (ref) ref.textContent = s.progetto.mascherato ? `${s.progetto.mascherato}.supabase.co` : "—";
        const open = $("sb-open") as HTMLAnchorElement | null; if (open && s.progetto.dashboard) open.href = s.progetto.dashboard;

        const v = (x: string) => x === "uguali" ? tr("itg.sb.same") : x === "diverse" ? tr("itg.sb.diff") : x === "ok" ? tr("itg.sb.accepted") : x === "rifiutata" ? tr("itg.sb.refused") : tr("itg.sb.missing");
        const buono = (x: string) => x === "uguali" || x === "ok";
        const chiavi = $("sb-chiavi");
        if (chiavi) chiavi.innerHTML = [
          ["SUPABASE_URL · PUBLIC_SUPABASE_URL", s.chiavi.url],
          ["SUPABASE_ANON_KEY · PUBLIC_SUPABASE_ANON_KEY", s.chiavi.anon],
          ["SUPABASE_SERVICE_KEY", s.chiavi.service],
        ].map(([k, x]) => `<span class="sb-k">${k}</span><span class="sb-v${buono(x) ? "" : " is-no"}">${esc(v(x))}</span>`).join("");
        const nota = $("sb-chiavi-nota");
        const chiaviOk = buono(s.chiavi.url) && buono(s.chiavi.anon) && buono(s.chiavi.service);
        if (nota) { nota.textContent = chiaviOk ? tr("itg.sb.keysNote") : tr("itg.sb.keysFix"); nota.className = chiaviOk ? "sb-nota" : "sb-nota is-no"; }

        const m = s.migrazioni;
        const dMig = m.baseVuota ? `<b>0 / ${m.totale}</b> · ${esc(tr("itg.sb.migEmpty"))}`
          : !m.registro ? esc(tr("itg.sb.migNoReg"))
          : `<b>${esc(tr("itg.sb.migDetail").replace("{a}", String(m.applicate)).replace("{t}", String(m.totale)))}</b>`
            + (m.mancanti.length ? ` · ${tr("itg.sb.migMissing").replace("{l}", lista(m.mancanti.slice(0, 4).map((x) => `#${x.numero} (${x.nome})`)) + (m.mancanti.length > 4 ? " …" : ""))}` : "");
        const b = s.bucket;
        const dBucket = `<b>${esc(tr("itg.sb.storageDetail").replace("{a}", String(b.presenti)).replace("{t}", String(b.totale)))}</b>`
          + (b.mancanti.length ? ` · ${tr("itg.sb.storageMissing").replace("{l}", lista(b.mancanti))}` : "")
          + (b.daCorreggere.length ? ` · ${tr("itg.sb.storageFix").replace("{l}", lista(b.daCorreggere))}` : "");
        const c = s.cron;
        const dCron = c.motivo === "token" ? esc(tr("itg.sb.unknown"))
          : c.motivo === "pgcron" ? esc(tr("itg.sb.cronPg"))
          : `<b>${esc(tr("itg.sb.cronDetail").replace("{a}", String(c.giusti)).replace("{t}", String(c.totale)))}</b>`
            + (c.domini.length ? ` · → ${lista(c.domini)}` : "")
            + (c.daRifare.length ? ` · ${tr("itg.sb.cronRedo").replace("{l}", lista(c.daRifare))}` : "")
            + (c.motivo === "localhost" && c.daRifare.length ? ` · ${esc(tr("itg.sb.cronLocal"))}` : "");
        const e = s.estensioni;
        const dExt = e.motivo === "token" ? esc(tr("itg.sb.unknown"))
          : e.mancanti.length ? tr("itg.sb.extMissing").replace("{l}", lista(e.mancanti)) : e.presenti.map(esc).join(" · ");
        const conToken = s.token;
        const controlli = $("sb-controlli");
        if (controlli) controlli.innerHTML = [
          riga(m.livello, tr("itg.sb.mig"), dMig, conToken ? "migrazioni" : "", tr("itg.sb.apply")),
          riga(b.livello, tr("itg.sb.storage"), dBucket, "bucket", tr("itg.sb.create")),
          riga(c.livello, tr("itg.sb.cron"), dCron, conToken && c.motivo !== "localhost" && c.motivo !== "pgcron" ? "cron" : "", tr("itg.sb.create")),
          riga(e.livello, tr("itg.sb.ext"), dExt, conToken ? "estensioni" : "", tr("itg.sb.enable")),
        ].join("");
        const tok = $("sb-token-nota");
        if (tok) { tok.textContent = conToken ? tr("itg.sb.tokenNote") : tr("itg.sb.noToken"); tok.className = conToken ? "sb-nota" : "sb-nota is-no"; }
        const tutto = $("sb-tutto") as HTMLButtonElement | null;
        if (tutto) {
          tutto.textContent = m.baseVuota ? tr("itg.sb.prepareAll") : tr("itg.sb.fixAll");
          // Spento se non c'e' niente che questa casella possa fare da sola:
          // senza token restano solo gli spazi di archivio.
          const fattibile = b.livello !== "ok" || (conToken && (m.livello !== "ok" || e.livello !== "ok" || (c.livello !== "ok" && c.motivo === "")));
          tutto.disabled = !fattibile || occupato;
        }
        const quando = $("sb-quando");
        if (quando) quando.textContent = tr("itg.sb.checkedAt").replace("{h}", new Date().toLocaleTimeString(document.documentElement.lang || "fr", { hour: "2-digit", minute: "2-digit" }));
        if (m.baseVuota) mostraEsito("parz", tr("itg.sb.emptyHint"));
      }

      function mostraEsito(livello: "ok" | "parz" | "no" | "", testo = "") {
        esito("sb-esito", livello, testo);
      }

      function testoErrore(e: Exclude<Esito, { ok: true }>): string {
        if (e.errore === "token") return tr("itg.sb.errToken");
        if (e.errore === "localhost") return tr("itg.sb.errLocal");
        if (e.errore === "segreto") return tr("itg.sb.errSecret");
        if (e.errore === "pgcron") return tr("itg.sb.errPgcron");
        if (e.errore === "storage") return tr("itg.sb.errStorage").replace("{m}", e.messaggio ?? "");
        return tr("itg.sb.errSql").replace("{n}", e.numero ? ` (#${e.numero})` : "").replace("{m}", e.messaggio ?? "");
      }

      async function carica() {
        try {
          const res = await fetch("/api/admin/supabase-stato", { headers: await authFresh() });
          stato = res.ok ? ((await res.json()) as Stato) : null;
        } catch { stato = null; }
        renderCasella();
        renderModale();
      }

      /** Un passo. Le migrazioni tornano a pezzi: si richiama finche' ne restano. */
      async function esegui(passo: Passo): Promise<boolean> {
        for (;;) {
          mostraEsito("parz", passo === "migrazioni" && stato
            ? tr("itg.sb.migProgress").replace("{a}", String(stato.migrazioni.applicate)).replace("{t}", String(stato.migrazioni.totale))
            : tr("itg.sb.running").replace("{p}", passo));
          let r: { esito: Esito; stato: Stato } | null = null;
          try {
            const res = await fetch("/api/admin/supabase-stato", { method: "POST", headers: await authFresh(), body: JSON.stringify({ passo }) });
            r = (await res.json().catch(() => null)) as { esito: Esito; stato: Stato } | null;
          } catch { /* rete */ }
          if (!r?.esito) { mostraEsito("no", tr("err.network")); return false; }
          stato = r.stato;
          renderCasella();
          renderModale();
          if (!r.esito.ok) { mostraEsito("no", testoErrore(r.esito)); return false; }
          if (passo !== "migrazioni" || r.esito.restano <= 0) return true;
        }
      }

      /** Un lavoro alla volta: il bottone premuto mostra l'attesa (conAttesa),
       *  e finche' non finisce gli altri non partono. */
      async function blocca(bottone: HTMLButtonElement | null, fai: () => Promise<void>): Promise<void> {
        if (occupato || !bottone) return;
        occupato = true;
        try { await conAttesa(bottone, fai); } finally {
          occupato = false;
          renderModale();
        }
      }

      tile?.addEventListener("click", () => {
        if (overlay) overlay.hidden = false;
        mostraEsito("");
        void carica();
      });
      overlay?.querySelectorAll("[data-md-close]").forEach((el) => el.addEventListener("click", () => { if (overlay && !occupato) overlay.hidden = true; }));
      const verifica = $("sb-verifica") as HTMLButtonElement | null;
      verifica?.addEventListener("click", () => blocca(verifica, async () => { mostraEsito(""); await carica(); }));
      $("sb-controlli")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-passo]");
        if (!b) return;
        void blocca(b, async () => { if (await esegui(b.dataset.passo as Passo)) mostraEsito("ok", tr("itg.sb.done")); });
      });
      // «Tout préparer»: i passi nell'ordine giusto, solo quelli che servono.
      const tuttoBtn = $("sb-tutto") as HTMLButtonElement | null;
      tuttoBtn?.addEventListener("click", () => blocca(tuttoBtn, async () => {
        if (!stato) await carica();
        const ordine: Passo[] = ["estensioni", "migrazioni", "bucket", "cron"];
        for (const p of ordine) {
          const s = stato;
          if (!s) return;
          const serve = p === "estensioni" ? s.token && s.estensioni.livello !== "ok"
            : p === "migrazioni" ? s.token && s.migrazioni.livello !== "ok"
            : p === "bucket" ? s.bucket.livello !== "ok"
            : s.token && s.cron.livello !== "ok" && s.cron.motivo === "";
          if (serve && !(await esegui(p))) return;
          if (p === "estensioni" && serve) await carica();
        }
        await carica();
        mostraEsito(stato?.casella.livello === "ok" ? "ok" : "parz", stato?.casella.livello === "ok" ? tr("itg.sb.done") : tr("itg.sb.todo").replace("{n}", String(stato?.casella.daFare ?? 1)));
      }));

      void carica();
    </script>
    <!-- ===== INTÉGRATIONS → RESEND (5/11/2026) =====
         Chiave (cifrata nel database, mai rimostrata), mittente, dominio,
         e-mail di prova, email del mese. Script a parte come Supabase. -->
    <script>
      import { authFresh } from "../../lib/admin/auth";
      import { conAttesa } from "../../lib/admin/attesa";
      import { SEGNO, esito } from "../../lib/admin/casellaUi";
      import { esc } from "../../lib/esc";
      import { adminT, type AdminLang } from "../../i18n/admin";

      type Livello = "ok" | "parz" | "no" | "ignoto";
      type Fonte = "casella" | "env" | "nessuna";
      type Stato = {
        chiave: { fonte: Fonte; mascherata: string; rotta: boolean; inEnv: boolean; cifratura: boolean };
        mittente: { fonte: Fonte; nome: string; email: string; dallEnv: string };
        dominio: { nome: string; stato: "verificato" | "attesa" | "assente" | "ignoto" };
        conteggi: { mese: string; transazionali: number | null; newsletter: number | null };
        tabella: boolean;
        casella: { livello: Livello; daFare: number };
        io?: string;
      };
      type Esito = { ok: true } | { ok: false; errore: string; messaggio?: string };

      const lingua = document.documentElement.lang || "fr";
      const tr = adminT(lingua as AdminLang);
      const $ = (id: string) => document.getElementById(id);
      const overlay = $("rs-overlay");
      let stato: Stato | null = null;
      let occupato = false;
      let io = "";

      function renderCasella() {
        const segno = $("rs-segno");
        const pill = $("rs-pill");
        if (!segno || !pill) return;
        if (!stato) { segno.className = "itg-segno is-no"; segno.innerHTML = SEGNO.no; pill.className = "itg-pill is-no"; pill.textContent = tr("itg.sb.down"); return; }
        const { livello, daFare } = stato.casella;
        const l = livello === "ignoto" ? "parz" : livello;
        segno.className = `itg-segno is-${l}`;
        segno.innerHTML = SEGNO[l];
        pill.className = `itg-pill is-${l}`;
        pill.textContent = livello === "ok" ? tr("itg.rs.ok")
          : livello === "no" ? tr("itg.rs.off")
          : daFare <= 1 ? tr("itg.sb.todo1") : tr("itg.sb.todo").replace("{n}", String(daFare));
      }

      function chip(id: string, fonte: Fonte, rotta = false) {
        const el = $(id);
        if (!el) return;
        const [cls, testo] = rotta ? ["is-no", tr("itg.rs.srcBroken")]
          : fonte === "casella" ? ["is-set", tr("itg.rs.srcBox")]
          : fonte === "env" ? ["is-parz", tr("itg.rs.srcEnv")]
          : ["is-no", tr("itg.rs.srcNone")];
        el.className = `loc-chip ${cls}`;
        el.textContent = testo;
      }

      const numero = (n: number | null) => n === null ? "—" : n.toLocaleString(lingua);

      function renderModale() {
        if (!stato) return;
        const s = stato;
        chip("rs-chiave-stato", s.chiave.fonte, s.chiave.rotta);
        const inChiave = $("rs-chiave") as HTMLInputElement | null;
        if (inChiave) inChiave.placeholder = s.chiave.mascherata || tr("itg.rs.keyPh");
        const nota = $("rs-chiave-nota");
        if (nota) {
          const avviso = !s.tabella ? tr("itg.rs.noTable") : !s.chiave.cifratura ? tr("itg.rs.noCrypto") : s.chiave.rotta ? tr("itg.rs.keyBroken") : "";
          nota.textContent = avviso || tr("itg.rs.keyHint");
          nota.className = avviso ? "f-note is-avviso" : "f-note";
        }
        chip("rs-mitt-stato", s.mittente.fonte);
        const nome = $("rs-nome") as HTMLInputElement | null;
        const email = $("rs-email") as HTMLInputElement | null;
        if (nome && document.activeElement !== nome) nome.value = s.mittente.nome;
        if (email && document.activeElement !== email) email.value = s.mittente.email;

        const d = s.dominio;
        const dom = $("rs-dominio");
        if (dom) {
          const [cls, testo] = !d.nome ? ["is-no", tr("itg.rs.domNone")]
            : d.stato === "verificato" ? ["is-ok", tr("itg.rs.domOk")]
            : d.stato === "attesa" ? ["is-parz", tr("itg.rs.domWait")]
            : d.stato === "assente" ? ["is-no", tr("itg.rs.domMissing")]
            : ["", tr("itg.rs.domUnknown")];
          dom.className = `f-note rs-dominio ${cls}`.trim();
          dom.textContent = testo.replace("{d}", d.nome);
        }

        const c = s.conteggi;
        const tot = c.transazionali === null && c.newsletter === null ? null : (c.transazionali ?? 0) + (c.newsletter ?? 0);
        const conteggi = $("rs-conteggi");
        if (conteggi) conteggi.innerHTML = [
          [tr("itg.rs.trans"), numero(c.transazionali)],
          [tr("itg.rs.news"), numero(c.newsletter)],
          [`${tr("itg.rs.total")} · ${c.mese}`, numero(tot)],
        ].map(([k, v]) => `<span>${esc(k)}</span><span class="rs-n">${esc(v)}</span>`).join("");

        // «Importer» solo se il .env ha qualcosa che la casella non ha.
        const importa = $("rs-importa") as HTMLButtonElement | null;
        if (importa) importa.hidden = !((s.chiave.inEnv && s.chiave.fonte !== "casella") || (s.mittente.dallEnv && s.mittente.fonte !== "casella"));
        const togli = $("rs-togli") as HTMLButtonElement | null;
        if (togli) togli.hidden = s.chiave.fonte !== "casella" && s.mittente.fonte !== "casella";
        const prova = $("rs-prova") as HTMLButtonElement | null;
        if (prova) prova.disabled = occupato || s.chiave.fonte === "nessuna" || !s.mittente.email;
        aggiornaSalva();
      }

      /** Quello che «Enregistrer» scriverebbe adesso: vuoto = niente di nuovo. */
      function daSalvare(): Record<string, string> {
        const corpo: Record<string, string> = {};
        const k = ($("rs-chiave") as HTMLInputElement | null)?.value.trim() ?? "";
        const nome = ($("rs-nome") as HTMLInputElement | null)?.value.trim() ?? "";
        const email = ($("rs-email") as HTMLInputElement | null)?.value.trim() ?? "";
        if (k) corpo.chiave = k;
        // Il mittente si scrive se e' cambiato, o se oggi viene dal .env.
        if (email && (email !== stato?.mittente.email || nome !== stato?.mittente.nome || stato?.mittente.fonte !== "casella")) { corpo.nome = nome; corpo.email = email; }
        return corpo;
      }

      function aggiornaSalva() {
        const b = $("rs-salva") as HTMLButtonElement | null;
        if (b) b.disabled = occupato || !Object.keys(daSalvare()).length;
      }

      function mostraEsito(livello: "ok" | "parz" | "no" | "", testo = "") {
        esito("rs-esito", livello, testo);
      }

      function testoErrore(e: Exclude<Esito, { ok: true }>): string {
        if (e.errore === "chiave") return tr("itg.rs.errKey");
        if (e.errore === "email") return tr("itg.rs.errEmail");
        if (e.errore === "cifratura") return tr("itg.rs.noCrypto");
        if (e.errore === "tabella") return tr("itg.rs.noTable");
        if (e.errore === "invio") return tr("itg.rs.errSend").replace("{m}", e.messaggio ?? "");
        return tr("itg.rs.errNothing");
      }

      async function carica() {
        try {
          const res = await fetch("/api/admin/resend", { headers: await authFresh() });
          stato = res.ok ? ((await res.json()) as Stato) : null;
          if (stato?.io) io = stato.io;
        } catch { stato = null; }
        renderCasella();
        renderModale();
      }

      /** Una chiamata che cambia qualcosa: la risposta porta lo stato nuovo. */
      async function chiama(metodo: "PUT" | "POST" | "DELETE", corpo: unknown, riuscito: string): Promise<boolean> {
        let r: { esito?: Esito; stato?: Stato } | null = null;
        try {
          const res = await fetch("/api/admin/resend", { method: metodo, headers: await authFresh(), body: corpo === undefined ? undefined : JSON.stringify(corpo) });
          r = (await res.json().catch(() => null)) as { esito?: Esito; stato?: Stato } | null;
        } catch { /* rete */ }
        if (!r?.esito) { mostraEsito("no", tr("err.network")); return false; }
        if (r.stato) stato = r.stato;
        renderCasella();
        renderModale();
        if (!r.esito.ok) { mostraEsito("no", testoErrore(r.esito)); return false; }
        mostraEsito("ok", riuscito);
        return true;
      }

      async function blocca(bottone: HTMLButtonElement | null, fai: () => Promise<void>): Promise<void> {
        if (occupato || !bottone) return;
        occupato = true;
        try { await conAttesa(bottone, fai); } finally {
          occupato = false;
          renderModale();
        }
      }

      $("rs-tile")?.addEventListener("click", () => {
        if (overlay) overlay.hidden = false;
        mostraEsito("");
        const k = $("rs-chiave") as HTMLInputElement | null;
        if (k) k.value = "";
        void carica();
      });
      overlay?.querySelectorAll("[data-md-close]").forEach((el) => el.addEventListener("click", () => { if (overlay && !occupato) overlay.hidden = true; }));

      const salva = $("rs-salva") as HTMLButtonElement | null;
      salva?.addEventListener("click", () => blocca(salva, async () => {
        const corpo = daSalvare();
        if (!Object.keys(corpo).length) return;
        if (await chiama("PUT", corpo, tr("itg.rs.saved"))) {
          const k = $("rs-chiave") as HTMLInputElement | null;
          if (k) k.value = "";
          renderModale();
        }
      }));
      // «Enregistrer» si accende solo quando c'e' qualcosa di nuovo da scrivere.
      ["rs-chiave", "rs-nome", "rs-email"].forEach((id) => $(id)?.addEventListener("input", aggiornaSalva));

      const importa = $("rs-importa") as HTMLButtonElement | null;
      importa?.addEventListener("click", () => blocca(importa, async () => { await chiama("POST", { azione: "importa" }, tr("itg.rs.imported")); }));

      const prova = $("rs-prova") as HTMLButtonElement | null;
      prova?.addEventListener("click", () => blocca(prova, async () => { await chiama("POST", { azione: "prova" }, tr("itg.rs.testOk").replace("{e}", io)); }));

      // «Supprimer» chiede conferma sul bottone stesso: il primo clic cambia
      // la scritta, il secondo (entro 4 s) toglie.
      const togli = $("rs-togli") as HTMLButtonElement | null;
      let conferma = 0;
      togli?.addEventListener("click", () => {
        if (!togli) return;
        if (Date.now() > conferma) {
          conferma = Date.now() + 4000;
          togli.textContent = tr("itg.rs.delConfirm");
          setTimeout(() => { if (Date.now() >= conferma) togli.textContent = tr("common.delete"); }, 4100);
          return;
        }
        conferma = 0;
        togli.textContent = tr("common.delete");
        void blocca(togli, async () => { await chiama("DELETE", undefined, tr("itg.rs.deleted")); });
      });

      void carica();
    </script>
    <!-- ===== INTÉGRATIONS → STRIPE (5/11/2026) =====
         Chiave e webhook per livello (marchio, sedi), conto, webhook creato
         dalla casella. La scheda della sede apre qui con «apri-stripe». -->
    <script>
      import { authFresh } from "../../lib/admin/auth";
      import { conAttesa } from "../../lib/admin/attesa";
      import { SEGNO, esito } from "../../lib/admin/casellaUi";
      import { esc } from "../../lib/esc";
      import { adminT, type AdminLang } from "../../i18n/admin";

      type Livello = "ok" | "parz" | "no" | "ignoto";
      type Fonte = "sede" | "marchio" | "ambiente" | "nessuna";
      type Riep = { id: string; nome: string; fonteChiave: Fonte; fonteFirma: Fonte; pronto: boolean };
      type VoceConto = { id: string; nome: string; pronto: boolean; attivo: boolean; modo: "live" | "test" | "" };
      type Scelto = Riep & {
        conto: string; conti: VoceConto[]; nomeConto: string;
        propriaChiave: "suo" | "rotto" | ""; propriaFirma: "suo" | "rotto" | "";
        mascherata: string; modo: "live" | "test" | "";
        verifica: { conto: { nome: string; paese: string; incassi: boolean } | null; errore: string;
          webhook: { stato: "ok" | "eventi" | "spento" | "assente" | "ignoto"; url: string; domini: string[] } } | null;
      };
      type Stato = {
        livelli: Riep[];
        casella: { livello: Livello; pronti: number; totale: number; daEnv: boolean };
        scelto: Scelto | null;
        env: { chiave: boolean; firma: boolean };
        cifratura: boolean; tabella: boolean; tabellaConti: boolean; sito: { online: boolean };
      };
      type Esito = { ok: true; conto?: string } | { ok: false; errore: string; messaggio?: string };

      const tr = adminT((document.documentElement.lang || "fr") as AdminLang);
      const $ = (id: string) => document.getElementById(id);
      const overlay = $("sp-overlay");
      let stato: Stato | null = null;
      let livello = "marchio";
      /** Il conto aperto dentro il livello: "principale", un id, o "nuovo". */
      let conto = "principale";
      let occupato = false;

      function renderCasella() {
        const segno = $("sp-segno");
        const pill = $("sp-pill");
        if (!segno || !pill) return;
        if (!stato) { segno.className = "itg-segno is-no"; segno.innerHTML = SEGNO.no; pill.className = "itg-pill is-no"; pill.textContent = tr("itg.sb.down"); return; }
        const c = stato.casella;
        const l = c.livello === "ignoto" ? "parz" : c.livello;
        segno.className = `itg-segno is-${l}`;
        segno.innerHTML = SEGNO[l];
        pill.className = `itg-pill is-${l}`;
        pill.textContent = c.livello === "no" ? tr("itg.st.off")
          : c.pronti < c.totale ? tr("itg.st.part").replace("{a}", String(c.pronti)).replace("{t}", String(c.totale))
          : c.daEnv ? tr("itg.st.viaEnv") : tr("itg.st.ok");
      }

      const nomeFonte = (f: Fonte) => f === "sede" ? tr("itg.st.fromSede") : f === "marchio" ? tr("itg.st.fromBrand") : f === "ambiente" ? tr("itg.st.fromEnv") : tr("itg.st.fromNone");

      /** Il chip di un campo: suo, ereditato, dal .env, assente, illeggibile. */
      function chip(id: string, proprio: "suo" | "rotto" | "", fonte: Fonte) {
        const el = $(id);
        if (!el) return;
        const [cls, testo] = proprio === "rotto" ? ["is-no", tr("itg.rs.srcBroken")]
          : proprio === "suo" ? ["is-set", livello === "marchio" && conto === "principale" ? tr("itg.rs.srcBox") : tr("itg.st.srcOwn")]
          : fonte === "marchio" ? ["is-parz", tr("itg.st.srcBrand")]
          : fonte === "ambiente" ? ["is-parz", tr("itg.rs.srcEnv")]
          : ["is-no", tr("itg.rs.srcNone")];
        el.className = `loc-chip ${cls}`;
        el.textContent = testo;
      }

      /** Cos'e' un livello, in una frase: il marchio fa da conto di base,
       *  una sede incassa col suo conto, con quello del marchio, o non incassa. */
      function spiegazione(l: Riep, conSedi: boolean): string {
        if (l.id === "marchio") return conSedi ? tr("itg.st.lvBrand") : "";
        if (!l.pronto) return tr("itg.st.lvOff");
        if (l.fonteChiave === "sede") return tr("itg.st.lvOwn");
        if (l.fonteChiave === "marchio") return tr("itg.st.lvBrandUse");
        return tr("itg.st.lvEnv");
      }

      function riga(lv: Livello, titolo: string, dettaglio: string, bottone = ""): string {
        return `<li><span class="sb-ic is-${lv}">${SEGNO[lv]}</span><div><p class="sb-t">${titolo}</p><p class="sb-d">${dettaglio}</p></div>${bottone || "<span></span>"}</li>`;
      }

      function renderModale() {
        if (!stato) return;
        const s = stato;
        // Le pillole: solo se ci sono sedi.
        const pillole = $("sp-pillole");
        if (pillole) {
          pillole.hidden = s.livelli.length <= 1;
          pillole.innerHTML = s.livelli.map((l) => {
            const lv = l.pronto ? "ok" : "no";
            return `<button type="button" class="m-tab${l.id === livello ? " is-on" : ""}" data-livello="${esc(l.id)}" title="${esc(spiegazione(l, s.livelli.length > 1))}"><span class="sp-punto is-${lv}"></span>${esc(l.id === "marchio" ? tr("itg.st.brand") : l.nome)}</button>`;
          }).join("");
        }
        const sc = s.scelto;
        if (!sc) return;
        conto = sc.conto;
        // La fila dei conti: nome, pallino pronto/no, «actif» su quello che incassa.
        const fila = $("sp-conti");
        if (fila) {
          const voci = sc.conti.map((c) => `<button type="button" class="m-tab${c.id === conto ? " is-on" : ""}" data-conto="${esc(c.id)}"><span class="sp-punto is-${c.pronto ? "ok" : "no"}"></span>${esc(c.id === "principale" ? tr("itg.st.accMain") : c.nome)}${c.attivo ? `<span class="sp-attivo">${esc(tr("itg.st.accActive"))}</span>` : ""}</button>`);
          if (s.tabellaConti) voci.push(`<button type="button" class="m-tab${conto === "nuovo" ? " is-on" : ""}" data-conto="nuovo">${esc(tr("itg.st.accAdd"))}</button>`);
          fila.innerHTML = voci.join("");
        }
        const nomeCampo = $("sp-nome-campo");
        if (nomeCampo) nomeCampo.hidden = conto === "principale";
        const nome = $("sp-nome") as HTMLInputElement | null;
        if (nome && document.activeElement !== nome) nome.value = sc.nomeConto;
        // Una frase che dice cos'e' la pillola scelta e con che conto incassa.
        const spiega = $("sp-spiega");
        if (spiega) {
          spiega.hidden = s.livelli.length <= 1;
          spiega.textContent = spiegazione(s.livelli.find((l) => l.id === livello) ?? sc, true);
          spiega.className = `f-note sp-spiega${sc.id !== "marchio" && !sc.pronto ? " is-avviso" : ""}`;
        }
        chip("sp-chiave-stato", sc.propriaChiave, sc.fonteChiave);
        chip("sp-firma-stato", sc.propriaFirma, sc.fonteFirma);
        const k = $("sp-chiave") as HTMLInputElement | null;
        if (k) k.placeholder = sc.mascherata || tr("itg.st.keyPh");
        const nota = $("sp-nota");
        if (nota) {
          const avviso = !s.tabella && livello === "marchio" ? tr("itg.rs.noTable") : !s.cifratura ? tr("itg.rs.noCrypto") : "";
          nota.textContent = avviso || tr("itg.st.keyHint");
          nota.className = avviso ? "f-note is-avviso" : "f-note";
        }

        // Controlli: conto, webhook, pagamento online.
        const v = sc.verifica;
        const modo = sc.modo ? `<span class="sp-modo${sc.modo === "live" ? " is-live" : ""}">${sc.modo.toUpperCase()}</span>` : "";
        const cConto: [Livello, string] = !sc.mascherata ? ["no", esc(tr("itg.st.accountNone"))]
          : v?.conto ? [v.conto.incassi ? "ok" : "parz", `<b>${esc(v.conto.nome)}</b>${v.conto.paese ? ` · ${esc(v.conto.paese)}` : ""}${modo}${v.conto.incassi ? "" : ` · ${esc(tr("itg.st.noCharges"))}`}`]
          : ["no", esc(tr("itg.st.accountKo").replace("{m}", v?.errore ?? ""))];
        const w = v?.webhook;
        const wst = w?.stato ?? "ignoto";
        const cHook: [Livello, string] = wst === "ok" ? ["ok", esc(s.sito.online ? tr("itg.st.whOk").replace("{u}", w?.url ?? "") : tr("itg.st.whLocal").replace("{d}", (w?.domini ?? []).join(", ")))]
          : wst === "eventi" ? ["parz", esc(tr("itg.st.whEvents"))]
          : wst === "spento" ? ["no", esc(tr("itg.st.whOff"))]
          : wst === "assente" ? ["no", esc(tr("itg.st.whMissing"))]
          : ["ignoto", esc(tr("itg.st.whUnknown"))];
        // «Créer» solo online e con una chiave propria; «Recréer» se c'e' gia'.
        const puoCreare = s.sito.online && sc.propriaChiave === "suo" && !occupato;
        const btnHook = puoCreare
          ? `<button type="button" class="btn" data-azione="webhook">${esc(wst === "ok" && sc.propriaFirma === "suo" ? tr("itg.st.whRecreate") : tr("itg.st.whCreate"))}</button>` : "";
        const cPaga: [Livello, string] = sc.pronto ? ["ok", esc(tr("itg.st.payOk").replace("{a}", nomeFonte(sc.fonteChiave)))]
          : sc.fonteChiave !== "nessuna" && sc.fonteFirma !== "nessuna" ? ["no", esc(tr("itg.st.payMix").replace("{a}", nomeFonte(sc.fonteChiave)).replace("{b}", nomeFonte(sc.fonteFirma)))]
          : ["no", esc(tr("itg.st.payNone"))];
        const controlli = $("sp-controlli");
        if (controlli) controlli.innerHTML = [
          riga(cConto[0], esc(tr("itg.st.account")), cConto[1]),
          riga(cHook[0], esc(tr("itg.st.webhook")), cHook[1], btnHook),
          riga(cPaga[0], esc(tr("itg.st.pay")), cPaga[1]),
        ].join("");

        const importa = $("sp-importa") as HTMLButtonElement | null;
        if (importa) importa.hidden = !(livello === "marchio" && conto === "principale" && ((s.env.chiave && sc.propriaChiave !== "suo") || (s.env.firma && sc.propriaFirma !== "suo")));
        const togli = $("sp-togli") as HTMLButtonElement | null;
        if (togli) togli.hidden = conto === "nuovo" || (conto === "principale" && !sc.propriaChiave && !sc.propriaFirma);
        const verificaBtn = $("sp-verifica") as HTMLButtonElement | null;
        if (verificaBtn) verificaBtn.hidden = conto === "nuovo";
        // Un conto nuovo non ha ancora niente da controllare.
        const controlliEl = $("sp-controlli");
        if (controlliEl && conto === "nuovo") controlliEl.innerHTML = "";
        aggiornaSalva();
      }

      function aggiornaSalva() {
        const b = $("sp-salva") as HTMLButtonElement | null;
        const k = ($("sp-chiave") as HTMLInputElement | null)?.value.trim();
        const f = ($("sp-firma") as HTMLInputElement | null)?.value.trim();
        const n = ($("sp-nome") as HTMLInputElement | null)?.value.trim() ?? "";
        const nomeCambiato = conto !== "principale" && !!n && n !== (stato?.scelto?.nomeConto ?? "");
        if (b) b.disabled = occupato || (conto === "nuovo" ? !n || !k : !k && !f && !nomeCambiato);
      }

      function mostraEsito(lv: "ok" | "parz" | "no" | "", testo = "") {
        esito("sp-esito", lv, testo);
      }

      function testoErrore(e: Exclude<Esito, { ok: true }>): string {
        const m: Record<string, string> = {
          livello: "itg.st.errLevel", chiave: "itg.st.errKey", pubblicabile: "itg.st.errPk", firma: "itg.st.errHook",
          cifratura: "itg.rs.noCrypto", tabella: "itg.rs.noTable", localhost: "itg.st.errLocal", ereditata: "itg.st.errInherited",
          niente: "itg.rs.errNothing", nome: "itg.st.errName", conto: "itg.st.errConto",
        };
        if (e.errore === "stripe") return tr("itg.st.errStripe").replace("{m}", e.messaggio ?? "");
        return tr(m[e.errore] ?? "itg.rs.errNothing");
      }

      function svuotaCampi() {
        for (const id of ["sp-chiave", "sp-firma", "sp-nome"]) { const el = $(id) as HTMLInputElement | null; if (el) el.value = ""; }
      }

      async function carica(conLivello = true) {
        try {
          const q = conLivello ? `?livello=${encodeURIComponent(livello)}&conto=${encodeURIComponent(conto)}` : "";
          const res = await fetch(`/api/admin/stripe${q}`, { headers: await authFresh() });
          stato = res.ok ? ((await res.json()) as Stato) : null;
        } catch { stato = null; }
        renderCasella();
        renderModale();
      }

      async function chiama(metodo: "PUT" | "POST" | "DELETE", corpo: unknown, riuscito: string): Promise<boolean> {
        let r: { esito?: Esito; stato?: Stato } | null = null;
        try {
          const res = await fetch("/api/admin/stripe", { method: metodo, headers: await authFresh(), body: JSON.stringify(corpo) });
          r = (await res.json().catch(() => null)) as { esito?: Esito; stato?: Stato } | null;
        } catch { /* rete */ }
        if (!r?.esito) { mostraEsito("no", tr("err.network")); return false; }
        if (r.stato) stato = r.stato;
        renderCasella();
        renderModale();
        if (!r.esito.ok) { mostraEsito("no", testoErrore(r.esito)); return false; }
        mostraEsito("ok", riuscito);
        return true;
      }

      async function blocca(bottone: HTMLButtonElement | null, fai: () => Promise<void>): Promise<void> {
        if (occupato || !bottone) return;
        occupato = true;
        try { await conAttesa(bottone, fai); } finally {
          occupato = false;
          renderModale();
        }
      }

      function apri(su: string) {
        livello = su;
        conto = "principale";
        if (overlay) overlay.hidden = false;
        mostraEsito("");
        svuotaCampi();
        void carica();
      }

      $("sp-tile")?.addEventListener("click", () => apri("marchio"));
      // Dalla scheda di una sede: «Ouvrir Stripe» apre sulla sua pillola.
      document.addEventListener("apri-stripe", (ev) => apri(String((ev as CustomEvent).detail ?? "marchio")));
      overlay?.querySelectorAll("[data-md-close]").forEach((el) => el.addEventListener("click", () => { if (overlay && !occupato) overlay.hidden = true; }));
      ["sp-chiave", "sp-firma", "sp-nome"].forEach((id) => $(id)?.addEventListener("input", aggiornaSalva));

      $("sp-pillole")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-livello]");
        if (!b || occupato || b.dataset.livello === livello) return;
        livello = b.dataset.livello ?? "marchio";
        conto = "principale";
        mostraEsito("");
        svuotaCampi();
        renderModale();
        void blocca(b, async () => { await carica(); });
      });

      $("sp-conti")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-conto]");
        if (!b || occupato || b.dataset.conto === conto) return;
        conto = b.dataset.conto ?? "principale";
        mostraEsito("");
        svuotaCampi();
        void blocca(b, async () => { await carica(); });
      });

      const salva = $("sp-salva") as HTMLButtonElement | null;
      salva?.addEventListener("click", () => blocca(salva, async () => {
        const chiave = ($("sp-chiave") as HTMLInputElement | null)?.value.trim() ?? "";
        const firma = ($("sp-firma") as HTMLInputElement | null)?.value.trim() ?? "";
        const nome = ($("sp-nome") as HTMLInputElement | null)?.value.trim() ?? "";
        if (await chiama("PUT", { livello, conto, nome: conto === "principale" ? undefined : nome, chiave, firma }, tr("itg.st.saved"))) svuotaCampi();
      }));

      const verifica = $("sp-verifica") as HTMLButtonElement | null;
      verifica?.addEventListener("click", () => blocca(verifica, async () => { mostraEsito(""); await carica(); }));

      const importa = $("sp-importa") as HTMLButtonElement | null;
      importa?.addEventListener("click", () => blocca(importa, async () => { await chiama("POST", { azione: "importa", livello: "marchio" }, tr("itg.st.imported")); }));

      $("sp-controlli")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-azione=webhook]");
        if (!b) return;
        void blocca(b, async () => { await chiama("POST", { azione: "webhook", livello, conto }, tr("itg.st.whDone")); });
      });

      // «Supprimer»: conferma sul bottone stesso, come nella casella Resend.
      const togli = $("sp-togli") as HTMLButtonElement | null;
      let conferma = 0;
      togli?.addEventListener("click", () => {
        if (!togli) return;
        if (Date.now() > conferma) {
          conferma = Date.now() + 4000;
          togli.textContent = tr("itg.rs.delConfirm");
          setTimeout(() => { if (Date.now() >= conferma) togli.textContent = tr("common.delete"); }, 4100);
          return;
        }
        conferma = 0;
        togli.textContent = tr("common.delete");
        void blocca(togli, async () => { await chiama("DELETE", { livello, conto }, conto === "principale" ? tr("itg.st.deleted") : tr("itg.st.accDeleted")); });
      });

      // La casella si colora subito, senza chiamare Stripe (solo il riepilogo).
      void carica(false);
    </script>
    <!-- ===== INTÉGRATIONS → GOOGLE BUSINESS (5/11/2026) =====
         Account Google (uno), e per livello Place ID, link recensioni,
         scheda, recensioni. La scheda della sede apre qui con «apri-google». -->
    <script>
      import { authFresh } from "../../lib/admin/auth";
      import { conAttesa } from "../../lib/admin/attesa";
      import { SEGNO, esito } from "../../lib/admin/casellaUi";
      import { esc } from "../../lib/esc";
      import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";

      type Livello = "ok" | "parz" | "no" | "ignoto";
      type Liv = {
        id: string; nome: string; placeId: string; placeProprio: boolean; link: string; linkProprio: boolean;
        scheda: string; schedaPropria: boolean; pronto: boolean; linkGenerato: string;
        sync: { il: string; voto: string; recensioni: string };
      };
      type Stato = {
        oauth: { stato: "spento" | "mai" | "scaduto" | "incerto" | "ok"; configurato: boolean };
        places: boolean;
        livelli: Liv[];
        casella: { livello: Livello; pronti: number; totale: number };
      };
      type Esito = { ok: true; generato?: boolean } | { ok: false; errore: string; messaggio?: string };

      const lingua = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(lingua);
      const $ = (id: string) => document.getElementById(id);
      const overlay = $("gb-overlay");
      let stato: Stato | null = null;
      let livello = "marchio";
      let occupato = false;

      const conSedi = () => (stato?.livelli.length ?? 1) > 1;
      const scelto = (): Liv | null => stato?.livelli.find((l) => l.id === livello) ?? null;

      function renderCasella() {
        const segno = $("gb-segno");
        const pill = $("gb-pill");
        if (!segno || !pill) return;
        if (!stato) { segno.className = "itg-segno is-no"; segno.innerHTML = SEGNO.no; pill.className = "itg-pill is-no"; pill.textContent = tr("itg.sb.down"); return; }
        const c = stato.casella;
        segno.className = `itg-segno is-${c.livello}`;
        segno.innerHTML = SEGNO[c.livello];
        pill.className = `itg-pill is-${c.livello}`;
        pill.textContent = c.livello === "no" ? tr("itg.gb.off")
          : c.pronti < c.totale ? tr("itg.st.part").replace("{a}", String(c.pronti)).replace("{t}", String(c.totale))
          : tr("itg.gb.ok");
      }

      /** Un chip: suo, ereditato dal marchio, assente. */
      function chip(id: string, valore: string, proprio: boolean) {
        const el = $(id);
        if (!el) return;
        const [cls, testo] = !valore ? ["is-no", tr("itg.rs.srcNone")]
          : livello === "marchio" || proprio ? ["is-set", livello === "marchio" ? tr("itg.rs.srcBox") : tr("itg.st.srcOwn")]
          : ["is-parz", tr("itg.st.srcBrand")];
        el.className = `loc-chip ${cls}`;
        el.textContent = testo;
      }

      function riga(lv: Livello, titolo: string, dettaglio: string, bottone = ""): string {
        return `<li><span class="sb-ic is-${lv}">${SEGNO[lv]}</span><div><p class="sb-t">${esc(titolo)}</p><p class="sb-d">${dettaglio}</p></div>${bottone || "<span></span>"}</li>`;
      }

      function renderModale() {
        if (!stato) return;
        const s = stato;
        // L'account Google.
        const o = s.oauth;
        const oauth = $("gb-oauth");
        if (oauth) {
          const [cls, testo] = o.stato === "ok" ? ["is-set", tr("itg.g.connected")]
            : o.stato === "scaduto" ? ["is-no", tr("itg.gb.expired")]
            : o.stato === "incerto" ? ["is-parz", tr("itg.gb.uncertain")]
            : o.stato === "spento" ? ["is-parz", tr("itg.gb.notReady")]
            : ["is-parz", tr("itg.g.off")];
          oauth.className = `loc-chip ${cls}`;
          oauth.textContent = testo;
        }
        const connetti = $("gb-connetti") as HTMLButtonElement | null;
        if (connetti) {
          connetti.disabled = occupato || !o.configurato;
          connetti.textContent = o.stato === "ok" || o.stato === "scaduto" ? tr("itg.g.reconnect") : tr("itg.g.connect");
        }
        const scollega = $("gb-scollega") as HTMLButtonElement | null;
        if (scollega) scollega.hidden = o.stato === "mai" || o.stato === "spento";
        const nota = $("gb-oauth-nota");
        if (nota) nota.textContent = !o.configurato ? tr("itg.g.pending") : o.stato === "ok" ? tr("itg.g.connectedNote") : o.stato === "scaduto" ? tr("itg.gb.expiredHint") : tr("itg.g.authNote");

        // Le pillole dei livelli (solo con le sedi).
        const pillole = $("gb-pillole");
        if (pillole) {
          pillole.hidden = !conSedi();
          pillole.innerHTML = s.livelli.map((l) => `<button type="button" class="m-tab${l.id === livello ? " is-on" : ""}" data-livello="${esc(l.id)}"><span class="sp-punto is-${l.pronto ? "ok" : "no"}"></span>${esc(l.id === "marchio" ? tr("itg.st.brand") : l.nome)}</button>`).join("");
        }
        const l = scelto();
        if (!l) return;
        const spiega = $("gb-spiega");
        if (spiega) {
          spiega.hidden = !conSedi();
          spiega.textContent = l.id === "marchio" ? tr("itg.gb.lvBrand") : l.pronto ? tr("itg.gb.lvOk") : tr("itg.gb.lvTodo");
          spiega.className = `f-note sp-spiega${l.id !== "marchio" && !l.pronto ? " is-avviso" : ""}`;
        }
        chip("gb-place-stato", l.placeId, l.placeProprio);
        chip("gb-link-stato", l.link, l.linkProprio);
        const place = $("gb-place") as HTMLInputElement | null;
        const link = $("gb-link") as HTMLInputElement | null;
        // Il campo mostra il valore SUO; un valore ereditato sta nel segnaposto.
        if (place && document.activeElement !== place) { place.value = l.placeProprio ? l.placeId : ""; place.placeholder = l.placeProprio || !l.placeId ? "ChIJ…" : l.placeId; }
        if (link && document.activeElement !== link) { link.value = l.linkProprio ? l.link : ""; link.placeholder = l.linkProprio || !l.link ? "https://…" : l.link; }
        const gen = $("gb-link-gen") as HTMLButtonElement | null;
        if (gen) gen.hidden = !l.linkGenerato || (l.linkProprio && l.link === l.linkGenerato);

        // Controlli: scheda Google e recensioni.
        const collegato = s.oauth.stato === "ok";
        const dScheda = !collegato ? esc(tr("itg.gb.needAccount"))
          : l.scheda ? `<b>${esc(l.scheda)}</b>${l.id !== "marchio" && !l.schedaPropria ? ` · ${esc(tr("itg.st.srcBrand"))}` : ""}`
          : esc(tr("itg.gb.noListing"));
        const lvScheda: Livello = !collegato ? "ignoto" : l.scheda && (l.id === "marchio" || l.schedaPropria || !conSedi()) ? "ok" : "no";
        const btnScheda = collegato ? `<button type="button" class="btn" data-azione="schede">${esc(tr("gg.change"))}</button>` : "";
        const quando = l.sync.il ? new Date(l.sync.il).toLocaleString(ADMIN_LOCALE[lingua] ?? "fr-BE", { dateStyle: "short", timeStyle: "short" }) : "";
        const vecchio = l.sync.il ? Date.now() - new Date(l.sync.il).getTime() > 3 * 3600_000 : true;
        const dRec = !l.sync.il ? esc(tr("itg.gb.neverSynced"))
          : `${esc(tr("itg.gb.lastSync").replace("{d}", quando))}${l.sync.voto ? ` · <b>${esc(Number(l.sync.voto).toLocaleString(lingua, { maximumFractionDigits: 1 }))}/5</b>` : ""}${l.sync.recensioni ? ` · ${esc(l.sync.recensioni)} ${esc(tr("itg.g.reviews"))}` : ""}`;
        const lvRec: Livello = !collegato || !l.scheda ? "ignoto" : !l.sync.il ? "no" : vecchio ? "parz" : "ok";
        const btnSync = collegato && l.scheda ? `<button type="button" class="btn" data-azione="sync">${esc(tr("itg.gb.syncNow"))}</button>` : "";
        const controlli = $("gb-controlli");
        if (controlli) controlli.innerHTML = [
          riga(lvScheda, tr("itg.gb.listing"), dScheda, btnScheda),
          riga(lvRec, tr("itg.gb.reviews"), dRec, btnSync),
        ].join("");
        aggiornaSalva();
      }

      function daSalvare(): Record<string, string> {
        const l = scelto();
        const corpo: Record<string, string> = {};
        if (!l) return corpo;
        const place = ($("gb-place") as HTMLInputElement | null)?.value.trim() ?? "";
        const link = ($("gb-link") as HTMLInputElement | null)?.value.trim() ?? "";
        if (place !== (l.placeProprio ? l.placeId : "")) corpo.place_id = place;
        if (link !== (l.linkProprio ? l.link : "")) corpo.review_url = link;
        return corpo;
      }

      function aggiornaSalva() {
        const b = $("gb-salva") as HTMLButtonElement | null;
        if (b) b.disabled = occupato || !Object.keys(daSalvare()).length;
      }

      function mostraEsito(lv: "ok" | "parz" | "no" | "", testo = "") {
        esito("gb-esito", lv, testo);
      }

      function testoErrore(e: Exclude<Esito, { ok: true }>): string {
        if (e.errore === "chiave") return tr("itg.g.isKey");
        if (e.errore === "formato") return tr("loc.err.placeId");
        if (e.errore === "link") return tr("itg.gb.errLink");
        if (e.errore === "sync") return tr("itg.gb.errSync").replace("{m}", e.messaggio ?? "");
        if (e.errore === "livello") return tr("itg.st.errLevel");
        if (e.errore === "niente") return tr("itg.rs.errNothing");
        return e.messaggio || tr("err.network");
      }

      async function carica() {
        try {
          const res = await fetch("/api/admin/google-casella", { headers: await authFresh() });
          stato = res.ok ? ((await res.json()) as Stato) : null;
        } catch { stato = null; }
        if (stato && !stato.livelli.some((l) => l.id === livello)) livello = "marchio";
        renderCasella();
        renderModale();
      }

      async function chiama(metodo: "PUT" | "POST", corpo: unknown, riuscito: string): Promise<Esito | null> {
        let r: { esito?: Esito; stato?: Stato } | null = null;
        try {
          const res = await fetch("/api/admin/google-casella", { method: metodo, headers: await authFresh(), body: JSON.stringify(corpo) });
          r = (await res.json().catch(() => null)) as { esito?: Esito; stato?: Stato } | null;
        } catch { /* rete */ }
        if (!r?.esito) { mostraEsito("no", tr("err.network")); return null; }
        if (r.stato) stato = r.stato;
        renderCasella();
        renderModale();
        if (!r.esito.ok) { mostraEsito("no", testoErrore(r.esito)); return r.esito; }
        mostraEsito("ok", riuscito);
        return r.esito;
      }

      async function blocca(bottone: HTMLButtonElement | null, fai: () => Promise<void>): Promise<void> {
        if (occupato || !bottone) return;
        occupato = true;
        try { await conAttesa(bottone, fai); } finally {
          occupato = false;
          renderModale();
        }
      }

      function svuota() {
        for (const id of ["gb-place", "gb-link"]) { const el = $(id) as HTMLInputElement | null; if (el) el.value = ""; }
        const res = $("gb-place-res"); if (res) res.textContent = tr("loc.placeIdHint");
        const sc = $("gb-schede"); if (sc) sc.innerHTML = "";
      }

      function apri(su: string) {
        livello = su;
        if (overlay) overlay.hidden = false;
        mostraEsito("");
        svuota();
        void carica();
      }

      $("gb-tile")?.addEventListener("click", () => apri("marchio"));
      document.addEventListener("apri-google", (ev) => apri(String((ev as CustomEvent).detail ?? "marchio")));
      overlay?.querySelectorAll("[data-md-close]").forEach((el) => el.addEventListener("click", () => { if (overlay && !occupato) overlay.hidden = true; }));
      ["gb-place", "gb-link"].forEach((id) => $(id)?.addEventListener("input", aggiornaSalva));

      $("gb-pillole")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-livello]");
        if (!b || occupato || b.dataset.livello === livello) return;
        livello = b.dataset.livello ?? "marchio";
        mostraEsito("");
        // Il cambio di pillola non chiede niente al server: e' tutto gia' qui.
        const res = $("gb-place-res"); if (res) res.textContent = tr("loc.placeIdHint");
        const sc = $("gb-schede"); if (sc) sc.innerHTML = "";
        for (const id of ["gb-place", "gb-link"]) { const el = $(id) as HTMLInputElement | null; if (el) el.blur(); }
        renderModale();
      });

      // Il collegamento: la stessa API di prima, poi la schermata di Google.
      const connetti = $("gb-connetti") as HTMLButtonElement | null;
      connetti?.addEventListener("click", () => blocca(connetti, async () => {
        try {
          const res = await fetch("/api/google/connect", { method: "POST", headers: await authFresh() });
          const j = await res.json().catch(() => ({}));
          if (!res.ok || !j.url) { mostraEsito("no", String(j.error ?? tr("itg.g.connErr"))); return; }
          window.location.href = j.url;
        } catch { mostraEsito("no", tr("err.network")); }
      }));
      const scollega = $("gb-scollega") as HTMLButtonElement | null;
      scollega?.addEventListener("click", () => blocca(scollega, async () => {
        try {
          const res = await fetch("/api/google/connect", { method: "POST", headers: await authFresh({ "X-Method-Override": "DELETE" }) });
          if (!res.ok) { mostraEsito("no", tr("itg.g.disErr")); return; }
          mostraEsito("ok", tr("itg.g.disconnected"));
          await carica();
        } catch { mostraEsito("no", tr("err.network")); }
      }));

      // «Vérifier» il Place ID scritto (o quello che vale qui).
      const verifica = $("gb-verifica") as HTMLButtonElement | null;
      verifica?.addEventListener("click", () => blocca(verifica, async () => {
        const res = $("gb-place-res");
        const id = (($("gb-place") as HTMLInputElement | null)?.value.trim()) || scelto()?.placeId || "";
        if (!res) return;
        if (!id) { res.textContent = tr("itg.g.needPlace"); return; }
        if (/^AIza/.test(id)) { res.textContent = tr("itg.g.isKeyShort"); return; }
        try {
          const r = await fetch(`/api/admin/google-place?place_id=${encodeURIComponent(id)}`, { headers: await authFresh() });
          const j = await r.json().catch(() => ({}));
          res.textContent = r.ok ? `${j.name} — ${j.rating ?? "?"}/5 · ${j.reviews ?? 0} ${tr("itg.g.reviews")}` : String(j.error ?? tr("itg.g.verifyErr"));
        } catch { res.textContent = tr("err.network"); }
      }));

      const gen = $("gb-link-gen") as HTMLButtonElement | null;
      gen?.addEventListener("click", () => {
        const l = scelto();
        const link = $("gb-link") as HTMLInputElement | null;
        if (l && link) { link.value = l.linkGenerato; aggiornaSalva(); }
      });

      const salva = $("gb-salva") as HTMLButtonElement | null;
      salva?.addEventListener("click", () => blocca(salva, async () => {
        const corpo = daSalvare();
        if (!Object.keys(corpo).length) return;
        const e = await chiama("PUT", { livello, ...corpo }, tr("itg.st.saved"));
        if (e?.ok && e.generato) mostraEsito("ok", tr("itg.gb.savedGen"));
      }));

      // La scheda: si sceglie con la stessa API della scheda della sede.
      const urlSchede = () => "/api/admin/google/locations" + (livello !== "marchio" ? `?sede=${encodeURIComponent(livello)}` : "");
      $("gb-controlli")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-azione]");
        if (!b) return;
        if (b.dataset.azione === "sync") {
          void blocca(b, async () => { await chiama("POST", { livello, azione: "sync" }, tr("itg.gb.synced")); });
          return;
        }
        void blocca(b, async () => {
          const box = $("gb-schede");
          if (!box) return;
          try {
            const res = await fetch(urlSchede(), { headers: await authFresh() });
            const j = await res.json();
            if (j.error) { mostraEsito("no", String(j.error)); return; }
            const schede = (j.sedi ?? []) as { path: string; title: string; address: string }[];
            const cur = j.current?.path ?? "";
            if (!schede.length) { mostraEsito("parz", tr("itg.gb.noListings")); return; }
            box.innerHTML = schede.map((sd) => `<button type="button" class="btn gb-scheda${sd.path === cur ? " is-on" : ""}" data-path="${esc(sd.path)}" data-title="${esc(sd.title)}">${esc(sd.title || sd.path)}${sd.address ? ` — <span class="note">${esc(sd.address)}</span>` : ""}</button>`).join("");
          } catch { mostraEsito("no", tr("err.network")); }
        });
      });
      $("gb-schede")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest<HTMLButtonElement>(".gb-scheda");
        if (!b) return;
        const su = livello;
        void blocca(b, async () => {
          try {
            const res = await fetch("/api/admin/google/locations", {
              method: "POST", headers: await authFresh(),
              body: JSON.stringify({ path: b.dataset.path ?? "", title: b.dataset.title ?? "", ...(su !== "marchio" ? { sede: su } : {}) }),
            });
            const j = await res.json().catch(() => ({}));
            if (!res.ok) { mostraEsito("no", String(j.error ?? tr("err.network"))); return; }
            const box = $("gb-schede"); if (box) box.innerHTML = "";
            mostraEsito(j.reviewError ? "parz" : "ok", j.reviewError ? String(j.reviewError) : tr("itg.gb.listingSaved"));
            await carica();
          } catch { mostraEsito("no", tr("err.network")); }
        });
      });

      void carica();
    </script>
    <!-- ===== INTÉGRATIONS → SEARCH CONSOLE (5/11/2026) =====
         Il robot da aggiungere, la proprieta' (provata SENZA salvare), e se
         i dati arrivano davvero. -->
    <script>
      import { authFresh } from "../../lib/admin/auth";
      import { conAttesa } from "../../lib/admin/attesa";
      import { SEGNO, esito } from "../../lib/admin/casellaUi";
      import { esc } from "../../lib/esc";
      import { adminT, type AdminLang } from "../../i18n/admin";

      type Livello = "ok" | "parz" | "no" | "ignoto";
      type Config = { site: string; ready: boolean; robot: string; suggerito: string };
      type Vis = { configured: boolean; clicks: number; impressions: number; position: number; periode: string; error?: string };

      const lingua = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(lingua);
      const $ = (id: string) => document.getElementById(id);
      const overlay = $("sc-overlay");
      let cfg: Config | null = null;
      /** I dati della proprieta' SALVATA (null = non chiesti o niente da chiedere). */
      let vis: Vis | null = null;
      let occupato = false;

      /** Il segno: rosso senza chiave o senza proprieta', arancio se Google rifiuta. */
      function livello(): Livello {
        if (!cfg || !cfg.ready || !cfg.site) return "no";
        if (!vis) return "ignoto";
        return vis.configured && !vis.error ? "ok" : "parz";
      }

      function renderCasella() {
        const segno = $("sc-segno");
        const pill = $("sc-pill");
        if (!segno || !pill) return;
        if (!cfg) { segno.className = "itg-segno is-no"; segno.innerHTML = SEGNO.no; pill.className = "itg-pill is-no"; pill.textContent = tr("itg.sb.down"); return; }
        const l = livello();
        segno.className = `itg-segno is-${l}`;
        segno.innerHTML = l === "ignoto" ? "" : SEGNO[l];
        pill.className = `itg-pill is-${l === "ignoto" ? "parz" : l}`;
        pill.textContent = !cfg.ready ? tr("itg.sc.noKey") : !cfg.site ? tr("itg.sc.off") : l === "ok" ? tr("itg.sc.active") : l === "ignoto" ? tr("itg.sb.checking") : tr("itg.sc.refused");
      }

      function riga(lv: Livello, titolo: string, dettaglio: string): string {
        return `<li><span class="sb-ic is-${lv}">${SEGNO[lv]}</span><div><p class="sb-t">${esc(titolo)}</p><p class="sb-d">${dettaglio}</p></div><span></span></li>`;
      }

      function renderModale() {
        if (!cfg) return;
        const robot = $("sc-robot") as HTMLInputElement | null;
        if (robot) robot.value = cfg.robot;
        const sito = $("sc-site") as HTMLInputElement | null;
        if (sito && document.activeElement !== sito && !sito.dataset.toccato) {
          // Vuoto: si propone la proprieta' dominio del sito, da verificare e salvare.
          sito.value = cfg.site || cfg.suggerito;
        }
        const l = livello();
        const controlli = $("sc-controlli");
        if (controlli) controlli.innerHTML = [
          riga(cfg.ready ? "ok" : "no", tr("itg.sc.chkKey"), esc(cfg.ready ? tr("itg.sc.chkKeyOk") : tr("itg.sc.noServerKey"))),
          riga(!cfg.site ? "no" : l, tr("itg.sc.chkSite"),
            !cfg.site ? esc(tr("itg.sc.chkSiteNone"))
            : l === "ok" ? `<b>${esc(cfg.site)}</b>`
            : l === "ignoto" ? esc(tr("itg.sb.checking"))
            : `<b>${esc(cfg.site)}</b> · ${esc(vis?.error || tr("itg.sc.notFound"))}`),
        ].join("");
        const dati = $("sc-dati");
        if (dati) {
          dati.hidden = !(vis?.configured && !vis.error);
          if (!dati.hidden && vis) {
            const n = (x: number) => x.toLocaleString(lingua);
            dati.innerHTML = [
              [n(vis.clicks), tr("itg.sc.clicks")],
              [n(vis.impressions), tr("itg.sc.impressions")],
              [vis.position ? vis.position.toLocaleString(lingua, { maximumFractionDigits: 1 }) : "—", tr("itg.sc.position")],
            ].map(([v, k]) => `<div class="sc-dato"><b>${esc(v)}</b><span>${esc(k)}</span></div>`).join("");
          }
        }
        aggiornaSalva();
      }

      function aggiornaSalva() {
        const b = $("sc-save") as HTMLButtonElement | null;
        const v = ($("sc-site") as HTMLInputElement | null)?.value.trim() ?? "";
        if (b) b.disabled = occupato || !cfg || v === cfg.site;
      }

      function mostraEsito(lv: "ok" | "parz" | "no" | "", testo = "") {
        esito("sc-esito", lv, testo);
      }

      async function carica() {
        try {
          const res = await fetch("/api/admin/integrations", { headers: await authFresh() });
          const j = res.ok ? await res.json() : null;
          cfg = j?.search_console ? { suggerito: "", ...j.search_console } as Config : null;
        } catch { cfg = null; }
        vis = null;
        renderCasella();
        renderModale();
        // I dati della proprieta' salvata: e' cosi' che si sa se il robot e' stato aggiunto.
        if (cfg?.ready && cfg.site) {
          try {
            const res = await fetch("/api/admin/search-console", { headers: await authFresh() });
            vis = res.ok ? ((await res.json()) as Vis) : { configured: false, clicks: 0, impressions: 0, position: 0, periode: "", error: tr("err.network") };
          } catch { vis = { configured: false, clicks: 0, impressions: 0, position: 0, periode: "", error: tr("err.network") }; }
          renderCasella();
          renderModale();
        }
      }

      async function blocca(bottone: HTMLButtonElement | null, fai: () => Promise<void>): Promise<void> {
        if (occupato || !bottone) return;
        occupato = true;
        try { await conAttesa(bottone, fai); } finally {
          occupato = false;
          aggiornaSalva();
        }
      }

      $("sc-tile")?.addEventListener("click", () => {
        if (overlay) overlay.hidden = false;
        mostraEsito("");
        const sito = $("sc-site") as HTMLInputElement | null;
        if (sito) delete sito.dataset.toccato;
        const res = $("sc-res"); if (res) res.textContent = tr("itg.sc.note");
        void carica();
      });
      overlay?.querySelectorAll("[data-md-close]").forEach((el) => el.addEventListener("click", () => { if (overlay && !occupato) overlay.hidden = true; }));
      $("sc-site")?.addEventListener("input", (ev) => { (ev.target as HTMLInputElement).dataset.toccato = "1"; aggiornaSalva(); });

      const scCopy = $("sc-copy") as HTMLButtonElement | null;
      scCopy?.addEventListener("click", async () => {
        const robot = $("sc-robot") as HTMLInputElement | null;
        if (!robot?.value) return;
        try { await navigator.clipboard.writeText(robot.value); mostraEsito("ok", tr("itg.sc.emailCopied")); }
        catch { robot.select(); }
      });

      const scTest = $("sc-test") as HTMLButtonElement | null;
      scTest?.addEventListener("click", () => blocca(scTest, async () => {
        const res = $("sc-res");
        const site = ($("sc-site") as HTMLInputElement | null)?.value.trim() ?? "";
        if (!res) return;
        if (!site) { res.textContent = tr("itg.sc.needSite"); return; }
        res.textContent = tr("common.verifying");
        try {
          // ⚠️ PROVA e basta: la proprieta' viaggia nell'indirizzo e non si
          // scrive niente. A salvare ci pensa «Enregistrer».
          const r = await fetch(`/api/admin/search-console?site=${encodeURIComponent(site)}`, { headers: await authFresh() });
          const j = await r.json().catch(() => ({}));
          if (!r.ok) { res.textContent = String(j.error ?? tr("err.network")); return; }
          if (j.error) { res.textContent = String(j.error); return; }
          if (!j.configured) { res.textContent = tr("itg.sc.notFound"); return; }
          res.textContent = `OK ✓ ${j.clicks} ${tr("itg.sc.okStats").replace("{imp}", String(j.impressions ?? 0))}${site !== cfg?.site ? ` ${tr("itg.sc.okNotSaved")}` : ""}`;
        } catch {
          res.textContent = tr("err.network");
        }
      }));

      const scSave = $("sc-save") as HTMLButtonElement | null;
      scSave?.addEventListener("click", () => blocca(scSave, async () => {
        const site = ($("sc-site") as HTMLInputElement | null)?.value.trim() ?? "";
        try {
          const res = await fetch("/api/admin/integrations", { method: "PUT", headers: await authFresh(), body: JSON.stringify({ gsc_site: site }) });
          const j = await res.json().catch(() => ({}));
          if (!res.ok) { mostraEsito("no", String(j.error ?? tr("common.saveErr"))); return; }
          mostraEsito("ok", tr("itg.sc.saved"));
          const sito = $("sc-site") as HTMLInputElement | null;
          if (sito) delete sito.dataset.toccato;
          await carica();
        } catch {
          mostraEsito("no", tr("err.network"));
        }
      }));

      void carica();
    </script>
    <!-- ===== INTÉGRATIONS → NEWSLETTER (5/11/2026) =====
         La quota inclusa, il consumo del mese, e tutto quello che decide se
         una newsletter puo' partire. -->
    <script>
      import { authFresh } from "../../lib/admin/auth";
      import { conAttesa } from "../../lib/admin/attesa";
      import { SEGNO, esito } from "../../lib/admin/casellaUi";
      import { esc } from "../../lib/esc";
      import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";

      type Livello = "ok" | "parz" | "no" | "ignoto";
      type Stato = {
        quota: { sent_this_month: number; free_remaining: number; purchased_total: number; purchased_balance: number; total_remaining: number; monthly_quota: number } | null;
        resend: boolean;
        mittente: { valore: string; dominio: string; stato: "verificato" | "attesa" | "assente" | "ignoto" };
        ultimo: { subject: string; count: number; il: string } | null;
        programmati: number;
        casella: { livello: "ok" | "parz" | "no" };
      };

      const lingua = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(lingua);
      const $ = (id: string) => document.getElementById(id);
      const overlay = $("nl-overlay");
      let stato: Stato | null = null;
      let occupato = false;
      const n = (x: number) => x.toLocaleString(lingua);

      function renderCasella() {
        const segno = $("nl-segno");
        const pill = $("nl-pill");
        if (!segno || !pill) return;
        if (!stato) { segno.className = "itg-segno is-no"; segno.innerHTML = SEGNO.no; pill.className = "itg-pill is-no"; pill.textContent = tr("itg.sb.down"); return; }
        const l = stato.casella.livello;
        const q = stato.quota;
        segno.className = `itg-segno is-${l}`;
        segno.innerHTML = SEGNO[l];
        pill.className = `itg-pill is-${l}`;
        pill.textContent = !stato.resend ? tr("itg.nl.noResend")
          : q ? tr("itg.nl.pillLeft").replace("{n}", n(q.total_remaining)) : tr("itg.sb.down");
      }

      function riga(lv: Livello, titolo: string, dettaglio: string): string {
        return `<li><span class="sb-ic is-${lv}">${SEGNO[lv]}</span><div><p class="sb-t">${esc(titolo)}</p><p class="sb-d">${dettaglio}</p></div><span></span></li>`;
      }

      function renderModale() {
        if (!stato) return;
        const s = stato;
        const q = s.quota;
        const quota = $("nl-quota") as HTMLInputElement | null;
        if (quota && document.activeElement !== quota && q) quota.value = String(q.monthly_quota);
        // La barra: inviate su incluse.
        const barra = $("nl-barra");
        if (barra && q) {
          const pct = q.monthly_quota > 0 ? Math.min(100, Math.round((q.sent_this_month / q.monthly_quota) * 100)) : 100;
          barra.className = `nl-barra${pct >= 100 ? " is-no" : pct >= 80 ? " is-parz" : ""}`;
          const dentro = barra.firstElementChild as HTMLElement | null;
          if (dentro) dentro.style.width = `${pct}%`;
        }
        const numeri = $("nl-numeri");
        if (numeri && q) numeri.innerHTML = `<span>${tr("itg.nl.sentOf").replace("{a}", `<b>${esc(n(q.sent_this_month))}</b>`).replace("{t}", `<b>${esc(n(q.monthly_quota))}</b>`)}</span><span>${esc(tr("itg.nl.freeLeft").replace("{n}", n(q.free_remaining)))}</span>`;
        const dati = $("nl-dati");
        if (dati && q) dati.innerHTML = [
          [n(q.purchased_total), tr("itg.nl.bought")],
          [n(q.purchased_balance), tr("itg.nl.creditsLeft")],
          [n(q.total_remaining), tr("itg.nl.canSend")],
        ].map(([v, k]) => `<div class="sc-dato"><b>${esc(v)}</b><span>${esc(k)}</span></div>`).join("");

        const m = s.mittente;
        const lvM: Livello = !m.valore ? "no" : m.stato === "verificato" ? "ok" : m.stato === "assente" ? "no" : m.stato === "attesa" ? "parz" : "ignoto";
        const dM = !m.valore ? esc(tr("itg.nl.noSender"))
          : `<b>${esc(m.valore)}</b> · ${esc(m.stato === "verificato" ? tr("itg.rs.domOk") : m.stato === "attesa" ? tr("itg.rs.domWait") : m.stato === "assente" ? tr("itg.rs.domMissing") : tr("itg.rs.domUnknown")).replace("{d}", esc(m.dominio))}`;
        const u = s.ultimo;
        const quando = u?.il ? new Date(u.il).toLocaleString(ADMIN_LOCALE[lingua] ?? "fr-BE", { dateStyle: "short", timeStyle: "short" }) : "";
        const controlli = $("nl-controlli");
        if (controlli) controlli.innerHTML = [
          riga(s.resend ? "ok" : "no", "Resend", esc(s.resend ? tr("itg.nl.resendOk") : tr("itg.nl.resendKo"))),
          riga(lvM, tr("itg.nl.sender"), dM),
          riga(u ? "ok" : "ignoto", tr("itg.nl.last"), u ? `<b>${esc(u.subject)}</b> · ${esc(quando)} · ${esc(tr("itg.nl.toN").replace("{n}", n(u.count)))}` : esc(tr("itg.nl.never"))),
          riga(s.programmati ? "ok" : "ignoto", tr("itg.nl.scheduled"), esc(s.programmati ? tr("itg.nl.scheduledN").replace("{n}", String(s.programmati)) : tr("itg.nl.scheduledNone"))),
        ].join("");
        aggiornaSalva();
      }

      function aggiornaSalva() {
        const b = $("nl-save") as HTMLButtonElement | null;
        const v = ($("nl-quota") as HTMLInputElement | null)?.value.trim() ?? "";
        if (b) b.disabled = occupato || !stato?.quota || v === "" || Number(v) === stato.quota.monthly_quota;
      }

      function mostraEsito(lv: "ok" | "parz" | "no" | "", testo = "") {
        esito("nl-esito", lv, testo);
      }

      async function carica() {
        try {
          const res = await fetch("/api/admin/newsletter-casella", { headers: await authFresh() });
          stato = res.ok ? ((await res.json()) as Stato) : null;
        } catch { stato = null; }
        renderCasella();
        renderModale();
      }

      async function blocca(bottone: HTMLButtonElement | null, fai: () => Promise<void>): Promise<void> {
        if (occupato || !bottone) return;
        occupato = true;
        try { await conAttesa(bottone, fai); } finally {
          occupato = false;
          aggiornaSalva();
        }
      }

      $("nl-tile")?.addEventListener("click", () => {
        if (overlay) overlay.hidden = false;
        mostraEsito("");
        void carica();
      });
      overlay?.querySelectorAll("[data-md-close]").forEach((el) => el.addEventListener("click", () => { if (overlay && !occupato) overlay.hidden = true; }));
      $("nl-quota")?.addEventListener("input", aggiornaSalva);

      const nlSave = $("nl-save") as HTMLButtonElement | null;
      nlSave?.addEventListener("click", () => blocca(nlSave, async () => {
        const v = Math.floor(Number(($("nl-quota") as HTMLInputElement | null)?.value));
        if (!Number.isFinite(v) || v < 0) { mostraEsito("no", tr("itg.nl.invalid")); return; }
        try {
          const res = await fetch("/api/admin/integrations", { method: "PUT", headers: await authFresh(), body: JSON.stringify({ newsletter_quota: v }) });
          const j = await res.json().catch(() => ({}));
          if (!res.ok) { mostraEsito("no", String(j.error ?? tr("common.saveErr"))); return; }
          mostraEsito("ok", tr("itg.nl.saved"));
          await carica();
        } catch {
          mostraEsito("no", tr("err.network"));
        }
      }));

      void carica();
    </script>
  </body>
</html>
