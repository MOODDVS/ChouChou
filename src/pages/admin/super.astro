            </div>

            <div class="prev-wrap">
              <p class="prev-lab">{t("sup.preview")}</p>
              <div class="prev" aria-hidden="true">
                <div class="prev-top">
                  <span class="prev-logo"></span>
                  <span class="prev-date">MERCREDI <b>29 JUILLET</b></span>
                  <span class="prev-mail">client@resto.be</span>
                </div>
                <div class="prev-body">
                  <div class="prev-tile"><div class="k">{t("prev.orders")}</div><div class="v acc">12</div></div>
                  <div class="prev-tile"><div class="k">{t("prev.reservations")}</div><div class="v">28</div></div>
