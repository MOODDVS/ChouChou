              <span class="itg-pill" id="sc-pill">{t("itg.sb.checking")}</span>
            </button>
            <button type="button" class="itg-tile" id="nl-tile">
              <span class="itg-segno" id="nl-segno"></span>
              <span class="itg-logo is-nl">{/* Servizio di RestoHub (su Resend): l'icona del motore, nel colore dell'accento. */}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z" /><path d="M3.5 7l8.5 6 8.5-6" /><path d="M7 3.5h10" /></svg></span>
              <span class="itg-nome">Newsletter</span>
              <span class="itg-cosa">{t("itg.nl.whoTile")}</span>
              <span class="itg-pill" id="nl-pill">{t("itg.sb.checking")}</span>
            </button>
            <button type="button" class="itg-tile" id="im-tile">
              <span class="itg-segno" id="im-segno"></span>
              <span class="itg-logo is-bizprint">{/* Il logo di BizPrint (icona ufficiale del plugin). */}<img src="/restohub/integrazioni/bizprint.webp" alt="" width="64" height="64" /></span>
              <span class="itg-nome">{t("itg.im.title")}</span>
              <span class="itg-cosa">{t("itg.im.who")}</span>
              <span class="itg-pill" id="im-pill">{t("itg.sb.checking")}</span>
            </button>
          </div>

          <!-- Google Business: dal 5/11/2026 e' la casella qui sopra (Place ID,
               link recensioni, scheda, account Google, per livello). -->

          <!-- Impression: dal 5/11/2026 e' la casella «Imprimantes» in alto. -->
          <!-- Search Console e Newsletter: dal 5/11/2026 sono caselle in alto. -->
        </section>

        <!-- ===== PRINT (super admin) : catalogo prodotti stampabili ordinabili a MOODD ===== -->
        <section class="pane" data-pane="print" hidden>
          <h1>
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
            {t("sup.tab.print")}
          </h1>
          <p class="sub">{t("print.intro")}</p>
          <script is:inline type="application/json" id="pr-i18n" set:html={JSON.stringify(prI18n)}></script>
          <div class="pr-found" id="pr-found" hidden>
            <div class="pr-found-t">{t("print.found")}</div>
            <p class="pr-found-hint">{t("print.foundHint")}</p>
            <div id="pr-found-list"></div>
          </div>
          <div id="pr-list" class="pr-list"></div>
