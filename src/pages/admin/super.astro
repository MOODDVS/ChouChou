      .pr-meta-t { font-family: var(--font-title); font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--c-muted); margin-bottom: 0.6rem; }
      .pr-meta-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
      .pr-m-f { display: flex; flex-direction: column; gap: 0.25rem; }
