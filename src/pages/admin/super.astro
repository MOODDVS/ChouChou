            <p class="tema-titre" style="margin-top:0">{t("sup.lang.title")}</p>
            <p class="sub">{t("sup.lang.hint")}</p>
            <select id="admin-lang-sel" class="lang-sel" aria-label={t("sup.lang.title")}>
              {LINGUE_ADMIN.map((l) => (
                <option value={l.code} selected={l.code === lang}>{l.label}</option>
              ))}
            </select>
          </div>

          {/* Lingue pubbliche (cliente): set attivo + predefinita */}
          <div class="publang-box">
            <p class="tema-titre">{t("sup.publang.title")}</p>
            <p class="sub">{t("sup.publang.hint")}</p>
            <div class="publang-list" id="publang-list" style="display:none"></div>
          </div>

          <hr class="publang-sep" />

          {/* Marchio dell'app installata (PWA): RestoHub o cliente */}
