          <p class="sub">{t("sup.pwa.hint")}</p>
          <div class="rows">
            <div class="rowwrap">
              <div class="row is-off" id="pwa-row">
                <span class="row-name">{t("sup.pwa.row")}</span>
                <span class="row-state" id="pwa-state">—</span>
