              <p class="note" id="pwa-msg" style="margin: 0.8rem 0 0"></p>
            </div>
          </div>

          <hr class="publang-sep" />

          {/* Funzioni opzionali del motore (accese per cliente) */}
          <p class="tema-titre" style="margin-top:0">{t("sup.features.title")}</p>
          <p class="sub">{t("sup.features.hint")}</p>
          <div class="rows" id="feat-rows" style="display:none"></div>

          <hr class="publang-sep" />

          {/* Visibilità pagine (permessi degli altri utenti) */}
          <p class="tema-titre" style="margin-top:0">{t("sup.pagesvis.title")}</p>
          <p class="sub">{t("sup.reglages.intro")}</p>
          <div class="state" id="state">{t("sup.loading")}</div>
          <div class="rows" id="rows" style="display:none"></div>
          <p class="note">{t("sup.reglages.note")}</p>
        </section>

        <section class="pane" data-pane="integrations" hidden>
