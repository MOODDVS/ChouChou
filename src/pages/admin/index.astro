---
// Pannello admin — dashboard. Riepilogo di OGGI, 4 tile in linea:
// Notes (lavagnetta staff, oro), Commandes, Horaires, Menu.
// Le Notes hanno un'anteprima nel tile + un modale per la board completa.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import TileNotes from "../../components/admin/home/TileNotes.astro";
import TileCommandes from "../../components/admin/home/TileCommandes.astro";
import TileReservations from "../../components/admin/home/TileReservations.astro";
import TileHoraires from "../../components/admin/home/TileHoraires.astro";
import TileJoursSpeciaux from "../../components/admin/home/TileJoursSpeciaux.astro";
import TileCuisine from "../../components/admin/home/TileCuisine.astro";
import TileMenu from "../../components/admin/home/TileMenu.astro";
import TileStats from "../../components/admin/home/TileStats.astro";
import TilePhotos from "../../components/admin/home/TilePhotos.astro";
import TileGoogle from "../../components/admin/home/TileGoogle.astro";
import { CLIENT } from "../../config/client";
import { verificaTokenLocale } from "../../lib/admin/adminAuth";
import { caricaHomeData } from "../../lib/admin/caricaHomeData";

export const prerender = false;

// SSR (Fase 2): se il cookie di sessione è valido, pre-carichiamo le 5 isole
// principali sul server → appaiono già piene (le statistiche restano lato
// client). Se il cookie manca/è scaduto o c'è errore, ssrHome resta null e la
// pagina carica tutto lato client come prima (nessun rischio).
let ssrHome: unknown = null;
try {
  const token = Astro.cookies.get("mdd_at")?.value ?? "";
  const staff = token ? await verificaTokenLocale(token) : null;
  if (staff) ssrHome = await caricaHomeData();
} catch {
  ssrHome = null;
}
const ssrHomeJson = ssrHome ? JSON.stringify(ssrHome).replace(/</g, "\\u003c") : "";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{"Admin — " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-hover: #e04f00;
        --c-input: #e6e6e6;
        --c-bg: #ffffff;
        --c-text: #666666;
        --c-accent: #ff7300;
        --c-muted: #a6a6a6;
        --c-line: #ebebeb;
        --c-card: #ffffff;
        --c-brown: var(--c-bg);
        --font-title: "Bebas Neue", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; }
      #app { display: none; min-height: 100vh; flex-direction: column; }
      main { flex: 1; padding: 2rem 2rem 7rem; width: 100%; }

      /* minmax(0,1fr): colonne SEMPRE uguali (il contenuto largo non può
         allargare la sua colonna). grid-auto-rows + align-items:start =
         masonry: ogni tile occupa N micro-righe in base alla SUA altezza,
         quindi una tile alta non allunga le vicine e le tile sotto risalgono. */
      .cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; grid-auto-rows: 10px; align-items: start; }
      @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 560px) { .cards { grid-template-columns: minmax(0, 1fr); } }

      .tile { display: block; min-width: 0; background: var(--c-card); border: 1px solid var(--c-line); padding: 1.6rem; text-decoration: none; color: var(--c-text); transition: border-color 0.2s, transform 0.15s; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); }
      a.tile:hover { border-color: var(--c-accent); transform: translateY(-2px); }
      .tile-title { font-family: var(--font-title); font-size: 1.35rem; letter-spacing: 0.04em; line-height: 1; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
      .tile-title .tt-ico { width: 17px; height: 17px; flex: 0 0 auto; fill: none; stroke: var(--c-accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transform: translateY(-1.5px); }
      .tile-big { font-family: var(--font-title); font-size: 2.3rem; line-height: 1; margin-bottom: 0.25rem; color: var(--c-accent); }
      .ord-two { display: flex; gap: 1.5rem; }
      .ord-two > div { flex: 1; min-width: 0; }
      .ord-nexts { display: flex; flex-direction: column; gap: 0.35rem; }
      .ord-nx { display: flex; align-items: baseline; gap: 0.5rem; font-size: 0.95rem; min-width: 0; }
      .ord-nx .nx-h { font-weight: 800; color: var(--c-accent); flex: 0 0 auto; }
      .ord-nx .nx-n { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .resa-two { display: flex; gap: 1rem; align-items: flex-end; justify-content: space-between; margin-bottom: 1.25rem; }
      .resa-two .tile-sub { margin-bottom: 0; }
      .resa-perm { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1rem; }
      .resa-perm .rp-pill {
        border: 1px solid #d24d55; color: #ffffff; background: #d24d55;
        border-radius: 999px; padding: 0.24rem 0.65rem; font-size: 0.68rem;
        font-weight: 700; letter-spacing: 0.03em; white-space: nowrap;
      }
      .resa-mini { display: flex; align-items: flex-end; gap: 0.45rem; padding-top: 0.2rem; }
      .resa-mini .rmc { display: flex; flex-direction: column; align-items: center; gap: 3px; }
      .resa-mini .rmc b { font-size: 0.74rem; color: var(--c-text); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
      .resa-mini .rmc i { width: 18px; border-radius: 2px 2px 0 0; display: block; }
      .tile-sub { color: var(--c-muted); font-size: 0.9rem; margin-bottom: 1.25rem; }
      .tile-next { border-top: 1px solid var(--c-line); padding-top: 1rem; font-size: 0.95rem; }
      .tile-next .lab { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-muted); display: block; margin-bottom: 0.3rem; }
      .tile-next .val { font-weight: 700; }
      .tile-next .none { color: var(--c-muted); font-weight: 400; }
      .state { color: var(--c-muted); padding: 1rem 0; }

      /* --- Tile Statistiques (2 colonne) --- */
      .tile-stats { grid-column: span 2; }
      @media (max-width: 560px) { .tile-stats { grid-column: 1 / -1; } }

      /* --- Card Photos récentes (2 colonne, griglia 4x2) --- */
      .tile-photos { grid-column: span 2; }
      @media (max-width: 560px) { .tile-photos { grid-column: 1 / -1; } }
      .ph-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; margin-top: 0.8rem; }
      .ph-cell {
        display: block; border: 1px solid var(--c-line); border-radius: 8px; overflow: hidden;
        transition: border-color 0.15s, transform 0.15s;
      }
      .ph-cell:hover { border-color: var(--c-accent); transform: scale(0.97); }
      .ph-cell img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
      .ph-empty { grid-column: 1 / -1; color: var(--c-muted); font-size: 0.85rem; }
      .st-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
      .st-head .tile-title { margin-bottom: 0; }
      .st-link { color: var(--c-muted); font-size: 0.8rem; text-decoration: none; transition: color 0.15s; }
      .st-link:hover { color: var(--c-accent); }
      .st-grid { display: flex; gap: 1.75rem; }
      .st-left { flex: 1; min-width: 0; }
      .st-chart { flex: 1.2; min-width: 0; display: flex; flex-direction: column; }
      @media (max-width: 700px) { .st-grid { flex-direction: column; } }
      .st-lab { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-muted); display: block; margin-bottom: 0.3rem; }
      .st-two { display: flex; gap: 1.5rem; margin-bottom: 1.1rem; }
      .st-two > div { flex: 1; }
      .st-big { font-family: var(--font-title); font-size: 2.3rem; line-height: 1; color: var(--c-accent); }
      .st-facts { border-top: 1px solid var(--c-line); padding-top: 1rem; display: flex; gap: 1.5rem; }
      .st-facts > div { flex: 1; min-width: 0; }
      .st-facts .val { font-weight: 700; font-size: 0.95rem; }
      .st-bars { display: flex; align-items: flex-end; gap: 2px; height: 110px; border-bottom: 1px solid var(--c-line); margin-top: 0.4rem; flex: 1; }
      .st-bar { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; }
      .st-bar .cval { font-family: var(--font-title); font-size: 0.8rem; color: var(--c-text); text-align: center; margin-bottom: 2px; }
      .st-bar .fill { background: var(--c-accent); border-radius: 3px 3px 0 0; min-height: 2px; }
      .st-bar.zero .fill { background: var(--c-line); }
      .st-labs { display: flex; gap: 2px; margin-top: 0.35rem; }
      .st-labs span { flex: 1; text-align: center; font-size: 0.62rem; color: var(--c-muted); }

      /* --- Tile Horaires --- */
      .sched-status { font-family: var(--font-title); font-size: 1.8rem; letter-spacing: 0.03em; line-height: 1; margin-bottom: 0.9rem; }
      .sched-status.open { color: var(--c-accent); }
      .sched-status.closed { color: #d24d55; }
      .sched-bands { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.25rem; }
      .sched-band { display: flex; align-items: center; gap: 0.5rem; font-size: 1.1rem; font-weight: 700; }
      .sched-band .clock { width: 15px; height: 15px; stroke: var(--c-accent); fill: none; stroke-width: 1.8; flex-shrink: 0; }
      .sched-two { display: flex; gap: 1.5rem; }
      .sched-two > div { flex: 1; }

      /* --- Tile Cuisine --- */
      .cui-row { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--c-line); margin-top: 1.1rem; padding-top: 1rem; }
      .cui-lab { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-muted); }
      .cui-sw { width: 44px; height: 24px; border-radius: 999px; background: var(--c-input); border: 1px solid var(--c-line); box-sizing: border-box; cursor: pointer; position: relative; transition: background 0.2s, border-color 0.2s; padding: 0; flex: 0 0 auto; }
      .cui-sw.is-on { border-color: var(--c-accent); }
      .cui-sw .cui-knob { position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: left 0.2s; }
      .cui-sw.is-on { background: var(--c-accent); }
      .cui-sw.is-on .cui-knob { left: 23px; }

      /* --- Tile Jours spéciaux --- */
      .spx-list { display: flex; flex-direction: column; gap: 0.55rem; }
      .spx-row { display: flex; align-items: center; gap: 0.55rem; font-size: 0.92rem; min-width: 0; }
      .spx-b { flex: 0 0 auto; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.16rem 0.5rem; border-radius: 999px; font-weight: 800; }
      .spx-b.open { background: rgba(0, 113, 83, 0.3); color: #58c9a3; }
      .spx-b.closed { background: rgba(237, 28, 36, 0.18); color: #ff8a8f; }
      .spx-date { font-weight: 800; color: var(--c-text); white-space: nowrap; }
      .spx-note { color: var(--c-muted); font-size: 0.82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
      .spx-more { color: var(--c-muted); font-size: 0.8rem; }
      .spx-empty { color: var(--c-muted); font-size: 0.9rem; padding: 0.4rem 0; }
      .spx-evts { display: flex; flex-direction: column; gap: 0.55rem; }
      .spx-ev { display: flex; align-items: center; gap: 0.65rem; min-width: 0; }
      .ev-cal { width: 50px; flex: 0 0 auto; background: var(--c-input); border: 1px solid var(--c-line); border-radius: 8px; display: flex; flex-direction: column; align-items: center; padding: 0.3rem 0 0.28rem; line-height: 1; }
      .ev-cal b { font-family: var(--font-title); font-size: 1.1rem; color: var(--c-text); }
      .ev-cal i { font-style: normal; font-size: 0.56rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-accent); margin-top: 3px; }
      .ev-nome { display: block; font-weight: 700; font-size: 0.95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .ev-gg { display: block; color: var(--c-muted); font-size: 0.76rem; text-transform: capitalize; }
      .ev-nome .spx-b { font-size: 0.56rem; padding: 0.1rem 0.45rem; vertical-align: 2px; margin-left: 0.25rem; }

      /* --- Bottone + della tile Jours speciaux + modale Evenements locaux --- */
      .spx-add {
        position: absolute; top: 1.15rem; right: 1.25rem; z-index: 2;
        width: 34px; height: 34px; border-radius: 50%;
        background: transparent; border: 1px solid var(--c-line); color: var(--c-accent);
        font-size: 1.35rem; line-height: 1; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: border-color 0.15s, background 0.15s;
      }
      .spx-add:hover { border-color: var(--c-accent); background: color-mix(in srgb, var(--c-accent) 12%, transparent); }
      .ev-nome.ev-loc { color: var(--c-accent); }

      #evt-overlay .evm-modal {
        width: 100%; max-width: 460px; margin: auto; position: relative;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        padding: 1.7rem; box-shadow: 0 24px 60px rgba(0, 0, 0, calc(0.5 * var(--sh, 0.15)));
      }
      .evm-titre { font-family: var(--font-title); font-size: 1.7rem; letter-spacing: 0.04em; margin-bottom: 0.3rem; }
      .evm-sub { color: var(--c-muted); font-size: 0.85rem; line-height: 1.55; margin-bottom: 0.4rem; }
      .evm-lab { display: block; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); margin: 1rem 0 0.35rem; }
      .evm-in {
        width: 100%; background: var(--c-input); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-size: 0.95rem; padding: 0.65rem 0.75rem; border-radius: 8px;
      }
      .evm-in:focus { outline: none; border-color: var(--c-accent); }
      .evm-in[readonly] { cursor: pointer; }
      .evm-check { display: flex; align-items: center; gap: 0.55rem; margin: 1.1rem 0 1.3rem; font-size: 0.9rem; cursor: pointer; }
      .evm-check input { accent-color: var(--c-accent); width: 16px; height: 16px; cursor: pointer; }
      .evm-add {
        width: 100%; background: var(--c-accent); border: 1px solid var(--c-accent); color: var(--c-bg);
        font-family: var(--font-body); font-weight: 800; font-size: 0.95rem; padding: 0.75rem; border-radius: 8px; cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
      }
      .evm-add:hover { background: var(--c-hover); border-color: var(--c-hover); }
      .evm-x {
        position: absolute; top: 0.9rem; right: 0.9rem; width: 34px; height: 34px; border-radius: 50%;
        background: transparent; border: 1px solid var(--c-line); color: var(--c-muted); cursor: pointer;
        transition: color 0.15s, border-color 0.15s;
      }
      .evm-x:hover { color: var(--c-text); border-color: var(--c-accent); }
      .evm-list { margin-top: 1.3rem; display: flex; flex-direction: column; gap: 0.4rem; max-height: 260px; overflow-y: auto; }
      .evm-vide { color: var(--c-muted); font-size: 0.85rem; }
      .evm-row {
        display: flex; align-items: center; gap: 0.7rem;
        background: var(--c-input); border: 1px solid var(--c-line); border-radius: 8px;
        padding: 0.5rem 0.7rem; font-size: 0.88rem;
      }
      .evm-row .d { color: var(--c-accent); font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
      .evm-row .n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .evm-row .y { color: var(--c-muted); font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; }
      .evm-del {
        width: 28px; height: 28px; flex: 0 0 auto; border-radius: 50%;
        background: transparent; border: 1px solid var(--c-line); color: var(--c-muted);
        cursor: pointer; font-size: 0.8rem; transition: border-color 0.15s, color 0.15s;
      }
      .evm-del:hover { border-color: #ed1c24; color: var(--c-text); }
      .evm-del.confirm { background: #a3320f; border-color: #a3320f; color: #fff; width: auto; padding: 0 0.6rem; border-radius: 999px; font-size: 0.72rem; }

      /* Datepicker brand (copia locale — sopra l'overlay: z 420) */
      .dp-panel {
        position: fixed; z-index: 420; width: 308px;
        background: var(--c-card); border: 1px solid var(--c-line);
        box-shadow: 0 12px 32px rgba(0, 0, 0, calc(0.55 * var(--sh, 0.15))); padding: 0.9rem;
      }
      .dp-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
      .dp-title { font-family: var(--font-title); font-size: 1.15rem; letter-spacing: 0.04em; text-transform: capitalize; }
      .dp-nav {
        width: 40px; height: 40px; background: transparent; border: 1px solid var(--c-line);
        color: var(--c-text); font-size: 1.3rem; cursor: pointer; border-radius: 50%;
        transition: border-color 0.15s, color 0.15s;
      }
      .dp-nav:hover:not(:disabled) { border-color: var(--c-accent); color: var(--c-accent); }
      .dp-nav:disabled { opacity: 0.3; cursor: not-allowed; }
      .dp-dow { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 0.2rem; }
      .dp-dow span { text-align: center; font-size: 0.7rem; color: var(--c-muted); text-transform: uppercase; padding: 0.2rem 0; }
      .dp-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
      .dp-cell {
        aspect-ratio: 1; min-height: 40px; display: flex; align-items: center; justify-content: center;
        background: transparent; border: none; color: var(--c-text); font-family: var(--font-body);
        font-size: 0.95rem; cursor: pointer; border-radius: 50%;
        transition: background 0.15s, color 0.15s;
      }
      .dp-cell:hover:not(:disabled):not(.dp-vuota):not(.dp-sel) { background: var(--c-line); }
      .dp-vuota { cursor: default; }
      .dp-off { color: #5d5555; cursor: not-allowed; }
      .dp-today { box-shadow: inset 0 0 0 1px var(--c-accent); }
      .dp-sel { background: var(--c-accent); color: var(--c-bg); font-weight: 700; }
      @media (pointer: coarse) {
        .dp-panel { width: 340px; }
        .dp-cell { min-height: 44px; font-size: 1.05rem; }
      }

      /* --- Tile Menu --- */
      .menu-counts { display: flex; gap: 1.5rem; margin-bottom: 1.25rem; }
      .mc-num { font-family: var(--font-title); font-size: 2.8rem; line-height: 1; color: var(--c-accent); display: block; }
      .mc-lab { color: var(--c-muted); font-size: 0.85rem; }
      .val.warn { color: var(--c-accent); }

      /* --- Tile Notes (colori invertiti: fondo oro, testo marrone) --- */
      .tile-notes { background: var(--c-accent); color: var(--c-brown); border-color: var(--c-accent); }
      .tile-notes .tile-title { color: var(--c-brown); }
      .tile-notes .tile-title .tt-ico { stroke: var(--c-brown); }
      .ntile-head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
      .ntile-head .tile-title { margin-bottom: 0; }
      .ntile-btn { cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--c-brown); background: transparent; color: var(--c-brown); padding: 0; transition: background 0.15s, color 0.15s; }
      .ntile-btn svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .ntile-btn:hover { background: var(--c-brown); color: var(--c-accent); }
      .ntile-expand { margin-left: auto; }
      .ntile-add { font-size: 1.5rem; line-height: 1; background: var(--c-brown); color: var(--c-accent); border-color: var(--c-brown); }
      .ntile-add:hover { background: transparent; color: var(--c-brown); }
      .notes-preview { cursor: pointer; }
      .np-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0; border-top: 1px solid color-mix(in srgb, var(--c-bg) 18%, transparent); font-size: 0.92rem; }
      .np-item:first-child { border-top: none; }
      .np-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--c-brown); opacity: 0.55; flex-shrink: 0; }
      .np-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .np-item.done .np-text { text-decoration: line-through; opacity: 0.55; }
      .np-item.done .np-dot { opacity: 0.3; }
      .np-more { font-size: 0.8rem; opacity: 0.75; margin-top: 0.45rem; font-weight: 700; }
      .np-empty { opacity: 0.8; font-size: 0.92rem; }

      /* --- Modale Notes (centrato, fondo oro coerente col tile) --- */
      .overlay { position: fixed; inset: 0; z-index: 300; display: none; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); align-items: center; justify-content: center; padding: 5vh 1rem; overflow-y: auto; }
      .overlay.is-open { display: flex; }
      .modal { width: 100%; max-width: 620px; margin: auto; background: var(--c-accent); color: var(--c-brown); border: 1px solid var(--c-accent); padding: 1.75rem; position: relative; box-shadow: 0 24px 60px rgba(0, 0, 0, calc(0.5 * var(--sh, 0.15))); }
      .modal h2 { font-family: var(--font-title); font-size: 1.9rem; letter-spacing: 0.04em; margin-bottom: 1.1rem; color: var(--c-brown); }
      .m-close { position: absolute; top: 0.8rem; right: 1rem; background: none; border: none; color: color-mix(in srgb, var(--c-bg) 55%, transparent); font-size: 1.7rem; cursor: pointer; line-height: 1; }
      .m-close:hover { color: var(--c-brown); }

      /* Compose */
      .notes-compose { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.25rem; }
      .notes-compose textarea { background: #fffaf0; border: 1px solid color-mix(in srgb, var(--c-bg) 30%, transparent); color: var(--c-brown); font-family: var(--font-body); font-size: 0.95rem; padding: 0.7rem 0.8rem; width: 100%; min-height: 74px; resize: vertical; color-scheme: light; }
      .notes-compose textarea::placeholder { color: color-mix(in srgb, var(--c-bg) 50%, transparent); }
      .notes-compose textarea:focus { outline: none; border-color: var(--c-brown); }
      .notes-compose-actions { display: flex; justify-content: flex-end; }
      .notes-compose-actions { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
      .nc-tags { display: flex; gap: 0.45rem; flex-wrap: wrap; }
      .nc-tag { border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c-bg) 45%, transparent); background: transparent; color: #2c2013; font-family: var(--font-body); font-size: 0.78rem; font-weight: 700; padding: 0.28rem 0.75rem; cursor: pointer; transition: background 0.15s, color 0.15s; }
      .nc-tag.is-on { background: var(--c-brown); color: var(--c-accent); border-color: var(--c-brown); }
      .note-tags { display: flex; gap: 0.35rem; margin-top: 0.3rem; flex-wrap: wrap; }
      .note-tag { border-radius: 999px; font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.12rem 0.5rem; }
      .note-tag.t-important { background: #8f2e15; color: #fff; }
      .note-tag.t-recurrent { background: var(--c-brown); color: var(--c-accent); }
      .note-tag.t-fournisseur { background: #007153; color: #fff; }
      .np-item .note-tag { transform: translateY(-1px); }
      .nc-save { background: var(--c-brown); border: 1px solid var(--c-brown); color: var(--c-accent); font-family: var(--font-title); font-size: 1.05rem; letter-spacing: 0.04em; padding: 0.5rem 1.6rem; cursor: pointer; border-radius: 999px; transition: background 0.15s, color 0.15s; }
      .nc-save:hover:not(:disabled) { background: transparent; color: var(--c-brown); }
      .nc-save:disabled { opacity: 0.5; cursor: not-allowed; }
      .notes-msg { color: #7a1f12; font-size: 0.85rem; font-weight: 700; min-height: 1.1rem; margin-bottom: 0.4rem; }

      /* Lista completa (nel modale, su fondo oro) */
      .note { display: flex; align-items: flex-start; gap: 0.8rem; padding: 0.85rem 0; border-top: 1px solid color-mix(in srgb, var(--c-bg) 20%, transparent); }
      .note:first-child { border-top: none; }
      .note-check { flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--c-brown); background: transparent; cursor: pointer; margin-top: 0.1rem; display: inline-flex; align-items: center; justify-content: center; transition: background 0.15s, border-color 0.15s; }
      .note-check:hover { background: color-mix(in srgb, var(--c-bg) 12%, transparent); }
      .note.done .note-check { background: var(--c-brown); border-color: var(--c-brown); }
      .note-check svg { width: 13px; height: 13px; fill: none; stroke: var(--c-accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
      .note-body { flex: 1; min-width: 0; }
      .note-text { font-size: 0.98rem; white-space: pre-wrap; word-break: break-word; line-height: 1.35; }
      .note.done .note-text { text-decoration: line-through; color: color-mix(in srgb, var(--c-bg) 55%, transparent); }
      .note-meta { color: color-mix(in srgb, var(--c-bg) 60%, transparent); font-size: 0.72rem; margin-top: 0.3rem; }
      .note-del { flex-shrink: 0; height: 30px; min-width: 30px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c-bg) 30%, transparent); background: transparent; color: color-mix(in srgb, var(--c-bg) 70%, transparent); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; padding: 0; }
      .note-del:hover { border-color: #9a1b12; color: #9a1b12; background: rgba(154, 27, 18, 0.08); }
      .note-del svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .note-del.confirm { padding: 0 0.7rem; font-size: 0.72rem; color: #fff; background: #a3320f; border-color: #a3320f; }
      .notes-empty { color: color-mix(in srgb, var(--c-bg) 65%, transparent); font-size: 0.9rem; padding: 0.4rem 0; }

      /* ---- Organiser : FAB flottante in basso a sinistra (come les chiusure Réservations) ---- */
      .org-fab {
        position: fixed; left: 1.5rem; bottom: 4.4rem; z-index: 90;
        width: 52px; height: 52px; border-radius: 50%;
        background: var(--c-accent); color: var(--c-bg); border: 2px solid var(--c-accent);
        display: flex; align-items: center; justify-content: center; cursor: pointer;
        box-shadow: 0 8px 24px rgba(0, 0, 0, calc(0.45 * var(--sh, 0.15)));
        transition: border-color 0.2s, color 0.2s, background 0.2s, transform 0.15s;
      }
      .org-fab:hover { background: var(--c-hover); border-color: var(--c-hover); transform: scale(0.94); }
      .org-fab svg { width: 23px; height: 23px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
      .org-fab.is-on { background: transparent; color: var(--c-accent); }
      .org-fab-reset { left: 5.6rem; }

      .tile { position: relative; }
      .tile-move, .tile-resize { display: none; }
      .cards.editing .tile { outline: 1px dashed var(--c-line); cursor: default; }
      .cards.editing .tile.dragging { opacity: 0.45; }
      .cards.editing .tile-move {
        display: flex; align-items: center; justify-content: center;
        position: absolute; top: 8px; left: 8px; width: 30px; height: 30px; z-index: 6;
        background: color-mix(in srgb, var(--c-bg) 90%, transparent); border: 1px solid var(--c-accent); border-radius: 8px;
        color: var(--c-accent); cursor: grab; touch-action: none;
      }
      .cards.editing .tile-move:active { cursor: grabbing; }
      .cards.editing .tile-move svg { width: 16px; height: 16px; fill: currentColor; }
      .cards.editing .tile-resize {
        display: block; position: absolute; right: 5px; bottom: 5px; width: 18px; height: 18px; z-index: 6;
        cursor: nwse-resize; touch-action: none;
        border-right: 3px solid var(--c-accent); border-bottom: 3px solid var(--c-accent);
        border-bottom-right-radius: 6px;
      }
    </style>
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <div class="state" id="state">Chargement…</div>
        <div class="cards" id="cards" style="display:none">
          <TileNotes />
          <TileCommandes />
          <TileReservations />
          <TileHoraires />
          <TileJoursSpeciaux />
          <TileCuisine />
          <TileMenu />
          <TileGoogle />
          <TileStats />
          <TilePhotos />
        </div>
      </main>

      <!-- FAB Organiser (disposizione delle isole) -->
      <button class="org-fab" id="organiser-btn" type="button" title="Organiser mes tuiles" aria-label="Organiser" style="display:none">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      </button>
      <button class="org-fab org-fab-reset" id="organiser-reset" type="button" title="Réinitialiser la disposition" aria-label="Réinitialiser" style="display:none">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.5 15a9 9 0 1 0 2.1-9.4L1 10"/></svg>
      </button>

      <AdminFooter />
    </div>

    <!-- Modale Notes -->
    <div class="overlay" id="evt-overlay">
      <div class="evm-modal">
        <button type="button" class="evm-x" id="evt-close" aria-label="Fermer">✕</button>
        <h2 class="evm-titre">Événements locaux</h2>
        <p class="evm-sub">
          Des rappels pour le resto : fête du quartier, brocante, anniversaire…
          Ils apparaissent dans « Événements à venir », rien d'autre ne change.
        </p>
        <label class="evm-lab" for="evt-nom">Nom</label>
        <input id="evt-nom" class="evm-in" maxlength="80" placeholder="Brocante du Parvis" autocomplete="off" />
        <label class="evm-lab" for="evt-date">Date</label>
        <input id="evt-date" class="evm-in" readonly placeholder="Choisir une date" />
        <label class="evm-check"><input type="checkbox" id="evt-yearly" />Chaque année à la même date</label>
        <button type="button" class="evm-add" id="evt-add">Ajouter</button>
        <div class="evm-list" id="evt-list"></div>
      </div>
    </div>

    <div class="overlay" id="notes-overlay">
      <div class="modal">
        <button class="m-close" id="notes-close" type="button" aria-label="Fermer">×</button>
        <h2>Notes</h2>
        <div class="notes-compose">
          <textarea id="notes-input" maxlength="1000" placeholder="Un rappel pour l'équipe… (ex. « livraison farine à 10h », « rappeler le fournisseur »)"></textarea>
          <div class="notes-compose-actions">
            <div class="nc-tags" id="nc-tags">
              <button type="button" class="nc-tag" data-tag="important">Important</button>
              <button type="button" class="nc-tag" data-tag="recurrent">Récurrent</button>
              <button type="button" class="nc-tag" data-tag="fournisseur">Fournisseur</button>
            </div>
            <button class="nc-save" id="nc-save" type="button">Ajouter</button>
          </div>
        </div>
        <div class="notes-msg" id="notes-msg"></div>
        <div id="notes-list"></div>
      </div>
    </div>

    <AdminNav current="home" />

    <!-- Dati SSR (Fase 2): 5 isole pre-caricate dal server, lette dal client. -->
    <script id="ssr-home" type="application/json" is:inline set:html={ssrHomeJson}></script>

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { SERVIZI_WIDGET } from "../../lib/reservationI18n";

      type Item = { id: string; name: string; qty: number; price_cents: number; notes: string };
      type Order = { pickup_time: string; customer_name: string; items: Item[]; total_cents: number; status: string };
      type ResaRow = { heure: string; first_name?: string; last_name?: string; people: number; status: string };
      type Config = {
        lunch_active: boolean; lunch_open: string | null; lunch_close: string | null;
        dinner_active: boolean; dinner_open: string | null; dinner_close: string | null;
        prep_time_minutes: number; slot_duration_minutes: number;
      } | null;
      type MenuRow = { category: string; available: boolean };
      type Cat = { name: string; kind: "food" | "drink" };
      type Note = { id: string; content: string; author: string | null; done: boolean; created_at: string; tags?: string[] | null };
      type StatsResp = {
        revenue_cents: number;
        peak_hour: number | null;
        top: { name: string; qty: number }[];
        series: { label: string; count: number }[];
      };

      const CLOCK =
        '<svg class="clock" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><polyline points="12 7 12 12 15 14" /></svg>';
      const TRASH_ICON =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>';
      const CHECK_ICON =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

      function dayKey(d: Date): string {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, "0");
        const g = String(d.getDate()).padStart(2, "0");
        return `${y}-${m}-${g}`;
      }
      function euro(cents: number): string {
        return (cents / 100).toLocaleString("fr-BE", { style: "currency", currency: "EUR" });
      }
      // Fuso del ristorante, esposto dall'header (data-tz)
      const TZ_LOCALE = (document.querySelector(".ah-header") as HTMLElement | null)?.dataset.tz || "Europe/Brussels";
      function oraDa(iso: string): string {
        return new Date(iso).toLocaleTimeString("fr-BE", { timeZone: TZ_LOCALE, hour: "2-digit", minute: "2-digit" });
      }
      function dayKeyBrussels(iso: string): string {
        return new Date(iso).toLocaleDateString("en-CA", { timeZone: TZ_LOCALE });
      }
      function escHtml(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }
      function noteDate(iso: string): string {
        return new Date(iso).toLocaleString("fr-BE", {
          timeZone: TZ_LOCALE, day: "numeric", month: "short", hour: "2-digit", minute: "2-digit",
        });
      }
      function fasce(cfg: NonNullable<Config>): string[] {
        // Il DB salva time con i secondi ("11:00:00") -> mostra solo HH:MM
        const hhmm = (t: string) => t.slice(0, 5);
        const b: string[] = [];
        if (cfg.lunch_active && cfg.lunch_open && cfg.lunch_close) b.push(`${hhmm(cfg.lunch_open)} – ${hhmm(cfg.lunch_close)}`);
        if (cfg.dinner_active && cfg.dinner_open && cfg.dinner_close) b.push(`${hhmm(cfg.dinner_open)} – ${hhmm(cfg.dinner_close)}`);
        return b;
      }

      // ---------- Notes: anteprima nel tile + board nel modale ----------
      async function avviaNote(headers: Record<string, string>) {
        const preview = document.getElementById("notes-preview") as HTMLElement;
        const expandBtn = document.getElementById("notes-expand") as HTMLButtonElement;
        const addBtn = document.getElementById("notes-add") as HTMLButtonElement;
        const overlay = document.getElementById("notes-overlay") as HTMLElement;
        const closeBtn = document.getElementById("notes-close") as HTMLButtonElement;
        const input = document.getElementById("notes-input") as HTMLTextAreaElement;
        const saveBtn = document.getElementById("nc-save") as HTMLButtonElement;
        const listEl = document.getElementById("notes-list") as HTMLElement;
        const msgEl = document.getElementById("notes-msg") as HTMLElement;
        let notes: Note[] = [];

        async function erroreDa(res: Response, fallback: string): Promise<string> {
          try { return ((await res.json()) as { error?: string }).error || fallback; } catch { return `${fallback} (HTTP ${res.status})`; }
        }

        const TAG_FR: Record<string, string> = { important: "Important", recurrent: "Récurrent", fournisseur: "Fournisseur" };
        const tagPills = (n: Note): string => {
          const t = Array.isArray(n.tags) ? n.tags.filter((x) => TAG_FR[x]) : [];
          return t.length ? `<div class="note-tags">${t.map((x) => `<span class="note-tag t-${x}">${TAG_FR[x]}</span>`).join("")}</div>` : "";
        };

        function renderPreview() {
          if (notes.length === 0) {
            preview.innerHTML = '<p class="np-empty">Aucune note. Appuie sur + pour en ajouter.</p>';
            return;
          }
          const primi = notes.slice(0, 3);
          const resto = notes.length - primi.length;
          preview.innerHTML =
            primi
              .map(
                (n) => `
              <div class="np-item${n.done ? " done" : ""}">
                <span class="np-dot"></span><span class="np-text">${escHtml(n.content)}</span>${tagPills(n)}
              </div>`
              )
              .join("") +
            (resto > 0 ? `<div class="np-more">+${resto} autre${resto > 1 ? "s" : ""}…</div>` : "");
        }
        function renderList() {
          if (notes.length === 0) {
            listEl.innerHTML = '<p class="notes-empty">Aucune note. Ajoute un rappel pour l\'équipe.</p>';
            return;
          }
          listEl.innerHTML = notes
            .map(
              (n) => `
            <div class="note${n.done ? " done" : ""}" data-id="${n.id}">
              <button class="note-check" type="button" title="${n.done ? "Rouvrir" : "Marquer comme fait"}">${n.done ? CHECK_ICON : ""}</button>
              <div class="note-body">
                <div class="note-text">${escHtml(n.content)}</div>${tagPills(n)}
                <div class="note-meta">${n.author ? escHtml(n.author) + " · " : ""}${noteDate(n.created_at)}</div>
              </div>
              <button class="note-del" type="button" title="Supprimer">${TRASH_ICON}</button>
            </div>`
            )
            .join("");
        }
        function render() { renderPreview(); renderList(); }

        function openModal(focus: boolean) {
          msgEl.textContent = "";
          overlay.classList.add("is-open");
          if (focus) input.focus();
        }
        function closeModal() { overlay.classList.remove("is-open"); }

        expandBtn.addEventListener("click", () => openModal(false));
        addBtn.addEventListener("click", () => openModal(true));
        preview.addEventListener("click", () => openModal(false));
        closeBtn.addEventListener("click", closeModal);
        overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });

        const tagSel = new Set<string>();
        const tagsBox = document.getElementById("nc-tags") as HTMLElement | null;
        tagsBox?.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".nc-tag") as HTMLButtonElement | null;
          if (!b || !b.dataset.tag) return;
          const t = b.dataset.tag;
          if (tagSel.has(t)) tagSel.delete(t); else tagSel.add(t);
          b.classList.toggle("is-on", tagSel.has(t));
        });
        const azzeraTag = () => {
          tagSel.clear();
          tagsBox?.querySelectorAll(".nc-tag").forEach((b) => b.classList.remove("is-on"));
        };

        saveBtn.addEventListener("click", async () => {
          const content = input.value.trim();
          if (!content) { input.focus(); return; }
          msgEl.textContent = "";
          saveBtn.disabled = true;
          try {
            const res = await fetch("/api/admin/notes", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ content, tags: [...tagSel] }),
            });
            if (res.ok) {
              notes.unshift((await res.json()).note as Note);
              input.value = "";
              azzeraTag();
              render();
            } else {
              msgEl.textContent = await erroreDa(res, "Ajout impossible.");
            }
          } catch {
            msgEl.textContent = "Erreur de connexion.";
          } finally {
            saveBtn.disabled = false;
          }
        });

        listEl.addEventListener("click", async (e) => {
          const t = e.target as HTMLElement;
          const row = t.closest(".note") as HTMLElement | null;
          if (!row) return;
          const id = row.dataset.id!;
          const n = notes.find((x) => x.id === id);
          if (!n) return;

          if (t.closest(".note-check")) {
            const nuovo = !n.done;
            msgEl.textContent = "";
            try {
              const res = await fetch("/api/admin/notes", {
                method: "PUT",
                headers: { ...headers, "Content-Type": "application/json" },
                body: JSON.stringify({ id, done: nuovo }),
              });
              if (res.ok) { n.done = nuovo; render(); }
              else { msgEl.textContent = await erroreDa(res, "Modification impossible."); }
            } catch { msgEl.textContent = "Erreur de connexion."; }
            return;
          }

          const del = t.closest(".note-del") as HTMLButtonElement | null;
          if (del) {
            if (!del.classList.contains("confirm")) {
              del.classList.add("confirm");
              del.textContent = "Supprimer ?";
              setTimeout(() => { del.classList.remove("confirm"); del.innerHTML = TRASH_ICON; }, 4000);
              return;
            }
            msgEl.textContent = "";
            try {
              const res = await fetch("/api/admin/notes", {
                method: "POST",
                headers: { ...headers, "Content-Type": "application/json" },
                body: JSON.stringify({ delete_id: id }),
              });
              if (res.ok) { notes = notes.filter((x) => x.id !== id); render(); }
              else { msgEl.textContent = await erroreDa(res, "Suppression impossible."); }
            } catch { msgEl.textContent = "Erreur de connexion."; }
          }
        });

        try {
          const res = await fetch("/api/admin/notes", { headers });
          if (!res.ok) { preview.innerHTML = '<p class="np-empty">Notes indisponibles.</p>'; return; }
          notes = ((await res.json()).notes as Note[]) ?? [];
          render();
        } catch {
          preview.innerHTML = '<p class="np-empty">Erreur de connexion.</p>';
        }
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const cardsEl = document.getElementById("cards") as HTMLDivElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        const oggi = new Date();
        const oggiKey = dayKey(oggi);

        const token = session.access_token ?? "";
        const headers = { Authorization: `Bearer ${token}` };

        // Cards visibili subito; Notes e tile si popolano in parallelo.
        stateEl.style.display = "none";
        cardsEl.style.display = "grid";
        const fabOrg = document.getElementById("organiser-btn");
        if (fabOrg) fabOrg.style.display = "flex";
        posizionaIsole();

        // ---- Allineamento isole (SOLO home): ingranaggio Admin subito a sinistra
        // dell'isola dei link; FAB Organiser a sinistra, centrato con l'isola.
        function posizionaIsole() {
          const nav = document.querySelector(".admin-nav") as HTMLElement | null;
          if (!nav) return;
          const largo = window.matchMedia("(min-width: 521px)").matches;
          const r = nav.getBoundingClientRect();
          for (const id of ["organiser-btn", "organiser-reset"]) {
            const el = document.getElementById(id) as HTMLElement | null;
            if (el) el.style.bottom = largo ? `${window.innerHeight - r.bottom + (r.height - 52) / 2}px` : "";
          }
        }
        window.addEventListener("resize", posizionaIsole);

        avviaNote(headers);

        // ---------- Photos récentes (bibliothèque, ultime 8) ----------
        (async () => {
          const phGrid = document.getElementById("ph-grid") as HTMLElement;
          try {
            const res = await fetch("/api/admin/images", { headers });
            if (!res.ok) throw new Error();
            const images = (((await res.json()) as { images: { url: string; name: string }[] }).images) ?? [];
            if (!images.length) {
              phGrid.innerHTML = '<div class="ph-empty">Aucune image pour le moment — téléverse une photo depuis Menu ou Marketing.</div>';
              return;
            }
            phGrid.innerHTML = images
              .slice(0, 8)
              .map(
                (i) =>
                  `<a class="ph-cell" href="/admin/assets" title="${escHtml(i.name)}"><img src="${escHtml(i.url)}" alt="" loading="lazy" /></a>`
              )
              .join("");
          } catch {
            phGrid.innerHTML = '<div class="ph-empty">Images indisponibles.</div>';
          }
        })();

        // ---------- Événements du pays (calcolo locale, nessuna API) ----------
        // Feste ufficiali belghe + date commerciali utili a un ristorante.
        // Le feste mobili derivano dalla Pasqua (algoritmo di Gauss).
        let eventiLocali: { date: string; label: string; yearly: boolean }[] = [];
        async function caricaEventiLocali(): Promise<void> {
          try {
            const res = await fetch("/api/admin/events", { headers });
            if (res.ok) eventiLocali = (((await res.json()) as { events?: typeof eventiLocali }).events ?? []);
          } catch { /* niente eventi locali */ }
        }
        async function renderEventi(): Promise<void> {
          const box = document.getElementById("spx-evts") as HTMLElement | null;
          if (!box) return;
          const pasqua = (anno: number): Date => {
            const a = anno % 19, b = Math.floor(anno / 100), c = anno % 100;
            const d = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25);
            const g = Math.floor((b - f + 1) / 3), h = (19 * a + b - d - g + 15) % 30;
            const i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7;
            const m = Math.floor((a + 11 * h + 22 * l) / 451);
            const mese = Math.floor((h + l - 7 * m + 114) / 31);
            const giorno = ((h + l - 7 * m + 114) % 31) + 1;
            return new Date(anno, mese - 1, giorno);
          };
          const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
          const somma = (d: Date, gg: number) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + gg);
          const nDomenica = (anno: number, mese0: number, n: number): Date => {
            const primo = new Date(anno, mese0, 1);
            const off = (7 - primo.getDay()) % 7; // prima domenica
            return new Date(anno, mese0, 1 + off + (n - 1) * 7);
          };
          const eventiAnno = (anno: number): [string, string][] => {
            const P = pasqua(anno);
            const ev: [Date, string][] = [
              [new Date(anno, 0, 1), "Nouvel An"],
              [new Date(anno, 1, 14), "Saint-Valentin"],
              [somma(P, -47), "Mardi Gras"],
              [P, "Pâques"],
              [somma(P, 1), "Lundi de Pâques"],
              [new Date(anno, 4, 1), "Fête du Travail"],
              [nDomenica(anno, 4, 2), "Fête des Mères"],
              [somma(P, 39), "Ascension"],
              [somma(P, 49), "Pentecôte"],
              [somma(P, 50), "Lundi de Pentecôte"],
              [nDomenica(anno, 5, 2), "Fête des Pères"],
              [new Date(anno, 6, 21), "Fête nationale belge"],
              [new Date(anno, 7, 15), "Assomption"],
              [new Date(anno, 9, 31), "Halloween"],
              [new Date(anno, 10, 1), "Toussaint"],
              [new Date(anno, 10, 11), "Armistice"],
              [new Date(anno, 11, 6), "Saint-Nicolas"],
              [new Date(anno, 11, 24), "Réveillon de Noël"],
              [new Date(anno, 11, 25), "Noël"],
              [new Date(anno, 11, 31), "Réveillon du Nouvel An"],
            ];
            return ev.map(([d, n]) => [iso(d), n]);
          };
          const oggiBx = new Intl.DateTimeFormat("en-CA", { timeZone: TZ_LOCALE }).format(new Date());
          const anno = Number(oggiBx.slice(0, 4));
          // Feste del paese + eventi LOCALI (terzo campo = locale, reso in oro)
          const tutti: [string, string, boolean][] = [...eventiAnno(anno), ...eventiAnno(anno + 1)].map(
            ([d, n]) => [d, n, false] as [string, string, boolean]
          );
          for (const ev of eventiLocali) {
            if (ev.yearly) {
              const mmdd = ev.date.slice(5);
              tutti.push([`${anno}-${mmdd}`, ev.label, true], [`${anno + 1}-${mmdd}`, ev.label, true]);
            } else {
              tutti.push([ev.date, ev.label, true]);
            }
          }
          const futuri = tutti
            .filter(([d]) => d >= oggiBx)
            .sort((a, b) => (a[0] < b[0] ? -1 : 1))
            .slice(0, 3);

          // Aperto/chiuso quel giorno: month API pubblica (orari settimanali +
          // jours spéciaux, stessa fonte del widget). Errore → nessun tag.
          const chiusi = new Set<string>();
          let tagOk = false;
          try {
            const mesi = [...new Set(futuri.map(([d]) => d.slice(0, 7)))];
            const risp = await Promise.all(mesi.map((m) => fetch("/api/reservation?month=" + m).then((r) => r.json())));
            for (const rr of risp) for (const d of rr.closed ?? []) chiusi.add(d);
            tagOk = true;
          } catch { /* niente tag */ }

          const escEv = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
          box.innerHTML = futuri
            .map(([d, nome, loc]) => {
              const dt = new Date(d + "T12:00:00");
              const mese = dt.toLocaleDateString("fr-BE", { month: "short" }).replace(".", "");
              const gg = dt.toLocaleDateString("fr-BE", { weekday: "long" });
              const tag = tagOk
                ? (chiusi.has(d) ? '<span class="spx-b closed">Fermé</span>' : '<span class="spx-b open">Ouvert</span>')
                : "";
              return `<div class="spx-ev"><span class="ev-cal"><b>${Number(d.slice(8, 10))}</b><i>${mese}</i></span><span class="ev-txt"><span class="ev-nome${loc ? " ev-loc" : ""}">${escEv(nome)}${tag ? " " + tag : ""}</span><span class="ev-gg">${gg}</span></span></div>`;
            })
            .join("");
        }
        void caricaEventiLocali().then(renderEventi);

        // ---------- Modale Evenements locaux (bottone + della tile) ----------
        (() => {
          const evtOverlay = document.getElementById("evt-overlay") as HTMLDivElement | null;
          const evtBtn = document.getElementById("spx-add") as HTMLButtonElement | null;
          if (!evtOverlay || !evtBtn) return;
          const evtNom = document.getElementById("evt-nom") as HTMLInputElement;
          const evtDate = document.getElementById("evt-date") as HTMLInputElement;
          const evtYear = document.getElementById("evt-yearly") as HTMLInputElement;
          const evtAdd = document.getElementById("evt-add") as HTMLButtonElement;
          const evtList = document.getElementById("evt-list") as HTMLDivElement;
          const evtClose = document.getElementById("evt-close") as HTMLButtonElement;
          const headersJson = { ...headers, "Content-Type": "application/json" };

          const fdFr = (iso: string) => { const [y, m, d] = iso.split("-"); return `${d}/${m}/${y}`; };
          const escE = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");

          function renderListaEvt() {
            evtList.innerHTML = eventiLocali.length
              ? eventiLocali
                  .map((ev, i) =>
                    `<div class="evm-row"><span class="d">${fdFr(ev.date)}</span><span class="n">${escE(ev.label)}</span>${ev.yearly ? '<span class="y">chaque année</span>' : ""}<button type="button" class="evm-del" data-i="${i}" aria-label="Supprimer">✕</button></div>`
                  )
                  .join("")
              : '<div class="evm-vide">Aucun événement local pour le moment.</div>';
          }
          async function salvaEvt(): Promise<boolean> {
            try {
              const res = await fetch("/api/admin/events", {
                method: "PUT",
                headers: headersJson,
                body: JSON.stringify({ events: eventiLocali }),
              });
              return res.ok;
            } catch {
              return false;
            }
          }
          const apriEvt = () => { renderListaEvt(); evtOverlay.classList.add("is-open"); };
          const chiudiEvt = () => { evtOverlay.classList.remove("is-open"); dpChiudi(); };
          evtBtn.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); apriEvt(); });
          evtClose.addEventListener("click", chiudiEvt);
          evtOverlay.addEventListener("click", (e) => { if (e.target === evtOverlay) chiudiEvt(); });

          evtAdd.addEventListener("click", async () => {
            const label = evtNom.value.trim();
            const iso = evtDate.dataset.iso ?? "";
            if (!label || !iso) return;
            eventiLocali.push({ date: iso, label, yearly: evtYear.checked });
            eventiLocali.sort((a, b) => (a.date < b.date ? -1 : 1));
            if (await salvaEvt()) {
              evtNom.value = "";
              evtDate.value = "";
              delete evtDate.dataset.iso;
              evtYear.checked = false;
              renderListaEvt();
              void renderEventi();
            } else {
              await caricaEventiLocali();
              renderListaEvt();
            }
          });

          evtList.addEventListener("click", async (e) => {
            const b = (e.target as HTMLElement).closest(".evm-del") as HTMLButtonElement | null;
            if (!b) return;
            if (!b.classList.contains("confirm")) {
              b.classList.add("confirm");
              b.textContent = "Supprimer ?";
              window.setTimeout(() => { b.classList.remove("confirm"); b.textContent = "✕"; }, 2500);
              return;
            }
            eventiLocali.splice(Number(b.dataset.i), 1);
            if (await salvaEvt()) {
              renderListaEvt();
              void renderEventi();
            } else {
              await caricaEventiLocali();
              renderListaEvt();
            }
          });

          // ----- Datepicker brand (copia locale, un solo campo) -----
          const MESI_DP = ["janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre"];
          const DOW_DP = ["L", "M", "M", "J", "V", "S", "D"];
          let dpAnno = 0;
          let dpMese = 0;
          const dpPanel = document.createElement("div");
          dpPanel.className = "dp-panel";
          dpPanel.style.display = "none";
          document.body.appendChild(dpPanel);

          const isoOggiDp = (): string => {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
          };
          const isoDiDp = (y: number, m: number, g: number): string =>
            `${y}-${String(m + 1).padStart(2, "0")}-${String(g).padStart(2, "0")}`;

          function dpRender() {
            const oggi = isoOggiDp();
            const sel = evtDate.dataset.iso ?? "";
            const offset = (new Date(dpAnno, dpMese, 1).getDay() + 6) % 7;
            const nGiorni = new Date(dpAnno, dpMese + 1, 0).getDate();
            const oy = Number(oggi.slice(0, 4));
            const om = Number(oggi.slice(5, 7)) - 1;
            const prevOff = dpAnno < oy || (dpAnno === oy && dpMese <= om);
            let celle = "";
            for (let i = 0; i < offset; i++) celle += '<span class="dp-cell dp-vuota"></span>';
            for (let g = 1; g <= nGiorni; g++) {
              const iso = isoDiDp(dpAnno, dpMese, g);
              const cls = ["dp-cell"];
              if (iso < oggi) cls.push("dp-off");
              if (iso === oggi) cls.push("dp-today");
              if (iso === sel) cls.push("dp-sel");
              celle += `<button type="button" class="${cls.join(" ")}" data-iso="${iso}" ${iso < oggi ? "disabled" : ""}>${g}</button>`;
            }
            dpPanel.innerHTML = `
              <div class="dp-head">
                <button type="button" class="dp-nav" data-nav="-1" ${prevOff ? "disabled" : ""}>‹</button>
                <span class="dp-title">${MESI_DP[dpMese]} ${dpAnno}</span>
                <button type="button" class="dp-nav" data-nav="1">›</button>
              </div>
              <div class="dp-dow">${DOW_DP.map((g) => `<span>${g}</span>`).join("")}</div>
              <div class="dp-grid">${celle}</div>`;
          }
          function dpApri() {
            const base = evtDate.dataset.iso || isoOggiDp();
            dpAnno = Number(base.slice(0, 4));
            dpMese = Number(base.slice(5, 7)) - 1;
            dpRender();
            dpPanel.style.display = "block";
            const r = evtDate.getBoundingClientRect();
            const pw = dpPanel.offsetWidth || 308;
            const ph = dpPanel.offsetHeight || 360;
            dpPanel.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - pw - 8))}px`;
            dpPanel.style.top = `${Math.max(8, Math.min(r.bottom + 6, window.innerHeight - ph - 8))}px`;
          }
          function dpChiudi() {
            dpPanel.style.display = "none";
          }
          dpPanel.addEventListener("click", (e) => {
            e.stopPropagation();
            const t = e.target as HTMLElement;
            if (t.classList.contains("dp-nav")) {
              dpMese += Number(t.dataset.nav);
              if (dpMese < 0) { dpMese = 11; dpAnno--; }
              if (dpMese > 11) { dpMese = 0; dpAnno++; }
              dpRender();
              return;
            }
            if (t.classList.contains("dp-cell") && t.dataset.iso) {
              evtDate.dataset.iso = t.dataset.iso;
              evtDate.value = fdFr(t.dataset.iso);
              dpChiudi();
            }
          });
          evtDate.addEventListener("click", (e) => { e.stopPropagation(); dpApri(); });
          document.addEventListener("click", (e) => {
            if (dpPanel.style.display !== "none" && !dpPanel.contains(e.target as Node) && e.target !== evtDate) dpChiudi();
          });
          document.addEventListener("keydown", (e) => { if (e.key === "Escape") dpChiudi(); });
        })();

        // ---------- Jours spéciaux (fetch autonomo, fuori dal batch SSR) ----------
        (async () => {
          const wrap = document.getElementById("spx-list") as HTMLDivElement | null;
          if (!wrap) return;
          try {
            const res = await fetch("/api/admin/special-days", { headers });
            if (!res.ok) throw new Error();
            const days = (((await res.json()) as { days: { type: string; date_from: string; date_to: string; note?: string | null }[] }).days) ?? [];
            if (!days.length) {
              wrap.innerHTML = '<div class="spx-empty">Aucun jour spécial à venir</div>';
              return;
            }
            const fd = (iso: string) => { const [y, m, d] = iso.split("-"); return `${d}/${m}/${y}`; };
            const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
            const MAX = 4;
            wrap.innerHTML =
              days.slice(0, MAX).map((sp) => {
                const dates = sp.date_from === sp.date_to ? fd(sp.date_from) : `${fd(sp.date_from)} → ${fd(sp.date_to)}`;
                const b = sp.type === "closed" ? '<span class="spx-b closed">Fermé</span>' : '<span class="spx-b open">Ouvert</span>';
                const nota = sp.note ? `<span class="spx-note">${esc(String(sp.note))}</span>` : "";
                return `<div class="spx-row">${b}<span class="spx-date">${dates}</span>${nota}</div>`;
              }).join("") +
              (days.length > MAX ? `<div class="spx-more">+ ${days.length - MAX} autres…</div>` : "");
          } catch {
            wrap.innerHTML = '<div class="spx-empty">Indisponible</div>';
          }
        })();

        try {
          // SSR (Fase 2): 5 isole pre-caricate dal server (ssr-home). Se
          // presenti, i tile principali appaiono all'istante senza fetch; le
          // statistiche (3) partono subito ma si attendono solo al momento
          // dell'uso, così non bloccano i primi tile. Senza SSR → come prima.
          const fakeRes = (obj: any) => ({ ok: true, json: async () => obj });
          let ssrHome: any = null;
          try {
            const raw = document.getElementById("ssr-home")?.textContent?.trim();
            if (raw) ssrHome = JSON.parse(raw);
          } catch {
            ssrHome = null;
          }

          let resOrd: any, resResa: any, resToday: any, resMenu: any, resCats: any;
          let resSD: any, resSM: any, resSW: any;

          if (ssrHome) {
            resOrd = fakeRes(ssrHome.orders);
            resResa = fakeRes(ssrHome.resa);
            resToday = fakeRes(ssrHome.today);
            resMenu = fakeRes(ssrHome.menu);
            resCats = fakeRes(ssrHome.categories);
            const pSD = fetch("/api/admin/stats?period=day", { headers });
            const pSM = fetch("/api/admin/stats?period=month", { headers });
            const pSW = fetch("/api/admin/stats?period=week", { headers });
            const lazy = (p: Promise<Response>) => ({
              ok: true,
              json: async () => {
                const r = await p;
                if (!r.ok) throw new Error();
                return r.json();
              },
            });
            resSD = lazy(pSD);
            resSM = lazy(pSM);
            resSW = lazy(pSW);
          } else {
            [resOrd, resResa, resToday, resMenu, resCats, resSD, resSM, resSW] = await Promise.all([
              fetch("/api/admin/orders", { headers }),
              fetch("/api/admin/reservations?date=" + oggiKey, { headers }),
              fetch("/api/admin/today", { headers }),
              fetch("/api/admin/menu", { headers }),
              fetch("/api/admin/categories", { headers }),
              fetch("/api/admin/stats?period=day", { headers }),
              fetch("/api/admin/stats?period=month", { headers }),
              fetch("/api/admin/stats?period=week", { headers }),
            ]);
          }

          // ---------- Commandes ----------
          if (resOrd.ok) {
            const orders = ((await resOrd.json()).orders as Order[]) ?? [];
            const ordOggi = orders
              .filter((o) => dayKeyBrussels(o.pickup_time) === oggiKey && o.status !== "cancelled")
              .sort((a, b) => (a.pickup_time < b.pickup_time ? -1 : 1));
            const ordTot = ordOggi.reduce((s, o) => s + o.total_cents, 0);
            (document.getElementById("ord-count") as HTMLElement).textContent = String(ordOggi.length);
            (document.getElementById("ord-tot") as HTMLElement).textContent = euro(ordTot);

            const oraOra = new Date();
            const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
            const prossimi = ordOggi.filter((o) => o.status === "paid" && new Date(o.pickup_time) >= oraOra).slice(0, 3);
            const ordNextList = document.getElementById("ord-next-list") as HTMLElement;
            ordNextList.innerHTML = prossimi.length
              ? prossimi.map((o) => `<div class="ord-nx"><span class="nx-h">${oraDa(o.pickup_time)}</span><span class="nx-n">${esc(String(o.customer_name ?? ""))}</span></div>`).join("")
              : '<span class="val none">Aucun à venir</span>';
          }

          // ---------- Réservations (aujourd'hui) ----------
          if (resResa.ok) {
            const jr = await resResa.json();
            const tutte = (jr.reservations as ResaRow[]) ?? [];
            const rese = tutte.filter((r) => r.status === "confirmed");
            const couv = Number(jr.couverts ?? 0);
            (document.getElementById("resa-count") as HTMLElement).textContent = String(rese.length);
            (document.getElementById("resa-sub") as HTMLElement).textContent =
              rese.length > 0 ? `aujourd'hui · ${couv} couv.` : "aujourd'hui";

            // Mini-grafica: conteggio per stato (stessi colori della pagina Résa)
            const STATI: [string, string, string][] = [
              ["confirmed", "Conf.", "#2e9e6b"],
              ["seated", "En cours", "#3b82f6"],
              ["done", "Fini", "var(--c-muted)"],
              ["noshow", "No-show", "var(--c-accent)"],
              ["cancelled", "Annul.", "#ed1c24"],
            ];
            const miniEl = document.getElementById("resa-mini") as HTMLElement | null;
            if (miniEl) {
              const contaSt = (st: string) => tutte.filter((r) => r.status === st).length;
              const max = Math.max(1, ...STATI.map(([st]) => contaSt(st)));
              miniEl.innerHTML = STATI.map(([st, lab, col]) => {
                const n = contaSt(st);
                const h = Math.max(2, Math.round((n / max) * 34));
                return `<span class="rmc" title="${lab}"><b>${n}</b><i style="height:${h}px;background:${col}"></i></span>`;
              }).join("");
            }

            // Chiusure «jusqu'à réouverture» (reason: permanent, da caricaResaGiorno)
            const escP = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
            const permEl = document.getElementById("resa-perm") as HTMLElement | null;
            if (permEl) {
              const svPerm = ((jr.closures ?? []) as { service_key: string; reason: string }[])
                .filter((c) => c.reason === "permanent")
                .map((c) => SERVIZI_WIDGET[c.service_key]?.fr ?? c.service_key);
              const znPerm = ((jr.zone_closures ?? []) as { zone: string; reason: string }[])
                .filter((c) => c.reason === "permanent")
                .map((c) => c.zone);
              const nomi = [...svPerm, ...znPerm];
              permEl.innerHTML = nomi
                .map((n) => `<span class="rp-pill">${escP(n)} — fermé jusqu\u2019à réouverture</span>`)
                .join("");
              permEl.style.display = nomi.length ? "" : "none";
            }

            const nowHM = new Intl.DateTimeFormat("en-GB", {
              timeZone: TZ_LOCALE, hour: "2-digit", minute: "2-digit", hour12: false,
            }).format(new Date());
            const escR = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
            const prossime = rese
              .slice()
              .sort((a, b) => (a.heure < b.heure ? -1 : 1))
              .filter((r) => String(r.heure).slice(0, 5) >= nowHM)
              .slice(0, 3);
            const resaNextList = document.getElementById("resa-next-list") as HTMLElement;
            resaNextList.innerHTML = prossime.length
              ? prossime.map((r) => {
                  const nome = `${r.first_name ?? ""} ${r.last_name ?? ""}`.trim();
                  return `<div class="ord-nx"><span class="nx-h">${String(r.heure).slice(0, 5)}</span><span class="nx-n">${escR(nome)} (${r.people})</span></div>`;
                }).join("")
              : '<span class="val none">Aucune à venir</span>';
          }

          // ---------- Horaires (aujourd'hui) ----------
          const statusEl = document.getElementById("sched-status") as HTMLElement;
          const bandsWrap = document.getElementById("sched-bands-wrap") as HTMLElement;
          type Today = { config: Config; orders_closed?: boolean; closes_at?: string | null; reopen?: { in_days: number; heure: string } | null };
          const jt: Today | null = resToday.ok ? ((await resToday.json()) as Today) : null;
          const cfg = jt?.config ?? null;
          if (!cfg) {
            statusEl.textContent = "Indisponible";
            statusEl.classList.add("closed");
          } else {
            const b = fasce(cfg);
            if (b.length === 0) {
              statusEl.textContent = "Fermé aujourd'hui";
              statusEl.classList.add("closed");
              bandsWrap.innerHTML = "";
            } else {
              statusEl.textContent = "Ouvert aujourd'hui";
              statusEl.classList.add("open");
              bandsWrap.innerHTML =
                `<div class="sched-bands">` +
                b.map((f) => `<span class="sched-band">${CLOCK}${f}</span>`).join("") +
                `</div>`;
            }
          }

          // Réouverture / fermeture del giorno (tile Horaires)
          const reLab = document.getElementById("sched-reopen-lab") as HTMLElement | null;
          const reVal = document.getElementById("sched-reopen") as HTMLElement | null;
          if (reLab && reVal) {
            if (jt?.closes_at) {
              reLab.textContent = "Fermeture";
              reVal.textContent = `à ${jt.closes_at}`;
            } else if (jt?.reopen) {
              const g = jt.reopen.in_days;
              let quando: string;
              if (g === 0) quando = "aujourd'hui";
              else if (g === 1) quando = "demain";
              else {
                const dt = new Date(Date.now() + g * 86400000);
                quando = dt.toLocaleDateString("fr-BE", { weekday: "long", timeZone: TZ_LOCALE });
                if (g > 6) quando += " " + dt.toLocaleDateString("fr-BE", { day: "2-digit", month: "2-digit", timeZone: TZ_LOCALE });
              }
              reLab.textContent = "Réouverture";
              reVal.textContent = `${quando} à ${jt.reopen.heure}`;
            } else {
              reVal.textContent = "—";
              reVal.classList.add("none");
            }
          }

          // ---------- Cuisine ----------
          const cuiStatus = document.getElementById("cui-status") as HTMLElement | null;
          const cuiSw = document.getElementById("cui-sw") as HTMLButtonElement | null;
          // La cucina è chiusa se il manager l'ha chiusa (switch) O se il
          // ristorante è chiuso oggi (nessuna fascia). Lo switch riflette solo
          // la chiusura manuale.
          const giornoSenzaServizio = !cfg || fasce(cfg).length === 0;
          let cucinaChiusaManuale = Boolean(jt?.orders_closed);
          const aggiornaCucina = () => {
            const chiusa = cucinaChiusaManuale || giornoSenzaServizio;
            if (cuiStatus) {
              cuiStatus.textContent = chiusa ? "Fermée" : "Ouverte";
              cuiStatus.classList.toggle("closed", chiusa);
              cuiStatus.classList.toggle("open", !chiusa);
            }
            cuiSw?.classList.toggle("is-on", !cucinaChiusaManuale);
          };
          aggiornaCucina();
          if (cfg) {
            const cp = document.getElementById("cui-prep") as HTMLElement | null;
            if (cp) cp.textContent = `${cfg.prep_time_minutes} min`;
            const cs = document.getElementById("cui-slot") as HTMLElement | null;
            if (cs) cs.textContent = `${cfg.slot_duration_minutes} min`;
          }
          cuiSw?.addEventListener("click", async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const nuovo = !cucinaChiusaManuale;
            cucinaChiusaManuale = nuovo;
            aggiornaCucina();
            try {
              const res = await fetch("/api/admin/settings", {
                method: "PATCH",
                headers: { ...headers, "Content-Type": "application/json" },
                body: JSON.stringify({ orders_closed: nuovo }),
              });
              if (!res.ok) { cucinaChiusaManuale = !nuovo; aggiornaCucina(); }
            } catch {
              cucinaChiusaManuale = !nuovo;
              aggiornaCucina();
            }
          });

          // ---------- Menu ----------
          if (resMenu.ok && resCats.ok) {
            const rows = ((await resMenu.json()).items as MenuRow[]) ?? [];
            const cats = ((await resCats.json()).categories as Cat[]) ?? [];
            const kindByCat = new Map(cats.map((c) => [c.name, c.kind]));
            let food = 0, drink = 0, indispo = 0;
            for (const r of rows) {
              if (kindByCat.get(r.category) === "drink") drink++;
              else food++;
              if (!r.available) indispo++;
            }
            (document.getElementById("menu-food") as HTMLElement).textContent = String(food);
            (document.getElementById("menu-drink") as HTMLElement).textContent = String(drink);
            const indispoEl = document.getElementById("menu-indispo") as HTMLElement;
            if (indispo > 0) {
              indispoEl.textContent = `${indispo} plat${indispo > 1 ? "s" : ""}`;
              indispoEl.classList.add("warn");
            } else {
              indispoEl.textContent = "Aucun — tout est visible";
              indispoEl.classList.add("none");
            }
          }

          // ---------- Statistiques ----------
          if (resSD.ok) {
            const sd = (await resSD.json()) as StatsResp;
            (document.getElementById("st-ca-day") as HTMLElement).textContent = euro(sd.revenue_cents);
          }
          if (resSM.ok) {
            const sm = (await resSM.json()) as StatsResp;
            (document.getElementById("st-ca-month") as HTMLElement).textContent = euro(sm.revenue_cents);
            (document.getElementById("st-top") as HTMLElement).textContent =
              sm.top.length ? `${sm.top[0].name} (${sm.top[0].qty}×)` : "—";
            const peakEl = document.getElementById("st-peak") as HTMLElement;
            if (sm.peak_hour === null) {
              peakEl.textContent = "—";
            } else {
              const h = String(sm.peak_hour).padStart(2, "0");
              const h2 = String((sm.peak_hour + 1) % 24).padStart(2, "0");
              peakEl.textContent = `${h}:00–${h2}:00`;
            }
          }
          if (resSW.ok) {
            const sw = (await resSW.json()) as StatsResp;
            const barsEl = document.getElementById("st-bars") as HTMLElement;
            const labsEl = document.getElementById("st-labs") as HTMLElement;
            const max = Math.max(...sw.series.map((b) => b.count), 1);
            const peakIdx = sw.series.findIndex((b) => b.count === max);
            barsEl.innerHTML = sw.series
              .map((b, i) => {
                const hPct = Math.round((b.count / max) * 100);
                const val = i === peakIdx && b.count > 0 ? `<span class="cval">${b.count}</span>` : "";
                return `<div class="st-bar${b.count === 0 ? " zero" : ""}" role="img" aria-label="${b.label} : ${b.count} commandes">${val}<span class="fill" style="height:${hPct}%"></span></div>`;
              })
              .join("");
            labsEl.innerHTML = sw.series.map((b) => `<span>${b.label}</span>`).join("");
          }
        } catch {
          /* i tile degradano in silenzio; la pagina resta usabile */
        }
      })();
    </script>

    <!-- Organiser : ordine + dimensione delle isole (per utente, salvato in DB) -->
    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";

      (async () => {
        const cards = document.getElementById("cards") as HTMLElement;
        if (!cards) return;
        const btn = document.getElementById("organiser-btn") as HTMLButtonElement | null;
        const btnReset = document.getElementById("organiser-reset") as HTMLButtonElement | null;

        type Item = { key: string; w?: number; minH?: number };
        const KEYS = ["notes", "orders", "reservations", "settings", "special", "cuisine", "menu", "google", "stats", "assets"];
        const DEFAULT_LAYOUT: Item[] = [
          { key: "notes", w: 1 }, { key: "orders", w: 1 }, { key: "reservations", w: 1 }, { key: "settings", w: 1 },
          { key: "special", w: 1 }, { key: "cuisine", w: 1 }, { key: "menu", w: 1 }, { key: "google", w: 1 },
          { key: "stats", w: 2 }, { key: "assets", w: 2 },
        ];

        let editing = false;

        const { data: sd } = await supabaseBrowser.auth.getSession();
        const token = sd.session?.access_token ?? "";
        const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };

        const mappa = () => {
          const m = new Map<string, HTMLElement>();
          cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((t) => m.set(t.dataset.tile as string, t));
          return m;
        };
        const colonne = () =>
          window.matchMedia("(max-width:560px)").matches ? 1 : window.matchMedia("(max-width:1100px)").matches ? 2 : 4;

        function applicaSpans() {
          const c = colonne();
          cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((t) => {
            const w = Math.min(c, Math.max(1, Number(t.dataset.w || 1)));
            t.style.gridColumn = "span " + w;
            const mh = Number(t.dataset.minh || 0);
            t.style.minHeight = mh > 0 ? mh + "px" : "";
          });
        }
        window.addEventListener("resize", applicaSpans);

        // Masonry: span verticale = altezza reale della tile in micro-righe.
        // Un ResizeObserver lo tiene aggiornato quando il contenuto cambia
        // (note caricate, liste, minHeight trascinato con la maniglia).
        const MICRO = 10, GAPPX = 20; // grid-auto-rows 10px, gap 1.25rem
        const spanAltezza = (t: HTMLElement) => {
          const h = t.getBoundingClientRect().height;
          const n = Math.max(1, Math.ceil((h + GAPPX) / (MICRO + GAPPX)));
          const nuovo = "span " + n;
          if (t.style.gridRowEnd !== nuovo) t.style.gridRowEnd = nuovo;
        };
        const roTile = new ResizeObserver((voci) => {
          for (const v of voci) spanAltezza(v.target as HTMLElement);
        });
        cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((t) => roTile.observe(t));

        function applicaLayout(layout: Item[]) {
          const m = mappa();
          const usati = new Set<string>();
          for (const it of layout) {
            const t = m.get(it.key);
            if (!t) continue;
            usati.add(it.key);
            t.dataset.w = String(Math.min(4, Math.max(1, Number(it.w) || 1)));
            if (it.minH && it.minH > 0) t.dataset.minh = String(it.minH);
            else delete t.dataset.minh;
            cards.appendChild(t);
          }
          for (const key of KEYS) {
            if (usati.has(key)) continue;
            const t = m.get(key);
            if (!t) continue;
            t.dataset.w = String(DEFAULT_LAYOUT.find((d) => d.key === key)?.w ?? 1);
            delete t.dataset.minh;
            cards.appendChild(t);
          }
          applicaSpans();
        }

        function layoutCorrente(): Item[] {
          const out: Item[] = [];
          cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((t) => {
            const w = Math.min(4, Math.max(1, Number(t.dataset.w || 1)));
            const mh = Number(t.dataset.minh || 0);
            out.push(mh > 0 ? { key: t.dataset.tile as string, w, minH: mh } : { key: t.dataset.tile as string, w });
          });
          return out;
        }

        let salvaTimer: number | undefined;
        function salva() {
          window.clearTimeout(salvaTimer);
          salvaTimer = window.setTimeout(() => {
            fetch("/api/admin/home-layout", { method: "PUT", headers, body: JSON.stringify({ layout: layoutCorrente() }) }).catch(() => {});
          }, 400);
        }

        // --- Tile Google : note, nombre d'avis, dernier avis ---
        (async () => {
          const tile = document.getElementById("tile-google") as HTMLElement | null;
          if (!tile) return;
          try {
            const res = await fetch("/api/admin/google-info", { headers });
            if (!res.ok) return;
            const g = (await res.json()) as {
              configured: boolean; name?: string; rating?: number | null; reviews?: number;
              maps_url?: string; avis?: { auteur: string; note: number; texte: string; quand: string }[];
            };
            if (!g.configured || g.rating == null) return; // niente Place ID → tile nascosta
            tile.style.display = "";
            const maps = document.getElementById("g-maps") as HTMLAnchorElement | null;
            if (maps) maps.href = g.maps_url || "#";
            const stelle = (n: number) => "★".repeat(Math.round(n)) + "☆".repeat(Math.max(0, 5 - Math.round(n)));
            const nota = Number(g.rating);
            const rEl = document.getElementById("g-rating");
            if (rEl) rEl.textContent = nota.toFixed(1).replace(".", ",");
            const sEl = document.getElementById("g-stars");
            if (sEl) sEl.textContent = stelle(nota);
            const cEl = document.getElementById("g-count");
            if (cEl) cEl.textContent = `${g.reviews ?? 0} avis Google`;

            // --- Carrousel des avis ---
            const avis = (g.avis ?? []).filter((a) => a.texte);
            if (!avis.length) return;
            const car = document.getElementById("g-carousel");
            const qEl = document.getElementById("g-quote");
            const wEl = document.getElementById("g-who");
            const asEl = document.getElementById("g-a-stars");
            const dots = document.getElementById("g-dots");
            if (car) car.style.display = "";
            let idx = 0;
            let auto: number | undefined;

            const mostra = (i: number) => {
              idx = (i + avis.length) % avis.length;
              const a = avis[idx];
              if (asEl) asEl.textContent = stelle(a.note || 0);
              if (qEl) qEl.textContent = "« " + (a.texte.length > 190 ? a.texte.slice(0, 190) + "…" : a.texte) + " »";
              if (wEl) wEl.textContent = [a.auteur, a.quand].filter(Boolean).join(" · ");
              if (dots) {
                dots.querySelectorAll("i").forEach((d, n) => d.classList.toggle("on", n === idx));
              }
            };
            if (dots) {
              dots.innerHTML = avis.map(() => "<i></i>").join("");
              dots.querySelectorAll("i").forEach((d, n) =>
                d.addEventListener("click", () => { mostra(n); riparti(); })
              );
            }
            const riparti = () => {
              window.clearInterval(auto);
              if (avis.length > 1) auto = window.setInterval(() => mostra(idx + 1), 7000);
            };
            document.getElementById("g-prev")?.addEventListener("click", () => { mostra(idx - 1); riparti(); });
            document.getElementById("g-next")?.addEventListener("click", () => { mostra(idx + 1); riparti(); });
            mostra(0);
            riparti();
          } catch { /* rete assente : tile reste cachée */ }
        })();

        // Carica il layout salvato (o default)
        try {
          const res = await fetch("/api/admin/home-layout", { headers });
          const j = await res.json();
          applicaLayout(Array.isArray(j.layout) && j.layout.length ? (j.layout as Item[]) : DEFAULT_LAYOUT);
        } catch {
          applicaLayout(DEFAULT_LAYOUT);
        }

        // Maniglie iniettate in ogni isola
        const GRIP =
          '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>';
        cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((t) => {
          const mv = document.createElement("div");
          mv.className = "tile-move";
          mv.title = "Déplacer";
          mv.innerHTML = GRIP;
          const rz = document.createElement("div");
          rz.className = "tile-resize";
          rz.title = "Redimensionner";
          t.appendChild(mv);
          t.appendChild(rz);

          // Trascinamento (riordino) — parte dalla maniglia in alto a sinistra
          mv.addEventListener("pointerdown", () => { if (editing) t.setAttribute("draggable", "true"); });
          mv.addEventListener("pointerup", () => t.removeAttribute("draggable"));
          t.addEventListener("dragstart", (e) => {
            if (!editing) { e.preventDefault(); return; }
            t.classList.add("dragging");
            if (e.dataTransfer) e.dataTransfer.effectAllowed = "move";
          });
          t.addEventListener("dragend", () => {
            t.classList.remove("dragging");
            t.removeAttribute("draggable");
            salva();
          });
          t.addEventListener("dragover", (e) => {
            if (!editing) return;
            e.preventDefault();
            const dragging = cards.querySelector(".dragging") as HTMLElement | null;
            if (!dragging || dragging === t) return;
            const r = t.getBoundingClientRect();
            const dopo = e.clientY - r.top > r.height / 2 || e.clientX - r.left > r.width / 2;
            if (dopo) t.after(dragging); else t.before(dragging);
          });

          // Ridimensionamento — maniglia in basso a destra (larghezza + altezza)
          rz.addEventListener("pointerdown", (e) => {
            if (!editing) return;
            e.preventDefault();
            e.stopPropagation();
            rz.setPointerCapture(e.pointerId);
            const startX = e.clientX, startY = e.clientY;
            const startW = Math.min(4, Math.max(1, Number(t.dataset.w || 1)));
            const startH = t.getBoundingClientRect().height;
            const c = colonne();
            const cellW = (cards.clientWidth - 20 * (c - 1)) / c;
            const onMove = (ev: PointerEvent) => {
              // Larghezza: già a scatti di colonna
              const w = Math.min(c, Math.max(1, startW + Math.round((ev.clientX - startX) / cellW)));
              t.dataset.w = String(w);
              t.style.gridColumn = "span " + w;
              let nh = Math.round(Math.min(900, Math.max(140, startH + (ev.clientY - startY))));
              // SNAP DI RIGA: se il fondo arriva vicino (±16px) al fondo di
              // un'altra tile, si aggancia per allinearsi con quella riga.
              const mioTop = t.getBoundingClientRect().top;
              let aggancio: number | null = null;
              cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((o) => {
                if (o === t) return;
                const cand = o.getBoundingClientRect().bottom - mioTop;
                if (cand < 140) return;
                if (Math.abs(cand - nh) < 16 && (aggancio === null || Math.abs(cand - nh) < Math.abs(aggancio - nh))) aggancio = cand;
              });
              if (aggancio !== null) nh = Math.round(aggancio);
              t.dataset.minh = String(nh);
              t.style.minHeight = nh + "px";
            };
            const onUp = (ev: PointerEvent) => {
              rz.releasePointerCapture(ev.pointerId);
              rz.removeEventListener("pointermove", onMove);
              rz.removeEventListener("pointerup", onUp);
              salva();
            };
            rz.addEventListener("pointermove", onMove);
            rz.addEventListener("pointerup", onUp);
          });
        });

        // In modalità edit i link delle isole non navigano
        cards.addEventListener("click", (e) => {
          if (!editing) return;
          if ((e.target as HTMLElement).closest("a.tile")) e.preventDefault();
        }, true);

        function setEditing(on: boolean) {
          editing = on;
          cards.classList.toggle("editing", on);
          btn?.classList.toggle("is-on", on);
          if (btn) btn.title = on ? "Terminé" : "Organiser mes tuiles";
          if (btnReset) btnReset.style.display = on ? "flex" : "none";
        }
        btn?.addEventListener("click", () => setEditing(!editing));
        btnReset?.addEventListener("click", () => { applicaLayout(DEFAULT_LAYOUT); salva(); });
      })();
    </script>
  </body>
