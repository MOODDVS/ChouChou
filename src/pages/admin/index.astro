---
// Pannello admin — dashboard. Riepilogo di OGGI, 4 tile in linea:
// Notes (lavagnetta staff, oro), Commandes, Horaires, Menu.
// Le Notes hanno un'anteprima nel tile + un modale per la board completa.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHead from "../../components/admin/AdminHead.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import Giornata from "../../components/admin/home/Giornata.astro";
import SpecialDaysForm from "../../components/admin/SpecialDaysForm.astro";
import Modal from "../../components/admin/Modal.astro";
import { CLIENT } from "../../config/client";
import { verificaTokenLocale } from "../../lib/admin/adminAuth";
import { caricaHomeData } from "../../lib/admin/caricaHomeData";
import { contestoDiStaff } from "../../lib/admin/permessi";
import { puoVederePagina } from "../../lib/admin/permessiRegole";
import { ambitoDiRichiesta } from "../../lib/admin/sede";
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";
import "../../styles/datepicker.css";

const lang = await adminLang();
const t = adminT(lang);

export const prerender = false;

// SSR (Fase 2): se il cookie di sessione è valido, pre-carichiamo le 5 isole
// principali sul server → appaiono già piene (le statistiche restano lato
// client). Se il cookie manca/è scaduto o c'è errore, ssrHome resta null e la
// pagina carica tutto lato client come prima (nessun rischio).
let ssrHome: unknown = null;
// ⚠️ LA COLONNA DELLE RECETTES SI DECIDE QUI, e parte SPENTA. E' l'unica
// colonna della fascia che legge un'API permessa a pochi (`/api/admin/stats`,
// della pagina Statistiques): disegnata a tutti e nascosta dopo, chiederebbe
// lo stesso, e chi non ha quella pagina si prenderebbe dei 403 a ogni
// caricamento — e' gia' successo, e per anni la risposta e' stata «la Accueil
// non chiede affatto le statistiche». Ora le chiede, ma solo chi puo'.
// Spenta anche quando non sappiamo chi guarda (cookie scaduto, SSR saltato):
// in quel caso la pagina si ricarica dopo il rinnovo del token, e un dato
// chiuso che appare per un attimo e' peggio di un dato che arriva un secondo
// dopo. La STESSA decisione del middleware, presa con lo stesso contesto.
let vedeRecettes = false;
try {
  const token = Astro.cookies.get("mdd_at")?.value ?? "";
  const staff = token ? await verificaTokenLocale(token) : null;
  // ⚠️ Il contesto dei permessi va passato, non dedotto qui: e' lo STESSO
  // che usa il middleware per decidere se un'API risponde. Due copie di
  // quella decisione e i dati nell'HTML direbbero una cosa e le API un'altra.
  if (staff) {
    const ctx = await contestoDiStaff(staff);
    ssrHome = await caricaHomeData(await ambitoDiRichiesta(Astro.request, staff), ctx);
    vedeRecettes = puoVederePagina("stats", ctx);
  }
} catch {
  ssrHome = null;
  vedeRecettes = false;
}
const ssrHomeJson = ssrHome ? JSON.stringify(ssrHome).replace(/</g, "\\u003c") : "";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{"Admin — " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#ffffff" />
    <style is:global>
      :root {
        --c-hover: #e86a61;
        --c-input: #0e3038;
        --c-bg: #0c2a30;
        --c-header: #04161b;
        --c-text: #e9efef;
        --c-accent: #cb534d;
        --c-muted: #86a0a4;
        --c-line: #244a52;
        --c-card: #16424b;
        --c-brown: var(--c-bg);
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; }
      #app { display: none; min-height: 100vh; flex-direction: column; }

      /* minmax(0,1fr): colonne SEMPRE uguali (il contenuto largo non può
         allargare la sua colonna). grid-auto-rows + align-items:start =
         masonry: ogni tile occupa N micro-righe in base alla SUA altezza,
         quindi una tile alta non allunga le vicine e le tile sotto risalgono. */
      /* SCALA DELLE COLONNE — UNICA FONTE: la variabile --cols.
         La griglia la usa per disegnarsi e lo script la RILEGGE da qui
         (getComputedStyle) per sapere quante colonne ci sono davvero: il
         drag & drop e il ridimensionamento calcolano tutto da quel numero.
         Cambiare le soglie qui basta e avanza, non c'e' nient'altro da
         aggiornare.
             >= 1280   4 colonne
             920-1279  3
             760-919   2
             < 760     1 (impilate, niente masonry ne' riordino) */
      .cards { --cols: 4; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 0 0.75rem; grid-auto-rows: 2px; align-items: start; }
      @media (max-width: 1279px) { .cards { --cols: 3; } }
      @media (max-width: 919px) { .cards { --cols: 2; } }
      /* STRETTO : une tuile par ligne, hauteur = contenu (pas de masonry),
         et pas de réorganisation (ni FAB, ni poignées). */
      @media (max-width: 759px) {
        .cards { --cols: 1; grid-auto-rows: auto; }
        .cards .tile { grid-column: 1 / -1 !important; grid-row: auto !important; min-height: 0 !important; height: auto !important; }
        .cards .tile-notes { min-height: 180px !important; }
        .org-fab:not(.org-fab-tiles), .cards .tile-move, .cards .tile-resize { display: none !important; }
        .org-fab-tiles { left: 1.5rem; bottom: 4.4rem; }
      }

      /* ============================================================
         LA GIORNATA — la fascia in cima, che NON e' una tile.
         ------------------------------------------------------------
         Niente fondo, niente bordo, niente ombra: e' il contenuto
         della pagina. Dentro, hanno un blocco solo le cose che si
         prendono una alla volta (una prenotazione, un ordine, un
         numero); quello che si guarda e basta resta nudo.
         ============================================================ */
      /* ⚠️ ALTEZZA FISSA, e le TRE file di numeri sulla stessa linea in fondo.
         Senza, la fascia respirava: sei ordini la allungavano, due la
         accorciavano, e il carosello di Google la spostava da solo ogni sette
         secondi. Una pagina che cambia misura mentre la si guarda sembra
         rotta, e i numeri — che si confrontano con un colpo d'occhio
         orizzontale — finivano a tre altezze diverse.
         Tutte le colonne sono stirate alla stessa altezza e ognuna spinge i
         suoi numeri in fondo: se sopra avanza spazio, resta vuoto. */
      .jour {
        /* ⚠️ Le tre misure della fascia stanno QUI e in nessun altro posto.
           Chi la vuole diversa non le riscrive: dichiara le variabili (la
           fascia stretta) o le TOGLIE con `initial` (il tablet), e `var()`
           torna al valore di questa riga. Cosi' cambiare la proporzione e'
           una riga sola, e nessuna media query puo' restare indietro con il
           numero vecchio — che e' il modo in cui due schermi finiscono per
           mostrare due disegni diversi senza che nessuno lo decida. */
        display: grid; grid-template-columns: var(--j-cols, repeat(3, minmax(0, 1fr)));
        gap: var(--j-gap, 3.6rem);
        /* ⚠️ L'ALTEZZA DELLE COLONNE E' LO SCHERMO, non il loro contenuto.
           Una colonna che cresce con le righe spinge giu' tutto e, soprattutto,
           porta fuori schermo le colonne accanto: la fascia serve a guardare
           la giornata TUTTA INSIEME, e appena una colonna si allunga non lo
           fa piu'. Fissata l'altezza, dentro ogni colonna scorre il suo corpo.
           La formula sta qui e in nessun altro posto: l'intestazione e
           l'imbottitura del `main` sono gia' due variabili loro, e riscriverle
           a mano in una media query vorrebbe dire che il giorno in cui
           l'intestazione cambia altezza una fascia su due resta indietro.
           `dvh` e non `vh`: su un telefono la barra del browser entra e esce,
           e `vh` e' l'altezza con la barra NASCOSTA — cioe' sempre un po'
           troppa.
           ⚠️ L'ARIA IN FONDO SI MISURA DAL BORDO DELLO SCHERMO, non
           dall'isola dei link. L'isola galleggia alta 77px (`--h-nav`), e
           toglierla dall'altezza — com'era fino all'08/10 — costava a OGNI
           colonna, su tutta la larghezza, lo spazio di una barra che copre
           solo il centro: su un tablet si perdevano cinque righe di lista per
           non far passare i numeri sotto una pillola larga mezza pagina.
           Scelta del ristoratore: la fascia ci passa SOTTO, ma si ferma a DUE
           TERZI DELL'ISOLA — cioe' le entra dietro solo per il terzo basso,
           e non si appoggia al filo del copyright, che sta piu' in basso
           ancora. `--j-col-sotto` e' quel punto detto in misure che esistono
           gia': lo stacco dell'isola dal bordo piu' due terzi della sua
           altezza. Quindi sul desktop la colonna finisce 58px sopra il bordo
           e sul tablet 42, e il giorno in cui l'isola cambia altezza o si
           alza da terra quel punto si sposta con lei, in tutte e due le
           scale. Un `3rem` scritto a mano — com'era fino all'08/10 — non
           sapeva nemmeno che sul tablet l'isola e' piu' bassa.
           Quel che le finisce dietro e' l'aria sotto i numeri, non i numeri.
           ⚠️ Chi invece deve stare FUORI dall'isola non si arrangia qui:
           `--h-nav` sta in AdminHead accanto a `--h-header` ed e' quello che
           il piede del `main` usa per lasciarla passare.
           ⚠️ IL MINIMO IN PIXEL, perche' su uno schermo basso (un portatile
           da 13" col browser a mezza altezza, un iPad in orizzontale) la
           sottrazione darebbe una colonna alta due righe: li' e' giusto che
           la fascia sfori e sia la PAGINA a scorrere, non che ogni colonna
           diventi una fessura. `max()`, non `min-height`: l'altezza deve
           restare UNA, perche' il corpo della colonna (`.j-lista`) ci calcola
           dentro il suo scorrimento.
           ⚠️ DUE VARIABILI E NON UNA: `--j-col-piena` e' la formula,
           `--j-col-h` e' quella che si usa. Cosi' la fascia stretta puo'
           spegnere l'altezza (`auto`) e il tablet puo' RIACCENDERLA senza
           ricopiare la formula — che e' esattamente il modo in cui il tablet
           era rimasto indietro: fra 1024 e 1100 le due media query valgono
           entrambe, quella stretta diceva `auto` e nessuno la contraddiceva,
           quindi su un iPad mini in orizzontale le colonne del bancone
           crescevano col contenuto e sbordavano dallo schermo. */
        /* L'imbottitura laterale delle righe dell'elenco: la usa anche chi le
           intitola, cosi' le due cose restano incolonnate (vedi `.j-lista-h`). */
        --j-li-x: 0.9rem;
        --j-col-sotto: calc(var(--h-nav-gap, 1.25rem) + var(--h-nav-h, 57px) * 2 / 3);
        --j-col-piena: max(var(--j-col-min, 420px), calc(100dvh - var(--h-header, 81px) - var(--pad-y, 2rem) - var(--j-col-sotto)));
        --j-col-h: var(--j-col-piena);
        /* ⚠️ `start`, e non il comportamento normale della griglia. Da quando
           le righe sono piu' d'una, la griglia si spartirebbe fra loro lo
           spazio che avanza fino al `min-height`: le sezioni della prima riga
           si allungherebbero di quel tanto per far posto a una riga che sta
           sotto e non le riguarda. Le righe restano alte quanto cio' che
           hanno dentro, e lo spazio che avanza resta in fondo. */
        align-content: start;
        /* ⚠️ NIENTE LINEA SOTTO. C'era, e diceva dove finiva la giornata e dove
           cominciavano le tile: senza, i numeri delle colonne e i riquadri
           delle tile si leggevano come un elenco solo che cambiava forma a
           meta'. Le tile non ci sono piu' — sono diventate colonne, una dopo
           l'altra — e quella linea era rimasta a separare la fascia da niente:
           un filo in fondo alla pagina che prometteva qualcosa sotto. Sotto
           adesso c'e' il marchio, che non ha bisogno di essere separato. */
        padding-bottom: 2.4rem;
      }
      /* ⚠️ UNA GRIGLIA SOLA, e le sezioni sono i suoi figli diretti. Prima
         c'erano due involucri — `.j-dx` e `.j-due` — che tenevano insieme
         prenotazioni e ordini dentro mezza fascia: una griglia dentro una
         griglia, con le sue proporzioni, le sue media query e il suo caso
         «una colonna sola» da gestire a mano in JavaScript. Da fuori sembrava
         una fila di tre colonne e non lo era, e ogni sezione nuova andava
         infilata nell'involucro giusto.
         Adesso le sezioni si dispongono da sole: tre per riga, e la prima
         casella libera se la prende la prossima. Spenti gli ordini, la
         lavagnetta sale al loro posto senza che nessuno glielo dica. */
      .j-col { min-width: 0; display: flex; flex-direction: column; height: var(--j-col-h); }
      /* TESTATA, CORPO, PIEDE: la stessa ossatura in tutte le colonne. Il
         corpo e' l'unico pezzo che scorre; testata e numeri restano dove
         sono, perche' sono le due cose che si guardano senza cercarle.
         ⚠️ `min-height: 0` non e' un ritocco: in una colonna flex un figlio
         non scende sotto la propria altezza naturale, quindi senza quella riga
         il corpo si allarga fino a contenere tutto, `overflow` non ha niente
         da nascondere e la barra di scorrimento non compare mai — la colonna
         si allunga e basta, come se la regola non ci fosse. */
      .j-lista { flex: 1; min-height: 0; overflow-y: var(--j-scroll, auto); scrollbar-width: thin; }
      /* ⚠️ IL CORPO DELLA COLONNA DI OGGI NON SCORRE. Scorreva, e voleva dire
         che per leggere il voto di Google si faceva scendere via il grafico:
         due blocchi che si guardano insieme — quanta gente oggi, come ci
         giudicano — e uno spariva per far posto all'altro. Qui dentro c'e'
         una cosa sola che puo' essere lunga a piacere, la recensione, ed e'
         LEI che scorre nel suo blocco (.j-quote). Tutto il resto ha
         un'altezza che si conosce.
         `display: flex` serve a questo: l'altezza che avanza nella colonna
         arriva fino alla citazione invece di fermarsi al primo blocco. */
      .j-corpo { flex: 1; min-height: 0; display: flex; flex-direction: column; }
      .j-hd, .j-nums, .j-per, .j-serv, .j-cmd { flex: none; }
      .j-col .j-nums { margin-top: auto; }
      /* I titoli delle tre colonne sono TITOLI: in bianco pieno. Grigi,
         pesavano meno dei numeri che stavano sotto e la colonna partiva da
         una riga sbiadita. */
      .j-t { font-family: var(--font-title); font-size: 0.78rem; letter-spacing: .14em; text-transform: uppercase;
        color: var(--c-text); display: flex; align-items: center; gap: 0.5rem; }
      .j-hd { display: flex; align-items: flex-start; gap: 0.6rem; margin-bottom: 1.1rem; }
      /* ⚠️ La STESSA misura del logo Google: le tre colonne cominciano con un
         segno della stessa taglia, sulla stessa riga. Due pixel di differenza
         fra i tre segni bastano a far sembrare storti tre titoli allineati. */
      .j-ico { width: 18px; height: 18px; flex: none; fill: none; stroke: var(--c-accent);
        stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; display: block; }
      /* Titolo e conteggio in colonna; il link va a fondo riga da solo. */
      .j-hd-x { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
      .j-hd .j-link { margin-left: auto; align-self: flex-start; }
      .j-vedi { font-size: 0.75rem; color: var(--c-muted); text-decoration: none; }
      .j-link { display: inline-flex; align-items: center; gap: 0.5rem; }
      .j-arr { width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--c-line);
        display: inline-flex; align-items: center; justify-content: center; flex: none;
        transition: border-color .15s, color .15s, transform .15s; }
      .j-arr svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2;
        stroke-linecap: round; stroke-linejoin: round; display: block; }
      /* Si accende tutto insieme — testo, cerchio e freccia — perche' e' un
         bersaglio solo: illuminare mezzo link insegna a mirare male. */
      .j-link:hover { color: #fff; }
      .j-link:hover .j-arr { border-color: #fff; transform: translateX(2px); }
      /* ⚠️ Il marchio VERO, da `public/restohub/`: la «G» disegnata a mano in
         un quadratino bianco era un segnaposto, e un logo ridisegnato non e'
         quel logo. Niente fondo: il file ha gia' il suo, e i colori reggono
         sul tema scuro. */
      .j-glogo { width: 18px; height: 18px; display: block; flex: none; }

      /* --- Google --- */
      /* ⚠️ `baseline` incolonna il numero con le stelle, ma un'immagine non ha
         una base su cui appoggiarsi: il logo scivolava sul fondo della riga.
         Si centra da solo, e la riga resta allineata sul testo. */
      /* La taglia del voto, scritta UNA volta: il logo ci si misura sopra.
         ⚠️ Logo e numero sono una cosa sola — «su Google, 4,4» — e due misure
         scritte a mano vorrebbe dire che il giorno in cui il numero cresce il
         logo resta indietro, senza che nessuno se ne accorga. */
      /* `wrap`: nella colonna stretta del telefono la riga porta logo, voto,
         stelle e il link alla scheda. Senza, l'ultimo usciva dal blocco
         invece di andare a capo. */
      .j-note { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; --j-voto: 2.5rem; }
      /* 0.72 e non 1: il numero e' alto 2.5rem di CORPO, ma le cifre ne
         occupano meno, e il logo sta un filo SOTTO la loro altezza. Il voto
         e' il dato, il logo dice solo da dove viene: alla pari si guardavano
         in cagnesco, e l'occhio non sapeva piu' quale dei due leggere. */
      .j-note .j-glogo { align-self: center;
        width: calc(var(--j-voto) * 0.72); height: calc(var(--j-voto) * 0.72); }
      .j-note .v { font-family: var(--font-title); font-size: var(--j-voto); line-height: 1; }
      .j-note .st { color: #f5b544; font-size: 1rem; letter-spacing: 2px; }
      /* Il link va a fondo riga, come nella testata. ⚠️ `align-self` perche'
         la riga e' allineata sulle BASI del testo, e un bottone con la sua
         freccia non ha una base su cui appoggiarsi: scivolerebbe in fondo
         come faceva il logo. */
      .j-note .j-link { margin-left: auto; align-self: center; }
      .j-note-sub { font-size: 0.8rem; color: var(--c-muted); margin-top: 0.35rem; }
      /* Il mese in BIANCO dentro la riga grigia: non e' un giudizio — non c'e'
         un «meglio» o un «peggio» in due recensioni in piu' — e' solo la parte
         della riga che si va a leggere. Il verde diceva «cresce», e «+0» in
         verde diceva che crescere di zero e' una buona notizia. */
      .j-note-sub .m { color: var(--c-text); font-weight: 700; }

      /* ---- PROVA (07/10/2026): il voto dentro un blocco bianco ----
         ⚠️ Va contro la regola della fascia — qui niente ha un riquadro,
         perche' un riquadro dice «questa e' un'altra cosa» e la giornata e'
         una cosa sola. Il voto pero' NON e' nostro: e' il giudizio che sta
         su Google, e un fondo bianco lo stacca da tutto il resto come una
         citazione. Si prova, e si tiene solo se da lontano aiuta.
         Per tornare indietro: si cancella questo blocco, nient'altro. */
      /* La recensione e' una CITAZIONE, non una scatola dentro la pagina. */
      .j-quote { border-left: 2px solid var(--c-line); padding: 0.1rem 0 0.1rem 1rem; margin-top: 0.9rem; }
      /* ⚠️ LA CITAZIONE PRENDE LO SPAZIO CHE AVANZA, E SCORRE DENTRO.
         Il carosello cambia avis da solo ogni sette secondi: con l'altezza
         libera, una recensione lunga e una corta spostavano in su e in giu'
         tutto quello che sta sotto, compresi i tre numeri della scheda. Una
         pagina che si muove da sola mentre la si guarda sembra rotta.
         Qui c'erano sei righe fisse, che risolvevano il salto tagliando coi
         puntini quelle piu' lunghe: il testo pieno restava solo sulla scheda
         Google. Adesso l'altezza e' quella che la colonna le lascia — sempre
         la stessa, quindi niente salto — e la recensione lunga si legge fino
         in fondo scorrendo DENTRO il suo blocco. Nessuno deve piu' uscire dal
         pannello per leggere cosa gli hanno scritto. */
      .j-quote { flex: 1; min-height: 0; display: flex; }
      .j-quote .q-x {
        font-size: 0.9rem; line-height: 1.65;
        flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: thin;
      }
      /* --- chi ha scritto: sopra la citazione, e fuori dalla sua riga --- */
      .j-aut { display: flex; align-items: center; gap: 0.75rem; margin-top: 1.3rem; min-width: 0; }
      .j-aut-x { min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
      .j-aut .nm { color: var(--c-text); font-weight: 700; font-size: 0.95rem;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .j-aut-r { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; color: var(--c-muted); }
      .j-aut .sr { color: #f5b544; letter-spacing: 1px; font-size: 0.85rem; white-space: nowrap; flex: none; }
      .j-aut .dt { white-space: nowrap; flex: none; }
      /* ⚠️ L'avatar NON e' `sede-avatar`: quello e' il riquadro di un LOCALE,
         con le sue iniziali su fondo neutro. Qui c'e' una persona, e quando
         Google non da' la foto il cerchio porta un colore ricavato dal nome —
         stabile, cosi' la stessa persona ha sempre lo stesso. Un cerchio
         grigio vuoto non distingue nessuno da nessuno. */
      .j-av { width: 40px; height: 40px; border-radius: 50%; flex: none; overflow: hidden;
        display: inline-flex; align-items: center; justify-content: center;
        font-family: var(--font-title); font-size: 0.9rem; color: #fff; background: var(--c-input); }
      .j-av img { width: 100%; height: 100%; object-fit: cover; display: block; }
      /* Lo stato della risposta: si vede solo quando lo sappiamo davvero,
         cioe' quando le recensioni arrivano dal Business Profile. Scriverlo
         sempre direbbe «senza risposta» anche a chi ha gia' risposto. */
      /* La pastiglia «Risposto / Senza risposta» ha la FORMA delle altre
         della fascia (`.spx-b`): qui restano i colori, che sono suoi. Era la
         quarta pastiglia della pagina con la sua misura e il suo raggio. */
      .j-rep.si { color: var(--c-ok); border: 1px solid color-mix(in srgb, var(--c-ok) 55%, transparent); }
      .j-rep.no { color: var(--c-hover); border: 1px solid color-mix(in srgb, var(--c-accent) 55%, transparent); }
      .j-qf { display: flex; align-items: center; gap: 0.75rem; margin-top: 1rem; }
      /* «Répondre» in fondo alla riga di chi ha scritto: il bottone pieno del
         pannello (`.btn.btn-sm.btn-primary`).
         ⚠️ PIENO, e non un contorno: il contorno e' il vestito delle pastiglie
         di STATO qui accanto («sans réponse», «répondu»), che si leggono e
         basta. Un'azione vestita da stato invita a leggerla, non a premerla.
         Qui resta solo il posto: e' l'ultimo di una riga con dentro un nome
         lungo quanto vuole, e senza `flex: none` si lascerebbe schiacciare. */
      .j-rbtn { margin-left: auto; flex: none; }
      /* --- il modale della risposta --- */
      /* Dentro al modale l'intestazione non ha bisogno dello stacco che ha
         nella colonna: e' la prima cosa della finestra. */
      #j-rep-overlay .j-aut { margin-top: 0; }
      .j-rep-quote { margin: 1.1rem 0 1rem; }
      /* ⚠️ Nel modale la citazione non scorre: cresce. Nella colonna scorre
         perche' l'altezza e' quella della colonna; qui la finestra si allunga
         con cio' che contiene, e far scorrere il commento a cui si sta
         rispondendo — dentro una finestra che avrebbe posto — sarebbe il modo
         di rispondere a meta' di quello che hanno scritto. */
      .j-rep-quote { display: block; }
      .j-rep-quote .q-x { height: auto; display: block; overflow: visible; flex: none; }
      .j-rep-lab { display: block; margin-bottom: 0.3rem; }
      .j-rep-txt { width: 100%; min-height: 7rem; resize: vertical; line-height: 1.55; }
      .j-rep-hint { margin-top: 0.45rem; }
      .j-reply-msg { margin-right: auto; font-size: 0.78rem; color: var(--c-muted); }
      .j-arrows { display: flex; gap: 0.35rem; }
      /* Le frecce sono `.ibtn.ibtn-sm`: il tondo del pannello in taglia
         piccola. ⚠️ Erano riscritte da zero — misura, raggio, bordo, fondo — e
         il fondo era `--c-bg` «per staccarsi dalla card»: la stessa ragione
         per cui `.ibtn` usa `--c-card` sul fondo della pagina. Due regole
         opposte nate dallo stesso ragionamento, in due punti diversi. */
      .j-dots { display: flex; gap: 0.35rem; }
      /* Stessa ragione delle frecce: il pallino spento e' un buco scuro nella
         card, non un pallino del colore del filo che ci si confondeva. */
      .j-dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--c-bg); display: block; }
      .j-dots i.on { background: var(--c-accent); }
      /* LA DIDASCALIA DEL PIEDE: una frase piccola che spiega i numeri sotto
         («ultimi 30 giorni», «la piu' vecchia da 2 giorni»). Sta SULLA linea,
         non sopra una linea sua: il filo e' il suo `::after` qui sotto. */
      .j-per { font-size: 0.7rem; color: var(--c-muted); margin-top: 0.6rem;
        display: flex; align-items: center; gap: 0.75rem; }
      /* ⚠️ Vuota non esiste. Nella lavagnetta questa riga dice «la piu' vecchia
         da N giorni» e TACE quando non c'e' niente in ritardo — ma taceva
         occupando il suo posto: una riga di niente piu' il suo margine, cioe'
         un buco fra l'ultima nota e la linea dei numeri che compariva proprio
         nei giorni in cui va tutto bene. */
      .j-per:empty { display: none; }

      /* --- i blocchi dei numeri: tre piani, e MAI un a capo ---
         Un blocco che si apre in due righe cresce in altezza e i tre accanto
         restano corti: la fila si sfalsa e i numeri non si leggono piu' in
         orizzontale. Etichetta e descrizione si tagliano coi puntini; il
         NUMERO non si taglia mai (un prezzo tagliato e' un prezzo sbagliato)
         e rimpicciolisce da solo sulla larghezza del suo blocco. */
      .j-nums { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-top: 1.5rem; }
      /* ⚠️ I numeri per ULTIMI, anche se nel markup la nota «30 derniers
         jours» viene dopo: in fondo alla colonna deve arrivarci la FILA DEI
         NUMERI, se no sarebbe la nota a toccare il fondo e quella fila
         resterebbe una riga piu' in alto delle altre due.
         La nota scende insieme a loro (e' lei a portare lo spazio vuoto) e
         resta attaccata ai numeri che spiega. */
      .j-google .j-nums { order: 9; }
      /* LA NOTA STA SULLA LINEA, non sopra: «30 derniers jours» e il filo
         dicono la stessa cosa — da qui in giu' si cambia argomento, e si
         guardano trenta giorni invece di oggi. Due righe sovrapposte per un
         confine solo erano un confine disegnato due volte.
         ⚠️ Il filo e' un `::after` che prende lo spazio che resta, non una
         larghezza scritta a mano: la nota e' lunga diversa in cinque lingue,
         e «Laatste 30 dagen» avrebbe scavalcato un filo tagliato su misura
         per il francese. */
      /* ⚠️ TUTTE LE COLONNE, UNA REGOLA. La didascalia del piede sta SULLA
         linea, non sopra una linea sua: era scritta per Google, poi copiata
         per i giorni speciali, e la lavagnetta — che ha la stessa frase, «la
         piu' vecchia da N giorni» — era rimasta fuori dall'elenco dei nomi.
         Non era rotta: era semplicemente un'altra cosa, nella stessa fascia,
         a un centimetro di distanza. Un elenco di nomi va allungato a mano
         ogni volta, e chi se ne scorda non lo sa; una regola su `.j-per` vale
         per chi ce l'ha, e basta. */
      .j-google .j-per { margin-top: 0; padding-top: 0; }
      /* ⚠️ `auto` e non un margine scritto: la nota e i numeri sono una cosa
         sola e scendono insieme in fondo alla colonna, come la fila delle
         altre due. E' la nota a portare lo spazio vuoto, perche' e' lei che
         viene prima: dandolo ai numeri, il filo sarebbe rimasto appeso a
         mezza colonna con l'elenco. */
      .j-spx .j-per { margin-top: auto; }
      /* ⚠️ Il vuoto che restava NON era della nota: era il margine sotto la
         scatola, lo stesso che stacca la giornata da Google. Sotto Google pero'
         non c'e' un'altra scatola, c'e' la sua didascalia — e una didascalia
         sta attaccata a cio' che spiega. Limarlo dalla nota non bastava:
         la nota partiva gia' da zero. */
      .j-g-blocco { margin-bottom: 0.55rem; }
      .j-per::after { content: ""; flex: 1; height: 1px; background: rgba(36, 74, 82, .65); }
      /* ⚠️ LA LINEA LA DISEGNA UNO SOLO. Se la didascalia c'e', la porta lei e
         i numeri non ne fanno una seconda a un centimetro; se TACE — nella
         lavagnetta la frase sparisce quando non c'e' niente in ritardo —
         torna sui numeri, che se no restano senza niente sopra.
         Due righe di CSS invece di un nome di colonna: cosi' vale anche per
         la prossima colonna che avra' un piede. */
      .j-per + .j-nums { border-top: none; padding-top: 0; margin-top: 0.55rem; }
      .j-per:empty + .j-nums { border-top: 1px solid rgba(36, 74, 82, .65); padding-top: 1.2rem; margin-top: 1.5rem; }
      /* ⚠️ E la linea sparisce da SOTTO: era il `border-top` dei numeri, ed e'
         salita nella nota. Lasciandola, sarebbero stati due fili a un
         centimetro l'uno dall'altro.
         ⚠️ `margin-top: auto` tolto: spingeva i numeri in fondo alla colonna
         per incolonnarli con le altre due file, e cosi' facendo apriva un
         vuoto di mezzo schermo fra il blocco Google e la sua nota. Qui sotto
         i numeri sono di GOOGLE, non il conteggio di una colonna: stanno
         attaccati al blocco che li spiega. Le due file a destra restano
         incolonnate fra loro — e' quella la coppia che si confronta. */
      /* ⚠️ Google resta nominata, e non per dimenticanza: la sua didascalia sta
         DOPO i numeri nel markup (`order: 9` la rimette sotto), quindi la
         regola dei fratelli qui sopra non la raggiunge — `+` guarda il DOM,
         non quello che si vede. */
      .j-google .j-nums { border-top: none; padding-top: 0; margin-top: 0.55rem; }
      .j-nums > div { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px;
        padding: 0.7rem 0.85rem 0.8rem; box-shadow: 0 2px 8px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15)));
        container-type: inline-size; }
      .j-nums .k, .j-nums .d { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
      .j-nums .k { font-size: 0.66rem; text-transform: uppercase; letter-spacing: .06em; color: var(--c-muted); }
      .j-nums .v { display: block; white-space: nowrap; font-family: var(--font-title); font-size: min(1.45rem, 17cqw); margin-top: 0.3rem; }
      .j-nums .v.att { color: var(--c-hover); }
      .j-nums .d { font-size: 0.68rem; color: var(--c-muted); margin-top: 0.2rem; }
      /* ⚠️ LA TERZA RIGA TIENE IL POSTO ANCHE DA VUOTA. I riquadri hanno tre
         piani — etichetta, numero, didascalia — ma la didascalia non ce
         l'hanno sempre: dove nessuno dei tre ce l'ha (i giorni speciali), la
         fila veniva su piu' bassa di quelle delle altre colonne, e in fondo
         alla fascia tre file che si leggono in orizzontale erano sfalsate.
         Dentro UNA colonna non si vedeva: la griglia allunga i riquadri al
         piu' alto, quindi bastava che uno avesse la didascalia perche' gli
         altri due lo seguissero. Si vedeva solo confrontando le colonne, cioe'
         guardando la fascia intera — che e' esattamente come la si guarda. */
      .j-nums .d:empty::before { content: "\00a0"; }
      .j-nums .d.up { color: var(--c-ok); font-weight: 700; }
      .j-nums .d.giu { color: var(--c-hover); font-weight: 700; }
      /* ⚠️ Il riquadro «chi le fa» occupa DUE caselle: dentro non c'e' una
         cifra ma tre nomi, e un nome e cognome in un terzo di colonna va a
         capo o si taglia coi puntini — cioe' una classifica in cui non si
         legge chi e'. */
      .j-note-top { grid-column: span 2; }
      .j-top3 { list-style: none; margin: 0.45rem 0 0; padding: 0;
        display: flex; flex-direction: column; gap: 0.25rem; }
      .j-top3 li { display: flex; align-items: baseline; gap: 0.5rem; font-size: 0.78rem; }
      .j-top3 .n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .j-top3 .q { font-family: var(--font-title); font-size: 0.95rem; flex: none; }
      .j-top3 .vuoto { color: var(--c-muted); font-size: 0.72rem; display: block; }

      /* --- orari + affluenza --- */
      .j-pil { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .07em;
        padding: 0.28rem 0.68rem; border-radius: 999px; background: var(--c-ok); color: #fff; white-space: nowrap; }
      .j-pil.off { background: var(--c-accent); }
      /* ⚠️ ROSSO, e non `--c-accent`: «chiuso oggi» e' un fatto che ferma
         tutto, e l'accento e' il colore delle AZIONI del pannello — cambia da
         cliente a cliente, e su un tema verde la pastiglia di chiusura sarebbe
         stata verde. E' lo stesso rosso delle pastiglie di chiusura dei giorni
         speciali. */
      .j-pil.ko { background: #ed1c24; color: #fff; }
      /* La pastiglia NEUTRA: dice un numero, non uno stato. Il fondo e' la
         stessa formula dei piani rialzati del pannello (`color-mix` sul testo
         contro il fondo), non un grigio scritto a mano che su un tema chiaro
         sparirebbe. */
      .j-pil.n { background: color-mix(in srgb, var(--c-text) 14%, var(--c-bg)); color: var(--c-text); }
      /* ⚠️ Vuota non esiste. I conteggi arrivano con la giornata, e fino ad
         allora la pastiglia sarebbe stata una pillola grigia senza niente
         dentro accanto al titolo — una cosa rotta, non una cosa che aspetta.
         In CSS e non in JS: cosi' vale anche il giorno in cui qualcuno
         aggiunge la quarta colonna e si dimentica di nasconderla. */
      .j-pil:empty { display: none; }
      /* LE SCATOLE DELLA FASCIA: la giornata (orari + affluenza), Google
         (voto + recensione) e i servizi di oggi nella colonna Réservations.
         ⚠️ UNA regola per tutte, e lo STESSO vestito dei riquadri dei
         numeri (`.j-nums > div`): stesso fondo, stesso filo, stesso raggio,
         stessa ombra. Scritte in due regole, un giorno una delle due prende
         un raggio diverso e la fascia ha due scatole che non si somigliano.
         L'unica differenza dai riquadri dei numeri e' l'imbottitura, un filo
         piu' larga: qui dentro c'e' un grafico o una recensione, non una
         cifra. */
      /* ⚠️ Il blocco Google prende l'altezza che avanza e la passa dentro,
         fino alla citazione: e' l'unico pezzo elastico della colonna. Senza
         `min-height: 0` non si lascerebbe stringere sotto il suo contenuto e
         la citazione non avrebbe mai un limite da cui scorrere. */
      .j-g-blocco { flex: 1; min-height: 0; display: flex; flex-direction: column; }
      /* ⚠️ LA SCATOLA DELLA FASCIA, un nome solo. Era un elenco di nomi
         (`.j-oggi-blocco, .j-g-blocco, .j-serv`) che bisognava allungare ogni
         volta che una colonna ne voleva una — e chi se ne scordava disegnava
         la quarta scatola a mano, leggermente diversa. Adesso la scatola e'
         `.j-box` e i nomi specifici restano solo per cio' che CAMBIA (il
         blocco Google e' elastico, i servizi spariscono da vuoti). */
      .j-box {
        background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15)));
        padding: 0.95rem 1.15rem 0.9rem;
        margin-bottom: 1.15rem;
      }
      /* L'orario in testa al blocco.
         ⚠️ Piu' grande del titolo che lo apre: «AUJOURD'HUI» e' un'etichetta,
         «OPEN» un colore, e l'orario e' l'unica cosa che si va a leggere. */
      .j-orari { font-size: 1.2rem; font-weight: 700;
        display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
      .j-orari .f { white-space: nowrap; }
      /* «Riapertura domani 17:00»: si legge DOPO «Fermé», quindi non ne ha la
         taglia. ⚠️ Non va a capo da sola in mezzo a una data: o sta sulla riga
         degli orari o passa sotto intera. */
      .j-riapre { font-size: 0.8rem; font-weight: 400; color: var(--c-muted); white-space: nowrap; }
      /* Un orologio solo per tutti i servizi: due disegni uguali in fila su
         una riga di sette parole sono un disegno di troppo. */
      /* ⚠️ Cresce con l'orario che accompagna: un orologio di 16 px accanto a
         un numero di 1.2rem diventa una briciola davanti alla riga, e la riga
         sembra cominciare storta. */
      .j-orari .clock { width: 20px; height: 20px; stroke: var(--c-accent); fill: none; stroke-width: 1.8;
        flex: none; }
      /* ⚠️ Lo stesso `gap` del grafico e dell'asse delle ore: sono due righe
         separate che devono restare incolonnate, e due numeri diversi si
         notano solo all'ultima ora della giornata. */
      /* ⚠️ Lo stacco dagli orari sta SUL GRAFICO, non sotto gli orari: spenti
         ordini e prenotazioni il grafico e' `display:none`, non occupa niente
         e si porta via il suo margine. Messo sugli orari avrebbe lasciato un
         vuoto in fondo al blocco proprio nei giorni senza grafico. */
      .j-hm { margin-top: 1rem; }
      .j-hm-plot { display: flex; align-items: flex-end; gap: 4px; height: 74px; position: relative; }
      /* LE LINEE DEL GRAFICO: pavimento, meta', soffitto.
         ⚠️ Stanno SOPRA le barre, non dietro: una linea dietro si interrompe
         dove passa una barra, e proprio sulla barra alta — quella che si vuole
         misurare — sparisce. Sopra, attraversa, e l'occhio legge dove la barra
         taglia la linea. Sono abbastanza sbiadite da non diventare un
         disegno loro.
         `inset: 0` e non una terza misura: le linee occupano esattamente il
         riquadro delle barre, qualunque altezza abbia. */
      .j-grid { position: absolute; inset: 0; pointer-events: none; }
      .j-grid i { position: absolute; left: 0; right: 0; bottom: 0;
        border-top: 1px solid color-mix(in srgb, var(--c-text) 13%, transparent); }
      /* Il pavimento e' piu' marcato: e' lo zero, e lo zero non e' una
         tacca fra le altre. */
      .j-grid i.base { border-top-color: color-mix(in srgb, var(--c-text) 28%, transparent); }
      /* Il numero sta SOTTO la sua linea, a destra, dove le ore di chiusura
         lasciano il grafico vuoto. ⚠️ Sotto e non sopra: sopra, il numero
         della linea piu' alta uscirebbe dal grafico e andrebbe a finire
         sull'orario. Il fondo della card dietro: senza, finirebbe sopra una
         barra e si leggerebbe come parte di essa. */
      .j-grid i b { position: absolute; right: 0; top: 2px; font-weight: 400;
        font-size: 0.6rem; line-height: 1; color: var(--c-muted);
        background: var(--c-card); padding: 0 0.1rem 0 0.35rem; }
      /* QUATTRO BARRE PER ORA: coperti e ordini, ognuno col suo «di solito».
         Il COLORE dice che cosa si conta (coperti o ordini), la TINTA dice
         quando (piena = oggi, chiara = di solito). Due variabili, due segni:
         chi guarda impara una cosa sola e la applica a tutte e quattro.
         ⚠️ Una barra resta al suo posto anche a zero: se sparisse, le altre
         scivolerebbero e le ore non sarebbero piu' incolonnate — un grafico
         che si muove da solo mentre i numeri cambiano. */
      .j-hb { flex: 1 1 0; height: 100%; position: relative;
        display: flex; align-items: flex-end; justify-content: center; gap: 2px; }
      .j-hb span { min-width: 3px; border-radius: 2px 2px 0 0; }
      /* ⚠️ Un colore PIENO, non lo stesso reso trasparente: `color-mix` col
         FONDO e non con `transparent`, cosi' resta opaco e segue comunque il
         tema del cliente invece di essere un esadecimale scritto a mano.
         ⚠️ Il fondo e' `--c-card`, la scatola su cui le barre stanno davvero,
         e NON `--c-bg`: qui c'era una ridefinizione di `--c-bg` dentro il
         blocco, cioe' un token del tema che cambiava significato in un punto
         della pagina. Chiunque avesse scritto `var(--c-bg)` li' dentro — un
         bottone, un bordo — avrebbe preso il colore della card credendo di
         prendere quello della pagina. */
      .j-hb .cov { background: color-mix(in srgb, var(--c-barra, #4e8f9c) 40%, var(--c-card)); }
      .j-hb .cov.oggi { background: var(--c-barra, #4e8f9c); }
      /* Gli ordini nel CORALLO del cliente (`--c-accent`): una tinta sola per
         tutte e due le serie non si distingue, e il corallo e' l'unico altro
         colore che il pannello ha gia' — un terzo colore inventato qui
         sarebbe un colore in piu' da spiegare, e cambierebbe da cliente a
         cliente senza che nessuno l'abbia scelto. */
      .j-hb .ord { background: color-mix(in srgb, var(--c-accent) 40%, var(--c-card)); }
      .j-hb .ord.oggi { background: var(--c-accent); }
      /* LE DUE SERIE DELLE RECETTES: lo stesso significato dei colori di sopra
         — `--c-barra` e' la serie normale, il corallo e' l'ATTENZIONE, qui i
         soldi tornati indietro. Piene tutte e due: fra incassi e resi non c'e'
         nessun «di solito» da distinguere con la tinta. */
      .j-hb .inc { background: var(--c-barra, #4e8f9c); }
      .j-hb .rb { background: var(--c-accent); }
      /* La larghezza dipende da quante serie sono accese: con i soli coperti
         restano due barre, e devono riempire la colonna come le quattro. */
      .j-hm.serie2 .j-hb span { width: 46%; max-width: 20px; }
      .j-hm.serie4 .j-hb span { width: 23%; max-width: 11px; }
      /* ⚠️ DUE COLORI E BASTA. Qui c'erano anche il tratteggio delle ore di
         chiusura e il riquadro dell'ora in corso: quattro linguaggi in una
         striscia alta settanta pixel, e per leggerla bisognava prima
         imparare tre segni. Gli orari sono scritti in lettere due righe
         sopra — il grafico non deve ripeterli, deve dire quanta gente c'e'.
         Un'ora senza barre e' un'ora senza nessuno, e si capisce da sola. */
      /* ---------- La colonna «Visibilité» ----------
         ⚠️ Il grafico e' QUELLO dell'affluenza (`.j-hm`, `.j-hm-plot`,
         `.j-hm-x`, `.j-grid`): qui si aggiunge solo la larghezza di una serie
         sola e il colore, che e' quello delle barre del pannello. */
      .j-hm.serie1 .j-hb span { width: 100%; max-width: 12px; }
      .j-hb .vis { background: color-mix(in srgb, var(--c-barra, #4e8f9c) 55%, var(--c-card)); }
      /* L'ultima barra e' il periodo che sta finendo: piena, come «oggi»
         nell'affluenza. */
      .j-hb .vis.oggi { background: var(--c-barra, #4e8f9c); }
      /* Dentro la scatola il grafico non ha piu' bisogno del suo stacco: e'
         l'imbottitura della scatola a fare l'aria, sopra e sotto. */
      .j-vis-hm { margin-top: 0; }
      /* ---- RECETTES ----
         Il totale in testa alla scatola: e' IL numero della colonna, e si
         legge da lontano come l'orario di «Aujourd'hui» (stessa taglia,
         stessa famiglia). La variazione e il periodo gli stanno accanto
         piccoli: spiegano il numero, non si confrontano con lui. */
      .j-tot { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
      .j-tot .big { font-family: var(--font-title); font-size: 1.75rem; line-height: 1; }
      .j-tot .d { font-size: 0.78rem; font-weight: 700; }
      .j-tot .d.up { color: var(--c-ok-chiaro, #4fbe8c); }
      .j-tot .d.giu { color: var(--c-accent); }
      .j-tot .q { font-size: 0.74rem; color: var(--c-muted); margin-left: auto; }
      /* I soldi resi, sotto il totale. ⚠️ `:empty` non esiste: senza rimborsi
         questa riga tace, e tacendo non deve lasciare il suo spazio fra il
         totale e il grafico. */
      .j-rb { font-size: 0.78rem; color: var(--c-muted); margin-top: 0.45rem;
        display: flex; align-items: baseline; gap: 0.4rem; }
      .j-rb:empty { display: none; }
      .j-rb b { font-family: var(--font-title); font-weight: 400; font-size: 1rem; color: var(--c-accent); }
      .j-rec-hm { margin-top: 0.9rem; }
      .j-rec-box { flex: none; }
      /* La riga di un articolo: posto, nome, quantita', incasso — la stessa
         riga delle parole cercate di Visibilité, con un numero in piu'.
         ⚠️ `.j-li.j-art` e non `.j-art`: la riga condivisa `.j-li` sta PIU' IN
         BASSO in questo foglio, e con la stessa specificita' vince l'ultima —
         le righe sarebbero rimaste allineate in alto e con la spaziatura
         dell'altra. Due classi: la variante batte la base, ovunque stia. */
      .j-li.j-art { align-items: baseline; gap: 0.7rem; }
      .j-li.j-art .pos { flex: none; font-family: var(--font-title); font-size: 0.9rem; color: var(--c-muted); width: 1.1rem; }
      .j-li.j-art .q { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .j-li.j-art .qty { flex: none; color: var(--c-muted); font-size: 0.76rem; font-variant-numeric: tabular-nums; }
      .j-li.j-art .eur { flex: none; font-family: var(--font-title); font-size: 1rem;
        font-variant-numeric: tabular-nums; min-width: 3.4rem; text-align: right; }
      .j-vis-box { flex: none; }
      /* Il quadratino della legenda ha il colore delle barre dei clic — la
         stessa tinta, non una simile: viene dalla stessa variabile. */
      .j-key b.vis { background: var(--c-barra, #4e8f9c); }
      /* L'intestazione dell'elenco: due parole, una volta sola. */
      /* L'INTESTAZIONE DI UN ELENCO: due parole, una volta sola, sopra le
         righe che intitolano. ⚠️ Si chiamava `.j-vis-h` — il nome di una
         colonna — e la seconda colonna che ne ha avuto bisogno (le recettes)
         avrebbe dovuto o portarsi addosso il nome dell'altra o rifarsela
         uguale. Il nome dice cos'e', non chi la usa.
         ⚠️ LA STESSA IMBOTTITURA DELLE RIGHE, e per questo e' una variabile.
         «Clics» stava 0.2rem dal bordo e i numeri che intitola 0.9rem: scritto
         cosi' sembrava spostato a destra di mezza parola, e nessuno dei due
         numeri era sbagliato — erano due numeri per la stessa misura. */
      .j-lista-h { display: flex; justify-content: space-between; color: var(--c-muted);
        font-size: 0.66rem; text-transform: uppercase; letter-spacing: .06em;
        padding: 0 var(--j-li-x, 0.9rem) 0.3rem; }
      .j-vq { display: flex; align-items: baseline; gap: 0.7rem; }
      /* La parola cercata prende tutto lo spazio che resta e si taglia coi
         puntini: sono frasi intere («restaurant ouvert dimanche bruxelles»). */
      .j-vq .q { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      /* ⚠️ Le IMPRESSIONI in grigio accanto ai clic: comparire di piu' e
         farsi cliccare uguale non e' crescere. Senza questo numero, «3 clic»
         su una parola non dice se e' una parola che nessuno cerca o una in cui
         si compare e non si viene scelti — due problemi diversi. */
      .j-vq .imp { flex: none; color: var(--c-muted); font-size: 0.76rem; font-variant-numeric: tabular-nums; }
      .j-vq .n { flex: none; font-family: var(--font-title); font-size: 1rem;
        font-variant-numeric: tabular-nums; min-width: 1.8rem; text-align: right; }

      .j-hm-x { display: flex; gap: 4px; margin-top: 0.7rem; }
      .j-hm-x span { flex: 1 1 0; text-align: center; font-size: 0.66rem; color: var(--c-muted); }
      .j-hm-f { display: flex; align-items: center; gap: 0.85rem; margin-top: 0.8rem; font-size: 0.7rem; color: var(--c-muted); flex-wrap: wrap; }
      .j-key { display: inline-flex; align-items: center; gap: 0.35rem; }
      .j-key b { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
      /* Ogni segno della legenda ha la FORMA di cio' che spiega: il quadrato
         e' la barra, il trattino e' il trattino, il contorno e' il cerchio
         dell'ora in corso. Un pallino uguale per tutti non spiega niente. */
      .j-key b.cov, .j-key b.inc { background: var(--c-barra, #4e8f9c); }
      .j-key b.ord, .j-key b.rb { background: var(--c-accent); }
      .j-pale { font-style: italic; }
      .j-hm-f .src { margin-left: auto; }

      /* I servizi di oggi e i bottoni della préparation: due righe di comando
         sotto il titolo della loro colonna, prima dell'elenco. ⚠️ Lo stesso
         spazio sotto tutte e due, altrimenti i due elenchi partono a due
         altezze diverse e le colonne sembrano disallineate. */
      .j-cmd { margin-bottom: 1.05rem; }
      /* I SERVIZI DI OGGI: una scatola come quelle della colonna Google —
         stessa regola, qui sopra. L'imbottitura verticale e' piu' bassa
         perche' le righe dentro hanno gia' la loro: sommate, la prima riga
         sarebbe partita un dito sotto il bordo. */
      /* DUE SERVIZI AFFIANCATI quando c'e' posto. ⚠️ `auto-fit` + `minmax` e
         non due colonne fisse: i servizi possono essere cinque, e la colonna
         e' larga la meta' dello schermo su un portatile e tutta su un
         telefono. Cosi' il blocco conta da solo quante ce ne stanno —
         due, tre o una — invece di avere una misura per ogni apparecchio.
         190px e' il minimo in cui ci stanno nome, orario e l'interruttore
         grande: sotto, il nome andrebbe a capo. */
      .j-serv { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        column-gap: 1.6rem; row-gap: 0.1rem; padding: 0.45rem 1.15rem 0.55rem; }
      .j-serv:empty, .j-cmd:empty { display: none; margin: 0; padding: 0; border: none; box-shadow: none; }
      /* Nome sopra, orario sotto: il nome e' quello che si cerca («sto
         chiudendo il pranzo o la cena?»), l'orario e' la conferma. In fila
         sulla stessa riga erano due testi della stessa taglia, e l'occhio
         doveva leggerli tutti e due per sapere quale riga stava toccando.
         ⚠️ Fra un servizio e l'altro c'e' lo SPAZIO e non un filo: affiancati,
         un filo orizzontale avrebbe tagliato una colonna sola, e uno
         verticale si sarebbe dovuto accendere e spegnere a seconda di quante
         colonne la griglia ha deciso di fare — cosa che il CSS non sa dire. */
      .j-sv { display: flex; align-items: center; gap: 0.75rem; padding: 0.55rem 0; }
      .j-sv-x { display: flex; flex-direction: column; min-width: 0; }
      .j-sv .n { font-weight: 700; font-size: 0.95rem; }
      .j-sv .h { color: var(--c-muted); font-size: 0.78rem; margin-top: 0.1rem; }
      .j-sv .switch { margin-left: auto; flex: none; }
      /* Chiuso fino a riapertura: l'interruttore del giorno non lo riaprirebbe,
         quindi e' spento e disattivato — e la riga lo dice sbiadendo. */
      .j-sv.is-perm { opacity: 0.6; }

      /* ⚠️ Qui c'era tutta la macchina del «mezzo schermo vuoto»: la
         sotto-griglia `.j-due`, il caso «una sola funzione accesa»
         (`.j-sola`), il caso «nessuna delle due» (`.j-niente`) e due tile
         fatte salire dal basso in JavaScript per finire la riga
         (`.j-salite`, `.j-tiles`). Serviva perche' la fascia era fatta di due
         caselle di misura fissa: se una si spegneva, restava un buco che
         qualcuno doveva riempire a mano.
         Con una griglia di sezioni il buco non esiste — la sezione successiva
         scorre nella casella libera da sola. Quattro stati, un evento e
         centocinquanta righe di CSS e JavaScript sono spariti perche' il
         problema non c'e' piu', non perche' qualcuno li ha sistemati. */
      .j-nums { padding-top: 1.2rem; border-top: 1px solid rgba(36, 74, 82, .65); }
      /* ⚠️ Lo stacco dalla linea dei numeri e' un margine della LISTA, non lo
         spazio che avanza: `margin-top: auto` sui numeri da' zero quando la
         colonna e' piena, e l'ultima riga finiva appoggiata al filo. */
      /* `flex: 1` : la lista occupa tutto lo spazio fra l'intestazione e i
         numeri, anche quando e' vuota — e il messaggio puo' mettercisi in
         mezzo invece di restare appeso in alto. */
      /* ⚠️ Niente altezza sua: la lista prende quello che avanza nella colonna
         fra la testata e i numeri. Qui c'erano 330px scritti a mano — una
         misura in piu' da tenere d'accordo con l'altezza della colonna, e due
         numeri che si somigliano finiscono per divergere. */
      .j-lista { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem;
        padding-right: 0.3rem; }
      /* ⚠️ `flex: none` sulla RIGA, non solo `overflow` sul riquadro. In una
         colonna flex le righe si lasciano SCHIACCIARE per starci dentro: con
         dieci prenotazioni in un riquadro da 330px non sarebbe comparsa
         nessuna barra, sarebbero diventate dieci righe alte la meta' con il
         testo tagliato — un elenco che si rimpicciolisce invece di scorrere,
         e nessun errore da nessuna parte. */
      .j-li { flex: none; display: flex; align-items: flex-start; gap: 0.85rem; background: var(--c-card);
        border: 1px solid var(--c-line); border-radius: 12px; padding: 0.7rem var(--j-li-x, 0.9rem);
        box-shadow: 0 2px 8px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); text-decoration: none; color: var(--c-text); }
      .j-li .h { font-family: var(--font-title); font-size: 0.95rem; width: 44px; flex: none; color: var(--c-accent); }
      .j-li .h small { display: block; font-family: var(--font-body); font-size: 0.64rem; color: var(--c-muted); font-weight: 700; margin-top: 2px; }
      .j-li .tx { flex: 1 1 auto; min-width: 0; font-size: 0.88rem; font-weight: 600; }
      .j-li .j-nome { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      /* L'anteprima della nota: UNA riga, tagliata dove finisce lo spazio.
         In corsivo e rientrata, cosi' si vede che sono parole del cliente e
         non un altro dato della prenotazione. */
      .j-nota { display: flex; align-items: center; gap: 0.35rem; margin-top: 5px; font-size: 0.78rem;
        font-style: italic; color: var(--c-muted); min-width: 0; }
      .j-nota > span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .j-li .tx small { display: flex; align-items: center; gap: 0.35rem; font-weight: 400;
        color: var(--c-muted); font-size: 0.78rem; margin-top: 3px; min-width: 0; }
      .j-li .tx small > span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      /* ⚠️ In BIANCO, non nel grigio del testo accanto: a 13px un segno
         grigio su fondo scuro si perde, e l'icona serve proprio a far trovare
         la riga con un colpo d'occhio. Il testo resta grigio: il bianco e' del
         segno, non della frase. */
      .j-mi { width: 13px; height: 13px; flex: none; fill: none; stroke: var(--c-text);
        stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      /* Stato sopra, occasioni sotto: la colonna di destra resta stretta e
         allineata, qualunque cosa porti la riga. */
      .j-dx-col { display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem; flex: none; }
      .j-tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.25rem; max-width: 11rem; }

      /* ---------- La colonna «Menu»: la foto del piatto ----------
         ⚠️ LA CASELLA RESTA ANCHE SENZA FOTO. Nascondendola, le righe
         ballerebbero da sinistra e un piatto senza foto sembrerebbe a posto —
         mentre sul sito e' esattamente quello che vende meno, ed e' lo stesso
         buco che conta il numero in fondo alla colonna. Vuota, mostra l'icona
         grigia: il posto c'e' e si vede che e' vuoto.
         ⚠️ `object-fit: cover`: le foto del menu arrivano di ogni forma, e una
         pizza schiacciata dentro un quadrato e' una foto che fa sembrare il
         piatto peggiore di com'e'. */
      .m-foto { flex: none; width: 46px; height: 46px; border-radius: 10px; overflow: hidden;
        background: var(--c-bg); border: 1px solid var(--c-line);
        display: flex; align-items: center; justify-content: center; }
      .m-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .m-foto svg { width: 19px; height: 19px; stroke: var(--c-muted); fill: none; stroke-width: 1.5; opacity: 0.65; }
      /* Un piatto NASCOSTO non e' sul sito: foto spenta e nome grigio lo
         dicono prima che si legga la pastiglia. */
      .j-menu .j-li.m-off .m-foto { opacity: 0.42; }
      .j-menu .j-li.m-off .j-nome { color: var(--c-muted); }
      .j-menu .j-li { align-items: center; }
      /* ⚠️ La riga NON e' un link: l'unica cosa che si tocca e' l'interruttore
         (vedi `rigaMenu`). Quindi niente mano del cursore e niente colore da
         link — e' una riga che si legge. */
      .j-menu .j-li { cursor: default; }
      .j-menu .j-li .tx small { flex-wrap: wrap; row-gap: 0.15rem; }
      .m-prezzo { color: var(--c-text); font-family: var(--font-title); font-size: 0.88rem; }
      /* I formati finiti: in corallo chiaro, perche' sono la parte del piatto
         che NON si puo' vendere mentre il resto si. */
      .m-var { color: #ffb9ad; }
      /* L'interruttore dentro la riga non deve stirarsi in altezza con lei. */
      .j-menu .j-li .switch { flex: none; align-self: center; }
      /* Le etichette della lavagnetta: piene e bianche come le altre
         pastiglie della fascia. Erano un contorno col testo grigio — su un
         fondo chiaro, due grigi uno sull'altro. */
      .j-tag { font-size: 0.6rem; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap;
        padding: 0.12rem 0.45rem; border-radius: 999px; background: #5f7378; color: #fff; }
      .j-li .tx small b { color: var(--c-text); font-weight: 700; }
      /* Niente da mostrare: non e' un errore ne' una riga mancante, e' la
         buona notizia della serata.
         ⚠️ PRENDE TUTTO IL POSTO delle righe che non ci sono, con un filo
         TRATTEGGIATO. Prima era una scritta sospesa in mezzo al vuoto, e il
         vuoto sembrava un pezzo di pagina che non aveva finito di caricare:
         il tratteggio dice «qui ci vanno gli ordini, e oggi non ce ne sono» —
         un posto apparecchiato, non un buco. E tratteggiato e non pieno,
         perche' le scatole piene di questa fascia contengono qualcosa.
         `flex: 1` dentro `.j-lista`, che e' gia' una colonna alta quanto
         serve: il riquadro arriva fin dove sarebbe arrivato l'elenco. */
      .j-vuoto { flex: 1; display: flex; align-items: center; justify-content: center;
        padding: 1.5rem 1rem; text-align: center; font-size: 1.05rem;
        border: 1px dashed var(--c-line); border-radius: 12px;
        font-family: var(--font-title); color: var(--c-muted); }

      /* ⚠️ Le pastiglie di stato sono QUELLE delle loro pagine (reservations,
         orders): stessi colori, stesse parole. Due nomi per lo stesso stato
         sono due stati. Qui cambia solo la misura, perche' la riga e' meta'. */
      .j-badge { font-size: 0.64rem; text-transform: uppercase; letter-spacing: .06em; border-radius: 999px;
        font-family: var(--font-body); cursor: default;
        white-space: nowrap; height: 26px; padding: 0 0.7rem; display: inline-flex; align-items: center;
        justify-content: center; flex: none; font-weight: 700; }
      /* ⚠️ FONDO PIENO E SCRITTA BIANCA (09/10/2026). Erano tinte tenui con
         il bordo colorato e la scritta nel colore dello stato: un disegno
         fatto per il fondo SCURO, dove una velatura al 15% si stacca. Sul
         tema chiaro quelle stesse velature diventano quasi bianche e la
         scritta chiara ci sparisce dentro — «Terminée» era messa anche
         peggio: bordo bianco e testo bianco, cioe' invisibile su bianco.
         Il pieno e' l'unico che non dipende dal tema di chi guarda, ed e' la
         stessa lingua delle pastiglie delle foto e dei giorni speciali.
         ⚠️ I colori restano FISSI: `--c-accent` e' il colore delle AZIONI e
         cambia da cliente a cliente — «confermata» non deve diventare blu
         perche' un ristorante ha scelto il blu. */
      .j-badge.ok { background: #2e9e6b; color: #fff; }
      /* L'unica legata all'accento: «in attesa» e' la riga su cui si deve
         fare qualcosa, ed e' il colore con cui il pannello chiama all'azione. */
      .j-badge.pd { background: var(--c-accent); color: var(--c-bg); }
      .j-badge.bl { background: #3b82f6; color: #fff; }
      /* ⚠️ Una regola per due nomi: `gr` (prenotazione finita, no-show,
         annullata) e `done` (ordine terminato o annullato) sono la stessa
         cosa in due colonne — una riga chiusa, che non chiede piu' niente.
         Due grigi diversi sarebbero stati due stati diversi. */
      .j-badge.gr,
      .j-badge.done { background: #5f7378; color: #fff; }
      .j-badge.enc { background: #5d5555; color: #fff; }
      .j-badge.pay { background: #2e9e6b; color: #fff; }
      /* «Fini ?» — la domanda dell'orologio: la stessa veste di `.b-fini`
         nella pagina Réservations, perche' e' la stessa domanda.
         ⚠️ Senza il battito che ha di la'. Nella pagina ce n'e' una alla
         volta in mezzo a venti righe ferme; qui le righe sono poche e tutte
         della sera: tre pastiglie che pulsano insieme in un terzo di schermo
         non chiamano l'attenzione, la consumano. */
      /* ⚠️ «Fini ?» NON diventa piena, ed e' l'unica. Non e' uno stato: e' una
         DOMANDA che si clicca, e ha la veste del suo bottone nella pagina
         Réservations (`.b-fini`: contorno, e si riempie al passaggio). Piena
         sarebbe identica a «in attesa» — due cose diverse con la stessa
         faccia — e sul chiaro il contorno accento su fondo quasi bianco si
         legge, perche' il colore sta nel bordo e nella scritta, non in una
         velatura. */
      .j-badge.fin { background: color-mix(in srgb, var(--c-accent) 15%, transparent);
        border: 1px solid var(--c-accent); color: var(--c-accent); }
      /* Quella delle prenotazioni si clicca: lo dice il cursore, e si accende
         al passaggio come ogni altro comando del pannello. */
      .j-badge.j-st { cursor: pointer; }
      .j-badge.j-st:hover { filter: brightness(1.25); }

      /* Stretto: le colonne si impilano e l'altezza fissa non ha piu' senso —
         terrebbe aperto mezzo schermo vuoto. */
      /* ⚠️ Schermo stretto: una sezione sotto l'altra, altezza naturale e
         NESSUNO scorrimento dentro. Qui le colonne non sono affiancate — non
         c'e' niente da tenere in vista — e un riquadro che scorre dentro una
         pagina che scorre e' il dito che non sa piu' quale dei due sta
         muovendo. */
      @media (max-width: 1100px) {
        .jour { --j-cols: 1fr; --j-gap: 2.2rem; --j-col-h: auto; --j-scroll: visible; }
      }
      /* iPad in orizzontale: 1024-1366 CSS, cioe' largo come un portatile, ma
         lo si tocca col dito e lo si guarda da piu' lontano — percio'
         styles/tablet.css abbassa il piede di misura a 13px e tutto rientra.
         Le tre colonne ci stanno, e sono il motivo per cui si apre la Accueil:
         qui si tolgono le variabili della fascia stretta e tornano le misure
         di sopra, con un po' meno aria fra le colonne. `pointer: coarse` non
         e' un dettaglio: senza, prenderebbe anche i portatili da 1280. */
      @media (min-width: 1024px) and (max-width: 1366px) and (pointer: coarse) {
        /* ⚠️ SUL TABLET LE SEZIONI STANNO TUTTE SU UNA RIGA, e la riga si
           scorre col dito. Non e' un ripiego della griglia stretta: su un
           iPad in mano, mandare la quarta sezione a capo vuol dire che per
           vederla si scorre la pagina in verticale e si perde di vista la
           prima. Una fila sola si tira di lato, e le sezioni restano
           confrontabili fra loro come su un bancone.
           `grid-auto-flow: column` + `grid-auto-columns`: nessuna riga da
           contare, nessun numero di sezioni scritto da qualche parte — se ne
           aggiunge una, la fila si allunga.
           ⚠️ `minmax(380px, 1fr)` e non una larghezza secca: quando le
           sezioni accese sono due e ci stanno, si prendono lo schermo invece
           di lasciare mezzo bancone vuoto. */
        .jour { --j-cols: none; --j-gap: 2rem; --j-scroll: auto;
          /* ⚠️ L'ALTEZZA SI RIACCENDE QUI. Da 1024 a 1100 vale anche la media
             query della fascia stretta, che l'aveva spenta (`auto`): senza
             questa riga un iPad mini in orizzontale si teneva le colonne alte
             quanto il loro contenuto — tre righe di ordini e il bancone
             sbordava sotto la barra. Si riaccende la FORMULA, non il numero. */
          --j-col-h: var(--j-col-piena);
          /* ⚠️ LARGHEZZA FISSA, e non `1fr`: e' un bancone, e le colonne di un
             bancone sono tutte larghe uguali. Con `1fr` le colonne si
             allargherebbero per riempire lo schermo quando sono poche e si
             stringerebbero quando sono tante — cioe' la stessa colonna
             cambierebbe faccia da un locale all'altro. */
          --j-col-w: 400px;
          grid-auto-flow: column; grid-auto-columns: var(--j-col-w);
          overflow-x: auto; overscroll-behavior-x: contain;
          scroll-snap-type: x proximity;
          /* Lo spazio sotto e' per il dito e per la barra: senza, il filo di
             scorrimento passa sopra l'ultima riga dei numeri. */
          padding-bottom: 3rem;
        }
        .jour > * { scroll-snap-align: start; }
        /* ⚠️ L'ultima casella del bancone, non una riga in fondo: `1 / -1` su
           una griglia a colonne automatiche creerebbe una RIGA sotto, e per
           vedere un disegno si scorrerebbe in verticale uno schermo che e'
           alto quanto le colonne. Qui il marchio e' l'ultima colonna: lo si
           incontra arrivando in fondo allo scorrimento di lato. */
        .j-marchio { grid-column: auto; }
        .j-marchio i { width: 150px; }
      }
      @media (max-width: 759px) { .j-hm-f .src { margin-left: 0; } }

      /* IL MARCHIO DEL MOTORE, in fondo alla fascia.
         ⚠️ E' un FIGLIO DELLA GRIGLIA, e per questo sta dentro `.jour`: su un
         tablet in orizzontale la fascia e' un bancone che si tira di lato, e
         il marchio messo SOTTO costringeva a scorrere anche in verticale per
         un disegno — su uno schermo che e' alto esattamente quanto le colonne.
         Dentro la griglia diventa l'ultima casella: sul desktop prende tutta
         la larghezza sotto le colonne, sul bancone e' l'ultima colonna e si
         trova in fondo allo scorrimento, dove la giornata finisce.
         ⚠️ `pointer-events: none` e `aria-hidden`: non e' un link e non e'
         un'informazione, e chi legge lo schermo ad alta voce non deve
         annunciarlo in fondo a ogni giornata. */
      .j-marchio { grid-column: 1 / -1; display: flex; align-items: center; justify-content: center;
        padding: 0.5rem 0; pointer-events: none; }
      /* ⚠️ IL COLORE E' QUELLO DEL TESTO, e il disegno e' una MASCHERA, non
         un'immagine: il file del marchio e' bianco (piu' un blocco rosso), e
         bianco su un tema chiaro vuol dire invisibile. Con la maschera la
         forma viene dal file e il colore da `--c-text`: scuro sui temi
         chiari, chiaro su quelli scuri, senza una seconda copia del disegno
         da tenere allineata e senza chiedere al server se il tema e' scuro. */
      .j-marchio i { display: block; width: 180px; max-width: 45vw; height: 24px;
        background: var(--c-text); opacity: 0.12;
        -webkit-mask: url("/restohub/wordmark-negative.svg") center / contain no-repeat;
        mask: url("/restohub/wordmark-negative.svg") center / contain no-repeat; }
      .tile { display: block; min-width: 0; margin-bottom: 0.75rem; background: var(--c-card); border: 1px solid var(--c-line); padding: 1.6rem; text-decoration: none; color: var(--c-text); transition: border-color 0.2s, transform 0.15s; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); }
      a.tile:hover { border-color: var(--c-accent); transform: translateY(-2px); }
      .tile-title { font-family: var(--font-title); font-size: 1.35rem; letter-spacing: 0.04em; line-height: 1; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
      .tile-title .tt-ico { width: 17px; height: 17px; flex: 0 0 auto; fill: none; stroke: var(--c-accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .tile-big { font-family: var(--font-title); font-size: 2.3rem; line-height: 1; margin-bottom: 0.25rem; color: var(--c-accent); }
      .tile-next { border-top: 1px solid var(--c-line); padding-top: 1rem; font-size: 0.95rem; }
      .tile-next .lab { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-muted); display: block; margin-bottom: 0.3rem; }
      .state { color: var(--c-muted); padding: 1rem 0; }

      /* Testata di una tile con il link a destra (Photos). ⚠️ Il prefisso
         `st-` viene dalla tile Statistiques, che non c'e' piu': i nomi sono
         rimasti perche' rinominarli e' un'altra modifica, e una modifica per
         volta e' il motivo per cui si capisce che cosa ha rotto che cosa. */
      .st-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
      .st-head .tile-title { margin-bottom: 0; }
      .st-link { color: var(--c-muted); font-size: 0.8rem; text-decoration: none; transition: color 0.15s; }
      .st-link:hover { color: var(--c-accent); }

      /* --- Card Photos récentes (2 colonne, griglia 4x2) --- */
      /* La griglia della colonna «Photos». Tre per riga: a quattro, dentro
         una colonna della fascia, la miniatura diventa un francobollo e una
         foto che non si riconosce vale meno di niente. */
      .j-foto-wrap { overflow-y: auto; }
      .ph-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
      /* ⚠️ `position: relative`: la pastiglia «Libre» e il cestino si
         appoggiano QUI dentro. Senza, finivano sull'angolo del primo antenato
         posizionato — cioe' da un'altra parte nella pagina, e il cestino di
         tutte le foto libere si sarebbe impilato nello stesso punto.
         ⚠️ Niente piu' ingrandimento al passaggio: la cella non si clicca, e
         un quadrato che reagisce al dito promette qualcosa che non succede. */
      .ph-cell {
        position: relative; display: block; cursor: default;
        border: 1px solid var(--c-line); border-radius: 10px; overflow: hidden;
        background: var(--c-bg);
      }
      .ph-cell img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
      /* ⚠️ La casella resta anche se l'immagine non arriva: un buco nella
         griglia sembra un pezzo non caricato, e invece e' un file che non
         risponde piu'. L'icona grigia lo dice. */
      .ph-cell.rotta { display: flex; align-items: center; justify-content: center; aspect-ratio: 1; }
      .ph-cell.rotta svg { width: 20px; height: 20px; stroke: var(--c-muted); fill: none; stroke-width: 1.5; opacity: 0.6; }
      /* Le pastiglie in basso a sinistra: a cosa serve la foto. Sempre in
         vista, non al passaggio del dito. Vanno a capo da sole, perche' una
         foto puo' stare in due famiglie. */
      .ph-tags { position: absolute; left: 0.3rem; bottom: 0.3rem; right: 0.3rem;
        display: flex; flex-wrap: wrap; gap: 0.2rem; }
      .ph-t, .ph-b { font-size: 0.58rem; font-weight: 800; letter-spacing: 0.04em;
        text-transform: uppercase; padding: 0.12rem 0.4rem; border-radius: 999px; }
      /* ⚠️ TUTTE PIENE, con la scritta bianca. Queste pastiglie stanno SOPRA
         una fotografia: un fondo trasparente prende il colore di cio' che c'e'
         sotto, e la stessa parola che si legge su una tagliata scura sparisce
         su una panna cotta. Il colore pieno e' l'unico che non dipende dalla
         foto.
         I colori sono quelli che il pannello usa gia' altrove: il blu di «a
         tavola» e il verde di «confermata» nelle pastiglie di stato. */
      .ph-t { background: rgba(8, 26, 30, 0.78); color: #fff; }
      /* Un colore pieno per famiglia: arancione il menu, blu il marketing,
         grigio il sito. ⚠️ L'arancione NON e' `--c-accent`: quello e' il
         colore delle AZIONI del pannello (il bottone pieno, la pastiglia del
         filtro acceso) e cambia da cliente a cliente — una pastiglia che si
         legge «menu» non deve diventare rossa, blu o verde a seconda del tema
         di chi guarda. */
      .ph-menu { background: #e07a3b; }
      .ph-marketing { background: #3b82f6; }
      .ph-site { background: #5f7378; }
      /* «Libre» e' VERDE PIENO, testo bianco: una foto che non usa nessuno non
         e' un guasto — e' una foto disponibile, da montare da qualche parte o
         da buttare. Il rosso qui dentro vuol dire «qualcosa non va», e su
         mezza libreria avrebbe gridato tutto il giorno per niente.
         ⚠️ `#2e9e6b` e' il verde che il pannello usa gia' per «confermata»
         nelle pastiglie di stato: pieno perche' sta SOPRA una fotografia, dove
         un fondo trasparente prende il colore di quello che c'e' sotto e una
         scritta chiara su una panna cotta non si legge piu'. */
      .ph-b { background: #2e9e6b; color: #fff; }
      /* Il cestino sta sulla foto, in alto a DESTRA: e' il tondo del pannello
         in taglia piccola (`.ibtn.ibtn-sm.ibtn-danger`), con la sua guardia a
         due tocchi. Si vede solo sulle foto che non usa nessuno — e si vede
         sempre, perche' su un tablet non c'e' un passaggio del dito che lo
         faccia comparire. */
      .ph-del { position: absolute; right: 0.3rem; top: 0.3rem; }
      .ph-del.confirm { width: auto; border-radius: 999px; padding: 0 0.45rem; font-size: 0.58rem;
        font-weight: 800; letter-spacing: 0.03em; }
      .ph-empty { grid-column: 1 / -1; color: var(--c-muted); font-size: 0.85rem; padding: 1rem 0; text-align: center; }

      /* --- Pastiglie aperto/chiuso: colonna Jours spéciaux, tile Menu, Visibilité --- */
      /* `.spx-list` e `.spx-row` erano l'elenco dentro la tile Menu, che non
         c'e' piu'. La pastiglia `.spx-b` invece e' rimasta: sta in
         `styles/stati.css` e la usano la colonna dei giorni speciali e quella
         del menu. */
      /* `.spx-b` (aperto / chiuso / festa / oggi) sta in `styles/stati.css`:
         la stessa pastiglia la disegna anche l'elenco dei giorni speciali nei
         Réglages, e scritta qui era piu' grande di la'. */
      .ev-cal { width: 50px; flex: 0 0 auto; background: var(--c-input); border: 1px solid var(--c-line); border-radius: 8px; display: flex; flex-direction: column; align-items: center; padding: 0.3rem 0 0.28rem; line-height: 1; }
      .ev-cal b { font-family: var(--font-title); font-size: 1.1rem; color: var(--c-text); }
      .ev-cal i { font-style: normal; font-size: 0.56rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-accent); margin-top: 3px; }
      .ev-nome { display: block; font-weight: 700; font-size: 0.95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

      /* ===================== COLONNA JOURS SPÉCIAUX =====================
         ⚠️ Le righe sono `.j-li`, le stesse di prenotazioni e ordini: una cosa
         che si prende una alla volta ha un blocco, e questo e' il blocco del
         pannello. Niente scatola nuova per la stessa idea. */
      /* ⚠️ TRATTEGGIATO = NESSUNO L'HA DECISO. Una festa senza giorno speciale
         non e' un dato scritto da qualcuno: e' una data che sta sul calendario.
         Lo stesso filo di «Rien à afficher» — un posto apparecchiato, non un
         fatto.
         ⚠️ Il FONDO pero' e' quello di tutte le righe (`--c-card`, come le
         prenotazioni e gli ordini): senza, in una colonna di blocchi pieni
         quelli trasparenti si leggevano come buchi — e la differenza fra «da
         decidere» e «non c'e' niente» e' proprio quella che la colonna deve
         dire. Resta il filo, che e' il segno giusto: cambia il BORDO, non la
         presenza. */
      .j-spx-li.aperta { border-style: dashed; }
      /* Oggi: bordo corallo, come la pastiglia piena qui dentro. Un giorno
         speciale che e' OGGI non e' un promemoria, e' il turno di stasera. */
      .j-spx-li.oggi { border-color: var(--c-accent); }
      .j-spx-l1 { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; min-width: 0; }
      /* Il calendarietto di un PERIODO: due date, una sopra l'altra.
         ⚠️ La freccia in mezzo non e' decorazione: due numeri incolonnati
         senza niente fra loro si leggono come due giorni staccati, ed e'
         l'opposto — e' un intervallo, e dentro c'e' chiuso tutto. */
      .ev-cal.due { padding: 0.4rem 0 0.35rem; }
      .ev-cal.due em { font-style: normal; font-size: 0.72rem; line-height: 1;
        color: var(--c-muted); margin: 0.1rem 0; }
      /* Il cestino in alto a destra, come nelle note: la riga puo' essere
         alta due piani o cinque (un periodo col calendarietto doppio), e
         centrato scendeva con lei — lo stesso comando finiva ogni volta a
         un'altezza diversa, e si cerca con gli occhi invece di trovarlo dove
         sta sempre. */
      .j-spx-li .j-spx-del { align-self: flex-start; margin-left: auto; }
      .j-spx-l1:empty { display: none; }
      .j-spx-l1 .ev-nome { font-size: 0.95rem; }
      /* La riga di sotto: la misura e le pastiglie, sulla stessa linea. */
      .j-spx-l2 { display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;
        min-width: 0; margin-top: 3px; }
      .j-spx-dur { font-family: var(--font-title); font-size: 0.95rem; color: var(--c-text); }
      .j-spx-gg { color: var(--c-muted); font-size: 0.78rem; text-transform: capitalize; }


      /* Guscio, titolo e × : classi .md-* in src/styles/modal.css. */
      /* Tab del modale: la pastiglia condivisa (`styles/filters.css`). Qui
         resta solo il margine, che e' di questa pagina. */
      .m-tabs { margin: 0.9rem 0 1rem; }
      .evm-pane .f-label:first-of-type { margin-top: 0.6rem; }
      /* ⚠️ Qui c'erano quattro regole `#evt-overlay .spf …` che ridipingevano
         campi e pastiglie del form perche' il modale ha un fondo diverso da
         Réglages. Con un ID davanti: battevano qualunque regola condivisa, per
         sempre. Il form adesso ricava i suoi bordi dal colore del TESTO e i
         campi sono quelli di `field.css`, che su un fondo valgono quanto
         sull'altro — e non c'e' piu' niente da correggere da fuori. */
      .evm-sub { color: var(--c-muted); font-size: 0.85rem; line-height: 1.55; margin-bottom: 0.4rem; }
      /* L'etichetta e' `.f-label` e il campo e' quello di `field.css` (dentro
         un modale non serve nemmeno la classe). Qui resta lo spazio fra una
         domanda e l'altra, che e' di questo modale. */
      .evm-pane .f-label { margin: 1rem 0 0.35rem; }
      #evt-date { cursor: pointer; }
      .evm-check { display: flex; align-items: center; gap: 0.55rem; margin: 1.1rem 0 1.3rem; font-size: 0.9rem; cursor: pointer; }
      .evm-check input { accent-color: var(--c-accent); width: 16px; height: 16px; cursor: pointer; }
      .evm-list { margin-top: 1.3rem; display: flex; flex-direction: column; gap: 0.4rem; max-height: 260px; overflow-y: auto; }
      .evm-vide { color: var(--c-muted); font-size: 0.85rem; }
      /* Fondo PIENO, non un rettangolo col bordo: la riga e' un blocco, e il
         bordo in piu' faceva sembrare ogni evento un campo da compilare. */
      /* La riga di un evento e' la STESSA CARD della colonna (`.j-li`): fondo
         `--c-card`, filo `--c-line`, 12px di raggio. Qui c'era un terzo grigio
         inventato (`color-mix` sul testo al 15%) e dieci pixel di raggio: lo
         stesso evento, visto nella colonna e nel modale, era due oggetti
         diversi — e sono a un clic di distanza l'uno dall'altro. */
      .evm-row {
        display: flex; align-items: center; gap: 0.7rem;
        background: var(--c-card);
        border: 1px solid var(--c-line); border-radius: 12px;
        padding: 0.6rem 0.65rem 0.6rem 0.8rem; font-size: 0.88rem;
      }
      .evm-row .d { color: var(--c-accent); font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
      .evm-row .n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .evm-row .y { color: var(--c-muted); font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; }
      /* Il cestino e' `.ibtn.ibtn-danger`, con la sua guardia a due tocchi:
         il primo arma «Eliminare?», il secondo cancella.
         ⚠️ Qui era il TERZO scritto a mano nella stessa pagina (`.note-del`
         nelle note, `.evm-del` qui, e quello condiviso nei giorni speciali) —
         tre cestini con tre bordi e tre rossi diversi per lo stesso gesto. */


      /* --- Tile Menu --- */

      /* --- La lavagnetta nella colonna (il modale resta su fondo oro) ---
         ⚠️ Qui c'era il vestito della tile: fondo oro, testo marrone, due
         bottoni tondi suoi (`.ntile-btn`). Se n'e' andato con la tile. Il
         marrone su oro, dentro una colonna scura, sarebbe stato un cerchio
         nero su fondo nero — e nessuno se ne sarebbe accorto finche' non
         avesse provato a spuntare una nota. */
      /* Il dito cambia sulle RIGHE, non su tutto il riquadro: nella colonna
         il riquadro e' alto come gli altri, e sotto l'ultima nota c'e' spazio
         vuoto che non porta da nessuna parte. */
      .notes-preview .np-item, .notes-preview .np-empty { cursor: pointer; }
      .j-nbtns { display: flex; gap: 0.4rem; margin-left: auto; flex: none; }
      /* La riga dei filtri sta FUORI dal corpo che scorre: si filtra per
         scendere meno, e un filtro che scorre via con cio' che filtra fa
         risalire ogni volta. */
      .j-nfiltri { flex: none; margin-bottom: 0.75rem; }
      /* ⚠️ Il disegno sta sotto `.j-nfiltri`, non su `.rh-filter`: quella
         pastiglia e' il componente condiviso di Menu, Google e Statistiche, e
         una regola sua qui dentro arriverebbe anche la', dove nessuno ha
         chiesto un'icona. */
      .j-nfiltri .rh-filter.tutte { display: inline-flex; align-items: center; gap: 0.4rem; }
      .j-nfiltri .rh-filter svg { width: 14px; height: 14px; flex: none;
        fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
      /* ⚠️ Su tablet e telefono resta la SOLA icona. La riga delle etichette
         e' l'unica cosa che scorre di lato in una colonna larga quanto il
         dito, e «Toutes» e' la parola di cui si puo' fare a meno: il disegno
         dice la stessa cosa e lascia il posto alle etichette vere, che sono
         quelle che non si possono indovinare.
         Due fasce e non una: sono le STESSE due in cui la fascia cambia forma
         piu' in su in questo file — telefono (colonne impilate) e iPad
         orizzontale (il bancone che si tira di lato). */
      @media (max-width: 1100px) {
        .j-nfiltri .rh-filter.tutte .et { display: none; }
        .j-nfiltri .rh-filter.tutte { padding-left: 0.8rem; padding-right: 0.8rem; }
      }
      @media (min-width: 1024px) and (max-width: 1366px) and (pointer: coarse) {
        .j-nfiltri .rh-filter.tutte .et { display: none; }
        .j-nfiltri .rh-filter.tutte { padding-left: 0.8rem; padding-right: 0.8rem; }
      }
      /* L'elenco arriva piu' vicino alla linea dei numeri: sotto non c'e' una
         seconda lista da staccare, c'e' il piede della colonna. */
      .j-notes .j-lista { margin-bottom: 0.9rem; }
      /* OGNI NOTA E' UN BLOCCO SUO, in corallo. Una lavagnetta non e' un
         elenco: sono bigliettini, e due bigliettini separati da un filo sono
         due righe di una lista. Il blocco dice che si possono prendere,
         spuntare e buttare uno per uno.
         ⚠️ Il corallo torna qui dentro ed e' una scelta, non un residuo della
         tile: nella fascia tutte le scatole sono scure, e la lavagnetta e'
         l'unica cosa che qualcuno ha scritto a mano — non un dato che
         arriva. Il colore e' quello che il pannello usa gia' per dire
         «attenzione a questo».
         ⚠️ `flex: none`: le note stanno in una colonna che scorre, e senza si
         lascerebbero schiacciare invece di far comparire la barra — la stessa
         trappola delle righe di prenotazione. */
      .j-notes .np-item { flex: none; background: var(--c-accent); color: var(--c-bg);
        border-radius: 12px; border-top: none; padding: 0.7rem 0.9rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); }
      /* ⚠️ Il cerchio della spunta e le pastiglie dei tag NON hanno bisogno di
         niente: erano gia' disegnati per una nota su fondo corallo (e' da li'
         che vengono). Scrivere qui una seconda versione «per la colonna»
         vorrebbe dire due spunte da tenere d'accordo per sempre. */
      .j-notes .np-empty { color: var(--c-muted); }
      /* Stessa misura del testo del modale (0.98rem) e STESSO cerchio
         (.note-check): spuntare una nota si fa anche da qui, senza aprire. */
      /* ⚠️ `flex-start`: il bigliettino ha tre piani — testo, etichette, chi e
         quando — e il cerchio della spunta va in cima accanto alla prima
         riga. Centrato, su una nota di due righe finiva a mezz'aria. */
      .np-item { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.98rem; }
      .np-body { flex: 1; min-width: 0; }
      /* ⚠️ IL TESTO VA A CAPO, e non si taglia coi puntini. I puntini vanno
         bene quando il testo intero si puo' leggere da un'altra parte: qui
         l'elenco completo nel modale non c'e' piu', e una nota tagliata
         sarebbe una nota PERSA — scritta, salvata, e illeggibile per sempre. */
      .np-text { display: block; white-space: pre-wrap; word-break: break-word; line-height: 1.35; }
      /* ⚠️ FATTA = TUTTO IL BIGLIETTINO SBIADISCE, non il solo testo. Una nota
         spuntata resta li' per essere ritrovata, ma non deve piu' chiedere
         attenzione: col solo testo sbiadito, l'etichetta e il corallo pieno
         continuavano a gridare quanto quelli da fare, e la colonna non si
         leggeva piu' a colpo d'occhio.
         ⚠️ L'opacita' sta sul BLOCCO, e il testo non ne ha piu' una sua: due
         trasparenze sovrapposte fanno 0,30 — il testo di una nota fatta
         sarebbe sparito, e «fatta» non vuol dire «cancellata». */
      .j-notes .np-item.done { opacity: 0.55; }
      .np-item.done .np-text { text-decoration: line-through; }
      /* Chi l'ha scritta e quando, in piccolo sotto: non si cerca quasi mai,
         ma quando si cerca e' l'unica cosa che serve — «questa chi l'ha
         messa?». Lo stesso inchiostro scolorito delle altre righe di servizio
         su fondo chiaro. */
      .note-meta { color: color-mix(in srgb, var(--c-bg) 60%, transparent);
        font-size: 0.72rem; margin-top: 0.35rem; }
      /* Il nome in grassetto, l'ora no: fra i due, quello che si cerca e'
         «chi». L'ora e' il contorno. */
      .note-meta b { font-weight: 700; color: color-mix(in srgb, var(--c-bg) 80%, transparent); }
      .np-empty { opacity: 0.8; font-size: 0.92rem; }

      /* --- Modale «Nouvelle note»: i colori di tutti i modali --- */
      /* ⚠️ Qui c'era il vestito di una finestra color post-it — carta crema
         per il testo, pastiglie marroni, un bottone «Ajouter» tutto suo — e
         sotto il disegno dell'elenco delle note, che nel modale non c'e'
         piu'. Campo e bottoni adesso sono quelli condivisi (`.fld`, `.btn`,
         `.md-btn`): la finestra non ha piu' colori propri da tenere
         d'accordo con nessuno. */
      .nc-txt { width: 100%; min-height: 110px; resize: vertical; line-height: 1.5; }
      .nc-lab { display: block; margin: 1rem 0 0.4rem; }
      /* Nessuno nel team: invece di una casella vuota, la frase che spiega e
         la porta per rimediare. ⚠️ Un menu' con dentro il solo «Personne» non
         e' un comando, e' un vicolo cieco con l'aria di un comando. */
      .nc-vuoto { font-size: 0.8rem; color: var(--c-muted); margin-bottom: 0.5rem; }
      /* ⚠️ QUATTRO COLONNE FISSE, e le righe che servono. Non `auto-fit`: qui
         le caselle sono volti, e una fila di volti che cambia numero a ogni
         larghezza si ri-impara ogni volta. La finestra e' larga 560px: quattro
         ci stanno comode. Sotto i 520px si scende a tre, perche' a quattro il
         nome andrebbe a capo in mezzo. */
      .nc-ask { display: flex; align-items: center; gap: 0.7rem; margin: 1.1rem 0 0; }
      .nc-ask-t { font-size: 0.9rem; }
      #nc-chi { margin-top: 0.9rem; }
      .nc-chi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem 0.4rem; }
      @media (max-width: 520px) { .nc-chi-grid { grid-template-columns: repeat(3, 1fr); } }
      /* ⚠️ Il cerchio e' piu' grande qui che altrove (56 contro 40): nella
         colonna e' il contorno di chi ha scritto una recensione, qui e' il
         BERSAGLIO da toccare col dito, e una faccia da riconoscere prima di
         toccarla. Stesso componente, taglia dichiarata nel posto che la usa. */
      .nc-p .j-av { width: 56px; height: 56px; font-size: 1.05rem; position: relative; }
      /* ⚠️ La foto COPRE le iniziali, non ci sta accanto. Dentro un cerchio
         `inline-flex`, l'immagine era un fratello del testo: si stringevano
         per stare in due, e usciva mezza faccia con una lettera a fianco. Qui
         sta sopra, e se non carica (`onerror` la toglie) sotto ci sono gia' le
         iniziali. */
      .nc-p .j-av img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .nc-p { display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
        background: transparent; border: none; padding: 0.2rem 0; cursor: pointer;
        color: var(--c-muted); font-family: var(--font-body); min-width: 0; }
      .nc-p .n { font-size: 0.72rem; max-width: 100%; overflow: hidden;
        text-overflow: ellipsis; white-space: nowrap; }
      /* ⚠️ L'anello sta FUORI dal cerchio (`box-shadow`), non e' un bordo: un
         bordo mangia due pixel di foto e la faccia scelta si rimpicciolisce
         nel momento in cui la si sceglie. */
      .nc-p .j-av { transition: box-shadow 0.15s; }
      .nc-p.is-on { color: var(--c-text); font-weight: 700; }
      .nc-p.is-on .j-av { box-shadow: 0 0 0 2px var(--c-accent); }
      .nc-p:hover .j-av { box-shadow: 0 0 0 2px color-mix(in srgb, var(--c-accent) 45%, transparent); }
      .nc-p .n { font-size: 0.74rem; }
      .nc-tags { display: flex; gap: 0.45rem; flex-wrap: wrap; }
      /* La pastiglia da PREMERE: contorno da spenta, piena da accesa. E' la
         stessa coppia dei bottoni «15/30/45» della préparation — sceglie, non
         informa. */
      .nc-tag { border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c-text) 28%, var(--c-bg));
        background: var(--c-card); color: var(--c-text); font-family: var(--font-body);
        font-size: 0.78rem; font-weight: 700; padding: 0.28rem 0.75rem; cursor: pointer;
        transition: background 0.15s, color 0.15s, border-color 0.15s; }
      .nc-tag:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .nc-tag.is-on { background: var(--c-accent); color: var(--c-bg); border-color: var(--c-accent); }
      /* ⚠️ La pastiglia «+ etichetta» NON si accende come le altre: quelle
         dicono una scelta fatta, questa apre una cosa. Il tratteggio lo dice
         prima di premerla — e' un posto vuoto da riempire, non un'etichetta. */
      .nc-tag.nc-piu { border-style: dashed; color: var(--c-muted); }
      .nc-tag.nc-piu:hover { color: var(--c-accent); }
      .nc-new { position: relative; margin-top: 0.6rem; }
      /* Spazio a destra per il cerchio: senza, il testo ci scorre sotto. */
      .nc-new .fld { width: 100%; padding-right: 3.1rem; }
      /* ⚠️ UN CERCHIO VERO: larghezza e altezza UGUALI e scritte, `padding: 0`
         e nessun testo che lo gonfi. Qui c'era un `.btn btn-sm`, cioe' una
         pastiglia: raggio 999px su una scatola piu' larga che alta non fa un
         cerchio, fa un ovale — e un ovale accanto ai tondi del pannello si
         vede che e' un'altra cosa.
         `aspect-ratio` oltre alle due misure: se un giorno qualcuno cambia il
         corpo del «+», il quadrato resta quadrato. */
      .nc-ok {
        position: absolute; right: 0.45rem; top: 50%; transform: translateY(-50%);
        width: 32px; height: 32px; aspect-ratio: 1; padding: 0; border: none;
        border-radius: 50%; background: var(--c-accent); color: var(--c-bg);
        display: inline-flex; align-items: center; justify-content: center;
        font-family: var(--font-body); font-size: 1.25rem; line-height: 1;
        cursor: pointer; transition: filter 0.15s;
      }
      .nc-ok:hover { filter: brightness(1.08); }
      /* I due pannelli che si aprono con l'etichetta. `[hidden]` lo spegne il
         browser da solo: nessuna classe nostra per dire «nascosto». */
      .nc-extra { margin-top: 1rem; }
      .nc-extra .f-label { display: block; margin-bottom: 0.4rem; }
      .nc-rip { display: flex; gap: 0.5rem; flex-wrap: wrap; }
      .nc-rip .fld { flex: 1 1 7rem; min-width: 0; }
      /* Il messaggio d'errore sta nel piede, a sinistra dei bottoni: e' li'
         che si guarda dopo aver premuto «Ajouter». */
      .notes-msg { margin-right: auto; color: var(--c-hover); font-size: 0.82rem; font-weight: 700; }

      /* --- I bigliettini: il cerchio della spunta, i tag, il cestino --- */
      .note-tags { display: flex; gap: 0.3rem 0.8rem; margin-top: 0.3rem; flex-wrap: wrap; align-items: center; }
      .note-tag { border-radius: 999px; font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.12rem 0.5rem; }
      .note-tag.t-important { background: #8f2e15; color: #fff; }
      /* ⚠️ Un BLU VERO, scritto qui come i suoi due fratelli.
         Era marrone, e su un bigliettino corallo si confondeva col rosso di
         «important». L'ho poi ricavato da `--c-barra` per non inventare un
         colore — ma `--c-barra` e' il turchese delle barre del grafico, cioe'
         un parente del verde di «fournisseur»: derivandolo dal tema si
         otteneva un colore giusto in teoria e indistinguibile in pratica.
         Le tre etichette sono tre segni che devono separarsi con la coda
         dell'occhio: rosso, verde, blu. Sono tre esadecimali perche' devono
         restare DIVERSI FRA LORO, e tre tinte ricavate dallo stesso tema
         sarebbero finite vicine prima o poi. */
      .note-tag.t-recurrent { background: #1f6fb5; color: #fff; }
      .note-tag.t-fournisseur { background: #007153; color: #fff; }
      /* ⚠️ I tag scritti a mano non hanno un colore loro, e non devono
         averlo: un colore per tag vorrebbe dire sceglierne uno nuovo a ogni
         parola nuova, e dopo dieci note la colonna e' un arcobaleno che non
         dice niente. Quelli liberi portano tutti la stessa pastiglia scura. */
      .note-tag.t-libero { background: var(--c-brown); color: var(--c-accent); }
      .np-item .note-tag { transform: translateY(-1px); }
      /* ETICHETTA → INFORMAZIONE, sulla stessa riga. L'etichetta resta una
         pastiglia piena («di che si tratta»), il dettaglio e' testo in
         grassetto («entro quando», «ogni quanto»): due pastiglie di seguito
         con due significati diversi sarebbero due cose da imparare. */
      .note-tagx { display: inline-flex; align-items: center; gap: 0.35rem; min-width: 0; }
      .note-fr { font-weight: 700; opacity: 0.5; flex: none; }
      .note-info { font-size: 0.74rem; font-weight: 700;
        color: color-mix(in srgb, var(--c-bg) 78%, transparent); }
      /* ⚠️ A CHI TOCCA si legge piu' in grande del resto della riga. Scadenza
         ed etichette sono dettagli della nota; il nome di chi deve farla e' la
         prima cosa che si cerca in una lavagnetta di squadra — «questa e'
         mia?» — e alla taglia delle note di servizio bisognava andarlo a
         cercare. Resta piu' piccolo del testo della nota: dice di chi e', non
         che cosa c'e' da fare. */
      /* ⚠️ L'anello e' un'OMBRA, non un bordo: un bordo si disegna dentro il
         cerchio e mangia due pixel di faccia. E' lo stesso accorgimento della
         griglia nel modale — stesso componente, stesso modo di cerchiarlo.
         Scuro e trasparente perche' il fondo qui e' corallo: un anello bianco
         avrebbe aggiunto un terzo colore a un bigliettino che ne ha due. */
      .np-av { width: 28px; height: 28px; font-size: 0.68rem; position: relative;
        box-shadow: 0 0 0 2px color-mix(in srgb, var(--c-bg) 32%, transparent); }
      .note-tagx.chi { gap: 0.45rem; }
      .note-tagx.chi .note-info { font-size: 0.88rem; }
      .np-av img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .note-tagx svg { width: 13px; height: 13px; fill: none; stroke: currentColor;
        stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex: none;
        color: color-mix(in srgb, var(--c-bg) 72%, transparent); }
      /* ⚠️ Il ritardo e' l'unica cosa ROSSA su un bigliettino gia' corallo: un
         corallo piu' acceso non si sarebbe distinto dal fondo, e il rosso
         scuro dell'etichetta «important» e' lo stesso rosso che il pannello
         usa gia' per dire «questo e' andato storto». */
      .note-info.late { color: #7a1f12; }
      /* Il cestino a fondo bigliettino: e' l'azione, e le azioni stanno dove
         finisce la riga. Il bottone e' `.ibtn.ibtn-danger`, quello di tutto il
         pannello — qui resta solo DOVE sta.
         ⚠️ Era scritto a mano (`.note-del`: 30px, bordo e colore ricavati da
         `--c-bg` perche' il bigliettino e' corallo) e si e' portato dietro
         anche la sua guardia a due tocchi. Tre cestini diversi in tre colonne
         della stessa fascia: `.note-del`, `.evm-del` e quello condiviso.
         `.note-del` resta come AGGANCIO del clic, senza piu' una faccia. */
      .np-item .note-del { margin-left: auto; align-self: flex-start; }
      .note-check { flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--c-brown); background: transparent; cursor: pointer; margin-top: 0.1rem; display: inline-flex; align-items: center; justify-content: center; transition: background 0.15s, border-color 0.15s; }
      .note-check:hover { background: color-mix(in srgb, var(--c-bg) 12%, transparent); }
      .np-item.done .note-check { background: var(--c-brown); border-color: var(--c-brown); }
      .note-check svg { width: 13px; height: 13px; fill: none; stroke: var(--c-accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }

      /* ---- Organiser : FAB flottante in basso a sinistra (come les chiusure Réservations) ---- */
      /* Saluto sopra le tile (SOLO mobile): la parola ruota ogni 5s. */
      .home-hello { display: none; }
      @media (max-width: 640px) {
        .home-hello { display: block; text-align: center; margin: 0.15rem 0 1.1rem; font-family: var(--font-title); font-size: 1.25rem; line-height: 1.1; color: var(--c-muted); letter-spacing: 0.02em; }
        .home-hello strong { color: var(--c-text); font-weight: 700; }
        .home-hello .hh-word { display: inline-block; font-family: var(--font-mano); font-weight: 400; font-size: 0.95em; line-height: 1; vertical-align: -0.04em; margin-right: 0.2em; transition: opacity 0.35s ease, transform 0.35s ease; }
      }
      .org-fab {
        position: fixed; left: 1.5rem; bottom: 4.4rem; z-index: 90;
        width: 52px; height: 52px; border-radius: 50%;
        background: var(--c-accent); color: var(--c-bg); border: 2px solid var(--c-accent);
        display: flex; align-items: center; justify-content: center; cursor: pointer;
        box-shadow: 0 8px 24px rgba(0, 0, 0, calc(0.45 * var(--sh, 0.15)));
        transition: border-color 0.2s, color 0.2s, background 0.2s, transform 0.15s;
      }
      .org-fab:hover { background: var(--c-hover); border-color: var(--c-hover); transform: scale(0.94); }
      .org-fab svg { width: 23px; height: 23px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
      .org-fab.is-on {
        background: color-mix(in srgb, var(--c-accent) 62%, #000);
        border-color: color-mix(in srgb, var(--c-accent) 62%, #000);
        color: var(--c-bg); transform: scale(0.86);
      }
      .org-fab.is-on:hover { background: color-mix(in srgb, var(--c-accent) 50%, #000); border-color: color-mix(in srgb, var(--c-accent) 50%, #000); transform: scale(0.82); }
      /* Bottoni azione in VERTICALE (impilati dal JS posizionaIsole via bottom). */
      .org-fab-reset { left: 1.5rem; }
      .org-fab-tiles { left: 1.5rem; }

      /* ---- Modale « Tuiles » : afficher / masquer les tuiles ---- */
      .tm-list { margin-top: 0.9rem; display: flex; flex-direction: column; }
      .tm-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; border-top: 1px solid color-mix(in srgb, var(--c-text) 18%, var(--c-bg)); }
      .tm-row:first-child { border-top: none; }
      .tm-nom { font-size: 0.95rem; font-weight: 700; }
      /* L'interruttore e' il componente condiviso: .switch in src/styles/switch.css. */

      .tile { position: relative; }
      .tile-move, .tile-resize { display: none; }
      .cards.editing .tile { outline: 1px dashed var(--c-line); cursor: default; }
      .cards.editing a.tile:hover { transform: none; border-color: var(--c-line); }
      .cards .tile.is-off { display: none !important; }
      .tile-ph {
        margin-bottom: 0.75rem;
        border: 1px dashed var(--c-accent); border-radius: 2px;
        background: color-mix(in srgb, var(--c-accent) 9%, transparent);
      }
      .cards.editing .tile.dragging {
        z-index: 60; opacity: 0.97; cursor: grabbing; outline: 1px solid var(--c-accent);
        box-shadow: 0 20px 46px rgba(0, 0, 0, calc(0.65 * var(--sh, 0.15)));
      }
      .cards.editing .tile-move {
        display: flex; align-items: center; justify-content: center;
        position: absolute; top: 8px; left: 8px; width: 30px; height: 30px; z-index: 6;
        background: color-mix(in srgb, var(--c-bg) 90%, transparent); border: 1px solid var(--c-accent); border-radius: 8px;
        color: var(--c-accent); cursor: grab; touch-action: none;
      }
      .cards.editing .tile-move:active { cursor: grabbing; }
      .cards.editing .tile-move svg { width: 16px; height: 16px; fill: currentColor; }
      .cards.editing .tile-resize {
        display: block; position: absolute; right: 5px; bottom: 5px; width: 18px; height: 18px; z-index: 6;
        cursor: nwse-resize; touch-action: none;
        border-right: 3px solid var(--c-accent); border-bottom: 3px solid var(--c-accent);
        border-bottom-right-radius: 6px;
      }
    </style>
    <AdminHead />
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <div class="home-hello" id="home-hello" aria-live="polite"></div>
        <div class="state" id="state">{t("sup.loading")}</div>
        <Giornata recettes={vedeRecettes} />
        {/* ⚠️ La tile «Menu» non c'e' piu': e' diventata una colonna della
            fascia, come la lavagnetta e i giorni speciali prima di lei.
            Mostrava due conteggi e i primi quattro piatti indisponibili, con
            un «+3 in piu'…» che per sapere QUALI mandava ad aprire la pagina
            Menu — cioe' il contrario di cio' che serve guardando la Accueil
            all'apertura del servizio. */}
        {/* ⚠️ Anche «Photos récentes» e' diventata una colonna della fascia.
            Mostrava le ultime otto miniature, larga due colonne, e di ognuna
            diceva solo il nome nel titolo: quali foto non le usasse nessuno —
            cioe' le uniche cancellabili — non si vedeva da nessuna parte. */}
        {/* ⚠️ LA GRIGLIA DELLE ISOLE E' VUOTA: «Visibilité» era l'ultima tile,
            ed e' diventata una colonna della fascia come tutte le altre. Il
            contenitore resta perche' il codice dell'Organiser (trascinamento,
            ridimensionamento, modale delle tile) lo cerca all'avvio e si ferma
            se non lo trova — e in quello stesso blocco vive la colonna Google.
            Separarli e' una potatura di settecento righe che merita il suo
            giro: vedi `ENGINE.md`. Intanto nessuna tile = nessun comando, e i
            FAB dell'Organiser restano spenti. */}
        <div class="cards" id="cards" style="display:none"></div>
      </main>

      <!-- FAB Organiser (disposizione delle isole) -->
      <button class="org-fab" id="organiser-btn" type="button" title={t("home.organizeTiles")} aria-label={t("home.organize")} style="display:none">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      </button>
      <button class="org-fab org-fab-reset" id="organiser-reset" type="button" title={t("home.resetLayout")} aria-label={t("home.reset")} style="display:none">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.5 15a9 9 0 1 0 2.1-9.4L1 10"/></svg>
      </button>
      <button class="org-fab org-fab-tiles" id="organiser-tuiles" type="button" title={t("home.toggleTiles")} aria-label={t("home.tiles")} style="display:none">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="M3 12l9 5 9-5"/><path d="M3 16.5l9 5 9-5"/></svg>
      </button>

      <AdminFooter />
    </div>

    <!-- Modale Tuiles : afficher / masquer les tuiles de l'accueil -->
    <Modal id="tuiles-overlay" title={t("home.tiles")} width="420px">
      <p class="evm-sub">{t("home.tilesIntro")}</p>
      <div class="tm-list" id="tuiles-list"></div>
    </Modal>

    <!-- Modale Jours speciaux : evenement local | fermeture/ouverture -->
    <Modal id="evt-overlay" title={t("home.specialDays")} width="520px">
      <div class="m-tabs" id="evt-tabs">
        <button type="button" class="m-tab is-on" data-p="ev">{t("home.evtTabEvent")}</button>
        <button type="button" class="m-tab" data-p="cl">{t("home.evtTabClosure")}</button>
      </div>
      <div class="evm-pane" data-p="ev">
        <p class="evm-sub">{t("home.localEventsIntro")}</p>
        <label class="f-label" for="evt-nom">{t("home.name")}</label>
        <input id="evt-nom" maxlength="80" placeholder={t("home.eventNamePh")} autocomplete="off" />
        <label class="f-label" for="evt-date">{t("home.date")}</label>
        <input id="evt-date" readonly placeholder={t("home.chooseDate")} />
        <label class="evm-check"><input type="checkbox" id="evt-yearly" />{t("home.yearly")}</label>
        <div class="evm-list" id="evt-list"></div>
      </div>
      <div class="evm-pane" data-p="cl" hidden>
        <p class="evm-sub">{t("home.closureIntro")}</p>
        <SpecialDaysForm azioneFuori />
      </div>
      {/* ⚠️ IL PIEDE, come in ogni altro modale del pannello: «Annulla» e la
          conferma, in basso a destra. L'«Aggiungi» stava dentro il corpo, a
          tutta larghezza e con una grafica sua — in mezzo al modulo sembrava
          un altro campo, e sopra all'elenco degli eventi sembrava che
          aggiungesse quello.
          ⚠️ UNA conferma per linguetta, non una sola che indovina: le due
          linguette salvano cose diverse (un promemoria, una chiusura vera).
          Un bottone unico avrebbe dovuto chiedersi su quale pannello si trova,
          e il giorno che se lo chiede male si crea la cosa sbagliata. */}
      <Fragment slot="foot">
        <button type="button" class="md-btn" data-md-close>{t("common.cancel")}</button>
        <button type="button" class="md-btn md-btn-primary evm-ok" data-p="ev" id="evt-add">{t("common.add")}</button>
        <button type="button" class="md-btn md-btn-primary evm-ok" data-p="cl" id="evt-add-cl" hidden>{t("common.add")}</button>
      </Fragment>
    </Modal>

    {/* ⚠️ UN MODALE PER SCRIVERE UNA NOTA, e basta.
        Qui sotto c'era anche l'elenco completo delle note: le stesse note che
        si leggono nella colonna, ridisegnate una seconda volta con un secondo
        markup e un secondo `render`. Due disegni della stessa cosa sono due
        posti dove un giorno la pastiglia di un tag esce diversa, e la finestra
        copriva la colonna per mostrarle di nuovo.
        ⚠️ E i colori sono quelli di TUTTI i modali. Il fondo corallo
        (`md-nota`) era il vestito della vecchia tile oro: adesso il corallo e'
        il bigliettino nella colonna, e una finestra grande dello stesso colore
        del bigliettino fa sembrare la finestra una nota gigante. */}
    <Modal id="notes-overlay" title={t("home.newNote")} titleId="notes-title" width="560px">
      <textarea id="notes-input" class="fld nc-txt" maxlength="1000" placeholder={t("home.notesPlaceholder")}></textarea>

      <span class="f-label nc-lab">{t("home.noteTags")}</span>
      {/* I tre di sempre, piu' quelli gia' usati nelle altre note (li aggiunge
          lo script) e il campo per scriverne uno nuovo. */}
      <div class="nc-tags" id="nc-tags">
        <button type="button" class="nc-tag" data-tag="important">{t("tag.important")}</button>
        <button type="button" class="nc-tag" data-tag="recurrent">{t("tag.recurrent")}</button>
        <button type="button" class="nc-tag" data-tag="fournisseur">{t("tag.fournisseur")}</button>
        {/* ⚠️ «+ etichetta» e' l'ULTIMA pastiglia della riga, e il campo per
            scriverla si apre solo premendola. Prima il campo stava sempre li'
            sotto, grande come la riga delle pastiglie: chiedeva di scrivere a
            tutti, anche a chi le tre etichette gia' pronte bastano — che e'
            quasi sempre. Il bottone resta in coda anche quando lo script
            aggiunge quelle gia' usate: e' il «e altro», e l'altro viene dopo. */}
        <button type="button" class="nc-tag nc-piu" id="nc-tag-piu">{t("home.noteTagAdd")}</button>
      </div>
      <div class="nc-new" id="nc-new" hidden>
        <input id="nc-tag-new" class="fld" type="text" maxlength="120" placeholder={t("home.noteTagNew")} />
        {/* ⚠️ Il bottone sta DENTRO il campo, non accanto: e' la chiusura di
            quello che si sta scrivendo li', non un comando a parte. Fuori,
            una riga di due cose chiedeva di scegliere fra due; dentro, e'
            evidente che finisce la frase cominciata nel campo. */}
        <button type="button" class="nc-ok" id="nc-tag-add" aria-label={t("common.add")}>+</button>
      </div>

      {/* ⚠️ Una DOMANDA con un interruttore, e i volti solo se la risposta e'
          si'. Qui c'era una casella «Personne» in testa alla griglia: faceva
          il suo lavoro, ma metteva «nessuno» in mezzo alle persone — una
          scelta che non e' una persona, disegnata come se lo fosse. E
          costringeva a guardare tutta la squadra anche quando la nota non e'
          di nessuno, che e' il caso piu' comune: una lavagnetta serve prima
          di tutto a dire una cosa a tutti.
          ⚠️ Spegnere l'interruttore TOGLIE l'assegnazione: e' cosi' che si
          disfa, e senza bisogno di una casella apposta. */}
      <div class="nc-ask">
        <label class="switch"><input type="checkbox" id="nc-chi-on" /><span class="track"></span></label>
        <span class="nc-ask-t">{t("home.noteAssignQ")}</span>
      </div>
      <div id="nc-chi" hidden></div>

      {/* ⚠️ I due pannelli compaiono con la LORO etichetta e non sono sempre
          li'. «Importante» e «Ricorrente» non sono due caselle in piu' da
          riempire: sono due scelte che, fatte, portano una domanda ciascuna —
          per quando, e ogni quanto. Mostrarle sempre vorrebbe dire chiedere a
          tutti due cose che riguardano una nota su dieci. */}
      <div class="nc-extra" id="nc-quando" hidden>
        <span class="f-label">{t("home.noteWhen")}</span>
        {/* ⚠️ Il CALENDARIO DEL MARCHIO, non il `datetime-local` del browser:
            quello cambia faccia su ogni sistema, non sa niente dei giorni di
            chiusura e scrive la data nel formato del computer. Il valore vero
            sta in `data-iso`, il testo e' solo per l'occhio (vedi
            lib/admin/datepicker.ts). La data e l'ora sono due campi perche'
            sono due scelte: il giorno si sceglie da un calendario, l'ora si
            scrive. */}
        <div class="nc-rip">
          <input id="nc-due" class="fld" type="text" readonly placeholder="--/--/----" />
          <input id="nc-due-ora" class="fld" type="time" value="12:00" />
        </div>
      </div>

      <div class="nc-extra" id="nc-ripeti" hidden>
        <span class="f-label">{t("home.noteEvery")}</span>
        <div class="nc-rip">
          <select id="nc-ogni" class="fld">
            <option value="giorno">{t("home.everyDay")}</option>
            <option value="settimana">{t("home.everyWeek")}</option>
            <option value="mese">{t("home.everyMonth")}</option>
            <option value="anno">{t("home.everyYear")}</option>
          </select>
          {/* ⚠️ I nomi dei giorni e dei mesi NON sono stringhe da tradurre: li
              riempie lo script con `Intl`, nella lingua dell'admin. Scritti a
              mano sarebbero diciannove chiavi per cinque lingue, cioe'
              novantacinque parole che il browser conosce gia'. */}
          <select id="nc-dow" class="fld" hidden></select>
          <select id="nc-dom" class="fld" hidden></select>
          <select id="nc-mese" class="fld" hidden></select>
          <input id="nc-ora" class="fld" type="time" value="09:00" />
        </div>
      </div>

      <Fragment slot="foot">
        <span class="notes-msg" id="notes-msg"></span>
        <button type="button" class="md-btn" data-md-close>{t("common.cancel")}</button>
        <button type="button" class="md-btn md-btn-primary" id="nc-save">{t("common.add")}</button>
      </Fragment>
    </Modal>

    <!-- Toast: componente condiviso (styles/toast.css, importato da AdminHead).
         Serve da quando la Accueil SCRIVE: cambiare lo stato di una
         prenotazione dalla fascia e' una PATCH, e una PATCH rifiutata deve
         dirlo — altrimenti la riga resta come l'hai lasciata e il database
         dice un'altra cosa. -->
    <div class="toast" id="toast"></div>

    <AdminNav current="home" />

    <!-- Dati SSR (Fase 2): 5 isole pre-caricate dal server, lette dal client. -->
    <script id="ssr-home" type="application/json" is:inline set:html={ssrHomeJson}></script>

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { authFresh } from "../../lib/admin/auth";
      import { collegaLogout } from "../../lib/admin/logout";
      import { nomeServizio } from "../../lib/reservationI18n";
      import { creaDatepicker } from "../../lib/admin/datepicker";
      import { descrivi } from "../../lib/admin/ricorrenzaRegole";
      import { assegnabili } from "../../lib/admin/teamRegole";
      import { iniziali, coloreDi } from "../../lib/admin/avatarRegole";
      import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";
      import { festivita, ricorrenze } from "../../lib/festivitaRegole";
      import {
        statoDi, voceStatoDi, HOLD_RIPIEGO, type ServizioHold, type StatoMostrato,
      } from "../../lib/admin/resaStato";
      import {
        copertiDelGiorno, daConfermare, daFare, riempimento,
      } from "../../lib/admin/resaConti";
      import {
        incassato, panierMedio, restaDaIncassare, righeIncassate, daServire, statoOrdine,
        piattiVeri,
      } from "../../lib/admin/ordiniConti";
      import { euroDa } from "../../lib/soldi";
      import {
        fuori as piattiFuori, conStato, conti as contiMenu, statoPiatto, etichettaFormati,
        type RigaMenu, type StatoPiatto,
      } from "../../lib/admin/menuRegole";
      import {
        conFiltro as fotoConFiltro, conti as contiFoto, usata as fotoUsata,
        famiglieDi, peso, type RigaFoto, type FiltroFoto, type Famiglia,
      } from "../../lib/admin/fotoRegole";
      import { caricaFoto } from "../../lib/admin/caricaFoto";
      import {
        PERIODI, periodoValido, istogramma, etichetteAsse, andamento, andamentoPosizione,
        type Periodo,
      } from "../../lib/admin/visibilitaRegole";
      import {
        PERIODI_R, PERIODO_R_DEFAULT, periodoValidoR, istogrammaSoldi, quotaResi, articoli,
        type PeriodoR,
      } from "../../lib/admin/recetteRegole";
      import {
        tagDi, inRitardo, etichette, conEtichetta, filtroValido,
        contoDelMese, chiLeFa, attesaPiuVecchia, daFare as noteDaFare,
      } from "../../lib/admin/noteRegole";
      import {
        fasce, statoGiorno, oreAperte, grafico, altezza, picco, quanto, oraDi,
        serviziDelGiorno, type Serie,
      } from "../../lib/admin/giornataRegole";
      import {
        fondi, conti, TIPI_FILTRO, piuGiorni,
        type Festa, type RigaSpeciale, type TipoRiga,
      } from "../../lib/admin/giorniSpecialiRegole";

      const LANG = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(LANG);
      const LOC = ADMIN_LOCALE[LANG] ?? "fr-BE";

      // ⚠️ Fuori da ogni IIFE, come chi lo chiama: `cambiaStatoResa` sta a
      // questo livello e leggeva un `headers` e un `toast` che vivevano dentro
      // la chiusura di sotto. Il controllo dei tipi l'ha detto; a pagina aperta
      // sarebbe stato un ReferenceError al primo cambio di stato, cioe' uno
      // stato che non si salva e nessun messaggio che spieghi perche'.
      const toastEl = document.getElementById("toast") as HTMLDivElement | null;
      let toastTimer: number | undefined;
      function toast(msg: string, errore = false) {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.className = "toast is-on" + (errore ? " is-error" : " is-ok");
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toastEl.classList.remove("is-on"), 2500);
      }

      type Item = { id: string; name: string; qty: number; price_cents: number; notes: string };
      /* ⚠️ `refunded_cents` e `supplement_due_cents` sono nella risposta
         dell'API da sempre (migrazioni #41 e #50) e nessuno li dichiarava: i
         soldi rimborsati restavano nell'incasso della giornata e i supplementi
         non pagati ci entravano. Un dato che arriva e non si legge e' il
         guasto piu' silenzioso che ci sia. */
      type Order = {
        id?: string;
        pickup_time: string;
        customer_name: string;
        items: Item[];
        total_cents: number;
        status: string;
        payment_method?: string | null;
        refunded_cents?: number | null;
        supplement_due_cents?: number | null;
      };
      type ResaRow = {
        /* ⚠️ `date`, `service_key` e `extra_minutes` non sono decorazione: sono
           cio' che serve a sapere se la prenotazione e' IN CORSO. Mancavano, e
           la pastiglia stampava `status` cosi' com'era. */
        id?: string; date?: string; heure: string; service_key?: string | null; extra_minutes?: number | null;
        first_name?: string; last_name?: string; people: number; status: string;
        zone?: string | null; phone?: string | null; email?: string | null; notes?: string | null;
        high_chair?: boolean; quiet?: boolean; business?: boolean; company?: string | null;
        birthday?: boolean; special_event?: boolean; tables?: unknown[] | null;
      };
      type Config = {
        lunch_active: boolean; lunch_open: string | null; lunch_close: string | null;
        dinner_active: boolean; dinner_open: string | null; dinner_close: string | null;
        prep_time_minutes: number; slot_duration_minutes: number;
      } | null;
      /* ⚠️ `image_url`, `price_cents` e `variants` arrivavano gia' nella
         risposta e non erano dichiarati: la tile mostrava due conteggi e
         quattro nomi, e il resto del piatto restava nella risposta senza che
         nessuno lo guardasse. */
      type MenuRow = RigaMenu & { id: string; category: string; available: boolean; name: string };
      type Cat = { name: string; kind: "food" | "drink" };
      type Note = { id: string; content: string; author: string | null; done: boolean; created_at: string; tags?: string[] | null;
        /** Quando e' stata spuntata (#78). Oggi non si legge ancora: la riga
         *  in fondo dice «3 fatte su 11», che si puo' dire anche sulle note
         *  di prima. Da quando ce ne saranno abbastanza con questa data,
         *  diventa «3 fatte questa settimana» — e cambia solo quella riga. */
        done_at?: string | null;
        /** Chi l'ha spuntata (#79). ⚠️ Non e' `author`: quello e' chi l'ha
         *  scritta, ed e' quasi sempre un'altra persona. */
        done_by?: string | null;
        /** A chi tocca (#81): l'id in `team` e il nome al momento. */
        assigned_to?: string | null;
        assigned_name?: string | null;
        /** Quando va fatta, e ogni quanto torna (#80). */
        due_at?: string | null;
        repeat?: { ogni?: string; ora?: string; dow?: number; dom?: number; mese?: number } | null };

      const CLOCK =
        '<svg class="clock" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><polyline points="12 7 12 12 15 14" /></svg>';
      const TRASH_ICON =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>';
      /**
       * I GIORNI IN CUI IL LOCALE E' CHIUSO — per segnarli sul calendario.
       *
       * Due sorgenti, e vanno tenute distinte:
       *   `chiusiSettimana`  i giorni della settimana senza nessun servizio
       *                      (dalla configurazione: 1 = lunedi', 7 = domenica)
       *   `chiusiSpeciali`   le date chiuse una volta sola (giorni speciali)
       *
       * ⚠️ Si riempiono quando i dati arrivano, e il calendario le CHIEDE a
       * ogni disegno. Passate per valore alla creazione sarebbero sempre
       * vuote: il calendario nasce col pannello, le chiusure arrivano da due
       * chiamate che finiscono dopo.
       */
      const chiusiSettimana = new Set<number>();
      const chiusiSpeciali = new Set<string>();
      /** Il calendario del marchio, uno per questa pagina. */
      const dp = creaDatepicker({
        loc: LOC,
        dow: tr("res.dowInitials").split(","),
        chiuso: (iso) => giornoChiuso(iso),
      });
      function giornoChiuso(iso: string): boolean {
        if (chiusiSpeciali.has(iso)) return true;
        // ⚠️ `T12:00` e non la data nuda: `new Date("2026-03-10")` e' mezzanotte
        // UTC, che in mezzo mondo e' ancora il giorno prima — e il calendario
        // segnerebbe chiuso il giorno sbagliato.
        const d = new Date(iso + "T12:00:00");
        return chiusiSettimana.has(((d.getDay() + 6) % 7) + 1);
      }

      const CHECK_ICON =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
      // La sveglia e il giro: due segni per due cose diverse — «entro quando»
      // e «ogni quanto». Lo stesso orologio per tutte e due avrebbe messo chi
      // guarda a leggere la frase per capire quale delle due e'.
      const ICO_SVEGLIA =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"/><polyline points="12 9 12 13 15 15"/><line x1="5" y1="3" x2="7.5" y2="5"/><line x1="19" y1="3" x2="16.5" y2="5"/></svg>';
      // «Tutte»: quattro caselle, cioe' l'insieme. ⚠️ Non una lente ne' un
      // imbuto: quelli dicono «cerca» e «filtra», e questo bottone fa
      // l'opposto — toglie il filtro.
      const ICO_TUTTE =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>';
      const ICO_RIPETI =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="17 2 21 6 17 10"/><path d="M3 12V10a4 4 0 0 1 4-4h14"/><polyline points="7 22 3 18 7 14"/><path d="M21 12v2a4 4 0 0 1-4 4H3"/></svg>';
      /** I nomi corti di giorni e mesi, dal browser: vedi `nomeGiorno`. */
      const nomeGiornoBreve = (dow: number) =>
        new Intl.DateTimeFormat(LOC, { weekday: "long" }).format(new Date(Date.UTC(2024, 0, 1 + ((dow - 1) % 7))));
      const nomeMeseBreve = (m: number) =>
        new Intl.DateTimeFormat(LOC, { month: "long" }).format(new Date(Date.UTC(2024, m - 1, 15)));

      function dayKey(d: Date): string {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, "0");
        const g = String(d.getDate()).padStart(2, "0");
        return `${y}-${m}-${g}`;
      }
      /** I soldi scritti: la riga sta in `lib/soldi.ts`, una per tutto il
       *  pannello. Era la stessa funzione in cinque pagine. */
      const euro = (cents: number): string => euroDa(cents, LOC);
      // Fuso del ristorante, esposto dall'header (data-tz)
      const TZ_LOCALE = (document.querySelector(".ah-header") as HTMLElement | null)?.dataset.tz || "Europe/Brussels";
      function oraDa(iso: string): string {
        return new Date(iso).toLocaleTimeString(LOC, { timeZone: TZ_LOCALE, hour: "2-digit", minute: "2-digit" });
      }
      function dayKeyBrussels(iso: string): string {
        return new Date(iso).toLocaleDateString("en-CA", { timeZone: TZ_LOCALE });
      }
      // ⚠️ Le stesse icone della pagina Réservations: le persone e il fumetto
      // della nota sono gia' i segni che il ristoratore associa a «quanti» e
      // «c'e' scritto qualcosa». Un disegno nuovo per la stessa cosa e' una
      // cosa nuova da imparare.
      const ICO_PERS = '<svg class="j-mi" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 20.5v-1.4a4 4 0 0 0-4-4h-5a4 4 0 0 0-4 4v1.4"/><circle cx="9" cy="7.5" r="3.2"/><path d="M21.5 20.5v-1.4a4 4 0 0 0-3-3.87"/><path d="M16.2 4.3a4 4 0 0 1 0 7.5"/></svg>';
      const ICO_NOTA = '<svg class="j-mi" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>';

      function escHtml(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }

      // ============================================================
      // LE RIGHE DELLA GIORNATA
      // ------------------------------------------------------------
      // ⚠️ Le pastiglie di stato sono quelle delle pagine Réservations e
      // Commandes, con le LORO parole: due nomi per lo stesso stato sono due
      // stati. Qui cambia solo la misura, perche' la riga e' meta' larga.
      // ⚠️ Sola lettura: niente bottoni. Si clicca la riga e si apre la
      // pagina che sa fare quel mestiere.
      // ============================================================
      /** ⚠️ `piattiVeri`: dentro `items` c'e' anche la riga finta della nota
       *  del cliente (`id: "note"`, `qty: 0`), e questa riga era l'unica del
       *  motore che non la saltava — l'elenco dei piatti cominciava con
       *  «0× NOTE CLIENT». */
      function piattiDi(items: Item[]): string {
        const voci = piattiVeri(items).map((i) => `${i.qty}× ${i.name}`);
        return voci.length > 3 ? voci.slice(0, 3).join(" · ") + " …" : voci.join(" · ");
      }
      /** ⚠️ IL GUASTO. L'ultima riga era un ripiego: OGNI stato che non fosse
       *  `done` o `pending` diventava «Payée» — un ordine annullato, o con uno
       *  stato nuovo, si leggeva «pagato». La stessa regola della pastiglia
       *  delle prenotazioni: stato ignoto, parola grezza.
       *
       *  ⚠️ E due `pending` molto diversi: uno aspetta che il cliente paghi un
       *  link, l'altro si incassa al banco al ritiro. Dire «À encaisser» per
       *  il primo manda qualcuno ad aspettare al banco dei soldi che devono
       *  arrivare da Internet. */
      function badgeOrdine(o: Order): string {
        const st = statoOrdine(o.status);
        if (st === "done") return `<span class="j-badge done">${tr("ord.terminee")}</span>`;
        if (st === "paid") return `<span class="j-badge pay">${tr("ord.paid")}</span>`;
        if (st === "pending") {
          const banco = String(o.payment_method ?? "") === "onsite";
          return `<span class="j-badge enc">${banco ? tr("ord.toCollect") : tr("ord.awaitingShort")}</span>`;
        }
        if (st === "cancelled") return `<span class="j-badge done">${tr("ord.annulee")}</span>`;
        return `<span class="j-badge done">${escHtml(String(o.status ?? ""))}</span>`;
      }
      function rigaOrdine(o: Order): string {
        return `<a class="j-li" href="/admin/orders">` +
          `<span class="h">${oraDa(o.pickup_time)}</span>` +
          `<span class="tx">${escHtml(String(o.customer_name ?? ""))}` +
          // ⚠️ Dentro uno `span`: la riga sotto il nome e' diventata una riga
          // flex per far stare l'icona accanto al testo, e un testo nudo
          // dentro un flex non si taglia coi puntini — si spezza a meta'.
          `<small><span>${escHtml(piattiDi(o.items))} · <b>${euro(o.total_cents)}</b></span></small></span>` +
          badgeOrdine(o) + `</a>`;
      }
      /** Gli stati, con le loro parole e i loro colori: gli stessi della pagina
       *  Réservations, perche' sono gli stessi stati. */
      const STATI_RESA: { st: string; cls: string; label: string; colore: string }[] = [
        { st: "pending", cls: "pd", label: tr("res.stPending"), colore: "var(--c-accent)" },
        { st: "confirmed", cls: "ok", label: tr("res.stConfirmed"), colore: "#2e9e6b" },
        { st: "seated", cls: "bl", label: tr("res.stSeated"), colore: "#3b82f6" },
        { st: "done", cls: "gr", label: tr("res.stDone"), colore: "var(--c-muted)" },
        { st: "cancelled", cls: "gr", label: tr("res.stCancelled"), colore: "#ed1c24" },
      ];
      /** ⚠️ Un BOTTONE, non un'etichetta: si clicca e si cambia stato senza
       *  cambiare pagina. `data-st-id` e' la prenotazione a cui appartiene. */
      /** L'ora del RISTORANTE, non del browser: il pannello si apre anche da
       *  casa o in viaggio, e «adesso», per una prenotazione, e' l'ora della
       *  sala. */
      function adessoResa(): { oggi: string; minuti: number } {
        const ora = new Date();
        const [h, m] = new Intl.DateTimeFormat("en-GB", {
          timeZone: TZ_LOCALE, hour: "2-digit", minute: "2-digit", hour12: false,
        }).format(ora).split(":");
        return {
          oggi: new Intl.DateTimeFormat("en-CA", { timeZone: TZ_LOCALE }).format(ora),
          minuti: Number(h) * 60 + Number(m),
        };
      }
      /** La durata dei tavoli, dalla configurazione del giorno. Senza, si
       *  userebbe il ripiego di 90 minuti per tutti — cioe' un «Fini ?» in
       *  anticipo in un servizio da due ore. */
      let resaServizi: ServizioHold[] = [];
      let resaHold = HOLD_RIPIEGO;
      /** Le parole delle pastiglie, compresa la domanda dell'orologio.
       *  ⚠️ Non sta dentro `STATI_RESA` perche' quello e' il MENU: «Fini ?» non
       *  e' uno stato che si possa scegliere, e in mezzo agli altri sarebbe un
       *  bottone che scrive nel database una parola che non esiste. */
      const PAROLE_STATO: Record<StatoMostrato, { cls: string; label: string }> = {
        pending: { cls: "pd", label: tr("res.stPending") },
        confirmed: { cls: "ok", label: tr("res.stConfirmed") },
        seated: { cls: "bl", label: tr("res.stSeated") },
        fini: { cls: "fin", label: tr("res.finiQ") },
        done: { cls: "gr", label: tr("res.stDone") },
        noshow: { cls: "gr", label: tr("res.stNoshow") },
        cancelled: { cls: "gr", label: tr("res.stCancelled") },
      };
      /** ⚠️ Un BOTTONE, non un'etichetta: si clicca e si cambia stato senza
       *  cambiare pagina. `data-st-id` e' la prenotazione a cui appartiene.
       *
       *  ⚠️ IL GUASTO (07/10/2026, visto su Educazione Napoletana). Qui si
       *  stampava `status` cosi' com'era: una confermata il cui tavolo e' in
       *  corso diceva «Confirmée» sulla Accueil e «En cours» nella pagina
       *  Réservations. Non erano due dati — era la stessa riga letta da due
       *  codici che non la pensavano uguale, e quello sbagliato stava sullo
       *  schermo che resta aperto tutta la sera. La regola adesso e' una sola
       *  e sta in `resaStato.ts`.
       *
       *  ⚠️ Uno stato IGNOTO stampa la sua parola grezza. Prima ricadeva su
       *  «Confirmée»: un'etichetta inventata e' peggio di una brutta — una
       *  annullata letta «confermata» e' un tavolo tenuto per nessuno. */
      function badgeResa(r: ResaRow): string {
        const ora = adessoResa();
        const sm = statoDi(
          {
            // Senza data, e' la riga di oggi: la colonna non ne carica altre.
            date: String(r.date ?? ora.oggi),
            heure: String(r.heure ?? ""),
            status: r.status,
            service_key: r.service_key ?? null,
            extra_minutes: r.extra_minutes ?? null,
          },
          ora, resaServizi, resaHold,
        );
        const v = sm ? PAROLE_STATO[sm] : undefined;
        const cls = v?.cls ?? "gr";
        const label = v?.label ?? String(r.status ?? "");
        return `<button type="button" class="j-badge ${cls} j-st" data-st-id="${escHtml(String(r.id ?? ""))}">${escHtml(label)}</button>`;
      }
      // ============================================================
      // LA COLONNA «MENU» — cosa non si puo' vendere adesso
      // ------------------------------------------------------------
      // ⚠️ Le regole (chi e' fuori, in che ordine, i formati finiti, i conti
      // del piede) stanno in `menuRegole.ts`: la pagina Menu disegna le stesse
      // cose, e due copie della stessa regola si dividono alla prima modifica.
      // ============================================================
      let menuRighe: MenuRow[] = [];
      /** Il filtro acceso. Vuoto = tutti quelli fuori. */
      let menuFiltro: StatoPiatto | "" = "";

      /** L'icona del posto vuoto: una foto che non c'e'. */
      const ICO_NOFOTO =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/>' +
        '<circle cx="8.5" cy="10" r="1.5"/><polyline points="21 16 15.5 10.5 7 19"/></svg>';

      /** La casella della foto. ⚠️ C'E' SEMPRE, anche vuota: nascosta, le
       *  righe ballerebbero da sinistra e un piatto senza foto sembrerebbe a
       *  posto — mentre sul sito e' quello che vende meno, ed e' lo stesso
       *  buco che conta il numero in fondo alla colonna.
       *  ⚠️ `onerror` toglie l'immagine rotta e lascia la casella: un link
       *  morto disegnerebbe l'icona grigia del browser, che non e' la nostra e
       *  non dice niente. */
      function fotoDi(r: MenuRow): string {
        const url = String(r.image_url ?? "").trim();
        if (!url) return `<span class="m-foto" title="${escHtml(tr("home.menuPhotoNone"))}">${ICO_NOFOTO}</span>`;
        return `<span class="m-foto"><img src="${escHtml(url)}" alt="" loading="lazy" ` +
          `referrerpolicy="no-referrer" onerror="this.remove()" /></span>`;
      }

      function rigaMenu(r: MenuRow): string {
        const st = statoPiatto(r);
        const badge = st === "hidden"
          ? `<span class="spx-b hid">${tr("print.hidden")}</span>`
          : `<span class="spx-b closed">${tr("menu.soldOut")}</span>`;
        // ⚠️ I FORMATI FINITI si dicono col loro nome. Con «40 cm» finita e
        // «30 cm» disponibile l'interruttore del piatto e' spento — e' del
        // piatto INTERO — e senza questa riga l'unico modo di saperlo era
        // aprire il modale nella pagina Menu.
        // La lingua: quella del pannello, perche' qui legge lo staff; se
        // quell'etichetta manca, il modulo ripiega sulla prima che c'e'.
        const formati = etichettaFormati(r, LANG);
        const prezzo = Number(r.price_cents);
        const sotto = [
          badge,
          String(r.category ?? "").trim() ? `<span>${escHtml(String(r.category))}</span>` : "",
          Number.isFinite(prezzo) ? `<span class="m-prezzo">${euro(prezzo)}</span>` : "",
          formati ? `<span class="m-var">${escHtml(formati)}</span>` : "",
        ].filter(Boolean).join("");
        /* ⚠️ L'INTERRUTTORE SOLO SUGLI ESAURITI, ed e' quello della pagina
           Menu (`.switch.sw-sold`), con lo stesso verso: acceso = esaurito.
           Un tocco a inizio servizio rimette il piatto in vendita senza aprire
           niente. Sui NASCOSTI non c'e': togliere un piatto dal sito e' una
           decisione che si prende con foto, descrizione e prezzo davanti, e la
           riga porta li'. */
        const sw = st === "sold"
          ? `<label class="switch sw-sold" title="${escHtml(tr("menu.soldOut"))}">` +
            `<input type="checkbox" data-menu-id="${escHtml(String(r.id ?? ""))}" checked />` +
            `<span class="track"></span></label>`
          : "";
        /* ⚠️ LA RIGA NON E' UN LINK, e l'unica cosa che si tocca e'
           l'interruttore. Nelle altre colonne la riga porta alla sua pagina
           perche' li' c'e' dell'altro da fare — leggere una prenotazione,
           aprire un ordine. Qui la cosa da fare e' UNA: rimettere in vendita.
           Un rettangolo largo che porta a una pagina qualsiasi del menu, con
           dentro il solo comando che serve, e' un bersaglio che si preme per
           sbaglio mentre si cerca la casella.
           ⚠️ E anche quando era un link, la casella stava fuori: su un
           `<button>` basta un `preventDefault()` per non far partire il link,
           ma su una CASELLA quello stesso `preventDefault()` annulla il cambio
           di stato — l'interruttore non si gira, `change` non parte, e il
           tocco non fa niente. Senza un errore da nessuna parte. */
        return `<div class="j-li${st === "hidden" ? " m-off" : ""}">` +
          fotoDi(r) +
          `<span class="tx"><span class="j-nome">${escHtml(String(r.name ?? ""))}</span>` +
          `<small>${sotto}</small></span>` +
          sw + `</div>`;
      }

      // ============================================================
      // LA COLONNA «VISIBILITÉ» — chi ci cerca su Google
      // ------------------------------------------------------------
      // ⚠️ IL GRAFICO E' QUELLO DELL'AFFLUENZA: stesse classi, stessa
      // `altezza()`, stesse linee della griglia. Un secondo grafico scritto da
      // zero nella stessa pagina sarebbe un secondo righello — e due barre
      // alte uguali in due colonne vorrebbero dire due cose diverse.
      //
      // ⚠️ OGNI PERIODO SI CHIEDE UNA VOLTA SOLA. La risposta si tiene qui:
      // premere «7 g» e tornare a «28 g» non deve rifare il giro fino a
      // Google, che e' lento e ha una quota giornaliera.
      // ============================================================
      type VisKpi = { clicks: number; impressions: number; position: number };
      type VisDett = {
        configured: boolean;
        periode: string;
        kpi: VisKpi & { prev: VisKpi };
        serie: { date: string; clicks: number; impressions: number }[];
        topQueries: { key: string; clicks: number; impressions: number }[];
      };
      let visPeriodo: Periodo = 28;
      const visCache = new Map<number, VisDett>();

      function disegnaVisFiltri(): void {
        const box = document.getElementById("j-vis-filtri");
        if (!box) return;
        box.innerHTML = PERIODI.map((g) =>
          `<button type="button" class="rh-filter${g === visPeriodo ? " is-on" : ""}" data-g="${g}">` +
          `<span class="et">${escHtml(tr("home.visDays").replace("{n}", String(g)))}</span></button>`).join("");
      }

      /** Un numero come lo scrive il pannello: con i separatori della lingua. */
      const nVis = (n: number): string => new Intl.NumberFormat(LOC).format(Math.round(Number(n) || 0));

      /** La riga sotto un numero: «▲ 18 %», verde o corallo, o niente. */
      function frecciaVis(id: string, a: { diff: number | null; meglio: boolean }, testo: string): void {
        const el = document.getElementById(id + "-d");
        if (!el) return;
        // ⚠️ Niente freccia quando non si puo' dire (il periodo prima era a
        // zero): una freccia verde messa per ripiego e' una buona notizia
        // inventata.
        el.textContent = a.diff === null ? "" : testo;
        el.classList.toggle("up", a.diff !== null && a.meglio);
        el.classList.toggle("giu", a.diff !== null && !a.meglio);
      }

      function disegnaVis(): void {
        disegnaVisFiltri();
        const v = visCache.get(visPeriodo);
        const lista = document.getElementById("j-vis-lista");
        const hm = document.getElementById("j-vis-box");
        const intest = document.getElementById("j-vis-h");
        const nums = document.getElementById("j-vis-nums");
        if (!lista) return;
        if (!v) {
          // Sta arrivando: non si scrive «nessun dato», che e' un'altra cosa.
          lista.innerHTML = "";
          return;
        }
        if (nums) nums.style.display = "";

        // ---- I tre numeri, col confronto sul periodo precedente ----
        const cl = andamento(v.kpi.clicks, v.kpi.prev.clicks);
        const im = andamento(v.kpi.impressions, v.kpi.prev.impressions);
        const po = andamentoPosizione(v.kpi.position, v.kpi.prev.position);
        numero("j-vis-clic", nVis(v.kpi.clicks), "");
        frecciaVis("j-vis-clic", cl, `${cl.meglio ? "▲" : "▼"} ${Math.abs(cl.diff ?? 0)} %`);
        numero("j-vis-imp", nVis(v.kpi.impressions), "");
        frecciaVis("j-vis-imp", im, `${im.meglio ? "▲" : "▼"} ${Math.abs(im.diff ?? 0)} %`);
        // ⚠️ La posizione si scrive com'e' (12,4) e la variazione in POSTI:
        // «+18 %» su una posizione media non vuol dire niente a nessuno. E la
        // freccia e' girata: da 14,2 a 12,4 si e' SALITI.
        numero("j-vis-pos", v.kpi.position > 0 ? nVis(Math.round(v.kpi.position * 10) / 10) : "—", "");
        frecciaVis("j-vis-pos", po,
          `${po.meglio ? "▲" : "▼"} ${tr("home.visSpots").replace("{n}", String(Math.abs(po.posti ?? 0)).replace(".", ","))}`);

        // ---- Il grafico, col righello dell'affluenza ----
        const g = istogramma(v.serie);
        const plot = document.getElementById("j-vis-plot");
        const assi = document.getElementById("j-vis-x");
        if (hm && plot && assi && g) {
          hm.style.display = "";
          const griglia =
            `<div class="j-grid" aria-hidden="true">` +
            `<i class="base"></i>` +
            `<i style="bottom:${altezza(g.cima, g.cima)}%"><b>${g.cima}</b></i>` +
            `</div>`;
          plot.innerHTML = g.barre
            .map((b, i) =>
              `<div class="j-hb"><span class="vis${i === g.barre.length - 1 ? " oggi" : ""}" ` +
              `style="height:${altezza(b.valore, g.cima)}%" title="${escHtml(`${b.iso} · ${b.valore}`)}"></span></div>`)
            .join("") + griglia;
          // ⚠️ LE DATE VERE SOTTO IL GRAFICO, e non «28 giorni»: Google ha
          // circa tre giorni di ritardo, quindi l'ultima barra NON e' oggi — e
          // chi guarda deve poterlo vedere invece di crederlo.
          // Quali barre la portano lo decide `etichetteAsse` (una regola, con
          // i suoi test): due date sole non dicevano DOVE si e' alzato il
          // grafico, e una per barra sarebbe una riga grigia.
          // ⚠️ L'ultima scrive `g.a`, cioe' l'ULTIMO GIORNO VERO: a settimane
          // raggruppate `b.iso` e' il lunedi' di quel gruppo, e sotto l'ultima
          // barra si leggerebbe una data piu' vecchia di quella che i dati
          // arrivano — che e' proprio il numero che quel piede deve dire.
          const ultimo = g.barre.length - 1;
          const segnate = new Set(etichetteAsse(g.barre.length));
          assi.innerHTML = g.barre
            .map((b, i) => {
              if (!segnate.has(i)) return "<span></span>";
              // Agli estremi la data si appoggia al bordo del grafico: centrata
              // sulla sua barra sporgerebbe fuori dal riquadro.
              const dove = i === 0 ? "left" : i === ultimo ? "right" : "center";
              return `<span style="text-align:${dove}">${escHtml(dataCorta(i === ultimo ? g.a : b.iso))}</span>`;
            })
            .join("");
          // Il piede: di che passo sono le barre (un giorno o una settimana —
          // a novanta giorni si raggruppa, e senza scritto si legge un crollo
          // dove c'e' solo una barra che conta sette giorni invece di uno) e
          // fino a quando arrivano i dati di Google.
          const passo = document.getElementById("j-vis-passo");
          if (passo) passo.textContent = tr(g.passo === "settimana" ? "home.visPerWeek" : "home.visPerDay");
          const vsrc = document.getElementById("j-vis-src");
          if (vsrc) vsrc.textContent = `Search Console · ${tr("home.visUpTo").replace("{d}", dataCorta(g.a))}`;
        } else if (hm) {
          hm.style.display = "none";
        }

        // ---- Le parole cercate ----
        if (intest) intest.style.display = v.topQueries.length ? "" : "none";
        lista.innerHTML = v.topQueries.length
          ? v.topQueries.map((q) =>
              `<div class="j-li j-vq"><span class="q">${escHtml(q.key)}</span>` +
              `<span class="imp">${escHtml(nVis(q.impressions))}</span>` +
              `<span class="n">${escHtml(nVis(q.clicks))}</span></div>`).join("")
          : `<p class="j-vuoto">${tr("home.visNoData")}</p>`;
      }

      /** «11 sett.» — la data corta, nella lingua del pannello. */
      function dataCorta(iso: string): string {
        const t = Date.parse(`${iso}T12:00:00Z`);
        return Number.isFinite(t)
          ? new Date(t).toLocaleDateString(LOC, { day: "numeric", month: "short" })
          : "";
      }

      async function caricaVis(giorni: Periodo): Promise<void> {
        if (visCache.has(giorni)) { disegnaVis(); return; }
        try {
          const res = await fetch(`/api/admin/search-console?detail=1&days=${giorni}`, {
            headers: await authFresh(),
          });
          if (!res.ok) return;
          const v = (await res.json()) as VisDett;
          // ⚠️ Senza proprieta' configurata la colonna NON si accende: a un
          // locale che non ha Search Console una colonna vuota non dice
          // niente, e non si puo' nemmeno riempire da qui.
          if (!v?.configured) return;
          visCache.set(giorni, v);
          const col = document.getElementById("j-vis");
          if (col) col.style.display = "";
          disegnaVis();
        } catch { /* rete assente: la colonna resta spenta */ }
      }

      document.getElementById("j-vis-filtri")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest(".rh-filter") as HTMLElement | null;
        if (!b) return;
        visPeriodo = periodoValido(b.dataset.g);
        disegnaVis();
        void caricaVis(visPeriodo);
      });

      // ============================================================
      // LA COLONNA «RECETTES» — quanto e' entrato, quanto e' tornato indietro
      // ------------------------------------------------------------
      // ⚠️ QUI NON SI SOMMA NIENTE. I totali arrivano gia' fatti da
      // `/api/admin/stats`, cioe' da `calcolaStats`: la stessa funzione che
      // riempie la pagina Statistiques, che a sua volta chiede a
      // `ordiniConti` cosa vuol dire «entrato» e «rimborsato». La parola
      // «incassato» ha gia' avuto quattro definizioni in questo progetto e
      // quattro numeri diversi sullo stesso schermo: la quinta non la
      // scriviamo qui.
      //
      // ⚠️ OGNI PERIODO SI CHIEDE UNA VOLTA SOLA, come in Visibilité: la
      // risposta si tiene, e tornare indietro fra «Mese» e «Settimana» non
      // rifa' il giro fino al database.
      // ============================================================
      type RecSerie = { label: string; count: number; cents: number; refund_cents: number };
      type RecDett = {
        period: string;
        orders: number;
        revenue_cents: number;
        refunded_cents?: number;
        refunded_orders?: number;
        avg_cents: number;
        prev?: { orders: number; revenue_cents: number; refunded_cents: number } | null;
        series_kind: string;
        series: RecSerie[];
        top: { name: string; qty: number; cents: number }[];
      };
      let recPeriodo: PeriodoR = PERIODO_R_DEFAULT;
      const recCache = new Map<string, RecDett>();

      /** Le etichette dei periodi sono quelle della pagina Statistiques: le
       *  stesse parole per la stessa cosa, e nessuna chiave nuova. */
      const REC_ET: Record<PeriodoR, string> = {
        day: "st.pDay", week: "res.week", month: "res.month", ytd: "st.pYear",
      };

      function disegnaRecFiltri(): void {
        const box = document.getElementById("j-rec-filtri");
        if (!box) return;
        box.innerHTML = PERIODI_R.map((p) =>
          `<button type="button" class="rh-filter${p === recPeriodo ? " is-on" : ""}" data-p="${p}">` +
          `<span class="et">${escHtml(tr(REC_ET[p]))}</span></button>`).join("");
      }

      function disegnaRec(): void {
        disegnaRecFiltri();
        const v = recCache.get(recPeriodo);
        const lista = document.getElementById("j-rec-lista");
        if (!lista) return;
        if (!v) { lista.innerHTML = ""; return; }

        const box = document.getElementById("j-rec-box");
        const nums = document.getElementById("j-rec-nums");
        if (nums) nums.style.display = "";

        // ---- Il totale, e com'e' andata rispetto al periodo di prima ----
        // ⚠️ Il confronto e' con la stessa FETTA di tempo gia' passata (lo
        // taglia `calcolaStats`): alle tre del pomeriggio, «oggi» contro
        // «ieri intero» direbbe ogni giorno che stiamo crollando.
        const resi = Number(v.refunded_cents ?? 0);
        const tot = document.getElementById("j-rec-tot");
        if (tot) tot.textContent = euro(v.revenue_cents);
        const a = andamento(v.revenue_cents, v.prev?.revenue_cents);
        const td = document.getElementById("j-rec-tot-d");
        if (td) {
          td.textContent = a.diff === null ? "" : `${a.meglio ? "▲" : "▼"} ${Math.abs(a.diff)} %`;
          td.classList.toggle("up", a.diff !== null && a.meglio);
          td.classList.toggle("giu", a.diff !== null && !a.meglio);
        }
        const per = document.getElementById("j-rec-per");
        if (per) per.textContent = tr(REC_ET[recPeriodo]);

        // ---- I resi: la riga tace quando non ce ne sono ----
        const rb = document.getElementById("j-rec-rb");
        if (rb) {
          const quota = quotaResi(v.revenue_cents, resi);
          rb.innerHTML = resi > 0
            ? `${escHtml(tr("home.recRefunded"))} <b>−${escHtml(euro(resi))}</b> ` +
              `<span>· ${escHtml(tr("home.nOrders").replace("{n}", String(v.refunded_orders ?? 0)))}` +
              `${quota === null ? "" : ` · ${quota} %`}</span>`
            : "";
        }

        // ---- Il grafico: due serie, lo stesso righello della fascia ----
        const g = istogrammaSoldi(v.series);
        const plot = document.getElementById("j-rec-plot");
        const assi = document.getElementById("j-rec-x");
        if (box && plot && assi && g) {
          box.style.display = "";
          const griglia =
            `<div class="j-grid" aria-hidden="true">` +
            `<i class="base"></i>` +
            `<i style="bottom:${altezza(g.cima, g.cima)}%"><b>${escHtml(euro(g.cima))}</b></i>` +
            `</div>`;
          plot.innerHTML = g.barre
            .map((b) =>
              `<div class="j-hb" title="${escHtml(`${b.label} · ${euro(b.inc)}`)}">` +
                `<span class="inc" style="height:${altezza(b.inc, g.cima)}%"></span>` +
                `<span class="rb" style="height:${altezza(b.rb, g.cima)}%"></span>` +
              `</div>`)
            .join("") + griglia;
          // Le etichette dell'asse: la stessa regola della colonna Visibilité
          // — poche, leggibili, e la prima e l'ultima sempre.
          const ultimo = g.barre.length - 1;
          const segnate = new Set(etichetteAsse(g.barre.length));
          assi.innerHTML = g.barre
            .map((b, i) => {
              if (!segnate.has(i)) return "<span></span>";
              const dove = i === 0 ? "left" : i === ultimo ? "right" : "center";
              return `<span style="text-align:${dove}">${escHtml(b.label)}</span>`;
            })
            .join("");
          // Il colore dei resi si nomina solo se ce ne sono.
          const kRb = document.getElementById("j-rec-k-rb");
          if (kRb) kRb.style.display = g.conResi ? "" : "none";
          // ⚠️ Solo i passi che hanno una parola: `tr()` di una chiave che non
          // esiste rende LA CHIAVE, cioe' scriverebbe «home.recStep.xyz» sotto
          // il grafico il giorno in cui il server impara un intervallo nuovo.
          const passo = document.getElementById("j-rec-passo");
          const PASSI = ["hour", "weekday", "day", "month", "quarter"];
          if (passo) passo.textContent = PASSI.includes(String(v.series_kind))
            ? tr(`home.recStep.${v.series_kind}`)
            : "";
        } else if (box) {
          box.style.display = "none";
        }

        // ---- Gli articoli piu' ordinati ----
        const art = articoli(v.top, 6);
        const intest = document.getElementById("j-rec-h");
        if (intest) intest.style.display = art.length ? "" : "none";
        lista.innerHTML = art.length
          ? art.map((x, i) =>
              `<div class="j-li j-art"><span class="pos">${i + 1}</span>` +
              `<span class="q">${escHtml(x.name)}</span>` +
              `<span class="qty">×${escHtml(nVis(x.qty))}</span>` +
              `<span class="eur">${escHtml(euro(x.cents))}</span></div>`).join("")
          : `<p class="j-vuoto">${escHtml(tr("home.recNone"))}</p>`;

        // ---- I tre numeri in fondo ----
        // ⚠️ Lo scontrino medio arriva gia' fatto: dividere qui `revenue` per
        // `orders` sarebbe il quinto conto dei soldi, e con l'arrotondamento
        // darebbe un centesimo diverso dalla pagina Statistiques.
        numero("j-rec-avg", euro(v.avg_cents), "");
        frecciaVis("j-rec-avg", andamento(v.avg_cents, scontrinoPrima(v)),
          scontrinoFreccia(v));
        numero("j-rec-ord", nVis(v.orders), "");
        const ao = andamento(v.orders, v.prev?.orders);
        frecciaVis("j-rec-ord", ao, `${ao.meglio ? "▲" : "▼"} ${Math.abs(ao.diff ?? 0)} %`);
        numero("j-rec-rbt", resi > 0 ? euro(resi) : "—", "");
        const rbd = document.getElementById("j-rec-rbt-d");
        if (rbd) rbd.textContent = resi > 0
          ? tr("home.nOrders").replace("{n}", String(v.refunded_orders ?? 0))
          : "";
      }

      /** Lo scontrino medio del periodo di prima, o `undefined` se non c'e' un
       *  prima: `andamento()` dice gia' «niente freccia» quando manca. */
      function scontrinoPrima(v: RecDett): number | undefined {
        const p = v.prev;
        return p && p.orders > 0 ? Math.round(p.revenue_cents / p.orders) : undefined;
      }
      function scontrinoFreccia(v: RecDett): string {
        const a = andamento(v.avg_cents, scontrinoPrima(v));
        return `${a.meglio ? "▲" : "▼"} ${Math.abs(a.diff ?? 0)} %`;
      }

      async function caricaRec(p: PeriodoR): Promise<void> {
        // ⚠️ SI CHIEDE SOLO SE LA COLONNA C'E'. Il server non la disegna a chi
        // non puo' vedere il fatturato, e AdminNav la rimuove coi permessi
        // veri quando la pagina e' arrivata senza SSR: in tutti e due i casi
        // questo elemento non esiste, e senza questa riga il codice chiederebbe
        // lo stesso `/api/admin/stats` — un 403 in console a ogni caricamento,
        // per una colonna che non si vede nemmeno.
        if (!document.getElementById("j-rec")) return;
        if (recCache.has(p)) { disegnaRec(); return; }
        try {
          const res = await fetch(`/api/admin/stats?period=${p}`, { headers: await authFresh() });
          if (!res.ok) return;
          const v = (await res.json()) as RecDett;
          if (!v || typeof v.revenue_cents !== "number") return;
          recCache.set(p, v);
          const col = document.getElementById("j-rec");
          if (col) col.style.display = "";
          disegnaRec();
        } catch { /* rete assente: la colonna resta spenta */ }
      }

      document.getElementById("j-rec-filtri")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest(".rh-filter") as HTMLElement | null;
        if (!b) return;
        recPeriodo = periodoValidoR(b.dataset.p);
        disegnaRec();
        void caricaRec(recPeriodo);
      });

      // ============================================================
      // LA COLONNA «PHOTOS» — cosa e' entrato, e cosa non serve a niente
      // ------------------------------------------------------------
      // ⚠️ `used_by` ARRIVAVA GIA' NELLA RISPOSTA e nessuno lo leggeva: la
      // tile mostrava le ultime otto miniature, e quali foto non le usasse
      // nessuno — le uniche che si possono cancellare — si scopriva solo
      // aprendo la pagina Assets e guardando le card una per una.
      // ============================================================
      type FotoRow = RigaFoto & { bucket: string; name: string; url: string };
      let fotoTutte: FotoRow[] = [];
      let fotoFiltro: FiltroFoto = "";

      /** I nomi delle famiglie, quelli del pannello: «Menu» e «Marketing» sono
       *  le voci della barra, «Site» e' la linguetta della pagina Assets. */
      const NOME_FAMIGLIA: Record<Famiglia, string> = {
        menu: tr("nav.menu"),
        marketing: tr("nav.marketing"),
        site: tr("as.site"),
      };

      function cellaFoto(f: FotoRow): string {
        const libera = !fotoUsata(f);
        // ⚠️ Il titolo porta il nome E dove e' usata: e' l'informazione che
        // la griglia non puo' mostrare e che la libreria nascondeva.
        const dove = (f.used_by ?? []).join(" · ");
        const titolo = [String(f.name ?? ""), dove || tr("as.free")].filter(Boolean).join(" · ");
        /* ⚠️ IL CESTINO SOLO SULLE LIBERE, e sempre in vista, in alto a
           destra. La pagina Assets rifiuta di cancellare una foto usata
           (risponde 409 con l'elenco di chi la mostra): un cestino che si puo'
           premere e risponde «no» e' un bottone che insegna a non fidarsi dei
           bottoni.
           ⚠️ SEMPRE VISIBILE e non «al passaggio del dito»: su un tablet
           appeso in sala non esiste un passaggio del dito, e un comando che si
           scopre solo col mouse e' un comando che meta' delle persone non
           trova mai. */
        const cestino = libera
          ? `<button type="button" class="ibtn ibtn-sm ibtn-danger ph-del" ` +
            `data-b="${escHtml(String(f.bucket ?? ""))}" data-n="${escHtml(String(f.name ?? ""))}" ` +
            `title="${escHtml(tr("common.delete"))}" aria-label="${escHtml(tr("common.delete"))}">${TRASH_ICON}</button>`
          : "";
        /* ⚠️ LA CELLA NON E' UN LINK: l'unica cosa che si tocca e' il
           cestino. Un quadrato grande che porta alla pagina Assets, con dentro
           il solo comando che serve, e' un bersaglio che si preme per sbaglio
           mentre si cerca il cestino — e per andare alla libreria c'e' «Voir
           tout» in testa alla colonna, dove sta in tutte le altre.
           ⚠️ Il NOME e DOVE E' USATA restano nel titolo: e' l'informazione che
           una griglia non puo' mostrare, ed e' quella che la libreria
           nascondeva. */
        /* ⚠️ LE PASTIGLIE DICONO A COSA SERVE la foto: Menu, Marketing, Site.
           Una foto puo' averne due — la stessa immagine su un piatto e in un
           pop-up — e si leggono tutte, in ordine fisso. «Libre» non e' una
           famiglia: e' quello che resta quando non ce n'e' nessuna, ed e'
           l'unica rossa perche' e' l'unica che chiede di fare qualcosa.
           ⚠️ La parola «Libre» e' `as.freeSg`, quella che la pagina Assets usa
           gia' sulla sua card: due parole per la stessa cosa sarebbero due
           cose. */
        const fam = famiglieDi(f)
          .map((x) => `<span class="ph-t ph-${x}">${escHtml(NOME_FAMIGLIA[x])}</span>`)
          .join("");
        return `<div class="ph-cell" title="${escHtml(titolo)}">` +
          `<img src="${escHtml(String(f.url ?? ""))}" alt="" loading="lazy" ` +
          `onerror="this.closest('.ph-cell')?.classList.add('rotta'); this.remove()" />` +
          `<span class="ph-tags">${fam}` +
          (libera ? `<span class="ph-b">${escHtml(tr("as.freeSg"))}</span>` : "") +
          `</span>` + cestino + `</div>`;
      }

      function disegnaFotoFiltri(): void {
        const box = document.getElementById("j-foto-filtri");
        if (!box) return;
        // Fissi, come nelle altre colonne. ⚠️ «Menu» e «Marketing» vengono
        // dall'USO della foto, non dalla cartella in cui sta: lo decide l'API.
        const voci: { f: FiltroFoto; testo: string; ico?: string }[] = [
          { f: "", testo: tr("home.notesAll"), ico: ICO_TUTTE },
          { f: "site", testo: NOME_FAMIGLIA.site },
          { f: "menu", testo: NOME_FAMIGLIA.menu },
          { f: "marketing", testo: NOME_FAMIGLIA.marketing },
          { f: "libere", testo: tr("as.free") },
        ];
        box.innerHTML = voci.map((v) =>
          `<button type="button" class="rh-filter${v.ico ? " tutte" : ""}${v.f === fotoFiltro ? " is-on" : ""}"` +
          ` data-f="${escHtml(v.f)}"${v.ico ? ` aria-label="${escHtml(v.testo)}" title="${escHtml(v.testo)}"` : ""}>` +
          `${v.ico ?? ""}<span class="et">${escHtml(v.testo)}</span></button>`).join("");
      }

      function disegnaFoto(): void {
        disegnaFotoFiltri();
        const oggiK = dayKeyBrussels(new Date().toISOString());
        const c = contiFoto(fotoTutte, oggiK, dayKeyBrussels);
        // La pastiglia conta le LIBERE: e' quello che c'e' da guardare.
        pastigliaConta("j-foto-cnt", c.libere);
        numero("j-foto-tot", String(c.totale),
          c.settimana ? tr("home.phWeek").replace("{n}", String(c.settimana)) : "");
        // ⚠️ Un trattino e non «0»: zero foto libere e' una buona notizia, e in
        // corallo grande sembrerebbe un allarme.
        numero("j-foto-libere", c.libere ? String(c.libere) : "—",
          c.totale ? tr("home.menuOfN").replace("{n}", String(c.totale)) : "");
        numero("j-foto-peso", peso(c.byte, tr("as.kb"), tr("as.mb")) || "—",
          c.media ? tr("home.phEach").replace("{n}", peso(c.media, tr("as.kb"), tr("as.mb"))) : "");
        const lista = document.getElementById("j-foto-lista");
        if (!lista) return;
        const viste = fotoConFiltro(fotoTutte, fotoFiltro);
        // Due vuoti diversi: «non ce n'e' nessuna» e «nessuna di queste».
        lista.innerHTML = viste.length
          ? `<div class="ph-grid">${viste.map((f) => cellaFoto(f)).join("")}</div>`
          : `<div class="ph-grid"><div class="ph-empty">${
              fotoFiltro ? tr("home.nothingToShow") : tr("home.noImages")}</div></div>`;
      }

      document.getElementById("j-foto-filtri")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest(".rh-filter") as HTMLElement | null;
        if (!b) return;
        fotoFiltro = (b.dataset.f ?? "") as FiltroFoto;
        disegnaFoto();
      });

      /** Il cestino di una foto libera: due tocchi, come ovunque nel pannello. */
      document.getElementById("j-foto-lista")?.addEventListener("click", (ev) => {
        const del = (ev.target as HTMLElement).closest(".ph-del") as HTMLButtonElement | null;
        if (!del) return;
        if (!del.classList.contains("confirm")) {
          del.classList.add("confirm");
          del.textContent = tr("home.deleteQ");
          window.setTimeout(() => { del.classList.remove("confirm"); del.innerHTML = TRASH_ICON; }, 3000);
          return;
        }
        void cancellaFoto(del);
      });

      /** Rilegge la bibliotheque e ridisegna. ⚠️ Si RICHIEDE invece di
       *  aggiungere la riga a mano: la risposta del caricamento porta il solo
       *  URL, mentre la colonna ha bisogno anche del peso, della data e di chi
       *  la usa — inventarli vorrebbe dire una miniatura con «0 Ko» che si
       *  corregge da sola al prossimo caricamento della pagina. */
      async function rileggiFoto(): Promise<void> {
        try {
          const res = await fetch("/api/admin/images", { headers: await authFresh() });
          if (!res.ok) return;
          fotoTutte = (((await res.json()) as { images?: FotoRow[] }).images) ?? [];
          disegnaFoto();
        } catch { /* la colonna resta com'era: nessun dato inventato */ }
      }

      /** «+ Image»: il bottone apre il campo nascosto, il campo fa il lavoro.
       *  ⚠️ IL GESTO sta in `caricaFoto.ts`, lo stesso della pagina Assets —
       *  comprime, controlla il peso PRIMA di spedire, e spedisce. Scritto due
       *  volte, una delle due copie prima o poi dimentica un controllo: quello
       *  del peso soprattutto, che il server rifiuterebbe comunque ma dopo
       *  quattro mega in salita da un telefono in sala. */
      (() => {
        const btn = document.getElementById("j-foto-add") as HTMLButtonElement | null;
        const campo = document.getElementById("j-foto-file") as HTMLInputElement | null;
        if (!btn || !campo) return;
        btn.addEventListener("click", () => campo.click());
        campo.addEventListener("change", async () => {
          const file = campo.files?.[0];
          if (!file) return;
          btn.disabled = true;
          const esito = await caricaFoto(file, { headers: await authFresh() });
          if (esito.ok) {
            toast(`${tr("as.imgAdded")} ✓`);
            await rileggiFoto();
          } else {
            // Il motivo lo decide il modulo, la parola questa pagina: «troppo
            // pesante» e «illeggibile» mandano a fare due cose diverse.
            const parola = esito.motivo === "grande" ? tr("as.tooBig4")
              : esito.motivo === "illeggibile" ? tr("as.fileUnreadable")
                : (esito.dettaglio || tr("as.uploadFailed"));
            toast(parola, true);
          }
          btn.disabled = false;
          // ⚠️ Si svuota SEMPRE: senza, ricaricare la stessa foto dopo un
          // errore non fa scattare `change` — il valore non cambia — e il
          // bottone sembra rotto.
          campo.value = "";
        });
      })();

      async function cancellaFoto(btn: HTMLButtonElement): Promise<void> {
        const bucket = btn.dataset.b ?? "";
        const nome = btn.dataset.n ?? "";
        if (!bucket || !nome) return;
        btn.disabled = true;
        try {
          // ⚠️ LA STESSA CHIAMATA della pagina Assets, che rifiuta (409) una
          // foto usata da qualcuno: il controllo sta sul server, e questo
          // cestino non ne inventa un secondo.
          const res = await fetch(
            `/api/admin/images?bucket=${encodeURIComponent(bucket)}&name=${encodeURIComponent(nome)}`,
            { method: "DELETE", headers: await authFresh() },
          );
          if (!res.ok) throw new Error();
          fotoTutte = fotoTutte.filter((f) => !(f.bucket === bucket && f.name === nome));
          disegnaFoto();
        } catch {
          btn.disabled = false;
          btn.classList.remove("confirm");
          btn.innerHTML = TRASH_ICON;
          toast(tr("us.editErr"), true);
        }
      }

      function disegnaMenuFiltri(): void {
        const box = document.getElementById("j-menu-filtri");
        if (!box) return;
        // ⚠️ Fissi, come nei giorni speciali: tre posti che si imparano una
        // volta. Una colonna vuota lo dice con la sua frase.
        const voci: { f: StatoPiatto | ""; testo: string; ico?: string }[] = [
          { f: "", testo: tr("home.menuAll"), ico: ICO_TUTTE },
          { f: "sold", testo: tr("home.menuSold") },
          { f: "hidden", testo: tr("home.menuHidden") },
        ];
        box.innerHTML = voci.map((v) =>
          `<button type="button" class="rh-filter${v.ico ? " tutte" : ""}${v.f === menuFiltro ? " is-on" : ""}"` +
          ` data-f="${escHtml(v.f)}"${v.ico ? ` aria-label="${escHtml(v.testo)}" title="${escHtml(v.testo)}"` : ""}>` +
          `${v.ico ?? ""}<span class="et">${escHtml(v.testo)}</span></button>`).join("");
      }

      function disegnaMenu(): void {
        disegnaMenuFiltri();
        const lista = document.getElementById("j-menu-lista");
        const tuttiFuori = piattiFuori(menuRighe);
        // ⚠️ La pastiglia conta TUTTI i fuori, non quelli del filtro: e' il
        // numero della colonna, e cambiarlo premendo un filtro la' sopra
        // vorrebbe dire un numero di cui non ci si fida piu'.
        pastigliaConta("j-menu-cnt", tuttiFuori.length);
        if (!lista) return;
        const viste = conStato(menuRighe, menuFiltro);
        // Due vuoti diversi: «e' tutto online» e «nessuno di questi».
        lista.innerHTML = viste.length
          ? viste.map((r) => rigaMenu(r)).join("")
          : `<p class="j-vuoto">${menuFiltro ? tr("home.nothingToShow") : tr("home.menuOnline")}</p>`;
      }

      document.getElementById("j-menu-filtri")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest(".rh-filter") as HTMLElement | null;
        if (!b) return;
        menuFiltro = (b.dataset.f ?? "") as StatoPiatto | "";
        disegnaMenu();
      });

      /** Rimette in vendita un piatto esaurito.
       *  ⚠️ LA STESSA CHIAMATA della pagina Menu (`PUT /api/admin/menu` con
       *  `{ id, sold_out }`): un secondo modo di dire «non e' finito» sarebbe
       *  un secondo posto in cui ricordarsi le regole della sede. */
      document.getElementById("j-menu-lista")?.addEventListener("change", async (ev) => {
        const el = (ev.target as HTMLElement).closest<HTMLInputElement>("input[data-menu-id]");
        if (!el) return;
        const id = el.dataset.menuId ?? "";
        const finito = el.checked;
        el.disabled = true;
        try {
          const res = await fetch("/api/admin/menu", {
            method: "PUT",
            headers: await authFresh({ "Content-Type": "application/json" }),
            body: JSON.stringify({ id, sold_out: finito }),
          });
          if (!res.ok) throw new Error();
          const r = menuRighe.find((x) => String(x.id ?? "") === id);
          if (r) r.sold_out = finito;
          // Il piatto esce dall'elenco: non e' piu' fuori. La pastiglia e i
          // numeri si rifanno con lui.
          disegnaMenu();
        } catch {
          // ⚠️ L'interruttore torna com'era: lasciarlo girato direbbe che il
          // piatto e' tornato in vendita mentre il sito lo mostra barrato.
          el.checked = !finito;
          el.disabled = false;
          toast(tr("us.editErr"), true);
        }
      });

      /** I tavoli di una prenotazione, COL LORO NOME. `tables` porta gli id, e
       *  un id non dice niente a chi lavora: in sala il tavolo si chiama «3».
       *  Senza piano sala (mappa vuota) non si scrive niente — meglio tacere
       *  che mostrare un numero che non e' quello scritto sul tavolo. */
      let tavoliNomi: Record<string, string> = {};
      function tavoliDi(r: ResaRow): string {
        if (!Array.isArray(r.tables) || !r.tables.length) return "";
        const nomi = r.tables.map((id) => tavoliNomi[String(id)] ?? "").filter(Boolean);
        if (!nomi.length) return "";
        return nomi.length > 3 ? nomi.slice(0, 3).join("+") + " …" : nomi.join("+");
      }
      /** Le occasioni che cambiano il modo di accogliere: una parola ciascuna. */
      function occasioniDi(r: ResaRow): string[] {
        const o: string[] = [];
        if (r.birthday) o.push(tr("res.optBirthday"));
        if (r.special_event) o.push(tr("res.optEventShort"));
        if (r.business) o.push(tr("res.optBusiness"));
        if (r.high_chair) o.push(tr("res.optHighchair"));
        if (r.quiet) o.push(tr("res.optQuiet"));
        return o;
      }
      function rigaResa(r: ResaRow): string {
        const ora = String(r.heure ?? "").slice(0, 5);
        const nome = `${r.first_name ?? ""} ${r.last_name ?? ""}`.trim();
        // ⚠️ Coperti, tavoli e zona sulla stessa riga, in quest'ordine: «per
        // quanti» e «dove» sono la stessa domanda, e separarle costringeva a
        // guardare in due punti.
        const dove = [
          `${r.people} ${tr("home.covers").toLowerCase()}`,
          tavoliDi(r),
          String(r.zone ?? "").trim(),
        ].filter(Boolean).join(" · ");
        const doveHtml = `${ICO_PERS}<span>${escHtml(dove)}</span>`;
        const occ = occasioniDi(r)
          .map((x) => `<span class="j-tag">${escHtml(x)}</span>`)
          .join("");
        // ⚠️ La nota si ANNUNCIA, non si apre: una riga sola, tagliata dove
        // finisce lo spazio. Chi la legge sa che c'e' qualcosa da sapere e
        // apre la pagina; nasconderla del tutto vuol dire scoprire al tavolo
        // che c'era scritto «allergia».
        const nota = String(r.notes ?? "").trim();
        const notaHtml = nota ? `<span class="j-nota">${ICO_NOTA}<span>${escHtml(nota)}</span></span>` : "";
        // ⚠️ Il link porta alla SUA prenotazione, non all'elenco: `?resa=<id>`
        // fa aprire di la' la scheda di questa riga. Chi ha cliccato un nome
        // non deve ritrovarselo in mezzo a venti.
        return `<a class="j-li" href="/admin/reservations?resa=${encodeURIComponent(String(r.id ?? ""))}">` +
          `<span class="h">${ora}</span>` +
          `<span class="tx"><span class="j-nome">${escHtml(nome)}</span>` +
          `<small>${doveHtml}</small>${notaHtml}</span>` +
          `<span class="j-dx-col">${badgeResa(r)}${occ ? `<span class="j-tags">${occ}</span>` : ""}</span>` +
          `</a>`;
      }
      // ============================================================
      // LA COLONNA DELLE PRENOTAZIONI
      // ------------------------------------------------------------
      // Le righe del giorno vivono qui, non dentro chi le ha caricate: la
      // pastiglia cambia stato e la colonna si ridisegna da sola, numeri
      // compresi, senza chiedere di nuovo la giornata al server.
      // ============================================================
      let reseOggi: ResaRow[] = [];
      /* ⚠️ I COPERTI NON SI TENGONO: si ricontano da `reseOggi` a ogni disegno.
         Erano un numero arrivato col caricamento e messo da parte, e cambiare
         uno stato dalla pastiglia ridisegnava la colonna lasciando il numero
         di prima: si metteva a tavola un tavolo di sei e i coperti non si
         muovevano. */
      let resaCapienza = 0;
      // Gli ordini di oggi, gia' filtrati: li disegna la colonna di destra e
      // li riconta l'affluenza. Richiederli una seconda volta vorrebbe dire
      // due elenchi dello stesso giorno, e un giorno direbbero due cose.
      let ordiniOggi: Order[] = [];

      // ⚠️ L'ascolto sta sulla LISTA e non sulle pastiglie: le righe si
      // ridisegnano a ogni cambio di stato, e un ascoltatore attaccato a un
      // bottone muore col bottone. Agganciarlo dopo ogni disegno, invece, ne
      // lascerebbe uno in piu' ogni volta.
      document.getElementById("j-resa-lista")?.addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest(".j-st") as HTMLElement | null;
        if (!b) return;
        // La riga e' un link: senza questo, cambiare stato aprirebbe anche la
        // pagina Réservations.
        ev.preventDefault();
        ev.stopPropagation();
        apriStMenu(b, b.dataset.stId ?? "");
      });

      function disegnaResa(): void {
        // Un tavolo finito, o che non si e' presentato, non e' piu' lavoro:
        // esce dalla lista e resta nei numeri (`daFare`, in `resaConti.ts`).
        const attese = daFare(reseOggi);
        const lista = document.getElementById("j-resa-lista") as HTMLElement | null;
        if (lista) {
          lista.innerHTML = attese.length
            // ⚠️ Niente piu' tetto a sei: le sei righe erano il modo di non far
            // crescere la colonna, e adesso a non farla crescere ci pensa
            // l'altezza fissa. Tagliate, la settima prenotazione della serata
            // non esisteva — e non c'era niente che lo dicesse.
            ? attese.map((r) => rigaResa(r)).join("")
            : `<p class="j-vuoto">${tr("home.nothingToShow")}</p>`;
        }
        // ⚠️ I tre numeri vengono da `resaConti.ts`, lo stesso modulo della
        // pagina Réservations e dei coperti della risposta: «coperti» voleva
        // dire tre cose diverse in tre posti, e la sera le tre dicevano tre
        // numeri per la stessa giornata.
        const coperti = copertiDelGiorno(reseOggi);
        const pieno = riempimento(coperti, resaCapienza);
        numero("j-resa-couv", String(coperti),
          resaCapienza ? tr("home.onPlaces").replace("{n}", String(resaCapienza)) : "");
        // ⚠️ `null` = senza capienza, e si scrive un trattino: una percentuale
        // calcolata su zero posti e' un numero inventato, e sembra vero.
        numero("j-resa-rempl", pieno === null ? "—" : pieno + " %", "");
        numero("j-resa-conf", String(daConfermare(reseOggi)), "");
      }


      // ============================================================
      // I SERVIZI DI OGGI, E L'INTERRUTTORE PER CHIUDERLI
      // ------------------------------------------------------------
      // ⚠️ La chiamata e' QUELLA della pagina Réservations
      // (`/api/admin/service-closures`), e l'interruttore e' il componente
      // condiviso `.switch`. Un secondo modo di chiudere un servizio sarebbe
      // un secondo posto in cui ricordarsi le regole — e la prima a cadere
      // sarebbe quella che nessuno ricorda di avere scritto.
      //
      // ⚠️ `checked` = APERTO. Lo stesso verso della pagina Réservations: due
      // interruttori uguali che vogliono dire il contrario sono il modo piu'
      // veloce per chiudere un servizio credendo di aprirlo.
      // ============================================================
      type SvOggi = { key: string; label: string; da: string; a: string };
      let servOggi: SvOggi[] = [];
      let servData = "";
      const servChiusi = new Map<string, string>();

      function disegnaServizi(): void {
        const box = document.getElementById("j-serv");
        if (!box) return;
        box.innerHTML = servOggi
          .map((sv) => {
            const motivo = servChiusi.get(sv.key) ?? "";
            const perm = motivo === "permanent";
            return (
              `<div class="j-sv${perm ? " is-perm" : ""}">` +
                `<span class="j-sv-x">` +
                  `<span class="n">${escHtml(sv.label)}</span>` +
                  `<span class="h">${escHtml(sv.da)} – ${escHtml(sv.a)}</span>` +
                `</span>` +
                // ⚠️ Taglia PIENA, senza `sw-sm`: questo interruttore chiude un
                // servizio, e lo si tocca col dito su un tablet appeso in sala.
                // `sw-sm` e' la taglia delle righe fitte di un elenco lungo —
                // qui ci sono due righe, e il bersaglio deve essere quello che
                // il dispositivo da' a tutti gli altri interruttori.
                `<label class="switch"${perm ? ` title="${escHtml(tr("res.closedUntilReopenM"))}"` : ""}>` +
                  `<input type="checkbox" data-sv="${escHtml(sv.key)}"${motivo ? "" : " checked"}${perm ? " disabled" : ""} />` +
                  `<span class="track"></span>` +
                `</label>` +
              `</div>`
            );
          })
          .join("");
      }

      document.getElementById("j-serv")?.addEventListener("change", async (e) => {
        const el = (e.target as HTMLElement).closest<HTMLInputElement>("input[data-sv]");
        if (!el || !servData) return;
        const chiave = el.dataset.sv ?? "";
        const chiudere = !el.checked;
        el.disabled = true;
        try {
          // ⚠️ Per cancellare NON si usa `method: "DELETE"`: il resto del
          // pannello passa da POST + `X-Method-Override`, e il middleware
          // conosce solo quella strada.
          const res = chiudere
            ? await fetch("/api/admin/service-closures", {
                method: "POST",
                headers: await authFresh(),
                body: JSON.stringify({ date: servData, service_key: chiave, reason: "full" }),
              })
            : await fetch(
                `/api/admin/service-closures?date=${encodeURIComponent(servData)}&service_key=${encodeURIComponent(chiave)}`,
                { method: "POST", headers: await authFresh({ "X-Method-Override": "DELETE" }) },
              );
          if (!res.ok) throw new Error();
          if (chiudere) servChiusi.set(chiave, "full");
          else servChiusi.delete(chiave);
        } catch {
          // ⚠️ L'interruttore torna com'era: lasciarlo girato direbbe che il
          // servizio e' chiuso mentre il sito continua a prendere tavoli.
          el.checked = !el.checked;
          toast(tr("us.editErr"), true);
        } finally {
          el.disabled = false;
        }
      });

      /**
       * CAMBIARE LO STATO DALLA ACCUEIL.
       *
       * ⚠️ La stessa chiamata della pagina Réservations (`PATCH`), perche' e'
       * la stessa azione: una seconda strada per scrivere la stessa colonna
       * e' una strada che un giorno dimentica una regola.
       *
       * ⚠️ Si scrive PRIMA sul server e solo dopo sullo schermo. Al contrario,
       * una riga rifiutata resterebbe verde sul pannello e rossa nel database,
       * e nessuno saprebbe quale delle due e' vera.
       */
      async function cambiaStatoResa(id: string, st: string): Promise<void> {
        try {
          const res = await fetch("/api/admin/reservations", {
            method: "PATCH",
            headers: await authFresh(),
            body: JSON.stringify({ id, status: st }),
          });
          if (!res.ok) throw new Error();
          const r = reseOggi.find((x) => String(x.id ?? "") === id);
          if (r) r.status = st;
          disegnaResa();
        } catch {
          toast(tr("us.editErr"), true);
        }
      }

      // ---- il menu degli stati: uno solo, appeso al body ----
      // ⚠️ Appeso al `body` e non alla riga: dentro l'elenco lo taglierebbe il
      // primo contenitore che nasconde cio' che esce, e in un elenco ce n'e'
      // sempre uno.
      const stMenu = document.createElement("div");
      stMenu.className = "st-menu";
      document.body.appendChild(stMenu);
      let stMenuId = "";
      function chiudiStMenu(): void {
        stMenu.style.display = "none";
        stMenuId = "";
      }
      function apriStMenu(anchor: HTMLElement, id: string): void {
        const r = reseOggi.find((x) => String(x.id ?? "") === id);
        stMenuId = id;
        // ⚠️ La voce segnata e' quella che dice la PASTIGLIA, non il `status`
        // grezzo: una confermata il cui tavolo e' in corso mostra «En cours»,
        // e il menu segnava «Confirmée». Chi lo apriva per metterla a tavola
        // vedeva che era gia' fatto, e chiudeva senza toccare niente. La
        // regola sta in `resaStato.ts`, insieme a quella della pastiglia.
        const voce = r ? voceStatoDi(
          {
            date: String(r.date ?? adessoResa().oggi),
            heure: String(r.heure ?? ""),
            status: r.status,
            service_key: r.service_key ?? null,
            extra_minutes: r.extra_minutes ?? null,
          },
          adessoResa(), resaServizi, resaHold,
        ) : "";
        stMenu.innerHTML = STATI_RESA.map(
          (v) =>
            `<button type="button" data-st="${v.st}" class="${voce === v.st ? "is-cur" : ""}">` +
            `<span class="st-dot" style="background:${v.colore}"></span>${v.label}</button>`
        ).join("");
        stMenu.style.display = "block";
        // Posizionato sulle coordinate della pastiglia, e tenuto dentro lo
        // schermo: sull'ultima riga in basso si aprirebbe fuori dalla finestra.
        const rect = anchor.getBoundingClientRect();
        const mw = stMenu.offsetWidth || 150;
        const mh = stMenu.offsetHeight || 160;
        stMenu.style.left = `${Math.max(8, Math.min(rect.left, window.innerWidth - mw - 8))}px`;
        stMenu.style.top = `${Math.min(rect.bottom + 6, window.innerHeight - mh - 8)}px`;
      }
      stMenu.addEventListener("click", (e) => {
        e.stopPropagation();
        const b = (e.target as HTMLElement).closest("[data-st]") as HTMLElement | null;
        if (!b || !stMenuId) return;
        const id = stMenuId;
        const st = b.dataset.st ?? "";
        chiudiStMenu();
        void cambiaStatoResa(id, st);
      });
      document.addEventListener("click", (e) => {
        if (stMenu.style.display === "block" && !stMenu.contains(e.target as Node)) chiudiStMenu();
      });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") chiudiStMenu(); });

      // ============================================================
      // LA PASTIGLIA DEL CONTEGGIO — «3 aujourd'hui», e il locale chiuso
      // ------------------------------------------------------------
      // ⚠️ IL COLORE DICE SE C'E' DA LAVORARE: neutra a zero (un numero, non
      // uno stato), VERDE da uno in su, ROSSA quando il locale oggi non apre —
      // e allora al posto del numero c'e' «Fermé aujourd'hui», perche' «0
      // aujourd'hui» su una giornata di chiusura si legge come «nessuno ha
      // prenotato», che e' un'altra cosa e fa venire voglia di controllare.
      //
      // ⚠️ CHI DECIDE SE E' CHIUSO e' la colonna «Aujourd'hui», con
      // `statoGiorno()`: una seconda lettura degli orari qui vorrebbe dire due
      // colonne accanto che possono dire il contrario. Ma quel blocco gira
      // DOPO prenotazioni e ordini, quindi la pastiglia si disegna due volte:
      // prima col numero, poi — se la giornata e' chiusa — col rosso. Lo
      // stesso che fa la colonna dei giorni speciali con le feste.
      // ============================================================
      /** Oggi il locale e' chiuso? `null` = ancora non si sa (configurazione
       *  non arrivata).
       *  ⚠️ Non confondere con `giornoChiuso(iso)`, poco piu' su: quella
       *  risponde per un giorno QUALSIASI e la usa il calendario; questa e' lo
       *  stato di OGGI, deciso una volta sola dalla colonna «Aujourd'hui». */
      let oggiChiuso: boolean | null = null;
      const contaPastiglia = new Map<string, number>();

      function pastigliaGiorno(id: string, n: number): void {
        contaPastiglia.set(id, n);
        disegnaPastiglia(id);
      }

      function disegnaPastiglia(id: string): void {
        const el = document.getElementById(id);
        const n = contaPastiglia.get(id);
        if (!el || n === undefined) return;
        if (oggiChiuso) {
          el.textContent = tr("home.closedToday");
          el.className = "j-pil ko";
          return;
        }
        el.textContent = tr("home.nToday").replace("{n}", String(n));
        // Verde = c'e' qualcosa; neutra = non c'e' niente, e non e' un guasto.
        el.className = n > 0 ? "j-pil" : "j-pil n";
      }

      /**
       * LA PASTIGLIA DI UNA COLONNA: un numero e basta (note da fare, decisioni
       * sui giorni speciali, piatti fuori, foto libere).
       *
       * ⚠️ Stesso colore delle altre due: VERDE da uno in su, neutra a zero.
       * Era il contrario di quello che si vedeva — `.j-pil` da solo E' gia'
       * verde, e due colonne portavano una classe `att` che nel foglio di
       * stile non esisteva: sembravano scelte, erano verdi per caso.
       *
       * ⚠️ A ZERO la pastiglia SPARISCE (`.j-pil:empty`, in CSS): «0» accanto
       * a un titolo e' un posto occupato per dire che non c'e' niente, e la
       * colonna qui sotto lo dice gia' con la sua frase.
       */
      function pastigliaConta(id: string, n: number): void {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = n > 0 ? String(n) : "";
        el.className = n > 0 ? "j-pil" : "j-pil n";
      }

      /** Un blocco a tre piani: etichetta (gia' nel markup), numero, descrizione. */
      function numero(id: string, valore: string, sotto: string): void {
        const v = document.getElementById(id);
        if (v) v.textContent = valore;
        const d = document.getElementById(id + "-d");
        if (d) d.textContent = sotto;
      }
      /** «6 oct, 12:20» nella lingua dell'admin e nel fuso del LOCALE.
       *  ⚠️ Non quello del browser: una nota scritta alle 23:40 a Bruxelles,
       *  letta da un telefono rimasto su un altro fuso, direbbe un'altra ora —
       *  e su una lavagnetta l'ora e' meta' dell'informazione. */
      function noteDate(iso: string): string {
        return new Date(iso).toLocaleString(LOC, {
          timeZone: TZ_LOCALE, day: "numeric", month: "short", hour: "2-digit", minute: "2-digit",
        });
      }

      // ---------- Notes: i bigliettini nella colonna + il modale «nuova nota» ----------
      async function avviaNote(headers: Record<string, string>) {
        const preview = document.getElementById("notes-preview") as HTMLElement;
        const addBtn = document.getElementById("notes-add") as HTMLButtonElement;
        const overlay = document.getElementById("notes-overlay") as HTMLElement;
        const input = document.getElementById("notes-input") as HTMLTextAreaElement;
        const saveBtn = document.getElementById("nc-save") as HTMLButtonElement;
        const msgEl = document.getElementById("notes-msg") as HTMLElement;
        const tagNew = document.getElementById("nc-tag-new") as HTMLInputElement;
        const tagAdd = document.getElementById("nc-tag-add") as HTMLButtonElement;
        const tagPiu = document.getElementById("nc-tag-piu") as HTMLButtonElement;
        const rigaNew = document.getElementById("nc-new") as HTMLElement;
        const boxChi = document.getElementById("nc-chi") as HTMLElement;
        const panQuando = document.getElementById("nc-quando") as HTMLElement;
        const panRipeti = document.getElementById("nc-ripeti") as HTMLElement;
        const campoDue = document.getElementById("nc-due") as HTMLInputElement;
        const campoDueOra = document.getElementById("nc-due-ora") as HTMLInputElement;
        // Il calendario del marchio sul campo della scadenza. Niente passato:
        // una scadenza di ieri non e' una scadenza, e il calendario lo dice
        // spegnendo i giorni invece di accettarli e poi colorare di rosso.
        dp.collega(campoDue);
        const selOgni = document.getElementById("nc-ogni") as HTMLSelectElement;
        const selDow = document.getElementById("nc-dow") as HTMLSelectElement;
        const selDom = document.getElementById("nc-dom") as HTMLSelectElement;
        const selMese = document.getElementById("nc-mese") as HTMLSelectElement;
        const campoOra = document.getElementById("nc-ora") as HTMLInputElement;
        let notes: Note[] = [];
        // ⚠️ Lo dice l'API, non il browser: e' la stessa risposta che decide
        // se la cancellazione passera'. Finche' non si sa, il cestino non
        // c'e' — meglio un bottone che compare un attimo dopo di un bottone
        // che risponde «non autorizzato».
        let puoCancellare = false;
        /** L'etichetta per cui si sta filtrando. Vuota = tutte. */
        let filtro = "";
        /** La nota che si sta MODIFICANDO, o `null` se se ne sta scrivendo una
         *  nuova. ⚠️ E' l'unica cosa che distingue i due usi della stessa
         *  finestra: tutto il resto — campo, etichette, scadenza — e' lo
         *  stesso, ed era gia' tutto li'. Una seconda finestra «modifica»
         *  sarebbe stata la stessa finestra scritta due volte. */
        let modificaId: string | null = null;

        async function erroreDa(res: Response, fallback: string): Promise<string> {
          try { return ((await res.json()) as { error?: string }).error || fallback; } catch { return `${fallback} (HTTP ${res.status})`; }
        }

        const TAG_LABEL: Record<string, string> = { important: tr("tag.important"), recurrent: tr("tag.recurrent"), fournisseur: tr("tag.fournisseur") };
        /**
         * ⚠️ I tag che NON sono fra i tre noti si scrivono come sono stati
         * scritti, invece di sparire. Prima la riga era
         * `.filter((x) => TAG_LABEL[x])`: un tag scritto a mano si salvava e
         * poi non si vedeva piu' da nessuna parte — il modo peggiore di
         * perdere una cosa, perche' sembra che abbia funzionato.
         * ⚠️ `t-${x}` solo per i tre noti: la classe finisce nell'HTML, e una
         * parola scritta da una persona non va messa dentro un nome di
         * classe.
         */
        const tagPills = (n: Note): string => {
          const t = tagDi(n);
          const quando = testoScadenza(n);
          const ripete = testoRicorrenza(n);
          const inRit = tardi(n);

          /** Una pastiglia, con il suo dettaglio attaccato se ce l'ha.
           *  ⚠️ Il dettaglio sta accanto alla SUA etichetta, non su una riga
           *  a parte: «Important» e «entro l'11 ottobre» sono una frase sola,
           *  e separate chiedevano di rimetterle insieme da soli. La freccia
           *  dice che la seconda spiega la prima.
           *  ⚠️ La freccia e' un carattere e non un elemento: qui non reagisce
           *  a niente e non e' un comando — e fra le cinque lingue
           *  dell'admin non ce n'e' una che scrive da destra. */
          const uno = (x: string) => {
            const info = x === "important" ? quando : x === "recurrent" ? ripete : "";
            const rosso = x === "important" && inRit ? " late" : "";
            return `<span class="note-tagx"><span class="note-tag ${TAG_LABEL[x] ? "t-" + x : "t-libero"}">${escHtml(TAG_LABEL[x] ?? x)}</span>` +
              (info ? `<span class="note-fr">→</span><b class="note-info${rosso}">${escHtml(info)}</b>` : "") +
              `</span>`;
          };

          const pezzi = t.map(uno);
          // ⚠️ A CHI TOCCA viene PRIMA delle etichette, perche' e' la cosa per
          // cui si guarda una lavagnetta di squadra: «questa e' mia?». Si
          // legge `assigned_name`, il nome salvato con la nota, e non la
          // rubrica di oggi: se quella persona se n'e' andata la nota deve
          // continuare a dire di chi era.
          if (n.assigned_name) {
            // ⚠️ IL NOME dalla NOTA, la FOTO dalla rubrica di oggi. Il nome e'
            // quello salvato quando la si e' assegnata — se quella persona se
            // n'e' andata, la nota deve continuare a dire di chi era. La foto
            // invece cambia: fotografarla nella nota avrebbe lasciato in giro
            // ritratti vecchi di un anno, e un indirizzo che un giorno non
            // risponde piu'. Se la persona non e' piu' in rubrica restano le
            // iniziali, che dal nome si ricavano sempre.
            const p = squadra.find((x) => x.id === n.assigned_to);
            const dentro = escHtml(iniziali(n.assigned_name)) +
              (p?.foto ? `<img src="${escHtml(p.foto)}" alt="" referrerpolicy="no-referrer" onerror="this.remove()" />` : "");
            pezzi.unshift(
              `<span class="note-tagx chi"><span class="j-av np-av" style="background:${coloreDi(n.assigned_name)}">${dentro}</span>` +
              `<b class="note-info">${escHtml(n.assigned_name)}</b></span>`);
          }
          // ⚠️ Scadenza o ricorrenza SENZA la loro etichetta esistono: il
          // campo si apre con «Important», ma niente vieta di togliere
          // l'etichetta e lasciare la data. Orfane si mostrano lo stesso, con
          // il loro segno davanti — altrimenti una scadenza ci sarebbe e non
          // si vedrebbe.
          if (quando && !t.includes("important")) {
            pezzi.push(`<span class="note-tagx">${ICO_SVEGLIA}<b class="note-info${inRit ? " late" : ""}">${escHtml(quando)}</b></span>`);
          }
          if (ripete && !t.includes("recurrent")) {
            pezzi.push(`<span class="note-tagx">${ICO_RIPETI}<b class="note-info">${escHtml(ripete)}</b></span>`);
          }
          return pezzi.length ? `<div class="note-tags">${pezzi.join("")}</div>` : "";
          // (l'ordine della riga: a chi tocca, le etichette col loro
          //  dettaglio, e in coda scadenza o ricorrenza rimaste orfane)
        };

        /** La riga dei filtri. ⚠️ Non c'e' se non c'e' niente da filtrare: una
         *  riga con la sola pastiglia «Toutes» e' un comando che non comanda,
         *  e ruba due centimetri alla colonna in cima. */
        function disegnaFiltri(): void {
          const box = document.getElementById("j-note-filtri");
          if (!box) return;
          const tag = etichette(notes);
          box.style.display = tag.length ? "" : "none";
          if (!tag.length) { filtro = ""; return; }
          // ⚠️ Se l'ultima nota con l'etichetta filtrata se ne va — spuntata,
          // cancellata — il filtro resterebbe acceso su una parola che non
          // esiste piu', e la colonna direbbe «niente da mostrare» senza che
          // si capisca perche'. (`filtroValido`, in `noteRegole.ts`.)
          filtro = filtroValido(notes, filtro);
          // ⚠️ `aria-label` e `title` sulla pastiglia con l'icona: su tablet e
          // telefono la parola e' nascosta, e un bottone fatto di un disegno
          // solo non ha piu' un nome — per chi legge con la voce diventa
          // «pulsante», e per chi guarda un rettangolo da provare.
          const chip = (val: string, testo: string, ico = "") =>
            `<button type="button" class="rh-filter${ico ? " tutte" : ""}${val.toLowerCase() === filtro.toLowerCase() ? " is-on" : ""}"` +
            ` data-f="${escHtml(val)}"${ico ? ` aria-label="${escHtml(testo)}" title="${escHtml(testo)}"` : ""}>` +
            `${ico}<span class="et">${escHtml(testo)}</span></button>`;
          // ⚠️ L'icona sta SOLO su «Toutes», ed e' il punto: le altre pastiglie
          // sono etichette — parole scritte da chi usa la lavagnetta — questa
          // e' il comando che le spegne tutte. Un segno la separa da loro
          // senza doverla leggere, in una riga che scorre di lato.
          box.innerHTML = chip("", tr("home.notesAll"), ICO_TUTTE) + tag.map((x) => chip(x, TAG_LABEL[x] ?? x)).join("");
        }

        /**
         * Le note da mostrare: tutte, o quelle che portano l'etichetta.
         *
         * ⚠️ L'ORDINE NON SI TOCCA QUI. Arriva dal server — dalla piu' vecchia
         * alla piu' nuova, le fatte in fondo — ed e' un ordine solo, in un
         * posto solo. Qui c'era un riordino per scadenza: due regole d'ordine
         * sulla stessa lista vogliono dire che aggiungendo una nota la si
         * vede comparire in un punto che non e' quello in cui il database
         * crede che sia, e nessuna delle due e' sbagliata abbastanza da
         * accorgersene.
         * La scadenza si vede: lo dice «en retard» in rosso, non la posizione.
         */
        const visibili = (): Note[] => conEtichetta(notes, filtro);

        /**
         * IL PIEDE DELLA COLONNA: quante ne sono state chiuse, e da quanto
         * aspetta la piu' vecchia.
         *
         * ⚠️ Conta SEMPRE tutte le note, anche col filtro acceso. E' la riga
         * di fondo della colonna, non il riassunto di cio' che si sta
         * guardando: un numero che cambia perche' si e' premuta una pastiglia
         * la' in cima e' un numero di cui non ci si fida piu'.
         *
         * ⚠️ L'eta' si dice solo da UN GIORNO IN SU. «La piu' vecchia da 0
         * giorni» non e' un'informazione, e' una riga che occupa posto per
         * dire che e' tutto normale; la frase serve quando c'e' qualcosa che
         * aspetta da troppo.
         */
        function renderStat(): void {
          const box = document.getElementById("j-note-stat");
          if (box) {
            // ⚠️ GIORNI DI CALENDARIO nel fuso del locale, non fette di
            // ventiquattro ore: con la sottrazione dei millisecondi una nota
            // scritta ieri alle 23 diceva «0 giorni» fino alle 23 di oggi,
            // cioe' per tutta la giornata in cui qualcuno doveva
            // accorgersene. La regola sta in `noteRegole.ts`.
            const giorni = notes.length
              ? attesaPiuVecchia(notes, dayKeyBrussels(new Date().toISOString()), dayKeyBrussels)
              : null;
            box.textContent = giorni === null ? "" : tr("home.notesOldest").replace("{n}", String(giorni));
          }

          const nums = document.getElementById("j-note-nums");
          if (!nums) return;
          nums.style.display = notes.length ? "" : "none";
          if (!notes.length) return;

          // ⚠️ IL MESE COMINCIA NEL FUSO DEL LOCALE. `new Date(y, m, 1)` lo
          // fa nascere nel fuso del BROWSER: una nota del primo del mese
          // scritta a Bruxelles, guardata da un telefono rimasto indietro di
          // un fuso, cadrebbe nel mese prima — e il conto del mese sarebbe
          // diverso a seconda di chi guarda la stessa pagina.
          const inizioMese = (() => {
            const f = new Intl.DateTimeFormat("en-CA", { timeZone: TZ_LOCALE, year: "numeric", month: "2-digit" });
            return `${f.format(new Date())}-01`;
          })();
          // ⚠️ IL CONFRONTO ERA A META'. Il primo del mese si calcolava nel
          // fuso del locale e poi si confrontava col `created_at` grezzo, che
          // e' un istante UTC: una nota scritta il primo ottobre all'una di
          // notte a Bruxelles e' `2026-09-30T23:00:00Z`, sta prima di
          // «2026-10-01» per lettere, e cadeva nel mese sbagliato. Adesso
          // tutte e due le parti del confronto sono chiavi-giorno dello
          // stesso fuso.
          const mese = contoDelMese(notes, inizioMese, dayKeyBrussels);
          // `numero()`: lo stesso aiutante dei riquadri delle altre colonne —
          // scrive la cifra e la riga sotto in un colpo, e sa gia' che la
          // seconda si chiama come la prima con «-d».
          numero("j-note-mese", `${mese.fatte}/${mese.totali}`, tr("home.notesDoneShort"));

          // CHI LE FA: si conta `done_by`, non `author`.
          // ⚠️ `done_by` esiste dalla #79 e si riempie da quando qualcuno
          // spunta: finche' non c'e' niente la casella lo DICE invece di
          // mostrare una classifica vuota, che si leggerebbe come «nessuno
          // fa niente».
          const top = chiLeFa(notes, inizioMese, dayKeyBrussels);
          const ol = document.getElementById("j-note-top");
          if (ol) {
            ol.innerHTML = top.length
              ? top.map((x) => `<li><span class="n">${escHtml(x.chi)}</span><span class="q">${x.quante}</span></li>`).join("")
              : `<li class="vuoto">${escHtml(tr("home.notesTopNone"))}</li>`;
          }
        }

        /** ⚠️ «In ritardo» si dice solo per le note DA FARE: su una gia'
         *  spuntata sarebbe un rimprovero per un lavoro finito. La regola sta
         *  in `noteRegole.ts`, con quella della mail del mattino — che prima
         *  non sapeva affatto cosa fosse una nota in ritardo. */
        const tardi = (n: Note): boolean => inRitardo(n, Date.now());

        /** «11 Oct, 12:00» — e «· en retard» quando e' passata. */
        function testoScadenza(n: Note): string {
          if (!n.due_at) return "";
          return noteDate(n.due_at) + (tardi(n) ? ` · ${tr("home.noteLate")}` : "");
        }

        /** «ogni lunedi' alle 09:00» — la frase la compone `descrivi()`, la
         *  stessa che usa l'email alla persona assegnata. Qui si passano solo
         *  i nomi dei giorni e dei mesi, che il browser sa gia' fare. */
        const testoRicorrenza = (n: Note): string =>
          descrivi(n.repeat as never, { t: tr, giorno: nomeGiornoBreve, mese: nomeMeseBreve });

        function renderPreview() {
          disegnaFiltri();
          renderStat();
          const mostrate = visibili();
          // La pastiglia conta le note DA FARE, non tutte: una lavagnetta con
          // trenta note spuntate direbbe «30» a chi ne ha zero da leggere.
          // ⚠️ E conta quelle MOSTRATE: con un filtro acceso, un numero nel
          // titolo piu' grande delle note qui sotto e' un numero che chi
          // guarda deve spiegarsi da solo.
          // ⚠️ Conta le note DA FARE, non tutte: una lavagnetta con trenta
          // note spuntate direbbe «30» a chi non ha niente da leggere. E a
          // zero sparisce, invece di dire «0».
          pastigliaConta("j-note-cnt", noteDaFare(mostrate).length);
          if (mostrate.length === 0) {
            // Due vuoti diversi: «non ce ne sono» e «nessuna ha questa
            // etichetta». Il primo dice di premere +, il secondo sarebbe un
            // consiglio sbagliato — la nota c'e', e' il filtro che la nasconde.
            const testo = notes.length ? tr("home.nothingToShow") : tr("home.noNotesShort");
            preview.innerHTML = `<p class="np-empty j-vuoto">${escHtml(testo)}</p>`;
            return;
          }
          // ⚠️ TUTTE, e non le prime tre con un «+7 altre». Le tre erano il
          // modo di far stare la lavagnetta in una tile; adesso e' una colonna
          // alta quanto le altre e scorre dentro. La riga «+7» mandava ad
          // aprire il modale per leggere note che ci stavano benissimo qui.
          preview.innerHTML = mostrate
            .map(
              (n) => `
              <div class="np-item${n.done ? " done" : ""}" data-id="${n.id}">
                <button class="note-check" type="button" title="${n.done ? tr("home.reopenNote") : tr("home.markDone")}">${n.done ? CHECK_ICON : ""}</button>
                <div class="np-body">
                  <span class="np-text">${escHtml(n.content)}</span>${tagPills(n)}
                  <div class="note-meta">${n.author ? `<b>${escHtml(n.author)}</b> · ` : ""}${noteDate(n.created_at)}</div>
                </div>
                ${puoCancellare ? `<button class="ibtn ibtn-danger note-del" type="button" title="${tr("common.delete")}" aria-label="${tr("common.delete")}">${TRASH_ICON}</button>` : ""}
              </div>`
            )
            .join("");
        }
        /** ⚠️ Un disegno solo. Le note si disegnavano due volte — qui e
            nell'elenco del modale — con due markup e due funzioni: e' il modo
            in cui una pastiglia finisce diversa nei due posti e nessuno sa
            quale sia quella giusta. */
        const render = renderPreview;

        /** Segna fatta / da fare. */
        async function spunta(id: string): Promise<void> {
          const n = notes.find((x) => x.id === id);
          if (!n) return;
          const nuovo = !n.done;
          msgEl.textContent = "";
          try {
            const res = await fetch("/api/admin/notes", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id, done: nuovo }),
            });
            if (res.ok) {
              /* ⚠️ IL GUASTO. Qui si scriveva `n.done = nuovo` e si buttava
                 via la risposta. Ma una nota RICORRENTE non si chiude: il
                 server la riapre con la scadenza del giro dopo (vedi
                 `api/admin/notes.ts`). Lo schermo la mostrava spuntata e
                 barrata, il conto del mese la contava fatta, la scadenza
                 restava quella vecchia — rossa — e al primo ricaricamento
                 tutto cambiava da solo sotto gli occhi di chi guardava.
                 La riga che vale e' quella che torna dal server: porta `done`
                 vero, la scadenza nuova, e `done_by` (cosi' la classifica di
                 chi le chiude si aggiorna subito invece che al prossimo
                 ricaricamento). */
              try {
                const j = (await res.json()) as { note?: Partial<Note> };
                if (j?.note) Object.assign(n, j.note);
                else n.done = nuovo;
              } catch {
                // Risposta illeggibile: si tiene il gesto, che il server ha
                // comunque accettato (`res.ok`).
                n.done = nuovo;
              }
              render();
            }
            else { msgEl.textContent = await erroreDa(res, tr("home.editFailed")); }
          } catch { msgEl.textContent = tr("common.netErr"); }
        }

        const titolo = document.getElementById("notes-title") as HTMLElement | null;

        /** Accende le pastiglie che stanno in `tagSel`, spegne le altre.
         *  ⚠️ Da fare DOPO `disegnaTagUsati()`: le pastiglie delle etichette
         *  scritte a mano non esistono finche' non le disegna, e accese prima
         *  sarebbero rimaste spente. */
        function mostraTagSel(): void {
          tagsBox?.querySelectorAll<HTMLButtonElement>(".nc-tag[data-tag]").forEach((b) => {
            b.classList.toggle("is-on", tagSel.has(b.dataset.tag ?? ""));
          });
        }

        /**
         * Apre la finestra: vuota per una nota nuova, piena per modificarne una.
         *
         * ⚠️ Riempirla NON basta: va anche SVUOTATA quando si passa da una
         * nota all'altra, o da una nota a una nuova. Senza, la nota nuova
         * nascerebbe con la scadenza e le etichette dell'ultima aperta —
         * campi che nessuno ha toccato e che si salvano lo stesso.
         */
        /** La rubrica, letta una volta sola e tenuta.
         *  ⚠️ Non al caricamento della pagina: chi non apre mai il modale non
         *  deve pagare una chiamata in piu' a ogni visita della Accueil. */
        let squadraLetta = false;
        async function leggiSquadra(): Promise<void> {
          if (squadraLetta) return;
          squadraLetta = true;
          try {
            const res = await fetch("/api/admin/team", { headers });
            if (!res.ok) return;
            const j = (await res.json()) as { team?: unknown[]; rows?: unknown[]; people?: unknown[] };
            const righe = (j.team ?? j.rows ?? j.people ?? []) as { id: string; name: string; photo_url?: string }[];
            squadra = assegnabili(righe as { id: string; name: string; photo_url?: string }[])
              .map((p) => ({ id: String(p.id), name: String(p.name), foto: String(p.photo_url ?? "") }));
          } catch { /* niente rubrica: la finestra mostra la via d'uscita */ }
        }

        function openModal(focus: boolean, n?: Note) {
          msgEl.textContent = "";
          modificaId = n?.id ?? null;

          input.value = n?.content ?? "";
          tagSel.clear();
          for (const t of Array.isArray(n?.tags) ? n!.tags! : []) tagSel.add(String(t));

          // La scadenza torna nei due campi da cui era uscita: il giorno nel
          // calendario (in `data-iso`), l'ora nel suo.
          if (n?.due_at) {
            const d = new Date(n.due_at);
            dp.metti(campoDue, dayKey(d));
            campoDueOra.value = `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
          } else {
            dp.metti(campoDue, "");
            campoDueOra.value = "12:00";
          }

          const r = n?.repeat;
          selOgni.value = String(r?.ogni ?? "giorno");
          campoOra.value = String(r?.ora ?? "09:00");

          disegnaTagUsati();
          mostraTagSel();
          // ⚠️ Anche i pannelli, non solo le pastiglie: chi chiude la finestra
          // con la × invece di salvare lascia le etichette accese, e
          // riaprendola avrebbe trovato «Importante» premuto e il campo della
          // scadenza sparito — due cose che si contraddicono.
          aggiornaPannelli();
          // ⚠️ Le scelte della ricorrenza si rimettono DOPO `aggiornaPannelli`:
          // e' li' che le caselle vengono riempite la prima volta, e scrivere
          // in una `<select>` ancora vuota non lascia niente.
          if (r) {
            if (r.dow) selDow.value = String(r.dow);
            if (r.dom) selDom.value = String(r.dom);
            if (r.mese) selMese.value = String(r.mese);
          }

          rigaNew.hidden = true;
          tagNew.value = "";
          // ⚠️ Prima col poco che si ha, poi di nuovo quando la rubrica
          // arriva: aspettando la risposta, la finestra si aprirebbe dopo il
          // click invece che con il click.
          chiSel = String(n?.assigned_to ?? "");
          // Aprendo una nota gia' assegnata l'interruttore e' acceso e la sua
          // faccia e' quella scelta: la finestra mostra com'e' la nota, non
          // come si comincia.
          swChi.checked = !!chiSel;
          boxChi.hidden = !chiSel;
          disegnaChi();
          void leggiSquadra().then(() => { if (!boxChi.hidden) disegnaChi(); });
          if (titolo) titolo.textContent = tr(modificaId ? "home.editNote" : "home.newNote");
          saveBtn.textContent = tr(modificaId ? "common.save" : "common.add");
          overlay.hidden = false;
          if (focus) input.focus();
        }
        function closeModal() { overlay.hidden = true; }

        // ⚠️ Il bottone «Agrandir» non c'e' piu', e questa riga se n'e' andata
        // con lui. Lasciata, `getElementById` avrebbe reso `null` e
        // `addEventListener` sarebbe morto subito: dentro `avviaNote`, cioe'
        // prima che si agganciassero il «+», la spunta e il caricamento —
        // tutta la lavagnetta spenta per un bottone tolto dal markup.
        // Il «+» apre sempre una finestra vuota, anche se l'ultima volta si
        // stava correggendo una nota.
        addBtn.addEventListener("click", () => openModal(true));
        document.getElementById("j-note-filtri")?.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".rh-filter") as HTMLButtonElement | null;
          if (!b) return;
          const val = b.dataset.f ?? "";
          // Ripremere il filtro acceso lo spegne: e' la via d'uscita piu'
          // corta, e non costringe a cercare «Toutes» in fondo a una riga che
          // scorre di lato.
          filtro = val.toLowerCase() === filtro.toLowerCase() ? "" : val;
          render();
        });
        preview.addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          const riga = t.closest(".np-item") as HTMLElement | null;
          // Il cerchio spunta la nota SENZA aprire il modale: e' l'unico punto
          // del bigliettino che non porta dentro.
          if (t.closest(".note-check")) {
            if (riga?.dataset.id) void spunta(riga.dataset.id);
            return;
          }
          const del = t.closest(".note-del") as HTMLButtonElement | null;
          if (del && riga?.dataset.id) { void cancella(del, riga.dataset.id); return; }
          // ⚠️ Solo da un BIGLIETTINO (o dal messaggio «nessuna nota»). Qui
          // dentro si apriva da qualunque punto: andava bene in una tile alta
          // quattro righe, dove tutto era una nota. Nella colonna, sotto
          // l'ultima nota ci sono duecento pixel di niente, e cliccarli faceva
          // comparire un modale che nessuno aveva chiesto.
          if (!t.closest(".np-item, .np-empty")) return;
          // ⚠️ Toccando un bigliettino si apre QUELLA nota, non una finestra
          // vuota: si tocca per cambiare cio' che c'e' scritto, non per
          // scriverne un'altra — e trovarsi davanti un foglio bianco al posto
          // della propria nota fa credere di averla persa.
          const sua = riga?.dataset.id ? notes.find((x) => x.id === riga.dataset.id) : undefined;
          openModal(false, sua);
        });

        /** Cancella, in due tempi: il primo tocco CHIEDE, il secondo fa.
         *  ⚠️ Niente `confirm()` del browser e niente finestra: si cancella un
         *  bigliettino di una riga, e una domanda che ferma tutta la pagina
         *  per quello e' sproporzionata. La domanda sta sul bottone stesso, e
         *  dopo quattro secondi si ritira da sola — chi ha toccato per sbaglio
         *  non deve nemmeno annullare. */
        async function cancella(btn: HTMLButtonElement, id: string): Promise<void> {
          if (!btn.classList.contains("confirm")) {
            btn.classList.add("confirm");
            btn.textContent = tr("home.deleteQ");
            setTimeout(() => { btn.classList.remove("confirm"); btn.innerHTML = TRASH_ICON; }, 4000);
            return;
          }
          try {
            const res = await fetch("/api/admin/notes", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ delete_id: id }),
            });
            // ⚠️ L'esito si legge. Qui il messaggio d'errore vive nel modale,
            // che in questo momento e' chiuso: senza il toast, una
            // cancellazione rifiutata sarebbe un bottone premuto due volte e
            // una nota che resta dov'e', senza una parola.
            if (res.ok) { notes = notes.filter((x) => x.id !== id); render(); }
            else toast(await erroreDa(res, tr("home.deleteFailed")), true);
          } catch { toast(tr("common.netErr"), true); }
        }
        // Sfondo e × del guscio condiviso: un solo aggancio, [data-md-close].
        overlay.querySelectorAll("[data-md-close]").forEach((el) => el.addEventListener("click", closeModal));
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });

        const tagSel = new Set<string>();
        const tagsBox = document.getElementById("nc-tags") as HTMLElement | null;
        tagsBox?.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".nc-tag") as HTMLButtonElement | null;
          if (!b || !b.dataset.tag) return;
          const t = b.dataset.tag;
          if (tagSel.has(t)) tagSel.delete(t); else tagSel.add(t);
          b.classList.toggle("is-on", tagSel.has(t));
          aggiornaPannelli();
        });
        /** Svuota la finestra dopo un salvataggio riuscito.
         *  ⚠️ `dp.metti(el, "")` e non `el.value = ""`: il valore vero sta in
         *  `data-iso`, e svuotando solo il testo la nota dopo si sarebbe
         *  portata dietro la scadenza di quella prima, con il campo in
         *  apparenza vuoto. */
        const azzeraTag = () => {
          tagSel.clear();
          tagsBox?.querySelectorAll(".nc-tag").forEach((b) => b.classList.remove("is-on"));
          dp.metti(campoDue, "");
          tagNew.value = "";
          rigaNew.hidden = true;
          chiSel = "";
          swChi.checked = false;
          boxChi.hidden = true;
          modificaId = null;
          aggiornaPannelli();
        };

        // ---------- Assegna a ----------
        /** Le persone a cui si puo' assegnare. Vuoto finche' la rubrica non
         *  arriva — e se non arriva, resta vuoto e la finestra lo dice. */
        let squadra: { id: string; name: string; foto: string }[] = [];
        /** Chi e' scelto nella griglia. ⚠️ Una variabile e non il DOM: la
         *  griglia si ridisegna quando la rubrica arriva, e leggere la scelta
         *  da un elemento che nel frattempo e' stato buttato via vorrebbe dire
         *  perderla proprio nel momento in cui l'elenco si riempie. */
        let chiSel = "";

        /**
         * Il menu' «Assegna a», o la via d'uscita quando non c'e' nessuno.
         *
         * ⚠️ `team` e' una RUBRICA: dentro ci sono anche fornitori, tecnici e
         * consulenti. Il filtro e' `assegnabili()`, la stessa regola che
         * applica il server quando salva e quando manda l'email — se qui ne
         * mostrassi uno in piu', il salvataggio lo rifiuterebbe in silenzio.
         */
        /**
         * LE FACCE, non un menu' a tendina.
         *
         * ⚠️ In cucina le persone si riconoscono in faccia, non leggendo un
         * elenco: una griglia di volti si scorre con l'occhio, una `<select>`
         * va aperta, letta e chiusa. E il cerchio col colore ricavato dal nome
         * e' lo STESSO che il pannello usa per chi scrive una recensione —
         * stesso componente (`.j-av`), stesse iniziali, stesso colore.
         *
         * ⚠️ «Personne» e' la PRIMA casella e non l'assenza di una scelta: e'
         * cosi' che si toglie un'assegnazione fatta per sbaglio. Senza, per
         * disfare bisognerebbe cancellare la nota.
         */
        function disegnaChi(): void {
          if (!squadra.length) {
            boxChi.innerHTML =
              `<p class="nc-vuoto">${escHtml(tr("home.noteTeamNone"))}</p>` +
              `<a class="btn btn-sm" href="/admin/settings?tab=team">${escHtml(tr("home.noteTeamAdd"))}</a>`;
            return;
          }
          const cella = (id: string, nome: string, foto: string) => {
            // ⚠️ `referrerpolicy` e un `onerror` che torna alle iniziali: una
            // foto che non carica lascerebbe un cerchio vuoto, che non dice
            // niente e sembra un guasto.
            // ⚠️ Le iniziali ci sono SEMPRE, e la foto ci sta sopra: cosi'
            // `onerror` deve solo togliere l'immagine, e sotto c'e' gia' da
            // vedere. Un cerchio vuoto non dice niente e sembra un guasto.
            const dentro = escHtml(iniziali(nome)) +
              (foto ? `<img src="${escHtml(foto)}" alt="" referrerpolicy="no-referrer" onerror="this.remove()" />` : "");
            return `<button type="button" class="nc-p${id === chiSel ? " is-on" : ""}" data-chi="${escHtml(id)}">` +
              `<span class="j-av" style="background:${id ? coloreDi(nome) : "transparent"}">${dentro}</span>` +
              `<span class="n">${escHtml(nome)}</span></button>`;
          };
          boxChi.innerHTML =
            `<div class="nc-chi-grid">` +
            squadra.map((p) => cella(p.id, p.name, p.foto)).join("") +
            `</div>`;
        }

        const swChi = document.getElementById("nc-chi-on") as HTMLInputElement;
        swChi.addEventListener("change", () => {
          boxChi.hidden = !swChi.checked;
          // ⚠️ Spegnendo si DIMENTICA la scelta, non la si nasconde: una
          // faccia ancora selezionata sotto un interruttore spento verrebbe
          // salvata lo stesso, e la nota partirebbe assegnata a chi si era
          // deciso di non assegnare.
          if (!swChi.checked) chiSel = "";
          else { disegnaChi(); void leggiSquadra().then(() => { if (!boxChi.hidden) disegnaChi(); }); }
        });

        boxChi.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".nc-p") as HTMLButtonElement | null;
          if (!b) return;
          chiSel = b.dataset.chi ?? "";
          disegnaChi();
        });

        const chiScelto = (): string => chiSel;

        // ---------- Scadenza e ricorrenza ----------
        /** I nomi dei giorni e dei mesi nella lingua dell'admin, dal browser.
         *  ⚠️ `Intl` e non diciannove chiavi tradotte cinque volte: sono parole
         *  che ogni browser conosce gia', e una traduzione nostra sarebbe
         *  novantacinque occasioni di scriverne una storta.
         *  2024 e' bisestile: serve per avere un 29 febbraio da nominare. */
        const nomeGiorno = (dow: number) =>
          new Intl.DateTimeFormat(LOC, { weekday: "long" }).format(new Date(Date.UTC(2024, 0, 1 + ((dow - 1) % 7))));
        const nomeMese = (m: number) =>
          new Intl.DateTimeFormat(LOC, { month: "long" }).format(new Date(Date.UTC(2024, m - 1, 15)));

        function riempiScelte(): void {
          if (selDow.options.length) return;
          for (let g = 1; g <= 7; g++) selDow.add(new Option(nomeGiorno(g), String(g)));
          for (let d = 1; d <= 31; d++) selDom.add(new Option(String(d), String(d)));
          for (let m = 1; m <= 12; m++) selMese.add(new Option(nomeMese(m), String(m)));
        }

        /** Quali caselle servono alla regola scelta: il giorno della settimana
         *  per «ogni settimana», il numero per «ogni mese», mese e numero per
         *  «ogni anno». Le altre non si svuotano — si nascondono: chi cambia
         *  idea e torna indietro ritrova quello che aveva scelto. */
        function aggiornaRipeti(): void {
          const o = selOgni.value;
          selDow.hidden = o !== "settimana";
          selDom.hidden = o !== "mese" && o !== "anno";
          selMese.hidden = o !== "anno";
        }
        selOgni.addEventListener("change", aggiornaRipeti);

        /** I pannelli seguono le due etichette. */
        function aggiornaPannelli(): void {
          panQuando.hidden = !tagSel.has("important");
          panRipeti.hidden = !tagSel.has("recurrent");
          if (!panRipeti.hidden) { riempiScelte(); aggiornaRipeti(); }
        }

        /** La regola da mandare al server, o `null` se «Ricorrente» e' spenta. */
        function regolaScelta(): Record<string, unknown> | null {
          if (panRipeti.hidden) return null;
          const ora = campoOra.value || "09:00";
          const o = selOgni.value;
          if (o === "settimana") return { ogni: o, ora, dow: Number(selDow.value) };
          if (o === "mese") return { ogni: o, ora, dom: Number(selDom.value) };
          if (o === "anno") return { ogni: o, ora, dom: Number(selDom.value), mese: Number(selMese.value) };
          return { ogni: "giorno", ora };
        }

        /** I tag gia' usati nelle altre note, come pastiglie da premere.
         *  ⚠️ Si leggono dalle NOTE, senza una tabella dei tag da tenere
         *  pulita: il giorno in cui l'ultima nota con «metro» viene
         *  cancellata, «metro» smette di proporsi da solo. Un elenco a parte
         *  avrebbe continuato a offrirlo per sempre.
         *  I tre noti sono gia' nel markup e non si ripetono. */
        function disegnaTagUsati(): void {
          if (!tagsBox) return;
          const noti = new Set(Object.keys(TAG_LABEL));
          const visti = new Map<string, string>();
          for (const n of notes) {
            for (const t of Array.isArray(n.tags) ? n.tags : []) {
              const x = String(t).trim();
              if (!x || noti.has(x)) continue;
              if (!visti.has(x.toLowerCase())) visti.set(x.toLowerCase(), x);
            }
          }
          tagsBox.querySelectorAll(".nc-tag[data-usato]").forEach((b) => b.remove());
          // ⚠️ PRIMA del «+ etichetta», non in coda alla riga: quello e' il
          // bottone che apre il campo, e messo in mezzo alle etichette
          // diventa una quarta etichetta che non si accende.
          for (const x of visti.values()) tagsBox.insertBefore(bottoneTag(x), tagPiu);
        }

        /** Una pastiglia da premere. Lo stesso elemento dei tre del markup —
         *  stessa classe, stesso `data-tag` — cosi' il gestore del click non
         *  sa nemmeno che ne esistono di due provenienze. */
        function bottoneTag(x: string): HTMLButtonElement {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "nc-tag";
          b.dataset.tag = x;
          b.dataset.usato = "1";
          b.textContent = x;
          if (tagSel.has(x)) b.classList.add("is-on");
          return b;
        }

        /** Le etichette scritte a mano, UNA O PIU' separate da virgola.
         *  ⚠️ Scriverle non basta: senza questa funzione, chi scrive «metro» e
         *  preme «Ajouter» salva una nota senza quel tag — ha fatto tutto
         *  giusto e la parola sparisce.
         *  ⚠️ Il campo si svuota SOLO dopo aver letto tutto: svuotandolo in
         *  cima al giro, una virgola di troppo o un nome tutto spazi
         *  porterebbero via anche quelli buoni scritti accanto. */
        function aggiungiTagScritto(): void {
          const scritti = tagNew.value.split(",");
          let qualcosa = false;
          for (const grezzo of scritti) {
            const x = grezzo.replace(/\s+/g, " ").trim().slice(0, 24);
            if (x) { metteTag(x); qualcosa = true; }
          }
          if (qualcosa) tagNew.value = "";
        }

        /** Quante etichette stanno su una nota.
         *  ⚠️ Lo stesso numero di `MAX_TAG` in `api/admin/notes.ts`, che e'
         *  quello che DECIDE: il server taglia le eccedenti. Qui si ferma
         *  prima e lo si dice, perche' scriverne otto, vederne otto accese e
         *  poi ritrovarne cinque e' la stessa parola persa in silenzio che
         *  abbiamo appena tolto dall'API. */
        const MAX_TAG = 5;

        /** Una sola etichetta: la pastiglia che c'e' gia', o una nuova. */
        function metteTag(x: string): void {
          if (!x || !tagsBox) return;
          const nota = x.toLowerCase();
          const gia2 = [...tagSel].some((t) => t.toLowerCase() === nota);
          if (!gia2 && tagSel.size >= MAX_TAG) {
            msgEl.textContent = tr("home.noteTagMax").replace("{n}", String(MAX_TAG));
            return;
          }
          const gia = [...tagsBox.querySelectorAll<HTMLButtonElement>(".nc-tag")]
            .find((b) => (b.dataset.tag ?? "").toLowerCase() === x.toLowerCase());
          const b = gia ?? tagsBox.insertBefore(bottoneTag(x), tagPiu);
          const chiave = b.dataset.tag ?? x;
          tagSel.add(chiave);
          b.classList.add("is-on");
        }
        tagAdd.addEventListener("click", aggiungiTagScritto);
        tagPiu.addEventListener("click", () => {
          rigaNew.hidden = false;
          tagNew.focus();
        });
        // Invio: si sta scrivendo in un campo di una riga, e l'invio li' vuol
        // dire «questo e' finito» — non «salva la nota».
        tagNew.addEventListener("keydown", (e) => {
          if (e.key !== "Enter") return;
          e.preventDefault();
          aggiungiTagScritto();
        });

        saveBtn.addEventListener("click", async () => {
          const content = input.value.trim();
          if (!content) { input.focus(); return; }
          msgEl.textContent = "";
          saveBtn.disabled = true;
          try {
            // La stessa finestra scrive e corregge: cambia il verbo e un id.
            const res = await fetch("/api/admin/notes", {
              method: modificaId ? "PUT" : "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({
                ...(modificaId ? { id: modificaId } : {}),
                content, tags: [...tagSel],
                // ⚠️ L'orologio del campo viaggia COM'E' SCRITTO, senza fuso:
                // «10/03 alle 9» e' il server a metterlo nel fuso del locale.
                // Convertito qui, due telefoni su due fusi fisserebbero due
                // ore diverse per la stessa frase.
                // ⚠️ `dataset.iso` (2026-03-10), non `.value` (10/03/2026):
                // il testo e' per l'occhio, e mandato al server diventa una
                // data che nessuno rilegge — o, peggio, marzo letto come
                // ottobre.
                assigned_to: (swChi.checked && chiScelto()) || null,
                due_at: panQuando.hidden || !campoDue.dataset.iso
                  ? null
                  : `${campoDue.dataset.iso}T${campoDueOra.value || "12:00"}`,
                repeat: regolaScelta(),
              }),
            });
            if (res.ok) {
              const salvata = (await res.json()).note as Note;
              if (modificaId) {
                // ⚠️ Si SOSTITUISCE al suo posto, non si sposta: l'elenco e'
                // in ordine di scrittura, e togliere e rimettere in fondo
                // avrebbe fatto saltare in coda una nota di tre settimane fa
                // solo perche' le si e' corretta una parola.
                const i = notes.findIndex((x) => x.id === modificaId);
                if (i >= 0) notes[i] = salvata;
              } else {
                // ⚠️ In FONDO, non in cima: l'elenco va dalla piu' vecchia alla
                // piu' nuova, e `unshift` la metteva in testa — al ricaricamento
                // della pagina sarebbe saltata in fondo, cioe' la nota appena
                // scritta cambiava posto da sola.
                notes.push(salvata);
              }
              input.value = "";
              tagNew.value = "";
              azzeraTag();
              render();
              // ⚠️ Si chiude. Prima restava aperta perche' sotto c'era
              // l'elenco e si vedeva la nota comparire; adesso sotto non c'e'
              // niente, e una finestra vuota che resta aperta dopo aver fatto
              // il suo lavoro fa dubitare che l'abbia fatto. La nota si vede
              // comparire nella colonna dietro.
              closeModal();
            } else {
              msgEl.textContent = await erroreDa(res, tr("home.addFailed"));
            }
          } catch {
            msgEl.textContent = tr("common.netErr");
          } finally {
            saveBtn.disabled = false;
          }
        });


        try {
          const res = await fetch("/api/admin/notes", { headers });
          if (!res.ok) { preview.innerHTML = `<p class="np-empty">${tr("home.notesUnavailable")}</p>`; return; }
          const j = (await res.json()) as { notes?: Note[]; canDelete?: boolean };
          notes = j.notes ?? [];
          puoCancellare = j.canDelete === true;
          render();
          // ⚠️ La rubrica si legge SOLO se c'e' almeno una nota assegnata, e
          // il disegno si rifa' quando arriva. Leggerla sempre vorrebbe dire
          // una chiamata in piu' a ogni apertura della Accueil per una
          // lavagnetta in cui nessuno ha assegnato niente; aspettarla prima di
          // disegnare vorrebbe dire una colonna vuota finche' non risponde.
          if (notes.some((n) => n.assigned_to)) {
            void leggiSquadra().then(() => render());
          }
        } catch {
          preview.innerHTML = `<p class="np-empty">${tr("common.netErr")}</p>`;
        }
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const cardsEl = document.getElementById("cards") as HTMLDivElement;

        /** Colonne ATTUALI della griglia delle tile: unica fonte = --cols,
         *  impostata dalle media query di .cards. Ripiego a 4 se il CSS non
         *  e' ancora applicato (non dovrebbe mai capitare). */
        function colonne(): number {
          const v = parseInt(getComputedStyle(cardsEl).getPropertyValue("--cols"), 10);
          return Number.isFinite(v) && v >= 1 ? v : 4;
        }
        /** Larghezza "stretta": una colonna sola, quindi niente riordino. */
        const stretto = () => colonne() === 1;

        collegaLogout(logoutBtn);

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";

        // Saluto sopra le tile (solo mobile): parola che cambia ogni 5 secondi.
        const homeHello = document.getElementById("home-hello");
        if (homeHello) {
          const md = (session.user.user_metadata || {}) as Record<string, unknown>;
          const rawNome = String(md.full_name || md.name || md.first_name || md.given_name || md.nome || "").trim();
          const nome = rawNome ? rawNome.split(/\s+/)[0] : "";
          const SALUTI = ["Ciao", "Salut", "Hola", "Hallo", "Olá", "Hej", "Hello", "Hoi", "Ahoj"];
          let gi = Math.floor(Math.random() * SALUTI.length);
          homeHello.innerHTML = `<span class="hh-word">${escHtml(SALUTI[gi])}</span>${nome ? ` <strong>${escHtml(nome)}</strong>` : ""}`;
          const wEl = homeHello.querySelector(".hh-word") as HTMLElement | null;
          if (wEl) {
            setInterval(() => {
              gi = (gi + 1) % SALUTI.length;
              wEl.style.opacity = "0";
              wEl.style.transform = "translateY(-6px)";
              setTimeout(() => {
                wEl.textContent = SALUTI[gi];
                wEl.style.opacity = "1";
                wEl.style.transform = "translateY(0)";
              }, 350);
            }, 5000);
          }
        }
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        const oggi = new Date();
        const oggiKey = dayKey(oggi);

        const token = session.access_token ?? "";
        let headers = { Authorization: `Bearer ${token}` };

        /** La sede selezionata nell'header, per le chiamate agli endpoint
         *  PUBBLICI: quelli non guardano il cookie apposta (vedi
         *  `ambitoPubblicoChiesto`), quindi glielo si passa a mano.
         *  Nessuna sede selezionata = niente header = comportamento di sempre. */
        function hSede(): Record<string, string> {
          const m = /(?:^|;\s*)mdd_sede=([^;]*)/.exec(document.cookie);
          const v = m ? decodeURIComponent(m[1]).trim() : "";
          return v && v !== "tutte" ? { "x-sede": v } : {};
        }

        // Il token Supabase SCADE (di norma dopo un'ora). Con `headers` fissato
        // una volta sola al caricamento, un tab lasciato aperto continuava a
        // mandare il token vecchio: ogni salvataggio tornava «Non autorisé»,
        // e in certi punti il campo spariva senza spiegazione. supabase-js
        // rinnova il token da solo in background: qui ci limitiamo ad
        // ASCOLTARLO e a riscrivere l'header. Nessuna chiamata da cambiare.
        supabaseBrowser.auth.onAuthStateChange((_evento, sessione) => {
          if (sessione?.access_token) headers = { Authorization: `Bearer ${sessione.access_token}` };
        });

        // Cards visibili subito; Notes e tile si popolano in parallelo.
        stateEl.style.display = "none";
        cardsEl.style.display = "grid";
        // La fascia della giornata compare col resto: le sue tre colonne si
        // accendono una per una, quando i loro dati arrivano.
        const jourEl = document.getElementById("jour");
        if (jourEl) jourEl.style.display = "";

        // Organiser: solo su schermi larghi (su mobile le tuiles sono impilate)
        // ⚠️ E solo se c'e' almeno un'ISOLA da organizzare. Da quando tutto e'
        // salito nella fascia la griglia e' vuota, e tre bottoni che aprono
        // una finestra vuota sono tre bottoni che fanno perdere tempo.
        const isole = cardsEl?.querySelectorAll(".tile[data-tile]").length ?? 0;
        const fabOrg = document.getElementById("organiser-btn");
        const petit = stretto();
        if (fabOrg && !petit && isole) fabOrg.style.display = "flex";
        // Sur mobile : pas de réorganisation, mais on garde le choix des tuiles
        const fabTui = document.getElementById("organiser-tuiles");
        if (fabTui && petit && isole) fabTui.style.display = "flex";
        posizionaIsole();

        // ---- Allineamento isole (SOLO home): ingranaggio Admin subito a sinistra
        // dell'isola dei link; FAB Organiser a sinistra, centrato con l'isola.
        function posizionaIsole() {
          const nav = document.querySelector(".admin-nav") as HTMLElement | null;
          if (!nav) return;
          // Deve combaciare con fab.css (641): sotto, i FAB stanno sopra la barra.
          const largo = window.matchMedia("(min-width: 641px)").matches;
          const r = nav.getBoundingClientRect();
          const base = window.innerHeight - r.bottom + (r.height - 52) / 2;
          const STEP = 66; // spaziatura verticale tra i FAB impilati
          const off: Record<string, number> = { "organiser-btn": 0, "organiser-reset": STEP, "organiser-tuiles": STEP * 2 };
          for (const id of ["organiser-btn", "organiser-reset", "organiser-tuiles"]) {
            const el = document.getElementById(id) as HTMLElement | null;
            if (el) el.style.bottom = largo ? `${base + (off[id] ?? 0)}px` : "";
          }
        }
        window.addEventListener("resize", posizionaIsole);

        avviaNote(headers);

        // ---------- Visibilité: Search Console, 28 giorni ----------
        // ⚠️ Fuori dal giro degli altri dati: la risposta passa da Google e
        // puo' metterci qualche secondo. Attaccata al resto, tutta la fascia
        // avrebbe aspettato lei.
        void caricaVis(visPeriodo);

        // ---------- Recettes: i soldi del mese ----------
        // ⚠️ Anche questa per conto suo: e' una lettura di tutti gli ordini
        // del periodo, e il resto della fascia non deve aspettarla.
        void caricaRec(recPeriodo);

        // ---------- Photos: la bibliotheque, intera ----------
        // ⚠️ INTERA e non «le ultime otto»: il tetto era il modo di far stare
        // la libreria in una tile, e nascondeva proprio le foto vecchie — che
        // sono quelle che nessuno usa piu'. La colonna le mostra tutte e
        // scorre dentro, come le altre.
        (async () => {
          const lista = document.getElementById("j-foto-lista");
          try {
            const res = await fetch("/api/admin/images", { headers });
            if (!res.ok) throw new Error();
            fotoTutte = (((await res.json()) as { images?: FotoRow[] }).images) ?? [];
            const col = document.getElementById("j-foto");
            if (col) col.style.display = "";
            const nums = document.getElementById("j-foto-nums");
            if (nums) nums.style.display = "";
            disegnaFoto();
          } catch {
            // ⚠️ La colonna resta spenta, e non mezza vuota con una frase
            // d'errore: quando lo Storage non risponde non c'e' niente da
            // dire che aiuti, e tre riquadri a trattino sembrerebbero una
            // libreria vuota.
            if (lista) lista.innerHTML = `<div class="ph-grid"><div class="ph-empty">${tr("home.imagesUnavailable")}</div></div>`;
          }
        })();

        // ---------- Événements du pays ----------
        // Feste legali + ricorrenze commerciali del PAESE scelto in Réglages →
        // Général, piu' gli eventi del locale. Le date non si calcolano piu'
        // qui: stavano scritte a mano e erano quelle belghe, quindi un cliente
        // francese vedeva il 21 luglio e non il 14. Adesso vengono da
        // `festivitaRegole.ts`, che e' puro e ha la sua rete di prove.
        let eventiLocali: { date: string; label: string; yearly: boolean }[] = [];
        let paeseEventi = "";
        async function caricaEventiLocali(): Promise<void> {
          try {
            const res = await fetch("/api/admin/events", { headers });
            if (res.ok) {
              const j = (await res.json()) as { events?: typeof eventiLocali; paese?: string };
              eventiLocali = j.events ?? [];
              paeseEventi = j.paese ?? "";
            }
          } catch { /* niente eventi locali */ }
        }
        /* ============================================================
           JOURS SPÉCIAUX — una colonna, una linea del tempo
           ------------------------------------------------------------
           ⚠️ Qui c'erano DUE disegni per lo stesso giorno: la tile elencava i
           giorni speciali del ristoratore, e in un riquadro sotto le prossime
           feste del calendario. Natale compariva due volte — una come chiusura
           sua, una come festa — e niente diceva che erano la stessa riga; una
           delle due poteva dire «fermé» mentre l'altra diceva ancora «ouvert».
           Adesso le due fonti si fondono per data in `fondi()`
           (`giorniSpecialiRegole.ts`, provato a parte) e qui resta il disegno.

           ⚠️ UNA FESTA NON CHIUDE NIENTE — lo dice `festivitaRegole.ts` e vale
           anche qui: una pizzeria lavora il 1° maggio. Una festa senza giorno
           speciale non e' un allarme: e' una riga che dice cosa fara' il sito
           quel giorno, e la decisione resta a chi apre il ristorante.
           ============================================================ */
        type SpxDay = {
          id?: string; type: string; date_from: string; date_to: string;
          note?: string | null;
          lunch_open?: string | null; lunch_close?: string | null;
          dinner_open?: string | null; dinner_close?: string | null;
          services?: string[] | null;
        };
        let spxDays: SpxDay[] = [];
        let spxRighe: RigaSpeciale[] = [];
        let spxFiltro: TipoRiga | "" = "";

        /** Le date chiuse, giorno per giorno: il calendario le segna.
         *  ⚠️ Una chiusura e' un INTERVALLO (`date_from` → `date_to`): due
         *  settimane di ferie sono una riga sola, e segnando solo il primo
         *  giorno il calendario direbbe aperto per tredici giorni di chiusura.
         *  Si aprono tutti, con un tetto perche' una data scritta storta non
         *  mandi il browser a contare fino al 3000. */
        function segnaChiusure(days: SpxDay[]): void {
          chiusiSpeciali.clear();
          for (const sp of days) {
            if (sp.type !== "closed") continue;
            const d = new Date(String(sp.date_from) + "T12:00:00");
            const fine = new Date(String(sp.date_to || sp.date_from) + "T12:00:00");
            if (Number.isNaN(d.getTime()) || Number.isNaN(fine.getTime())) continue;
            for (let i = 0; d <= fine && i < 400; i++, d.setDate(d.getDate() + 1)) {
              chiusiSpeciali.add(dayKey(d));
            }
          }
        }

        const spxFmt = (iso: string, opz: Intl.DateTimeFormatOptions): string =>
          new Date(iso + "T12:00:00").toLocaleDateString(LOC, opz);

        /** Le feste del paese e gli eventi del locale, in una lista sola.
         *  ⚠️ Le legali PRIMA delle ricorrenze: il giorno che cadono insieme
         *  (in Germania la festa del papa' E' l'Ascensione) `fondi()` tiene la
         *  prima, e quella che pesa e' la festa legale. */
        function spxFeste(oggi: string, fino: string): Festa[] {
          const out: Festa[] = [];
          const anno = Number(oggi.slice(0, 4));
          for (const a of [anno, anno + 1]) {
            for (const f of [...festivita(paeseEventi, a), ...ricorrenze(paeseEventi, a)]) {
              out.push({ iso: f.data, nome: f.nome[LANG] ?? f.nome.fr });
            }
          }
          for (const ev of eventiLocali) {
            if (ev.yearly) {
              const mmdd = ev.date.slice(5);
              out.push({ iso: `${anno}-${mmdd}`, nome: ev.label, locale: true });
              out.push({ iso: `${anno + 1}-${mmdd}`, nome: ev.label, locale: true });
            } else {
              out.push({ iso: ev.date, nome: ev.label, locale: true });
            }
          }
          return out.filter((f) => f.iso >= oggi && f.iso <= fino);
        }

        /** Cosa fara' il sito nei giorni NON decisi: aperto o chiuso comunque.
         *
         *  ⚠️ La stessa fonte del widget (`/api/reservation?month=`, orari
         *  settimanali + giorni speciali), non una regola riscritta qui: un
         *  pannello che si calcola gli orari per conto suo finisce per dire
         *  «ouvert» un giorno in cui il cliente trova chiuso.
         *
         *  ⚠️ `noto: false` quando la richiesta non risponde, e allora la riga
         *  NON scrive niente. Ripiegare su «ouvert» vorrebbe dire inventare la
         *  risposta piu' rassicurante proprio quando non la sappiamo.
         *
         *  Tre mesi al massimo: e' una riga di informazione, e non vale tre
         *  richieste in piu' per le feste di luglio. */
        async function spxChiusi(righe: RigaSpeciale[]): Promise<{ chiusi: Set<string>; noto: boolean }> {
          const chiusi = new Set<string>();
          const mesi = [...new Set(righe.filter((r) => !r.deciso).map((r) => r.iso.slice(0, 7)))].slice(0, 3);
          if (!mesi.length) return { chiusi, noto: true };
          try {
            const risp = await Promise.all(
              mesi.map((m) => fetch("/api/reservation?month=" + m, { headers: hSede() }).then((r) => r.json())),
            );
            for (const rr of risp) for (const d of rr.closed ?? []) chiusi.add(String(d));
            return { chiusi, noto: true };
          } catch {
            return { chiusi, noto: false };
          }
        }

        /** Un giorno sul calendarietto: numero grande, mese piccolo. */
        const spxGiorno = (iso: string): string =>
          `<b>${Number(iso.slice(8, 10))}</b><i>${escHtml(spxFmt(iso, { month: "short" }).replace(".", ""))}</i>`;

        function rigaSpx(r: RigaSpeciale, chiusi: Set<string>, noto: boolean): string {
          /* ⚠️ UN PERIODO HA DUE DATE, e la seconda non e' un dettaglio da
             riga di servizio: «chiuso dal 19 al 25» e' la cosa che si guarda.
             Stava scritta in mezzo alla frase sotto («lunedì · fino al 25 ott
             · 7 giorni»), cioe' nel posto in cui si legge per ultimo. Sale sul
             calendarietto, sotto la data d'inizio: due numeri grandi, e la
             freccia dice che e' un intervallo e non due giorni staccati. */
          const cal = r.fine
            ? `<span class="ev-cal due">${spxGiorno(r.iso)}<em>↓</em>${spxGiorno(r.fine)}</span>`
            : `<span class="ev-cal">${spxGiorno(r.iso)}</span>`;
          const badge =
            r.tipo === "closed" ? `<span class="spx-b closed">${tr("home.tagClosed")}</span>`
              : r.tipo === "open" ? `<span class="spx-b open">${tr("home.spxHoursTag")}</span>`
                : `<span class="spx-b fete">${tr("home.spxFete")}</span>`;
          /* ⚠️ IL MOTIVO E' IL NOME DELLA RIGA. «Vacanze Autunno» dice piu' di
             «CHIUSO» ripetuto dieci volte, ed e' la parola che si cerca quando
             si scorre la colonna. Stava in fondo, in corsivo, al posto delle
             note dei clienti.
             Se la riga ha ANCHE una festa, il nome resta quello della festa e
             il motivo torna sotto: sono due cose diverse — come si chiama quel
             giorno, e perche' si chiude. */
          const nome = r.titolo || r.nota || "";
          /* ⚠️ Il nome in BIANCO, anche quando l'evento e' suo. Era in corallo
             per farlo ritrovare fra venti feste di calendario — ma adesso
             quell'evento ha il cestino, che le feste non hanno: chi e' suo si
             vede dal fatto che si puo' buttare via. Due segni per la stessa
             cosa, e il corallo era quello che costava il colore del titolo. */
          const titolo = nome ? `<span class="ev-nome">${escHtml(nome)}</span>` : "";
          const ore = [r.pranzo, r.cena]
            .filter((f): f is [string, string] => Array.isArray(f))
            .map((f) => `${f[0]} – ${f[1]}`)
            .join("  ·  ");
          /* LA MISURA DELLA RIGA: una sola, scelta per importanza.
             Un periodo dura («7 giorni»), un giorno aperto ha degli orari
             («11:00 – 23:30»), tutto il resto ha il suo giorno della settimana.
             Rispondono alla stessa domanda — «quanto» — e stavano su tre righe
             diverse, due in bianco grande e una in grigio piccolo: la stessa
             colonna si leggeva in tre modi.
             ⚠️ Il giorno della settimana NON va sui periodi: «lunedì» e' il
             giorno d'inizio, e accanto a due date fa credere che si chiuda di
             lunedi'. Ne' sui giorni con gli orari: la data sta gia' nel
             calendarietto, e la riga serve a dire a che ora si apre.
             ⚠️ In BIANCO quando e' un numero (giorni, ore), in grigio quando e'
             solo il giorno: il numero e' cio' che si legge, il giorno e' il
             contorno di una data che sta li' accanto. */
          const misura = r.fine
            ? `<span class="j-spx-dur">${escHtml(tr("home.spxDays").replace("{n}", String(r.giorni)))}</span>`
            : ore
              ? `<span class="j-spx-dur">${escHtml(ore)}</span>`
              : `<span class="j-spx-gg">${escHtml(spxFmt(r.iso, { weekday: "long" }))}</span>`;
          /* Cosa succede quel giorno, sulla riga della festa: APERTO o CHIUSO,
             la stessa pastiglia verde e rossa dei giorni decisi.
             ⚠️ Solo se la risposta ce l'abbiamo DAVVERO (`noto`): quando l'API
             pubblica non risponde non si scrive niente. Una pastiglia verde
             messa per ripiego direbbe «aperto» un giorno di chiusura, ed e'
             l'unica riga della colonna che qualcuno potrebbe leggere di corsa
             senza aprire niente.
             ⚠️ E solo sulle feste NON decise: su una chiusura vera la pastiglia
             c'e' gia' ed e' quella di sinistra — due pastiglie che dicono la
             stessa cosa sono una che si contraddira'. */
          const stato = !r.deciso && noto
            ? (chiusi.has(r.iso)
                ? `<span class="spx-b closed">${tr("home.tagClosed")}</span>`
                : `<span class="spx-b open">${tr("home.tagOpen")}</span>`)
            : "";
          // La nota scende qui solo se non e' gia' il nome della riga.
          const nota = r.nota && r.nota !== nome
            ? `<span class="j-nota">${ICO_NOTA}<span>${escHtml(r.nota)}</span></span>`
            : "";
          /* ⚠️ UN SERVIZIO E' «chiave|orario», non una chiave. Nel database un
             giorno «aperto» salva `soir|17:00-22:30`, e stampando il valore
             cosi' com'e' la riga diceva «SOIR|17:00-22:30» — il nome del
             servizio in una lingua che non e' nessuna, e l'orario attaccato
             con una barra. Si spezza come fa il modulo che l'ha scritto. */
          const serv = (r.servizi ?? [])
            .map((tok) => {
              const [k, h] = String(tok).split("|");
              const nome = nomeServizio(k, LANG);
              return `<span class="j-tag">${escHtml(h ? `${nome} ${h.replace("-", "–")}` : nome)}</span>`;
            })
            .join("");
          /* Il cestino c'e' su cio' che QUALCUNO HA SCRITTO: le chiusure, le
             aperture eccezionali e gli eventi del locale. Non sulle feste del
             calendario — tornerebbero l'anno prossimo comunque, e un cestino
             che non cancella niente e' peggio di nessun cestino.
             ⚠️ `data-sid` porta l'id del giorno speciale; vuoto vuol dire che
             la riga e' un evento locale, che vive in un'altra lista e si
             cancella in un altro modo. Senza, il cestino avrebbe dovuto
             indovinare da che parte andare.
             ⚠️ `.ibtn.ibtn-danger`: il cestino del pannello, con la sua guardia
             a due tocchi. Era riscritto in otto pagine con otto nomi; questa
             non fa la nona. */
          const cancellabile = r.locale || (r.deciso && Boolean(r.id));
          const cestino = cancellabile
            ? `<button type="button" class="ibtn ibtn-danger j-spx-del" data-sid="${escHtml(r.id ?? "")}" title="${escHtml(tr("common.delete"))}" aria-label="${escHtml(tr("common.delete"))}">${TRASH_ICON}</button>`
            : "";
          // ⚠️ La riga INTERA e' il link al modulo, con la sua data dentro
          // (`?spx=`): la cosa che si vuole fare guardando questa colonna e'
          // cambiare quel giorno, e un bersaglio piccolo in una colonna che si
          // guarda col dito e' un bersaglio che si sbaglia.
          return `<a class="j-li j-spx-li${r.deciso ? "" : " aperta"}${r.oggi ? " oggi" : ""}` +
            `" data-iso="${r.iso}" data-nome="${escHtml(r.titolo)}"` +
            ` href="/admin/settings?tab=horaire&spx=${encodeURIComponent(r.iso)}">` +
            cal +
            `<span class="tx">` +
            /* ⚠️ SOPRA IL NOME, SOTTO COS'E'. Il nome («Vacanze Autunno»,
               «Halloween») e' quello che si cerca scorrendo la colonna, e con
               due pastiglie davanti si leggeva per terzo. Le pastiglie
               scendono accanto alla misura, dove rispondono alla domanda che
               viene dopo: quanto dura, e che cosa succede quel giorno.
               Senza nome la riga comincia direttamente da li': una riga vuota
               in cima sarebbe un buco che sembra un pezzo non caricato. */
            `<span class="j-spx-l1">${r.oggi ? `<span class="spx-b now">${tr("home.spxToday")}</span>` : ""}${titolo}</span>` +
            `<span class="j-spx-l2">${misura}${badge}${stato}</span>` +
            nota +
            (serv ? `<span class="j-tags">${serv}</span>` : "") +
            `</span>${cestino}</a>`;
        }

        function disegnaSpxFiltri(): void {
          const box = document.getElementById("j-spx-filtri");
          if (!box) return;
          // ⚠️ I QUATTRO SONO SEMPRE QUI, anche quando uno non ha righe: la
          // riga dei comandi non deve cambiare forma da sola (`TIPI_FILTRO`,
          // in `giorniSpecialiRegole.ts`). Una colonna vuota lo dice con la
          // sua frase, che e' una risposta vera.
          box.style.display = "";
          const nome: Record<TipoRiga, string> = {
            closed: tr("home.spxClosures"),
            // «Aperture»: sono le aperture eccezionali decise qui. La
            // pastiglia della riga resta «Horaires», che e' cosa cambia quel
            // giorno — un'altra domanda.
            open: tr("home.spxOpenings"),
            fete: tr("home.spxFetes"),
          };
          const chip = (val: string, testo: string, ico = ""): string =>
            `<button type="button" class="rh-filter${ico ? " tutte" : ""}${val === spxFiltro ? " is-on" : ""}"` +
            ` data-f="${escHtml(val)}"${ico ? ` aria-label="${escHtml(testo)}" title="${escHtml(testo)}"` : ""}>` +
            `${ico}<span class="et">${escHtml(testo)}</span></button>`;
          box.innerHTML = chip("", tr("home.notesAll"), ICO_TUTTE) +
            TIPI_FILTRO.map((t) => chip(t, nome[t])).join("");
        }

        function disegnaSpx(chiusi: Set<string>, noto: boolean): void {
          const col = document.getElementById("j-spx");
          const lista = document.getElementById("j-spx-lista");
          if (!col || !lista) return;
          col.style.display = "";
          const viste = spxFiltro ? spxRighe.filter((r) => r.tipo === spxFiltro) : spxRighe;
          // ⚠️ Due vuoti diversi, come nella colonna delle note: «non ce n'e'»
          // e «nessuna di queste». Col filtro acceso, «nessun giorno speciale»
          // sarebbe falso — i giorni ci sono, e' il filtro che li nasconde.
          lista.innerHTML = viste.length
            ? viste.map((r) => rigaSpx(r, chiusi, noto)).join("")
            : `<p class="j-vuoto">${spxFiltro ? tr("home.nothingToShow") : tr("home.noSpecialDays")}</p>`;
          disegnaSpxFiltri();
          const c = conti(spxRighe);
          // ⚠️ La pastiglia conta le DECISIONI, non le righe: le feste sono
          // contorno, e un «12» fatto di feste direbbe che c'e' da lavorare
          // dove non c'e' niente da fare.
          pastigliaConta("j-spx-cnt", c.chiusure + c.orari);
          numero("j-spx-ferm", String(c.chiusure),
            c.giorniChiusi ? tr("home.spxDays").replace("{n}", String(c.giorniChiusi)) : "");
          numero("j-spx-ore", String(c.orari), "");
          // ⚠️ «Prossima» e' quella NON ANCORA cominciata (vedi `conti`). Se
          // una chiusura e' in corso adesso non si perde: la riga sotto lo
          // dice, invece di lasciare un trattino muto accanto a un locale
          // chiuso oggi.
          numero("j-spx-next",
            c.prossimaChiusura ? spxFmt(c.prossimaChiusura, { day: "numeric", month: "short" }) : "—",
            c.prossimaChiusura
              ? spxFmt(c.prossimaChiusura, { weekday: "short" })
              : c.chiusuraInCorso ? tr("home.spxToday") : "");
          const nums = document.getElementById("j-spx-nums");
          if (nums) nums.style.display = "";
        }

        /** ⚠️ Il nome resta `renderEventi` perche' lo chiama il modale degli
         *  eventi locali dopo ogni aggiunta e cancellazione: li' vuol dire «le
         *  date sono cambiate, ridisegna», ed e' esattamente questo. */
        async function renderEventi(): Promise<void> {
          const oggi = new Intl.DateTimeFormat("en-CA", { timeZone: TZ_LOCALE }).format(new Date());
          const fino = piuGiorni(oggi, 90);
          spxRighe = fondi({ speciali: spxDays, feste: spxFeste(oggi, fino), oggi, fino });
          // ⚠️ Si disegna DUE volte, e non e' uno spreco: la colonna compare
          // subito con cio' che sappiamo (le date, le chiusure, gli orari), e
          // la riga «ouvert / fermé» delle feste arriva quando risponde l'API
          // pubblica. Aspettando la rete, mezza fascia resterebbe vuota per
          // una frase di contorno.
          disegnaSpx(new Set<string>(), false);
          const { chiusi, noto } = await spxChiusi(spxRighe);
          if (noto) disegnaSpx(chiusi, noto);
        }

        /** Cliccare una riga apre il modale di QUESTA pagina, sulla linguetta
         *  delle chiusure e con la data gia' dentro.
         *
         *  ⚠️ L'indirizzo nella riga resta vero e porta a Réglages → Horaires:
         *  serve a chi apre in una scheda nuova (⌘-clic, rotellina) e a chi
         *  legge la pagina senza JavaScript. Un `href="#"` avrebbe tolto tutte
         *  e due le cose per far funzionare un clic che funziona lo stesso. */
        /** L'evento del locale che questa riga mostra, dentro `eventiLocali`.
         *
         *  ⚠️ Non basta la data: un evento «ogni anno» e' scritto UNA volta e
         *  la colonna lo disegna in due anni diversi, quindi la riga del 2027
         *  ha una data che nella lista non esiste. Si confronta il giorno e il
         *  mese, e il nome. `-1` = non e' suo, e allora non si cancella niente:
         *  meglio un cestino che non fa nulla di una riga cancellata a caso. */
        function indiceEventoLocale(iso: string, nome: string): number {
          return eventiLocali.findIndex((ev) =>
            ev.label === nome && (ev.yearly ? ev.date.slice(5) === iso.slice(5) : ev.date === iso));
        }

        document.getElementById("j-spx-lista")?.addEventListener("click", (ev) => {
          const m = ev as MouseEvent;
          if (m.metaKey || m.ctrlKey || m.shiftKey || m.button !== 0) return;
          const a = (ev.target as HTMLElement).closest(".j-spx-li") as HTMLElement | null;
          if (!a) return;

          // ⚠️ Il cestino sta DENTRO il link: senza fermare l'evento, il primo
          // tocco aprirebbe anche il modale — e il secondo lo troverebbe
          // davanti, cioe' la cancellazione non si potrebbe confermare.
          const del = (ev.target as HTMLElement).closest(".j-spx-del") as HTMLButtonElement | null;
          if (del) {
            ev.preventDefault();
            ev.stopPropagation();
            // Primo tocco: la pastiglia si allarga e chiede. Si disarma da
            // sola dopo tre secondi, come gli altri cestini del pannello.
            if (!del.classList.contains("confirm")) {
              del.classList.add("confirm");
              del.textContent = tr("home.deleteQ");
              window.setTimeout(() => { del.classList.remove("confirm"); del.innerHTML = TRASH_ICON; }, 3000);
              return;
            }
            // Un giorno speciale lo cancella il form (che possiede l'elenco e
            // sa rileggerlo); un evento locale lo cancella il modale, che
            // possiede la sua lista. La colonna dice solo QUALE riga.
            const sid = del.dataset.sid ?? "";
            if (sid) {
              document.dispatchEvent(new CustomEvent("spf:cancella", { detail: { id: sid } }));
              return;
            }
            const i = indiceEventoLocale(a.dataset.iso ?? "", a.dataset.nome ?? "");
            if (i >= 0) document.dispatchEvent(new CustomEvent("evt:cancella", { detail: { i } }));
            return;
          }

          ev.preventDefault();
          document.dispatchEvent(new CustomEvent("spx:apri", { detail: { iso: a.dataset.iso ?? "" } }));
        });

        document.getElementById("j-spx-filtri")?.addEventListener("click", (ev) => {
          const b = (ev.target as HTMLElement).closest(".rh-filter") as HTMLElement | null;
          if (!b) return;
          spxFiltro = (b.dataset.f ?? "") as TipoRiga | "";
          void renderEventi();
        });

        /** Il form dei giorni speciali (nel modale di questa pagina e in
         *  Réglages) rilancia `spf:loaded` dopo ogni aggiunta o cancellazione:
         *  la colonna si ridisegna con QUEI dati, senza un secondo fetch e
         *  senza ricaricare la pagina. */
        document.addEventListener("spf:loaded", (e) => {
          const d = (e as CustomEvent<{ days?: SpxDay[] }>).detail?.days;
          if (!Array.isArray(d)) return;
          spxDays = d;
          segnaChiusure(spxDays);
          void renderEventi();
        });

        void (async () => {
          await caricaEventiLocali();
          try {
            const res = await fetch("/api/admin/special-days", { headers });
            if (res.ok) spxDays = ((await res.json()) as { days?: SpxDay[] }).days ?? [];
          } catch { /* la colonna mostrera' le feste e basta */ }
          // ⚠️ PRIMA del disegno: le chiusure si segnano anche quando la lista
          // e' vuota o la colonna non c'e' — un calendario senza puntini su un
          // locale che chiude due settimane.
          segnaChiusure(spxDays);
          void renderEventi();
        })();


        // ---------- Modale Evenements locaux (il bottone in fondo alla colonna) ----------
        (() => {
          const evtOverlay = document.getElementById("evt-overlay") as HTMLDivElement | null;
          const evtBtn = document.getElementById("spx-add") as HTMLButtonElement | null;
          if (!evtOverlay || !evtBtn) return;
          const evtNom = document.getElementById("evt-nom") as HTMLInputElement;
          const evtDate = document.getElementById("evt-date") as HTMLInputElement;
          const evtYear = document.getElementById("evt-yearly") as HTMLInputElement;
          const evtAdd = document.getElementById("evt-add") as HTMLButtonElement;
          const evtList = document.getElementById("evt-list") as HTMLDivElement;
          // ⚠️ Una FUNZIONE, non una copia: `headers` viene riscritto a ogni
          //    rinnovo del token, e una copia presa all'avvio resterebbe
          //    quella vecchia per sempre.
          const headersJson = () => ({ ...headers, "Content-Type": "application/json" });

          const fdFr = (iso: string) => { const [y, m, d] = iso.split("-"); return `${d}/${m}/${y}`; };
          const escE = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");

          function renderListaEvt() {
            evtList.innerHTML = eventiLocali.length
              ? eventiLocali
                  .map((ev, i) =>
                    `<div class="evm-row"><span class="d">${fdFr(ev.date)}</span><span class="n">${escE(ev.label)}</span>${ev.yearly ? `<span class="y">${tr("home.yearlyShort")}</span>` : ""}<button type="button" class="ibtn ibtn-danger evm-del" data-i="${i}" title="${tr("common.delete")}" aria-label="${tr("common.delete")}">${TRASH_ICON}</button></div>`
                  )
                  .join("")
              : `<div class="evm-vide">${tr("home.noLocalEvents")}</div>`;
          }
          async function salvaEvt(): Promise<boolean> {
            try {
              const res = await fetch("/api/admin/events", {
                method: "PUT",
                headers: headersJson(),
                body: JSON.stringify({ events: eventiLocali }),
              });
              return res.ok;
            } catch {
              return false;
            }
          }
          // Tab del modale: Événement local | Fermeture / ouverture
          const evtTabs = document.getElementById("evt-tabs") as HTMLDivElement | null;
          evtTabs?.addEventListener("click", (e) => {
            const b = (e.target as HTMLElement).closest<HTMLElement>(".m-tab");
            if (!b || !b.dataset.p) return;
            const p = b.dataset.p;
            evtTabs.querySelectorAll<HTMLElement>(".m-tab").forEach((x) => x.classList.toggle("is-on", x.dataset.p === p));
            evtOverlay.querySelectorAll<HTMLElement>(".evm-pane").forEach((x) => { x.hidden = x.dataset.p !== p; });
            // ⚠️ Anche il piede: senza, si vedrebbe «Aggiungi» dell'altra
            // linguetta — cioe' un bottone che crea la cosa che non si sta
            // guardando.
            evtOverlay.querySelectorAll<HTMLElement>(".evm-ok").forEach((x) => { x.hidden = x.dataset.p !== p; });
          });

          /** La colonna chiede di cancellare un evento locale.
           *  ⚠️ La cancellazione vive QUI, dove sta il resto della vita di
           *  `eventiLocali` (il salvataggio, il rinfresco dell'elenco, il
           *  ripiego quando il server dice di no): due posti che salvano la
           *  stessa lista diventano due liste il giorno che uno dei due
           *  sbaglia. La colonna dice COSA, non COME. */
          document.addEventListener("evt:cancella", async (e) => {
            const i = Number((e as CustomEvent<{ i?: number }>).detail?.i ?? -1);
            if (!Number.isInteger(i) || i < 0 || i >= eventiLocali.length) return;
            eventiLocali.splice(i, 1);
            if (await salvaEvt()) {
              renderListaEvt();
            } else {
              // Il server ha detto di no: si rilegge la verita' invece di
              // tenere a schermo una cancellazione che non c'e' stata.
              await caricaEventiLocali();
              renderListaEvt();
              toast(tr("us.editErr"), true);
            }
            void renderEventi();
          });

          document.getElementById("evt-add-cl")?.addEventListener("click", () => {
            document.dispatchEvent(new CustomEvent("spf:aggiungi"));
          });

          const apriEvt = () => { renderListaEvt(); evtOverlay.hidden = false; };
          /** La colonna «Jours spéciaux» apre QUESTO modale: il modulo delle
           *  chiusure e' la sua seconda linguetta, ed e' gia' in pagina.
           *  Mandare in Réglages per una cosa che si fa qui vorrebbe dire far
           *  perdere il posto in cui si era — e tornare indietro a mano.
           *  ⚠️ Un evento e non una funzione esportata: i due pezzi stanno in
           *  due chiusure diverse di questo stesso script, e il modale si
           *  monta DOPO la colonna. */
          document.addEventListener("spx:apri", (e) => {
            const iso = String((e as CustomEvent<{ iso?: string }>).detail?.iso ?? "");
            apriEvt();
            if (!iso) return;
            evtTabs?.querySelector<HTMLElement>('.m-tab[data-p="cl"]')?.click();
            document.dispatchEvent(new CustomEvent("spf:data", { detail: { iso } }));
          });
          const chiudiEvt = () => { evtOverlay.hidden = true; dpChiudi(); };
          evtBtn.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); apriEvt(); });
          // Sfondo e × del guscio condiviso: un solo aggancio, [data-md-close].
          evtOverlay.querySelectorAll("[data-md-close]").forEach((el) => el.addEventListener("click", chiudiEvt));

          evtAdd.addEventListener("click", async () => {
            const label = evtNom.value.trim();
            const iso = evtDate.dataset.iso ?? "";
            if (!label || !iso) return;
            eventiLocali.push({ date: iso, label, yearly: evtYear.checked });
            eventiLocali.sort((a, b) => (a.date < b.date ? -1 : 1));
            if (await salvaEvt()) {
              evtNom.value = "";
              evtDate.value = "";
              delete evtDate.dataset.iso;
              evtYear.checked = false;
              renderListaEvt();
              void renderEventi();
            } else {
              await caricaEventiLocali();
              renderListaEvt();
            }
          });

          evtList.addEventListener("click", async (e) => {
            const b = (e.target as HTMLElement).closest(".evm-del") as HTMLButtonElement | null;
            if (!b) return;
            if (!b.classList.contains("confirm")) {
              b.classList.add("confirm");
              b.textContent = tr("home.deleteQ");
              window.setTimeout(() => { b.classList.remove("confirm"); b.innerHTML = TRASH_ICON; }, 3000);
              return;
            }
            eventiLocali.splice(Number(b.dataset.i), 1);
            if (await salvaEvt()) {
              renderListaEvt();
              void renderEventi();
            } else {
              await caricaEventiLocali();
              renderListaEvt();
            }
          });

          // ----- Datepicker brand (copia locale, un solo campo) -----
          // Mesi e iniziali dei giorni calcolati dalla lingua admin (lunedì → domenica).
          const MESI_DP = Array.from({ length: 12 }, (_, i) => new Date(2021, i, 1).toLocaleDateString(LOC, { month: "long" }));
          const DOW_DP = Array.from({ length: 7 }, (_, i) => new Date(2021, 2, 1 + i).toLocaleDateString(LOC, { weekday: "narrow" }));
          let dpAnno = 0;
          let dpMese = 0;
          const dpPanel = document.createElement("div");
          dpPanel.className = "dp-panel";
          dpPanel.style.position = "absolute";
          dpPanel.style.display = "none";
          document.body.appendChild(dpPanel);

          const isoOggiDp = (): string => {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
          };
          const isoDiDp = (y: number, m: number, g: number): string =>
            `${y}-${String(m + 1).padStart(2, "0")}-${String(g).padStart(2, "0")}`;

          function dpRender() {
            const oggi = isoOggiDp();
            const sel = evtDate.dataset.iso ?? "";
            const offset = (new Date(dpAnno, dpMese, 1).getDay() + 6) % 7;
            const nGiorni = new Date(dpAnno, dpMese + 1, 0).getDate();
            const oy = Number(oggi.slice(0, 4));
            const om = Number(oggi.slice(5, 7)) - 1;
            const prevOff = dpAnno < oy || (dpAnno === oy && dpMese <= om);
            let celle = "";
            for (let i = 0; i < offset; i++) celle += '<span class="dp-cell dp-vuota"></span>';
            for (let g = 1; g <= nGiorni; g++) {
              const iso = isoDiDp(dpAnno, dpMese, g);
              const cls = ["dp-cell"];
              if (iso < oggi) cls.push("dp-off");
              if (iso === oggi) cls.push("dp-today");
              if (iso === sel) cls.push("dp-sel");
              celle += `<button type="button" class="${cls.join(" ")}" data-iso="${iso}" ${iso < oggi ? "disabled" : ""}>${g}</button>`;
            }
            dpPanel.innerHTML = `
              <div class="dp-head">
                <button type="button" class="dp-nav" data-nav="-1" ${prevOff ? "disabled" : ""}>‹</button>
                <span class="dp-title">${MESI_DP[dpMese]} ${dpAnno}</span>
                <button type="button" class="dp-nav" data-nav="1">›</button>
              </div>
              <div class="dp-dow">${DOW_DP.map((g) => `<span>${g}</span>`).join("")}</div>
              <div class="dp-grid">${celle}</div>`;
          }
          function dpApri() {
            document.querySelectorAll<HTMLElement>(".dp-panel").forEach((x) => { if (x !== dpPanel) x.style.display = "none"; });
            const base = evtDate.dataset.iso || isoOggiDp();
            dpAnno = Number(base.slice(0, 4));
            dpMese = Number(base.slice(5, 7)) - 1;
            dpRender();
            dpPanel.style.maxHeight = "";
            dpPanel.style.overflowY = "";
            dpPanel.style.display = "block";
            const r = evtDate.getBoundingClientRect();
            const pw = dpPanel.offsetWidth || 308;
            const ph = dpPanel.offsetHeight || 360;
            const gap = 6;
            const navReserve = window.innerWidth <= 900 ? 90 : 12;
            const headerReserve = 72;
            const spaceBelow = window.innerHeight - r.bottom - gap - navReserve;
            const spaceAbove = r.top - gap - headerReserve;
            let topVp: number;
            if (ph <= spaceBelow) {
              topVp = r.bottom + gap;
            } else if (ph <= spaceAbove) {
              topVp = r.top - gap - ph;
            } else if (spaceBelow >= spaceAbove) {
              topVp = r.bottom + gap;
              dpPanel.style.maxHeight = `${Math.max(220, spaceBelow)}px`;
              dpPanel.style.overflowY = "auto";
            } else {
              const h = Math.max(220, spaceAbove);
              topVp = r.top - gap - h;
              dpPanel.style.maxHeight = `${h}px`;
              dpPanel.style.overflowY = "auto";
            }
            const leftVp = Math.max(8, Math.min(r.left, window.innerWidth - pw - 8));
            dpPanel.style.left = `${leftVp + window.scrollX}px`;
            dpPanel.style.top = `${topVp + window.scrollY}px`;
          }
          function dpChiudi() {
            dpPanel.style.display = "none";
          }
          dpPanel.addEventListener("click", (e) => {
            e.stopPropagation();
            const t = e.target as HTMLElement;
            if (t.classList.contains("dp-nav")) {
              dpMese += Number(t.dataset.nav);
              if (dpMese < 0) { dpMese = 11; dpAnno--; }
              if (dpMese > 11) { dpMese = 0; dpAnno++; }
              dpRender();
              return;
            }
            if (t.classList.contains("dp-cell") && t.dataset.iso) {
              evtDate.dataset.iso = t.dataset.iso;
              evtDate.value = fdFr(t.dataset.iso);
              dpChiudi();
            }
          });
          evtDate.addEventListener("click", (e) => { e.stopPropagation(); dpApri(); });
          document.addEventListener("click", (e) => {
            if (dpPanel.style.display !== "none" && !dpPanel.contains(e.target as Node) && e.target !== evtDate) dpChiudi();
          });
          document.addEventListener("keydown", (e) => { if (e.key === "Escape") dpChiudi(); });
        })();

        try {
          // SSR (Fase 2): 5 isole pre-caricate dal server (ssr-home). Se
          // presenti, i tile principali appaiono all'istante senza fetch; le
          // statistiche (3) partono subito ma si attendono solo al momento
          // dell'uso, così non bloccano i primi tile. Senza SSR → come prima.
          // ⚠️ Un'isola ASSENTE non e' un'isola vuota: e' un rifiuto. L'SSR
          // non manda quello che chi guarda non puo' vedere, ed e' esattamente
          // quello che farebbe l'API con un 403 — quindi qui si risponde
          // `ok: false`, e i due rami si comportano uguale.
          const fakeRes = (obj: any) =>
            obj === undefined || obj === null
              ? { ok: false, json: async () => ({}) }
              : { ok: true, json: async () => obj };
          let ssrHome: any = null;
          try {
            const raw = document.getElementById("ssr-home")?.textContent?.trim();
            if (raw) ssrHome = JSON.parse(raw);
          } catch {
            ssrHome = null;
          }

          // ⚠️ Niente statistiche. La tile che le mostrava non c'e' piu', e
          // con lei sono spariti tre `fetch` a ogni caricamento della Accueil
          // — fatti anche a chi non aveva la pagina, che si prendeva tre 403
          // in console e credeva rotto quello che funzionava. Il fatturato si
          // guarda in /admin/stats, che e' la pagina che sa raccontarlo.
          let resOrd: any, resResa: any, resToday: any, resMenu: any, resCats: any;

          if (ssrHome) {
            resOrd = fakeRes(ssrHome.orders);
            resResa = fakeRes(ssrHome.resa);
            resToday = fakeRes(ssrHome.today);
            resMenu = fakeRes(ssrHome.menu);
            resCats = fakeRes(ssrHome.categories);
          } else {
            [resOrd, resResa, resToday, resMenu, resCats] = await Promise.all([
              fetch("/api/admin/orders", { headers }),
              fetch("/api/admin/reservations?date=" + oggiKey, { headers }),
              fetch("/api/admin/today", { headers }),
              fetch("/api/admin/menu", { headers }),
              fetch("/api/admin/categories", { headers }),
            ]);
          }

          // ---------- Commandes : la colonna di destra della giornata ----------
          // ⚠️ SOLO OGGI, e tutte: anche quelle gia' ritirate. Una riga che
          // sparisce appena e' fatta lascia una colonna che sembra l'inizio
          // del servizio anche a mezzanotte; spenta, dice quanta serata e'
          // passata senza farla contare.
          if (resOrd.ok) {
            const orders = ((await resOrd.json()).orders as Order[]) ?? [];
            const ordOggi = orders
              .filter((o) => dayKeyBrussels(o.pickup_time) === oggiKey && o.status !== "cancelled")
              .sort((a, b) => (a.pickup_time < b.pickup_time ? -1 : 1));
            ordiniOggi = ordOggi;

            const box = document.getElementById("j-ord");
            if (box) box.style.display = "";
            pastigliaGiorno("j-ord-cnt", ordOggi.length);

            // ⚠️ La lista e' quello che RESTA DA FARE (`daServire`, in
            // `ordiniConti.ts`): un ordine ritirato esce. Il conteggio in alto
            // invece li conta tutti, perche' e' il numero della giornata — ed
            // e' lo stesso da cui vengono i soldi qui sotto.
            const restano = daServire(ordOggi);
            const lista = document.getElementById("j-ord-lista") as HTMLElement | null;
            if (lista) {
              lista.innerHTML = restano.length
                // Come per le prenotazioni: l'elenco e' intero, e scorre dentro
                // il suo riquadro.
                ? restano.map((o) => rigaOrdine(o)).join("")
                : `<p class="j-vuoto">${tr("home.nothingToShow")}</p>`;
            }

            // ⚠️ I tre numeri vengono da `ordiniConti.ts`, lo stesso modulo
            // della pagina Commandes, delle statistiche e della mail del
            // mattino. «Incassato» sono i soldi ENTRATI: senza i rimborsi
            // (usciti) e senza i supplementi dovuti (mai entrati), e senza i
            // `pending`, che stanno nel terzo numero.
            const pagati = righeIncassate(ordOggi);
            const tot = incassato(ordOggi);
            const medio = panierMedio(ordOggi);
            const resta = restaDaIncassare(ordOggi);
            numero("j-ord-enc", euro(tot), tr("home.nOrders").replace("{n}", String(pagati.length)));
            // ⚠️ Un trattino e non «0,00 €»: un carrello medio a zero sembra un
            // dato — vuol dire «si e' venduto a prezzo zero» — mentre la verita'
            // e' che non si e' ancora venduto niente.
            numero("j-ord-pan", medio === null ? "—" : euro(medio), "");
            numero("j-ord-aenc", resta.importo ? euro(resta.importo) : "—",
              // ⚠️ «Au comptoir» solo se li si incassa davvero al banco: con un
              // link di pagamento in mezzo la frase manderebbe qualcuno ad
              // aspettare al banco soldi che devono arrivare da Internet.
              !resta.righe ? ""
                : resta.linkPagamento
                  ? `${resta.righe} ${tr("ord.pending")}`
                  : tr("home.atCounter").replace("{n}", String(resta.banco)));
          }

          // ---------- Réservations : la colonna di mezzo ----------
          if (resResa.ok) {
            const jr = await resResa.json();
            const tutte = ((jr.reservations ?? []) as ResaRow[])
              .filter((r) => r.status !== "cancelled")
              .sort((a, b) => (String(a.heure) < String(b.heure) ? -1 : 1));
            const capienza = Number(jr.config?.capacity ?? 0);
            tavoliNomi = (jr.tables_map ?? {}) as Record<string, string>;
            // ⚠️ La durata dei tavoli serve alla PASTIGLIA, non ai numeri: e'
            // lei che dice quando una confermata diventa «Fini ?». Arriva con
            // la giornata, quindi non costa una richiesta in piu'.
            resaServizi = ((jr.config?.services ?? []) as ServizioHold[]).filter((x) => x && x.key);
            resaHold = Number(jr.hold_minutes) || HOLD_RIPIEGO;

            const box = document.getElementById("j-resa");
            if (box) box.style.display = "";
            pastigliaGiorno("j-resa-cnt", tutte.length);

            // ⚠️ Le righe restano in memoria: cambiando uno stato dalla
            // pastiglia si ridisegna la colonna senza richiedere di nuovo la
            // giornata — e i numeri sotto si rifanno con lei.
            reseOggi = tutte;
            resaCapienza = capienza;
            disegnaResa();

            // ---- I servizi di oggi ----
            // ⚠️ `serviziDelGiorno` e' LA regola, la stessa della pagina
            // Réservations: giorni della settimana, giorno speciale «aperto»
            // che li scavalca, ordine di orario. Qui si filtrava solo per
            // `days`: un lunedi' di chiusura aperto per un'occasione mostrava
            // la scatola dei servizi VUOTA mentre il sito prendeva
            // prenotazioni — e dentro quella scatola c'e' l'interruttore per
            // chiudere un servizio. Niente scatola, niente comando, nessun
            // errore da nessuna parte.
            const dow = new Date(oggiKey + "T12:00:00").getDay();
            servData = oggiKey;
            servOggi = serviziDelGiorno(jr.config?.services, {
              dow,
              speciale: Boolean(jr.special_open),
              serviziSpeciali: (jr.special_services ?? null) as string[] | null,
            }).map((sv) => ({
              key: String(sv.key),
              label: nomeServizio(String(sv.key), LANG),
              da: String(sv.from).slice(0, 5),
              a: String(sv.to).slice(0, 5),
            }));
            // I giorni della settimana in cui non apre nessun servizio: il
            // calendario li segna. ⚠️ Lo CHIEDE a `serviziDelGiorno`, la stessa
            // regola della scatola qui sopra: scritta a mano era la terza copia
            // di «days vuoto = tutti i giorni», e un calendario che segna
            // aperto un giorno in cui la scatola dei servizi e' vuota manda in
            // sala qualcuno a cercare un interruttore che non c'e'.
            chiusiSettimana.clear();
            for (let d = 0; d <= 6; d++) {
              if (!serviziDelGiorno(jr.config?.services, { dow: d }).length) {
                chiusiSettimana.add(((d + 6) % 7) + 1);
              }
            }
            servChiusi.clear();
            for (const c of (jr.closures ?? []) as { service_key: string; reason: string }[]) {
              servChiusi.set(String(c.service_key), String(c.reason || "full"));
            }
            disegnaServizi();
          }

          // ⚠️ Qui si contavano le colonne accese per decidere la forma della
          // fascia: una sola funzione, tutte e due, nessuna. Serviva perche'
          // le caselle erano fisse e una colonna spenta lasciava mezzo
          // schermo vuoto. Adesso la fascia e' una griglia di sezioni: una
          // sezione spenta esce dal flusso e le altre scorrono al suo posto,
          // senza che nessuno le conti. Il conto non e' stato spostato: non
          // serve piu'.

          /** «oggi», «domani», oppure il giorno della settimana.
           *  ⚠️ Nessuna parola nuova da tradurre: oltre domani si scrive il
           *  nome del giorno, che la lingua ce l'ha gia'. «fra 9 giorni» e'
           *  un conto che chi legge rifa' per capire QUANDO. */
          const quandoRiapre = (fra: number): string => {
            if (fra <= 0) return tr("home.today");
            if (fra === 1) return tr("home.tomorrow");
            const d = new Date(oggiKey + "T12:00:00");
            d.setDate(d.getDate() + fra);
            return d.toLocaleDateString(LOC, { weekday: "long" });
          };

          // ---------- La giornata: orari, riapertura, affluenza ----------
          // ⚠️ Gli orari stavano in una tile, che adesso non c'e' piu'. Non e'
          // una tile spostata: e' la stessa cosa detta in UN posto solo. Due
          // punti che dicono l'orario di oggi sono due punti che un giorno
          // diranno orari diversi, e chi legge non sapra' quale credere.
          type Today = { config: Config; orders_closed?: boolean; closes_at?: string | null; reopen?: { in_days: number; heure: string } | null };
          const jt: Today | null = resToday.ok ? ((await resToday.json()) as Today) : null;
          const cfg = jt?.config ?? null;
          const bande = fasce(cfg);
          {
            const pil = document.getElementById("j-stato");
            const righeOre = document.getElementById("j-orari");
            // ⚠️ TRE stati, non due: «ignoto» non e' «chiuso». Il primo dice
            // che la configurazione non e' arrivata, il secondo che oggi non
            // si apre — e li' c'era una pastiglia CORALLE anche per il primo,
            // cioe' «Non disponibile» col vestito di «Fermé»: un locale aperto
            // con un'API lenta si vedeva chiuso sulla propria Accueil.
            const stato = statoGiorno(cfg);
            // ⚠️ «ignoto» NON e' «chiuso»: con la configurazione non arrivata
            // le altre due pastiglie restano col loro numero, invece di dire
            // che il locale e' chiuso quando nessuno lo sa.
            oggiChiuso = stato === "ignoto" ? null : stato === "chiuso";
            disegnaPastiglia("j-resa-cnt");
            disegnaPastiglia("j-ord-cnt");
            if (pil) {
              pil.textContent = stato === "ignoto" ? tr("home.unavail")
                : stato === "aperto" ? tr("home.tagOpen") : tr("home.tagClosed");
              pil.classList.toggle("off", stato === "chiuso");
              pil.classList.toggle("n", stato === "ignoto");
            }
            if (righeOre) {
              // ⚠️ Niente «Réouverture aujourd'hui à 17:00» accanto a
              // «17:00 – 22:30»: era la stessa ora detta due volte, e la
              // seconda in grigio e piu' lunga della prima.
              //
              // I servizi sono UNO ACCANTO ALL'ALTRO, ognuno in un pezzo suo
              // che non va a capo: «12:00 – 14:30» spezzato dopo il trattino
              // diventa due orari che non esistono.
              //
              // ⚠️ QUANDO SI RIAPRE, invece, si scrive — e solo da chiusi.
              // Il server lo calcola a ogni caricamento della Accueil
              // (`caricaToday` cerca fino a tre settimane avanti) e non lo
              // leggeva nessuno: un conto fatto ogni volta per niente, e
              // intanto la colonna di un lunedi' di chiusura diceva «Fermé»
              // senza dire fino a quando.
              const riapre = stato === "chiuso" && jt?.reopen
                ? `<span class="j-riapre">${escHtml(`${tr("home.reopen")} ${quandoRiapre(jt.reopen.in_days)} ${jt.reopen.heure}`)}</span>`
                : "";
              righeOre.innerHTML = CLOCK + (
                stato === "ignoto" ? escHtml("—")
                : stato === "aperto" ? bande.map((f) => `<span class="f">${escHtml(f)}</span>`).join("")
                : `<span class="f">${escHtml(tr("home.closedToday"))}</span>${riapre}`
              );
            }
            // ⚠️ Si accende la PASTIGLIA, non un blocco: adesso stato e orari
            // vivono dentro la testa della colonna. Finche' la configurazione
            // non arriva resta spenta — «AUJOURD'HUI —» sembra un guasto.
            if (pil) pil.style.display = "";
            // ⚠️ Gli orari ABITANO la colonna di Google, non sono di Google:
            // un locale senza Place ID lascerebbe quella colonna spenta e
            // perderebbe gli orari, che non c'entrano niente con la scheda.
            // Chi ha qualcosa da dire accende la colonna; il blocco di Google
            // fa lo stesso dal suo script, e accenderla due volte non costa.
            const colonna = document.getElementById("j-google");
            if (colonna) colonna.style.display = "";
          }

          // ---------- L'affluenza: l'abitudine, e oggi sopra ----------
          // ⚠️ L'abitudine arriva dal server (media dello stesso giorno della
          // settimana). OGGI invece si conta QUI, dalle righe che la fascia ha
          // gia' in mano: chiederlo al server sarebbe un secondo conteggio
          // dello stesso giorno, e il giorno che i due numeri non combaciano
          // tutti e due hanno l'aria giusta. Le due serie contano le STESSE
          // cose — `fonti` lo dice — altrimenti il confronto non vuol dire
          // niente.
          try {
            const rAff = await fetch("/api/admin/affluence", { headers });
            if (rAff.ok) {
              const aff = (await rAff.json()) as {
                covers: Record<string, number>; orders: Record<string, number>;
                settimane: number; fonti: string[];
              };
              // ⚠️ Chi comanda e' `fonti`, che arriva dal server: e' la stessa
              // decisione che ha deciso se LEGGERE quei dati. Spenti gli
              // ordini, la loro serie non esiste — non e' nascosta, non c'e' —
              // e con tutte e due spente il grafico non si disegna affatto.
              const conta = new Set(aff.fonti ?? []);
              const vedeCov = conta.has("covers");
              const vedeOrd = conta.has("orders");

              const oggiCov: Record<number, number> = {};
              const oggiOrd: Record<number, number> = {};
              const metti = (dove: Record<number, number>, h: number, q: number) => {
                if (!Number.isFinite(h) || h < 0 || h > 23 || !q) return;
                dove[h] = (dove[h] ?? 0) + q;
              };
              if (vedeCov) {
                for (const r of reseOggi) {
                  metti(oggiCov, oraDi(r.heure), Number(r.people) || 0);
                }
              }
              if (vedeOrd) {
                // ⚠️ Il formattatore si costruisce UNA volta, fuori dal giro:
                // dentro, una serata da duecento ordini ne costruiva duecento.
                const q = new Intl.DateTimeFormat("en-GB", { timeZone: TZ_LOCALE, hour: "2-digit", hourCycle: "h23" });
                for (const o of ordiniOggi) {
                  metti(oggiOrd, Number(q.format(new Date(o.pickup_time))), 1);
                }
              }

              // Le quattro serie, nell'ordine in cui si disegnano: ogni «oggi»
              // accanto al SUO «di solito», perche' il confronto che conta e'
              // quello — non coperti contro ordini, che non si confrontano.
              const serie: Serie[] = [];
              if (vedeCov) serie.push({ ore: oggiCov, classe: "cov oggi" }, { ore: aff.covers ?? {}, classe: "cov" });
              if (vedeOrd) serie.push({ ore: oggiOrd, classe: "ord oggi" }, { ore: aff.orders ?? {}, classe: "ord" });

              // La finestra, il soffitto e le linee: `giornataRegole.ts`, dove
              // si provano senza un browser. Qui resta il disegno.
              const g = grafico(serie, oreAperte(cfg));

              const hm = document.getElementById("j-hm");
              const plot = document.getElementById("j-hm-plot");
              const assi = document.getElementById("j-hm-x");
              if (hm && plot && assi && g) {
                const { da, cima, meta } = g;
                // LE LINEE: il pavimento, la meta' e il soffitto. Senza, una
                // barra e' alta rispetto a niente — si vede che una sera e'
                // piu' piena di un'altra, non QUANTO.
                // ⚠️ Le altezze vengono dalla STESSA `altezza()` delle barre:
                // una linea disegnata al 50% e una barra calcolata su `cima`
                // sarebbero due righelli diversi sullo stesso grafico.
                const griglia =
                  `<div class="j-grid" aria-hidden="true">` +
                  `<i class="base"></i>` +
                  `<i style="bottom:${altezza(meta, cima)}%">` + (g.metaScritta ? `<b>${meta}</b>` : "") + `</i>` +
                  `<i style="bottom:${altezza(cima, cima)}%"><b>${cima}</b></i>` +
                  `</div>`;
                const barre: string[] = [];
                const etichette: string[] = [];
                for (const h of g.ore) {
                  barre.push(
                    `<div class="j-hb">` +
                      serie.map((s2) => `<span class="${s2.classe}" style="height:${altezza(quanto(s2, h), cima)}%"></span>`).join("") +
                    `</div>`
                  );
                  // Un'etichetta ogni due ore: dodici numeri in fila sotto una
                  // striscia alta settanta pixel si leggono come un rumore,
                  // non come un asse.
                  etichette.push(`<span>${(h - da) % 2 === 0 ? h + "h" : ""}</span>`);
                }
                plot.innerHTML = barre.join("") + griglia;
                assi.innerHTML = etichette.join("");
                // Due serie o quattro: la larghezza delle barre sta nel CSS,
                // qui si dice solo quante ce ne sono.
                hm.classList.toggle("serie4", serie.length === 4);
                hm.classList.toggle("serie2", serie.length === 2);

                // La legenda nomina i COLORI, e solo quelli che esistono: una
                // voce «commandes» senza barre e' una domanda in piu'.
                const kCov = document.getElementById("j-k-cov");
                if (kCov) kCov.style.display = vedeCov ? "" : "none";
                const kOrd = document.getElementById("j-k-ord");
                if (kOrd) kOrd.style.display = vedeOrd ? "" : "none";

                // Il picco: l'ora piu' piena di OGGI. Sui COPERTI quando ci
                // sono, perche' l'affluenza sono le persone; gli ordini da
                // portare via sono un'altra cosa e hanno la loro barra.
                const pic = document.getElementById("j-hm-pic");
                if (pic) {
                  const h = picco(vedeCov ? oggiCov : oggiOrd);
                  pic.textContent = h === null ? "" : tr("home.peakAt").replace("{h}", h + "h");
                }

                // Su quante settimane e' fatta la media. Una media su tre
                // settimane e una su otto non si guardano allo stesso modo, e
                // chi legge deve saperlo senza doverlo chiedere.
                const src = document.getElementById("j-hm-src");
                if (src) {
                  src.textContent = aff.settimane > 0
                    ? tr("home.affWeeks").replace("{n}", String(aff.settimane))
                    : tr("home.affNone");
                }
                hm.style.display = "";
              }
            }
          } catch (e) {
            // ⚠️ Si SCRIVE prima di inghiottire. Qui dentro non c'e' solo la
            // rete: c'e' anche il codice che disegna, e un errore suo faceva
            // sparire il grafico senza lasciare traccia da nessuna parte —
            // nessun errore a schermo, nessuna riga in console, solo un
            // blocco con gli orari e basta.
            console.error("[affluenza]", String((e as Error)?.message ?? e));
          }


          // ---------- Commandes: préparation e chiusura online ----------
          // ⚠️ STESSI bottoni di /admin/orders (styles/prep.css) e STESSA
          // chiamata: `PATCH /api/admin/settings` scrive il tempo su tutti i
          // giorni ed e' l'unica che valida 0–240. Erano anche nella tile
          // Cuisine, sulla stessa pagina: due comandi per lo stesso valore, e
          // il giorno che uno dei due smette di aggiornarsi nessuno se ne
          // accorge — si vede solo quando la cucina lavora su un tempo che
          // nessuno ha scelto.
          {
            const cmd = document.getElementById("j-ord-cmd");
            const btnChiudi = document.getElementById("j-ord-close") as HTMLButtonElement | null;
            let prepMin = Number(cfg?.prep_time_minutes);
            let ordiniChiusi = Boolean(jt?.orders_closed);

            const chips = () => Array.from(cmd?.querySelectorAll<HTMLButtonElement>(".prep-btn[data-min]") ?? []);
            const segna = () => {
              // ⚠️ A ordini chiusi NESSUN tempo resta acceso: un «30 min»
              // illuminato accanto a un «Fermer» rosso direbbe due cose
              // opposte sullo stesso momento.
              for (const b of chips()) b.classList.toggle("active", !ordiniChiusi && Number(b.dataset.min) === prepMin);
              btnChiudi?.classList.toggle("closed", ordiniChiusi);
              const lab = btnChiudi?.querySelector(".m");
              if (lab) lab.textContent = ordiniChiusi ? tr("ord.closed") : tr("common.close");
              if (btnChiudi) btnChiudi.title = ordiniChiusi ? tr("ord.reopenOnline") : tr("ord.closeOnline");
            };
            segna();

            // Un valore fuori dai tre preset (scelto nei Réglages) non deve
            // sparire: diventa un bottone in piu', cosi' la colonna dice
            // sempre il tempo vero invece di non accendere niente.
            if (Number.isFinite(prepMin) && !chips().some((b) => Number(b.dataset.min) === prepMin) && btnChiudi) {
              const extra = document.createElement("button");
              extra.type = "button";
              extra.className = "prep-btn";
              extra.dataset.min = String(prepMin);
              extra.innerHTML = `<span class="m">${prepMin} min</span>`;
              btnChiudi.parentElement?.insertBefore(extra, btnChiudi);
              segna();
            }

            // Si scrive PRIMA sullo schermo e poi sul server, e si torna
            // indietro se il server rifiuta: il contrario (aspettare) rende
            // il bottone lento al tocco, e qui si tocca mentre si cucina.
            const salva = async (corpo: Record<string, unknown>, indietro: () => void) => {
              const tutti = [...chips(), ...(btnChiudi ? [btnChiudi] : [])];
              for (const b of tutti) b.disabled = true;
              try {
                const r = await fetch("/api/admin/settings", {
                  method: "PATCH",
                  headers: await authFresh(),
                  body: JSON.stringify(corpo),
                });
                if (!r.ok) throw new Error();
              } catch {
                indietro();
                segna();
                toast(tr("us.editErr"), true);
              } finally {
                for (const b of tutti) b.disabled = false;
              }
            };

            cmd?.addEventListener("click", async (e) => {
              const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".prep-btn[data-min]");
              if (!b) return;
              const min = Number(b.dataset.min);
              if (!Number.isFinite(min) || (min === prepMin && !ordiniChiusi)) return;
              const prima = prepMin;
              const eraChiuso = ordiniChiusi;
              prepMin = min;
              // Scegliere un tempo RIAPRE: e' la regola della pagina
              // Commandes, e due pannelli non possono rispondere diverso alla
              // stessa azione.
              ordiniChiusi = false;
              segna();
              await salva({ prep_time_minutes: min, orders_closed: false }, () => {
                prepMin = prima;
                ordiniChiusi = eraChiuso;
              });
              b.blur();
            });

            btnChiudi?.addEventListener("click", async () => {
              const nuovo = !ordiniChiusi;
              ordiniChiusi = nuovo;
              segna();
              await salva({ orders_closed: nuovo }, () => { ordiniChiusi = !nuovo; });
              btnChiudi.blur();
            });
          }


          // ---------- Menu : cosa non si puo' vendere adesso ----------
          if (resMenu.ok && resCats.ok) {
            menuRighe = ((await resMenu.json()).items as MenuRow[]) ?? [];
            const cats = ((await resCats.json()).categories as Cat[]) ?? [];
            const kindByCat = new Map(cats.map((c) => [c.name, c.kind]));
            const c = contiMenu(menuRighe, (nome) => kindByCat.get(nome));
            numero("j-menu-food", String(c.piatti),
              c.catPiatti ? tr("home.menuCats").replace("{n}", String(c.catPiatti)) : "");
            numero("j-menu-drink", String(c.bevande),
              c.catBevande ? tr("home.menuCats").replace("{n}", String(c.catBevande)) : "");
            // ⚠️ Un trattino e non «0»: zero piatti senza foto e' una buona
            // notizia, e in corallo grande sembrerebbe un allarme.
            numero("j-menu-nofoto", c.senzaFoto ? String(c.senzaFoto) : "—",
              c.totale ? tr("home.menuOfN").replace("{n}", String(c.totale)) : "");
            const box = document.getElementById("j-menu");
            if (box) box.style.display = "";
            const nums = document.getElementById("j-menu-nums");
            if (nums) nums.style.display = "";
            disegnaMenu();
          }
        } catch {
          /* i tile degradano in silenzio; la pagina resta usabile */
        }
      })();
    </script>

    <!-- Organiser : ordine + dimensione delle isole (per utente, salvato in DB) -->
    <script>
      import { iniziali, coloreDi } from "../../lib/admin/avatarRegole";
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";
      import { stelle, linkRecensioni, variazione } from "../../lib/admin/googleRegole";

      const LANG = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(LANG);
      const LOC = ADMIN_LOCALE[LANG] ?? "fr-BE";
      /** Il fuso del RISTORANTE, come nell'altro script di questa pagina.
       *  ⚠️ Una recensione scritta alle 23:40 a Bruxelles, letta da un telefono
       *  rimasto su un altro fuso, portava la data del giorno dopo: la stessa
       *  recensione con due date, una qui e una nella pagina Google. */
      const TZ = (document.querySelector(".ah-header") as HTMLElement | null)?.dataset.tz || "Europe/Brussels";
      const dataAvis = (a: { quand?: string; quand_iso?: string }): string =>
        a.quand || (a.quand_iso ? new Date(a.quand_iso).toLocaleDateString(LOC, { timeZone: TZ }) : "");

      (async () => {
        const cards = document.getElementById("cards") as HTMLElement;
        if (!cards) return;
        const btn = document.getElementById("organiser-btn") as HTMLButtonElement | null;
        const btnReset = document.getElementById("organiser-reset") as HTMLButtonElement | null;
        const btnTuiles = document.getElementById("organiser-tuiles") as HTMLButtonElement | null;

        type Item = { key: string; w?: number; minH?: number; hidden?: boolean };
        const KEYS = ["visibilite"];
        // ⚠️ `orders`, `reservations`, `google`, `settings` (gli orari),
        // `cuisine` (préparation e chiusura online), `notes`, `menu` e `assets` non sono piu' qui: il
        // loro contenuto e' salito nella fascia della giornata, che e' FISSA. Una gerarchia che si puo' trascinare torna
        // a essere una griglia di riquadri uguali, cioe' il difetto da cui
        // siamo partiti.
        const DEFAULT_LAYOUT: Item[] = [
          { key: "visibilite", w: 2 },
        ];

        let editing = false;

        const { data: sd } = await supabaseBrowser.auth.getSession();
        const token = sd.session?.access_token ?? "";
        let headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };
        // Secondo blocco di codice, suo scope, stesso difetto: il token scade e
        // il salvataggio del layout tornava «Non autorisé» su un tab aperto da
        // ore. supabase-js lo rinnova da solo: qui si ascolta e si riscrive.
        supabaseBrowser.auth.onAuthStateChange((_evento, sessione) => {
          if (sessione?.access_token) headers = { Authorization: `Bearer ${sessione.access_token}`, "Content-Type": "application/json" };
        });

        const mappa = () => {
          const m = new Map<string, HTMLElement>();
          cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((t) => m.set(t.dataset.tile as string, t));
          return m;
        };
        // Le SOGLIE non sono ripetute qui: il numero di colonne si legge da
        // --cols, che le media query di .cards impostano nel CSS. Cambiando
        // le soglie la' dentro, drag & drop e ridimensionamento seguono da
        // soli. (Questo e' un secondo blocco <script>, con il suo scope: il
        // lettore e' tre righe, le soglie restano una sola volta nel CSS.)
        const colonne = (): number => {
          const v = parseInt(getComputedStyle(cards).getPropertyValue("--cols"), 10);
          return Number.isFinite(v) && v >= 1 ? v : 4;
        };
        // MOBILE: una tuile par ligne, hauteur = contenu. Pas de masonry,
        // pas de largeurs, pas de hauteurs minimales : tout est remis à zéro.
        const isMobile = () => colonne() === 1;

        function applicaSpans() {
          const mob = isMobile();
          const c = colonne();
          cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((t) => {
            if (mob) {
              t.style.gridColumn = "";
              t.style.gridRowEnd = "";
              t.style.minHeight = "";
              return;
            }
            const w = Math.min(c, Math.max(1, Number(t.dataset.w || 1)));
            t.style.gridColumn = "span " + w;
            const mh = Number(t.dataset.minh || 0);
            t.style.minHeight = mh > 0 ? mh + "px" : "";
          });
        }
        window.addEventListener("resize", applicaSpans);

        // Masonry: span verticale = altezza reale della tile in micro-righe.
        // Un ResizeObserver lo tiene aggiornato quando il contenuto cambia
        // (note caricate, liste, minHeight trascinato con la maniglia).
        const MICRO = 2, GAPPX = 12; // righe da 2px, spazio sotto = margin-bottom 12px
        const spanAltezza = (t: HTMLElement) => {
          if (isMobile()) { t.style.gridRowEnd = ""; return; }
          const h = t.getBoundingClientRect().height;
          const n = Math.max(1, Math.ceil((h + GAPPX) / MICRO));
          const nuovo = "span " + n;
          if (t.style.gridRowEnd !== nuovo) t.style.gridRowEnd = nuovo;
        };
        const roTile = new ResizeObserver((voci) => {
          for (const v of voci) spanAltezza(v.target as HTMLElement);
        });
        cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((t) => roTile.observe(t));

        // ⚠️ Qui due tile salivano dalla griglia nella fascia, quando il
        // locale non aveva ne' prenotazioni ne' ordini: senza quelle due
        // colonne restava un terzo di schermo con due terzi di niente, e
        // qualcuno doveva riempirlo. Era una tile spostata a mano fuori dal
        // suo posto — niente maniglie, fuori dal modale «Tuiles», e un
        // `resize` che riprovava a ogni trascinamento della finestra.
        // La fascia adesso e' una griglia di sezioni e il buco non si forma:
        // le sezioni che restano scorrono nelle caselle libere da sole.

        function applicaLayout(layout: Item[]) {
          const m = mappa();
          const usati = new Set<string>();
          for (const it of layout) {
            const t = m.get(it.key);
            if (!t) continue;
            usati.add(it.key);
            t.dataset.w = String(Math.min(4, Math.max(1, Number(it.w) || 1)));
            if (!isMobile() && it.minH && it.minH > 0) t.dataset.minh = String(it.minH);
            else delete t.dataset.minh;
            t.classList.toggle("is-off", it.hidden === true);
            cards.appendChild(t);
          }
          for (const key of KEYS) {
            if (usati.has(key)) continue;
            const t = m.get(key);
            if (!t) continue;
            t.dataset.w = String(DEFAULT_LAYOUT.find((d) => d.key === key)?.w ?? 1);
            delete t.dataset.minh;
            t.classList.remove("is-off");
            cards.appendChild(t);
          }
          applicaSpans();
        }

        function layoutCorrente(): Item[] {
          const out: Item[] = [];
          cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((t) => {
            const w = Math.min(4, Math.max(1, Number(t.dataset.w || 1)));
            const mh = Number(t.dataset.minh || 0);
            const voce: Item = mh > 0 ? { key: t.dataset.tile as string, w, minH: mh } : { key: t.dataset.tile as string, w };
            if (t.classList.contains("is-off")) voce.hidden = true;
            out.push(voce);
          });
          return out;
        }

        let salvaTimer: number | undefined;
        function salva() {
          window.clearTimeout(salvaTimer);
          salvaTimer = window.setTimeout(() => {
            fetch("/api/admin/home-layout", { method: "PUT", headers, body: JSON.stringify({ layout: layoutCorrente() }) }).catch(() => {});
          }, 400);
        }

        // --- Google: la nota, il carosello degli avis, i numeri della scheda ---
        // ⚠️ SOLA LETTURA. Rispondere a una recensione si fa dalla pagina
        // Google, che sa anche mostrare quelle vecchie e correggere una
        // risposta gia' pubblicata. Una scorciatoia che fa meta' del mestiere
        // si usa una volta e poi non ci si fida piu'.
        (async () => {
          const box = document.getElementById("j-google") as HTMLElement | null;
          if (!box) return;
          // Tutto cio' che parla di Google, e che se ne va insieme alla scheda.
          // ⚠️ La TESTATA non si tocca. Da quando porta «AUJOURD'HUI», la
          // pastiglia aperto/chiuso e il link agli orari, non ha piu' niente
          // di Google: nasconderla toglieva il titolo e lo stato del locale a
          // ogni cliente senza scheda, e la colonna partiva da un riquadro di
          // orari senza nome. Tutto cio' che e' di Google sta nel suo blocco,
          // e se ne va con lui.
          const soloOrari = () => {
            for (const id of ["j-g-nb", "j-g-per"]) {
              const el = document.getElementById(id);
              if (el) el.style.display = "none";
            }
          };
          /**
           * ⚠️ GOOGLE CHE NON RISPONDE NON E' «GOOGLE CHE NON C'E'».
           *
           * Fino all'08/10 erano la stessa cosa: tutt'e due facevano sparire
           * il blocco. Su 450 Gradi — tre sedi — il voto si vedeva per
           * Schaerbeek e Stockel e su Jourdan compariva e spariva, e dallo
           * schermo non c'era modo di sapere perche': l'API il motivo lo
           * mandava gia' («Google non disponibile», piu' il codice), e questa
           * funzione lo buttava via insieme al blocco.
           *
           * Senza scheda configurata il blocco se ne va, ed e' giusto: non
           * c'e' niente da dire. Con la scheda configurata e Google che
           * rifiuta, il blocco RESTA e dice cosa e' successo — un 404 vuol
           * dire che quel Place ID non esiste per quella sede, ed e' una cosa
           * che si va a correggere in Réglages.
           */
          const guastoGoogle = (testo: string) => {
            const nb = document.getElementById("j-g-nb");
            if (nb) nb.style.display = "";
            const r = document.getElementById("j-g-rating");
            if (r) r.textContent = "—";
            const st = document.getElementById("j-g-stars");
            if (st) st.textContent = "";
            const c = document.getElementById("j-g-count");
            if (c) c.textContent = testo;
            // Quello che non si puo' mostrare non resta a meta': la recensione,
            // le frecce del carosello e il link all'elenco se ne vanno insieme
            // al voto. Un link «tutte le recensioni» che non porta da nessuna
            // parte si clicca una volta sola.
            for (const id of ["j-g-aut", "j-g-car", "j-g-nav", "j-g-maps", "j-g-per"]) {
              const el = document.getElementById(id);
              if (el) (el as HTMLElement).style.display = "none";
            }
          };
          try {
            const res = await fetch("/api/admin/google-info", { headers });
            if (!res.ok) { soloOrari(); return; }
            const g = (await res.json()) as {
              configured: boolean; rating?: number | null; reviews?: number; maps_url?: string;
              /** Il messaggio e il codice quando Google rifiuta la scheda. */
              error?: string; motivo?: string;
              /** L'elenco delle recensioni su Google (costruito dall'API). */
              reviews_url?: string;
              // Recensioni arrivate questo mese. Assente quando non si puo'
              // contare (Business Profile non collegato).
              mois?: number;
              // `id` = review_id: arriva solo con il Business Profile collegato,
              // ed e' quello che permette di rispondere. Senza, il bottone non esce.
              avis?: { auteur: string; note: number; texte: string; quand: string; quand_iso?: string; foto?: string; reply?: boolean; id?: string }[];
            };
            // Senza Place ID non c'e' niente da dire DI GOOGLE: spariscono
            // l'intestazione, la nota e il conteggio — ma la colonna puo'
            // restare, perche' ci stanno anche gli orari del locale. Prima
            // qui si usciva e basta, e con la scheda sparivano pure quelli.
            // Scheda non configurata per questo punto: niente da dire di
            // Google, il blocco se ne va e restano gli orari. Scheda
            // configurata ma Google che non risponde: il blocco resta e dice
            // il motivo — sparendo, non lo direbbe nessuno.
            if (!g.configured) { soloOrari(); return; }
            if (g.rating == null) {
              const motivo = String((g as { motivo?: string }).motivo ?? "").trim();
              guastoGoogle(`${g.error ?? tr("err.googleDown")}${motivo ? ` · ${motivo}` : ""}`);
              return;
            }
            box.style.display = "";

            const nota = Number(g.rating);
            const rEl = document.getElementById("j-g-rating");
            if (rEl) rEl.textContent = nota.toFixed(1).replace(".", ",");
            const sEl = document.getElementById("j-g-stars");
            if (sEl) sEl.textContent = stelle(nota);
            const cEl = document.getElementById("j-g-count");
            if (cEl) {
              // ⚠️ Nodi, non `innerHTML`: qui dentro passano un nome di
              // lingua e due numeri, ma `escHtml` vive nell'ALTRO script di
              // questa pagina e qui non esiste. Scritto con `innerHTML`
              // sarebbe stato un ReferenceError dentro un `try` — e il
              // `catch` l'avrebbe inghiottito facendo sparire tutto il
              // blocco Google senza un errore in console.
              cEl.textContent = `${g.reviews ?? 0} ${tr("home.avisGoogle")}`;
              // ⚠️ `typeof` e non `if (g.mois)`: zero recensioni questo mese
              // e' un'informazione — il mese e' andato cosi' — e con un test
              // di verita' sparirebbe insieme al caso «non lo sappiamo».
              if (typeof g.mois === "number") {
                // ⚠️ La parentesi sta DENTRO il pezzo bianco, aperta e chiusa
                // nella stessa stringa. Scritta fuori, un giorno resterebbe
                // una parentesi aperta attaccata al testo grigio e l'altra da
                // qualche altra parte.
                const b = document.createElement("b");
                b.className = "m";
                b.textContent = `(+${g.mois} ${tr("home.avisMois")})`;
                cEl.append(" ", b);
              }
            }
            const maps = document.getElementById("j-g-maps") as HTMLAnchorElement | null;
            // La scheda come ripiego: se un giorno l'elenco non arriva, meglio
            // la scheda di un link che non porta da nessuna parte.
            // ⚠️ E senza nemmeno la scheda il link SPARISCE, invece di restare
            // con `href="#"`: un link che si clicca e non fa niente si prova
            // una volta, e da li' in poi non si clicca piu' nemmeno quando
            // funziona.
            if (maps) {
              const u = linkRecensioni(g);
              if (u) { maps.href = u; maps.style.display = ""; }
              else maps.style.display = "none";
            }

            // ---- carosello ----
            const avis = (g.avis ?? []).filter((a) => a.texte);
            if (avis.length) {
              const car = document.getElementById("j-g-car");
              const nav = document.getElementById("j-g-nav");
              const qEl = document.getElementById("j-g-quote");
              const wEl = document.getElementById("j-g-who");
              const asEl = document.getElementById("j-g-astars");
              const dtEl = document.getElementById("j-g-when");
              const dots = document.getElementById("j-g-dots");
              const avEl = document.getElementById("j-g-av");
              const autEl = document.getElementById("j-g-aut");
              const repEl = document.getElementById("j-g-rep");
              /** ⚠️ La foto si prova, non si da' per buona: gli URL dei
               *  profili Google scadono e a volte rispondono 403, e al loro
               *  posto resterebbe un cerchio vuoto — che non dice niente e
               *  sembra un guasto. Se non carica, iniziali e colore. */
              const disegnaAvatar = (nome: string, foto?: string, dove?: HTMLElement | null) => {
                const el = dove ?? avEl;
                if (!el) return;
                el.textContent = iniziali(nome);
                el.style.background = coloreDi(nome || "?");
                if (!foto) return;
                const img = new Image();
                img.referrerPolicy = "no-referrer";
                img.alt = "";
                img.addEventListener("load", () => {
                  el.textContent = "";
                  el.style.background = "transparent";
                  el.appendChild(img);
                });
                img.src = foto;
              };
              const arrows = nav?.querySelector(".j-arrows") as HTMLElement | null;
              const repOpen = document.getElementById("j-g-rep-open") as HTMLButtonElement | null;
              // Il modale della risposta: guscio condiviso, fuori dalla fascia.
              const mOv = document.getElementById("j-rep-overlay") as HTMLElement | null;
              const mAv = document.getElementById("j-rep-av");
              const mWho = document.getElementById("j-rep-who");
              const mStars = document.getElementById("j-rep-stars");
              const mWhen = document.getElementById("j-rep-when");
              const mQuote = document.getElementById("j-rep-quote");
              const rTxt = document.getElementById("j-rep-txt") as HTMLTextAreaElement | null;
              const rMsg = document.getElementById("j-rep-msg");
              const rPub = document.getElementById("j-rep-pub") as HTMLButtonElement | null;
              if (car) car.style.display = "";
              if (autEl) autEl.style.display = "";
              // La barra resta: porta anche il bottone «Répondre». Spariscono
              // le frecce, che con una recensione sola non vanno da nessuna parte.
              if (nav) nav.style.display = "";
              if (arrows) arrows.style.display = avis.length > 1 ? "" : "none";
              let editing = false; // risposta in corso: il giro si ferma
              let idx = 0;
              let auto: number | undefined;
              const mostra = (i: number) => {
                idx = (i + avis.length) % avis.length;
                const a = avis[idx];
                if (qEl) qEl.textContent = `« ${a.texte} »`;
                if (wEl) wEl.textContent = a.auteur || "";
                if (asEl) asEl.textContent = stelle(Number(a.note) || 0);
                if (dtEl) dtEl.textContent = dataAvis(a);
                if (dots) dots.innerHTML = avis.map((_, k) => `<i class="${k === idx ? "on" : ""}"></i>`).join("");
                // ⚠️ `referrerpolicy`: le foto dei profili Google rispondono
                // 403 se arriva il referrer del nostro dominio, e al posto del
                // volto resta un rettangolo rotto.
                disegnaAvatar(a.auteur || "", a.foto);
                if (repEl) {
                  // `undefined` = non lo sappiamo (recensioni Places): meglio
                  // tacere che dire «senza risposta» a chi ha gia' risposto.
                  // ⚠️ E «sans réponse» si scrive solo quando NON si puo'
                  // rispondere da qui. Dove c'e' il bottone, la pastiglia
                  // diceva la stessa cosa due volte, in due pastiglie coralle
                  // una accanto all'altra: il bottone dice gia' che manca la
                  // risposta — e dice anche come darla.
                  const puoRispondere = !!a.id && !a.reply;
                  if (a.reply === undefined || puoRispondere) { repEl.textContent = ""; repEl.className = "j-rep"; }
                  else {
                    repEl.textContent = a.reply ? tr("home.replied") : tr("home.noReply");
                    repEl.className = "j-rep " + (a.reply ? "si" : "no");
                  }
                }
                // Si puo' rispondere solo a cio' che ha un id (Business
                // Profile collegato) e a cui nessuno ha gia' risposto.
                if (repOpen) repOpen.style.display = a.id && !a.reply ? "" : "none";
              };
              // ⚠️ Il giro riparte DOPO ogni tocco: se continuasse col suo
              // tempo, la recensione che si sta leggendo scapperebbe via. E si
              // ferma del tutto mentre si scrive una risposta: cambiare avis
              // sotto le dita vorrebbe dire pubblicare la risposta sbagliata.
              const riparti = () => {
                window.clearInterval(auto);
                if (avis.length > 1 && !editing) auto = window.setInterval(() => mostra(idx + 1), 7000);
              };
              function chiudiRisposta() {
                editing = false;
                if (mOv) mOv.hidden = true;
                if (rTxt) rTxt.value = "";
                if (rMsg) rMsg.textContent = "";
                if (rPub) { rPub.disabled = false; rPub.textContent = tr("gg.replyPublish"); }
              }
              document.getElementById("j-g-prev")?.addEventListener("click", () => { mostra(idx - 1); riparti(); });
              document.getElementById("j-g-next")?.addEventListener("click", () => { mostra(idx + 1); riparti(); });
              repOpen?.addEventListener("click", () => {
                const a = avis[idx];
                // ⚠️ Il giro si ferma PRIMA di aprire: se il carosello girasse
                // dietro al modale, si pubblicherebbe la risposta scritta per
                // una recensione sotto il nome di un'altra.
                editing = true;
                window.clearInterval(auto);
                // Chi ha scritto e cosa, dentro al modale: andarlo a rileggere
                // dietro la finestra e' il modo di rispondere a quella sbagliata.
                if (mWho) mWho.textContent = a.auteur || "";
                if (mStars) mStars.textContent = stelle(Number(a.note) || 0);
                if (mWhen) mWhen.textContent = dataAvis(a);
                if (mQuote) mQuote.textContent = `« ${a.texte} »`;
                if (mAv) disegnaAvatar(a.auteur || "", a.foto, mAv);
                if (mOv) mOv.hidden = false;
                rTxt?.focus();
              });
              // Sfondo, × e «Annuler»: la stessa chiusura, come in ogni modale.
              mOv?.querySelectorAll("[data-md-close]").forEach((el) =>
                el.addEventListener("click", () => { chiudiRisposta(); riparti(); })
              );
              document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && mOv && !mOv.hidden) { chiudiRisposta(); riparti(); }
              });
              rPub?.addEventListener("click", async () => {
                const a = avis[idx];
                const testo = (rTxt?.value ?? "").trim();
                if (!a.id || !testo || !rPub) return;
                rPub.disabled = true;
                rPub.textContent = tr("gg.replySaving");
                try {
                  const res = await fetch("/api/admin/google/reply", {
                    method: "POST",
                    headers: { ...headers, "Content-Type": "application/json" },
                    body: JSON.stringify({ reviewId: a.id, comment: testo }),
                  });
                  if (!res.ok) throw new Error();
                  // ⚠️ Si segna qui, in memoria: senza, tornando sulla stessa
                  // recensione il bottone ricomparirebbe e si risponderebbe due
                  // volte alla stessa persona.
                  a.reply = true;
                  if (rMsg) rMsg.textContent = tr("gg.replySaved");
                  // Si resta un momento sul messaggio, poi si chiude e la riga
                  // si ridisegna: la pastiglia passa a «Risposto» e il bottone
                  // sparisce da sola.
                  window.setTimeout(() => { chiudiRisposta(); mostra(idx); riparti(); }, 1400);
                } catch {
                  if (rMsg) rMsg.textContent = tr("gg.replyError");
                  rPub.disabled = false;
                  rPub.textContent = tr("gg.replyPublish");
                }
              });
              mostra(0);
              riparti();
            }

          } catch {
            // Rete assente: di Google non si dice niente. La colonna pero'
            // resta accesa se ci sono gli orari — quelli non sono suoi.
            soloOrari();
          }
        })();

        // --- I tre numeri della scheda Google (Business Profile Performance) ---
        // ⚠️ Una lettura A SE', non in coda a quella delle recensioni: erano
        // nello stesso `try`, e un inciampo qualunque nel carosello si portava
        // via anche i numeri — senza che niente lo dicesse. Due informazioni
        // diverse, due destini diversi.
        (async () => {
          const perf = document.getElementById("j-g-perf");
          if (!perf) return;
          try {
            // 90 giorni per poterne confrontare 30 con i 30 precedenti: un
            // numero senza il suo «rispetto a quando» non dice se le cose
            // vanno meglio o peggio, ed e' l'unica domanda che si fa a questi
            // tre numeri.
            const rp = await fetch("/api/admin/google/data?giorni=90", { headers });
            if (!rp.ok) return;
            const jp = (await rp.json()) as { serie?: { metric: string; punti: { date: string; value: number }[] }[] };
            const serie = jp.serie ?? [];
            if (!serie.length) return;
            const mostraPerf = (metric: string, idValore: string) => {
              // ⚠️ IL CONFRONTO LO FA `googleRegole.variazione`, che pretende
              // DUE periodi interi. Qui si sommavano «gli ultimi 30 punti» e
              // «i 30 prima», qualunque cosa fosse arrivata: con 40 giorni di
              // storia il secondo periodo erano 10 giorni, e il pannello
              // scriveva «+180 %» confrontando un mese con una settimana e
              // mezza — un numero inventato con l'aria di un numero vero.
              const v = variazione(serie.find((x) => x.metric === metric)?.punti);
              if (!v) return false;
              const el = document.getElementById(idValore);
              if (el) el.textContent = String(v.ultimi);
              const d = document.getElementById(idValore + "-d");
              if (d) {
                if (v.diff === null) { d.textContent = ""; d.className = "d"; }
                else {
                  d.textContent = (v.diff > 0 ? "+" : "") + v.diff + " %";
                  d.className = "d" + (v.diff >= 0 ? " up" : " giu");
                }
              }
              return true;
            };
            const ok1 = mostraPerf("WEBSITE_CLICKS", "j-g-site");
            const ok2 = mostraPerf("CALL_CLICKS", "j-g-calls");
            const ok3 = mostraPerf("BUSINESS_DIRECTION_REQUESTS", "j-g-route");
            if (ok1 || ok2 || ok3) {
              perf.style.display = "";
              const per = document.getElementById("j-g-per");
              if (per) per.style.display = "";
            }
          } catch { /* i numeri non sono arrivati: la nota e gli avis restano */ }
        })();

        // Carica il layout salvato (o default)
        try {
          const res = await fetch("/api/admin/home-layout", { headers });
          const j = await res.json();
          applicaLayout(Array.isArray(j.layout) && j.layout.length ? (j.layout as Item[]) : DEFAULT_LAYOUT);
        } catch {
          applicaLayout(DEFAULT_LAYOUT);
        }
        // Maniglie iniettate in ogni isola
        const GRIP =
          '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>';
        cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((t) => {
          const mv = document.createElement("div");
          mv.className = "tile-move";
          mv.title = tr("home.move");
          mv.innerHTML = GRIP;
          const rz = document.createElement("div");
          rz.className = "tile-resize";
          rz.title = tr("home.resize");
          t.appendChild(mv);
          t.appendChild(rz);

          // Trascinamento (riordino) — Pointer Events: funziona con mouse,
          // trackpad, dito (iPad/iPhone) e Apple Pencil.
          // REGOLA D'ORO: durante il trascinamento NON si tocca il DOM della
          // tile trascinata. Spostarla nel DOM annulla il pointer capture e il
          // drag si interrompe. Quindi la tile esce dal flusso (position:fixed)
          // e nella griglia si muove un SEGNAPOSTO; alla fine la tile prende
          // il posto del segnaposto.
          mv.addEventListener("pointerdown", (e: PointerEvent) => {
            if (!editing) return;
            e.preventDefault();
            e.stopPropagation();
            try { mv.setPointerCapture(e.pointerId); } catch { /* ok */ }

            const r0 = t.getBoundingClientRect();
            const startX = e.clientX, startY = e.clientY;
            let px = startX, py = startY;
            let bersaglio: HTMLElement | null = null;

            // Segnaposto: occupa esattamente la cella lasciata libera
            const ph = document.createElement("div");
            ph.className = "tile-ph";
            ph.style.gridColumn = t.style.gridColumn || "";
            ph.style.gridRowEnd = t.style.gridRowEnd || "";
            t.parentElement?.insertBefore(ph, t);

            t.classList.add("dragging");
            t.style.position = "fixed";
            t.style.left = r0.left + "px";
            t.style.top = r0.top + "px";
            t.style.width = r0.width + "px";
            t.style.height = r0.height + "px";
            t.style.margin = "0";
            t.style.transition = "none";
            t.style.transform = "translate(0px, 0px)";
            document.body.style.userSelect = "none";

            // position:fixed → lo scorrimento della pagina non sposta la tile:
            // basta lo scarto del puntatore rispetto al punto di partenza.
            const segui = () => {
              t.style.transform = `translate(${px - startX}px, ${py - startY}px)`;
            };

            // Auto-scroll vicino ai bordi alto/basso
            let raf = requestAnimationFrame(function ciclo() {
              const h = window.innerHeight;
              let d = 0;
              if (py < 100) d = -Math.min(22, (100 - py) / 3);
              else if (py > h - 100) d = Math.min(22, (py - (h - 100)) / 3);
              if (d) window.scrollBy(0, d);
              raf = requestAnimationFrame(ciclo);
            });

            // Posizione REALE (senza la traslazione dell'animazione in corso)
            const posReale = (o: HTMLElement): DOMRect => {
              const r = o.getBoundingClientRect();
              const tr = getComputedStyle(o).transform;
              if (!tr || tr === "none") return r;
              try {
                const m = new DOMMatrixReadOnly(tr);
                return new DOMRect(r.left - m.m41, r.top - m.m42, r.width, r.height);
              } catch {
                return r;
              }
            };

            // FLIP: le altre isole scivolano al nuovo posto invece di saltare
            const anima = (prima: Map<HTMLElement, DOMRect>) => {
              const altre = Array.from(cards.querySelectorAll<HTMLElement>(".tile[data-tile]")).filter((o) => o !== t);
              for (const o of altre) { o.style.transition = "none"; o.style.transform = "none"; }
              const dopo = altre.map((o) => o.getBoundingClientRect());
              altre.forEach((o, i2) => {
                const p0 = prima.get(o);
                if (!p0) return;
                const dx = p0.left - dopo[i2].left, dy = p0.top - dopo[i2].top;
                if (!dx && !dy) return;
                o.style.transform = `translate(${dx}px, ${dy}px)`;
              });
              requestAnimationFrame(() => {
                for (const o of altre) {
                  o.style.transition = "transform 0.2s cubic-bezier(0.2, 0.7, 0.3, 1)";
                  o.style.transform = "";
                }
              });
            };

            const onMove = (ev: PointerEvent) => {
              px = ev.clientX; py = ev.clientY;
              segui();

              let b: HTMLElement | null = null;
              for (const o of Array.from(cards.querySelectorAll<HTMLElement>(".tile[data-tile]"))) {
                if (o === t) continue;
                const r = posReale(o);
                if (r.width && px >= r.left && px <= r.right && py >= r.top && py <= r.bottom) { b = o; break; }
              }
              if (!b) { bersaglio = null; return; }
              if (b === bersaglio) return; // già scambiata: niente tremolio
              bersaglio = b;

              const prima = new Map<HTMLElement, DOMRect>();
              cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((o) => prima.set(o, o.getBoundingClientRect()));
              const r = posReale(b);
              const sotto = py - r.top > r.height / 2 || px - r.left > r.width / 2;
              if (sotto) b.after(ph); else b.before(ph);
              anima(prima);
            };

            const fine = (ev: PointerEvent) => {
              cancelAnimationFrame(raf);
              try { mv.releasePointerCapture(ev.pointerId); } catch { /* ok */ }
              mv.removeEventListener("pointermove", onMove);
              mv.removeEventListener("pointerup", fine);
              mv.removeEventListener("pointercancel", fine);
              document.body.style.userSelect = "";

              // La tile prende il posto del segnaposto
              ph.parentElement?.insertBefore(t, ph);
              ph.remove();
              t.classList.remove("dragging");
              for (const k of ["position", "left", "top", "width", "height", "margin", "transform", "transition"]) {
                t.style.removeProperty(k);
              }
              cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((o) => {
                o.style.transition = ""; o.style.transform = "";
              });
              applicaSpans();
              cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((o) => spanAltezza(o));
              salva();
            };

            mv.addEventListener("pointermove", onMove);
            mv.addEventListener("pointerup", fine);
            mv.addEventListener("pointercancel", fine);
          });

          // Ridimensionamento — maniglia in basso a destra (larghezza + altezza)
          rz.addEventListener("pointerdown", (e) => {
            if (!editing) return;
            e.preventDefault();
            e.stopPropagation();
            rz.setPointerCapture(e.pointerId);
            const startX = e.clientX, startY = e.clientY;
            const startW = Math.min(4, Math.max(1, Number(t.dataset.w || 1)));
            const startH = t.getBoundingClientRect().height;
            const c = colonne();
            const cellW = (cards.clientWidth - 12 * (c - 1)) / c;
            const onMove = (ev: PointerEvent) => {
              // Larghezza: già a scatti di colonna
              const w = Math.min(c, Math.max(1, startW + Math.round((ev.clientX - startX) / cellW)));
              t.dataset.w = String(w);
              t.style.gridColumn = "span " + w;
              let nh = Math.round(Math.min(900, Math.max(140, startH + (ev.clientY - startY))));
              // SNAP DI RIGA: se il fondo arriva vicino (±16px) al fondo di
              // un'altra tile, si aggancia per allinearsi con quella riga.
              const mioTop = t.getBoundingClientRect().top;
              let aggancio: number | null = null;
              cards.querySelectorAll<HTMLElement>(".tile[data-tile]").forEach((o) => {
                if (o === t) return;
                const cand = o.getBoundingClientRect().bottom - mioTop;
                if (cand < 140) return;
                if (Math.abs(cand - nh) < 16 && (aggancio === null || Math.abs(cand - nh) < Math.abs(aggancio - nh))) aggancio = cand;
              });
              if (aggancio !== null) nh = Math.round(aggancio);
              t.dataset.minh = String(nh);
              t.style.minHeight = nh + "px";
            };
            const onUp = (ev: PointerEvent) => {
              rz.releasePointerCapture(ev.pointerId);
              rz.removeEventListener("pointermove", onMove);
              rz.removeEventListener("pointerup", onUp);
              salva();
            };
            rz.addEventListener("pointermove", onMove);
            rz.addEventListener("pointerup", onUp);
          });
        });

        // In modalità edit i link delle isole non navigano
        cards.addEventListener("click", (e) => {
          if (!editing) return;
          if ((e.target as HTMLElement).closest("a.tile")) e.preventDefault();
        }, true);

        function setEditing(on: boolean) {
          editing = on;
          cards.classList.toggle("editing", on);
          btn?.classList.toggle("is-on", on);
          if (btn) btn.title = on ? tr("home.done") : tr("home.organizeTiles");
          if (btnReset) btnReset.style.display = on ? "flex" : "none";
          if (btnTuiles && !isMobile()) btnTuiles.style.display = on ? "flex" : "none";
        }
        btn?.addEventListener("click", () => setEditing(!editing));
        btnReset?.addEventListener("click", () => { applicaLayout(DEFAULT_LAYOUT); salva(); });

        // ---- Modale « Tuiles » : ogni isola ha un interruttore ----
        // ⚠️ Solo le tile che ESISTONO. Commandes, Réservations, Google,
        // Horaires e Notes sono salite nella fascia della giornata, che e' fissa:
        // lasciarle in elenco voleva dire proporre nel modale «Tuiles»
        // interruttori che non accendono niente.
        const NOMI: Record<string, string> = {
          special: tr("home.specialDays"), menu: tr("nav.menu"),
          visibilite: tr("home.visibility"), assets: tr("home.photos"),
        };
        const ovTuiles = document.getElementById("tuiles-overlay") as HTMLElement | null;
        const listaTuiles = document.getElementById("tuiles-list") as HTMLElement | null;

        function costruisciLista() {
          if (!listaTuiles) return;
          const m = mappa();
          listaTuiles.innerHTML = "";
          for (const key of KEYS) {
            const t = m.get(key);
            if (!t) continue;
            const spenta = t.classList.contains("is-off");
            // Isola non disponibile — Google senza Place ID, o funzione spenta
            // dal super in Pages visibles — : non la proponiamo. `getComputedStyle`
            // perche' la seconda e' una regola CSS, non uno stile inline: una
            // tile «Commandes» da riaccendere in un locale che non prende
            // ordini e' un interruttore che non accende niente.
            if (!spenta && getComputedStyle(t).display === "none") continue;

            const riga = document.createElement("div");
            riga.className = "tm-row";
            const nome = document.createElement("span");
            nome.className = "tm-nom";
            nome.textContent = NOMI[key] ?? key;
            const sw = document.createElement("label");
            sw.className = "switch";
            const inp = document.createElement("input");
            inp.type = "checkbox";
            inp.checked = !spenta;
            const track = document.createElement("span");
            track.className = "track";
            inp.addEventListener("change", () => {
              t.classList.toggle("is-off", !inp.checked);
              applicaSpans();
              spanAltezza(t);
              salva();
            });
            sw.appendChild(inp);
            sw.appendChild(track);
            riga.appendChild(nome);
            riga.appendChild(sw);
            listaTuiles.appendChild(riga);
          }
        }
        const chiudiTuiles = () => { if (ovTuiles) ovTuiles.hidden = true; };
        btnTuiles?.addEventListener("click", () => { costruisciLista(); if (ovTuiles) ovTuiles.hidden = false; });
        ovTuiles?.querySelectorAll("[data-md-close]").forEach((el) => el.addEventListener("click", chiudiTuiles));
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") chiudiTuiles(); });
      })();
    </script>
  </body>
</html>
