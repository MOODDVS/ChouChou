    <!-- Modale Notes -->
    <div class="overlay" id="evt-overlay">
      <div class="evm-modal">
        <button type="button" class="evm-x" id="evt-close" aria-label={t("common.close")}>✕</button>
        <h2 class="evm-titre">{t("home.localEvents")}</h2>
        <p class="evm-sub">{t("home.localEventsIntro")}</p>
        <label class="evm-lab" for="evt-nom">{t("home.name")}</label>
        <input id="evt-nom" class="evm-in" maxlength="80" placeholder={t("home.eventNamePh")} autocomplete="off" />
        <label class="evm-lab" for="evt-date">{t("home.date")}</label>
        <input id="evt-date" class="evm-in" readonly placeholder={t("home.chooseDate")} />
        <label class="evm-check"><input type="checkbox" id="evt-yearly" />{t("home.yearly")}</label>
        <button type="button" class="evm-add" id="evt-add">{t("common.add")}</button>
        <div class="evm-list" id="evt-list"></div>
      </div>
