---
// Pannello admin — MENU (§4.3): tab per sezione, gestione sezioni
// (creare/rinominare/riordinare/eliminare, tipo cibo/bevanda)
// e CRUD dei piatti.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import ImagePicker from "../../components/admin/ImagePicker.astro";
import { CLIENT } from "../../config/client";
import { verificaTokenLocale } from "../../lib/admin/adminAuth";
import { caricaMenuPagina } from "../../lib/admin/caricaMenu";

export const prerender = false;

// SSR (Fase 2): se il cookie di sessione è valido, pre-carichiamo categorie +
// piatti sul server. Altrimenti ssrMenu resta null e la pagina carica come
// prima (nessun rischio).
let ssrMenu: unknown = null;
try {
  const token = Astro.cookies.get("mdd_at")?.value ?? "";
  const staff = token ? await verificaTokenLocale(token) : null;
  if (staff) ssrMenu = await caricaMenuPagina();
} catch {
  ssrMenu = null;
}
const ssrMenuJson = ssrMenu ? JSON.stringify(ssrMenu).replace(/</g, "\\u003c") : "";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{"Menu — Admin " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#231f20" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-bg: #231f20;
        --c-text: #ffffff;
        --c-accent: #dfab4e;
        --c-muted: #b3aca6;
        --c-line: #3a3335;
        --c-card: #362c28;
        --font-title: "Bebas Neue", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; overflow-x: hidden; }
      #app { display: none; min-height: 100vh; flex-direction: column; }

      main { flex: 1; padding: 2rem 2rem 8rem; width: 100%; }
      .topbar { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
      .t-stats { display: flex; gap: 0.45rem; flex-wrap: wrap; }
      .t-pill {
        display: inline-flex; align-items: center; gap: 0.4rem;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        border-radius: 999px; padding: 0.32rem 0.9rem; font-size: 0.82rem; white-space: nowrap;
      }
      .t-pill b { color: #fff; font-size: 0.95rem; }
      .t-pill.gold { border-color: var(--c-accent); }
      .t-pill.gold b { color: var(--c-accent); }
      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; }
      h1 svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .spacer { flex: 1; }
      .state { color: var(--c-muted); text-align: center; padding: 3rem 1rem; }

      .actionsbar { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; padding-bottom: 1.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--c-line); }
      .actionsbar .search {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-size: 0.88rem; padding: 0.45rem 1rem 0.45rem 2.3rem;
        border-radius: 999px; flex: 0 1 300px; min-width: 200px; margin-left: auto;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23b3aca6' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='8'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg>");
        background-repeat: no-repeat; background-position: 0.9rem center; background-size: 14px;
      }
      .search:focus { outline: none; border-color: var(--c-accent); }

      .pill {
        font-family: var(--font-title); letter-spacing: 0.05em; cursor: pointer; border-radius: 999px;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .mn-float { position: fixed; right: 1.5rem; bottom: 1.25rem; z-index: 90; display: flex; gap: 0.6rem; }
      .mn-fab {
        display: inline-flex; align-items: center; box-sizing: border-box;
        background: var(--c-accent); color: #231f20; border: 1px solid var(--c-accent);
        font-size: 1.05rem; padding: 0 1.5rem; border-radius: 999px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
        transition: background 0.2s, color 0.2s, transform 0.15s, border-color 0.2s;
      }
      .mn-fab:hover { background: #c9963d; border-color: #c9963d; transform: scale(0.94); }
      .mn-fab svg {
        width: 17px; height: 17px; margin-right: 0.45rem; display: block;
        fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
      }
      @media (max-width: 520px) { .mn-float { bottom: calc(1.25rem + 72px); right: 1rem; } }
      .add-btn { background: var(--c-accent); color: #231f20; border: 1px solid var(--c-accent); font-size: 1.05rem; padding: 0.55rem 1.6rem; }
      .add-btn:hover { background: transparent; color: var(--c-accent); }
      .sec-btn { background: transparent; color: var(--c-muted); border: 1px solid var(--c-line); font-size: 1.05rem; padding: 0.55rem 1.4rem; }
      .sec-btn:hover { color: var(--c-accent); border-color: var(--c-accent); }

      /* Icone cibo/bevanda */
      .k-ico {
        width: 16px; height: 16px; fill: none; stroke: currentColor;
        stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        display: inline-block; vertical-align: -3px;
      }
      .k-ico-fill { fill: currentColor; stroke: none; }

      /* --- Tabs sezioni --- */
      .tabs {
        display: flex; gap: 0.4rem; overflow-x: auto; padding: 0.2rem 0;
        flex: 1; min-width: 0; scrollbar-width: thin;
      }
      .tab {
        flex-shrink: 0; background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-body); font-size: 0.82rem; letter-spacing: 0;
        padding: 0.4rem 1rem; cursor: pointer; border-radius: 999px;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .tab:hover { color: var(--c-text); border-color: var(--c-accent); }
      .tab.is-active { background: var(--c-accent); border-color: var(--c-accent); color: #231f20; font-weight: 700; }
      .tab .n { font-size: 0.75rem; opacity: 0.75; margin-left: 0.3rem; }
      .tab .k-ico { width: 13px; height: 13px; margin-right: 0.35rem; vertical-align: -2px; }
      .k-filtri {
        display: flex; gap: 0.45rem; flex-wrap: wrap;
        padding-bottom: 1.25rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--c-line);
      }
      .kf-pill {
        display: inline-flex; align-items: center; gap: 0.45rem;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.05em;
        padding: 0.5rem 1.2rem; border-radius: 10px; cursor: pointer;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .kf-pill:hover { border-color: var(--c-accent); color: var(--c-text); }
      .kf-pill.is-on { background: var(--c-accent); border-color: var(--c-accent); color: #231f20; }
      .kf-pill .k-ico { width: 15px; height: 15px; }
      .kf-pill .t-ico {
        width: 16px; height: 16px; margin-right: 0;
        fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
      }

      .cat-head { display: flex; align-items: baseline; gap: 0.6rem; margin: 1rem 0 0.6rem; }
      .cat-name { font-family: var(--font-title); font-size: 1.5rem; letter-spacing: 0.04em; color: var(--c-accent); }
      .cat-count { color: var(--c-muted); font-size: 0.8rem; }

      .item {
        display: flex; align-items: center; gap: 0.9rem;
        background: var(--c-card); border: 1px solid var(--c-line);
        padding: 0.7rem 1rem; margin-bottom: 0.4rem;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
      }
      .item.is-hidden-item { opacity: 0.55; }
      .i-thumb {
        width: 44px; height: 44px; flex-shrink: 0; border-radius: 8px;
        object-fit: cover; border: 1px solid var(--c-line); display: block;
      }
      .i-thumb--ph {
        display: flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.04); color: var(--c-muted);
      }
      .ph-ico { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
      .i-main { flex: 1; min-width: 0; }
      .i-name { font-weight: 700; }
      .i-badges { display: inline-flex; gap: 0.3rem; margin-left: 0.5rem; vertical-align: middle; }
      .i-badge { font-size: 0.82rem; line-height: 1; }
      .b-best { color: var(--c-accent); }
      .i-desc { color: var(--c-muted); font-size: 0.8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .i-alg { color: var(--c-muted); font-size: 0.72rem; white-space: nowrap; }
      .i-price { font-family: var(--font-title); font-size: 1.15rem; letter-spacing: 0.03em; white-space: nowrap; margin-right: 1.25rem; }
      .i-promo { color: var(--c-accent); }
      .i-old { color: var(--c-muted); font-size: 0.85rem; margin-right: 0.35rem; }
      .i-col { display: inline-flex; flex-direction: column; align-items: flex-end; vertical-align: middle; min-width: 5.2rem; }
      .i-col + .i-col { margin-left: 1.5rem; }
      .i-full { color: var(--c-text); }
      .i-strike { text-decoration: line-through; text-decoration-thickness: 2px; opacity: 0.55; }
      .i-table-lab { font-size: 0.55rem; color: var(--c-muted); font-family: var(--font-body); text-transform: uppercase; letter-spacing: 0.06em; line-height: 1.4; }

      .sw-wrap { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }
      .sw-lab { font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); }
      .switch { position: relative; width: 38px; height: 21px; flex-shrink: 0; }
      .switch input { opacity: 0; width: 0; height: 0; }
      .switch .track { position: absolute; inset: 0; cursor: pointer; border-radius: 999px; background: var(--c-line); transition: background 0.2s; }
      .switch .track::before {
        content: ""; position: absolute; width: 15px; height: 15px; border-radius: 50%;
        left: 3px; top: 3px; background: var(--c-muted); transition: transform 0.2s, background 0.2s;
      }
      .switch input:checked + .track { background: var(--c-accent); }
      .switch input:checked + .track::before { transform: translateX(17px); background: #231f20; }

      .i-btn {
        width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
        background: transparent; border: 1px solid var(--c-line); color: var(--c-text);
        cursor: pointer; border-radius: 50%; font-size: 0.95rem;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
      }
      .i-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .i-btn:disabled { opacity: 0.3; cursor: not-allowed; }
      .i-del { background: rgba(237, 28, 36, 0.25); border-color: rgba(237, 28, 36, 0.35); color: #ffffff; }
      .i-del:hover { background: rgba(237, 28, 36, 0.55); border-color: #ed1c24; color: #ffffff; }
      .i-del .k-ico { width: 15px; height: 15px; }
      .i-del.confirm { background: #a3320f; border-color: #a3320f; color: #fff; width: auto; padding: 0 0.7rem; border-radius: 999px; font-size: 0.75rem; }
      .k-btn.is-active { background: var(--c-accent); border-color: var(--c-accent); color: #231f20; }
      .k-btn.is-active:hover { color: #231f20; border-color: var(--c-accent); }

      /* --- Modali --- */
      .overlay {
        position: fixed; inset: 0; z-index: 300; display: none;
        background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
        align-items: flex-start; justify-content: center; padding: 4vh 1rem; overflow-y: auto;
      }
      .overlay.is-open { display: flex; }
      .modal { width: 100%; max-width: 620px; background: var(--c-bg); border: 1px solid var(--c-line); padding: 1.75rem; position: relative; }
      .modal h2 { font-family: var(--font-title); font-size: 1.6rem; letter-spacing: 0.04em; margin-bottom: 1.25rem; }
      .m-close { position: absolute; top: 0.8rem; right: 1rem; background: none; border: none; color: var(--c-muted); font-size: 1.6rem; cursor: pointer; line-height: 1; }
      .m-close:hover { color: var(--c-text); }

      .f-row { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
      .f-field { display: flex; flex-direction: column; gap: 0.3rem; flex: 1; min-width: 150px; }
      .f-label { font-size: 0.72rem; color: var(--c-muted); letter-spacing: 0.05em; text-transform: uppercase; }
      input[type="text"], input[type="number"], select, textarea {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-size: 0.95rem; padding: 0.55rem 0.7rem; border-radius: 0;
        width: 100%; color-scheme: dark;
      }
      input:focus, select:focus, textarea:focus { outline: none; border-color: var(--c-accent); }
      textarea { resize: vertical; min-height: 56px; }

      .alg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.35rem; }
      .alg-item { display: flex; align-items: center; gap: 0.45rem; font-size: 0.85rem; cursor: pointer; padding: 0.25rem 0.3rem; }
      .alg-item input { accent-color: var(--c-accent); width: 16px; height: 16px; flex-shrink: 0; }
      .alg-num { color: var(--c-muted); font-size: 0.72rem; min-width: 1.2rem; }

      .f-img-row { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
      .f-img-prev {
        width: 64px; height: 64px; border-radius: 8px; overflow: hidden; flex-shrink: 0;
        border: 1px solid var(--c-line); background: rgba(255, 255, 255, 0.04);
        display: flex; align-items: center; justify-content: center; color: var(--c-muted);
      }
      .f-img-prev img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .f-img-btn { font-size: 0.95rem; padding: 0.45rem 1.2rem; }

      .m-toggles { display: flex; gap: 2rem; margin: 0.4rem 0 1.2rem; }
      .m-toggle { display: flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; }
      .m-toggle .switch { width: 44px; height: 24px; }
      .m-toggle .switch .track::before { width: 18px; height: 18px; }
      .m-toggle .switch input:checked + .track::before { transform: translateX(20px); }
      .m-badges { flex-wrap: wrap; gap: 1.1rem 1.6rem; margin-top: 0.2rem; }
      .m-sublabel { display: block; margin-bottom: 0.4rem; }

      .m-actions { display: flex; align-items: center; justify-content: flex-end; gap: 1rem; border-top: 1px solid var(--c-line); padding-top: 1.2rem; }
      .m-cancel { background: transparent; border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-body); font-size: 0.85rem; padding: 0.6rem 1.4rem; cursor: pointer; border-radius: 999px; }
      .m-cancel:hover { color: var(--c-text); border-color: var(--c-text); }
      .m-save {
        background: var(--c-accent); color: #231f20; border: 1px solid var(--c-accent);
        font-family: var(--font-title); font-size: 1.1rem; letter-spacing: 0.05em;
        padding: 0.6rem 2rem; cursor: pointer; border-radius: 999px;
        transition: background 0.2s, color 0.2s;
      }
      .m-save:hover:not(:disabled) { background: transparent; color: var(--c-accent); }
      .m-save:disabled { opacity: 0.5; cursor: not-allowed; }
      .m-msg { color: #ff6b6b; font-size: 0.85rem; flex: 1; }

      /* --- Modale sezioni --- */
      .sec-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.45rem; }
      .sec-row input[type="text"] { flex: 1; }
      .sec-count { color: var(--c-muted); font-size: 0.75rem; white-space: nowrap; min-width: 4.5rem; text-align: right; }
      .sec-kind { display: inline-flex; gap: 0.3rem; }
      .s-drag { cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none; font-size: 1.05rem; }
      .s-drag:active { cursor: grabbing; }
      .sec-row.dragging { opacity: 0.65; outline: 1px dashed var(--c-accent); background: var(--c-card); }
      .i-drag { cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none; font-size: 1.05rem; flex-shrink: 0; }
      .i-drag:active { cursor: grabbing; }
      #list[data-mode="search"] .i-drag { display: none; }
      .item.dragging { opacity: 0.65; outline: 1px dashed var(--c-accent); }
      .sec-add { display: flex; gap: 0.5rem; margin-top: 1rem; border-top: 1px solid var(--c-line); padding-top: 1rem; align-items: center; }
      .sec-add input { flex: 1; }
      .sec-addbtn {
        background: transparent; border: 1px solid var(--c-accent); color: var(--c-accent);
        font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.05em;
        padding: 0.45rem 1.4rem; cursor: pointer; border-radius: 999px;
      }
      .sec-addbtn:hover { background: var(--c-accent); color: #231f20; }

      /* Toast */
      .toast {
        position: fixed; top: 1rem; left: 50%; transform: translateX(-50%) translateY(-8px);
        z-index: 400; background: var(--c-card); border: 1px solid var(--c-line);
        padding: 0.7rem 1.3rem; font-size: 0.9rem; border-radius: 999px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.25s;
      }
      .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
      .toast.err { border-color: #a3320f; color: #ff8a8f; }

      @media (max-width: 640px) {
        main { padding: 1.5rem 1rem 8rem; }
        .actionsbar .search { flex-basis: 100%; order: 3; margin-left: 0; }

        /* Card piatto riorganizzata su griglia:
           r1: handle · nome+descrizione · edit
           r2:          prezzo · allergeni
           r3: toggle Menu · toggle Cmd  ·  delete */
        .item {
          display: grid;
          grid-template-columns: auto auto 1fr auto;
          row-gap: 0.7rem;
          column-gap: 0.9rem;
          align-items: center;
        }
        .i-drag { grid-column: 1; grid-row: 1; align-self: start; }
        .i-thumb { grid-column: 2; grid-row: 1; width: 40px; height: 40px; align-self: start; }
        .i-main { grid-column: 3; grid-row: 1; }
        .i-desc { white-space: normal; margin-top: 0.2rem; }
        .i-edit { grid-column: 4; grid-row: 1; align-self: start; justify-self: end; }
        .i-price { grid-column: 2; grid-row: 2; justify-self: start; margin-right: 0; }
        .i-price .i-col { align-items: flex-start; min-width: 0; }
        .i-price .i-col + .i-col { margin-left: 1rem; }
        .i-alg { grid-column: 3 / 5; grid-row: 2; justify-self: start; }
        .sw-wrap:has(.t-av) { grid-column: 2; grid-row: 3; justify-self: start; }
        .sw-wrap:has(.t-or) { grid-column: 3; grid-row: 3; justify-self: start; }
        .i-del { grid-column: 4; grid-row: 3; justify-self: end; }
      }
      /* Loader dentro i bottoni di salvataggio */
      .is-loading { position: relative; color: transparent !important; pointer-events: none; }
      .is-loading::after {
        content: ""; position: absolute; inset: 0; margin: auto;
        width: 18px; height: 18px; border-radius: 50%;
        border: 2px solid rgba(35, 31, 32, 0.3); border-top-color: #231f20;
        animation: btnspin 0.7s linear infinite;
      }
      @keyframes btnspin { to { transform: rotate(360deg); } }
    </style>
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <div class="topbar">
          <h1><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>Menu</h1>
          <div class="t-stats" id="t-stats"></div>
        </div>
        <div class="k-filtri" id="k-filtri"></div>
        <div class="actionsbar">
          <div class="tabs" id="tabs"></div>
          <input type="text" class="search" id="search" placeholder="Rechercher un plat…" />
        </div>
        <div class="state" id="state">Chargement…</div>
        <div id="list"></div>
      </main>
      <AdminFooter />
    </div>

    <!-- Modale piatto -->
    <div class="overlay" id="overlay">
      <div class="modal">
        <button class="m-close" id="m-close" aria-label="Fermer">×</button>
        <h2 id="m-title">Ajouter un plat</h2>
        <div class="f-row">
          <div class="f-field" style="flex: 2">
            <span class="f-label">Nom *</span>
            <input type="text" id="f-name" maxlength="120" />
          </div>
          <div class="f-field">
            <span class="f-label">Prix (€) *</span>
            <input type="number" id="f-price" min="0" step="0.01" inputmode="decimal" />
          </div>
        </div>
        <div class="f-row">
          <div class="f-field" style="flex: 2">
            <span class="f-label">Section *</span>
            <select id="f-cat"></select>
          </div>
        </div>
        <div class="f-row">
          <div class="f-field">
            <span class="f-label">Photo (optionnelle)</span>
            <div class="f-img-row">
              <span class="f-img-prev" id="f-img-prev"></span>
              <button type="button" class="pill sec-btn f-img-btn" id="f-img-up">Téléverser une photo</button>
              <button type="button" class="pill sec-btn f-img-btn" id="f-img-lib">Bibliothèque</button>
              <button type="button" class="pill sec-btn f-img-btn" id="f-img-del" style="display: none">Retirer</button>
              <input type="file" id="f-img-file" accept=".jpg,.jpeg,.png,.webp,.gif" style="display: none" />
              <span class="f-label" id="f-img-state"></span>
            </div>
          </div>
        </div>
        <div class="f-row">
          <div class="f-field">
            <span class="f-label">Réduction</span>
            <select id="f-dtype">
              <option value="">Aucune</option>
              <option value="fixed">Prix promo fixe (€)</option>
              <option value="percent">Pourcentage (%)</option>
            </select>
          </div>
          <div class="f-field">
            <span class="f-label">Valeur</span>
            <input type="number" id="f-dval" min="0" step="0.01" inputmode="decimal" disabled />
          </div>
          <div class="f-field">
            <span class="f-label">Application</span>
            <select id="f-dscope" disabled>
              <option value="all">Partout</option>
              <option value="online">Commandes en ligne uniquement</option>
            </select>
          </div>
        </div>
        <div class="f-row">
          <div class="f-field">
            <span class="f-label">Description (FR)</span>
            <textarea id="f-dfr" maxlength="500"></textarea>
          </div>
        </div>
        <div class="f-row">
          <div class="f-field">
            <span class="f-label">Description (EN)</span>
            <textarea id="f-den" maxlength="500"></textarea>
          </div>
        </div>
        <div class="f-row">
          <div class="f-field">
            <span class="f-label">Allergènes (UE)</span>
            <div class="alg-grid" id="f-alg"></div>
          </div>
        </div>
        <span class="f-label m-sublabel">Badges</span>
        <div class="m-toggles m-badges">
          <label class="m-toggle">
            <span class="switch"><input type="checkbox" id="f-best" /><span class="track"></span></span>
            ★ Best-seller
          </label>
          <label class="m-toggle">
            <span class="switch"><input type="checkbox" id="f-vegan" /><span class="track"></span></span>
            🌱 Végan
          </label>
          <label class="m-toggle">
            <span class="switch"><input type="checkbox" id="f-spicy" /><span class="track"></span></span>
            🌶️ Épicé
          </label>
          <label class="m-toggle">
            <span class="switch"><input type="checkbox" id="f-suggestion" /><span class="track"></span></span>
            👨‍🍳 Suggestion
          </label>
        </div>
        <div class="m-toggles">
          <label class="m-toggle">
            <span class="switch"><input type="checkbox" id="f-av" checked /><span class="track"></span></span>
            Visible sur le site
          </label>
          <label class="m-toggle">
            <span class="switch"><input type="checkbox" id="f-or" checked /><span class="track"></span></span>
            Commandable
          </label>
        </div>
        <div class="m-actions">
          <span class="m-msg" id="m-msg"></span>
          <button class="m-cancel" id="m-cancel">Annuler</button>
          <button class="m-save" id="m-save">Enregistrer</button>
        </div>
      </div>
    </div>

    <!-- Modale sezioni -->
    <div class="overlay" id="sec-overlay">
      <div class="modal">
        <button class="m-close" id="sec-close" aria-label="Fermer">×</button>
        <h2>Gérer les sections</h2>
        <p class="f-label" style="margin-bottom: 0.8rem">Glisse ⠿ pour réordonner · renomme et appuie Entrée · 🍴/🍷 = nourriture ou boisson · suppression possible seulement si vide</p>
        <div id="sec-list"></div>
        <div class="sec-add">
          <span class="sec-kind" id="sec-kind"></span>
          <input type="text" id="sec-new" placeholder="Nouvelle section (ex. Pizzas colorées)" maxlength="60" />
          <button class="sec-addbtn" id="sec-addbtn">Ajouter</button>
        </div>
        <span class="m-msg" id="sec-msg"></span>
      </div>
    </div>

    <div class="toast" id="toast"></div>

    <ImagePicker />

    <!-- Bottoni flottanti (come Résa/Commandes/Clients) -->
    <div class="mn-float" id="mn-float">
      <button class="pill mn-fab mn-fab-sec" id="sec-btn" title="Gérer les sections">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
        Catégories
      </button>
      <button class="pill mn-fab" id="add-btn" title="Ajouter un plat">+ Ajou. plat</button>
    </div>

    <AdminNav current="menu" />

    <!-- Dati SSR (Fase 2): categorie + piatti pre-caricati dal server. -->
    <script id="ssr-menu" type="application/json" is:inline set:html={ssrMenuJson}></script>

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { comprimiFoto } from "../../lib/admin/imageCompress";

      type Item = {
        id: string; category: string; category_order: number; sort_order: number;
        name: string; description_fr: string | null; description_en: string | null;
        allergens: number[]; price_cents: number; available: boolean; orderable: boolean;
        discount_type: "fixed" | "percent" | null; discount_value: number; discount_scope: "all" | "online";
        is_bestseller: boolean; is_vegan: boolean; is_spicy: boolean; is_suggestion: boolean;
        image_url: string | null;
      };
      type Cat = { id: string; name: string; sort_order: number; kind: "food" | "drink"; count: number };

      const ALLERGENI: [number, string][] = [
        [1, "Gluten"], [2, "Lait"], [3, "Arachides"], [4, "Œufs"],
        [5, "Poisson"], [6, "Crustacés"], [7, "Soja"], [8, "Fruits à coque"],
        [9, "Céleri"], [10, "Moutarde"], [11, "Sulfites"], [12, "Sésame"],
        [13, "Lupin"], [14, "Mollusques"],
      ];

      // Icone cibo (forchetta) e bevanda (bicchiere)
      const ICO_FOOD =
        '<svg class="k-ico k-ico-fill" viewBox="0 0 489.773 489.773" aria-hidden="true"><path d="M155.183,305.646c-2.081,0.175-4.157,0.265-6.238,0.265c-5.693,0-11.23-0.826-16.652-2.081L6.834,429.293c-6.158,6.149-6.158,16.137,0,22.287l32.47,32.478c6.158,6.15,16.135,6.15,22.276,0l150.785-150.757l-27.944-30.15L155.183,305.646z"/><path d="M485.345,104.649c-5.888-5.885-15.417-5.885-21.304,0l-81.303,81.301c-7.693,7.685-20.154,7.685-27.847,0c-7.659-7.679-7.659-20.13,0-27.807l80.901-80.884c6.112-6.118,6.112-16.036,0-22.168c-6.141-6.11-16.055-6.11-22.167,0l-80.868,80.876c-7.693,7.693-20.14,7.693-27.833,0c-7.677-7.676-7.677-20.136,0-27.806l81.286-81.293c5.904-5.894,5.904-15.441,0-21.343c-5.888-5.895-15.434-5.895-21.338,0l-91.458,91.463c-21.989,22.003-28.935,52.888-21.816,80.991l61.31,61.314c28.101,7.093,59.001,0.144,80.965-21.841l91.471-91.458C491.249,120.1,491.249,110.543,485.345,104.649z"/><path d="M41.093,13.791c-3.134-3.135-7.372-4.854-11.724-4.854c-0.926,0-1.857,0.079-2.766,0.231c-5.295,0.896-9.838,4.295-12.172,9.133c-26.79,55.373-15.594,121.631,27.894,165.121l77.801,77.791c7.676,7.685,18.055,11.939,28.819,11.939c1.151,0,2.305-0.048,3.456-0.143l45.171-3.855l196.971,212.489c3.058,3.303,7.342,5.221,11.855,5.31c0.093,0,0.19,0,0.288,0c4.412,0,8.636-1.743,11.771-4.855l33.734-33.741c3.117-3.11,4.859-7.331,4.859-11.73c0-4.398-1.742-8.622-4.846-11.732L41.093,13.791z"/></svg>';
      const ICO_DRINK =
        '<svg class="k-ico k-ico-fill" viewBox="0 0 512 512" aria-hidden="true"><path d="M438.925,169.204c-3.253-48.149-21.943-109.273-49.729-160.47C386.273,3.354,380.642,0,374.523,0H137.371c-6.12,0-11.75,3.354-14.674,8.734C96.79,56.469,78.792,112.855,73.819,159.304C61.745,272.036,142.207,357.641,239.25,366.527v112.081h-66.783c-9.217,0-16.696,7.473-16.696,16.696c0,9.223,7.479,16.696,16.696,16.696h166.956c9.217,0,16.696-7.473,16.696-16.696c0-9.223-7.479-16.696-16.696-16.696H272.53V366.553C367.133,358.044,446.157,276.148,438.925,169.204z M294.903,289.391c-9.22,0-16.696-7.475-16.696-16.696c0-9.22,7.475-16.696,16.696-16.696s16.696,7.475,16.696,16.696C311.599,281.916,304.124,289.391,294.903,289.391z M216.99,256c-9.22,0-16.696-7.475-16.696-16.696c0-9.22,7.475-16.696,16.696-16.696s16.696,7.475,16.696,16.696C233.686,248.525,226.211,256,216.99,256z M269.64,158.759c-20.171-7.144-42.739-7.154-64.184,1.371c-11.132,4.445-31.724,16.625-58.911,3.022c-12.041-6.021-25.183-9.1-38.385-9.454c5.412-37.404,19.692-81.765,39.299-120.307h216.978c20.585,40.464,35.26,87.307,39.991,125.802c-23.48-8.624-49.899-7.326-72.469,3.959C303.217,177.532,280.771,162.66,269.64,158.759z"/></svg>';

      const ICO_TRASH =
        '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /></svg>';
      const ICO_IMG =
        '<svg class="ph-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>';

      let items: Item[] = [];
      let cats: Cat[] = [];
      let attiva = ""; // nome sezione attiva
      type KindTab = "food" | "drink" | "lunch" | "menus";
      let kindFiltro: KindTab = "food"; // filtro tab: cibo, bevande, lunch, menus
      let editId: string | null = null;
      let nuovaKind: "food" | "drink" = "food";
      let headers: Record<string, string> = {};

      function esc(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }
      function effettivo(it: Item): number {
        if (!it.discount_type || !it.discount_value) return it.price_cents;
        if (it.discount_type === "fixed") return Math.min(it.price_cents, it.discount_value);
        return Math.max(0, Math.round(it.price_cents * (1 - Math.min(it.discount_value, 100) / 100)));
      }
      function euro(cents: number): string {
        return (cents / 100).toLocaleString("fr-BE", { style: "currency", currency: "EUR" });
      }

      const toastEl = document.getElementById("toast") as HTMLDivElement;
      let toastTimer: number | undefined;
      function toast(msg: string, err = false) {
        toastEl.textContent = msg;
        toastEl.className = "toast show" + (err ? " err" : "");
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toastEl.classList.remove("show"), 2500);
      }

      // ---------- Rendering ----------
      const listEl = document.getElementById("list") as HTMLDivElement;
      const tabsEl = document.getElementById("tabs") as HTMLDivElement;
      const stateEl = document.getElementById("state") as HTMLDivElement;
      const searchEl = document.getElementById("search") as HTMLInputElement;

      function prezzoHTML(it: Item): string {
        const eff = effettivo(it);
        if (eff >= it.price_cents) return `<span class="i-price">${euro(it.price_cents)}</span>`;
        if (it.discount_scope === "online") {
          return `<span class="i-price i-promo">` +
            `<span class="i-col"><span class="i-full">${euro(it.price_cents)}</span><span class="i-table-lab">à table</span></span>` +
            `<span class="i-col"><span>${euro(eff)}</span><span class="i-table-lab">online</span></span>` +
            `</span>`;
        }
        return `<span class="i-price i-promo">` +
          `<span class="i-col"><span class="i-full i-strike">${euro(it.price_cents)}</span></span>` +
          `<span class="i-col"><span>${euro(eff)}</span></span>` +
          `</span>`;
      }
      function badgesHTML(it: Item): string {
        let b = "";
        if (it.is_bestseller) b += `<span class="i-badge b-best" title="Best-seller">★</span>`;
        if (it.is_vegan) b += `<span class="i-badge" title="Végan">🌱</span>`;
        if (it.is_spicy) b += `<span class="i-badge" title="Épicé">🌶️</span>`;
        if (it.is_suggestion) b += `<span class="i-badge" title="Suggestion">👨‍🍳</span>`;
        return b ? `<span class="i-badges">${b}</span>` : "";
      }
      function itemHTML(it: Item): string {
        const desc = it.description_fr ? `<div class="i-desc">${esc(it.description_fr)}</div>` : "";
        const alg = it.allergens?.length ? `<span class="i-alg">Alg. ${it.allergens.join(",")}</span>` : "";
        const dim = !it.available ? " is-hidden-item" : "";
        const thumb = it.image_url
          ? `<img class="i-thumb" src="${esc(it.image_url)}" alt="" loading="lazy" />`
          : `<span class="i-thumb i-thumb--ph" title="Pas de photo">${ICO_IMG}</span>`;
        return `
          <div class="item${dim}" data-id="${it.id}">
            <span class="i-btn i-drag" title="Glisser pour réordonner">⠿</span>
            ${thumb}
            <div class="i-main"><span class="i-name">${esc(it.name)}${badgesHTML(it)}</span>${desc}</div>
            ${alg}
            ${prezzoHTML(it)}
            <span class="sw-wrap"><label class="switch"><input type="checkbox" class="t-av" ${it.available ? "checked" : ""} /><span class="track"></span></label><span class="sw-lab">Menu</span></span>
            <span class="sw-wrap"><label class="switch"><input type="checkbox" class="t-or" ${it.orderable ? "checked" : ""} /><span class="track"></span></label><span class="sw-lab">Cmd</span></span>
            <button class="i-btn i-edit" title="Modifier">✎</button>
            <button class="i-btn i-del" title="Supprimer">${ICO_TRASH}</button>
          </div>`;
      }

      function posizionaMenuFabs() {
        const barra = document.querySelector(".admin-nav") as HTMLElement | null;
        const box = document.getElementById("mn-float") as HTMLElement | null;
        if (!barra || !box) return;
        if (!window.matchMedia("(min-width: 521px)").matches) {
          box.style.bottom = "";
          box.querySelectorAll<HTMLElement>(".mn-fab").forEach((b) => (b.style.height = ""));
          return;
        }
        const r = barra.getBoundingClientRect();
        box.style.bottom = `${window.innerHeight - r.bottom}px`;
        box.querySelectorAll<HTMLElement>(".mn-fab").forEach((b) => (b.style.height = `${r.height}px`));
      }
      window.addEventListener("resize", posizionaMenuFabs);
      window.addEventListener("DOMContentLoaded", posizionaMenuFabs);
      posizionaMenuFabs();

      function renderStatsTitolo() {
        const nCibo = cats.filter((c) => c.kind === "food").reduce((t, c) => t + c.count, 0);
        const nBev = cats.filter((c) => c.kind === "drink").reduce((t, c) => t + c.count, 0);
        (document.getElementById("t-stats") as HTMLDivElement).innerHTML =
          `<span class="t-pill gold"><b>${nCibo}</b> plat${nCibo > 1 ? "s" : ""}</span>` +
          `<span class="t-pill"><b>${nBev}</b> boisson${nBev > 1 ? "s" : ""}</span>`;
      }
      function renderTabs() {
        renderStatsTitolo();
        // Se la sezione attiva è dell'altro tipo, segui il suo tipo
        const catAttiva = cats.find((c) => c.name === attiva);
        if (catAttiva && catAttiva.kind !== kindFiltro) kindFiltro = catAttiva.kind;

        const visibili = cats.filter((c) => c.kind === kindFiltro);
        (document.getElementById("k-filtri") as HTMLDivElement).innerHTML =
          `<button class="kf-pill${kindFiltro === "food" ? " is-on" : ""}" data-kind="food">${ICO_FOOD}Plats</button>` +
          `<button class="kf-pill${kindFiltro === "drink" ? " is-on" : ""}" data-kind="drink">${ICO_DRINK}Boissons</button>` +
          `<button class="kf-pill${kindFiltro === "lunch" ? " is-on" : ""}" data-kind="lunch"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" /></svg>Lunch</button>` +
          `<button class="kf-pill${kindFiltro === "menus" ? " is-on" : ""}" data-kind="menus"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>Menus</button>`;
        tabsEl.innerHTML =
          visibili
            .map(
              (c) =>
                `<button class="tab${c.name === attiva ? " is-active" : ""}" data-cat="${esc(c.name)}">${esc(c.name)}<span class="n">${c.count}</span></button>`
            )
            .join("");
      }

      function renderList() {
        const filtro = searchEl.value.trim().toLowerCase();
        listEl.dataset.mode = filtro ? "search" : "cat";
        // Tab in costruzione: per ora vuoti (li riempiremo più avanti)
        if (!filtro && (kindFiltro === "lunch" || kindFiltro === "menus")) {
          listEl.innerHTML = `<p class="state">Section « ${kindFiltro === "lunch" ? "Lunch" : "Menus"} » — bientôt.</p>`;
          return;
        }
        if (filtro) {
          // Ricerca globale: risultati raggruppati per sezione
          const gruppi = new Map<string, Item[]>();
          for (const it of items) {
            if (!it.name.toLowerCase().includes(filtro)) continue;
            if (!gruppi.has(it.category)) gruppi.set(it.category, []);
            gruppi.get(it.category)!.push(it);
          }
          if (gruppi.size === 0) {
            listEl.innerHTML = '<p class="state">Aucun plat trouvé.</p>';
            return;
          }
          const ordinati = [...gruppi.entries()].sort(
            (a, b) => (cats.find((c) => c.name === a[0])?.sort_order ?? 0) - (cats.find((c) => c.name === b[0])?.sort_order ?? 0)
          );
          listEl.innerHTML = ordinati
            .map(
              ([nome, arr]) => `
            <div class="cat-head"><span class="cat-name">${esc(nome)}</span><span class="cat-count">${arr.length}</span></div>
            ${arr.map(itemHTML).join("")}`
            )
            .join("");
          return;
        }
        // Vista normale: solo la sezione attiva
        const arr = items.filter((i) => i.category === attiva);
        listEl.innerHTML = arr.length
          ? arr.map(itemHTML).join("")
          : '<p class="state">Section vide — ajoute un plat ou supprime la section.</p>';
      }

      async function caricaTutto(datiIniziali?: { categories: Cat[]; items: Item[] }) {
        if (datiIniziali) {
          // Dati già pronti dal server (SSR): niente fetch.
          cats = datiIniziali.categories ?? [];
          items = datiIniziali.items ?? [];
        } else {
          const [rc, ri] = await Promise.all([
            fetch("/api/admin/categories", { headers }),
            fetch("/api/admin/menu", { headers }),
          ]);
          if (!rc.ok || !ri.ok) {
            stateEl.textContent = "Erreur de chargement.";
            return false;
          }
          cats = ((await rc.json()).categories as Cat[]) ?? [];
          items = ((await ri.json()).items as Item[]) ?? [];
        }
        if (!attiva || !cats.some((c) => c.name === attiva)) {
          attiva = cats.find((c) => c.kind === kindFiltro)?.name ?? cats[0]?.name ?? "";
        }
        stateEl.style.display = "none";
        renderTabs();
        renderList();
        renderSezioni();
        return true;
      }

      // ---------- Modale piatto ----------
      const overlay = document.getElementById("overlay") as HTMLDivElement;
      const mTitle = document.getElementById("m-title") as HTMLHeadingElement;
      const mMsg = document.getElementById("m-msg") as HTMLSpanElement;
      const fName = document.getElementById("f-name") as HTMLInputElement;
      const fPrice = document.getElementById("f-price") as HTMLInputElement;
      const fCat = document.getElementById("f-cat") as HTMLSelectElement;
      const fDfr = document.getElementById("f-dfr") as HTMLTextAreaElement;
      const fDen = document.getElementById("f-den") as HTMLTextAreaElement;
      const fAlg = document.getElementById("f-alg") as HTMLDivElement;
      const fDtype = document.getElementById("f-dtype") as HTMLSelectElement;
      const fDval = document.getElementById("f-dval") as HTMLInputElement;
      const fDscope = document.getElementById("f-dscope") as HTMLSelectElement;
      const fAv = document.getElementById("f-av") as HTMLInputElement;
      const fOr = document.getElementById("f-or") as HTMLInputElement;
      const fBest = document.getElementById("f-best") as HTMLInputElement;
      const fVegan = document.getElementById("f-vegan") as HTMLInputElement;
      const fSpicy = document.getElementById("f-spicy") as HTMLInputElement;
      const fSuggestion = document.getElementById("f-suggestion") as HTMLInputElement;
      const mSave = document.getElementById("m-save") as HTMLButtonElement;
      const fImgPrev = document.getElementById("f-img-prev") as HTMLSpanElement;
      const fImgUp = document.getElementById("f-img-up") as HTMLButtonElement;
      const fImgDel = document.getElementById("f-img-del") as HTMLButtonElement;
      const fImgFile = document.getElementById("f-img-file") as HTMLInputElement;
      const fImgState = document.getElementById("f-img-state") as HTMLSpanElement;
      let imgUrl: string | null = null;

      function renderFotoPrev() {
        fImgPrev.innerHTML = imgUrl ? `<img src="${esc(imgUrl)}" alt="" />` : ICO_IMG;
        fImgDel.style.display = imgUrl ? "" : "none";
      }
      fImgUp.addEventListener("click", () => fImgFile.click());
      fImgDel.addEventListener("click", () => { imgUrl = null; renderFotoPrev(); });
      (document.getElementById("f-img-lib") as HTMLButtonElement).addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("imgpick:open"));
      });
      window.addEventListener("imgpick:pick", (e) => {
        if (!overlay.classList.contains("is-open")) return; // modale piatto chiuso
        imgUrl = (e as CustomEvent<{ url: string }>).detail.url;
        renderFotoPrev();
        fImgState.textContent = "";
      });
      fImgFile.addEventListener("change", async () => {
        const file = fImgFile.files?.[0];
        if (!file) return;
        fImgState.textContent = "Compression…";
        fImgUp.disabled = true;
        try {
          const foto = await comprimiFoto(file);
          if (foto.size > 4 * 1024 * 1024) throw new Error("Photo trop lourde (max 4 Mo)");
          fImgState.textContent = "Téléversement…";
          const b64 = await new Promise<string>((resolve, reject) => {
            const r = new FileReader();
            r.onload = () => resolve(String(r.result).split(",")[1] ?? "");
            r.onerror = () => reject(new Error("Fichier illisible"));
            r.readAsDataURL(foto);
          });
          const res = await fetch("/api/admin/upload", {
            method: "POST",
            headers: { ...headers, "Content-Type": "application/json" },
            body: JSON.stringify({ filename: foto.name, data: b64, bucket: "menu" }),
          });
          const j = await res.json();
          if (!res.ok) throw new Error(j.error ?? "Téléversement impossible");
          imgUrl = j.url as string;
          renderFotoPrev();
          fImgState.textContent = "";
        } catch (err) {
          fImgState.textContent = err instanceof Error ? err.message : "Téléversement impossible.";
        } finally {
          fImgUp.disabled = false;
          fImgFile.value = "";
        }
      });

      fAlg.innerHTML = ALLERGENI.map(
        ([n, lab]) => `<label class="alg-item"><input type="checkbox" value="${n}" /><span class="alg-num">${n}</span>${lab}</label>`
      ).join("");

      function maxSort(cat: string): number {
        return items.filter((i) => i.category === cat).reduce((mx, i) => Math.max(mx, i.sort_order), 0);
      }

      function apriModale(it: Item | null) {
        editId = it?.id ?? null;
        mTitle.textContent = it ? "Modifier le plat" : "Ajouter un plat";
        mMsg.textContent = "";
        fCat.innerHTML = cats.map((c) => `<option value="${esc(c.name)}">${esc(c.name)}</option>`).join("");
        fName.value = it?.name ?? "";
        fPrice.value = it ? (it.price_cents / 100).toFixed(2) : "";
        fCat.value = it?.category ?? attiva;
        fDfr.value = it?.description_fr ?? "";
        fDen.value = it?.description_en ?? "";
        fDtype.value = it?.discount_type ?? "";
        fDscope.value = it?.discount_scope ?? "all";
        if (it?.discount_type === "fixed") fDval.value = (it.discount_value / 100).toFixed(2);
        else if (it?.discount_type === "percent") fDval.value = String(it.discount_value);
        else fDval.value = "";
        aggiornaCampiSconto();
        fAv.checked = it?.available ?? true;
        fOr.checked = it?.orderable ?? true;
        fBest.checked = it?.is_bestseller ?? false;
        fVegan.checked = it?.is_vegan ?? false;
        fSpicy.checked = it?.is_spicy ?? false;
        fSuggestion.checked = it?.is_suggestion ?? false;
        imgUrl = it?.image_url ?? null;
        fImgState.textContent = "";
        renderFotoPrev();
        fAlg.querySelectorAll<HTMLInputElement>("input").forEach((cb) => {
          cb.checked = !!it?.allergens?.includes(Number(cb.value));
        });
        overlay.classList.add("is-open");
        fName.focus();
      }
      function chiudiModale() {
        overlay.classList.remove("is-open");
        editId = null;
      }

      function aggiornaCampiSconto() {
        const t = fDtype.value;
        fDval.disabled = !t;
        fDscope.disabled = !t;
        if (t === "percent") { fDval.step = "1"; fDval.max = "99"; fDval.placeholder = "10"; }
        else { fDval.step = "0.01"; fDval.removeAttribute("max"); fDval.placeholder = "12,00"; }
      }
      fDtype.addEventListener("change", aggiornaCampiSconto);

      async function salvaModale() {
        mMsg.textContent = "";
        if (!fName.value.trim()) { mMsg.textContent = "Nom requis."; return; }
        if (!fCat.value) { mMsg.textContent = "Section requise."; return; }
        const prezzo = Math.round(parseFloat(fPrice.value.replace(",", ".")) * 100);
        if (!Number.isFinite(prezzo) || prezzo < 0) { mMsg.textContent = "Prix invalide."; return; }

        const orig = editId ? items.find((x) => x.id === editId) : null;
        const body: Record<string, unknown> = {
          name: fName.value.trim(),
          category: fCat.value,
          price_cents: prezzo,
          description_fr: fDfr.value,
          description_en: fDen.value,
          allergens: [...fAlg.querySelectorAll<HTMLInputElement>("input:checked")].map((cb) => Number(cb.value)),
          available: fAv.checked,
          orderable: fOr.checked,
          is_bestseller: fBest.checked,
          is_vegan: fVegan.checked,
          is_spicy: fSpicy.checked,
          is_suggestion: fSuggestion.checked,
          image_url: imgUrl,
          discount_type: fDtype.value || null,
          discount_value: fDtype.value === "fixed"
            ? Math.round(parseFloat(fDval.value.replace(",", ".") || "0") * 100)
            : Math.round(Number(fDval.value || 0)),
          discount_scope: (fDscope.value as "all" | "online") || "all",
        };
        if (fDtype.value && !(Number(body.discount_value) > 0)) {
          mMsg.textContent = "Valeur de réduction requise.";
          return;
        }
        if (editId) body.id = editId;
        // Posizione automatica: nuovo piatto (o piatto spostato di sezione) in coda
        if (!editId || (orig && orig.category !== fCat.value)) {
          body.sort_order = maxSort(fCat.value) + 1;
        }

        mSave.disabled = true;
        mSave.classList.add("is-loading");
        try {
          const res = await fetch("/api/admin/menu", {
            method: editId ? "PUT" : "POST",
            headers: { ...headers, "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
          const j = await res.json();
          if (!res.ok) {
            mMsg.textContent = j.error ?? "Erreur d'enregistrement.";
          } else {
            attiva = fCat.value;
            chiudiModale();
            toast(editId ? "Plat modifié ✓" : "Plat ajouté ✓");
            await caricaTutto();
          }
        } catch {
          mMsg.textContent = "Erreur de connexion.";
        } finally {
          mSave.disabled = false;
          mSave.classList.remove("is-loading");
        }
      }

      // ---------- Modale sezioni ----------
      const secOverlay = document.getElementById("sec-overlay") as HTMLDivElement;
      const secList = document.getElementById("sec-list") as HTMLDivElement;
      const secNew = document.getElementById("sec-new") as HTMLInputElement;
      const secMsg = document.getElementById("sec-msg") as HTMLSpanElement;
      const secKind = document.getElementById("sec-kind") as HTMLSpanElement;

      function renderSezioni() {
        secList.innerHTML = cats
          .map(
            (c, i) => `
          <div class="sec-row" data-id="${c.id}" data-name="${esc(c.name)}">
            <span class="i-btn s-drag" title="Glisser pour réordonner">⠿</span>
            <button class="i-btn k-btn s-kfood${c.kind === "food" ? " is-active" : ""}" title="Nourriture">${ICO_FOOD}</button>
            <button class="i-btn k-btn s-kdrink${c.kind === "drink" ? " is-active" : ""}" title="Boisson">${ICO_DRINK}</button>
            <input type="text" class="s-name" value="${esc(c.name)}" maxlength="60" />
            <span class="sec-count">${c.count} plat${c.count > 1 ? "s" : ""}</span>
            <button class="i-btn i-del s-del" ${c.count > 0 ? "disabled" : ""} title="Supprimer (si vide)">${ICO_TRASH}</button>
          </div>`
          )
          .join("");
      }

      // Selettore tipo per la NUOVA sezione
      function renderNuovaKind() {
        secKind.innerHTML =
          `<button class="i-btn k-btn${nuovaKind === "food" ? " is-active" : ""}" id="snk-food" title="Nourriture">${ICO_FOOD}</button>` +
          `<button class="i-btn k-btn${nuovaKind === "drink" ? " is-active" : ""}" id="snk-drink" title="Boisson">${ICO_DRINK}</button>`;
      }
      secKind.addEventListener("click", (e) => {
        const t = (e.target as HTMLElement).closest("button");
        if (!t) return;
        nuovaKind = t.id === "snk-drink" ? "drink" : "food";
        renderNuovaKind();
      });

      async function putCategoria(id: string, campi: Record<string, unknown>): Promise<boolean> {
        const res = await fetch("/api/admin/categories", {
          method: "PUT",
          headers: { ...headers, "Content-Type": "application/json" },
          body: JSON.stringify({ id, ...campi }),
        });
        if (!res.ok) {
          const j = await res.json();
          secMsg.textContent = j.error ?? "Erreur.";
          return false;
        }
        return true;
      }

      secList.addEventListener("click", async (e) => {
        secMsg.textContent = "";
        const t = e.target as HTMLElement;
        const row = t.closest(".sec-row") as HTMLElement | null;
        if (!row) return;
        const id = row.dataset.id!;
        const idx = cats.findIndex((c) => c.id === id);

        if (t.closest(".s-kfood") || t.closest(".s-kdrink")) {
          const kind = t.closest(".s-kdrink") ? "drink" : "food";
          if (cats[idx].kind !== kind && (await putCategoria(id, { kind }))) {
            await caricaTutto();
          }
          return;
        }
        if (t.closest(".s-del")) {
          const res = await fetch("/api/admin/categories?id=" + id, { method: "DELETE", headers });
          if (!res.ok) {
            const j = await res.json();
            secMsg.textContent = j.error ?? "Suppression impossible.";
          } else {
            toast("Section supprimée");
            await caricaTutto();
          }
        }
      });

      // Rinomina: Enter o perdita di focus
      secList.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && (e.target as HTMLElement).classList.contains("s-name")) {
          (e.target as HTMLInputElement).blur();
        }
      });
      secList.addEventListener("focusout", async (e) => {
        const t = e.target as HTMLInputElement;
        if (!t.classList.contains("s-name")) return;
        const row = t.closest(".sec-row") as HTMLElement;
        const vecchio = row.dataset.name!;
        const nuovo = t.value.trim();
        if (!nuovo || nuovo === vecchio) { t.value = vecchio; return; }
        secMsg.textContent = "";
        if (await putCategoria(row.dataset.id!, { name: nuovo })) {
          if (attiva === vecchio) attiva = nuovo;
          toast("Section renommée ✓");
          await caricaTutto();
        } else {
          t.value = vecchio;
        }
      });

      // Drag & drop per riordinare le sezioni (mouse + dito)
      let dragRow: HTMLElement | null = null;
      secList.addEventListener("pointerdown", (e) => {
        const handle = (e.target as HTMLElement).closest(".s-drag");
        if (!handle) return;
        e.preventDefault();
        dragRow = handle.closest(".sec-row") as HTMLElement;
        dragRow.classList.add("dragging");
      });
      document.addEventListener("pointermove", (e) => {
        if (!dragRow) return;
        e.preventDefault();
        const rows = [...secList.querySelectorAll<HTMLElement>(".sec-row")].filter((r) => r !== dragRow);
        const dopo = rows.find((r) => {
          const rect = r.getBoundingClientRect();
          return e.clientY < rect.top + rect.height / 2;
        });
        if (dopo) secList.insertBefore(dragRow!, dopo);
        else secList.appendChild(dragRow!);
      });
      document.addEventListener("pointerup", async () => {
        if (!dragRow) return;
        dragRow.classList.remove("dragging");
        dragRow = null;
        const ordine = [...secList.querySelectorAll<HTMLElement>(".sec-row")].map((r) => r.dataset.id!);
        if (JSON.stringify(ordine) === JSON.stringify(cats.map((c) => c.id))) return;
        const res = await fetch("/api/admin/categories", {
          method: "PATCH",
          headers: { ...headers, "Content-Type": "application/json" },
          body: JSON.stringify({ order: ordine }),
        });
        if (!res.ok) {
          const j = await res.json();
          secMsg.textContent = j.error ?? "Réordonnancement impossible.";
          renderSezioni();
        } else {
          toast("Ordre enregistré ✓");
          await caricaTutto();
        }
      });

      (document.getElementById("sec-addbtn") as HTMLButtonElement).addEventListener("click", async () => {
        secMsg.textContent = "";
        const name = secNew.value.trim();
        if (!name) { secMsg.textContent = "Nom requis."; return; }
        const res = await fetch("/api/admin/categories", {
          method: "POST",
          headers: { ...headers, "Content-Type": "application/json" },
          body: JSON.stringify({ name, kind: nuovaKind }),
        });
        const j = await res.json();
        if (!res.ok) {
          secMsg.textContent = j.error ?? "Erreur.";
        } else {
          secNew.value = "";
          nuovaKind = "food";
          renderNuovaKind();
          toast("Section ajoutée ✓");
          await caricaTutto();
        }
      });

      // ---------- Avvio ----------
      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        headers = { Authorization: `Bearer ${session.access_token ?? ""}` };

        renderNuovaKind();
        // Primo caricamento: usa i dati SSR (Fase 2) se presenti, senza fetch.
        let ssrMenuDati: { categories: Cat[]; items: Item[] } | null = null;
        try {
          const raw = document.getElementById("ssr-menu")?.textContent?.trim();
          if (raw) ssrMenuDati = JSON.parse(raw);
        } catch {
          ssrMenuDati = null;
        }
        await caricaTutto(ssrMenuDati ?? undefined);

        searchEl.addEventListener("input", renderList);
        (document.getElementById("k-filtri") as HTMLDivElement).addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".kf-pill") as HTMLElement | null;
          if (!t || !t.dataset.kind) return;
          kindFiltro = t.dataset.kind as KindTab;
          attiva = cats.find((c) => c.kind === kindFiltro)?.name ?? "";
          searchEl.value = "";
          renderTabs();
          renderList();
        });
        tabsEl.addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".tab") as HTMLElement | null;
          if (!t) return;
          if (t.dataset.kind) {
            kindFiltro = t.dataset.kind as "food" | "drink";
            attiva = cats.find((c) => c.kind === kindFiltro)?.name ?? "";
          } else {
            attiva = t.dataset.cat!;
          }
          searchEl.value = "";
          renderTabs();
          renderList();
        });

        (document.getElementById("add-btn") as HTMLButtonElement).addEventListener("click", () => apriModale(null));
        (document.getElementById("sec-btn") as HTMLButtonElement).addEventListener("click", () => {
          secMsg.textContent = "";
          renderSezioni();
          secOverlay.classList.add("is-open");
        });
        (document.getElementById("m-close") as HTMLButtonElement).addEventListener("click", chiudiModale);
        (document.getElementById("m-cancel") as HTMLButtonElement).addEventListener("click", chiudiModale);
        (document.getElementById("sec-close") as HTMLButtonElement).addEventListener("click", () => secOverlay.classList.remove("is-open"));
        mSave.addEventListener("click", salvaModale);
        overlay.addEventListener("click", (e) => { if (e.target === overlay) chiudiModale(); });
        secOverlay.addEventListener("click", (e) => { if (e.target === secOverlay) secOverlay.classList.remove("is-open"); });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") { chiudiModale(); secOverlay.classList.remove("is-open"); }
        });

        // Azioni sui piatti (delega)
        listEl.addEventListener("click", async (e) => {
          const t = e.target as HTMLElement;
          const row = t.closest(".item") as HTMLElement | null;
          if (!row) return;
          const id = row.dataset.id!;
          const it = items.find((x) => x.id === id);
          if (!it) return;

          if (t.closest(".i-edit")) { apriModale(it); return; }
          const del = t.closest(".i-del") as HTMLButtonElement | null;
          if (del) {
            if (!del.classList.contains("confirm")) {
              del.classList.add("confirm");
              del.textContent = "Confirmer ?";
              setTimeout(() => { del.classList.remove("confirm"); del.innerHTML = ICO_TRASH; }, 3000);
              return;
            }
            try {
              const res = await fetch("/api/admin/menu?id=" + id, { method: "DELETE", headers });
              if (!res.ok) { toast("Suppression impossible", true); return; }
              toast("Plat supprimé");
              await caricaTutto();
            } catch {
              toast("Erreur de connexion", true);
            }
          }
        });

        // Drag & drop dei piatti nella sezione attiva (mouse + dito)
        let dragItem: HTMLElement | null = null;
        listEl.addEventListener("pointerdown", (e) => {
          if (listEl.dataset.mode === "search") return;
          const handle = (e.target as HTMLElement).closest(".i-drag");
          if (!handle) return;
          e.preventDefault();
          dragItem = handle.closest(".item") as HTMLElement;
          dragItem.classList.add("dragging");
        });
        document.addEventListener("pointermove", (e) => {
          if (!dragItem) return;
          e.preventDefault();
          const rows = [...listEl.querySelectorAll<HTMLElement>(".item")].filter((r) => r !== dragItem);
          const dopo = rows.find((r) => {
            const rect = r.getBoundingClientRect();
            return e.clientY < rect.top + rect.height / 2;
          });
          if (dopo) listEl.insertBefore(dragItem!, dopo);
          else listEl.appendChild(dragItem!);
        });
        document.addEventListener("pointerup", async () => {
          if (!dragItem) return;
          dragItem.classList.remove("dragging");
          dragItem = null;
          const ordine = [...listEl.querySelectorAll<HTMLElement>(".item")].map((r) => r.dataset.id!);
          const attuale = items.filter((i) => i.category === attiva).map((i) => i.id);
          if (JSON.stringify(ordine) === JSON.stringify(attuale)) return;
          const res = await fetch("/api/admin/menu", {
            method: "PATCH",
            headers: { ...headers, "Content-Type": "application/json" },
            body: JSON.stringify({ category: attiva, order: ordine }),
          });
          if (!res.ok) {
            toast("Réordonnancement impossible", true);
            renderList();
          } else {
            toast("Ordre enregistré ✓");
            await caricaTutto();
          }
        });

        listEl.addEventListener("change", async (e) => {
          const t = e.target as HTMLInputElement;
          if (!t.classList.contains("t-av") && !t.classList.contains("t-or")) return;
          const row = t.closest(".item") as HTMLElement;
          const id = row.dataset.id!;
          const campo = t.classList.contains("t-av") ? "available" : "orderable";
          try {
            const res = await fetch("/api/admin/menu", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id, [campo]: t.checked }),
            });
            if (!res.ok) throw new Error();
            const it = items.find((x) => x.id === id);
            if (it) (it as any)[campo] = t.checked;
            if (campo === "available") row.classList.toggle("is-hidden-item", !t.checked);
          } catch {
            t.checked = !t.checked;
            toast("Modification impossible", true);
          }
        });
      })();
    </script>
  </body>
</html>
