---
// Pannello admin — MENU (§4.3): tab per sezione, gestione sezioni
// (creare/rinominare/riordinare/eliminare, tipo cibo/bevanda)
// e CRUD dei piatti.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHead from "../../components/admin/AdminHead.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import ImagePicker from "../../components/admin/ImagePicker.astro";
import { CLIENT } from "../../config/client";
import { verificaTokenLocale } from "../../lib/admin/adminAuth";
import { caricaMenuPagina } from "../../lib/admin/caricaMenu";
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";
import { supabaseAdmin } from "../../lib/db";
import { normalizzaLinguePubbliche, LINGUE_PUBBLICHE } from "../../lib/admin/superAdmin";
import "../../styles/datepicker.css";

const lang = await adminLang();
const t = adminT(lang);

export const prerender = false;

// SSR (Fase 2): se il cookie di sessione è valido, pre-carichiamo categorie +
// piatti sul server. Altrimenti ssrMenu resta null e la pagina carica come
// prima (nessun rischio).
let ssrMenu: unknown = null;
try {
  const token = Astro.cookies.get("mdd_at")?.value ?? "";
  const staff = token ? await verificaTokenLocale(token) : null;
  if (staff) ssrMenu = await caricaMenuPagina();
} catch {
  ssrMenu = null;
}
const ssrMenuJson = ssrMenu ? JSON.stringify(ssrMenu).replace(/</g, "\\u003c") : "";

// Lingue del SITO PUBBLICO (per i campi traduzione dei piatti): { langs, def }.
let pubLangs: { langs: string[]; def: string } = { langs: ["fr"], def: "fr" };
try {
  const { data } = await supabaseAdmin
    .from("app_config")
    .select("key, value")
    .in("key", ["public_languages", "public_lang_default"]);
  const m = new Map((data ?? []).map((r) => [String(r.key), String(r.value ?? "")]));
  pubLangs = normalizzaLinguePubbliche(m.get("public_languages") ?? "", m.get("public_lang_default") ?? "");
} catch { /* default fr */ }
const pubLangsJson = JSON.stringify({
  langs: pubLangs.langs,
  def: pubLangs.def,
  labels: Object.fromEntries(LINGUE_PUBBLICHE.map((l) => [l.code, { label: l.label, flag: l.flag }])),
}).replace(/</g, "\\u003c");
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("nav.menu") + " — Admin " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@700&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-hover: #e04f00;
        --c-input: #e6e6e6;
        --c-bg: #ffffff;
        --c-text: #666666;
        --c-accent: #ff7300;
        --c-muted: #a6a6a6;
        --c-line: #ebebeb;
        --c-card: #ffffff;
        --font-title: "Quicksand", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; overflow-x: hidden; }
      #app { display: none; min-height: 100vh; flex-direction: column; }

      main { flex: 1; padding: 2rem 2rem 8rem; width: 100%; }
      .topbar { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
      .t-stats { display: flex; gap: 0.45rem; flex-wrap: wrap; }
      .t-pill {
        display: inline-flex; align-items: center; gap: 0.4rem;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        border-radius: 999px; padding: 0.32rem 0.9rem; font-size: 0.82rem; white-space: nowrap;
      }
      .t-pill b { color: var(--c-text); font-size: 0.95rem; }
      .t-pill.gold { border-color: var(--c-accent); }
      .t-pill.gold b { color: var(--c-accent); }
      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; }
      h1 svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .spacer { flex: 1; }
      .state { color: var(--c-muted); text-align: center; padding: 3rem 1rem; }

      .actionsbar { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; padding-bottom: 0.5rem; margin-bottom: 1rem; }
      .actionsbar .search {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-size: 0.88rem; padding: 0.45rem 1rem 0.45rem 2.3rem;
        border-radius: 999px; flex: 0 1 300px; min-width: 200px; margin-left: auto;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23b3aca6' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='8'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg>");
        background-repeat: no-repeat; background-position: 0.9rem center; background-size: 14px;
      }
      .search:focus { outline: none; border-color: var(--c-accent); }

      .pill {
        font-family: var(--font-title); letter-spacing: 0.05em; cursor: pointer; border-radius: 999px;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .mn-float { position: fixed; right: 1.5rem; bottom: 1.25rem; z-index: 90; display: flex; gap: 0.6rem; }
      .mn-fab {
        display: inline-flex; align-items: center; box-sizing: border-box;
        background: var(--c-accent); color: var(--c-bg); border: 1px solid var(--c-accent);
        font-size: 1.05rem; padding: 0 1.1rem; border-radius: 999px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, calc(0.45 * var(--sh, 0.15)));
        transition: background 0.2s, color 0.2s, transform 0.15s, border-color 0.2s;
      }
      .mn-fab:hover { background: var(--c-hover); border-color: var(--c-hover); transform: scale(0.94); }
      .mn-fab svg {
        width: 17px; height: 17px; margin-right: 0.45rem; display: block;
        fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
      }
      @media (max-width: 520px) { .mn-float { bottom: calc(1.25rem + 72px); right: 1rem; } }
      .add-btn { background: var(--c-accent); color: var(--c-bg); border: 1px solid var(--c-accent); font-size: 1.05rem; padding: 0.55rem 1.6rem; }
      .add-btn:hover { background: transparent; color: var(--c-accent); }
      .sec-btn { background: transparent; color: var(--c-muted); border: 1px solid var(--c-line); font-size: 1.05rem; padding: 0.55rem 1.4rem; }
      .sec-btn:hover { color: var(--c-accent); border-color: var(--c-accent); }

      /* Icone cibo/bevanda */
      .k-ico {
        width: 16px; height: 16px; fill: none; stroke: currentColor;
        stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        display: inline-block; vertical-align: -3px;
      }
      .k-ico-fill { fill: currentColor; stroke: none; }

      /* --- Tabs sezioni --- */
      .tabs {
        display: flex; gap: 0.4rem; overflow-x: auto; padding: 0.2rem 0;
        flex: 1; min-width: 0; scrollbar-width: thin;
      }
      .tab {
        flex-shrink: 0; background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-body); font-size: 0.82rem; letter-spacing: 0;
        padding: 0.4rem 1rem; cursor: pointer; border-radius: 999px;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .tab:hover { color: var(--c-text); border-color: var(--c-accent); }
      .tab.is-active { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); font-weight: 700; }
      .tab .n { font-size: 0.75rem; opacity: 0.75; margin-left: 0.3rem; }
      .tab .k-ico { width: 13px; height: 13px; margin-right: 0.35rem; vertical-align: -2px; }
      .tab.is-sub { border-style: dashed; border-color: color-mix(in srgb, var(--c-accent) 45%, var(--c-line)); background: color-mix(in srgb, var(--c-accent) 8%, transparent); font-size: 0.78rem; padding-left: 0.7rem; }
      .tab.is-sub.is-active { border-style: solid; background: var(--c-accent); }
      .tab .tab-arrow { color: var(--c-accent); margin-right: 0.3rem; font-weight: 700; letter-spacing: -2px; }
      .tab.is-active .tab-arrow { color: var(--c-bg); }
      .k-filtri {
        display: flex; gap: 0.45rem; flex-wrap: wrap;
        padding-bottom: 1.25rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--c-line);
      }
      .kf-pill {
        display: inline-flex; align-items: center; gap: 0.45rem;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.05em;
        padding: 0.5rem 1.2rem; border-radius: 10px; cursor: pointer;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .kf-pill:hover { border-color: var(--c-accent); color: var(--c-text); }
      .kf-pill.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .kf-pill .k-ico { width: 15px; height: 15px; }
      .kf-pill .t-ico {
        width: 16px; height: 16px; margin-right: 0;
        fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
      }

      .cat-head { display: flex; align-items: baseline; gap: 0.6rem; margin: 1rem 0 0.6rem; }
      .cat-name { font-family: var(--font-title); font-size: 1.5rem; letter-spacing: 0.04em; color: var(--c-accent); }
      .cat-count { color: var(--c-muted); font-size: 0.8rem; }
      .sub-head {
        display: flex; align-items: center; gap: 0.6rem;
        margin: 0.55rem 0 0.45rem; padding: 0.55rem 1rem;
        background: color-mix(in srgb, var(--c-card) 78%, #fff);
        border: 1px solid color-mix(in srgb, #fff 14%, transparent);
        border-radius: 12px; color: #fff; user-select: none;
        transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
      }
      .sub-head.dragging { opacity: 0.6; }
      .sub-head.drop-target { background: color-mix(in srgb, var(--c-accent) 48%, var(--c-bg)); border-color: var(--c-accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--c-accent) 45%, transparent); }
      .sub-head .s-drag { color: rgba(255,255,255,0.75); cursor: grab; font-size: 1.05rem; }
      .sub-head .s-drag:active { cursor: grabbing; }
      .sub-head .sub-arrow { color: rgba(255,255,255,0.7); font-weight: 700; letter-spacing: -2px; }
      .sub-head .sub-name { font-family: var(--font-title); font-size: 1.05rem; letter-spacing: 0.03em; color: #fff; }
      .sub-head .cat-count { color: rgba(255,255,255,0.72); font-size: 0.78rem; margin-left: auto; }
      #list[data-mode="search"] .sub-head .s-drag { display: none; }

      .item {
        display: flex; align-items: center; gap: 0.9rem;
        background: var(--c-card); border: 1px solid var(--c-line);
        padding: 0.7rem 1rem; margin-bottom: 0.4rem;
        box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15)));
      }
      .item.is-hidden-item { opacity: 0.55; }
      .i-thumb {
        width: 44px; height: 44px; flex-shrink: 0; border-radius: 8px;
        object-fit: cover; border: 1px solid var(--c-line); display: block;
      }
      .i-thumb--ph {
        display: flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.04); color: var(--c-muted);
      }
      .ph-ico { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
      .i-main { flex: 1; min-width: 0; }
      .i-name { font-weight: 700; }
      .i-badges { display: inline-flex; gap: 0.3rem; margin-left: 0.5rem; vertical-align: middle; }
      .i-soldout { display: inline-flex; align-items: center; gap: 0.25rem; margin-left: 0.5rem; vertical-align: middle; font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #ff8a8f; border: 1px solid rgba(237,28,36,0.5); border-radius: 999px; padding: 0.1rem 0.5rem; }
      .i-badge { font-size: 0.82rem; line-height: 1; }
      .b-best { color: var(--c-accent); }
      .i-desc { color: var(--c-muted); font-size: 0.8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .i-alg {
        color: var(--c-muted); font-size: 0.72rem;
        flex: 0 0 9.5rem; text-align: left; white-space: normal; line-height: 1.4;
      }
      .i-price { font-family: var(--font-title); font-size: 1.15rem; letter-spacing: 0.03em; white-space: nowrap; margin-right: 1.25rem; }
      .i-promo { color: var(--c-accent); }
      .i-old { color: var(--c-muted); font-size: 0.85rem; margin-right: 0.35rem; }
      .i-col { display: inline-flex; flex-direction: column; align-items: flex-end; vertical-align: middle; min-width: 5.2rem; }
      .i-col + .i-col { margin-left: 1.5rem; }
      .i-full { color: var(--c-text); }
      .i-strike { text-decoration: line-through; text-decoration-thickness: 2px; opacity: 0.55; }
      .i-table-lab { font-size: 0.55rem; color: var(--c-muted); font-family: var(--font-body); text-transform: uppercase; letter-spacing: 0.06em; line-height: 1.4; }

      .sw-wrap { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }
      .i-switches { display: inline-flex; align-items: center; gap: 1.15rem; }
      .switch.sw-sold input:checked + .track { background: #c0453b; }
      .sw-lab { font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); }
      .switch { position: relative; width: 38px; height: 21px; flex-shrink: 0; }
      .switch input { opacity: 0; width: 0; height: 0; }
      .switch .track { position: absolute; inset: 0; cursor: pointer; border-radius: 999px; background: var(--c-line); transition: background 0.2s; }
      .switch .track::before {
        content: ""; position: absolute; width: 15px; height: 15px; border-radius: 50%;
        left: 3px; top: 3px; background: var(--c-muted); transition: transform 0.2s, background 0.2s;
      }
      .switch input:checked + .track { background: var(--c-accent); }
      .switch input:checked + .track::before { transform: translateX(17px); background: var(--c-bg); }

      .i-btn {
        width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
        background: transparent; border: 1px solid var(--c-line); color: var(--c-text);
        cursor: pointer; border-radius: 50%; font-size: 0.95rem;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
      }
      .i-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .i-btn:disabled { opacity: 0.3; cursor: not-allowed; }
      .i-del { background: rgba(237, 28, 36, 0.25); border-color: rgba(237, 28, 36, 0.35); color: #ffffff; }
      .i-del:hover { background: rgba(237, 28, 36, 0.55); border-color: #ed1c24; color: #ffffff; }
      .i-del .k-ico { width: 15px; height: 15px; }
      .i-del.confirm { background: #a3320f; border-color: #a3320f; color: #fff; width: auto; padding: 0 0.7rem; border-radius: 999px; font-size: 0.75rem; }
      .k-btn.is-active { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .k-btn.is-active:hover { color: var(--c-bg); border-color: var(--c-accent); }

      /* --- Modali --- */
      .overlay {
        position: fixed; inset: 0; z-index: 300; display: none;
        background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
        align-items: flex-start; justify-content: center; padding: 4vh 1rem; overflow-y: auto;
      }
      .overlay.is-open { display: flex; }
      .modal { width: 100%; max-width: 620px; background: var(--c-bg); border: 1px solid var(--c-line); padding: 1.75rem; position: relative; }
      .modal h2 { font-family: var(--font-title); font-size: 1.6rem; letter-spacing: 0.04em; margin-bottom: 1.25rem; }
      .m-close { position: absolute; top: 0.8rem; right: 1rem; background: none; border: none; color: var(--c-muted); font-size: 1.6rem; cursor: pointer; line-height: 1; }
      .m-close:hover { color: var(--c-text); }
      /* Modale "Gestisci le sezioni": più largo e centrato verticalmente */
      #sec-overlay .modal { max-width: 860px; margin: auto; }
      #overlay .modal-dish { margin: auto; }

      /* Modale piatto a 2 colonne + tab */
      .modal-dish { max-width: 940px; }
      .m-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.8rem; align-items: start; margin-bottom: 0.4rem; }
      @media (max-width: 780px) { .m-cols { grid-template-columns: 1fr; gap: 0.8rem; } }
      .m-tabs { display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
      .m-tab { background: var(--c-input); border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-body); font-weight: 700; font-size: 0.82rem; padding: 0.45rem 1rem; border-radius: 999px; cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s; }
      .m-tab:hover { color: var(--c-text); }
      .m-tab.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }

      .f-row { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
      .f-field { display: flex; flex-direction: column; gap: 0.3rem; flex: 1; min-width: 150px; }
      .f-label { font-size: 0.72rem; color: var(--c-muted); letter-spacing: 0.05em; text-transform: uppercase; }
      input[type="text"], input[type="number"], input[type="date"], select, textarea {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-size: 0.95rem; padding: 0.55rem 0.7rem; border-radius: 0;
        width: 100%; color-scheme: dark;
      }
      input:focus, select:focus, textarea:focus { outline: none; border-color: var(--c-accent); }
      textarea { resize: vertical; min-height: 56px; }

      .alg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.35rem; }
      .alg-item { display: flex; align-items: center; gap: 0.45rem; font-size: 0.85rem; cursor: pointer; padding: 0.25rem 0.3rem; }
      .alg-item input { accent-color: var(--c-accent); width: 16px; height: 16px; flex-shrink: 0; }
      .alg-num { color: var(--c-muted); font-size: 0.72rem; min-width: 1.2rem; }

      .f-img-row { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
      .f-img-prev {
        width: 64px; height: 64px; border-radius: 8px; overflow: hidden; flex-shrink: 0;
        border: 1px solid var(--c-line); background: rgba(255, 255, 255, 0.04);
        display: flex; align-items: center; justify-content: center; color: var(--c-muted);
      }
      .f-img-prev img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .f-img-btn { font-size: 0.95rem; padding: 0.45rem 1.2rem; }

      .m-toggles { display: flex; gap: 2rem; margin: 0.4rem 0 1.2rem; }
      .m-toggle { display: flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; }
      .m-toggle .switch { width: 44px; height: 24px; }
      .m-toggle .switch .track::before { width: 18px; height: 18px; }
      .m-toggle .switch input:checked + .track::before { transform: translateX(20px); }
      .m-badges { flex-wrap: wrap; gap: 1.1rem 1.6rem; margin-top: 0.2rem; }
      .m-sublabel { display: block; margin-bottom: 0.4rem; }
      .m-sep { border-top: 1px solid var(--c-line); margin: 0.7rem 0 0.9rem; }
      .m-states { flex-wrap: wrap; gap: 0.9rem 1.4rem; }

      .m-actions { display: flex; align-items: center; justify-content: flex-end; gap: 1rem; border-top: 1px solid var(--c-line); padding-top: 1.2rem; }
      .m-cancel { background: transparent; border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-body); font-size: 0.85rem; padding: 0.6rem 1.4rem; cursor: pointer; border-radius: 999px; }
      .m-cancel:hover { color: var(--c-text); border-color: var(--c-text); }
      .m-save {
        background: var(--c-accent); color: var(--c-bg); border: 1px solid var(--c-accent);
        font-family: var(--font-title); font-size: 1.1rem; letter-spacing: 0.05em;
        padding: 0.6rem 2rem; cursor: pointer; border-radius: 999px;
        transition: background 0.2s, color 0.2s;
      }
      .m-save:hover:not(:disabled) { background: transparent; color: var(--c-accent); }
      .m-save:disabled { opacity: 0.5; cursor: not-allowed; }
      .m-msg { color: #ff6b6b; font-size: 0.85rem; flex: 1; }

      /* --- Modale sezioni --- */
      .sec-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.45rem; }
      .sec-row { position: relative; }
      .sec-row .s-tree { color: var(--c-muted); font-size: 0.8rem; letter-spacing: -1px; flex-shrink: 0; opacity: 0.7; }
      .sec-row.is-sub { }
      .sec-sub-btn { color: var(--c-muted); }
      .sec-sub-btn:hover { color: var(--c-accent); }
      .sec-parent-pill { display: inline-flex; align-items: center; gap: 0.4rem; background: color-mix(in srgb, var(--c-accent) 16%, transparent); color: var(--c-accent); border-radius: 999px; padding: 0.25rem 0.7rem; font-size: 0.8rem; font-weight: 700; margin-right: 0.5rem; }
      .sec-parent-pill button { background: none; border: none; color: inherit; cursor: pointer; font-size: 1rem; line-height: 1; padding: 0; }
      .sec-row input[type="text"] { flex: 1; }
      .sec-count { color: var(--c-muted); font-size: 0.75rem; white-space: nowrap; min-width: 4.5rem; text-align: right; }
      .sec-kind { display: inline-flex; gap: 0.3rem; }
      .s-drag { cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none; font-size: 1.05rem; }
      .s-drag:active { cursor: grabbing; }
      .sec-row.dragging { opacity: 0.65; outline: 1px dashed var(--c-accent); background: var(--c-card); }
      .i-drag { cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none; font-size: 1.05rem; flex-shrink: 0; }
      .i-drag:active { cursor: grabbing; }
      #list[data-mode="search"] .i-drag { display: none; }
      .item.dragging { opacity: 0.65; outline: 1px dashed var(--c-accent); }
      .sec-add { display: flex; gap: 0.5rem; margin-top: 1rem; border-top: 1px solid var(--c-line); padding-top: 1rem; align-items: center; }
      .sec-add input { flex: 1; }
      .sec-addbtn {
        background: transparent; border: 1px solid var(--c-accent); color: var(--c-accent);
        font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.05em;
        padding: 0.45rem 1.4rem; cursor: pointer; border-radius: 999px;
      }
      .sec-addbtn:hover { background: var(--c-accent); color: var(--c-bg); }

      /* --- Lunch: card formule --- */
      .lu-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 0.9rem; align-items: start; }
      .lu-card {
        display: flex; flex-direction: column; gap: 0.85rem;
        background: var(--c-card); border: 1px solid var(--c-line);
        padding: 1.1rem 1.2rem;
        box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15)));
      }
      .lu-card.is-hidden-item { opacity: 0.55; }
      .lu-name { font-family: var(--font-title); font-size: 1.5rem; letter-spacing: 0.04em; color: var(--c-accent); }
      .lu-dates { color: var(--c-text); font-size: 0.95rem; font-weight: 700; margin-top: 0.2rem; }
      .lu-courses { display: flex; flex-direction: column; gap: 0.55rem; }
      .lu-course-tit { display: block; font-family: var(--font-title); font-size: 0.95rem; letter-spacing: 0.06em; color: var(--c-accent); margin-bottom: 0.1rem; }
      .lu-course-plats { color: var(--c-text); font-size: 0.95rem; font-weight: 700; line-height: 1.5; }
      .lu-combos { display: flex; flex-direction: column; gap: 0.15rem; }
      .lu-combo {
        display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem;
        font-size: 0.85rem; color: var(--c-muted);
        padding: 0.3rem 0; border-bottom: 1px dashed var(--c-line);
      }
      .lu-combo:last-child { border-bottom: none; }
      .lu-combo b { font-family: var(--font-title); font-size: 1.1rem; letter-spacing: 0.03em; color: var(--c-text); font-weight: 400; }
      .lu-actions { display: flex; align-items: center; gap: 0.6rem; border-top: 1px solid var(--c-line); padding-top: 0.85rem; margin-top: auto; }
      .lu-actions .sw-wrap { margin-right: auto; }

      /* --- Lunch: modale --- */
      .luf-courses { display: flex; gap: 0.45rem; flex-wrap: wrap; }
      .luf-course {
        display: inline-flex; align-items: center; gap: 0.4rem;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-title); font-size: 0.95rem; letter-spacing: 0.05em;
        padding: 0.45rem 1.1rem; border-radius: 999px; cursor: pointer;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .luf-course:hover { border-color: var(--c-accent); color: var(--c-text); }
      .luf-course.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .luf-course.is-lock { cursor: default; }
      .lu-block { border: 1px solid var(--c-line); padding: 0.8rem; margin-bottom: 0.9rem; }
      .lu-block-tit { font-family: var(--font-title); font-size: 1.05rem; letter-spacing: 0.05em; color: var(--c-accent); margin-bottom: 0.55rem; }
      .lu-chips { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.55rem; }
      .lu-chip {
        display: inline-flex; align-items: center; gap: 0.45rem;
        background: rgba(255, 255, 255, 0.04); border: 1px solid var(--c-line);
        border-radius: 999px; padding: 0.28rem 0.75rem; font-size: 0.82rem;
      }
      .lu-chip button { background: none; border: none; color: var(--c-muted); cursor: pointer; font-size: 1rem; line-height: 1; padding: 0; }
      .lu-chip button:hover { color: #ff8a8f; }
      .lu-combo-row { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.45rem; }
      .lu-combo-lab { flex: 1; font-size: 0.9rem; }
      .lu-combo-row input { width: 110px; text-align: right; }

      /* --- Datepicker custom (brand), come Réglages — z sopra l'overlay (300) --- */
      #lu-from, #lu-to { cursor: pointer; }

      /* Toast */
      .toast {
        position: fixed; top: 1rem; left: 50%; transform: translateX(-50%) translateY(-8px);
        z-index: 400; background: var(--c-card); border: 1px solid var(--c-line);
        padding: 0.7rem 1.3rem; font-size: 0.9rem; border-radius: 999px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, calc(0.5 * var(--sh, 0.15)));
        opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.25s;
      }
      .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
      .toast.err { border-color: #a3320f; color: #ff8a8f; }

      @media (max-width: 640px) {
        main { padding: 1.5rem 1rem 8rem; }
        .actionsbar .search { flex-basis: 100%; order: 3; margin-left: 0; }

        /* Card piatto riorganizzata su griglia:
           r1: handle · nome+descrizione · edit
           r2:          prezzo · allergeni
           r3: toggle Menu · toggle Cmd  ·  delete */
        .item {
          display: grid;
          grid-template-columns: auto auto 1fr auto;
          row-gap: 0.7rem;
          column-gap: 0.9rem;
          align-items: center;
        }
        .i-drag { grid-column: 1; grid-row: 1; align-self: start; }
        .i-thumb { grid-column: 2; grid-row: 1; width: 40px; height: 40px; align-self: start; }
        .i-main { grid-column: 3; grid-row: 1; }
        .i-desc { white-space: normal; margin-top: 0.2rem; }
        .i-edit { grid-column: 4; grid-row: 1; align-self: start; justify-self: end; }
        .i-price { grid-column: 2; grid-row: 2; justify-self: start; margin-right: 0; }
        .i-price .i-col { align-items: flex-start; min-width: 0; }
        .i-price .i-col + .i-col { margin-left: 1rem; }
        .i-alg { grid-column: 3 / 5; grid-row: 2; justify-self: start; }
        .i-switches { grid-column: 2 / 4; grid-row: 3; justify-self: start; gap: 1.15rem; }
        .i-del { grid-column: 4; grid-row: 3; justify-self: end; }
      }
      /* Loader dentro i bottoni di salvataggio */
      .is-loading { position: relative; color: transparent !important; pointer-events: none; }
      .is-loading::after {
        content: ""; position: absolute; inset: 0; margin: auto;
        width: 18px; height: 18px; border-radius: 50%;
        border: 2px solid color-mix(in srgb, var(--c-bg) 30%, transparent); border-top-color: var(--c-bg);
        animation: btnspin 0.7s linear infinite;
      }
      @keyframes btnspin { to { transform: rotate(360deg); } }
    </style>
    <AdminHead />
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <div class="topbar">
          <h1><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>{t("nav.menu")}</h1>
          <div class="t-stats" id="t-stats"></div>
        </div>
        <div class="k-filtri" id="k-filtri"></div>
        <div class="actionsbar">
          <div class="tabs" id="tabs"></div>
          <input type="text" class="search" id="search" placeholder={t("menu.searchPh")} />
        </div>
        <div class="state" id="state">{t("sup.loading")}</div>
        <div id="list"></div>
      </main>
      <AdminFooter />
    </div>

    <!-- Modale piatto -->
    <div class="overlay" id="overlay">
      <div class="modal modal-dish">
        <button class="m-close" id="m-close" aria-label={t("common.close")}>×</button>
        <h2 id="m-title">{t("menu.addDish")}</h2>
        <div class="m-cols">

          <!-- COLONNA SINISTRA: foto · categoria · titoli+prezzo · badge -->
          <div class="m-col">
            <div class="f-row">
              <div class="f-field">
                <span class="f-label">{t("menu.photoOpt")}</span>
                <div class="f-img-row">
                  <span class="f-img-prev" id="f-img-prev"></span>
                  <button type="button" class="pill sec-btn f-img-btn" id="f-img-up">{t("cli.uploadPhoto")}</button>
                  <button type="button" class="pill sec-btn f-img-btn" id="f-img-lib">{t("menu.library")}</button>
                  <button type="button" class="pill sec-btn f-img-btn" id="f-img-del" style="display: none">{t("ord.remove")}</button>
                  <input type="file" id="f-img-file" accept=".jpg,.jpeg,.png,.webp,.gif" style="display: none" />
                  <span class="f-label" id="f-img-state"></span>
                </div>
              </div>
            </div>
            <div class="f-row">
              <div class="f-field" style="flex: 2">
                <span class="f-label">{t("menu.sectionReq")}</span>
                <select id="f-cat"></select>
              </div>
            </div>
            <div class="f-row">
              <div class="f-field" style="flex: 2">
                <span class="f-label" id="f-name-lab">{t("menu.nameReq")}</span>
                <input type="text" id="f-name" maxlength="120" />
              </div>
              <div class="f-field">
                <span class="f-label">{t("menu.priceReq")}</span>
                <input type="number" id="f-price" min="0" step="0.01" inputmode="decimal" />
              </div>
            </div>
            <div id="f-names-extra"></div>
            <span class="f-label m-sublabel">{t("menu.badges")}</span>
            <div class="m-toggles m-badges">
              <label class="m-toggle">
                <span class="switch"><input type="checkbox" id="f-best" /><span class="track"></span></span>
                ★ {t("menu.bestseller")}
              </label>
              <label class="m-toggle">
                <span class="switch"><input type="checkbox" id="f-vegan" /><span class="track"></span></span>
                🌱 {t("menu.vegan")}
              </label>
              <label class="m-toggle">
                <span class="switch"><input type="checkbox" id="f-spicy" /><span class="track"></span></span>
                🌶️ {t("menu.spicy")}
              </label>
              <label class="m-toggle">
                <span class="switch"><input type="checkbox" id="f-suggestion" /><span class="track"></span></span>
                👨‍🍳 {t("menu.suggestion")}
              </label>
            </div>
            <div class="m-sep"></div>
            <div class="m-toggles m-states">
              <label class="m-toggle">
                <span class="switch"><input type="checkbox" id="f-av" checked /><span class="track"></span></span>
                {t("menu.visibleSite")}
              </label>
              <label class="m-toggle">
                <span class="switch"><input type="checkbox" id="f-or" checked /><span class="track"></span></span>
                {t("menu.orderable")}
              </label>
              <label class="m-toggle">
                <span class="switch"><input type="checkbox" id="f-soldout" /><span class="track"></span></span>
                {t("menu.soldOut")}
              </label>
            </div>
          </div>

          <!-- COLONNA DESTRA: tab descrizioni · allergeni · sconto -->
          <div class="m-col">
            <div class="m-tabs" id="m-tabs">
              <button type="button" class="m-tab is-on" data-tab="desc">{t("menu.tabDesc")}</button>
              <button type="button" class="m-tab" data-tab="alg">{t("menu.tabAllerg")}</button>
              <button type="button" class="m-tab" data-tab="disc">{t("menu.tabDisc")}</button>
            </div>
            <div class="m-pane" data-pane="desc">
              <div id="f-descs"></div>
            </div>
            <div class="m-pane" data-pane="alg" style="display: none">
              <div class="alg-grid" id="f-alg"></div>
            </div>
            <div class="m-pane" data-pane="disc" style="display: none">
              <div class="f-row">
                <div class="f-field">
                  <span class="f-label">{t("menu.discount")}</span>
                  <select id="f-dtype">
                    <option value="">{t("itg.mode.none")}</option>
                    <option value="fixed">{t("menu.discFixed")}</option>
                    <option value="percent">{t("menu.discPercent")}</option>
                  </select>
                </div>
              </div>
              <div class="f-row">
                <div class="f-field">
                  <span class="f-label">{t("menu.value")}</span>
                  <input type="number" id="f-dval" min="0" step="0.01" inputmode="decimal" disabled />
                </div>
                <div class="f-field">
                  <span class="f-label">{t("menu.application")}</span>
                  <select id="f-dscope" disabled>
                    <option value="all">{t("menu.everywhere")}</option>
                    <option value="online">{t("menu.onlineOnly")}</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

        </div>
        <div class="m-actions">
          <span class="m-msg" id="m-msg"></span>
          <button class="m-cancel" id="m-cancel">{t("common.cancel")}</button>
          <button class="m-save" id="m-save">{t("common.save")}</button>
        </div>
      </div>
    </div>

    <!-- Modale sezioni -->
    <div class="overlay" id="sec-overlay">
      <div class="modal">
        <button class="m-close" id="sec-close" aria-label={t("common.close")}>×</button>
        <h2>{t("menu.manageSections")}</h2>
        <p class="f-label" style="margin-bottom: 0.8rem">{t("menu.sectionsHint")}</p>
        <div id="sec-list"></div>
        <div class="sec-add">
          <span class="sec-kind" id="sec-kind"></span>
          <input type="text" id="sec-new" placeholder={t("menu.newSectionPh")} maxlength="60" />
          <button class="sec-addbtn" id="sec-addbtn">{t("common.add")}</button>
        </div>
        <span class="m-msg" id="sec-msg"></span>
      </div>
    </div>

    <!-- Modale lunch -->
    <div class="overlay" id="lu-overlay">
      <div class="modal">
        <button class="m-close" id="lu-close" aria-label={t("common.close")}>×</button>
        <h2 id="lu-title">{t("menu.addLunch")}</h2>
        <div class="f-row">
          <div class="f-field" style="flex: 2">
            <span class="f-label">{t("home.name")}</span>
            <input type="text" id="lu-name" maxlength="60" placeholder={t("tab.menu.lunch")} />
          </div>
        </div>
        <div class="f-row">
          <div class="f-field">
            <span class="f-label">{t("menu.composition")}</span>
            <div class="luf-courses" id="lu-courses"></div>
          </div>
        </div>
        <div class="f-row">
          <div class="f-field">
            <span class="f-label">{t("menu.dateFrom")}</span>
            <input type="text" id="lu-from" placeholder={t("menu.noLimit")} readonly />
          </div>
          <div class="f-field">
            <span class="f-label">{t("menu.dateTo")}</span>
            <input type="text" id="lu-to" placeholder={t("menu.noLimit")} readonly />
          </div>
        </div>
        <div id="lu-items"></div>
        <div class="lu-block">
          <div class="lu-block-tit">{t("menu.pricePerCombo")}</div>
          <p class="f-label" style="margin-bottom: 0.55rem">{t("menu.comboEmptyHint")}</p>
          <div id="lu-combos"></div>
        </div>
        <div class="m-toggles">
          <label class="m-toggle">
            <span class="switch"><input type="checkbox" id="lu-active" checked /><span class="track"></span></span>
            {t("menu.active")}
          </label>
        </div>
        <div class="m-actions">
          <span class="m-msg" id="lu-msg"></span>
          <button class="m-cancel" id="lu-cancel">{t("common.cancel")}</button>
          <button class="m-save" id="lu-save">{t("common.save")}</button>
        </div>
      </div>
    </div>

    <div class="toast" id="toast"></div>

    <ImagePicker />

    <!-- Bottoni flottanti (come Résa/Commandes/Clients) -->
    <div class="mn-float" id="mn-float">
      <button class="pill mn-fab mn-fab-sec" id="sec-btn" title={t("menu.manageSections")}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
        {t("menu.categories")}
      </button>
      <button class="pill mn-fab" id="add-btn" title={t("menu.addDish")}><span class="fab-plus">+</span>{t("menu.addDishShort")}</button>
    </div>

    <AdminNav current="menu" />

    <!-- Dati SSR (Fase 2): categorie + piatti pre-caricati dal server. -->
    <script id="ssr-menu" type="application/json" is:inline set:html={ssrMenuJson}></script>
    <script id="pub-langs" type="application/json" is:inline set:html={pubLangsJson}></script>

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { comprimiFoto } from "../../lib/admin/imageCompress";
      import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";

      const LANG = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(LANG);
      const LOC = ADMIN_LOCALE[LANG] ?? "fr-BE";

      type Item = {
        id: string; category: string; category_order: number; sort_order: number;
        name: string; description_fr: string | null; description_en: string | null;
        name_i18n?: Record<string, string> | null; desc_i18n?: Record<string, string> | null;
        allergens: number[]; price_cents: number; available: boolean; orderable: boolean;
        discount_type: "fixed" | "percent" | null; discount_value: number; discount_scope: "all" | "online";
        is_bestseller: boolean; is_vegan: boolean; is_spicy: boolean; is_suggestion: boolean; sold_out?: boolean;
        image_url: string | null;
      };
      type Cat = { id: string; name: string; sort_order: number; kind: "food" | "drink"; count: number; parent_id?: string | null; depth?: number; children?: number };

      const ALLERGENI: [number, string][] = [
        [1, tr("menu.algGluten")], [2, tr("menu.algLait")], [3, tr("menu.algArachides")], [4, tr("menu.algOeufs")],
        [5, tr("menu.algPoisson")], [6, tr("menu.algCrustaces")], [7, tr("menu.algSoja")], [8, tr("menu.algFruitsCoque")],
        [9, tr("menu.algCeleri")], [10, tr("menu.algMoutarde")], [11, tr("menu.algSulfites")], [12, tr("menu.algSesame")],
        [13, tr("menu.algLupin")], [14, tr("menu.algMollusques")],
      ];

      // Icone cibo (forchetta) e bevanda (bicchiere)
      const ICO_FOOD =
        '<svg class="k-ico k-ico-fill" viewBox="0 0 489.773 489.773" aria-hidden="true"><path d="M155.183,305.646c-2.081,0.175-4.157,0.265-6.238,0.265c-5.693,0-11.23-0.826-16.652-2.081L6.834,429.293c-6.158,6.149-6.158,16.137,0,22.287l32.47,32.478c6.158,6.15,16.135,6.15,22.276,0l150.785-150.757l-27.944-30.15L155.183,305.646z"/><path d="M485.345,104.649c-5.888-5.885-15.417-5.885-21.304,0l-81.303,81.301c-7.693,7.685-20.154,7.685-27.847,0c-7.659-7.679-7.659-20.13,0-27.807l80.901-80.884c6.112-6.118,6.112-16.036,0-22.168c-6.141-6.11-16.055-6.11-22.167,0l-80.868,80.876c-7.693,7.693-20.14,7.693-27.833,0c-7.677-7.676-7.677-20.136,0-27.806l81.286-81.293c5.904-5.894,5.904-15.441,0-21.343c-5.888-5.895-15.434-5.895-21.338,0l-91.458,91.463c-21.989,22.003-28.935,52.888-21.816,80.991l61.31,61.314c28.101,7.093,59.001,0.144,80.965-21.841l91.471-91.458C491.249,120.1,491.249,110.543,485.345,104.649z"/><path d="M41.093,13.791c-3.134-3.135-7.372-4.854-11.724-4.854c-0.926,0-1.857,0.079-2.766,0.231c-5.295,0.896-9.838,4.295-12.172,9.133c-26.79,55.373-15.594,121.631,27.894,165.121l77.801,77.791c7.676,7.685,18.055,11.939,28.819,11.939c1.151,0,2.305-0.048,3.456-0.143l45.171-3.855l196.971,212.489c3.058,3.303,7.342,5.221,11.855,5.31c0.093,0,0.19,0,0.288,0c4.412,0,8.636-1.743,11.771-4.855l33.734-33.741c3.117-3.11,4.859-7.331,4.859-11.73c0-4.398-1.742-8.622-4.846-11.732L41.093,13.791z"/></svg>';
      const ICO_DRINK =
        '<svg class="k-ico k-ico-fill" viewBox="0 0 512 512" aria-hidden="true"><path d="M438.925,169.204c-3.253-48.149-21.943-109.273-49.729-160.47C386.273,3.354,380.642,0,374.523,0H137.371c-6.12,0-11.75,3.354-14.674,8.734C96.79,56.469,78.792,112.855,73.819,159.304C61.745,272.036,142.207,357.641,239.25,366.527v112.081h-66.783c-9.217,0-16.696,7.473-16.696,16.696c0,9.223,7.479,16.696,16.696,16.696h166.956c9.217,0,16.696-7.473,16.696-16.696c0-9.223-7.479-16.696-16.696-16.696H272.53V366.553C367.133,358.044,446.157,276.148,438.925,169.204z M294.903,289.391c-9.22,0-16.696-7.475-16.696-16.696c0-9.22,7.475-16.696,16.696-16.696s16.696,7.475,16.696,16.696C311.599,281.916,304.124,289.391,294.903,289.391z M216.99,256c-9.22,0-16.696-7.475-16.696-16.696c0-9.22,7.475-16.696,16.696-16.696s16.696,7.475,16.696,16.696C233.686,248.525,226.211,256,216.99,256z M269.64,158.759c-20.171-7.144-42.739-7.154-64.184,1.371c-11.132,4.445-31.724,16.625-58.911,3.022c-12.041-6.021-25.183-9.1-38.385-9.454c5.412-37.404,19.692-81.765,39.299-120.307h216.978c20.585,40.464,35.26,87.307,39.991,125.802c-23.48-8.624-49.899-7.326-72.469,3.959C303.217,177.532,280.771,162.66,269.64,158.759z"/></svg>';

      const ICO_TRASH =
        '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /></svg>';
      const ICO_IMG =
        '<svg class="ph-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>';

      let items: Item[] = [];
      let cats: Cat[] = [];
      let attiva = ""; // nome sezione attiva
      type KindTab = "food" | "drink" | "lunch" | "menus";
      let kindFiltro: KindTab = "food"; // filtro tab: cibo, bevande, lunch, menus
      let editId: string | null = null;
      let nuovaKind: "food" | "drink" = "food";
      let nuovoParent: { id: string; name: string; depth: number } | null = null;
      const MAX_DEPTH_UI = 3;
      let headers: Record<string, string> = {};
      let tabVietati: string[] = []; // tab del Menu nascosti a questo utente (Réglages MOODD)

      function esc(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }
      function effettivo(it: Item): number {
        if (!it.discount_type || !it.discount_value) return it.price_cents;
        if (it.discount_type === "fixed") return Math.min(it.price_cents, it.discount_value);
        return Math.max(0, Math.round(it.price_cents * (1 - Math.min(it.discount_value, 100) / 100)));
      }
      function euro(cents: number): string {
        return (cents / 100).toLocaleString(LOC, { style: "currency", currency: "EUR" });
      }

      const toastEl = document.getElementById("toast") as HTMLDivElement;
      let toastTimer: number | undefined;
      function toast(msg: string, err = false) {
        toastEl.textContent = msg;
        toastEl.className = "toast show" + (err ? " err" : "");
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toastEl.classList.remove("show"), 2500);
      }

      // ---------- Rendering ----------
      const listEl = document.getElementById("list") as HTMLDivElement;
      const tabsEl = document.getElementById("tabs") as HTMLDivElement;
      const stateEl = document.getElementById("state") as HTMLDivElement;
      const searchEl = document.getElementById("search") as HTMLInputElement;

      function prezzoHTML(it: Item): string {
        const eff = effettivo(it);
        if (eff >= it.price_cents) return `<span class="i-price">${euro(it.price_cents)}</span>`;
        if (it.discount_scope === "online") {
          return `<span class="i-price i-promo">` +
            `<span class="i-col"><span class="i-full">${euro(it.price_cents)}</span><span class="i-table-lab">${tr("menu.atTable")}</span></span>` +
            `<span class="i-col"><span>${euro(eff)}</span><span class="i-table-lab">online</span></span>` +
            `</span>`;
        }
        return `<span class="i-price i-promo">` +
          `<span class="i-col"><span class="i-full i-strike">${euro(it.price_cents)}</span></span>` +
          `<span class="i-col"><span>${euro(eff)}</span></span>` +
          `</span>`;
      }
      function badgesHTML(it: Item): string {
        let b = "";
        if (it.is_bestseller) b += `<span class="i-badge b-best" title="${tr("menu.bestseller")}">★</span>`;
        if (it.is_vegan) b += `<span class="i-badge" title="${tr("menu.vegan")}">🌱</span>`;
        if (it.is_spicy) b += `<span class="i-badge" title="${tr("menu.spicy")}">🌶️</span>`;
        if (it.is_suggestion) b += `<span class="i-badge" title="${tr("menu.suggestion")}">👨‍🍳</span>`;
        return b ? `<span class="i-badges">${b}</span>` : "";
      }
      function itemHTML(it: Item, indent = 0): string {
        const desc = it.description_fr ? `<div class="i-desc">${esc(it.description_fr)}</div>` : "";
        // Colonna allergeni: sempre presente (anche vuota) così le righe restano allineate
        const alg = `<span class="i-alg">${it.allergens?.length ? `${tr("menu.algShort")} ${it.allergens.join(",")}` : ""}</span>`;
        const dim = !it.available ? " is-hidden-item" : "";
        const thumb = it.image_url
          ? `<img class="i-thumb" src="${esc(it.image_url)}" alt="" loading="lazy" />`
          : `<span class="i-thumb i-thumb--ph" title="${tr("menu.noPhoto")}">${ICO_IMG}</span>`;
        return `
          <div class="item${dim}" data-id="${it.id}" data-cat="${esc(it.category)}"${indent ? ` style="margin-left:${indent}rem"` : ""}>
            <span class="i-btn i-drag" title="${tr("menu.dragReorder")}">⠿</span>
            ${thumb}
            <div class="i-main"><span class="i-name">${esc(it.name)}${badgesHTML(it)}${it.sold_out ? `<span class="i-soldout">⛔ ${esc(tr("menu.soldOut"))}</span>` : ""}</span>${desc}</div>
            ${alg}
            ${prezzoHTML(it)}
            <span class="i-switches">
              <span class="sw-wrap"><label class="switch"><input type="checkbox" class="t-av" ${it.available ? "checked" : ""} /><span class="track"></span></label><span class="sw-lab">${tr("nav.menu")}</span></span>
              <span class="sw-wrap"><label class="switch"><input type="checkbox" class="t-or" ${it.orderable ? "checked" : ""} /><span class="track"></span></label><span class="sw-lab">${tr("menu.cmdShort")}</span></span>
              <span class="sw-wrap"><label class="switch sw-sold"><input type="checkbox" class="t-soldout" ${it.sold_out ? "checked" : ""} /><span class="track"></span></label><span class="sw-lab">${tr("menu.soldShort")}</span></span>
            </span>
            <button class="i-btn i-edit" title="${tr("common.edit")}">✎</button>
            <button class="i-btn i-del" title="${tr("common.delete")}">${ICO_TRASH}</button>
          </div>`;
      }

      function posizionaMenuFabs() {
        const barra = document.querySelector(".admin-nav") as HTMLElement | null;
        const box = document.getElementById("mn-float") as HTMLElement | null;
        if (!barra || !box) return;
        if (!window.matchMedia("(min-width: 521px)").matches) {
          box.style.bottom = "";
          box.querySelectorAll<HTMLElement>(".mn-fab").forEach((b) => (b.style.height = ""));
          return;
        }
        const r = barra.getBoundingClientRect();
        box.style.bottom = `${window.innerHeight - r.bottom}px`;
        box.querySelectorAll<HTMLElement>(".mn-fab").forEach((b) => (b.style.height = `${r.height}px`));
      }
      window.addEventListener("resize", posizionaMenuFabs);
      window.addEventListener("DOMContentLoaded", posizionaMenuFabs);
      posizionaMenuFabs();

      function renderStatsTitolo() {
        const nCibo = cats.filter((c) => c.kind === "food").reduce((t, c) => t + c.count, 0);
        const nBev = cats.filter((c) => c.kind === "drink").reduce((t, c) => t + c.count, 0);
        (document.getElementById("t-stats") as HTMLDivElement).innerHTML =
          `<span class="t-pill gold"><b>${nCibo}</b> ${nCibo > 1 ? tr("home.dishesWord") : tr("home.dishWord")}</span>` +
          `<span class="t-pill"><b>${nBev}</b> ${nBev > 1 ? tr("home.drinks") : tr("menu.drinkWord")}</span>`;
      }
      function renderTabs() {
        renderStatsTitolo();
        aggiornaFabs();
        // Se la sezione attiva è dell'altro tipo, segui il suo tipo
        const catAttiva = cats.find((c) => c.name === attiva);
        if (catAttiva && catAttiva.kind !== kindFiltro) kindFiltro = catAttiva.kind;

        const visibili = cats.filter((c) => c.kind === kindFiltro && (c.depth ?? 0) === 0);
        (document.getElementById("k-filtri") as HTMLDivElement).innerHTML =
          `<button class="kf-pill${kindFiltro === "food" ? " is-on" : ""}" data-kind="food">${ICO_FOOD}${tr("tab.menu.food")}</button>` +
          `<button class="kf-pill${kindFiltro === "drink" ? " is-on" : ""}" data-kind="drink">${ICO_DRINK}${tr("tab.menu.drink")}</button>` +
          `<button class="kf-pill${kindFiltro === "lunch" ? " is-on" : ""}" data-kind="lunch"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" /></svg>${tr("tab.menu.lunch")}</button>` +
          `<button class="kf-pill${kindFiltro === "menus" ? " is-on" : ""}" data-kind="menus"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>${tr("tab.menu.menus")}</button>`;
        // Tab vietati dal super: la pillola sparisce anche a ogni re-render
        for (const tv of tabVietati) {
          (document.getElementById("k-filtri") as HTMLDivElement).querySelector(`.kf-pill[data-kind="${tv}"]`)?.remove();
        }
        tabsEl.innerHTML =
          visibili
            .map((c) => {
              const d = c.depth ?? 0;
              const sub = d > 0 ? " is-sub" : "";
              const arrow = d > 0 ? `<span class="tab-arrow">${"\u21B3".repeat(d)}</span>` : "";
              return `<button class="tab${c.name === attiva ? " is-active" : ""}${sub}" data-cat="${esc(c.name)}" data-depth="${d}">${arrow}${esc(c.name)}<span class="n">${c.count}</span></button>`;
            })
            .join("");
      }

      // Categoria radice (top-level) di una sezione: risale i parent.
      function radiceDi(nome: string): string {
        let c = cats.find((x) => x.name === nome);
        let guard = 0;
        while (c && c.parent_id && guard < 10) {
          const p = cats.find((x) => x.id === c!.parent_id);
          if (!p) break;
          c = p;
          guard++;
        }
        return c?.name ?? nome;
      }
      function renderList() {
        const filtro = searchEl.value.trim().toLowerCase();
        listEl.dataset.mode = filtro ? "search" : "cat";
        if (kindFiltro === "lunch") {
          renderLunchList(filtro);
          return;
        }
        // Tab in costruzione: per ora vuoto
        if (!filtro && kindFiltro === "menus") {
          listEl.innerHTML = `<p class="state">${tr("menu.menusSoon")}</p>`;
          return;
        }
        if (filtro) {
          // Ricerca globale: risultati raggruppati per sezione
          const gruppi = new Map<string, Item[]>();
          for (const it of items) {
            if (!it.name.toLowerCase().includes(filtro)) continue;
            if (tabVietati.includes(cats.find((c) => c.name === it.category)?.kind ?? "")) continue;
            if (!gruppi.has(it.category)) gruppi.set(it.category, []);
            gruppi.get(it.category)!.push(it);
          }
          if (gruppi.size === 0) {
            listEl.innerHTML = `<p class="state">${tr("menu.noDishFound")}</p>`;
            return;
          }
          const ordinati = [...gruppi.entries()].sort(
            (a, b) => (cats.find((c) => c.name === a[0])?.sort_order ?? 0) - (cats.find((c) => c.name === b[0])?.sort_order ?? 0)
          );
          listEl.innerHTML = ordinati
            .map(
              ([nome, arr]) => `
            <div class="cat-head"><span class="cat-name">${esc(nome)}</span><span class="cat-count">${arr.length}</span></div>
            ${arr.map((i) => itemHTML(i)).join("")}`
            )
            .join("");
          return;
        }
        // Vista normale: la sezione attiva + le sue SOTTO-CATEGORIE (albero),
        // con i piatti raggruppati sotto ciascuna. Ordinabili dentro e tra i gruppi.
        const activeCat = cats.find((c) => c.name === attiva);
        if (!activeCat) { listEl.innerHTML = `<p class="state">${tr("menu.sectionEmpty")}</p>`; return; }
        const figliDi = (id: string) => cats.filter((c) => c.parent_id === id).sort((a, b) => a.sort_order - b.sort_order);
        const sottoAlbero: Cat[] = [];
        const visita = (c: Cat) => { sottoAlbero.push(c); for (const f of figliDi(c.id)) visita(f); };
        visita(activeCat);
        const dishesDi = (nome: string) =>
          items.filter((i) => i.category === nome).sort((a, b) => a.sort_order - b.sort_order);
        let html = "";
        for (const c of sottoAlbero) {
          const arr = dishesDi(c.name);
          if (c.id === activeCat.id) {
            html += arr.map((i) => itemHTML(i)).join("");
          } else {
            const rel = (c.depth ?? 0) - (activeCat.depth ?? 0); // 1..3
            html += `<div class="sub-head" data-cat="${esc(c.name)}" data-id="${c.id}" data-parent="${c.parent_id ?? ""}" data-depth="${c.depth ?? 0}" style="margin-left:${(rel - 1) * 1.3}rem"><span class="i-btn s-drag" title="${tr("menu.dragReorder")}">\u283F</span><span class="sub-name">${esc(c.name)}</span><span class="cat-count">${arr.length}</span></div>`;
            html += arr.map((i) => itemHTML(i, rel * 1.3)).join("");
          }
        }
        if (!html) html = `<p class="state">${tr("menu.sectionEmpty")}</p>`;
        listEl.innerHTML = html;
      }

      // Ordina le sezioni in profondità (depth-first) rispettando sort_order:
      // robusto sia con i dati SSR (ordine piatto) sia con l'API (già ad albero).
      function ordinaAlbero(arr: Cat[]): Cat[] {
        const figli = new Map<string, Cat[]>();
        for (const c of arr) {
          const k = c.parent_id ?? "";
          if (!figli.has(k)) figli.set(k, []);
          figli.get(k)!.push(c);
        }
        for (const v of figli.values()) v.sort((a, b) => a.sort_order - b.sort_order || a.name.localeCompare(b.name));
        const out: Cat[] = [];
        const visita = (pid: string) => { for (const c of figli.get(pid) ?? []) { out.push(c); visita(c.id); } };
        visita("");
        // eventuali orfani (parent non presente): appendili in coda
        if (out.length < arr.length) for (const c of arr) if (!out.includes(c)) out.push(c);
        return out;
      }
      async function caricaTutto(datiIniziali?: { categories: Cat[]; items: Item[] }) {
        if (datiIniziali) {
          // Dati già pronti dal server (SSR): niente fetch.
          cats = ordinaAlbero(datiIniziali.categories ?? []);
          items = datiIniziali.items ?? [];
        } else {
          const [rc, ri] = await Promise.all([
            fetch("/api/admin/categories", { headers }),
            fetch("/api/admin/menu", { headers }),
          ]);
          if (!rc.ok || !ri.ok) {
            stateEl.textContent = tr("sup.load.error");
            return false;
          }
          cats = ordinaAlbero(((await rc.json()).categories as Cat[]) ?? []);
          items = ((await ri.json()).items as Item[]) ?? [];
        }
        if (!attiva || !cats.some((c) => c.name === attiva)) {
          attiva = cats.find((c) => c.kind === kindFiltro && (c.depth ?? 0) === 0)?.name ?? cats.find((c) => (c.depth ?? 0) === 0)?.name ?? "";
        }
        stateEl.style.display = "none";
        renderTabs();
        renderList();
        renderSezioni();
        return true;
      }

      // ---------- Modale piatto ----------
      const overlay = document.getElementById("overlay") as HTMLDivElement;
      const mTitle = document.getElementById("m-title") as HTMLHeadingElement;
      const mMsg = document.getElementById("m-msg") as HTMLSpanElement;
      const fName = document.getElementById("f-name") as HTMLInputElement;
      const fPrice = document.getElementById("f-price") as HTMLInputElement;
      const fCat = document.getElementById("f-cat") as HTMLSelectElement;
      const fNameLab = document.getElementById("f-name-lab") as HTMLSpanElement;
      const fNamesExtra = document.getElementById("f-names-extra") as HTMLDivElement;
      const fDescs = document.getElementById("f-descs") as HTMLDivElement;

      // Lingue del sito pubblico (per i campi traduzione). Fallback: fr.
      type PubLangs = { langs: string[]; def: string; labels: Record<string, { label: string; flag: string }> };
      let PUB: PubLangs = { langs: ["fr"], def: "fr", labels: { fr: { label: "Français", flag: "\uD83C\uDDEB\uD83C\uDDF7" } } };
      try {
        const raw = document.getElementById("pub-langs")?.textContent?.trim();
        if (raw) PUB = JSON.parse(raw) as PubLangs;
      } catch { /* fallback */ }
      const langTag = (code: string) => `${PUB.labels[code]?.flag ?? ""} ${code.toUpperCase()}`.trim();
      // Costruisce (una volta) i campi nome-extra e le descrizioni per lingua.
      function costruisciCampiLingua() {
        fNameLab.textContent = `${tr("menu.nameReq")} (${langTag(PUB.def)})`;
        const extra = PUB.langs.filter((l) => l !== PUB.def);
        fNamesExtra.innerHTML = extra
          .map(
            (l) =>
              `<div class="f-row"><div class="f-field"><span class="f-label">${esc(tr("menu.nameCol"))} (${esc(langTag(l))})</span><input type="text" class="f-nx" data-lang="${l}" maxlength="120" /></div></div>`
          )
          .join("");
        fDescs.innerHTML = PUB.langs
          .map(
            (l) =>
              `<div class="f-row"><div class="f-field"><span class="f-label">${esc(tr("menu.descCol"))} (${esc(langTag(l))})</span><textarea class="f-dx" data-lang="${l}" maxlength="500"></textarea></div></div>`
          )
          .join("");
      }
      costruisciCampiLingua();
      // ---- Tab del modale (Descrizioni / Allergeni / Sconto) ----
      const mTabs = document.getElementById("m-tabs") as HTMLDivElement;
      function mostraTab(tab: string) {
        mTabs.querySelectorAll<HTMLElement>(".m-tab").forEach((x) => x.classList.toggle("is-on", x.dataset.tab === tab));
        document.querySelectorAll<HTMLElement>(".modal-dish .m-pane").forEach((pane) => {
          pane.style.display = pane.dataset.pane === tab ? "" : "none";
        });
      }
      mTabs.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>(".m-tab");
        if (b?.dataset.tab) mostraTab(b.dataset.tab);
      });
      const fAlg = document.getElementById("f-alg") as HTMLDivElement;
      const fDtype = document.getElementById("f-dtype") as HTMLSelectElement;
      const fDval = document.getElementById("f-dval") as HTMLInputElement;
      const fDscope = document.getElementById("f-dscope") as HTMLSelectElement;
      const fAv = document.getElementById("f-av") as HTMLInputElement;
      const fOr = document.getElementById("f-or") as HTMLInputElement;
      const fBest = document.getElementById("f-best") as HTMLInputElement;
      const fVegan = document.getElementById("f-vegan") as HTMLInputElement;
      const fSpicy = document.getElementById("f-spicy") as HTMLInputElement;
      const fSuggestion = document.getElementById("f-suggestion") as HTMLInputElement;
      const fSoldout = document.getElementById("f-soldout") as HTMLInputElement;
      const mSave = document.getElementById("m-save") as HTMLButtonElement;
      const fImgPrev = document.getElementById("f-img-prev") as HTMLSpanElement;
      const fImgUp = document.getElementById("f-img-up") as HTMLButtonElement;
      const fImgDel = document.getElementById("f-img-del") as HTMLButtonElement;
      const fImgFile = document.getElementById("f-img-file") as HTMLInputElement;
      const fImgState = document.getElementById("f-img-state") as HTMLSpanElement;
      let imgUrl: string | null = null;

      function renderFotoPrev() {
        fImgPrev.innerHTML = imgUrl ? `<img src="${esc(imgUrl)}" alt="" />` : ICO_IMG;
        fImgDel.style.display = imgUrl ? "" : "none";
      }
      fImgUp.addEventListener("click", () => fImgFile.click());
      fImgDel.addEventListener("click", () => { imgUrl = null; renderFotoPrev(); });
      (document.getElementById("f-img-lib") as HTMLButtonElement).addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("imgpick:open"));
      });
      window.addEventListener("imgpick:pick", (e) => {
        if (!overlay.classList.contains("is-open")) return; // modale piatto chiuso
        imgUrl = (e as CustomEvent<{ url: string }>).detail.url;
        renderFotoPrev();
        fImgState.textContent = "";
      });
      fImgFile.addEventListener("change", async () => {
        const file = fImgFile.files?.[0];
        if (!file) return;
        fImgState.textContent = tr("menu.compressing");
        fImgUp.disabled = true;
        try {
          const foto = await comprimiFoto(file);
          if (foto.size > 4 * 1024 * 1024) throw new Error(tr("menu.photoTooBig"));
          fImgState.textContent = tr("cli.uploading");
          const b64 = await new Promise<string>((resolve, reject) => {
            const r = new FileReader();
            r.onload = () => resolve(String(r.result).split(",")[1] ?? "");
            r.onerror = () => reject(new Error(tr("menu.fileUnreadable")));
            r.readAsDataURL(foto);
          });
          const res = await fetch("/api/admin/upload", {
            method: "POST",
            headers: { ...headers, "Content-Type": "application/json" },
            body: JSON.stringify({ filename: foto.name, data: b64, bucket: "menu" }),
          });
          const j = await res.json();
          if (!res.ok) throw new Error(j.error ?? tr("menu.uploadFailed"));
          imgUrl = j.url as string;
          renderFotoPrev();
          fImgState.textContent = "";
        } catch (err) {
          fImgState.textContent = err instanceof Error ? err.message : tr("menu.uploadFailedDot");
        } finally {
          fImgUp.disabled = false;
          fImgFile.value = "";
        }
      });

      fAlg.innerHTML = ALLERGENI.map(
        ([n, lab]) => `<label class="alg-item"><input type="checkbox" value="${n}" /><span class="alg-num">${n}</span>${lab}</label>`
      ).join("");

      function maxSort(cat: string): number {
        return items.filter((i) => i.category === cat).reduce((mx, i) => Math.max(mx, i.sort_order), 0);
      }

      function apriModale(it: Item | null) {
        editId = it?.id ?? null;
        mostraTab("desc");
        mTitle.textContent = it ? tr("menu.editDish") : tr("menu.addDish");
        mMsg.textContent = "";
        {
          const catById = new Map(cats.map((c) => [c.id, c] as const));
          const pathOf = (c: Cat): string[] => {
            const names: string[] = [];
            let cur: Cat | undefined = c;
            const seen = new Set<string>();
            while (cur && !seen.has(cur.id)) { seen.add(cur.id); names.unshift(cur.name); cur = cur.parent_id ? catById.get(cur.parent_id) : undefined; }
            return names;
          };
          fCat.innerHTML = cats
            .map((c) => {
              const d = c.depth ?? 0;
              const pre = d > 0 ? "\u00A0\u00A0".repeat(d) : "";
              const label = pathOf(c).join(" \u203A ");
              return `<option value="${esc(c.name)}">${pre}${esc(label)}</option>`;
            })
            .join("");
        }
        fName.value = it?.name ?? "";
        fPrice.value = it ? (it.price_cents / 100).toFixed(2) : "";
        fCat.value = it?.category ?? attiva;
        // Nomi tradotti (lingue extra) + descrizioni per lingua pubblica
        const nI18n = it?.name_i18n ?? {};
        fNamesExtra.querySelectorAll<HTMLInputElement>(".f-nx").forEach((inp) => {
          inp.value = nI18n[inp.dataset.lang ?? ""] ?? "";
        });
        const dI18n = it?.desc_i18n ?? {};
        fDescs.querySelectorAll<HTMLTextAreaElement>(".f-dx").forEach((ta) => {
          const l = ta.dataset.lang ?? "";
          ta.value =
            dI18n[l] ??
            (l === "fr" ? it?.description_fr ?? "" : l === "en" ? it?.description_en ?? "" : "");
        });
        fDtype.value = it?.discount_type ?? "";
        fDscope.value = it?.discount_scope ?? "all";
        if (it?.discount_type === "fixed") fDval.value = (it.discount_value / 100).toFixed(2);
        else if (it?.discount_type === "percent") fDval.value = String(it.discount_value);
        else fDval.value = "";
        aggiornaCampiSconto();
        fAv.checked = it?.available ?? true;
        fOr.checked = it?.orderable ?? true;
        fBest.checked = it?.is_bestseller ?? false;
        fVegan.checked = it?.is_vegan ?? false;
        fSpicy.checked = it?.is_spicy ?? false;
        fSuggestion.checked = it?.is_suggestion ?? false;
        fSoldout.checked = it?.sold_out ?? false;
        imgUrl = it?.image_url ?? null;
        fImgState.textContent = "";
        renderFotoPrev();
        fAlg.querySelectorAll<HTMLInputElement>("input").forEach((cb) => {
          cb.checked = !!it?.allergens?.includes(Number(cb.value));
        });
        overlay.classList.add("is-open");
        fName.focus();
      }
      function chiudiModale() {
        overlay.classList.remove("is-open");
        editId = null;
      }

      function aggiornaCampiSconto() {
        const t = fDtype.value;
        fDval.disabled = !t;
        fDscope.disabled = !t;
        if (t === "percent") { fDval.step = "1"; fDval.max = "99"; fDval.placeholder = "10"; }
        else { fDval.step = "0.01"; fDval.removeAttribute("max"); fDval.placeholder = "12,00"; }
      }
      fDtype.addEventListener("change", aggiornaCampiSconto);

      async function salvaModale() {
        mMsg.textContent = "";
        if (!fName.value.trim()) { mMsg.textContent = tr("menu.nameRequired"); return; }
        if (!fCat.value) { mMsg.textContent = tr("menu.sectionRequired"); return; }
        const prezzo = Math.round(parseFloat(fPrice.value.replace(",", ".")) * 100);
        if (!Number.isFinite(prezzo) || prezzo < 0) { mMsg.textContent = tr("menu.priceInvalid"); return; }

        const orig = editId ? items.find((x) => x.id === editId) : null;
        const body: Record<string, unknown> = {
          name: fName.value.trim(),
          category: fCat.value,
          price_cents: prezzo,
          name_i18n: (() => {
            const o: Record<string, string> = { [PUB.def]: fName.value.trim() };
            fNamesExtra.querySelectorAll<HTMLInputElement>(".f-nx").forEach((inp) => {
              const v = inp.value.trim();
              if (v) o[inp.dataset.lang ?? ""] = v;
            });
            return o;
          })(),
          desc_i18n: (() => {
            const o: Record<string, string> = {};
            fDescs.querySelectorAll<HTMLTextAreaElement>(".f-dx").forEach((ta) => {
              const v = ta.value.trim();
              if (v) o[ta.dataset.lang ?? ""] = v;
            });
            return o;
          })(),
          allergens: [...fAlg.querySelectorAll<HTMLInputElement>("input:checked")].map((cb) => Number(cb.value)),
          available: fAv.checked,
          orderable: fOr.checked,
          is_bestseller: fBest.checked,
          is_vegan: fVegan.checked,
          is_spicy: fSpicy.checked,
          is_suggestion: fSuggestion.checked,
          sold_out: fSoldout.checked,
          image_url: imgUrl,
          discount_type: fDtype.value || null,
          discount_value: fDtype.value === "fixed"
            ? Math.round(parseFloat(fDval.value.replace(",", ".") || "0") * 100)
            : Math.round(Number(fDval.value || 0)),
          discount_scope: (fDscope.value as "all" | "online") || "all",
        };
        if (fDtype.value && !(Number(body.discount_value) > 0)) {
          mMsg.textContent = tr("menu.discValueRequired");
          return;
        }
        if (editId) body.id = editId;
        // Posizione automatica: nuovo piatto (o piatto spostato di sezione) in coda
        if (!editId || (orig && orig.category !== fCat.value)) {
          body.sort_order = maxSort(fCat.value) + 1;
        }

        mSave.disabled = true;
        mSave.classList.add("is-loading");
        try {
          const res = await fetch("/api/admin/menu", {
            method: editId ? "PUT" : "POST",
            headers: { ...headers, "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
          const j = await res.json();
          if (!res.ok) {
            mMsg.textContent = j.error ?? tr("res.saveError");
          } else {
            attiva = radiceDi(fCat.value);
            chiudiModale();
            toast(editId ? tr("menu.dishModified") : tr("menu.dishAdded"));
            await caricaTutto();
          }
        } catch {
          mMsg.textContent = tr("common.netErr");
        } finally {
          mSave.disabled = false;
          mSave.classList.remove("is-loading");
        }
      }

      // ---------- Modale sezioni ----------
      const secOverlay = document.getElementById("sec-overlay") as HTMLDivElement;
      const secList = document.getElementById("sec-list") as HTMLDivElement;
      const secNew = document.getElementById("sec-new") as HTMLInputElement;
      const secMsg = document.getElementById("sec-msg") as HTMLSpanElement;
      const secKind = document.getElementById("sec-kind") as HTMLSpanElement;

      function renderSezioni() {
        secList.innerHTML = cats
          .map((c) => {
            const depth = c.depth ?? 0;
            const tree = depth > 0 ? `<span class="s-tree">${"—".repeat(depth)}</span>` : "";
            const bloccaDel = (c.count > 0 || (c.children ?? 0) > 0);
            const puoSub = depth < MAX_DEPTH_UI;
            const puoOut = depth > 0;
            return `
          <div class="sec-row${depth > 0 ? " is-sub" : ""}" data-id="${c.id}" data-name="${esc(c.name)}" data-parent="${c.parent_id ?? ""}" data-depth="${depth}" style="padding-left:${depth * 1.4}rem">
            <span class="i-btn s-drag" title="${tr("menu.dragReorder")}">⠿</span>
            ${tree}
            <button class="i-btn k-btn s-kfood${c.kind === "food" ? " is-active" : ""}" title="${tr("menu.foodKind")}">${ICO_FOOD}</button>
            <button class="i-btn k-btn s-kdrink${c.kind === "drink" ? " is-active" : ""}" title="${tr("menu.drinkKind")}">${ICO_DRINK}</button>
            <input type="text" class="s-name" value="${esc(c.name)}" maxlength="60" />
            <button class="i-btn s-out" ${puoOut ? "" : "disabled"} title="${tr("menu.outdentTitle")}">⇤</button>
            <button class="i-btn s-in" title="${tr("menu.indentTitle")}">⇥</button>
            <button class="i-btn sec-sub-btn s-sub" ${puoSub ? "" : "disabled"} title="${tr("menu.addSubTitle")}">＋</button>
            <span class="sec-count">${c.count} ${c.count > 1 ? tr("home.dishesWord") : tr("home.dishWord")}</span>
            <button class="i-btn i-del s-del" ${bloccaDel ? "disabled" : ""} title="${tr("menu.deleteIfEmpty")}">${ICO_TRASH}</button>
          </div>`;
          })
          .join("");
        renderNuovaKind();
      }
      // Form "aggiungi": mostra il parent selezionato (sotto-sezione) o normale.
      function renderNuovaKind() {
        const parentPill = nuovoParent
          ? `<span class="sec-parent-pill">${esc(tr("menu.subOf"))} ${esc(nuovoParent.name)}<button type="button" id="snk-clear" title="${esc(tr("menu.clearParent"))}">×</button></span>`
          : "";
        secKind.innerHTML =
          parentPill +
          `<button class="i-btn k-btn${nuovaKind === "food" ? " is-active" : ""}" id="snk-food" title="${tr("menu.foodKind")}">${ICO_FOOD}</button>` +
          `<button class="i-btn k-btn${nuovaKind === "drink" ? " is-active" : ""}" id="snk-drink" title="${tr("menu.drinkKind")}">${ICO_DRINK}</button>`;
        secNew.placeholder = nuovoParent ? tr("menu.newSubPh") : tr("menu.newSectionPh");
      }

      secKind.addEventListener("click", (e) => {
        const t = (e.target as HTMLElement).closest("button");
        if (!t) return;
        if (t.id === "snk-clear") { nuovoParent = null; renderNuovaKind(); secNew.focus(); return; }
        nuovaKind = t.id === "snk-drink" ? "drink" : "food";
        renderNuovaKind();
      });

      async function putCategoria(id: string, campi: Record<string, unknown>): Promise<boolean> {
        const res = await fetch("/api/admin/categories", {
          method: "PUT",
          headers: { ...headers, "Content-Type": "application/json" },
          body: JSON.stringify({ id, ...campi }),
        });
        if (!res.ok) {
          const j = await res.json();
          secMsg.textContent = j.error ?? tr("menu.errorDot");
          return false;
        }
        return true;
      }

      secList.addEventListener("click", async (e) => {
        secMsg.textContent = "";
        const t = e.target as HTMLElement;
        const row = t.closest(".sec-row") as HTMLElement | null;
        if (!row) return;
        const id = row.dataset.id!;
        const idx = cats.findIndex((c) => c.id === id);

        if (t.closest(".s-kfood") || t.closest(".s-kdrink")) {
          const kind = t.closest(".s-kdrink") ? "drink" : "food";
          if (cats[idx].kind !== kind && (await putCategoria(id, { kind }))) {
            await caricaTutto();
          }
          return;
        }
        if (t.closest(".s-del")) {
          const res = await fetch("/api/admin/categories?id=" + id, { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } });
          if (!res.ok) {
            const j = await res.json();
            secMsg.textContent = j.error ?? tr("home.deleteFailed");
          } else {
            toast(tr("menu.sectionDeleted"));
            await caricaTutto();
          }
          return;
        }
        // "+ sotto": prepara il form per creare una sotto-sezione sotto questa
        if (t.closest(".s-sub")) {
          const c = cats[idx];
          nuovoParent = { id: c.id, name: c.name, depth: c.depth ?? 0 };
          renderNuovaKind();
          secNew.focus();
          return;
        }
        // Rientra (indent): mette la sezione sotto la sorella precedente
        if (t.closest(".s-in")) {
          const c = cats[idx];
          const cd = c.depth ?? 0;
          let sorella: Cat | null = null;
          for (let k = idx - 1; k >= 0; k--) {
            const dk = cats[k].depth ?? 0;
            if (dk < cd) break;            // risalito oltre: nessuna sorella
            if (dk === cd) { sorella = cats[k]; break; }
          }
          if (!sorella) { secMsg.textContent = tr("menu.indentTitle"); return; }
          if (await putCategoria(id, { parent_id: sorella.id })) await caricaTutto();
          return;
        }
        // Esci (outdent): risale di un livello (parent = nonno)
        if (t.closest(".s-out")) {
          const c = cats[idx];
          const parent = cats.find((x) => x.id === c.parent_id);
          const nonno = parent ? (parent.parent_id ?? null) : null;
          if (await putCategoria(id, { parent_id: nonno })) await caricaTutto();
          return;
        }
      });

      // Rinomina: Enter o perdita di focus
      secList.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && (e.target as HTMLElement).classList.contains("s-name")) {
          (e.target as HTMLInputElement).blur();
        }
      });
      secList.addEventListener("focusout", async (e) => {
        const t = e.target as HTMLInputElement;
        if (!t.classList.contains("s-name")) return;
        const row = t.closest(".sec-row") as HTMLElement;
        const vecchio = row.dataset.name!;
        const nuovo = t.value.trim();
        if (!nuovo || nuovo === vecchio) { t.value = vecchio; return; }
        secMsg.textContent = "";
        if (await putCategoria(row.dataset.id!, { name: nuovo })) {
          if (attiva === vecchio) attiva = nuovo;
          toast(tr("menu.sectionRenamed"));
          await caricaTutto();
        } else {
          t.value = vecchio;
        }
      });

      // Drag & drop per riordinare le sezioni (mouse + dito)
      let dragRow: HTMLElement | null = null;
      let dragBlock: HTMLElement[] = []; // il nodo + il suo sotto-albero (righe contigue)
      secList.addEventListener("pointerdown", (e) => {
        const handle = (e.target as HTMLElement).closest(".s-drag");
        if (!handle) return;
        e.preventDefault();
        dragRow = handle.closest(".sec-row") as HTMLElement;
        const d0 = Number(dragRow.dataset.depth ?? "0");
        const all = [...secList.querySelectorAll<HTMLElement>(".sec-row")];
        const start = all.indexOf(dragRow);
        dragBlock = [dragRow];
        for (let k = start + 1; k < all.length; k++) {
          if (Number(all[k].dataset.depth ?? "0") > d0) dragBlock.push(all[k]);
          else break;
        }
        dragBlock.forEach((r) => r.classList.add("dragging"));
      });
      document.addEventListener("pointermove", (e) => {
        if (!dragRow) return;
        e.preventDefault();
        const rows = [...secList.querySelectorAll<HTMLElement>(".sec-row")].filter((r) => !dragBlock.includes(r));
        const dopo = rows.find((r) => {
          const rect = r.getBoundingClientRect();
          return e.clientY < rect.top + rect.height / 2;
        });
        // sposta l'intero blocco (nodo + sotto-albero) mantenendo l'ordine interno
        for (const r of dragBlock) {
          if (dopo) secList.insertBefore(r, dopo);
          else secList.appendChild(r);
        }
      });
      document.addEventListener("pointerup", async () => {
        if (!dragRow) return;
        dragBlock.forEach((r) => r.classList.remove("dragging"));
        dragRow = null;
        dragBlock = [];
        const righe = [...secList.querySelectorAll<HTMLElement>(".sec-row")];
        const ordine = righe.map((r) => r.dataset.id!);
        if (JSON.stringify(ordine) === JSON.stringify(cats.map((c) => c.id))) return;
        // manda id + parent (invariato) per non appiattire l'albero
        const nodes = righe.map((r) => ({ id: r.dataset.id!, parent_id: r.dataset.parent || null }));
        const res = await fetch("/api/admin/categories", {
          method: "PATCH",
          headers: { ...headers, "Content-Type": "application/json" },
          body: JSON.stringify({ nodes }),
        });
        if (!res.ok) {
          const j = await res.json();
          secMsg.textContent = j.error ?? tr("menu.reorderFailed");
          renderSezioni();
        } else {
          toast(tr("menu.orderSaved"));
          await caricaTutto();
        }
      });

      (document.getElementById("sec-addbtn") as HTMLButtonElement).addEventListener("click", async () => {
        secMsg.textContent = "";
        const name = secNew.value.trim();
        if (!name) { secMsg.textContent = tr("menu.nameRequired"); return; }
        const res = await fetch("/api/admin/categories", {
          method: "POST",
          headers: { ...headers, "Content-Type": "application/json" },
          body: JSON.stringify({ name, kind: nuovaKind, parent_id: nuovoParent?.id ?? null }),
        });
        const j = await res.json();
        if (!res.ok) {
          secMsg.textContent = j.error ?? tr("menu.errorDot");
        } else {
          secNew.value = "";
          nuovaKind = "food";
          nuovoParent = null;
          renderNuovaKind();
          toast(tr("menu.sectionAdded"));
          await caricaTutto();
        }
      });

      // ---------- Lunch (formules du midi) ----------
      type Lunch = {
        id: string; name: string; courses: string[];
        date_from: string | null; date_to: string | null;
        items: Record<string, string[]>;
        combos: { parts: string[]; price_cents: number }[];
        active: boolean;
      };
      const PORTATE: string[] = ["entree", "plat", "dessert"]; // ordine canonico
      const PORTATA_LAB: Record<string, string> = { entree: tr("menu.courseEntree"), plat: tr("menu.coursePlat"), dessert: tr("menu.courseDessert") };
      let lunches: Lunch[] = [];
      let lunchPronto = false; // primo GET già fatto
      let lunchFetching = false;
      let lunchEditId: string | null = null;

      async function caricaLunches() {
        if (lunchFetching) return;
        lunchFetching = true;
        try {
          const res = await fetch("/api/admin/lunch", { headers });
          if (!res.ok) throw new Error();
          lunches = ((await res.json()).lunches as Lunch[]) ?? [];
        } catch {
          lunches = [];
        } finally {
          lunchPronto = true;
          lunchFetching = false;
        }
        if (kindFiltro === "lunch") renderList();
      }

      function comboLabel(parts: string[]): string {
        return parts.map((p) => PORTATA_LAB[p] ?? p).join(" + ");
      }
      function lunchDatesLabel(l: Lunch): string {
        const f = (s: string | null) => (s ? s.split("-").reverse().join("/") : "");
        if (l.date_from && l.date_to) return `${tr("menu.luFrom")} ${f(l.date_from)} ${tr("menu.luTo2")} ${f(l.date_to)}`;
        if (l.date_from) return `${tr("menu.luFromOnly")} ${f(l.date_from)}`;
        if (l.date_to) return `${tr("menu.luUntil")} ${f(l.date_to)}`;
        return tr("menu.luNoDateLimit");
      }
      function lunchHTML(l: Lunch): string {
        const combos = (l.combos ?? [])
          .map((c) => `<div class="lu-combo"><span>${esc(comboLabel(c.parts))}</span><b>${euro(c.price_cents)}</b></div>`)
          .join("");
        const portate = (l.courses ?? [])
          .map((pt) => {
            const nomi = (l.items?.[pt] ?? [])
              .map((id) => items.find((x) => x.id === id)?.name ?? "")
              .filter(Boolean);
            if (!nomi.length) return "";
            return `<div class="lu-course"><span class="lu-course-tit">${PORTATA_LAB[pt] ?? pt}</span><span class="lu-course-plats">${esc(nomi.join(" · "))}</span></div>`;
          })
          .join("");
        return `
          <div class="lu-card${l.active ? "" : " is-hidden-item"}" data-id="${l.id}">
            <div class="lu-main">
              <div class="lu-name">${esc(l.name)}</div>
              <div class="lu-dates">${lunchDatesLabel(l)}</div>
            </div>
            ${portate ? `<div class="lu-courses">${portate}</div>` : ""}
            <div class="lu-combos">${combos}</div>
            <div class="lu-actions">
              <span class="sw-wrap"><label class="switch"><input type="checkbox" class="lu-act" ${l.active ? "checked" : ""} /><span class="track"></span></label><span class="sw-lab">${tr("menu.active")}</span></span>
              <button class="i-btn lu-edit" title="${tr("common.edit")}">✎</button>
              <button class="i-btn i-del lu-del" title="${tr("common.delete")}">${ICO_TRASH}</button>
            </div>
          </div>`;
      }
      function renderLunchList(filtro: string) {
        if (!lunchPronto) {
          listEl.innerHTML = `<p class="state">${tr("sup.loading")}</p>`;
          void caricaLunches();
          return;
        }
        const arr = lunches.filter((l) => !filtro || l.name.toLowerCase().includes(filtro));
        listEl.innerHTML = arr.length
          ? `<div class="lu-grid">${arr.map(lunchHTML).join("")}</div>`
          : `<p class="state">${tr("menu.noLunch")}</p>`;
      }

      // Bottone flottante: etichetta secondo il tab attivo
      function aggiornaFabs() {
        const add = document.getElementById("add-btn") as HTMLButtonElement | null;
        if (!add) return;
        // Su Lunch/Menus l'intera actionsbar (tab sezioni + ricerca) sparisce:
        // niente seconda linea sotto i filtri, la lista risale
        const barra = document.querySelector(".actionsbar") as HTMLElement | null;
        if (barra) barra.style.display = kindFiltro === "lunch" || kindFiltro === "menus" ? "none" : "";
        // Il FAB Categories riguarda solo le sezioni di Plats/Boissons
        const sec = document.getElementById("sec-btn") as HTMLButtonElement | null;
        if (sec) sec.style.display = kindFiltro === "lunch" || kindFiltro === "menus" ? "none" : "";
        if (kindFiltro === "lunch") { add.style.display = ""; add.textContent = "+ " + tr("menu.addLunchShort"); }
        else if (kindFiltro === "menus") { add.style.display = "none"; }
        else { add.style.display = ""; add.textContent = "+ " + tr(kindFiltro === "drink" ? "menu.itemDrink" : "menu.itemFood"); }
      }

      // ---------- Modale lunch ----------
      const luOverlay = document.getElementById("lu-overlay") as HTMLDivElement;
      const luTitle = document.getElementById("lu-title") as HTMLHeadingElement;
      const luMsg = document.getElementById("lu-msg") as HTMLSpanElement;
      const luName = document.getElementById("lu-name") as HTMLInputElement;
      const luFrom = document.getElementById("lu-from") as HTMLInputElement;
      const luTo = document.getElementById("lu-to") as HTMLInputElement;
      const luCoursesEl = document.getElementById("lu-courses") as HTMLDivElement;
      const luItemsEl = document.getElementById("lu-items") as HTMLDivElement;
      const luCombosEl = document.getElementById("lu-combos") as HTMLDivElement;
      const luActive = document.getElementById("lu-active") as HTMLInputElement;
      const luSave = document.getElementById("lu-save") as HTMLButtonElement;
      let luCourses: string[] = ["plat"]; // portate attive
      let luItems: Record<string, string[]> = {}; // piatti scelti per portata
      let luPrezzi: Record<string, string> = {}; // "entree+plat" -> testo input prezzo

      function aggiornaLuNome() {
        luName.placeholder = luCourses.length === 1 ? tr("menu.dailyDish") : tr("tab.menu.lunch");
      }
      function renderLuCourses() {
        luCoursesEl.innerHTML = PORTATE.map((p) => {
          const on = luCourses.includes(p);
          const lock = p === "plat" ? " is-lock" : ""; // il plat c'è sempre
          return `<button type="button" class="luf-course${on ? " is-on" : ""}${lock}" data-p="${p}">${PORTATA_LAB[p]}</button>`;
        }).join("");
      }
      function renderLuItems() {
        luItemsEl.innerHTML = luCourses
          .map((p) => {
            const scelti = luItems[p] ?? [];
            const opzioni = cats
              .filter((c) => c.kind === "food")
              .map((c) => {
                const dentro = items
                  .filter((i) => i.category === c.name && !scelti.includes(i.id))
                  .map((i) => `<option value="${i.id}">${esc(i.name)}</option>`)
                  .join("");
                return dentro ? `<optgroup label="${esc(c.name)}">${dentro}</optgroup>` : "";
              })
              .join("");
            const chips = scelti
              .map((id) => {
                const it = items.find((x) => x.id === id);
                return `<span class="lu-chip">${esc(it?.name ?? "?")}<button type="button" data-p="${p}" data-id="${id}" title="${tr("ord.remove")}">×</button></span>`;
              })
              .join("");
            return `
            <div class="lu-block">
              <div class="lu-block-tit">${PORTATA_LAB[p]} — ${tr("menu.dishesChoice")}</div>
              <select class="lu-sel" data-p="${p}">
                <option value="">${tr("menu.addMenuDish")}</option>${opzioni}
              </select>
              <div class="lu-chips">${chips || `<span class="f-label">${tr("menu.noDishSelected")}</span>`}</div>
            </div>`;
          })
          .join("");
      }
      // Combinazioni possibili: sottoinsiemi delle portate attive che contengono il plat
      function comboPossibili(): string[][] {
        const extra = luCourses.filter((p) => p !== "plat");
        const out: string[][] = [];
        for (let mask = 0; mask < 1 << extra.length; mask++) {
          const dentro = new Set<string>(["plat"]);
          extra.forEach((p, i) => { if (mask & (1 << i)) dentro.add(p); });
          out.push(PORTATE.filter((p) => dentro.has(p)));
        }
        out.sort((a, b) => a.length - b.length);
        return out;
      }
      function salvaPrezziCorrenti() {
        luCombosEl.querySelectorAll<HTMLInputElement>("input").forEach((inp) => {
          luPrezzi[inp.dataset.k!] = inp.value;
        });
      }
      function renderLuCombos() {
        luCombosEl.innerHTML = comboPossibili()
          .map((parts) => {
            const k = parts.join("+");
            const solo = parts.length === 1 && luCourses.length === 1 ? ` ${tr("menu.dailyDishParen")}` : "";
            return `
            <div class="lu-combo-row">
              <span class="lu-combo-lab">${comboLabel(parts)}${solo}</span>
              <input type="number" min="0" step="0.01" inputmode="decimal" placeholder="€" data-k="${k}" value="${esc(luPrezzi[k] ?? "")}" />
            </div>`;
          })
          .join("");
      }

      function apriLunchModale(l: Lunch | null) {
        lunchEditId = l?.id ?? null;
        luTitle.textContent = l ? tr("menu.editLunch") : tr("menu.addLunch");
        luMsg.textContent = "";
        luName.value = l?.name ?? "";
        impostaData(luFrom, l?.date_from ?? "");
        impostaData(luTo, l?.date_to ?? "");
        luActive.checked = l?.active ?? true;
        luCourses = PORTATE.filter((p) => p === "plat" || (l?.courses ?? []).includes(p));
        luItems = {};
        for (const p of luCourses) luItems[p] = [...(l?.items?.[p] ?? [])];
        luPrezzi = {};
        for (const c of l?.combos ?? []) luPrezzi[c.parts.join("+")] = (c.price_cents / 100).toFixed(2);
        aggiornaLuNome();
        renderLuCourses();
        renderLuItems();
        renderLuCombos();
        luOverlay.classList.add("is-open");
      }
      function chiudiLunchModale() {
        dpChiudi();
        luOverlay.classList.remove("is-open");
        lunchEditId = null;
      }

      // ---- Datepicker brand (come Réglages/Résa) per le date del lunch ----
      const MESI_DP = Array.from({ length: 12 }, (_, m) => new Date(2000, m, 1).toLocaleDateString(LOC, { month: "long" }));
      const DOW_DP = tr("res.dowInitials").split(",");
      let dpTarget: HTMLInputElement | null = null;
      let dpAnno = 0;
      let dpMese = 0; // 0-11
      const dpPanel = document.createElement("div");
      dpPanel.className = "dp-panel";
      dpPanel.style.display = "none";
      document.body.appendChild(dpPanel);

      function isoOggi(): string {
        const d = new Date();
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      }
      function isoDi(y: number, m: number, g: number): string {
        return `${y}-${String(m + 1).padStart(2, "0")}-${String(g).padStart(2, "0")}`;
      }
      function fmtFr(iso: string): string {
        const [y, m, d] = iso.split("-");
        return `${d}/${m}/${y}`;
      }
      function impostaData(el: HTMLInputElement, iso: string) {
        el.dataset.iso = iso;
        el.value = iso ? fmtFr(iso) : "";
      }
      function dpAperto(): boolean {
        return dpPanel.style.display !== "none";
      }
      function dpRender() {
        const oggi = isoOggi();
        const sel = dpTarget?.dataset.iso ?? "";
        const offset = (new Date(dpAnno, dpMese, 1).getDay() + 6) % 7; // lunedì=0
        const nGiorni = new Date(dpAnno, dpMese + 1, 0).getDate();
        let celle = "";
        for (let i = 0; i < offset; i++) celle += '<span class="dp-cell dp-vuota"></span>';
        for (let g = 1; g <= nGiorni; g++) {
          const iso = isoDi(dpAnno, dpMese, g);
          const cls = ["dp-cell"];
          if (iso === oggi) cls.push("dp-today");
          if (iso === sel) cls.push("dp-sel");
          // Nessun giorno vietato: le date di validità possono anche stare nel passato
          celle += `<button type="button" class="${cls.join(" ")}" data-iso="${iso}">${g}</button>`;
        }
        dpPanel.innerHTML = `
          <div class="dp-head">
            <button type="button" class="dp-nav" data-nav="-1">‹</button>
            <span class="dp-title">${MESI_DP[dpMese]} ${dpAnno}</span>
            <button type="button" class="dp-nav" data-nav="1">›</button>
          </div>
          <div class="dp-dow">${DOW_DP.map((g) => `<span>${g}</span>`).join("")}</div>
          <div class="dp-grid">${celle}</div>
          <button type="button" class="dp-clear">${tr("menu.clearNoLimit")}</button>`;
      }
      function dpApri(target: HTMLInputElement) {
        dpTarget = target;
        const base = target.dataset.iso || isoOggi();
        dpAnno = Number(base.slice(0, 4));
        dpMese = Number(base.slice(5, 7)) - 1;
        dpRender();
        dpPanel.style.display = "block";
        const r = target.getBoundingClientRect();
        const pw = dpPanel.offsetWidth || 344;
        const ph = dpPanel.offsetHeight || 380;
        dpPanel.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - pw - 8))}px`;
        dpPanel.style.top = `${Math.max(8, Math.min(r.bottom + 6, window.innerHeight - ph - 8))}px`;
      }
      function dpChiudi() {
        dpPanel.style.display = "none";
        dpTarget = null;
      }
      dpPanel.addEventListener("click", (e) => {
        e.stopPropagation();
        const t = e.target as HTMLElement;
        if (t.classList.contains("dp-nav")) {
          dpMese += Number(t.dataset.nav);
          if (dpMese < 0) { dpMese = 11; dpAnno--; }
          if (dpMese > 11) { dpMese = 0; dpAnno++; }
          dpRender();
          return;
        }
        if (t.classList.contains("dp-clear") && dpTarget) {
          impostaData(dpTarget, "");
          dpChiudi();
          return;
        }
        if (t.classList.contains("dp-cell") && t.dataset.iso && dpTarget) {
          const iso = t.dataset.iso;
          impostaData(dpTarget, iso);
          // se la fine esiste ed è prima dell'inizio, allineala
          if (dpTarget === luFrom) {
            const toIso = luTo.dataset.iso ?? "";
            if (toIso && toIso < iso) impostaData(luTo, iso);
          }
          dpChiudi();
        }
      });
      [luFrom, luTo].forEach((el) => {
        el.addEventListener("click", (e) => {
          e.stopPropagation();
          dpApri(el);
        });
      });
      document.addEventListener("click", (e) => {
        if (dpAperto() && !dpPanel.contains(e.target as Node)) dpChiudi();
      });

      luCoursesEl.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest(".luf-course") as HTMLElement | null;
        if (!b || b.dataset.p === "plat") return;
        const p = b.dataset.p!;
        salvaPrezziCorrenti();
        luCourses = luCourses.includes(p) ? luCourses.filter((x) => x !== p) : [...luCourses, p];
        luCourses = PORTATE.filter((x) => luCourses.includes(x));
        aggiornaLuNome();
        renderLuCourses();
        renderLuItems();
        renderLuCombos();
      });
      luItemsEl.addEventListener("change", (e) => {
        const sel = e.target as HTMLSelectElement;
        if (!sel.classList.contains("lu-sel") || !sel.value) return;
        const p = sel.dataset.p!;
        luItems[p] = [...(luItems[p] ?? []), sel.value];
        renderLuItems();
      });
      luItemsEl.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest(".lu-chip button") as HTMLElement | null;
        if (!b) return;
        luItems[b.dataset.p!] = (luItems[b.dataset.p!] ?? []).filter((id) => id !== b.dataset.id);
        renderLuItems();
      });

      async function salvaLunch() {
        luMsg.textContent = "";
        salvaPrezziCorrenti();
        const combos: { parts: string[]; price_cents: number }[] = [];
        for (const parts of comboPossibili()) {
          const raw = (luPrezzi[parts.join("+")] ?? "").trim();
          if (!raw) continue; // combinazione non proposta
          const cents = Math.round(parseFloat(raw.replace(",", ".")) * 100);
          if (!Number.isFinite(cents) || cents <= 0) {
            luMsg.textContent = `${tr("menu.priceInvalidCombo")} (${comboLabel(parts)}).`;
            return;
          }
          combos.push({ parts, price_cents: cents });
        }
        if (!combos.length) { luMsg.textContent = tr("menu.comboPriceRequired"); return; }
        const dFrom = luFrom.dataset.iso ?? "";
        const dTo = luTo.dataset.iso ?? "";
        if (dFrom && dTo && dFrom > dTo) {
          luMsg.textContent = tr("menu.endBeforeStart");
          return;
        }
        const body: Record<string, unknown> = {
          name: luName.value.trim() || (luCourses.length === 1 ? tr("menu.dailyDish") : tr("tab.menu.lunch")),
          courses: luCourses,
          date_from: dFrom,
          date_to: dTo,
          items: Object.fromEntries(luCourses.map((p) => [p, luItems[p] ?? []])),
          combos,
          active: luActive.checked,
        };
        if (lunchEditId) body.id = lunchEditId;
        luSave.disabled = true;
        luSave.classList.add("is-loading");
        try {
          const res = await fetch("/api/admin/lunch", {
            method: lunchEditId ? "PATCH" : "POST",
            headers: { ...headers, "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
          const j = await res.json();
          if (!res.ok) {
            luMsg.textContent = j.error ?? tr("res.saveError");
          } else {
            toast(lunchEditId ? tr("menu.lunchModified") : tr("menu.lunchAdded"));
            chiudiLunchModale();
            await caricaLunches();
          }
        } catch {
          luMsg.textContent = tr("common.netErr");
        } finally {
          luSave.disabled = false;
          luSave.classList.remove("is-loading");
        }
      }

      (document.getElementById("lu-close") as HTMLButtonElement).addEventListener("click", chiudiLunchModale);
      (document.getElementById("lu-cancel") as HTMLButtonElement).addEventListener("click", chiudiLunchModale);
      luOverlay.addEventListener("click", (e) => { if (e.target === luOverlay) chiudiLunchModale(); });
      luSave.addEventListener("click", salvaLunch);

      // Azioni sulle card lunch (delega)
      listEl.addEventListener("click", async (e) => {
        const t = e.target as HTMLElement;
        const card = t.closest(".lu-card") as HTMLElement | null;
        if (!card) return;
        const l = lunches.find((x) => x.id === card.dataset.id);
        if (!l) return;
        if (t.closest(".lu-edit")) { apriLunchModale(l); return; }
        const del = t.closest(".lu-del") as HTMLButtonElement | null;
        if (del) {
          if (!del.classList.contains("confirm")) {
            del.classList.add("confirm");
            del.textContent = tr("common.confirm");
            setTimeout(() => { del.classList.remove("confirm"); del.innerHTML = ICO_TRASH; }, 3000);
            return;
          }
          try {
            const res = await fetch("/api/admin/lunch?id=" + l.id, { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } });
            if (!res.ok) { toast(tr("us.delErr"), true); return; }
            toast(tr("menu.lunchDeleted"));
            await caricaLunches();
          } catch {
            toast(tr("res.connErr"), true);
          }
        }
      });
      listEl.addEventListener("change", async (e) => {
        const t = e.target as HTMLInputElement;
        if (!t.classList.contains("lu-act")) return;
        const card = t.closest(".lu-card") as HTMLElement;
        try {
          const res = await fetch("/api/admin/lunch", {
            method: "PATCH",
            headers: { ...headers, "Content-Type": "application/json" },
            body: JSON.stringify({ id: card.dataset.id, active: t.checked }),
          });
          if (!res.ok) throw new Error();
          const l = lunches.find((x) => x.id === card.dataset.id);
          if (l) l.active = t.checked;
          card.classList.toggle("is-hidden-item", !t.checked);
        } catch {
          t.checked = !t.checked;
          toast(tr("us.editErr"), true);
        }
      });

      // ---------- Avvio ----------
      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        headers = { Authorization: `Bearer ${session.access_token ?? ""}` };

        renderNuovaKind();
        // Primo caricamento: usa i dati SSR (Fase 2) se presenti, senza fetch.
        let ssrMenuDati: { categories: Cat[]; items: Item[] } | null = null;
        try {
          const raw = document.getElementById("ssr-menu")?.textContent?.trim();
          if (raw) ssrMenuDati = JSON.parse(raw);
        } catch {
          ssrMenuDati = null;
        }
        await caricaTutto(ssrMenuDati ?? undefined);

        searchEl.addEventListener("input", renderList);
        (document.getElementById("k-filtri") as HTMLDivElement).addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".kf-pill") as HTMLElement | null;
          if (!t || !t.dataset.kind) return;
          kindFiltro = t.dataset.kind as KindTab;
          attiva = cats.find((c) => c.kind === kindFiltro)?.name ?? "";
          searchEl.value = "";
          renderTabs();
          renderList();
        });
        tabsEl.addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".tab") as HTMLElement | null;
          if (!t) return;
          if (t.dataset.kind) {
            kindFiltro = t.dataset.kind as "food" | "drink";
            attiva = cats.find((c) => c.kind === kindFiltro)?.name ?? "";
          } else {
            attiva = t.dataset.cat!;
          }
          searchEl.value = "";
          renderTabs();
          renderList();
        });

        (document.getElementById("add-btn") as HTMLButtonElement).addEventListener("click", () => {
          if (kindFiltro === "lunch") { apriLunchModale(null); return; }
          if (kindFiltro === "menus") return;
          apriModale(null);
        });
        (document.getElementById("sec-btn") as HTMLButtonElement).addEventListener("click", () => {
          secMsg.textContent = "";
          renderSezioni();
          secOverlay.classList.add("is-open");
        });
        (document.getElementById("m-close") as HTMLButtonElement).addEventListener("click", chiudiModale);
        (document.getElementById("m-cancel") as HTMLButtonElement).addEventListener("click", chiudiModale);
        (document.getElementById("sec-close") as HTMLButtonElement).addEventListener("click", () => secOverlay.classList.remove("is-open"));
        mSave.addEventListener("click", salvaModale);
        overlay.addEventListener("click", (e) => { if (e.target === overlay) chiudiModale(); });
        secOverlay.addEventListener("click", (e) => { if (e.target === secOverlay) secOverlay.classList.remove("is-open"); });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            if (dpAperto()) { dpChiudi(); return; }
            chiudiModale(); chiudiLunchModale(); secOverlay.classList.remove("is-open");
          }
        });

        // Azioni sui piatti (delega)
        listEl.addEventListener("click", async (e) => {
          const t = e.target as HTMLElement;
          const row = t.closest(".item") as HTMLElement | null;
          if (!row) return;
          const id = row.dataset.id!;
          const it = items.find((x) => x.id === id);
          if (!it) return;

          if (t.closest(".i-edit")) { apriModale(it); return; }
          const del = t.closest(".i-del") as HTMLButtonElement | null;
          if (del) {
            if (!del.classList.contains("confirm")) {
              del.classList.add("confirm");
              del.textContent = tr("common.confirm");
              setTimeout(() => { del.classList.remove("confirm"); del.innerHTML = ICO_TRASH; }, 3000);
              return;
            }
            try {
              const res = await fetch("/api/admin/menu?id=" + id, { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } });
              if (!res.ok) { toast(tr("us.delErr"), true); return; }
              toast(tr("menu.dishDeleted"));
              await caricaTutto();
            } catch {
              toast(tr("res.connErr"), true);
            }
          }
        });

        // Drag & drop: piatti (.i-drag) e pillole sotto-categoria (.s-drag)
        let dragItem: HTMLElement | null = null;
        let dragSub: HTMLElement | null = null;
        let dragSubBlock: HTMLElement[] = [];
        listEl.addEventListener("pointerdown", (e) => {
          if (listEl.dataset.mode === "search") return;
          // Pillola sotto-categoria: trascina l'intero blocco (pillola + suoi piatti/sottolivelli)
          const sHandle = (e.target as HTMLElement).closest(".s-drag");
          if (sHandle && sHandle.closest(".sub-head")) {
            e.preventDefault();
            dragSub = sHandle.closest(".sub-head") as HTMLElement;
            const d0 = Number(dragSub.dataset.depth ?? "1");
            dragSubBlock = [dragSub];
            let el = dragSub.nextElementSibling as HTMLElement | null;
            while (el) {
              if (el.classList.contains("sub-head") && Number(el.dataset.depth ?? "0") <= d0) break;
              dragSubBlock.push(el);
              el = el.nextElementSibling as HTMLElement | null;
            }
            dragSubBlock.forEach((r) => r.classList.add("dragging"));
            return;
          }
          const handle = (e.target as HTMLElement).closest(".i-drag");
          if (!handle) return;
          e.preventDefault();
          dragItem = handle.closest(".item") as HTMLElement;
          dragItem.classList.add("dragging");
        });
        document.addEventListener("pointermove", (e) => {
          // Riordino sotto-categoria: solo tra sorelle (stesso parent + stesso livello)
          if (dragSub) {
            e.preventDefault();
            const d0 = Number(dragSub.dataset.depth ?? "1");
            const pid = dragSub.dataset.parent ?? "";
            const heads = [...listEl.querySelectorAll<HTMLElement>(".sub-head")].filter(
              (h) => !dragSubBlock.includes(h) && Number(h.dataset.depth ?? "0") === d0 && (h.dataset.parent ?? "") === pid
            );
            const dopo = heads.find((h) => { const r = h.getBoundingClientRect(); return e.clientY < r.top + r.height / 2; });
            for (const r of dragSubBlock) { if (dopo) listEl.insertBefore(r, dopo); else listEl.appendChild(r); }
            return;
          }
          if (!dragItem) return;
          e.preventDefault();
          const conf = [...listEl.querySelectorAll<HTMLElement>(".item, .sub-head")].filter((r) => r !== dragItem);
          const dopo = conf.find((r) => { const rect = r.getBoundingClientRect(); return e.clientY < rect.top + rect.height / 2; });
          if (dopo) listEl.insertBefore(dragItem!, dopo); else listEl.appendChild(dragItem!);
          // evidenzia la pillola del gruppo di destinazione
          let target: HTMLElement | null = null;
          for (const el of [...listEl.children] as HTMLElement[]) {
            if (el === dragItem) break;
            if (el.classList.contains("sub-head")) target = el;
          }
          listEl.querySelectorAll(".sub-head.drop-target").forEach((x) => x.classList.remove("drop-target"));
          if (target) target.classList.add("drop-target");
        });
        document.addEventListener("pointerup", async () => {
          // === Fine drag di una SOTTO-CATEGORIA ===
          if (dragSub) {
            dragSubBlock.forEach((r) => r.classList.remove("dragging"));
            dragSub = null; dragSubBlock = [];
            const nuoviId = [...listEl.querySelectorAll<HTMLElement>(".sub-head")].map((h) => h.dataset.id!);
            const activeCat = cats.find((c) => c.name === attiva);
            if (!activeCat) return;
            const perId = new Map(cats.map((c) => [c.id, c]));
            const isDesc = (rootId: string, id: string): boolean => {
              let c = perId.get(id);
              let g = 0;
              while (c && c.parent_id && g < 12) { if (c.parent_id === rootId) return true; c = perId.get(c.parent_id); g++; }
              return false;
            };
            const rootIdx = cats.findIndex((c) => c.id === activeCat.id);
            let end = rootIdx + 1;
            while (end < cats.length && isDesc(activeCat.id, cats[end].id)) end++;
            const descById = new Map(cats.slice(rootIdx + 1, end).map((c) => [c.id, c]));
            const newDesc = nuoviId.map((id) => descById.get(id)).filter(Boolean) as Cat[];
            if (newDesc.length !== descById.size) { renderList(); return; }
            const attualeDesc = cats.slice(rootIdx + 1, end).map((c) => c.id);
            if (JSON.stringify(attualeDesc) === JSON.stringify(nuoviId)) return; // nessun cambiamento
            const newOrder = [...cats.slice(0, rootIdx + 1), ...newDesc, ...cats.slice(end)];
            const nodes = newOrder.map((c) => ({ id: c.id, parent_id: c.parent_id ?? null }));
            try {
              const r = await fetch("/api/admin/categories", { method: "PATCH", headers: { ...headers, "Content-Type": "application/json" }, body: JSON.stringify({ nodes }) });
              if (!r.ok) throw new Error();
              toast(tr("menu.orderSaved"));
              await caricaTutto();
            } catch {
              toast(tr("menu.reorderFailedShort"), true);
              renderList();
            }
            return;
          }
          // === Fine drag di un PIATTO ===
          if (!dragItem) return;
          dragItem.classList.remove("dragging");
          dragItem = null;
          listEl.querySelectorAll(".sub-head.drop-target").forEach((x) => x.classList.remove("drop-target"));
          const groups = new Map<string, string[]>();
          let cur = attiva;
          for (const el of [...listEl.children] as HTMLElement[]) {
            if (el.classList.contains("sub-head")) cur = el.dataset.cat || attiva;
            else if (el.classList.contains("item")) {
              if (!groups.has(cur)) groups.set(cur, []);
              groups.get(cur)!.push(el.dataset.id!);
            }
          }
          const catDi = new Map(items.map((i) => [i.id, i.category]));
          const moves: { id: string; cat: string }[] = [];
          let cambiato = false;
          for (const [cat, ids] of groups) {
            for (const id of ids) if (catDi.get(id) !== cat) { moves.push({ id, cat }); cambiato = true; }
            const attualeIds = items.filter((i) => i.category === cat).sort((a, b) => a.sort_order - b.sort_order).map((i) => i.id);
            if (JSON.stringify(attualeIds) !== JSON.stringify(ids)) cambiato = true;
          }
          if (!cambiato) return;
          try {
            for (const m of moves) {
              const r = await fetch("/api/admin/menu", { method: "PUT", headers: { ...headers, "Content-Type": "application/json" }, body: JSON.stringify({ id: m.id, category: m.cat }) });
              if (!r.ok) throw new Error();
            }
            for (const [cat, ids] of groups) {
              const r = await fetch("/api/admin/menu", { method: "PATCH", headers: { ...headers, "Content-Type": "application/json" }, body: JSON.stringify({ category: cat, order: ids }) });
              if (!r.ok) throw new Error();
            }
            toast(tr("menu.orderSaved"));
            await caricaTutto();
          } catch {
            toast(tr("menu.reorderFailedShort"), true);
            renderList();
          }
        });

        listEl.addEventListener("change", async (e) => {
          const t = e.target as HTMLInputElement;
          if (!t.classList.contains("t-av") && !t.classList.contains("t-or") && !t.classList.contains("t-soldout")) return;
          const row = t.closest(".item") as HTMLElement;
          const id = row.dataset.id!;
          const campo = t.classList.contains("t-av") ? "available" : t.classList.contains("t-or") ? "orderable" : "sold_out";
          try {
            const res = await fetch("/api/admin/menu", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id, [campo]: t.checked }),
            });
            if (!res.ok) throw new Error();
            const it = items.find((x) => x.id === id);
            if (it) (it as any)[campo] = t.checked;
            if (campo === "available") row.classList.toggle("is-hidden-item", !t.checked);
            if (campo === "sold_out") {
              const nameEl = row.querySelector(".i-name");
              const pill = nameEl?.querySelector(".i-soldout");
              if (t.checked && !pill && nameEl) {
                nameEl.insertAdjacentHTML("beforeend", `<span class="i-soldout">\u26D4 ${esc(tr("menu.soldOut"))}</span>`);
              } else if (!t.checked && pill) {
                pill.remove();
              }
            }
          } catch {
            t.checked = !t.checked;
            toast(tr("us.editErr"), true);
          }
        });

        // --- Tab del Menu vietati a questo utente (decisi dal super in Réglages MOODD) ---
        try {
          const rp = await fetch("/api/admin/pages", { headers });
          if (rp.ok) {
            const jp = (await rp.json()) as { hiddenTabs?: string[]; super?: boolean };
            if (!jp.super) {
              tabVietati = (jp.hiddenTabs ?? [])
                .filter((t) => t.startsWith("menu:"))
                .map((t) => t.slice(5));
              if (tabVietati.length) {
                if (tabVietati.includes(kindFiltro)) {
                  const ordine: KindTab[] = ["food", "drink", "lunch", "menus"];
                  kindFiltro = ordine.find((k) => !tabVietati.includes(k)) ?? kindFiltro;
                  attiva = cats.find((c) => c.kind === kindFiltro)?.name ?? "";
                }
                renderTabs();
                renderList();
              }
            }
          }
        } catch { /* rete assente: si resta com'è */ }
      })();
    </script>
  </body>
</html>
