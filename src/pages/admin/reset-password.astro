---
// Pagina di reimpostazione password — stesso layout SPLIT della login.
// L'utente arriva qui dal link "mot de passe oublié" (Supabase, type=recovery):
// supabase-js rileva il token nell'URL e apre una sessione di recupero; qui
// l'utente sceglie la nuova password (updateUser). Standalone, RestoHub-branded.
import { CLIENT } from "../../config/client";
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";
import { supabaseAdmin } from "../../lib/db";
import { cacheOr } from "../../lib/cache";
const lang = await adminLang();
const t = adminT(lang);

// SSR: la pagina legge la config e sceglie la cover a ogni richiesta.
export const prerender = false;

const SLIDE_FALLBACKS = ["/slideshow/slide-01.webp", "/slideshow/slide-02.webp", "/slideshow/slide-03.webp"];
const FALLBACK_COVERS = [
  "/restohub/slide01.webp",
  "/restohub/slide02.webp",
  "/restohub/slide03.webp",
  "/restohub/slide04.webp",
];

const brand = await (async () => {
  try {
    return await cacheOr("pub:login-brand2", async () => {
      const { data } = await supabaseAdmin
        .from("app_config")
        .select("key, value")
        .in("key", ["restaurant_name", "brand_logo", "brand_logo_negative", "site_hero_1", "site_hero_2", "site_hero_3"]);
      const m = new Map((data ?? []).map((r) => [String(r.key), String(r.value ?? "")] as [string, string]));
      const nome = (m.get("restaurant_name") ?? "").trim();
      const heroCfg = [1, 2, 3].map((i) => (m.get("site_hero_" + i) ?? "").trim()).filter(Boolean);
      const heroImages = heroCfg.length ? heroCfg : (nome ? SLIDE_FALLBACKS : []);
      return {
        nome,
        logo: (m.get("brand_logo") ?? "").trim() || CLIENT.logoLogin,
        logoNeg: (m.get("brand_logo_negative") ?? "").trim(),
        heroImages,
      };
    }, 60);
  } catch {
    return { nome: "", logo: CLIENT.logoLogin, logoNeg: "", heroImages: [] as string[] };
  }
})();

const PAYOFF: Record<string, string> = {
  fr: "Un hub. Tout le restaurant.",
  en: "One hub. Whole restaurant.",
  it: "Un hub. Tutto il ristorante.",
  nl: "Eén hub. Heel het restaurant.",
  es: "Un hub. Todo el restaurante.",
};
const payoff = PAYOFF[lang] ?? PAYOFF.fr;

const LEGAL: Record<string, Record<string, string>> = {
  terms: { fr: "Conditions générales", en: "Terms & Conditions", it: "Termini e condizioni", nl: "Algemene voorwaarden", es: "Términos y condiciones" },
  privacy: { fr: "Politique de confidentialité", en: "Privacy Policy", it: "Privacy", nl: "Privacybeleid", es: "Privacidad" },
};
const legalTerms = LEGAL.terms[lang] ?? LEGAL.terms.fr;
const legalPrivacy = LEGAL.privacy[lang] ?? LEGAL.privacy.fr;

// Solo https:// o path assoluti "/…", senza caratteri che potrebbero rompere
// lo style inline (difesa in profondità: Astro escapizza già gli attributi).
const COVER_OK = /^(https:\/\/[^\s"\x27()]+|\/[^\s"\x27()]*)$/;
const pool0 = brand.heroImages.length ? brand.heroImages : FALLBACK_COVERS;
const coverPool = pool0.filter((u) => COVER_OK.test(u));
const safePool = coverPool.length ? coverPool : FALLBACK_COVERS;
const cover = safePool[Math.floor(Math.random() * safePool.length)];
const topLogo = brand.logoNeg || "/restohub/wordmark-negative.svg";
const showPayoff = !brand.logoNeg;
const heroTitle = brand.nome || t("login.title");
const tabTitle = brand.nome || t("login.title");
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tabTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;900&family=Quicksand:wght@500;600;700&display=swap" />
    <style>
      :root {
        --c-hover: #e04f00; --c-card: #ffffff; --c-input: #f1f1f1; --c-bg: #ffffff;
        --c-text: #333333; --c-accent: #ff7300; --c-muted: #a6a6a6; --c-line: #e7e7e7;
        --c-error: #e5544b; --c-ok: #2f9e59;
        --font-title: "Quicksand", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
        --font-brand: "Quicksand", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; }
      .split { display: flex; min-height: 100vh; }

      /* ---------- Pannello immagine ---------- */
      .pane-img {
        flex: 1.1 1 0; position: relative; overflow: hidden;
        background-size: cover; background-position: center; background-color: #14100c;
        display: flex; flex-direction: column; justify-content: space-between;
        padding: 2.8rem 2.6rem; min-height: 100vh;
      }
      .pane-img::before {
        content: ""; position: absolute; inset: 0;
        background:
          linear-gradient(180deg, rgba(0, 45, 52, .60) 0%, rgba(0, 45, 52, .90) 100%),
          radial-gradient(760px 500px at 20% 6%, rgba(0, 45, 52, .30), transparent 62%);
      }
      .pane-img > * { position: relative; z-index: 1; }
      .img-top { display: block; }
      .img-logo { height: 30px; width: auto; max-width: 240px; object-fit: contain; display: block; filter: drop-shadow(0 4px 12px rgba(0,0,0,.35)); }
      .img-payoff { margin-top: .75rem; color: rgba(255, 255, 255, .9); font-family: var(--font-brand); font-weight: 500; font-size: .92rem; letter-spacing: .01em; }
      .img-hero h2 { font-family: var(--font-brand); font-weight: 600; color: #fff; font-size: clamp(1.9rem, 3.2vw, 2.7rem); line-height: 1.1; letter-spacing: .01em; }
      .img-hero .line { width: 56px; height: 3px; background: #dd5851; margin: 1.1rem 0 1.1rem; border-radius: 2px; }
      .img-hero p { color: rgba(255, 255, 255, .82); font-size: 1rem; max-width: 380px; line-height: 1.6; }
      .img-legal { display: flex; flex-direction: column; gap: .35rem; }
      .img-copy { color: rgba(255, 255, 255, .6); font-size: .72rem; letter-spacing: .06em; }
      .img-links { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
      .img-links a { color: rgba(255, 255, 255, .72); font-size: .74rem; text-decoration: none; }
      .img-links a:hover { color: #fff; text-decoration: underline; }
      .img-links .sep { color: rgba(255, 255, 255, .35); }

      /* ---------- Pannello form (brandizzato RestoHub) ---------- */
      .pane-form {
        --c-accent: #dd5851; --c-hover: #c8443c; --c-text: #002d34; --c-muted: #9aa4a4;
        --c-input: #f0f1f1; --c-line: #e7e7e7; --c-card: #ffffff; --c-error: #d64545; --c-ok: #2f9e59;
        flex: .9 1 0; display: flex; align-items: center; justify-content: center; background: #ffffff; padding: 2.4rem 1.6rem;
      }
      .form-inner { width: 100%; max-width: 360px; }
      .form-h { font-family: var(--font-title); font-size: 1.7rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--c-text); margin-bottom: .2rem; }
      .form-badge { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.7rem; }
      .form-badge img { width: 46px; height: 46px; object-fit: contain; border-radius: 12px; border: 1px solid var(--c-line); background: #fff; padding: 6px; box-shadow: 0 6px 16px -8px rgba(0,0,0,.25); }
      .form-badge span { font-family: var(--font-brand); font-weight: 600; font-size: 1rem; color: var(--c-text); }
      .form-sub { color: var(--c-muted); font-size: .85rem; margin-bottom: 2rem; }
      .intro { color: var(--c-muted); font-size: .86rem; line-height: 1.55; margin: -.8rem 0 1.6rem; }
      .loading { text-align: center; color: var(--c-muted); font-size: .9rem; padding: 1rem 0; }
      label { display: block; font-size: .66rem; letter-spacing: .06em; text-transform: uppercase; color: var(--c-muted); margin-bottom: .4rem; font-weight: 700; }
      input {
        width: 100%; background: var(--c-input); border: 1px solid var(--c-line); border-radius: 7px;
        color: var(--c-text); font-family: var(--font-body); font-size: 1rem; padding: .8rem .9rem;
        margin-bottom: 1.1rem; transition: border-color .15s, background .15s;
      }
      input:focus { outline: none; border-color: var(--c-accent); background: var(--c-card); }
      button.primary {
        width: 100%; background: var(--c-accent); color: #fff; border: none; border-radius: 7px;
        font-family: var(--font-title); font-weight: 700; font-size: 1rem; letter-spacing: .08em; text-transform: uppercase; padding: .85rem;
        cursor: pointer; transition: background .2s, transform .1s; margin-top: .2rem;
      }
      button.primary:hover { background: var(--c-hover); }
      button.primary:active { transform: scale(.985); }
      button.primary:disabled { opacity: .5; cursor: not-allowed; }
      .link { display: block; width: 100%; background: none; border: none; color: var(--c-accent); font-family: var(--font-body); font-size: .85rem; font-weight: 700; cursor: pointer; text-align: center; margin-top: 1.2rem; padding: .3rem; text-decoration: none; }
      .link:hover { text-decoration: underline; }
      .msg { font-size: .84rem; text-align: center; margin-bottom: 1rem; min-height: 1.1rem; line-height: 1.45; }
      .msg.err, .msg.ok { text-align: left; padding: .8rem .95rem; border-radius: 9px; border: 1px solid; min-height: 0; }
      .msg.ok { color: var(--c-ok); background: rgba(47, 158, 89, .10); border-color: rgba(47, 158, 89, .28); }
      .msg.err { color: var(--c-error); background: rgba(214, 69, 69, .08); border-color: rgba(214, 69, 69, .26); }
      .form-legal { display: none; margin-top: 2.4rem; text-align: center; color: var(--c-muted); font-size: .72rem; line-height: 1.9; }
      .form-legal a { color: var(--c-muted); text-decoration: none; }
      .form-legal a:hover { color: var(--c-text); text-decoration: underline; }
      .form-legal .sep { opacity: .5; margin: 0 .3rem; }

      /* ---------- Mobile ---------- */
      @media (max-width: 860px) {
        .split { flex-direction: column; }
        .pane-img {
          min-height: 340px; flex: none; padding: 2.2rem 1.6rem 2.6rem;
          justify-content: center; align-items: center; text-align: center;
        }
        .img-top, .img-hero { width: 100%; }
        .img-logo { margin: 0 auto; }
        .img-payoff { text-align: center; }
        .img-hero { margin-top: 1.6rem; }
        .img-hero h2 { font-size: 1.9rem; }
        .img-hero .line { margin: 1.1rem auto; }
        .img-hero p { display: none; }
        .img-legal { display: none; }
        .pane-form { flex: none; padding: 0 1.4rem 2.8rem; position: relative; z-index: 2; margin-top: -16px; }
        .form-inner { text-align: center; }
        .form-badge { justify-content: center; position: relative; z-index: 3; margin-top: -34px; margin-bottom: 1.3rem; }
        .form-badge img { width: 76px; height: 76px; border: 3px solid #fff; box-shadow: 0 10px 26px -8px rgba(0,0,0,.45); }
        .form-legal { display: block; }
      }
    </style>
  </head>
  <body>
    <div class="split">
      <!-- IMMAGINE -->
      <section class="pane-img" style={`background-image:url("${cover}")`}>
        <div class="img-top">
          <img class="img-logo" src={topLogo} alt={brand.logoNeg ? heroTitle : "RestoHub"} />
          {showPayoff && <p class="img-payoff">{payoff}</p>}
        </div>
        <div class="img-hero">
          <h2>{heroTitle}</h2>
          <div class="line"></div>
          <p>{t("login.admin")}</p>
        </div>
        <div class="img-legal">
          <span class="img-copy">© 2026 MOODD</span>
          <nav class="img-links">
            <a href="/legal/terms">{legalTerms}</a>
            <span class="sep">·</span>
            <a href="/legal/privacy">{legalPrivacy}</a>
          </nav>
        </div>
      </section>

      <!-- FORM -->
      <section class="pane-form">
        <div class="form-inner">
          <div class="form-badge">
            <img src={brand.logo} alt={heroTitle} />
            {brand.nome && <span>{brand.nome}</span>}
          </div>
          <h1 class="form-h">{t("reset.title")}</h1>
          <p class="form-sub">{t("login.admin")}</p>

          <div class="loading" id="reset-loading">…</div>

          <!-- FORM nuova password (visibile solo con sessione di recupero valida) -->
          <div id="reset-form-wrap" style="display:none">
            <p class="intro">{t("reset.intro")}</p>
            <div class="msg" id="reset-msg"></div>
            <form id="reset-form">
              <label for="pw1">{t("reset.title")}</label>
              <input type="password" id="pw1" name="pw1" autocomplete="new-password" required />
              <label for="pw2">{t("reset.confirm")}</label>
              <input type="password" id="pw2" name="pw2" autocomplete="new-password" required />
              <button type="submit" class="primary" id="save-btn">{t("reset.save")}</button>
            </form>
          </div>

          <!-- Link non valido / scaduto -->
          <div id="reset-invalid" style="display:none">
            <p class="intro" style="color:var(--c-error)">{t("reset.err")}</p>
            <a class="link" href="/admin/login">← {t("login.back")}</a>
          </div>

          <div class="form-legal">
            © 2026 MOODD
            <br />
            <a href="/legal/terms">{legalTerms}</a>
            <span class="sep">·</span>
            <a href="/legal/privacy">{legalPrivacy}</a>
          </div>
        </div>
      </section>
    </div>

    <script is:inline>
      try {
        const th = JSON.parse(localStorage.getItem("mdd_theme") || "null");
        if (th && typeof th === "object") {
          for (const k in th) {
            if (/^[a-z]+$/.test(k) && /^#[0-9a-f]{6}$/i.test(String(th[k]))) {
              document.documentElement.style.setProperty("--c-" + k, th[k]);
            }
          }
          if (/^#[0-9a-f]{6}$/i.test(String(th.bg))) {
            document.querySelector('meta[name="theme-color"]')?.setAttribute("content", th.bg);
          }
        }
      } catch { /* niente tema */ }
    </script>
    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { adminT, type AdminLang } from "../../i18n/admin";
      const tr = adminT((document.documentElement.lang || "fr") as AdminLang);
      const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

      let ready = false;
      function showForm() {
        ready = true;
        $("reset-loading").style.display = "none";
        $("reset-invalid").style.display = "none";
        $("reset-form-wrap").style.display = "";
      }
      function showInvalid() {
        $("reset-loading").style.display = "none";
        $("reset-form-wrap").style.display = "none";
        $("reset-invalid").style.display = "";
      }

      // Il token di recupero nell'URL apre una sessione: appena c'è, mostra il form.
      supabaseBrowser.auth.onAuthStateChange((event, session) => {
        if (event === "PASSWORD_RECOVERY" || (session && !ready)) showForm();
      });
      // Fallback: se dopo un attimo non c'è sessione, il link è scaduto/non valido.
      setTimeout(async () => {
        if (ready) return;
        const { data } = await supabaseBrowser.auth.getSession();
        if (data.session) showForm(); else showInvalid();
      }, 1800);

      const msg = $<HTMLDivElement>("reset-msg");
      const btn = $<HTMLButtonElement>("save-btn");
      $<HTMLFormElement>("reset-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        msg.textContent = ""; msg.className = "msg";
        const p1 = $<HTMLInputElement>("pw1").value;
        const p2 = $<HTMLInputElement>("pw2").value;
        if (p1.length < 8) { msg.className = "msg err"; msg.textContent = tr("reset.short"); return; }
        if (p1 !== p2) { msg.className = "msg err"; msg.textContent = tr("reset.mismatch"); return; }
        const label = btn.textContent;
        btn.disabled = true; btn.textContent = tr("reset.saving");
        const { error } = await supabaseBrowser.auth.updateUser({ password: p1 });
        if (error) {
          msg.className = "msg err"; msg.textContent = tr("reset.err");
          btn.disabled = false; btn.textContent = label;
          return;
        }
        msg.className = "msg ok"; msg.textContent = tr("reset.ok");
        // Password cambiata: chiudi la sessione di recupero e torna al login,
        // così l'utente rientra con la nuova password.
        await supabaseBrowser.auth.signOut();
        setTimeout(() => { window.location.href = "/admin/login"; }, 1800);
      });
    </script>
  </body>
</html>
