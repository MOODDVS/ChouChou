        async function caricaNews() {
          // "Guarigione" acquisti pending (pagati ma mai verificati)
          try {
            await fetch("/api/admin/credits", { headers });
          } catch {
            // non bloccante
          }
          try {
            const res = await fetch("/api/admin/newsletter", { headers });
            if (!res.ok) return;
            const s = (await res.json()) as NewsStato;
            destinatariNoti = s.recipients;
            nSent.textContent = String(s.sent_this_month);
            nRemaining.textContent = String(s.remaining);
            nPurchased.textContent =
              s.purchased_balance > 0 ? `dont ${s.purchased_balance} crédits achetés` : "";
            nRecipients.textContent = String(s.recipients);
            if (s.history.length === 0) {
              nHistory.innerHTML = "";
              nHempty.style.display = "block";
            } else {
              nHempty.style.display = "none";
              nHistory.innerHTML = s.history
                .map((h) => {
                  const d = new Date(h.created_at).toLocaleDateString("fr-BE", {
                    day: "2-digit", month: "2-digit", year: "numeric",
                    timeZone: "Europe/Brussels",
                  });
                  return `<div class="n-row"><span class="n-row-subject">${esc(h.subject)}</span><span class="n-row-count">${h.count} emails</span><span class="n-row-date">${d}</span></div>`;
                })
                .join("");
            }
          } catch {
            // silenzioso: le stat restano "—"
          }
        }

