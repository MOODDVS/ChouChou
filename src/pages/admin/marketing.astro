---
// Pannello admin — MARKETING.
// Tab "Pop-up": gestione dei modali di comunicazione del sito pubblico.
// Ogni pop-up: immagine/titolo/testo/max 2 bottoni (facoltativi tranne il
// titolo), scelta delle pagine, programmazione (sempre / date / giorni+ore)
// e numero massimo di visualizzazioni per visitatore.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import ImagePicker from "../../components/admin/ImagePicker.astro";
import { CLIENT } from "../../config/client";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{"Marketing — Admin " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#231f20" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-bg: #231f20;
        --c-text: #ffffff;
        --c-accent: #dfab4e;
        --c-muted: #b3aca6;
        --c-line: #3a3335;
        --c-card: #362c28;
        --font-title: "Bebas Neue", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; overflow-x: hidden; }
      #app { display: none; min-height: 100vh; flex-direction: column; }

      main { flex: 1; padding: 2rem 2rem 8rem; width: 100%; }
      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; margin-bottom: 1.25rem; }
      h1 svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .state { color: var(--c-muted); text-align: center; padding: 3rem 1rem; }

      /* Tabs (come Réglages) */
      .mtabs { display: flex; gap: 0.4rem; flex-wrap: wrap; padding-bottom: 1.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--c-line); }
      .mtab {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.05em;
        padding: 0.45rem 1.2rem; cursor: pointer; border-radius: 999px;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .mtab:hover { color: var(--c-text); border-color: var(--c-accent); }
      .mtab.is-active { background: var(--c-accent); border-color: var(--c-accent); color: #231f20; }

      .actionsbar { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
      .pill {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-weight: 700; font-size: 0.85rem;
        padding: 0.55rem 1.1rem; cursor: pointer; border-radius: 999px;
        transition: border-color 0.2s;
      }
      .pill:hover { border-color: var(--c-accent); }

      /* Card pop-up */
      .pops { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.25rem; }
      .pop {
        background: var(--c-card); border: 1px solid var(--c-line);
        padding: 1.25rem; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
        display: flex; flex-direction: column; gap: 0.7rem;
      }
      .pop.is-off { opacity: 0.55; }
      .pop-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.8rem; }
      .pop-title { font-family: var(--font-title); font-size: 1.35rem; letter-spacing: 0.03em; }
      .pop-text { color: var(--c-muted); font-size: 0.88rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .pop-meta { display: flex; flex-wrap: wrap; gap: 0.35rem; }
      .m-tag {
        display: inline-block; padding: 0.16rem 0.55rem; border: 1px solid var(--c-line);
        border-radius: 999px; color: var(--c-muted); font-size: 0.7rem;
        text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap;
      }
      .m-tag.gold { border-color: rgba(223, 171, 78, 0.5); color: var(--c-accent); }
      .pop-actions { display: flex; align-items: center; gap: 0.6rem; border-top: 1px solid var(--c-line); padding-top: 0.9rem; margin-top: auto; }

      /* Switch */
      .sw-wrap { display: inline-flex; align-items: center; gap: 0.5rem; }
      .sw-lab { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); }
      .switch { position: relative; display: inline-block; width: 46px; height: 26px; flex-shrink: 0; }
      .switch input { opacity: 0; width: 0; height: 0; }
      .switch .track {
        position: absolute; inset: 0; cursor: pointer; border-radius: 999px;
        background: var(--c-line); transition: background 0.2s;
      }
      .switch .track::before {
        content: ""; position: absolute; width: 20px; height: 20px; left: 3px; top: 3px;
        border-radius: 50%; background: #231f20; transition: transform 0.2s;
      }
      .switch input:checked + .track { background: var(--c-accent); }
      .switch input:checked + .track::before { transform: translateX(20px); }

      /* Bottoni icona (come le altre pagine admin) */
      .i-btn {
        width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
        background: transparent; border: 1px solid var(--c-line); border-radius: 50%;
        color: var(--c-muted); cursor: pointer; font-size: 0.95rem;
        transition: border-color 0.2s, color 0.2s, background 0.2s;
      }
      .i-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .i-edit { margin-left: auto; }
      .k-ico { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .i-del { background: rgba(237, 28, 36, 0.25); border-color: rgba(237, 28, 36, 0.35); color: #fff; }
      .i-del:hover { background: rgba(237, 28, 36, 0.55); border-color: #ed1c24; color: #fff; }
      .i-del.confirm { width: auto; padding: 0 0.75rem; border-radius: 999px; font-size: 0.75rem; font-family: var(--font-body); background: #a3320f; border-color: #a3320f; color: #fff; white-space: nowrap; }

      /* Modale form */
      .overlay {
        position: fixed; inset: 0; z-index: 300; display: none;
        background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
        justify-content: center; padding: 3vh 1rem; overflow-y: auto;
      }
      .overlay.is-open { display: flex; }
      /* margin auto = sempre centrato, ma scrollabile se più alto dello schermo */
      .modal { width: 100%; max-width: 640px; background: var(--c-bg); border: 1px solid var(--c-line); padding: 1.75rem; position: relative; margin: auto; }
      .modal h2 { font-family: var(--font-title); font-size: 1.6rem; letter-spacing: 0.04em; margin-bottom: 1.25rem; }
      .m-close { position: absolute; top: 0.8rem; right: 1rem; background: none; border: none; color: var(--c-muted); font-size: 1.6rem; cursor: pointer; line-height: 1; }
      .m-close:hover { color: var(--c-text); }

      .f-lab { display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); margin: 1.1rem 0 0.4rem; }
      .f-lab:first-of-type { margin-top: 0; }
      .f-input, .f-area {
        width: 100%; background: var(--c-card); border: 1px solid var(--c-line);
        color: var(--c-text); font-family: var(--font-body); font-size: 0.95rem;
        padding: 0.65rem 0.85rem; border-radius: 8px; transition: border-color 0.2s;
      }
      .f-input::placeholder, .f-area::placeholder { color: var(--c-muted); opacity: 0.7; }
      .f-input:focus, .f-area:focus { outline: none; border-color: var(--c-accent); }
      .f-area { min-height: 90px; resize: vertical; }
      .f-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
      .f-row--img { grid-template-columns: 1fr auto; align-items: center; }
      .picks--lang { margin-bottom: 0.2rem; }
      .picks--lang .pick { min-width: 56px; text-align: center; font-size: 0.9rem; }
      .f-hint { font-size: 0.72rem; color: var(--c-muted); margin-top: 0.3rem; }

      /* Pillole selezionabili (pagine, giorni, programmazione) */
      .picks { display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .pick {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-size: 0.82rem; font-weight: 700; padding: 0.4rem 0.85rem; cursor: pointer;
        border-radius: 999px; user-select: none;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .pick:hover { border-color: var(--c-accent); }
      .pick.is-on { background: var(--c-accent); border-color: var(--c-accent); color: #231f20; }

      .sched-block { display: none; margin-top: 0.8rem; }
      .sched-block.is-visible { display: block; }
      .f-date { cursor: pointer; }

      /* Modale coupon: più largo e con più aria fra le sezioni (solo qui) */
      #cp-overlay .modal { max-width: 780px; padding: 2.25rem; }
      #cp-overlay .f-lab { margin-top: 1.75rem; }
      #cp-overlay .f-lab:first-of-type { margin-top: 0; }
      #cp-overlay .f-row { margin-top: 1.75rem; gap: 1.5rem; }
      #cp-overlay .f-row .f-lab { margin-top: 0; }
      #cp-overlay .picks { gap: 0.5rem; margin-top: 0.2rem; }
      #cp-overlay .sched-block { margin-top: 1.2rem; }
      #cp-overlay .f-hint { margin-top: 0.1rem; }
      #cp-overlay .m-foot { margin-top: 2.4rem; }

      /* --- Datepicker custom (brand, come Réglages) --- */
      .dp-panel {
        position: fixed; z-index: 320; width: 308px;
        background: var(--c-card); border: 1px solid var(--c-line);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55); padding: 0.9rem;
      }
      .dp-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
      .dp-title { font-family: var(--font-title); font-size: 1.15rem; letter-spacing: 0.04em; text-transform: capitalize; }
      .dp-nav {
        width: 40px; height: 40px; background: transparent; border: 1px solid var(--c-line);
        color: var(--c-text); font-size: 1.3rem; cursor: pointer; border-radius: 50%;
        transition: border-color 0.15s, color 0.15s;
      }
      .dp-nav:hover:not(:disabled) { border-color: var(--c-accent); color: var(--c-accent); }
      .dp-nav:disabled { opacity: 0.3; cursor: not-allowed; }
      .dp-dow { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 0.2rem; }
      .dp-dow span { text-align: center; font-size: 0.7rem; color: var(--c-muted); text-transform: uppercase; padding: 0.2rem 0; }
      .dp-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
      .dp-cell {
        aspect-ratio: 1; min-height: 40px; display: flex; align-items: center; justify-content: center;
        background: transparent; border: none; color: var(--c-text); font-family: var(--font-body);
        font-size: 0.95rem; cursor: pointer; border-radius: 50%;
        transition: background 0.15s, color 0.15s;
      }
      .dp-cell:hover:not(:disabled):not(.dp-vuota):not(.dp-sel) { background: var(--c-line); }
      .dp-vuota { cursor: default; }
      .dp-off { color: #5d5555; cursor: not-allowed; }
      .dp-today { box-shadow: inset 0 0 0 1px var(--c-accent); }
      .dp-sel { background: var(--c-accent); color: #231f20; font-weight: 700; }
      @media (pointer: coarse) {
        .dp-panel { width: 340px; }
        .dp-cell { min-height: 44px; font-size: 1.05rem; }
      }

      .m-foot { display: flex; align-items: center; gap: 1rem; margin-top: 1.6rem; }
      .m-save {
        background: var(--c-accent); border: 1px solid var(--c-accent); color: #231f20;
        font-family: var(--font-title); font-size: 1.1rem; letter-spacing: 0.05em;
        padding: 0.6rem 1.6rem; cursor: pointer; border-radius: 999px;
        transition: filter 0.2s;
      }
      .m-save:hover { filter: brightness(1.1); }
      .m-save:disabled { opacity: 0.5; cursor: wait; }
      .m-err { color: #ff6b6b; font-size: 0.85rem; }

      /* Newsletter */
      .n-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-bottom: 1.25rem; }
      @media (max-width: 720px) { .n-stats { grid-template-columns: 1fr; } }
      .n-stat { background: var(--c-card); border: 1px solid var(--c-line); padding: 1.3rem 1.5rem; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28); }
      .n-stat-lab { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); margin-bottom: 0.5rem; }
      .n-stat-big { font-family: var(--font-title); font-size: 2.4rem; line-height: 1; color: var(--c-accent); }
      .n-stat-sub { font-size: 1.1rem; color: var(--c-muted); margin-left: 0.4rem; }
      .n-stat-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
      .n-stat-note { display: block; color: var(--c-muted); font-size: 0.78rem; margin-top: 0.5rem; }
      .c-packs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
      .c-pack {
        display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        padding: 1.1rem 0.8rem; cursor: pointer; border-radius: 12px;
        transition: border-color 0.15s, transform 0.15s;
      }
      .c-pack:hover { border-color: var(--c-accent); transform: scale(0.98); }
      .c-pack.is-on { border-color: var(--c-accent); background: rgba(223, 171, 78, 0.12); }
      .c-pack:disabled { opacity: 0.5; cursor: wait; }
      .c-pack-n { font-family: var(--font-title); font-size: 1.6rem; letter-spacing: 0.03em; color: var(--c-accent); }
      .c-pack-p { font-size: 0.9rem; font-weight: 700; }
      .n-htitle { font-family: var(--font-title); font-size: 1.5rem; letter-spacing: 0.04em; color: var(--c-accent); margin-bottom: 0.8rem; }
      .n-row { display: flex; align-items: baseline; gap: 0.9rem; background: var(--c-card); border: 1px solid var(--c-line); padding: 0.8rem 1.2rem; margin-bottom: 0.4rem; }
      .n-row-subject { flex: 1; font-weight: 700; }
      .n-row-count { font-family: var(--font-title); font-size: 1.1rem; color: var(--c-accent); white-space: nowrap; }
      .n-row-date { color: var(--c-muted); font-size: 0.82rem; white-space: nowrap; }
      .m-save.confirm { background: #a3320f; border-color: #a3320f; color: #fff; }

      /* Toast */
      .toast {
        position: fixed; left: 50%; bottom: 6rem; transform: translateX(-50%) translateY(20px);
        background: var(--c-card); border: 1px solid var(--c-accent); color: var(--c-text);
        padding: 0.7rem 1.3rem; border-radius: 999px; font-size: 0.9rem;
        opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.25s; z-index: 400;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
      }
      .toast.is-visible { opacity: 1; transform: translateX(-50%) translateY(0); }
      .toast.is-error { border-color: #ed1c24; }

      @media (max-width: 640px) {
        main { padding: 1.5rem 1rem 8rem; }
        .f-row { grid-template-columns: 1fr; }
      }
      /* Loader dentro i bottoni di salvataggio */
      .is-loading { position: relative; color: transparent !important; pointer-events: none; }
      .is-loading::after {
        content: ""; position: absolute; inset: 0; margin: auto;
        width: 18px; height: 18px; border-radius: 50%;
        border: 2px solid rgba(35, 31, 32, 0.3); border-top-color: #231f20;
        animation: btnspin 0.7s linear infinite;
      }
      @keyframes btnspin { to { transform: rotate(360deg); } }
    </style>
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <h1><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11v3" /><path d="M7 9v7" /><path d="M7 9l10-5v16l-10-5" /><path d="M17 8.5a4 4 0 0 1 0 7" /><path d="M9.5 16.5 11 21" /></svg>Marketing</h1>

        <div class="mtabs" id="mtabs">
          <button class="mtab is-active" data-tab="popup">Pop-up</button>
          <button class="mtab" data-tab="news">Newsletter</button>
          <button class="mtab" data-tab="coupons">Coupons</button>
        </div>

        <div class="state" id="state">Chargement…</div>

        <div id="tab-popup" style="display:none">
          <div class="actionsbar">
            <button class="pill" id="add-btn">+ Nouveau pop-up</button>
          </div>
          <div class="state" id="empty" style="display:none">
            Aucun pop-up pour le moment. Créez-en un&nbsp;: il apparaîtra sur les pages choisies.
          </div>
          <div class="pops" id="pops"></div>
        </div>

        <div id="tab-coupons" style="display:none">
          <div class="actionsbar">
            <button class="pill" id="cp-add">+ Nouveau coupon</button>
          </div>
          <div class="state" id="cp-empty" style="display:none">
            Aucun coupon pour le moment. Créez-en un&nbsp;: le client pourra le saisir au paiement.
          </div>
          <div class="pops" id="coupons"></div>
        </div>

        <div id="tab-news" style="display:none">
          <div class="n-stats">
            <div class="n-stat">
              <div class="n-stat-lab">Envoyées ce mois-ci</div>
              <div class="n-stat-big"><span id="n-sent">—</span><span class="n-stat-sub">/ 1000</span></div>
            </div>
            <div class="n-stat">
              <div class="n-stat-lab">Envois restants</div>
              <div class="n-stat-row">
                <div class="n-stat-big" id="n-remaining">—</div>
                <button class="pill" id="c-buy" type="button">+ Ajouter des crédits</button>
              </div>
              <span class="n-stat-note" id="n-purchased"></span>
            </div>
            <div class="n-stat">
              <div class="n-stat-lab">Destinataires</div>
              <div class="n-stat-big" id="n-recipients">—</div>
            </div>
          </div>

          <div class="actionsbar">
            <button class="pill" id="n-add">+ Nouvelle newsletter</button>
          </div>

          <h2 class="n-htitle">Derniers envois</h2>
          <div class="state" id="n-hempty" style="display:none">Aucun envoi pour le moment.</div>
          <div class="n-history" id="n-history"></div>
        </div>
      </main>
      <AdminFooter />
    </div>

    <!-- Modale creazione/modifica -->
    <div class="overlay" id="overlay">
      <div class="modal">
        <button class="m-close" id="m-close" type="button" aria-label="Fermer">×</button>
        <h2 id="m-title">Nouveau pop-up</h2>

        <div class="picks picks--lang" id="f-lang">
          <span class="pick is-on" data-l="fr">FR</span>
          <span class="pick" data-l="en">EN</span>
        </div>
        <p class="f-hint" style="margin:0.4rem 0 0.9rem">
          Le pop-up n'apparaît sur une version du site que si le titre de cette
          langue est rempli.
        </p>

        <label class="f-lab" for="f-img">Image</label>
        <div class="f-row f-row--img">
          <input type="text" class="f-input" id="f-img" placeholder="https://… ou téléversez un fichier →" />
          <button class="pill" id="f-upload" type="button">Téléverser</button>
          <button class="pill" id="f-lib" type="button">Bibliothèque</button>
          <input type="file" id="f-file" accept="image/*" style="display:none" />
        </div>
        <p class="f-hint" id="f-upload-state"></p>

        <div id="panel-fr">
          <label class="f-lab" for="f-title">Titre</label>
          <input type="text" class="f-input" id="f-title" placeholder="Ex. Fermeture exceptionnelle, Menu de Noël…" />

          <label class="f-lab" for="f-body">Texte</label>
          <textarea class="f-area" id="f-body" placeholder="Le message du pop-up (facultatif)"></textarea>

          <label class="f-lab">Bouton 1 (facultatif)</label>
          <div class="f-row">
            <input type="text" class="f-input" id="f-b1l" placeholder="Label — ex. Réserver" />
            <input type="text" class="f-input" id="f-b1u" placeholder="Lien — https://…, /order ou #reserver" />
            <button class="pill asset-pick" type="button" data-target="f-b1u" title="Choisir un asset (image ou PDF)">Assets</button>
          </div>

          <label class="f-lab">Bouton 2 (facultatif)</label>
          <div class="f-row">
            <input type="text" class="f-input" id="f-b2l" placeholder="Label" />
            <input type="text" class="f-input" id="f-b2u" placeholder="Lien" />
            <button class="pill asset-pick" type="button" data-target="f-b2u" title="Choisir un asset (image ou PDF)">Assets</button>
          </div>
          <p class="f-hint">Astuce&nbsp;: le lien <strong>#reserver</strong> ouvre le module de réservation.</p>
        </div>

        <div id="panel-en" style="display:none">
          <label class="f-lab" for="f-title-en">Title</label>
          <input type="text" class="f-input" id="f-title-en" placeholder="Ex. Exceptional closure, Christmas menu…" />

          <label class="f-lab" for="f-body-en">Text</label>
