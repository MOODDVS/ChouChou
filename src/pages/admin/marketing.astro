            fUploadState.textContent = "Erreur de connexion";
          } finally {
            fUpload.disabled = false;
            fFile.value = "";
          }
        });

        document.getElementById("add-btn")!.addEventListener("click", () => apriModale(null));
        document.getElementById("m-close")!.addEventListener("click", chiudiModale);
