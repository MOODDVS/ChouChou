    <div class="toast" id="toast"></div>

    <ImagePicker />

    <AdminNav current="marketing" />

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { comprimiFoto } from "../../lib/admin/imageCompress";
      import { isSuper } from "../../lib/admin/superAdmin";

      type Popup = {
        id: string;
        title: string | null;
        body: string | null;
        image_url: string | null;
        btn1_label: string | null;
        btn1_url: string | null;
        btn2_label: string | null;
        btn2_url: string | null;
        title_en: string | null;
        body_en: string | null;
        btn1_label_en: string | null;
        btn2_label_en: string | null;
        pages: string[];
        active: boolean;
        schedule_kind: "always" | "dates" | "weekly";
        date_start: string | null;
        date_end: string | null;
        days: number[] | null;
        hour_start: string | null;
        hour_end: string | null;
        max_shows: number;
      };

      const PAGINE: { k: string; label: string }[] = [
        { k: "home", label: "Accueil" },
        { k: "menu", label: "Notre Carte" },
        { k: "order", label: "Commander" },
        { k: "ambiance", label: "Ambiance" },
        { k: "contact", label: "Contact" },
        { k: "links", label: "Links" },
      ];
      const GIORNI: { n: number; label: string }[] = [
        { n: 1, label: "Lun" }, { n: 2, label: "Mar" }, { n: 3, label: "Mer" },
        { n: 4, label: "Jeu" }, { n: 5, label: "Ven" }, { n: 6, label: "Sam" }, { n: 0, label: "Dim" },
      ];
      const ICO_TRASH =
        '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /></svg>';
      const ICO_PEN = "✎";

      function esc(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const tabPopup = document.getElementById("tab-popup") as HTMLDivElement;
        const popsEl = document.getElementById("pops") as HTMLDivElement;
        const emptyEl = document.getElementById("empty") as HTMLDivElement;
        const toastEl = document.getElementById("toast") as HTMLDivElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        const headers = {
          Authorization: `Bearer ${session.access_token ?? ""}`,
          "Content-Type": "application/json",
        };

        let toastTimer: number | undefined;
        function toast(msg: string, isErr = false) {
          toastEl.textContent = msg;
          toastEl.classList.toggle("is-error", isErr);
          toastEl.classList.add("is-visible");
          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => toastEl.classList.remove("is-visible"), 2600);
        }

        // ---------- Lista ----------
        let popups: Popup[] = [];

        function riassuntoProgramma(p: Popup): string {
          if (p.schedule_kind === "dates") {
            const f = (d: string | null) => (d ? d.split("-").reverse().join("/") : "?");
            return `${f(p.date_start)} → ${f(p.date_end)}`;
          }
          if (p.schedule_kind === "weekly") {
            const nomi = GIORNI.filter((g) => (p.days ?? []).includes(g.n)).map((g) => g.label).join(", ");
            const hh = (h: string | null) => String(h ?? "").slice(0, 5);
            return `${nomi} · ${hh(p.hour_start)}–${hh(p.hour_end)}`;
          }
          return "Indéfini";
        }

        function render() {
          if (popups.length === 0) {
            popsEl.innerHTML = "";
            emptyEl.style.display = "block";
            return;
          }
          emptyEl.style.display = "none";
          popsEl.innerHTML = popups
            .map((p) => {
              const pagine = PAGINE.filter((x) => p.pages.includes(x.k)).map((x) => x.label).join(" · ");
              const lingue =
                (p.title ? `<span class="m-tag">FR</span>` : "") +
                (p.title_en ? `<span class="m-tag">EN</span>` : "");
              return `
              <div class="pop${p.active ? "" : " is-off"}" data-id="${p.id}">
                <div class="pop-top">
                  <div class="pop-title">${esc(p.title || p.title_en || "")}</div>
                </div>
                ${p.body ? `<div class="pop-text">${esc(p.body)}</div>` : ""}
                <div class="pop-meta">
                  <span class="m-tag gold">${esc(pagine)}</span>
                  ${lingue}
                  <span class="m-tag">${esc(riassuntoProgramma(p))}</span>
                  <span class="m-tag">${p.max_shows}× max</span>
                </div>
                <div class="pop-actions">
                  <span class="sw-wrap">
                    <label class="switch"><input type="checkbox" class="t-active" ${p.active ? "checked" : ""} /><span class="track"></span></label>
                    <span class="sw-lab">${p.active ? "Actif" : "Inactif"}</span>
                  </span>
                  <button class="i-btn i-edit" title="Modifier">${ICO_PEN}</button>
                  <button class="i-btn i-del" title="Supprimer">${ICO_TRASH}</button>
                </div>
              </div>`;
            })
            .join("");
        }

        // ---------- Tabs Pop-up / Newsletter ----------
        const tabNews = document.getElementById("tab-news") as HTMLDivElement;
        const tabCoupons = document.getElementById("tab-coupons") as HTMLDivElement;
        const mtabs = document.getElementById("mtabs") as HTMLDivElement;
        let tabAttivo = "popup";

        function mostraTab(t: string) {
          tabAttivo = t;
          mtabs.querySelectorAll<HTMLElement>(".mtab").forEach((el) =>
            el.classList.toggle("is-active", el.dataset.tab === t)
          );
          tabPopup.style.display = t === "popup" ? "block" : "none";
          tabNews.style.display = t === "news" ? "block" : "none";
          tabCoupons.style.display = t === "coupons" ? "block" : "none";
        }
        mtabs.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".mtab") as HTMLElement | null;
          if (!el) return;
          mostraTab(el.dataset.tab ?? "popup");
          if (el.dataset.tab === "news") caricaNews();
          if (el.dataset.tab === "coupons") caricaCoupons();
        });

        // Super vede tutti i tab; agli altri nascondi quelli disattivati (super admin).
        if (!isSuper(session.user.email ?? "")) {
          try {
            const rp = await fetch("/api/admin/pages", { headers });
            if (rp.ok) {
              const { hiddenTabs } = (await rp.json()) as { hiddenTabs?: string[] };
              const nasc = (hiddenTabs ?? [])
                .filter((k) => k.startsWith("marketing:"))
                .map((k) => k.slice("marketing:".length));
              for (const tk of nasc) {
                mtabs.querySelector(`.mtab[data-tab="${tk}"]`)?.remove();
                document.getElementById("tab-" + tk)?.remove();
              }
              // Se il tab attivo/di default è stato tolto, passa al primo visibile
              if (!mtabs.querySelector(`.mtab[data-tab="${tabAttivo}"]`)) {
                const primo = mtabs.querySelector<HTMLElement>(".mtab");
                if (primo) tabAttivo = primo.dataset.tab ?? "popup";
              }
            }
          } catch {
            /* rete assente: mostra tutto */
          }
        }

        async function carica() {
          try {
            const res = await fetch("/api/admin/popups", { headers });
            if (!res.ok) {
              stateEl.textContent = "Erreur de chargement.";
              return;
            }
            popups = ((await res.json()) as { popups: Popup[] }).popups;
            stateEl.style.display = "none";
            mostraTab(tabAttivo);
            render();
          } catch {
            stateEl.textContent = "Erreur de connexion.";
          }
        }

        // ---------- Modale ----------
        const overlay = document.getElementById("overlay") as HTMLDivElement;
        const mTitle = document.getElementById("m-title") as HTMLHeadingElement;
        const mErr = document.getElementById("m-err") as HTMLSpanElement;
        const mSave = document.getElementById("m-save") as HTMLButtonElement;
        const fTitle = document.getElementById("f-title") as HTMLInputElement;
        const fBody = document.getElementById("f-body") as HTMLTextAreaElement;
        const fImg = document.getElementById("f-img") as HTMLInputElement;
        const fB1l = document.getElementById("f-b1l") as HTMLInputElement;
        const fB1u = document.getElementById("f-b1u") as HTMLInputElement;
        const fB2l = document.getElementById("f-b2l") as HTMLInputElement;
        const fB2u = document.getElementById("f-b2u") as HTMLInputElement;
        const fTitleEn = document.getElementById("f-title-en") as HTMLInputElement;
        const fBodyEn = document.getElementById("f-body-en") as HTMLTextAreaElement;
        const fB1lEn = document.getElementById("f-b1l-en") as HTMLInputElement;
        const fB2lEn = document.getElementById("f-b2l-en") as HTMLInputElement;
        const fPages = document.getElementById("f-pages") as HTMLDivElement;
        const fKind = document.getElementById("f-kind") as HTMLDivElement;
        const fDays = document.getElementById("f-days") as HTMLDivElement;
        const fDs = document.getElementById("f-ds") as HTMLInputElement;
        const fDe = document.getElementById("f-de") as HTMLInputElement;
        const fHs = document.getElementById("f-hs") as HTMLInputElement;
        const fHe = document.getElementById("f-he") as HTMLInputElement;
        const fMax = document.getElementById("f-max") as HTMLInputElement;
        const fActive = document.getElementById("f-active") as HTMLInputElement;
        const schedDates = document.getElementById("sched-dates") as HTMLDivElement;
        const schedWeekly = document.getElementById("sched-weekly") as HTMLDivElement;

        let editId: string | null = null;

        // Tab lingua FR/EN del form
        const fLang = document.getElementById("f-lang") as HTMLDivElement;
        const panelFr = document.getElementById("panel-fr") as HTMLDivElement;
        const panelEn = document.getElementById("panel-en") as HTMLDivElement;
        function mostraLingua(l: string) {
          fLang.querySelectorAll<HTMLElement>(".pick").forEach((el) =>
            el.classList.toggle("is-on", el.dataset.l === l)
          );
          panelFr.style.display = l === "fr" ? "block" : "none";
          panelEn.style.display = l === "en" ? "block" : "none";
        }
        fLang.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (el) mostraLingua(el.dataset.l ?? "fr");
        });

        // Pillole pagine e giorni
        fPages.innerHTML = PAGINE.map((p) => `<span class="pick" data-p="${p.k}">${p.label}</span>`).join("");
        fDays.innerHTML = GIORNI.map((g) => `<span class="pick" data-d="${g.n}">${g.label}</span>`).join("");
        [fPages, fDays].forEach((box) =>
          box.addEventListener("click", (e) => {
            const el = (e.target as HTMLElement).closest(".pick");
            if (el) el.classList.toggle("is-on");
          })
        );

        function kindAttivo(): string {
          return (fKind.querySelector(".pick.is-on") as HTMLElement)?.dataset.k ?? "always";
        }
        fKind.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (!el) return;
          fKind.querySelectorAll(".pick").forEach((x) => x.classList.remove("is-on"));
          el.classList.add("is-on");
          schedDates.classList.toggle("is-visible", el.dataset.k === "dates");
          schedWeekly.classList.toggle("is-visible", el.dataset.k === "weekly");
        });

        function apriModale(p: Popup | null) {
          editId = p?.id ?? null;
          mTitle.textContent = p ? "Modifier le pop-up" : "Nouveau pop-up";
          mErr.textContent = "";
          fUploadState.textContent = "";
          mostraLingua("fr");
          fTitle.value = p?.title ?? "";
          fBody.value = p?.body ?? "";
          fImg.value = p?.image_url ?? "";
          fB1l.value = p?.btn1_label ?? "";
