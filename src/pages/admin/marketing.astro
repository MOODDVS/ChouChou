        const fPages = document.getElementById("f-pages") as HTMLDivElement;
        const fKind = document.getElementById("f-kind") as HTMLDivElement;
        const fDays = document.getElementById("f-days") as HTMLDivElement;
        const fDs = document.getElementById("f-ds") as HTMLInputElement;
        const fDe = document.getElementById("f-de") as HTMLInputElement;
        const fHs = document.getElementById("f-hs") as HTMLInputElement;
        const fHe = document.getElementById("f-he") as HTMLInputElement;
        const fMax = document.getElementById("f-max") as HTMLInputElement;
        const fActive = document.getElementById("f-active") as HTMLInputElement;
        const schedDates = document.getElementById("sched-dates") as HTMLDivElement;
        const schedWeekly = document.getElementById("sched-weekly") as HTMLDivElement;

        let editId: string | null = null;

        // Tab lingua del form: generati dalle LINGUE PUBBLICHE (super admin)
        const fLang = document.getElementById("f-lang") as HTMLDivElement;
        type PubLangs = { langs: string[]; def: string; labels: Record<string, { label: string; flag: string }> };
        let PUB: PubLangs = { langs: ["fr"], def: "fr", labels: { fr: { label: "Fran\u00e7ais", flag: "" } } };
        try { const raw = document.getElementById("pub-langs")?.textContent?.trim(); if (raw) PUB = JSON.parse(raw) as PubLangs; } catch { /* fallback */ }
        const ordineLang = () => [PUB.def, ...PUB.langs.filter((l) => l !== PUB.def)];
        function costruisciLingue() {
          const ord = ordineLang();
          fLang.innerHTML = ord
            .map((l, i) => `<span class="pick${i === 0 ? " is-on" : ""}" data-l="${esc(l)}">${esc(PUB.labels[l]?.flag ?? "")} ${esc(l.toUpperCase())}</span>`)
            .join("");
          fPanels.innerHTML = ord
            .map((l, i) => {
              const T = esc(l.toUpperCase());
              return `<div class="pop-lang" data-lang="${esc(l)}" style="display:${i === 0 ? "block" : "none"}">` +
                `<label class="f-lab">${esc(tr("mk.title"))} (${T})</label>` +
                `<input type="text" class="f-input f-tx" data-lang="${esc(l)}" placeholder="${i === 0 ? esc(tr("mk.titlePh")) : ""}" />` +
                `<label class="f-lab">${esc(tr("mk.text"))} (${T})</label>` +
                `<textarea class="f-area f-bx" data-lang="${esc(l)}"></textarea>` +
                `<label class="f-lab">${esc(tr("mk.btn1Opt"))} (${T})</label>` +
                `<input type="text" class="f-input f-b1lx" data-lang="${esc(l)}" placeholder="${i === 0 ? esc(tr("mk.btnLabelReservePh")) : esc(tr("mk.labelPh"))}" />` +
                `<div class="f-row f-row-btnu">` +
                  `<input type="text" class="f-input f-b1u" data-lang="${esc(l)}" placeholder="${esc(tr("mk.btnLinkPh"))}" />` +
                  `<button class="pill asset-pop" type="button" data-cls="f-b1u" title="${esc(tr("mk.chooseAsset"))}">${esc(tr("nav.assets"))}</button>` +
                `</div>` +
                `<label class="f-lab">${esc(tr("mk.btn2Opt"))} (${T})</label>` +
                `<input type="text" class="f-input f-b2lx" data-lang="${esc(l)}" placeholder="${esc(tr("mk.labelPh"))}" />` +
                `<div class="f-row f-row-btnu">` +
                  `<input type="text" class="f-input f-b2u" data-lang="${esc(l)}" placeholder="${esc(tr("mk.linkPh"))}" />` +
                  `<button class="pill asset-pop" type="button" data-cls="f-b2u" title="${esc(tr("mk.chooseAsset"))}">${esc(tr("nav.assets"))}</button>` +
                `</div>` +
                `</div>`;
            })
            .join("");
        }
        costruisciLingue();
        function mostraLingua(l: string) {
          fLang.querySelectorAll<HTMLElement>(".pick").forEach((el) => el.classList.toggle("is-on", el.dataset.l === l));
          fPanels.querySelectorAll<HTMLElement>(".pop-lang").forEach((p) => { p.style.display = p.dataset.lang === l ? "block" : "none"; });
        }
        function raccogliI18n(sel: string): Record<string, string> {
          const o: Record<string, string> = {};
          fPanels.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(sel).forEach((el) => { const v = el.value.trim(); if (v) o[el.dataset.lang ?? ""] = v; });
          return o;
        }
        fLang.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (el) mostraLingua(el.dataset.l ?? PUB.def);
        });

        // Pillole pagine e giorni
        fPages.innerHTML = PAGINE.map((p) => `<span class="pick" data-p="${p.k}">${p.label}</span>`).join("");
        fDays.innerHTML = GIORNI.map((g) => `<span class="pick" data-d="${g.n}">${g.label}</span>`).join("");
        [fPages, fDays].forEach((box) =>
          box.addEventListener("click", (e) => {
            const el = (e.target as HTMLElement).closest(".pick");
            if (el) el.classList.toggle("is-on");
          })
        );

        function kindAttivo(): string {
          return (fKind.querySelector(".pick.is-on") as HTMLElement)?.dataset.k ?? "always";
        }
        fKind.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (!el) return;
          fKind.querySelectorAll(".pick").forEach((x) => x.classList.remove("is-on"));
          el.classList.add("is-on");
          schedDates.classList.toggle("is-visible", el.dataset.k === "dates");
          schedWeekly.classList.toggle("is-visible", el.dataset.k === "weekly");
        });

        function apriModale(p: Popup | null) {
          editId = p?.id ?? null;
          mTitle.textContent = p ? tr("mk.editPopup") : tr("mk.newPopup");
          mErr.textContent = "";
          fUploadState.textContent = "";
          costruisciLingue();
          mostraLingua(PUB.def);
          const ti = p?.title_i18n ?? {};
          const bi = p?.body_i18n ?? {};
          const b1i = p?.btn1_label_i18n ?? {};
          const b2i = p?.btn2_label_i18n ?? {};
          fPanels.querySelectorAll<HTMLInputElement>(".f-tx").forEach((el) => { const l = el.dataset.lang ?? ""; el.value = ti[l] ?? (l === "fr" ? (p?.title ?? "") : l === "en" ? (p?.title_en ?? "") : ""); });
          fPanels.querySelectorAll<HTMLTextAreaElement>(".f-bx").forEach((el) => { const l = el.dataset.lang ?? ""; el.value = bi[l] ?? (l === "fr" ? (p?.body ?? "") : l === "en" ? (p?.body_en ?? "") : ""); });
          fPanels.querySelectorAll<HTMLInputElement>(".f-b1lx").forEach((el) => { const l = el.dataset.lang ?? ""; el.value = b1i[l] ?? (l === "fr" ? (p?.btn1_label ?? "") : l === "en" ? (p?.btn1_label_en ?? "") : ""); });
          fPanels.querySelectorAll<HTMLInputElement>(".f-b2lx").forEach((el) => { const l = el.dataset.lang ?? ""; el.value = b2i[l] ?? (l === "fr" ? (p?.btn2_label ?? "") : l === "en" ? (p?.btn2_label_en ?? "") : ""); });
          fImg.value = p?.image_url ?? "";
          renderFotoPop();
          setPos(p?.position ?? "center");
          setBtnU("f-b1u", p?.btn1_url ?? "");
          setBtnU("f-b2u", p?.btn2_url ?? "");
          fMax.value = String(p?.max_shows ?? 3);
          fActive.checked = p ? p.active : true;
          fDs.dataset.iso = p?.date_start ?? "";
          fDs.value = p?.date_start ? fmtFr(p.date_start) : "";
          fDe.dataset.iso = p?.date_end ?? "";
          fDe.value = p?.date_end ? fmtFr(p.date_end) : "";
          fHs.value = String(p?.hour_start ?? "").slice(0, 5);
          fHe.value = String(p?.hour_end ?? "").slice(0, 5);

          const pagineOn = p?.pages ?? ["home"];
          fPages.querySelectorAll<HTMLElement>(".pick").forEach((el) =>
            el.classList.toggle("is-on", pagineOn.includes(el.dataset.p ?? ""))
          );
          const giorniOn = p?.days ?? [];
          fDays.querySelectorAll<HTMLElement>(".pick").forEach((el) =>
            el.classList.toggle("is-on", giorniOn.includes(Number(el.dataset.d)))
          );
          const kind = p?.schedule_kind ?? "always";
          fKind.querySelectorAll<HTMLElement>(".pick").forEach((el) =>
            el.classList.toggle("is-on", el.dataset.k === kind)
          );
          schedDates.classList.toggle("is-visible", kind === "dates");
          schedWeekly.classList.toggle("is-visible", kind === "weekly");

          overlay.classList.add("is-open");
        }
        function chiudiModale() {
          overlay.classList.remove("is-open");
        }

        // ---------- Datepicker custom (brand, come Réglages) ----------
        const MESI = Array.from({ length: 12 }, (_, m) => new Date(2000, m, 1).toLocaleDateString(LOC, { month: "long" }));
        const DOW = tr("res.dowInitials").split(",");
        let dpTarget: HTMLInputElement | null = null;
        let dpAnno = 0;
        let dpMese = 0; // 0-11
        const dpPanel = document.createElement("div");
        dpPanel.className = "dp-panel";
        dpPanel.style.display = "none";
        document.body.appendChild(dpPanel);

        function isoOggi(): string {
          const d = new Date();
          return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
        }
        function isoDi(y: number, m: number, g: number): string {
          return `${y}-${String(m + 1).padStart(2, "0")}-${String(g).padStart(2, "0")}`;
        }
        function fmtFr(iso: string): string {
          const [y, m, d] = iso.split("-");
          return `${d}/${m}/${y}`;
        }
        function dpRender() {
          const oggi = isoOggi();
          const sel = dpTarget?.dataset.iso ?? "";
          const offset = (new Date(dpAnno, dpMese, 1).getDay() + 6) % 7; // lunedì=0
          const nGiorni = new Date(dpAnno, dpMese + 1, 0).getDate();
          const oy = Number(oggi.slice(0, 4));
          const om = Number(oggi.slice(5, 7)) - 1;
          const prevOff = dpAnno < oy || (dpAnno === oy && dpMese <= om);
          let celle = "";
          for (let i = 0; i < offset; i++) celle += '<span class="dp-cell dp-vuota"></span>';
          for (let g = 1; g <= nGiorni; g++) {
            const iso = isoDi(dpAnno, dpMese, g);
            const cls = ["dp-cell"];
            if (iso < oggi) cls.push("dp-off");
            if (iso === oggi) cls.push("dp-today");
            if (iso === sel) cls.push("dp-sel");
            celle += `<button type="button" class="${cls.join(" ")}" data-iso="${iso}" ${iso < oggi ? "disabled" : ""}>${g}</button>`;
          }
          dpPanel.innerHTML = `
            <div class="dp-head">
              <button type="button" class="dp-nav" data-nav="-1" ${prevOff ? "disabled" : ""}>‹</button>
              <span class="dp-title">${MESI[dpMese]} ${dpAnno}</span>
              <button type="button" class="dp-nav" data-nav="1">›</button>
            </div>
            <div class="dp-dow">${DOW.map((g) => `<span>${g}</span>`).join("")}</div>
            <div class="dp-grid">${celle}</div>`;
        }
        function dpApri(target: HTMLInputElement) {
          dpTarget = target;
          const base = target.dataset.iso || isoOggi();
          dpAnno = Number(base.slice(0, 4));
          dpMese = Number(base.slice(5, 7)) - 1;
          dpRender();
          dpPanel.style.display = "block";
          const r = target.getBoundingClientRect();
          const pw = dpPanel.offsetWidth || 308;
          const ph = dpPanel.offsetHeight || 360;
          dpPanel.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - pw - 8))}px`;
          dpPanel.style.top = `${Math.max(8, Math.min(r.bottom + 6, window.innerHeight - ph - 8))}px`;
        }
        function dpChiudi() {
          dpPanel.style.display = "none";
          dpTarget = null;
        }
        dpPanel.addEventListener("click", (e) => {
          e.stopPropagation();
          const t = e.target as HTMLElement;
          if (t.classList.contains("dp-nav")) {
            dpMese += Number(t.dataset.nav);
            if (dpMese < 0) { dpMese = 11; dpAnno--; }
            if (dpMese > 11) { dpMese = 0; dpAnno++; }
            dpRender();
            return;
          }
          if (t.classList.contains("dp-cell") && t.dataset.iso && dpTarget) {
            const iso = t.dataset.iso;
            dpTarget.dataset.iso = iso;
            dpTarget.value = fmtFr(iso);
            // se la fine manca o è prima dell'inizio, allineala
            const fromIso = fDs.dataset.iso ?? "";
            const toIso = fDe.dataset.iso ?? "";
            if (dpTarget === fDs && (!toIso || toIso < fromIso)) {
              fDe.dataset.iso = iso;
              fDe.value = fmtFr(iso);
            }
            dpChiudi();
          }
        });
        [fDs, fDe].forEach((el) => {
          el.addEventListener("click", (e) => {
            e.stopPropagation();
            dpApri(el);
          });
        });
        document.addEventListener("click", (e) => {
          if (dpPanel.style.display !== "none" && !dpPanel.contains(e.target as Node)) dpChiudi();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") dpChiudi();
        });

        // ---------- Upload immagine (Supabase Storage via API) ----------
        const fUpload = document.getElementById("f-upload") as HTMLButtonElement;
        const fFile = document.getElementById("f-file") as HTMLInputElement;
        const fUploadState = document.getElementById("f-upload-state") as HTMLElement;
        const fImgPrev = document.getElementById("f-img-prev") as HTMLSpanElement;
        const fImgDel = document.getElementById("f-img-del") as HTMLButtonElement;
        const ICO_IMG_POP = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>';
        function renderFotoPop() {
          const u = fImg.value.trim();
          fImgPrev.innerHTML = u ? `<img src="${esc(u)}" alt="" />` : ICO_IMG_POP;
          fImgDel.style.display = u ? "" : "none";
        }
        fImgDel.addEventListener("click", () => { fImg.value = ""; renderFotoPop(); });
        const fPos = document.getElementById("f-pos") as HTMLDivElement;
        function setPos(pos: string) { fPos.querySelectorAll<HTMLElement>(".pos-opt").forEach((x) => x.classList.toggle("is-on", x.dataset.pos === (pos || "center"))); }
        function posAttiva(): string { return (fPos.querySelector(".pos-opt.is-on") as HTMLElement | null)?.dataset.pos ?? "center"; }
        fPos.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".pos-opt") as HTMLElement | null;
          if (!b) return;
          fPos.querySelectorAll(".pos-opt").forEach((x) => x.classList.remove("is-on"));
          b.classList.add("is-on");
        });

        fUpload.addEventListener("click", () => fFile.click());
        fFile.addEventListener("change", async () => {
          const file = fFile.files?.[0];
          if (!file) return;
          fUpload.disabled = true;
          fUploadState.textContent = tr("menu.compressing");
          try {
            const foto = await comprimiFoto(file);
            if (foto.size > 4 * 1024 * 1024) {
              fUploadState.textContent = tr("cli.fileTooBig");
              return;
            }
            fUploadState.textContent = tr("cli.uploading");
            const base64 = await new Promise<string>((res, rej) => {
              const r = new FileReader();
              r.onload = () => res(String(r.result).split(",")[1] ?? "");
              r.onerror = () => rej(new Error());
              r.readAsDataURL(foto);
            });
            const resp = await fetch("/api/admin/upload", {
              method: "POST",
              headers,
              body: JSON.stringify({ filename: foto.name, data: base64 }),
            });
            const j = await resp.json();
            if (!resp.ok) {
              fUploadState.textContent = j.error ?? tr("cli.uploadError");
              return;
            }
            fImg.value = j.url;
            renderFotoPop();
            fUploadState.textContent = tr("mk.imgUploaded");
          } catch {
            fUploadState.textContent = tr("res.connErr");
          } finally {
            fUpload.disabled = false;
            fFile.value = "";
          }
        });

        document.getElementById("add-btn")!.addEventListener("click", () => apriModale(null));
        document.getElementById("m-close")!.addEventListener("click", chiudiModale);
        overlay.addEventListener("click", (e) => {
          if (e.target === overlay) chiudiModale();
        });

        mSave.addEventListener("click", async () => {
          mErr.textContent = "";
          const payload = {
            id: editId ?? undefined,
            title_i18n: raccogliI18n(".f-tx"),
            body_i18n: raccogliI18n(".f-bx"),
            btn1_label_i18n: raccogliI18n(".f-b1lx"),
            btn2_label_i18n: raccogliI18n(".f-b2lx"),
            image_url: fImg.value,
            btn1_url: getBtnU("f-b1u"),
            btn2_url: getBtnU("f-b2u"),
            position: posAttiva(),
            pages: Array.from(fPages.querySelectorAll<HTMLElement>(".pick.is-on")).map((el) => el.dataset.p!),
            active: fActive.checked,
            schedule_kind: kindAttivo(),
            date_start: fDs.dataset.iso || null,
            date_end: fDe.dataset.iso || null,
            days: Array.from(fDays.querySelectorAll<HTMLElement>(".pick.is-on")).map((el) => Number(el.dataset.d)),
            hour_start: fHs.value || null,
            hour_end: fHe.value || null,
            max_shows: Number(fMax.value),
          };
          mSave.disabled = true;
          mSave.classList.add("is-loading");
          try {
            const res = await fetch("/api/admin/popups", {
              method: editId ? "PUT" : "POST",
              headers,
              body: JSON.stringify(payload),
            });
            const j = await res.json();
            if (!res.ok) {
              mErr.textContent = j.error ?? tr("ord.errShort");
              return;
            }
            chiudiModale();
            toast(editId ? tr("mk.popupUpdated") : tr("mk.popupCreated"));
            await carica();
          } catch {
            mErr.textContent = tr("res.connErr");
          } finally {
            mSave.disabled = false;
            mSave.classList.remove("is-loading");
          }
        });

        // ---------- Azioni sulle card ----------
        popsEl.addEventListener("click", async (e) => {
          const t = e.target as HTMLElement;
          const card = t.closest(".pop") as HTMLElement | null;
          if (!card) return;
          const id = card.dataset.id!;
          const p = popups.find((x) => x.id === id);
          if (!p) return;

          if (t.closest(".i-edit")) {
            apriModale(p);
            return;
          }

          const del = t.closest(".i-del") as HTMLButtonElement | null;
          if (del) {
            if (!del.classList.contains("confirm")) {
              del.classList.add("confirm");
              del.textContent = tr("common.confirm");
              setTimeout(() => {
                del.classList.remove("confirm");
                del.innerHTML = ICO_TRASH;
              }, 3000);
              return;
            }
            try {
              const res = await fetch("/api/admin/popups?id=" + encodeURIComponent(id), {
                method: "POST",
                headers: { ...headers, "X-Method-Override": "DELETE" },
              });
              if (!res.ok) {
                toast(tr("us.delErr"), true);
                return;
              }
              toast(tr("mk.popupDeleted"));
              await carica();
            } catch {
              toast(tr("res.connErr"), true);
            }
            return;
          }

          const sw = t.closest(".t-active") as HTMLInputElement | null;
          if (sw) {
            try {
              const res = await fetch("/api/admin/popups", {
                method: "PUT",
                headers,
                body: JSON.stringify({ id, active: sw.checked }),
              });
              if (!res.ok) throw new Error();
              p.active = sw.checked;
              render();
            } catch {
              sw.checked = !sw.checked;
              toast(tr("common.saveErr"), true);
            }
          }
        });

        // ---------- Newsletter ----------
        const nSent = document.getElementById("n-sent") as HTMLSpanElement;
        const nRemaining = document.getElementById("n-remaining") as HTMLDivElement;
        const nRecipients = document.getElementById("n-recipients") as HTMLDivElement;
        const nSubject = document.getElementById("n-subject") as HTMLInputElement;
        const nMsg = document.getElementById("n-msg") as HTMLTextAreaElement;
        const nImg = document.getElementById("n-img") as HTMLInputElement;
        const nBtnl = document.getElementById("n-btnl") as HTMLInputElement;
        const nBtnu = document.getElementById("n-btnu") as HTMLInputElement;
        const nBtn2l = document.getElementById("n-btn2l") as HTMLInputElement;
        const nBtn2u = document.getElementById("n-btn2u") as HTMLInputElement;
        const nSend = document.getElementById("n-send") as HTMLButtonElement;
        const nTest = document.getElementById("n-test") as HTMLButtonElement;
        const nErr = document.getElementById("n-err") as HTMLSpanElement;
        const nHistory = document.getElementById("n-history") as HTMLDivElement;
        const nHempty = document.getElementById("n-hempty") as HTMLDivElement;

        type NewsStato = {
          sent_this_month: number;
          quota: number;
          remaining: number;
          purchased_balance: number;
          recipients: number;
          opted_out: number;
          segments?: Record<string, Record<string, number>>;
          history: { subject: string; count: number; created_at: string; image_url?: string | null; message?: string | null; segment?: string | null; btn_label?: string | null; btn_url?: string | null; btn2_label?: string | null; btn2_url?: string | null }[];
        };
        const nPurchased = document.getElementById("n-purchased") as HTMLSpanElement;

        let destinatariNoti = 0;

        // Modale newsletter
        const nOverlay = document.getElementById("n-overlay") as HTMLDivElement;
        document.getElementById("n-add")!.addEventListener("click", () => {
          nErr.textContent = "";
          nUploadState.textContent = "";
          // Modale PULITO: nuova newsletter = niente residui né brouillon agganciato
          draftId = null;
          nSubject.value = "";
          nMsg.value = "";
          nImg.value = "";
          renderFotoNews();
          nBtnl.value = "";
          nBtnu.value = "";
          nBtn2l.value = "";
          nBtn2u.value = "";
          langScelta = "tous";
          segScelto = "tous";
          quando = "now";
          renderSeg();
          aggiornaProg();
          nOverlay.classList.add("is-open");
        });
        document.getElementById("n-close")!.addEventListener("click", () => nOverlay.classList.remove("is-open"));
        nOverlay.addEventListener("click", (e) => {
          if (e.target === nOverlay) nOverlay.classList.remove("is-open");
        });

        async function caricaNews() {
          // "Guarigione" acquisti pending (pagati ma mai verificati)
          try {
            await fetch("/api/admin/credits", { headers });
          } catch {
            // non bloccante
          }
          try {
            const res = await fetch("/api/admin/newsletter", { headers });
            if (!res.ok) return;
            const s = (await res.json()) as NewsStato;
            destinatariNoti = s.recipients;
            nSent.textContent = String(s.sent_this_month);
            // Totale disponibile del mese: incluse (quota) + crediti acquistati
            const totale = document.getElementById("n-quota");
            if (totale) totale.textContent = `/ ${s.sent_this_month + s.remaining}`;
            nRemaining.textContent = String(s.remaining);
            nPurchased.textContent =
              s.purchased_balance > 0 ? tr("mk.ofWhichCredits").replace("{n}", String(s.purchased_balance)) : "";
            nRecipients.textContent = String(s.recipients);
            const oo = document.getElementById("n-optout");
            if (oo) oo.textContent = s.opted_out > 0 ? `${s.opted_out} ${tr("mk.optedOut")}` : tr("mk.noOptedOut");
            segCounts = s.segments ?? {};
            renderSeg();
            void caricaProgrammate();
            historyCache = s.history;
            if (s.history.length === 0) {
              nHistory.innerHTML = "";
              nHempty.style.display = "block";
            } else {
              nHempty.style.display = "none";
              nHistory.innerHTML = `<div class="nn-grid">${s.history
                .map((h, i) => {
                  const d = new Date(h.created_at).toLocaleDateString(LOC, {
                    day: "2-digit", month: "2-digit", year: "numeric",
                    timeZone: (document.querySelector(".ah-header") as HTMLElement | null)?.dataset.tz || "Europe/Brussels",
                  });
                  const foto = h.image_url ? `<img class="nn-img" src="${esc(h.image_url)}" alt="" loading="lazy" />` : "";
                  return `<div class="nn-card is-click" data-i="${i}" title="${tr("mk.relaunchNews")}">${foto}<div class="nn-tit">${esc(h.subject)}</div>${h.message ? `<div class="nn-msg">${esc(h.message)}</div>` : ""}${h.segment ? segPills(h.segment) : ""}<div class="nn-foot"><span class="nn-quando">${d}</span><span>${h.count} ${tr("mk.emails")}</span></div></div>`;
                })
                .join("")}</div>`;
            }
          } catch {
            // silenzioso: le stat restano "—"
          }
        }

        function payloadNews() {
          return {
            segment: `${langScelta}:${segScelto}`,
            subject: nSubject.value,
            message: nMsg.value,
            image_url: nImg.value,
            btn_label: nBtnl.value,
            btn_url: nBtnu.value,
            btn2_label: nBtn2l.value,
            btn2_url: nBtn2u.value,
          };
        }

        // Upload immagine newsletter (stesso endpoint dei pop-up)
        const nUpload = document.getElementById("n-upload") as HTMLButtonElement;
        const nFile = document.getElementById("n-file") as HTMLInputElement;
        const nUploadState = document.getElementById("n-upload-state") as HTMLElement;
        const nImgPrev = document.getElementById("n-img-prev") as HTMLSpanElement;
        const nImgDel = document.getElementById("n-img-del") as HTMLButtonElement;
        function renderFotoNews() {
          const u = nImg.value.trim();
          nImgPrev.innerHTML = u ? `<img src="${esc(u)}" alt="" />` : ICO_IMG_POP;
          nImgDel.style.display = u ? "" : "none";
        }
        nImgDel.addEventListener("click", () => { nImg.value = ""; renderFotoNews(); });
        nUpload.addEventListener("click", () => nFile.click());
        nFile.addEventListener("change", async () => {
          const file = nFile.files?.[0];
          if (!file) return;
          nUpload.disabled = true;
          nUploadState.textContent = tr("menu.compressing");
          try {
            const foto = await comprimiFoto(file);
            if (foto.size > 4 * 1024 * 1024) {
              nUploadState.textContent = tr("cli.fileTooBig");
              return;
            }
            nUploadState.textContent = tr("cli.uploading");
            const base64 = await new Promise<string>((res, rej) => {
              const r = new FileReader();
              r.onload = () => res(String(r.result).split(",")[1] ?? "");
              r.onerror = () => rej(new Error());
              r.readAsDataURL(foto);
            });
            const resp = await fetch("/api/admin/upload", {
              method: "POST",
              headers,
              body: JSON.stringify({ filename: foto.name, data: base64 }),
            });
            const j = await resp.json();
            if (!resp.ok) {
              nUploadState.textContent = j.error ?? tr("cli.uploadError");
              return;
            }
            nImg.value = j.url;
            renderFotoNews();
            nUploadState.textContent = tr("mk.imgUploaded");
          } catch {
            nUploadState.textContent = tr("res.connErr");
          } finally {
            nUpload.disabled = false;
            nFile.value = "";
          }
        });

        // ---------- Bibliothèque : riusa un'immagine già caricata ----------
        let pickTarget: HTMLInputElement | null = null;
        (document.getElementById("f-lib") as HTMLButtonElement).addEventListener("click", () => {
          pickTarget = fImg;
          window.dispatchEvent(new CustomEvent("imgpick:open"));
        });
        (document.getElementById("n-lib") as HTMLButtonElement).addEventListener("click", () => {
          pickTarget = nImg;
          window.dispatchEvent(new CustomEvent("imgpick:open"));
        });
        window.addEventListener("imgpick:pick", (e) => {
          if (!pickTarget) return;
          const eraImg = pickTarget === fImg;
          const eraImgN = pickTarget === nImg;
          pickTarget.value = (e as CustomEvent<{ url: string }>).detail.url;
          if (pickTarget.classList.contains("f-b1u")) setBtnU("f-b1u", pickTarget.value);
          else if (pickTarget.classList.contains("f-b2u")) setBtnU("f-b2u", pickTarget.value);
          pickTarget = null;
          if (eraImg) renderFotoPop();
          if (eraImgN) renderFotoNews();
        });
        // Campi "lien": scegli un asset (immagine O documento) e incolla l'URL
        document.querySelectorAll<HTMLButtonElement>(".asset-pick").forEach((b) => {
          b.addEventListener("click", () => {
            pickTarget = document.getElementById(b.dataset.target ?? "") as HTMLInputElement;
            window.dispatchEvent(new CustomEvent("imgpick:open", { detail: { mode: "link" } }));
          });
        });
        // Link dei pulsanti dentro i pannelli lingua: sync tra lingue + scelta asset
        fPanels.addEventListener("input", (e) => {
          const el = e.target as HTMLElement;
          if (el.classList.contains("f-b1u")) setBtnU("f-b1u", (el as HTMLInputElement).value);
          else if (el.classList.contains("f-b2u")) setBtnU("f-b2u", (el as HTMLInputElement).value);
        });
        fPanels.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest(".asset-pop") as HTMLButtonElement | null;
          if (!b) return;
          const row = b.closest(".f-row");
          pickTarget = row?.querySelector<HTMLInputElement>("input.f-input") ?? null;
          window.dispatchEvent(new CustomEvent("imgpick:open", { detail: { mode: "link" } }));
        });

        // Test: una sola email al proprio indirizzo
        nTest.addEventListener("click", async () => {
          nErr.textContent = "";
          nTest.disabled = true;
          try {
            const res = await fetch("/api/admin/newsletter", {
              method: "POST",
              headers,
              body: JSON.stringify({ ...payloadNews(), test: true }),
            });
            const j = await res.json();
            if (!res.ok) {
              nErr.textContent = j.error ?? tr("ord.errShort");
              return;
            }
            toast(`${tr("mk.testSentTo")} ${j.to}`);
          } catch {
            nErr.textContent = tr("res.connErr");
          } finally {
            nTest.disabled = false;
          }
        });

        // Invio a tutti: conferma in 2 tap (come le cancellazioni)
        let nConfermaTimer: number | undefined;
        nSend.addEventListener("click", async () => {
          nErr.textContent = "";
          if (quando !== "now") { void programmaNews(); return; }
          if (!nSend.classList.contains("confirm")) {
            nSend.classList.add("confirm");
            nSend.textContent = tr("mk.confirmSend").replace("{n}", String(contaSeg(langScelta, segScelto) ?? destinatariNoti));
            window.clearTimeout(nConfermaTimer);
            nConfermaTimer = window.setTimeout(() => {
              nSend.classList.remove("confirm");
              nSend.textContent = tr("mk.sendToAll");
            }, 4000);
            return;
          }
          window.clearTimeout(nConfermaTimer);
          nSend.classList.remove("confirm");
          nSend.textContent = tr("mk.sending");
          nSend.disabled = true;
          nSend.classList.add("is-loading");
          try {
            const res = await fetch("/api/admin/newsletter", {
              method: "POST",
              headers,
              body: JSON.stringify(payloadNews()),
            });
            const j = await res.json();
            if (!res.ok) {
              nErr.textContent = j.error ?? tr("ord.errShort");
              return;
            }
            toast(tr("mk.newsSentTo").replace("{n}", String(j.sent)));
            if (draftId) {
              void fetch("/api/admin/newsletter-schedule?id=" + draftId, { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } }).then(() => caricaProgrammate());
              draftId = null;
            }
            nSubject.value = "";
            nMsg.value = "";
            nImg.value = "";
            renderFotoNews();
            nBtnl.value = "";
            nBtnu.value = "";
            nOverlay.classList.remove("is-open");
            await caricaNews();
          } catch {
            nErr.textContent = tr("res.connErr");
          } finally {
            nSend.disabled = false;
            nSend.classList.remove("is-loading");
            nSend.textContent = tr("mk.sendToAll");
          }
        });

        // ---------- Segmenti destinatari + programmazione (#39) ----------
        // La LINGUA è primaria (fr = sito FR o sconosciuta · en = tutte le
        // altre); il gruppo vale DENTRO la lingua. segment = "lingua:gruppo".
        const LANG_LAB: Record<string, string> = { tous: tr("mk.allLanguages"), fr: "FR", en: "EN" };
        const SEG_LAB: Record<string, string> = {
          tous: tr("cli.all"), nouveaux: tr("mk.segNew"), top50: "Top 50", resa: tr("mk.segReserved"), commande: tr("mk.segOrdered"),
        };
        let langScelta = "tous";
        let segScelto = "tous";
        let segCounts: Record<string, Record<string, number>> = {};
        const nLang = document.getElementById("n-lang") as HTMLDivElement;
        const nSeg = document.getElementById("n-seg") as HTMLDivElement;
        function contaSeg(l: string, g: string): number | undefined {
          return segCounts[l]?.[g];
        }
        function segPills(seg: string): string {
          const [sl, sg] = String(seg ?? "").split(":");
          const pills: string[] = [LANG_LAB[sl] ?? tr("mk.allLanguages")];
          if (sg && sg !== "tous") pills.push(SEG_LAB[sg] ?? sg);
          return `<div class="nn-tags">${pills.map((t) => `<span class="nn-tag">${t}</span>`).join("")}</div>`;
        }
        function renderSeg() {
          nLang.innerHTML = Object.keys(LANG_LAB)
            .map((k) => `<button type="button" class="seg-pill${langScelta === k ? " is-on" : ""}" data-lang="${k}">${LANG_LAB[k]}${contaSeg(k, "tous") !== undefined ? `<span class="n">${contaSeg(k, "tous")}</span>` : ""}</button>`)
            .join("");
          nSeg.innerHTML = Object.keys(SEG_LAB)
            .map((k) => `<button type="button" class="seg-pill${segScelto === k ? " is-on" : ""}" data-seg="${k}">${SEG_LAB[k]}${contaSeg(langScelta, k) !== undefined ? `<span class="n">${contaSeg(langScelta, k)}</span>` : ""}</button>`)
            .join("");
        }
        nLang.addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".seg-pill") as HTMLElement | null;
          if (!t?.dataset.lang) return;
          langScelta = t.dataset.lang;
          renderSeg();
          aggiornaTestoInvio();
        });
        nSeg.addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".seg-pill") as HTMLElement | null;
          if (!t?.dataset.seg) return;
          segScelto = t.dataset.seg;
          renderSeg();
          aggiornaTestoInvio();
        });

        let quando = "now"; // now | date | weekly | monthly
        const nWhen = document.getElementById("n-when") as HTMLDivElement;
        const nProg = document.getElementById("n-prog") as HTMLDivElement;
        const npDate = document.getElementById("np-date") as HTMLInputElement;
        const npDow = document.getElementById("np-dow") as HTMLElement;
        const npDay = document.getElementById("np-day") as HTMLInputElement;
        const npHeure = document.getElementById("np-heure") as HTMLSelectElement;
        npHeure.innerHTML = Array.from({ length: 24 }, (_, h) => `<option value="${h}"${h === 10 ? " selected" : ""}>${String(h).padStart(2, "0")}:00</option>`).join("");
        const DOW_LAB = Array.from({ length: 7 }, (_, i) => new Date(2021, 2, i + 1).toLocaleDateString(LOC, { weekday: "short" }));
        let dowScelto = 5; // venerdì
        function renderDow() {
          npDow.innerHTML = DOW_LAB.map((l, i) => `<button type="button" class="seg-pill${dowScelto === i + 1 ? " is-on" : ""}" data-d="${i + 1}">${l}</button>`).join("");
        }
        npDow.addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".seg-pill") as HTMLElement | null;
          if (!t?.dataset.d) return;
          dowScelto = Number(t.dataset.d);
          renderDow();
        });
        function aggiornaTestoInvio() {
          if (nSend.classList.contains("confirm")) return;
          nSend.textContent = quando === "now" ? (langScelta === "tous" && segScelto === "tous" ? tr("mk.sendToAll") : tr("mk.sendToGroup")) : tr("mk.schedule");
        }
        function aggiornaProg() {
          nProg.style.display = quando === "now" ? "none" : "flex";
          npDate.style.display = quando === "date" ? "" : "none";
          npDow.style.display = quando === "weekly" ? "flex" : "none";
          npDay.style.display = quando === "monthly" ? "" : "none";
          nWhen.querySelectorAll(".seg-pill").forEach((pl) => pl.classList.toggle("is-on", (pl as HTMLElement).dataset.w === quando));
          aggiornaTestoInvio();
        }
        nWhen.addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".seg-pill") as HTMLElement | null;
          if (!t?.dataset.w) return;
          quando = t.dataset.w;
          aggiornaProg();
        });
        npDate.addEventListener("click", (e) => {
          e.stopPropagation();
          dpApri(npDate);
        });
        renderDow();
        renderSeg();
        aggiornaProg();

        async function programmaNews() {
          nErr.textContent = "";
          if (!nSubject.value.trim()) { nErr.textContent = tr("mk.subjectRequired"); return; }
          if (!nMsg.value.trim()) { nErr.textContent = tr("mk.messageRequired"); return; }
          const body: Record<string, unknown> = { ...payloadNews(), heure: Number(npHeure.value) };
          if (quando === "date") {
            if (!npDate.dataset.iso) { nErr.textContent = tr("mk.chooseDate"); return; }
            body.send_date = npDate.dataset.iso;
          } else {
            body.recur = quando; // weekly | monthly
            if (quando === "weekly") body.recur_dow = dowScelto;
            else body.recur_day = Math.min(28, Math.max(1, Number(npDay.value || 1)));
          }
          nSend.disabled = true;
          nSend.classList.add("is-loading");
          try {
            const res = await fetch("/api/admin/newsletter-schedule", { method: "POST", headers, body: JSON.stringify(body) });
            const j = await res.json();
            if (!res.ok) { nErr.textContent = j.error ?? tr("ord.errShort"); return; }
            toast(tr("mk.newsScheduled"));
            if (draftId) {
              void fetch("/api/admin/newsletter-schedule?id=" + draftId, { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } });
              draftId = null;
            }
            nOverlay.classList.remove("is-open");
            quando = "now";
            aggiornaProg();
            void caricaProgrammate();
          } catch {
            nErr.textContent = tr("res.connErr");
          } finally {
            nSend.disabled = false;
            nSend.classList.remove("is-loading");
            aggiornaTestoInvio();
          }
        }

        let draftId: string | null = null;
        let historyCache: NewsStato["history"] = [];

        // Rilancio di un invio passato: NUOVA istanza (modale precompilato,
        // contenuto + filtri; nessun legame con l'invio originale)
        nHistory.addEventListener("click", (e) => {
          const card = (e.target as HTMLElement).closest(".nn-card") as HTMLElement | null;
          if (!card?.dataset.i) return;
          const h = historyCache[Number(card.dataset.i)];
          if (!h) return;
          draftId = null;
          nErr.textContent = "";
          nSubject.value = h.subject ?? "";
          nMsg.value = h.message ?? "";
          nImg.value = h.image_url ?? "";
          renderFotoNews();
          nBtnl.value = h.btn_label ?? "";
          nBtnu.value = h.btn_url ?? "";
          nBtn2l.value = h.btn2_label ?? "";
          nBtn2u.value = h.btn2_url ?? "";
          const [sl, sg] = String(h.segment ?? "tous:tous").split(":");
          langScelta = sl || "tous";
          segScelto = sg || "tous";
          quando = "now";
          renderSeg();
          aggiornaProg();
          nOverlay.classList.add("is-open");
        });
        let draftsCache: { id: string; subject: string; message: string; image_url: string | null; btn_label: string | null; btn_url: string | null; btn2_label: string | null; btn2_url: string | null; segment: string }[] = [];

        async function salvaBrouillon() {
          nErr.textContent = "";
          if (!nSubject.value.trim() && !nMsg.value.trim()) {
            nErr.textContent = tr("mk.nothingToSave");
            return;
          }
          const bd = document.getElementById("n-draft") as HTMLButtonElement;
          bd.disabled = true;
          try {
            const res = await fetch("/api/admin/newsletter-schedule", {
              method: "POST",
              headers,
              body: JSON.stringify({ ...payloadNews(), draft: true, id: draftId ?? undefined }),
            });
            const j = await res.json();
            if (!res.ok) { nErr.textContent = j.error ?? tr("ord.errShort"); return; }
            draftId = j.schedule?.id ?? null;
            toast(tr("mk.draftSaved"));
            nOverlay.classList.remove("is-open");
            void caricaProgrammate();
          } catch {
            nErr.textContent = tr("res.connErr");
          } finally {
            bd.disabled = false;
          }
        }
        (document.getElementById("n-draft") as HTMLButtonElement).addEventListener("click", () => void salvaBrouillon());

        function apriBrouillon(r: (typeof draftsCache)[number]) {
          draftId = r.id;
          nErr.textContent = "";
          nSubject.value = r.subject === "(brouillon)" ? "" : r.subject;
          nMsg.value = r.message ?? "";
          nImg.value = r.image_url ?? "";
          renderFotoNews();
          nBtnl.value = r.btn_label ?? "";
          nBtnu.value = r.btn_url ?? "";
          nBtn2l.value = r.btn2_label ?? "";
          nBtn2u.value = r.btn2_url ?? "";
          const [sl, sg] = String(r.segment ?? "tous:tous").split(":");
          langScelta = sl || "tous";
          segScelto = sg || "tous";
          quando = "now";
          renderSeg();
          aggiornaProg();
          nOverlay.classList.add("is-open");
        }
        (document.getElementById("nd-list") as HTMLElement).addEventListener("click", async (e) => {
          const del = (e.target as HTMLElement).closest(".np-del") as HTMLButtonElement | null;
          const row = (e.target as HTMLElement).closest(".nn-card") as HTMLElement | null;
          if (!row) return;
          if (del) {
            if (!del.classList.contains("confirm")) {
              del.classList.add("confirm");
              del.textContent = "?";
              setTimeout(() => { del.classList.remove("confirm"); del.textContent = "×"; }, 3000);
              return;
            }
            try {
              const res = await fetch("/api/admin/newsletter-schedule?id=" + row.dataset.id, { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } });
              if (!res.ok) { toast(tr("us.delErr"), true); return; }
              if (draftId === row.dataset.id) draftId = null;
              toast(tr("mk.draftDeleted"));
              void caricaProgrammate();
            } catch {
              toast(tr("res.connErr"), true);
            }
            return;
          }
          const r = draftsCache.find((x) => x.id === row.dataset.id);
          if (r) apriBrouillon(r);
        });

        async function caricaProgrammate() {
          try {
            const res = await fetch("/api/admin/newsletter-schedule", { headers });
            if (!res.ok) return;
            const j = (await res.json()) as { schedules?: { id: string; subject: string; message?: string; segment: string; send_at: string | null; recur: string | null; recur_dow: number | null; recur_day: number | null; recur_heure: number | null }[] };
            const righe = j.schedules ?? [];
            draftsCache = ((j as { drafts?: typeof draftsCache }).drafts ?? []);
            const dtit = document.getElementById("nd-tit") as HTMLElement;
            const dbox = document.getElementById("nd-list") as HTMLElement;
            dtit.style.display = draftsCache.length ? "" : "none";
            dbox.innerHTML = draftsCache.length
              ? `<div class="nn-grid">${draftsCache
                  .map((r) => `<div class="nn-card is-click" data-id="${r.id}" title="${tr("mk.resumeDraft")}"><div class="nn-tit">${esc(r.subject)}</div>${r.message ? `<div class="nn-msg">${esc(r.message)}</div>` : ""}${segPills(r.segment)}<div class="nn-foot"><span class="nn-quando">${tr("mk.draft")}</span><button class="np-del" type="button" title="${tr("common.delete")}">×</button></div></div>`)
                  .join("")}</div>`
              : "";
            const tit = document.getElementById("np-tit") as HTMLElement;
            const box = document.getElementById("np-list") as HTMLElement;
            tit.style.display = righe.length ? "" : "none";
            const tz = (document.querySelector(".ah-header") as HTMLElement | null)?.dataset.tz || "Europe/Brussels";
            const JOURS = Array.from({ length: 7 }, (_, i) => new Date(2021, 2, i + 1).toLocaleDateString(LOC, { weekday: "long" }));
            box.innerHTML = righe.length ? '<div class="nn-grid">' + righe
              .map((r) => {
                const hh = `${String(r.recur_heure ?? 10).padStart(2, "0")}:00`;
                let quandoTxt = "";
                if (r.send_at) {
                  quandoTxt = new Date(r.send_at).toLocaleString(LOC, { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: tz });
                } else if (r.recur === "weekly") {
                  quandoTxt = `${tr("mk.weeklyDow").replace("{j}", JOURS[(r.recur_dow ?? 1) - 1])} ${tr("home.at")} ${hh}`;
                } else {
                  quandoTxt = `${tr("mk.monthlyDay").replace("{d}", String(r.recur_day))} ${tr("home.at")} ${hh}`;
                }
                return `<div class="nn-card" data-id="${r.id}"><div class="nn-tit">${esc(r.subject)}</div>${r.message ? `<div class="nn-msg">${esc(r.message)}</div>` : ""}${segPills(r.segment)}<div class="nn-foot"><span class="nn-quando">${quandoTxt}</span><button class="np-del" type="button" title="${tr("common.delete")}">×</button></div></div>`;
              })
              .join("") + "</div>" : "";
          } catch { /* lista invariata */ }
        }
        (document.getElementById("np-list") as HTMLElement).addEventListener("click", async (e) => {
          const b = (e.target as HTMLElement).closest(".np-del") as HTMLButtonElement | null;
          if (!b) return;
          const row = b.closest(".nn-card") as HTMLElement;
          if (!b.classList.contains("confirm")) {
            b.classList.add("confirm");
            b.textContent = "?";
            setTimeout(() => { b.classList.remove("confirm"); b.textContent = "×"; }, 3000);
            return;
          }
          try {
            const res = await fetch("/api/admin/newsletter-schedule?id=" + row.dataset.id, { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } });
            if (!res.ok) { toast(tr("us.delErr"), true); return; }
            toast(tr("mk.scheduledDeleted"));
            void caricaProgrammate();
          } catch {
            toast(tr("res.connErr"), true);
          }
        });

        // ---------- Acquisto crediti (Stripe MOODD) ----------
        const cOverlay = document.getElementById("c-overlay") as HTMLDivElement;
        const cErr = document.getElementById("c-err") as HTMLSpanElement;
        const cFoot = document.getElementById("c-foot") as HTMLDivElement;
        const cCheckout = document.getElementById("c-checkout") as HTMLButtonElement;
        let packScelto: string | null = null;

        function resetPacks() {
          packScelto = null;
          cErr.textContent = "";
          cFoot.style.display = "none";
          cOverlay.querySelectorAll<HTMLElement>(".c-pack").forEach((b) => b.classList.remove("is-on"));
        }

        document.getElementById("c-buy")!.addEventListener("click", () => {
          resetPacks();
          cOverlay.classList.add("is-open");
        });
        document.getElementById("c-close")!.addEventListener("click", () => cOverlay.classList.remove("is-open"));
        cOverlay.addEventListener("click", (e) => {
          if (e.target === cOverlay) cOverlay.classList.remove("is-open");
        });

        // 1° passo: scegli il pack → appare il bottone di pagamento
        cOverlay.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest(".c-pack") as HTMLButtonElement | null;
          if (!btn) return;
          packScelto = btn.dataset.pack ?? null;
          cOverlay.querySelectorAll<HTMLElement>(".c-pack").forEach((b) =>
            b.classList.toggle("is-on", b === btn)
          );
          cCheckout.textContent = `${tr("mk.pay")} ${btn.dataset.price} →`;
          cFoot.style.display = "flex";
          cErr.textContent = "";
        });

        // 2° passo: checkout Stripe
        cCheckout.addEventListener("click", async () => {
          if (!packScelto) return;
          cErr.textContent = "";
          cCheckout.disabled = true;
          cCheckout.classList.add("is-loading");
          try {
            const res = await fetch("/api/admin/credits", {
              method: "POST",
              headers,
              body: JSON.stringify({ pack: packScelto }),
            });
            const j = await res.json();
            if (!res.ok) {
              cErr.textContent = j.error ?? tr("ord.errShort");
              return;
            }
            window.location.href = j.url; // → Stripe Checkout
          } catch {
            cErr.textContent = tr("res.connErr");
          } finally {
            cCheckout.disabled = false;
            cCheckout.classList.remove("is-loading");
          }
        });

        await carica();

        // Ritorno da Stripe: verifica il pagamento e accredita
        const creditSession = new URLSearchParams(window.location.search).get("credit_session");
        if (creditSession) {
          window.history.replaceState({}, "", "/admin/marketing");
          mostraTab("news");
          try {
            const res = await fetch("/api/admin/credits", {
              method: "PUT",
              headers,
              body: JSON.stringify({ session_id: creditSession }),
            });
            const j = await res.json();
            if (res.ok) toast(tr("mk.creditsAdded").replace("{n}", String(j.credits)));
            else toast(j.error ?? tr("itg.g.verifyErr"), true);
          } catch {
            toast(tr("res.connErr"), true);
          }
          await caricaNews();
        }

        // ============================================================
        // ---------- Tab COUPONS ----------
        // ============================================================
        interface Coupon {
          id: string;
          code: string;
          description: string | null;
          discount_type: "percent" | "fixed";
          discount_value: number;
          max_discount_cents: number | null;
          min_spend_cents: number | null;
          schedule_kind: "always" | "dates" | "weekly";
          date_start: string | null;
          date_end: string | null;
          days: number[] | null;
          hour_start: string | null;
          hour_end: string | null;
          per_customer_limit: number | null;
          global_limit: number | null;
          categories: string[];
          combine_with_promo: "stack" | "exclude" | "block";
          new_customers_only: boolean;
          active: boolean;
          uses: number;
        }

        const cpEmpty = document.getElementById("cp-empty") as HTMLDivElement;
        const cpList = document.getElementById("coupons") as HTMLDivElement;
        const cpOverlay = document.getElementById("cp-overlay") as HTMLDivElement;
        const cpTitle = document.getElementById("cp-title") as HTMLHeadingElement;
        const cpCode = document.getElementById("cp-code") as HTMLInputElement;
        const cpDesc = document.getElementById("cp-desc") as HTMLInputElement;
        const cpType = document.getElementById("cp-type") as HTMLDivElement;
        const cpValue = document.getElementById("cp-value") as HTMLInputElement;
        const cpValueLab = document.getElementById("cp-value-lab") as HTMLSpanElement;
        const cpMaxcap = document.getElementById("cp-maxcap") as HTMLInputElement;
        const cpMinspend = document.getElementById("cp-minspend") as HTMLInputElement;
        const cpKind = document.getElementById("cp-kind") as HTMLDivElement;
        const cpSchedDates = document.getElementById("cp-sched-dates") as HTMLDivElement;
        const cpSchedWeekly = document.getElementById("cp-sched-weekly") as HTMLDivElement;
        const cpDs = document.getElementById("cp-ds") as HTMLInputElement;
        const cpDe = document.getElementById("cp-de") as HTMLInputElement;
        const cpDaysBox = document.getElementById("cp-days") as HTMLDivElement;
        const cpHs = document.getElementById("cp-hs") as HTMLInputElement;
        const cpHe = document.getElementById("cp-he") as HTMLInputElement;
        const cpPerClient = document.getElementById("cp-perclient") as HTMLInputElement;
        const cpGlobal = document.getElementById("cp-global") as HTMLInputElement;
        const cpCatsBox = document.getElementById("cp-cats") as HTMLDivElement;
        const cpCombine = document.getElementById("cp-combine") as HTMLDivElement;
        const cpNew = document.getElementById("cp-new") as HTMLInputElement;
        const cpActive = document.getElementById("cp-active") as HTMLInputElement;
        const cpSave = document.getElementById("cp-save") as HTMLButtonElement;
        const cpErr = document.getElementById("cp-err") as HTMLSpanElement;

        let coupons: Coupon[] = [];
        let cpEditId: string | null = null;
        let cpCatsCaricate = false;

        function cpEuro(cents: number): string {
          return (cents / 100).toFixed(2).replace(".", ",") + " €";
        }

        // Popola i giorni della settimana (una volta sola)
        cpDaysBox.innerHTML = GIORNI.map((g) => `<span class="pick" data-d="${g.n}">${g.label}</span>`).join("");

        async function cpCaricaCategorie() {
          if (cpCatsCaricate) return;
          try {
            const res = await fetch("/api/admin/categories", { headers });
            const j = await res.json();
            const cats: { name: string }[] = j.categories ?? [];
            cpCatsBox.innerHTML = cats
              .map((c) => `<span class="pick" data-cat="${esc(c.name)}">${esc(c.name)}</span>`)
              .join("");
            cpCatsCaricate = true;
          } catch {
            cpCatsBox.innerHTML = "";
          }
        }

        function cpProg(c: Coupon): string {
          if (c.schedule_kind === "dates") {
            const f = (d: string | null) => (d ? d.split("-").reverse().join("/") : "?");
            return `${f(c.date_start)} → ${f(c.date_end)}`;
          }
          if (c.schedule_kind === "weekly") {
            const nomi = GIORNI.filter((g) => (c.days ?? []).includes(g.n)).map((g) => g.label).join(", ");
            const hh = (h: string | null) => String(h ?? "").slice(0, 5);
            return `${nomi} · ${hh(c.hour_start)}–${hh(c.hour_end)}`;
          }
          return tr("mk.schedAlways");
        }

        function cpValoreLabel(c: Coupon): string {
          return c.discount_type === "percent" ? `−${c.discount_value}%` : `−${cpEuro(c.discount_value)}`;
        }

        function cpRender() {
          if (coupons.length === 0) {
            cpList.innerHTML = "";
            cpEmpty.style.display = "block";
            return;
          }
          cpEmpty.style.display = "none";
          cpList.innerHTML = coupons
            .map((c) => {
              const tags: string[] = [`<span class="m-tag gold">${cpValoreLabel(c)}</span>`];
              if (c.max_discount_cents) tags.push(`<span class="m-tag">max ${cpEuro(c.max_discount_cents)}</span>`);
              if (c.min_spend_cents) tags.push(`<span class="m-tag">min ${cpEuro(c.min_spend_cents)}</span>`);
              tags.push(`<span class="m-tag">${esc(cpProg(c))}</span>`);
              tags.push(
                `<span class="m-tag">${c.categories.length ? esc(c.categories.join(", ")) : tr("mk.allCategories")}</span>`
              );
              const combineLbl =
                c.combine_with_promo === "stack"
                  ? tr("mk.combStack")
                  : c.combine_with_promo === "exclude"
                    ? tr("mk.combExcl")
                    : tr("mk.combBlock");
              tags.push(`<span class="m-tag">${combineLbl}</span>`);
              if (c.new_customers_only) tags.push(`<span class="m-tag">${tr("mk.newCustomers")}</span>`);
              const usiTxt = c.global_limit
                ? `${c.uses} / ${c.global_limit} ${tr("mk.usedPl")}`
                : `${c.uses} ${c.uses === 1 ? tr("mk.usedSg") : tr("mk.usedPl")}`;
              const perCli = c.per_customer_limit ? ` · ${c.per_customer_limit}/${tr("mk.perClient")}` : "";
              tags.push(`<span class="m-tag">${usiTxt}${perCli}</span>`);
              return `
                <div class="pop ${c.active ? "" : "is-off"}">
                  <div class="pop-top">
                    <div class="pop-title">${esc(c.code)}</div>
                  </div>
                  ${c.description ? `<div class="pop-text">${esc(c.description)}</div>` : ""}
                  <div class="pop-meta">${tags.join("")}</div>
                  <div class="pop-actions">
                    <span class="sw-wrap">
                      <label class="switch"><input type="checkbox" data-toggle="${c.id}" ${c.active ? "checked" : ""} /><span class="track"></span></label>
                      <span class="sw-lab">${tr("menu.active")}</span>
                    </span>
                    <button class="i-btn i-edit" data-edit="${c.id}" aria-label="${tr("common.edit")}">${ICO_PEN}</button>
                    <button class="i-btn i-del" data-del="${c.id}" aria-label="${tr("common.delete")}">${ICO_TRASH}</button>
                  </div>
                </div>`;
            })
            .join("");
        }

        async function caricaCoupons() {
          await cpCaricaCategorie();
          try {
            const res = await fetch("/api/admin/coupons", { headers });
            const j = await res.json();
            coupons = j.coupons ?? [];
            cpRender();
          } catch {
            toast(tr("mk.couponsLoadErr"), true);
          }
        }

        function cpSingleSel(box: HTMLElement, el: HTMLElement) {
          box.querySelectorAll(".pick").forEach((x) => x.classList.remove("is-on"));
          el.classList.add("is-on");
        }
        function cpTipoAttivo(): string {
          return (cpType.querySelector(".pick.is-on") as HTMLElement)?.dataset.t ?? "percent";
        }
        function cpKindAttivo(): string {
          return (cpKind.querySelector(".pick.is-on") as HTMLElement)?.dataset.k ?? "always";
        }
        function cpCombineAttivo(): string {
          return (cpCombine.querySelector(".pick.is-on") as HTMLElement)?.dataset.c ?? "stack";
        }
        function cpAggiornaUnita() {
          cpValueLab.textContent = cpTipoAttivo() === "percent" ? tr("mk.valuePercent") : tr("mk.amountEuro");
        }

        cpType.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (!el) return;
          cpSingleSel(cpType, el);
          cpAggiornaUnita();
        });
        cpCombine.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (el) cpSingleSel(cpCombine, el);
        });
        cpKind.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (!el) return;
          cpSingleSel(cpKind, el);
          cpSchedDates.classList.toggle("is-visible", el.dataset.k === "dates");
          cpSchedWeekly.classList.toggle("is-visible", el.dataset.k === "weekly");
        });
        cpCatsBox.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (el) el.classList.toggle("is-on");
        });
        cpDaysBox.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (el) el.classList.toggle("is-on");
        });

        function cpEurToCents(v: string): number | null {
          const n = parseFloat(String(v).replace(",", "."));
          return Number.isFinite(n) && n > 0 ? Math.round(n * 100) : null;
        }
        function cpIntPos(v: string): number | null {
          const n = parseInt(v, 10);
          return Number.isFinite(n) && n > 0 ? n : null;
        }

        function cpApri(c: Coupon | null) {
          cpEditId = c?.id ?? null;
          cpTitle.textContent = c ? tr("mk.editCoupon") : tr("mk.newCoupon");
          cpErr.textContent = "";
          cpCode.value = c?.code ?? "";
          cpDesc.value = c?.description ?? "";

          const tipo = c?.discount_type ?? "percent";
          cpType.querySelectorAll<HTMLElement>(".pick").forEach((el) => el.classList.toggle("is-on", el.dataset.t === tipo));
          cpValue.value = c ? (tipo === "fixed" ? (c.discount_value / 100).toString() : String(c.discount_value)) : "";
          cpMaxcap.value = c?.max_discount_cents ? (c.max_discount_cents / 100).toString() : "";
          cpMinspend.value = c?.min_spend_cents ? (c.min_spend_cents / 100).toString() : "";
          cpAggiornaUnita();

          const kind = c?.schedule_kind ?? "always";
          cpKind.querySelectorAll<HTMLElement>(".pick").forEach((el) => el.classList.toggle("is-on", el.dataset.k === kind));
          cpSchedDates.classList.toggle("is-visible", kind === "dates");
          cpSchedWeekly.classList.toggle("is-visible", kind === "weekly");
          cpDs.value = c?.date_start ?? "";
          cpDe.value = c?.date_end ?? "";
          const giorniOn = c?.days ?? [];
          cpDaysBox.querySelectorAll<HTMLElement>(".pick").forEach((el) =>
            el.classList.toggle("is-on", giorniOn.includes(Number(el.dataset.d)))
          );
          cpHs.value = c?.hour_start ? String(c.hour_start).slice(0, 5) : "";
          cpHe.value = c?.hour_end ? String(c.hour_end).slice(0, 5) : "";

          cpPerClient.value = c?.per_customer_limit ? String(c.per_customer_limit) : "";
          cpGlobal.value = c?.global_limit ? String(c.global_limit) : "";

          const catsOn = c?.categories ?? [];
          cpCatsBox.querySelectorAll<HTMLElement>(".pick").forEach((el) =>
            el.classList.toggle("is-on", catsOn.includes(el.dataset.cat ?? ""))
          );

          const combine = c?.combine_with_promo ?? "stack";
          cpCombine.querySelectorAll<HTMLElement>(".pick").forEach((el) => el.classList.toggle("is-on", el.dataset.c === combine));

          cpNew.checked = c?.new_customers_only ?? false;
          cpActive.checked = c ? c.active : true;

          cpOverlay.classList.add("is-open");
        }
        function cpChiudi() {
          cpOverlay.classList.remove("is-open");
        }

        document.getElementById("cp-add")!.addEventListener("click", () => cpApri(null));
        document.getElementById("cp-close")!.addEventListener("click", cpChiudi);
        cpOverlay.addEventListener("click", (e) => {
          if (e.target === cpOverlay) cpChiudi();
        });

        function cpRaccogli() {
          const tipo = cpTipoAttivo();
          const valoreRaw = cpValue.value.trim();
          const discount_value = tipo === "fixed" ? cpEurToCents(valoreRaw) ?? 0 : parseInt(valoreRaw, 10) || 0;
          const kind = cpKindAttivo();
          return {
            id: cpEditId ?? undefined,
            code: cpCode.value.trim(),
            description: cpDesc.value.trim(),
            discount_type: tipo,
            discount_value,
            max_discount_cents: cpEurToCents(cpMaxcap.value.trim()),
            min_spend_cents: cpEurToCents(cpMinspend.value.trim()),
            schedule_kind: kind,
            date_start: kind === "dates" ? cpDs.value || null : null,
            date_end: kind === "dates" ? cpDe.value || null : null,
            days:
              kind === "weekly"
                ? Array.from(cpDaysBox.querySelectorAll<HTMLElement>(".pick.is-on")).map((el) => Number(el.dataset.d))
                : null,
            hour_start: kind === "weekly" ? cpHs.value || null : null,
            hour_end: kind === "weekly" ? cpHe.value || null : null,
            per_customer_limit: cpIntPos(cpPerClient.value),
            global_limit: cpIntPos(cpGlobal.value),
            categories: Array.from(cpCatsBox.querySelectorAll<HTMLElement>(".pick.is-on")).map((el) => el.dataset.cat!),
            combine_with_promo: cpCombineAttivo(),
            new_customers_only: cpNew.checked,
            active: cpActive.checked,
          };
        }

        cpSave.addEventListener("click", async () => {
          const payload = cpRaccogli();
          cpErr.textContent = "";
          cpSave.disabled = true;
          try {
            const res = await fetch("/api/admin/coupons", {
              method: cpEditId ? "PUT" : "POST",
              headers,
              body: JSON.stringify(payload),
            });
            const j = await res.json();
            if (!res.ok) {
              cpErr.textContent = j.error ?? tr("common.saveErr");
              return;
            }
            cpChiudi();
            toast(cpEditId ? tr("mk.couponUpdated") : tr("mk.couponCreated"));
            await caricaCoupons();
          } catch {
            cpErr.textContent = tr("res.connErr");
          } finally {
            cpSave.disabled = false;
          }
        });

        let cpDelPending: string | null = null;
        let cpDelTimer: number | undefined;
        cpList.addEventListener("click", async (e) => {
          const target = e.target as HTMLElement;
          const edit = target.closest("[data-edit]") as HTMLElement | null;
          if (edit) {
            const c = coupons.find((x) => x.id === edit.dataset.edit);
            if (c) cpApri(c);
            return;
          }
          const del = target.closest("[data-del]") as HTMLElement | null;
          if (del) {
            const id = del.dataset.del!;
            if (cpDelPending === id) {
              window.clearTimeout(cpDelTimer);
              cpDelPending = null;
              try {
                const res = await fetch(`/api/admin/coupons?id=${id}`, { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } });
                if (!res.ok) {
                  toast(tr("us.delErr"), true);
                  return;
                }
                toast(tr("mk.couponDeleted"));
                await caricaCoupons();
              } catch {
                toast(tr("res.connErr"), true);
              }
              return;
            }
            cpDelPending = id;
            del.classList.add("confirm");
            del.textContent = tr("common.confirm");
            window.clearTimeout(cpDelTimer);
            cpDelTimer = window.setTimeout(() => {
              cpDelPending = null;
              del.classList.remove("confirm");
              del.innerHTML = ICO_TRASH;
            }, 3000);
          }
        });
        cpList.addEventListener("change", async (e) => {
          const sw = (e.target as HTMLElement).closest("[data-toggle]") as HTMLInputElement | null;
          if (!sw) return;
          const id = sw.dataset.toggle!;
          try {
            const res = await fetch("/api/admin/coupons", {
              method: "PUT",
              headers,
              body: JSON.stringify({ id, active: sw.checked }),
            });
            if (!res.ok) {
              sw.checked = !sw.checked;
              toast(tr("common.saveErr"), true);
              return;
            }
            const c = coupons.find((x) => x.id === id);
            if (c) c.active = sw.checked;
            const card = sw.closest(".pop");
            if (card) card.classList.toggle("is-off", !sw.checked);
          } catch {
            sw.checked = !sw.checked;
            toast(tr("res.connErr"), true);
          }
        });

        // ---------- Bons cadeaux ----------
        const gcAdd = document.getElementById("gc-add") as HTMLButtonElement;
        const gcList = document.getElementById("giftcards") as HTMLDivElement;
        const gcEmpty = document.getElementById("gc-empty") as HTMLDivElement;
        const gcOverlay = document.getElementById("gc-overlay") as HTMLDivElement;
        const gcClose = document.getElementById("gc-close") as HTMLButtonElement;
        const gcValue = document.getElementById("gc-value") as HTMLInputElement;
        const gcValPicks = document.getElementById("gc-val-picks") as HTMLDivElement;
        const gcExpPicks = document.getElementById("gc-exp-picks") as HTMLDivElement;
        const gcExp = document.getElementById("gc-exp") as HTMLInputElement;
        const gcCode = document.getElementById("gc-code") as HTMLInputElement;
        const gcRfname = document.getElementById("gc-rfname") as HTMLInputElement;
        const gcRlname = document.getElementById("gc-rlname") as HTMLInputElement;
        const gcRemail = document.getElementById("gc-remail") as HTMLInputElement;
        const gcRphone = document.getElementById("gc-rphone") as HTMLInputElement;
        const gcSprefix = document.getElementById("gc-sprefix") as HTMLSelectElement;
        const gcRprefix = document.getElementById("gc-rprefix") as HTMLSelectElement;
        const gcSfname = document.getElementById("gc-sfname") as HTMLInputElement;
        const gcSlname = document.getElementById("gc-slname") as HTMLInputElement;
        const gcSemail = document.getElementById("gc-semail") as HTMLInputElement;
        const gcSphone = document.getElementById("gc-sphone") as HTMLInputElement;
        const gcMsg = document.getElementById("gc-msg") as HTMLTextAreaElement;
        const gcSave = document.getElementById("gc-save") as HTMLButtonElement;
        const gcNext = document.getElementById("gc-next") as HTMLButtonElement;
        const gcPrev = document.getElementById("gc-prev") as HTMLButtonElement;
        const gcRecap = document.getElementById("gc-recap") as HTMLDivElement;
        const gcShip = document.getElementById("gc-ship") as HTMLInputElement;
        const gcShipBox = document.getElementById("gc-ship-box") as HTMLDivElement;
        const gcShipAddress = document.getElementById("gc-ship-address") as HTMLInputElement;
        const gcShipZip = document.getElementById("gc-ship-zip") as HTMLInputElement;
        const gcShipCity = document.getElementById("gc-ship-city") as HTMLInputElement;
        const gcShipCountry = document.getElementById("gc-ship-country") as HTMLInputElement;
        const gcShipCents = document.getElementById("gc-ship-cents") as HTMLInputElement;
        const gcSendPicks = document.getElementById("gc-send-picks") as HTMLDivElement;
        const gcSendHint = document.getElementById("gc-send-hint") as HTMLParagraphElement;
        const gcPayPicks = document.getElementById("gc-pay-picks") as HTMLDivElement;
        const gcPayHint = document.getElementById("gc-pay-hint") as HTMLParagraphElement;
        const gcTitle = document.getElementById("gc-title") as HTMLHeadingElement;
        const gcResend = document.getElementById("gc-resend") as HTMLButtonElement;
        const gcSendBox = document.getElementById("gc-send-box") as HTMLDivElement;
        const gcErr = document.getElementById("gc-err") as HTMLSpanElement;
        const gcUseOverlay = document.getElementById("gc-use-overlay") as HTMLDivElement;
        const gcUseClose = document.getElementById("gc-use-close") as HTMLButtonElement;
        const gcUseInfo = document.getElementById("gc-use-info") as HTMLParagraphElement;
        const gcUseAmount = document.getElementById("gc-use-amount") as HTMLInputElement;
        const gcUseNote = document.getElementById("gc-use-note") as HTMLInputElement;
        const gcUseSave = document.getElementById("gc-use-save") as HTMLButtonElement;
        const gcUseErr = document.getElementById("gc-use-err") as HTMLSpanElement;

        interface GiftCard {
          id: string; code: string; initial_cents: number; balance_cents: number;
          active: boolean; expires_at: string | null; recipient_name: string | null;
          sender_name: string | null; message: string | null; uses?: number;
          paid?: boolean; payment_method?: string;
          recipient_email?: string | null; recipient_phone?: string | null;
          sender_email?: string | null; sender_phone?: string | null;
          ship?: boolean; ship_address?: string | null; ship_zip?: string | null;
          ship_city?: string | null; ship_country?: string | null; shipping_cents?: number | null;
        }
        let giftCards: GiftCard[] = [];
        let gcUseId: string | null = null;
        let gcEditId: string | null = null;
        let gcDelPending: string | null = null;
        let gcDelTimer: number | undefined;

        const gcEuro = (cents: number): string => (cents / 100).toFixed(2).replace(".", ",") + " €";
        const gcDate = (d: string | null): string => (d ? d.split("-").reverse().join("/") : "");
        const gcOggi = (): string => new Date().toISOString().slice(0, 10);
        const centsDaEuro = (v: string): number => {
          const n = parseFloat(String(v).replace(",", "."));
          return Number.isFinite(n) && n > 0 ? Math.round(n * 100) : 0;
        };
        const gcDialDefault = PREFISSI.find((pr) => pr.code === CLIENT.paese)?.dial ?? "+32";
        const gcOptsPrefix = PREFISSI.map((pr) => `<option value="${pr.dial}"${pr.dial === gcDialDefault ? " selected" : ""}>${pr.flag} ${pr.dial}</option>`).join("");
        if (gcSprefix) gcSprefix.innerHTML = gcOptsPrefix;
        if (gcRprefix) gcRprefix.innerHTML = gcOptsPrefix;
        function gcTelFull(prefix: HTMLSelectElement, input: HTMLInputElement): string | undefined {
          const raw = input.value.trim();
          if (!raw) return undefined;
          const sep = separaPrefisso(raw);
          if (sep) return `${sep.dial} ${sep.resto}`.trim();
          const local = raw.replace(/[\s\-().]/g, "").replace(/^0/, "");
          return `${prefix.value} ${local}`.trim();
        }

        function gcRender() {
          if (giftCards.length === 0) {
            gcList.innerHTML = "";
            gcEmpty.style.display = "block";
            return;
          }
          gcEmpty.style.display = "none";
          const oggi = gcOggi();
          gcList.innerHTML = giftCards
            .map((c) => {
              const esaurito = c.balance_cents <= 0;
              const scaduto = !!c.expires_at && String(c.expires_at) < oggi;
              const usabile = c.active && !esaurito && !scaduto && c.paid !== false;
              // Pillola di stato solo per ciò che lo switch NON dice già
              const tags: string[] = [];
              if (esaurito) tags.push(`<span class="m-tag">${tr("mk.exhausted")}</span>`);
              else if (scaduto) tags.push(`<span class="m-tag">${tr("mk.expired")}</span>`);
              const righe: string[] = [];
              if (c.recipient_name) righe.push(`<span class="gc-line">${tr("mk.gcFor")} <b>${esc(c.recipient_name)}</b></span>`);
              if (c.sender_name) righe.push(`<span class="gc-line">${tr("mk.gcFrom")} <b>${esc(c.sender_name)}</b></span>`);
              if (c.expires_at) righe.push(`<span class="gc-line">${tr("mk.gcExpiresOn")} <b>${gcDate(c.expires_at)}</b></span>`);
              const pagato = c.paid !== false;
              const badgePay = pagato
                ? `<span class="gc-pay ok" title="${tr("ord.paid")}"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>`
                : `<span class="gc-pay wait" title="${tr("ord.awaitingPayment")}"><svg viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg></span>`;
              const nUsi = Number(c.uses ?? 0);
              righe.push(`<span class="gc-line">${tr("mk.gcUsed")} <b>${nUsi}</b> ${tr("mk.times")}</span>`);
              const useBtn = usabile
                ? `<button data-use="${c.id}" style="border:1px solid var(--c-accent);color:var(--c-accent);background:none;border-radius:999px;padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;cursor:pointer;font-family:inherit">${tr("mk.use")}</button>`
                : "";
              return `
                <div class="pop ${usabile ? "" : "is-off"} ${pagato ? "" : "is-pending"}">
                  ${badgePay}
                  <div class="pop-top"><div class="pop-title">${esc(c.code)}</div></div>
                  <div class="gc-val">${gcEuro(c.balance_cents)}<span class="gc-val-sur">/ ${gcEuro(c.initial_cents)}</span></div>
                  ${righe.length ? `<div class="gc-lines">${righe.join("")}</div>` : ""}
                  ${tags.length ? `<div class="pop-meta">${tags.join("")}</div>` : ""}
                  <div class="pop-actions">
                    ${useBtn}
                    <span class="sw-wrap">
                      <label class="switch"><input type="checkbox" data-toggle="${c.id}" ${c.active ? "checked" : ""} /><span class="track"></span></label>
                      <span class="sw-lab">${tr("menu.active")}</span>
                    </span>
                    <button class="i-btn i-edit" data-edit="${c.id}" aria-label="${tr("common.edit")}">${ICO_PEN}</button>
                    <button class="i-btn i-del" data-del="${c.id}" aria-label="${tr("common.delete")}">${ICO_TRASH}</button>
                  </div>
                </div>`;
            })
            .join("");
        }

        async function caricaGiftcards() {
          try {
            const res = await fetch("/api/admin/gift-cards", { headers });
            if (!res.ok) { toast(tr("mk.giftsLoadErr"), true); return; }
            const j = (await res.json()) as { cards: GiftCard[] };
            giftCards = j.cards ?? [];
            gcRender();
          } catch {
            toast(tr("res.connErr"), true);
          }
        }

        // Apre il modale multi-step: vuoto (nuovo) o precompilato (modifica)
        function gcApri(c: GiftCard | null) {
          gcEditId = c?.id ?? null;
          gcErr.textContent = "";
          const nomi = (v: string | null | undefined): [string, string] => {
            const p2 = String(v ?? "").trim().split(/\s+/).filter(Boolean);
            return [p2[0] ?? "", p2.slice(1).join(" ")];
          };
          const tel = (v: string | null | undefined, pre: HTMLSelectElement, inp: HTMLInputElement) => {
            const sep = v ? separaPrefisso(String(v)) : null;
            pre.value = sep?.dial ?? gcDialDefault;
            inp.value = sep ? sep.resto : String(v ?? "").trim();
          };
          const [sf, sl] = nomi(c?.sender_name);
          const [rf, rl] = nomi(c?.recipient_name);
          gcSfname.value = sf; gcSlname.value = sl; gcSemail.value = c?.sender_email ?? "";
          gcRfname.value = rf; gcRlname.value = rl; gcRemail.value = c?.recipient_email ?? "";
          tel(c?.sender_phone, gcSprefix, gcSphone);
          tel(c?.recipient_phone, gcRprefix, gcRphone);
          gcMsg.value = c?.message ?? "";
          gcCode.value = c?.code ?? "";

          // Valore: preset se combacia, altrimenti « Autre »
          gcValPicks.querySelectorAll(".pick").forEach((el) => el.classList.remove("is-on"));
          gcValue.value = ""; gcValue.style.display = "none";
          if (c) {
            const euros = String(Math.round(c.initial_cents / 100));
            const preset = gcValPicks.querySelector(`[data-val="${euros}"]`) as HTMLElement | null;
            if (preset && c.initial_cents % 100 === 0) preset.classList.add("is-on");
            else {
              gcValPicks.querySelector('[data-val="autre"]')?.classList.add("is-on");
              gcValue.style.display = "";
              gcValue.value = (c.initial_cents / 100).toFixed(2);
            }
          }

          // Scadenza
          gcExpPicks.querySelectorAll(".pick").forEach((el) => el.classList.remove("is-on"));
          gcExp.removeAttribute("data-iso"); gcExp.value = ""; gcExp.style.display = "none";
          if (c?.expires_at) {
            gcExpPicks.querySelector('[data-exp="autre"]')?.classList.add("is-on");
            gcExp.dataset.iso = String(c.expires_at);
            gcExp.value = fmtFr(String(c.expires_at));
            gcExp.style.display = "";
          } else {
            gcExpPicks.querySelector('[data-exp="none"]')?.classList.add("is-on");
          }

          // Spedizione
          gcShip.checked = !!c?.ship;
          gcShipBox.style.display = c?.ship ? "" : "none";
          gcShipAddress.value = c?.ship_address ?? "";
          gcShipZip.value = c?.ship_zip ?? "";
          gcShipCity.value = c?.ship_city ?? "";
          gcShipCountry.value = c?.ship_country ?? "";
          gcShipCents.value = c?.shipping_cents ? (Number(c.shipping_cents) / 100).toFixed(2) : "";

          // Pagamento (in modifica non si tocca se già pagato)
          const pm = c?.payment_method ?? "cash";
          gcPayPicks.querySelectorAll(".pick").forEach((el) => el.classList.remove("is-on"));
          (gcPayPicks.querySelector(`[data-pay="${pm}"]`) ?? gcPayPicks.querySelector('[data-pay="cash"]'))?.classList.add("is-on");
          const bloccato = !!c && c.paid !== false;
          gcPayPicks.querySelectorAll<HTMLElement>(".pick").forEach((el) => el.classList.toggle("is-off", bloccato));
          gcPayHint.textContent = bloccato
            ? tr("mk.payHintLocked")
            : pm === "link"
              ? tr("mk.payHintLink")
              : tr("mk.payHintCash");

          gcSendPicks.querySelectorAll(".pick").forEach((el) => el.classList.remove("is-on"));
          gcResend.style.display = c && c.paid === false && (c.payment_method ?? "") === "link" ? "" : "none";
          gcSendBox.style.display = c ? "none" : "";
          gcTitle.textContent = c ? tr("mk.editGift") : tr("mk.newGift");
          gcSave.textContent = c ? tr("common.save") : tr("us.gen");
          gcStep(1);
          gcOverlay.classList.add("is-open");
        }
        gcAdd?.addEventListener("click", () => gcApri(null));

        // ---------- Acheter des bons imprimés (paiement MOODD) ----------
        const gsOverlay = document.getElementById("gs-overlay") as HTMLDivElement;
        const gsClose = document.getElementById("gs-close") as HTMLButtonElement;
        const gsPacks = document.getElementById("gs-packs") as HTMLDivElement;
        const gsMsg = document.getElementById("gs-msg") as HTMLParagraphElement;
        const gsHist = document.getElementById("gs-hist") as HTMLDivElement;
        const gcShop = document.getElementById("gc-shop") as HTMLButtonElement;

        async function gsStorico() {
          try {
            const res = await fetch("/api/admin/gift-cards-shop", { headers });
            if (!res.ok) return;
            const j = (await res.json()) as { purchases?: { qty: number; amount_cents: number; created_at: string }[] };
            const list = j.purchases ?? [];
            gsHist.innerHTML = list.length
              ? `<p class="f-lab" style="margin-top:1.4rem">${tr("mk.previousPurchases")}</p>` +
                list.map((a) => {
                  const d = String(a.created_at ?? "").slice(0, 10).split("-").reverse().join("/");
                  return `<div class="gs-hist-row"><span>${d}</span><span>${a.qty} ${tr("mk.vouchers")} · ${gcEuro(a.amount_cents)}</span></div>`;
                }).join("")
              : "";
          } catch { /* rete assente */ }
        }

        gcShop?.addEventListener("click", () => {
          gsMsg.textContent = "";
          gsOverlay.classList.add("is-open");
          void gsStorico();
        });
        gsClose?.addEventListener("click", () => gsOverlay.classList.remove("is-open"));
        gsOverlay?.addEventListener("click", (e) => { if (e.target === gsOverlay) gsOverlay.classList.remove("is-open"); });

        gsPacks?.addEventListener("click", async (e) => {
          const b = (e.target as HTMLElement).closest(".gs-pack") as HTMLButtonElement | null;
          if (!b) return;
          gsMsg.textContent = tr("mk.redirectPayment");
          gsPacks.querySelectorAll("button").forEach((x) => (x.disabled = true));
          try {
            const res = await fetch("/api/admin/gift-cards-shop", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ pack: b.dataset.pack }),
            });
            const j = await res.json();
            if (!res.ok || !j.url) { gsMsg.textContent = j.error ?? tr("mk.paymentFailed"); return; }
            window.location.href = j.url;
          } catch {
            gsMsg.textContent = tr("common.netErr");
          } finally {
            gsPacks.querySelectorAll("button").forEach((x) => (x.disabled = false));
          }
        });

        // Ritorno da Stripe: conferma l'acquisto e pulisce l'URL
        (async () => {
          const sid = new URLSearchParams(window.location.search).get("cards_session");
          if (!sid) return;
          try {
            const res = await fetch("/api/admin/gift-cards-shop", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ session_id: sid }),
            });
            const j = await res.json();
            if (res.ok) toast(tr("mk.orderConfirmed").replace("{n}", String(j.qty)));
            else toast(j.error ?? tr("mk.paymentNotConfirmed"), true);
          } catch {
            toast(tr("res.connErr"), true);
          }
          const u = new URL(window.location.href);
          u.searchParams.delete("cards_session");
          window.history.replaceState({}, "", u.toString());
        })();
        gcValPicks?.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (!el) return;
          gcValPicks.querySelectorAll(".pick").forEach((x) => x.classList.remove("is-on"));
          el.classList.add("is-on");
          if (el.dataset.val === "autre") { gcValue.style.display = ""; gcValue.value = ""; gcValue.focus(); }
          else gcValue.style.display = "none";
          gcNext.disabled = gcStepN === 1 && !gcValoreCents();
        });
        gcValue?.addEventListener("input", () => { gcNext.disabled = gcStepN === 1 && !gcValoreCents(); });
        gcShip?.addEventListener("change", () => { gcShipBox.style.display = gcShip.checked ? "" : "none"; });
        gcPayPicks?.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (!el || el.classList.contains("is-off")) return;
          gcPayPicks.querySelectorAll(".pick").forEach((x) => x.classList.remove("is-on"));
          el.classList.add("is-on");
          gcPayHint.textContent = el.dataset.pay === "link"
            ? tr("mk.payHintLink")
            : tr("mk.payHintCash");
        });
        gcResend?.addEventListener("click", async () => {
          if (!gcEditId) return;
          gcErr.textContent = "";
          gcResend.disabled = true;
          try {
            const res = await fetch("/api/admin/gift-cards", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ action: "resend_link", id: gcEditId, sender_email: gcSemail.value.trim() || undefined }),
            });
            const j = await res.json();
            if (!res.ok) { gcErr.textContent = j.error ?? tr("ord.sendFailed"); return; }
            toast(tr("mk.payLinkResentTo") + (j.sent_to ?? ""));
          } catch {
            gcErr.textContent = tr("common.netErr");
          } finally {
            gcResend.disabled = false;
          }
        });
        gcSendPicks?.addEventListener("click", (e) => {
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (!el || el.classList.contains("is-off")) return;
          el.classList.toggle("is-on");
        });
        function isoPlus(mesi: number, anni: number): string {
          const [y, m, d] = isoOggi().split("-").map(Number);
          const dt = new Date(Date.UTC(y, m - 1, d));
          dt.setUTCFullYear(dt.getUTCFullYear() + anni);
          dt.setUTCMonth(dt.getUTCMonth() + mesi);
          return dt.toISOString().slice(0, 10);
        }
        gcExpPicks?.addEventListener("click", (e) => {
          e.stopPropagation();
          const el = (e.target as HTMLElement).closest(".pick") as HTMLElement | null;
          if (!el) return;
          gcExpPicks.querySelectorAll(".pick").forEach((x) => x.classList.remove("is-on"));
          el.classList.add("is-on");
          const mode = el.dataset.exp;
          if (mode === "none") { gcExp.removeAttribute("data-iso"); gcExp.value = ""; gcExp.style.display = "none"; return; }
          if (mode === "autre") { gcExp.style.display = ""; dpApri(gcExp); return; }
          let iso = "";
          if (mode === "1m") iso = isoPlus(1, 0);
          else if (mode === "6m") iso = isoPlus(6, 0);
          else if (mode === "1y") iso = isoPlus(0, 1);
          else if (mode === "eoy") iso = isoOggi().slice(0, 4) + "-12-31";
          gcExp.dataset.iso = iso;
          gcExp.value = fmtFr(iso);
          gcExp.style.display = "";
        });
        gcExp?.addEventListener("click", (e) => {
          if (gcExpPicks.querySelector(".pick.is-on")?.getAttribute("data-exp") !== "autre") return;
          e.stopPropagation();
          dpApri(gcExp);
        });
        gcClose?.addEventListener("click", () => gcOverlay.classList.remove("is-open"));
        gcOverlay?.addEventListener("click", (e) => { if (e.target === gcOverlay) gcOverlay.classList.remove("is-open"); });

        // --- Navigazione multi-step ---
        let gcStepN = 1;
        function gcValoreCents(): number {
          const attivo = gcValPicks.querySelector(".pick.is-on") as HTMLElement | null;
          if (!attivo) return 0;
          return attivo.dataset.val === "autre" ? centsDaEuro(gcValue.value) : Math.round(Number(attivo.dataset.val) * 100);
        }
        function gcStep(n: number) {
          gcStepN = n;
          gcOverlay.querySelectorAll<HTMLElement>(".gc-pane").forEach((pane) => {
            pane.style.display = pane.dataset.pane === String(n) ? "block" : "none";
          });
          gcOverlay.querySelectorAll<HTMLElement>(".gc-step").forEach((st) => {
            const sn = Number(st.dataset.s);
            st.classList.toggle("is-on", sn === n);
            st.classList.toggle("done", sn < n);
          });
          gcPrev.style.display = n > 1 ? "" : "none";
          gcNext.style.display = n < 4 ? "" : "none";
          gcSave.style.display = n === 4 ? "" : "none";
          gcNext.disabled = n === 1 && !gcValoreCents();
          gcErr.textContent = "";
          if (n === 4) gcBuildRecap();
        }
        function gcBuildRecap() {
          const val = gcValoreCents();
          const exp = gcExp.dataset.iso ? fmtFr(gcExp.dataset.iso) : tr("itg.mode.none");
          const code = gcCode.value.trim() || tr("mk.autoGenerated");
          const offrant = [`${gcSfname.value.trim()} ${gcSlname.value.trim()}`.trim(), gcSemail.value.trim(), gcTelFull(gcSprefix, gcSphone) ?? ""].filter(Boolean).join(" · ") || "—";
          const dest = [`${gcRfname.value.trim()} ${gcRlname.value.trim()}`.trim(), gcRemail.value.trim(), gcTelFull(gcRprefix, gcRphone) ?? ""].filter(Boolean).join(" · ") || "—";
          const msg = gcMsg.value.trim() || "—";
          const row = (k: string, v: string) => `<div class="r-row"><span class="r-k">${k}</span><span class="r-v">${esc(v)}</span></div>`;
          const cell = (ico: string, k: string, v: string) => `<div class="gc-cell"><div class="gc-cell-head"><span class="gc-cell-ico">${ico}</span><span class="gc-cell-k">${esc(k)}</span></div><span class="gc-cell-v">${esc(v)}</span></div>`;
          const ICO_VAL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 7A5.5 5.5 0 1 0 15.5 17"/><path d="M4 10.5h9"/><path d="M4 13.5h8"/></svg>';
          const ICO_EXP = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18"/><path d="M8 3v3"/><path d="M16 3v3"/></svg>';
          const ICO_COD = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 4L7.5 20"/><path d="M16.5 4l-2 16"/><path d="M4 9h16"/><path d="M3 15h16"/></svg>';
          const ICO_PAY = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 9.5h19"/><path d="M6 15h4"/></svg>';
          const spedizione = gcShip.checked
            ? [gcShipAddress.value.trim(), [gcShipZip.value.trim(), gcShipCity.value.trim()].filter(Boolean).join(" "), gcShipCountry.value.trim()].filter(Boolean).join(", ") || tr("mk.yes")
            : "";
          const fraisC = gcShip.checked ? centsDaEuro(gcShipCents.value) : 0;
          const metodoTxt = (gcPayPicks.querySelector(".pick.is-on") as HTMLElement | null)?.textContent?.trim() || "—";
          gcRecap.innerHTML =
            `<div class="gc-grid">` +
              cell(ICO_VAL, tr("menu.value"), val ? gcEuro(val) : "—") +
              cell(ICO_EXP, tr("mk.expiration"), exp) +
              cell(ICO_COD, tr("mk.code"), code) +
              cell(ICO_PAY, tr("mk.payment"), metodoTxt) +
            `</div>` +
            row(tr("mk.givenBy"), offrant) +
            row(tr("mk.giftStep3"), dest) +
            (spedizione ? row(tr("mk.postalDelivery"), spedizione) : "") +
            (fraisC ? row(tr("mk.shippingFee"), gcEuro(fraisC)) : "") +
            row(tr("mk.message"), msg);
          // Pulsanti email: attivi solo se c'è l'indirizzo corrispondente
          const emailDest = gcRemail.value.trim();
          const emailOffr = gcSemail.value.trim();
          const pd = gcSendPicks.querySelector('[data-send="recipient"]') as HTMLElement | null;
          const po = gcSendPicks.querySelector('[data-send="sender"]') as HTMLElement | null;
          pd?.classList.toggle("is-off", !emailDest);
          po?.classList.toggle("is-off", !emailOffr);
          if (!emailDest) pd?.classList.remove("is-on");
          if (!emailOffr) po?.classList.remove("is-on");
          // Lien de paiement: l'email all'offrant è selezionata di default
          // (è lì che si trova il bouton « Payer maintenant »).
          const metodo = (gcPayPicks.querySelector(".pick.is-on") as HTMLElement | null)?.dataset.pay ?? "cash";
          if (metodo === "link" && emailOffr) po?.classList.add("is-on");
          gcSendHint.textContent = !emailDest && !emailOffr
            ? tr("mk.addEmailToSend")
            : metodo === "link"
              ? tr("mk.payLinkWithGiver")
              : tr("mk.clickToSelectSends");
        }
        gcNext?.addEventListener("click", () => {
          if (gcStepN === 1 && !gcValoreCents()) { gcErr.textContent = tr("mk.chooseValue");return; }
          gcStep(Math.min(4, gcStepN + 1));
        });
        gcPrev?.addEventListener("click", () => gcStep(Math.max(1, gcStepN - 1)));

        gcSave?.addEventListener("click", async () => {
          gcErr.textContent = "";
          const value_cents = gcValoreCents();
          if (!value_cents) { gcErr.textContent = tr("mk.chooseValue");gcStep(1); return; }
          gcSave.disabled = true;
          try {
            const res = await fetch("/api/admin/gift-cards", {
              method: gcEditId ? "PUT" : "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({
                id: gcEditId ?? undefined,
                value_cents,
                code: gcCode.value.trim() || undefined,
                expires_at: gcExp.dataset.iso || undefined,
                recipient_name: `${gcRfname.value.trim()} ${gcRlname.value.trim()}`.trim() || undefined,
                recipient_email: gcRemail.value.trim() || undefined,
                recipient_phone: gcTelFull(gcRprefix, gcRphone),
                sender_name: `${gcSfname.value.trim()} ${gcSlname.value.trim()}`.trim() || undefined,
                sender_email: gcSemail.value.trim() || undefined,
                sender_phone: gcTelFull(gcSprefix, gcSphone),
                message: gcMsg.value.trim() || undefined,
                payment_method: (gcPayPicks.querySelector(".pick.is-on") as HTMLElement | null)?.dataset.pay ?? "cash",
                ship: gcShip.checked,
                ship_address: gcShipAddress.value.trim() || undefined,
                ship_zip: gcShipZip.value.trim() || undefined,
                ship_city: gcShipCity.value.trim() || undefined,
                ship_country: gcShipCountry.value.trim() || undefined,
                shipping_cents: gcShip.checked ? centsDaEuro(gcShipCents.value) : 0,
                send_recipient: !!gcSendPicks.querySelector('[data-send="recipient"].is-on'),
                send_sender: !!gcSendPicks.querySelector('[data-send="sender"].is-on'),
              }),
            });
            const j = await res.json();
            if (!res.ok) { gcErr.textContent = j.error ?? tr("common.saveErr"); return; }
            gcOverlay.classList.remove("is-open");
            if (j.pay_error) toast(tr("mk.giftCreatedNoLink") + j.pay_error, true);
            else if (gcEditId) toast(tr("mk.giftUpdated"));
            else toast(tr("mk.giftCreated") + (j.code ?? ""));
            await caricaGiftcards();
          } catch {
            gcErr.textContent = tr("common.netErr");
          } finally {
            gcSave.disabled = false;
          }
        });

        gcUseClose?.addEventListener("click", () => gcUseOverlay.classList.remove("is-open"));
        gcUseOverlay?.addEventListener("click", (e) => { if (e.target === gcUseOverlay) gcUseOverlay.classList.remove("is-open"); });

        gcUseSave?.addEventListener("click", async () => {
          if (!gcUseId) return;
          gcUseErr.textContent = "";
          const amount_cents = centsDaEuro(gcUseAmount.value);
          if (!amount_cents) { gcUseErr.textContent = tr("ord.invalidAmount"); return; }
          gcUseSave.disabled = true;
          try {
            const res = await fetch("/api/admin/gift-cards", {
              method: "POST",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ action: "redeem", id: gcUseId, amount_cents, note: gcUseNote.value.trim() || undefined }),
            });
            const j = await res.json();
            if (!res.ok) { gcUseErr.textContent = j.error ?? tr("mk.cashInFailed"); return; }
            gcUseOverlay.classList.remove("is-open");
            toast(tr("mk.collectedBalance") + gcEuro(j.balance_cents ?? 0));
            await caricaGiftcards();
          } catch {
            gcUseErr.textContent = tr("common.netErr");
          } finally {
            gcUseSave.disabled = false;
          }
        });

        gcList?.addEventListener("click", async (e) => {
          const t = e.target as HTMLElement;
          const useB = t.closest("[data-use]") as HTMLElement | null;
          if (useB) {
            const c = giftCards.find((x) => x.id === useB.dataset.use);
            if (!c) return;
            gcUseId = c.id;
            gcUseErr.textContent = "";
            gcUseAmount.value = "";
            gcUseNote.value = "";
            gcUseInfo.textContent = `${c.code} — ${tr("mk.balance")} ${gcEuro(c.balance_cents)}`;
            gcUseOverlay.classList.add("is-open");
            return;
          }
          const editB = t.closest("[data-edit]") as HTMLElement | null;
          if (editB) {
            const c = giftCards.find((x) => x.id === editB.dataset.edit);
            if (c) gcApri(c);
            return;
          }
          const delB = t.closest("[data-del]") as HTMLElement | null;
          if (delB) {
            const id = delB.dataset.del as string;
            if (gcDelPending === id) {
              window.clearTimeout(gcDelTimer);
              gcDelPending = null;
              try {
                const res = await fetch(`/api/admin/gift-cards?id=${id}`, { method: "POST", headers: { ...headers, "X-Method-Override": "DELETE" } });
                if (!res.ok) { toast(tr("us.delErr"), true); return; }
                toast(tr("mk.giftDeleted"));
                giftCards = giftCards.filter((x) => x.id !== id);
                gcRender();
              } catch { toast(tr("res.connErr"), true); }
              return;
            }
            gcDelPending = id;
            delB.classList.add("confirm");
            delB.textContent = tr("common.confirm");
            window.clearTimeout(gcDelTimer);
            gcDelTimer = window.setTimeout(() => {
              gcDelPending = null;
              delB.classList.remove("confirm");
              delB.innerHTML = ICO_TRASH;
            }, 3000);
          }
        });

        gcList?.addEventListener("change", async (e) => {
          const sw = e.target as HTMLInputElement;
          if (!sw.dataset.toggle) return;
          const id = sw.dataset.toggle;
          try {
            const res = await fetch("/api/admin/gift-cards", {
              method: "PUT",
              headers: { ...headers, "Content-Type": "application/json" },
              body: JSON.stringify({ id, active: sw.checked }),
            });
            if (!res.ok) { sw.checked = !sw.checked; toast(tr("common.saveErr"), true); return; }
            const c = giftCards.find((x) => x.id === id);
            if (c) c.active = sw.checked;
            gcRender();
          } catch {
            sw.checked = !sw.checked;
            toast(tr("res.connErr"), true);
          }
        });

      })();
    </script>
  </body>
</html>
