          try {
            const foto = await comprimiFoto(file);
            if (foto.size > 4 * 1024 * 1024) {
              fUploadState.textContent = "Fichier trop lourd (max 4 Mo).";
              return;
            }
            fUploadState.textContent = "Téléversement…";
            const base64 = await new Promise<string>((res, rej) => {
              const r = new FileReader();
              r.onload = () => res(String(r.result).split(",")[1] ?? "");
              r.onerror = () => rej(new Error());
              r.readAsDataURL(foto);
            });
            const resp = await fetch("/api/admin/upload", {
              method: "POST",
              headers,
              body: JSON.stringify({ filename: foto.name, data: base64 }),
            });
            const j = await resp.json();
            if (!resp.ok) {
              fUploadState.textContent = j.error ?? "Erreur de téléversement";
              return;
            }
            fImg.value = j.url;
            fUploadState.textContent = "Image téléversée ✓";
