              }
              toast("Pop-up supprimé");
              await carica();
            } catch {
              toast("Erreur de connexion", true);
            }
            return;
          }

          const sw = t.closest(".t-active") as HTMLInputElement | null;
          if (sw) {
            try {
              const res = await fetch("/api/admin/popups", {
                method: "PUT",
