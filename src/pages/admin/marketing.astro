        // ---------- Newsletter ----------
        const nSent = document.getElementById("n-sent") as HTMLSpanElement;
        const nRemaining = document.getElementById("n-remaining") as HTMLDivElement;
        const nRecipients = document.getElementById("n-recipients") as HTMLDivElement;
        const nSubject = document.getElementById("n-subject") as HTMLInputElement;
