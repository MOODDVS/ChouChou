---
// Pannello admin — MARKETING.
// Tab "Pop-up": gestione dei modali di comunicazione del sito pubblico.
// Ogni pop-up: immagine/titolo/testo/max 2 bottoni (facoltativi tranne il
// titolo), scelta delle pagine, programmazione (sempre / date / giorni+ore)
// e numero massimo di visualizzazioni per visitatore.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHead from "../../components/admin/AdminHead.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import ImagePicker from "../../components/admin/ImagePicker.astro";
import { CLIENT } from "../../config/client";
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";
import "../../styles/datepicker.css";
import { caricaBootAdmin } from "../../lib/admin/adminBoot";
import { LINGUE_PUBBLICHE } from "../../lib/admin/superAdmin";
import { SITE_PAGES } from "../../config/sitePages";

const lang = await adminLang();
const t = adminT(lang);
const boot = await caricaBootAdmin();
const pubLangsJson = JSON.stringify({
  langs: boot.publicLangs,
  def: boot.publicLangDefault,
  labels: Object.fromEntries(LINGUE_PUBBLICHE.map((l) => [l.code, { label: l.label, flag: l.flag }])),
});
const sitePagesJson = JSON.stringify(SITE_PAGES);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("nav.marketing") + " — Admin " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@700&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-hover: #e04f00;
        --c-input: #e6e6e6;
        --c-bg: #ffffff;
        --c-text: #666666;
        --c-accent: #ff7300;
        --c-muted: #a6a6a6;
        --c-line: #ebebeb;
        --c-card: #ffffff;
        --font-title: "Quicksand", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; overflow-x: hidden; }
      #app { display: none; min-height: 100vh; flex-direction: column; }

      main { flex: 1; padding: 2rem 2rem 8rem; width: 100%; }
      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; margin-bottom: 1.25rem; }
      h1 svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .state { color: var(--c-muted); text-align: center; padding: 3rem 1rem; }

      /* Tabs (come Réglages) */
      .mtabs { display: flex; gap: 0.4rem; flex-wrap: wrap; padding-bottom: 1.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--c-line); }
      .t-ico {
        width: 16px; height: 16px; margin-right: 0.45rem; vertical-align: -3px;
        fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
      }
      .mtab {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.05em;
        padding: 0.5rem 1.2rem; cursor: pointer; border-radius: 10px;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .mtab:hover { color: var(--c-text); border-color: var(--c-accent); }
      .mtab.is-active { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }

      .actionsbar { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
      .pill {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        font-family: var(--font-body); font-weight: 700; font-size: 0.85rem;
        padding: 0.55rem 1.1rem; cursor: pointer; border-radius: 999px;
        transition: border-color 0.2s;
      }
      .pill:hover { border-color: var(--c-accent); }
      #c-buy { background: var(--c-input); }
      /* Pillole segmenti/programmazione nel modale newsletter */
      .seg-row { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
      .seg-pill {
        background: var(--c-input); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-body); font-weight: 700; font-size: 0.8rem;
        padding: 0.45rem 0.9rem; border-radius: 999px; cursor: pointer;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
      }
      .seg-pill:hover { border-color: var(--c-accent); color: var(--c-text); }
      .seg-pill.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .seg-pill .n { opacity: 0.7; margin-left: 0.3rem; }
      .np-del {
        background: none; border: 1px solid var(--c-line); color: var(--c-muted);
        width: 26px; height: 26px; border-radius: 50%; cursor: pointer; flex-shrink: 0;
        transition: border-color 0.15s, color 0.15s;
      }
      .np-del:hover, .np-del.confirm { border-color: #ed1c24; color: #ff8a8f; }
      /* Card di brouillons e programmate */
      .nn-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 0.9rem; align-items: start; margin-bottom: 1.5rem; }
      .nn-card {
        display: flex; flex-direction: column; gap: 0.5rem;
        background: var(--c-card); border: 1px solid var(--c-line);
        padding: 1rem 1.1rem; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15)));
      }
      .nn-card.is-click { cursor: pointer; transition: border-color 0.15s; }
      .nn-card.is-click:hover { border-color: var(--c-accent); }
      .nn-tit { font-family: var(--font-title); font-size: 1.2rem; letter-spacing: 0.04em; color: var(--c-accent); }
      .nn-msg { color: var(--c-muted); font-size: 0.8rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .nn-foot { display: flex; align-items: center; gap: 0.6rem; border-top: 1px solid var(--c-line); padding-top: 0.6rem; margin-top: 0.2rem; font-size: 0.75rem; color: var(--c-muted); }
      .nn-foot .nn-quando { margin-right: auto; color: var(--c-text); font-weight: 700; }
      .nn-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
      .nn-tag {
        display: inline-block; background: var(--c-accent); color: var(--c-bg);
        font-size: 0.68rem; font-weight: 800; letter-spacing: 0.04em;
        padding: 0.2rem 0.6rem; border-radius: 999px;
      }
      .nn-img {
        width: calc(100% + 2.2rem); margin: -1rem -1.1rem 0.35rem;
        height: 130px; object-fit: cover; display: block;
        border-bottom: 1px solid var(--c-line);
      }

      /* Card pop-up */
      .pops { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.25rem; }
      .pop {
        background: var(--c-card); border: 1px solid var(--c-line);
        padding: 1.25rem; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15)));
        display: flex; flex-direction: column; gap: 0.7rem;
      }
      .pop.is-off { opacity: 0.55; }
      .pop-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.8rem; }
      .pop-title { font-family: var(--font-title); font-size: 1.35rem; letter-spacing: 0.03em; }
      .pop-text { color: var(--c-muted); font-size: 0.88rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .pop-meta { display: flex; flex-wrap: wrap; gap: 0.35rem; }
      .m-tag {
        display: inline-block; padding: 0.16rem 0.55rem; border: 1px solid var(--c-line);
        border-radius: 999px; color: var(--c-muted); font-size: 0.7rem;
        text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap;
      }
      .m-tag.gold { border-color: color-mix(in srgb, var(--c-accent) 50%, transparent); color: var(--c-accent); }
      .pop-actions { display: flex; align-items: center; gap: 0.6rem; border-top: 1px solid var(--c-line); padding-top: 0.9rem; margin-top: auto; }

      /* Switch */
      .sw-wrap { display: inline-flex; align-items: center; gap: 0.5rem; }
      .sw-lab { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); }
      .switch { position: relative; display: inline-block; width: 46px; height: 26px; flex-shrink: 0; }
      .switch input { opacity: 0; width: 0; height: 0; }
      .switch .track {
        position: absolute; inset: 0; cursor: pointer; border-radius: 999px;
        background: var(--c-line); transition: background 0.2s;
      }
      .switch .track::before {
        content: ""; position: absolute; width: 20px; height: 20px; left: 3px; top: 3px;
        border-radius: 50%; background: var(--c-bg); transition: transform 0.2s;
      }
      .switch input:checked + .track { background: var(--c-accent); }
      .switch input:checked + .track::before { transform: translateX(20px); }

      /* Bottoni icona (come le altre pagine admin) */
      .i-btn {
        width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
        background: transparent; border: 1px solid var(--c-line); border-radius: 50%;
        color: var(--c-muted); cursor: pointer; font-size: 0.95rem;
        transition: border-color 0.2s, color 0.2s, background 0.2s;
      }
      .i-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .i-edit { margin-left: auto; }
      .k-ico { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .i-del { background: rgba(237, 28, 36, 0.25); border-color: rgba(237, 28, 36, 0.35); color: #fff; }
      .i-del:hover { background: rgba(237, 28, 36, 0.55); border-color: #ed1c24; color: #fff; }
      .i-del.confirm { width: auto; padding: 0 0.75rem; border-radius: 999px; font-size: 0.75rem; font-family: var(--font-body); background: #a3320f; border-color: #a3320f; color: #fff; white-space: nowrap; }

      /* Modale form */
      .overlay {
        position: fixed; inset: 0; z-index: 300; display: none;
        background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
        justify-content: center; padding: 3vh 1rem; overflow-y: auto;
      }
      .overlay.is-open { display: flex; }
      /* margin auto = sempre centrato, ma scrollabile se più alto dello schermo */
      .modal { --pad: 1.75rem; width: 100%; max-width: 640px; background: var(--c-bg); border: 1px solid var(--c-line); padding: 0 var(--pad); position: relative; margin: auto; }
      .modal { max-height: 90vh; overflow-y: auto; }
      /* Header (titolo) e footer (azioni) fissi, corpo scrollabile */
      .modal > h2 { position: sticky; top: 0; z-index: 6; background: var(--c-bg); margin: 0 calc(-1 * var(--pad)) 0.9rem; padding: var(--pad) var(--pad) 0.9rem; border-bottom: 1px solid var(--c-line); }
      .modal > .m-actions, .modal > .m-foot { position: sticky; bottom: 0; z-index: 6; background: var(--c-bg); margin: 1.6rem calc(-1 * var(--pad)) 0; padding: 1rem var(--pad) var(--pad); border-top: 1px solid var(--c-line); }
      /* Pop-up: Salva sempre a destra nel footer */
      #overlay .m-foot .m-save { margin-left: auto; order: 3; }
      .modal h2 { font-family: var(--font-title); font-size: 1.6rem; letter-spacing: 0.04em; margin-bottom: 1.25rem; }
      .m-close { position: sticky; top: 0.85rem; float: right; z-index: 8; margin: 0 0 -1.9rem; background: none; border: none; color: var(--c-muted); font-size: 1.6rem; cursor: pointer; line-height: 1; }
      .m-close:hover { color: var(--c-text); }

      .f-lab { display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); margin: 1.1rem 0 0.4rem; }
      .f-lab:first-of-type { margin-top: 0; }
      .f-input, .f-area {
        width: 100%; background: var(--c-card); border: 1px solid var(--c-line);
        color: var(--c-text); font-family: var(--font-body); font-size: 0.95rem;
        padding: 0.65rem 0.85rem; border-radius: 8px; transition: border-color 0.2s;
      }
      .f-input::placeholder, .f-area::placeholder { color: var(--c-muted); opacity: 0.7; }
      .f-input:focus, .f-area:focus { outline: none; border-color: var(--c-accent); }
      .f-area { min-height: 90px; resize: vertical; }
      .f-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
      .f-row--img { grid-template-columns: 1fr auto; align-items: center; }
      .picks--lang { margin-bottom: 0.2rem; }
      .picks--lang .pick { min-width: 56px; text-align: center; font-size: 0.9rem; }
      .f-hint { font-size: 0.72rem; color: var(--c-muted); margin-top: 0.3rem; }

      /* Pillole selezionabili (pagine, giorni, programmazione) */
      .picks { display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .pick {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-size: 0.82rem; font-weight: 700; padding: 0.4rem 0.85rem; cursor: pointer;
        border-radius: 999px; user-select: none;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .pick:hover { border-color: var(--c-accent); }
      .pick.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }

      .sched-block { display: none; margin-top: 0.8rem; }
      .sched-block.is-visible { display: block; }
      .f-date { cursor: pointer; }

      /* Modale coupon: più largo e con più aria fra le sezioni (solo qui) */
      #cp-overlay .modal { max-width: 780px; --pad: 2.25rem; padding: 0 var(--pad); }
      #cp-overlay .f-lab { margin-top: 1.75rem; }
      #cp-overlay .f-lab:first-of-type { margin-top: 0; }
      #cp-overlay .f-row { margin-top: 1.75rem; gap: 1.5rem; }
      #cp-overlay .f-row .f-lab { margin-top: 0; }
      #cp-overlay .picks { gap: 0.5rem; margin-top: 0.2rem; }
      #cp-overlay .sched-block { margin-top: 1.2rem; }
      #cp-overlay .f-hint { margin-top: 0.1rem; }
      #cp-overlay .m-foot { margin-top: 2.4rem; }
      /* Bon cadeau: stessa aria del modale coupon tra le righe */
      #gc-overlay .modal { --pad: 2.25rem; padding: 0 var(--pad); }
      #gc-overlay .f-lab { margin-top: 1.75rem; }
      #gc-overlay .f-lab:first-of-type { margin-top: 0; }
      #gc-overlay .f-row .f-lab { margin-top: 0; }
      #gc-overlay .f-row { margin-top: 1.75rem; gap: 1.5rem; }
      #gc-overlay .picks { gap: 0.5rem; margin-top: 0.2rem; }
      #gc-overlay .m-foot { margin-top: 2.4rem; }
      .gc-steps { display: flex; gap: 0.35rem; margin-bottom: 1.6rem; }
      .gc-step { flex: 1; text-align: center; min-width: 60px; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-muted); border-bottom: 2px solid var(--c-line); padding-bottom: 0.45rem; }
      .gc-step.is-on { color: var(--c-accent); border-color: var(--c-accent); }
      .gc-step.done { color: var(--c-text); border-color: var(--c-accent); }
      .gc-recap { display: flex; flex-direction: column; }
      .gc-recap .r-row { display: flex; flex-direction: column; align-items: flex-start; gap: 0.3rem; border-bottom: 1px solid var(--c-line); padding: 0.75rem 0; font-size: 0.9rem; }
      .gc-recap .r-k { color: var(--c-muted); }
      .gc-recap .r-v { color: var(--c-text); font-weight: 700; text-align: left; word-break: break-word; }
      .gc-recap .gc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; margin-bottom: 0.4rem; }
      .gc-cell { border: 1px solid var(--c-line); border-radius: 12px; padding: 0.85rem 0.95rem; background: var(--c-input); display: flex; flex-direction: column; gap: 0.3rem; }
      .gc-cell-head { display: flex; align-items: center; gap: 0.45rem; }
      .gc-cell-ico { color: var(--c-accent); line-height: 0; }
      .gc-cell-ico svg { width: 20px; height: 20px; }
      .gc-cell-k { color: var(--c-muted); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .gc-cell-v { color: var(--c-text); font-weight: 700; font-size: 0.95rem; word-break: break-word; }
      #gc-send-box { margin-top: 1.6rem; }
      #gc-overlay #gc-prev { color: var(--c-muted); }
      #gc-overlay .f-lab + .f-row { margin-top: 0; }
      #gc-overlay .m-foot { flex-wrap: wrap; }
      #gc-overlay .m-foot .m-err { flex-basis: 100%; order: -1; margin: 0 0 0.2rem; }
      #gc-overlay .m-err:empty { display: none; }
      #gc-overlay .m-foot #gc-prev { margin-right: auto; }
      #gc-overlay .m-foot #gc-next, #gc-overlay .m-foot #gc-save { margin-left: auto; }
      #gc-overlay .m-save:disabled { opacity: 0.45; cursor: not-allowed; }
      .gc-val { font-family: var(--font-title); font-size: 1.55rem; letter-spacing: 0.03em; color: var(--c-accent); line-height: 1.1; margin: 0.15rem 0 0.1rem; }
      .gc-val .gc-val-sur { font-family: var(--font-body); font-size: 0.78rem; font-weight: 700; letter-spacing: 0; color: var(--c-muted); margin-left: 0.4rem; }
      .gc-lines { display: flex; flex-direction: column; gap: 0.18rem; margin-top: 0.55rem; }
      .gc-lines .gc-line { font-size: 0.82rem; color: var(--c-muted); }
      .gc-lines .gc-line b { color: var(--c-text); font-weight: 700; }
      #giftcards .pop-actions .i-edit { margin-left: auto; }
      #giftcards .pop { position: relative; }
      #giftcards .pop.is-pending { opacity: 0.62; }
      .gc-pay { position: absolute; top: 1.1rem; right: 1.1rem; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
      .gc-pay svg { width: 14px; height: 14px; fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
      .gc-pay.ok { background: #2e9e6b; }
      .gc-pay.wait { background: #9b9490; }
      .gc-pay.wait svg { fill: #fff; stroke: none; }
      .gs-packs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
      .gs-pack { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.25rem;
        background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px; padding: 1.1rem 0.6rem;
        cursor: pointer; font-family: inherit; transition: border-color 0.15s, transform 0.15s; }
      .gs-pack:hover { border-color: var(--c-accent); transform: translateY(-2px); }
      .gs-pack:disabled { opacity: 0.5; cursor: wait; transform: none; }
      .gs-qty { color: var(--c-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .gs-price { font-family: var(--font-title); font-size: 1.7rem; color: var(--c-accent); letter-spacing: 0.03em; }
      .gs-unit { color: var(--c-muted); font-size: 0.72rem; }
      .gs-badge { position: absolute; top: -9px; background: var(--c-accent); color: var(--c-bg); font-size: 0.6rem;
        font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.12rem 0.5rem; border-radius: 999px; }
      .gs-hist-row { display: flex; justify-content: space-between; border-top: 1px solid var(--c-line); padding: 0.5rem 0; font-size: 0.82rem; color: var(--c-muted); }
      @media (max-width: 520px) { .gs-packs { grid-template-columns: 1fr; } }
      .gc-ship-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.75rem; }
      #gc-ship-box .f-row { margin-top: 0.6rem; }
      #gc-send-picks .pick.is-off, #gc-pay-picks .pick.is-off { opacity: 0.4; cursor: not-allowed; }
      #gc-pay-picks .gc-resend { border-color: var(--c-accent); color: var(--c-accent); font-family: inherit; }
      #gc-pay-picks .gc-resend:disabled { opacity: 0.5; cursor: wait; }
      .gc-tel { display: flex; gap: 0.4rem; min-width: 0; }
      .gc-tel .gc-tel-prefix { flex: 0 0 82px; cursor: pointer; padding-left: 0.5rem; padding-right: 0.3rem; }
      .gc-tel input[type="tel"] { flex: 1 1 auto; min-width: 0; }


      .m-foot { display: flex; align-items: center; gap: 1rem; margin-top: 1.6rem; }
      .m-foot--news { flex-direction: column; align-items: stretch; gap: 0.7rem; }
      .m-foot--news .m-foot-note { margin: 0; font-size: 0.72rem; line-height: 1.45; color: var(--c-muted); }
      .m-foot--news .m-foot-row { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
      .m-save {
        background: var(--c-accent); border: 1px solid var(--c-accent); color: var(--c-bg);
        font-family: var(--font-title); font-size: 1.1rem; letter-spacing: 0.05em;
        padding: 0.6rem 1.6rem; cursor: pointer; border-radius: 999px;
        transition: filter 0.2s;
      }
      .m-save:hover { filter: brightness(1.1); }
      .m-save:disabled { opacity: 0.5; cursor: wait; }
      .m-err { color: #ff6b6b; font-size: 0.85rem; }
      .f-img-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
      .f-img-prev { width: 52px; height: 52px; border-radius: 10px; border: 1px solid var(--c-line); background: var(--c-input); display: inline-flex; align-items: center; justify-content: center; overflow: hidden; flex: 0 0 auto; color: var(--c-muted); }
      .f-img-prev img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .f-img-prev svg { width: 22px; height: 22px; }
      #f-panels { margin-top: 1.1rem; }
      #f-panels .f-row-btnu { margin-top: 0.45rem; margin-bottom: 0.2rem; }
      .pos-picker { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
      .pos-opt { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 10px; padding: 0.45rem; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 0.3rem; width: 78px; transition: border-color 0.15s; }
      .pos-opt:hover, .pos-opt.is-on { border-color: var(--c-accent); }
      .pos-screen { position: relative; width: 52px; height: 38px; border: 1px solid var(--c-line); border-radius: 4px; background: var(--c-input); }
      .pos-dot { position: absolute; width: 16px; height: 11px; border-radius: 3px; background: var(--c-accent); }
      .pos-c { top: 50%; left: 50%; transform: translate(-50%, -50%); }
      .pos-bl { bottom: 3px; left: 3px; }
      .pos-bc { bottom: 3px; left: 50%; transform: translateX(-50%); }
      .pos-br { bottom: 3px; right: 3px; }
      .pos-name { font-size: 0.66rem; color: var(--c-muted); text-align: center; }
      .pos-opt.is-on .pos-name { color: var(--c-text); }

      /* Newsletter */
      .n-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-bottom: 1.25rem; }
      @media (max-width: 720px) { .n-stats { grid-template-columns: 1fr; } }
      .n-stat { background: var(--c-card); border: 1px solid var(--c-line); padding: 1.3rem 1.5rem; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); }
      .n-stat-lab { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); margin-bottom: 0.5rem; }
      .n-stat-big { font-family: var(--font-title); font-size: 2.4rem; line-height: 1; color: var(--c-accent); }
      .n-stat-sub { font-size: 1.1rem; color: var(--c-muted); margin-left: 0.4rem; }
      .n-stat-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
      .n-stat-note { display: block; color: var(--c-muted); font-size: 0.78rem; margin-top: 0.5rem; }
      .c-packs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
      .c-pack {
        display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-text);
        padding: 1.1rem 0.8rem; cursor: pointer; border-radius: 12px;
        transition: border-color 0.15s, transform 0.15s;
      }
      .c-pack:hover { border-color: var(--c-accent); transform: scale(0.98); }
      .c-pack.is-on { border-color: var(--c-accent); background: color-mix(in srgb, var(--c-accent) 12%, transparent); }
      .c-pack:disabled { opacity: 0.5; cursor: wait; }
      .c-pack-n { font-family: var(--font-title); font-size: 1.6rem; letter-spacing: 0.03em; color: var(--c-accent); }
      .c-pack-p { font-size: 0.9rem; font-weight: 700; }
      .n-htitle { font-family: var(--font-title); font-size: 1.5rem; letter-spacing: 0.04em; color: var(--c-accent); margin-bottom: 0.8rem; }
      .n-row { display: flex; align-items: baseline; gap: 0.9rem; background: var(--c-card); border: 1px solid var(--c-line); padding: 0.8rem 1.2rem; margin-bottom: 0.4rem; }
      .n-row-subject { flex: 1; font-weight: 700; }
      .n-row-count { font-family: var(--font-title); font-size: 1.1rem; color: var(--c-accent); white-space: nowrap; }
      .n-row-date { color: var(--c-muted); font-size: 0.82rem; white-space: nowrap; }
      .m-save.confirm { background: #a3320f; border-color: #a3320f; color: #fff; }

      /* Toast */
      .toast {
        position: fixed; left: 50%; bottom: 6rem; transform: translateX(-50%) translateY(20px);
        background: var(--c-card); border: 1px solid var(--c-accent); color: var(--c-text);
        padding: 0.7rem 1.3rem; border-radius: 999px; font-size: 0.9rem;
        opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.25s; z-index: 400;
        box-shadow: 0 8px 24px rgba(0, 0, 0, calc(0.5 * var(--sh, 0.15)));
      }
      .toast.is-visible { opacity: 1; transform: translateX(-50%) translateY(0); }
      .toast.is-error { border-color: #ed1c24; }

      @media (max-width: 640px) {
        main { padding: 1.5rem 1rem 8rem; }
        .f-row { grid-template-columns: 1fr; }
      }
      /* Loader dentro i bottoni di salvataggio */
      .is-loading { position: relative; color: transparent !important; pointer-events: none; }
      .is-loading::after {
        content: ""; position: absolute; inset: 0; margin: auto;
        width: 18px; height: 18px; border-radius: 50%;
        border: 2px solid color-mix(in srgb, var(--c-bg) 30%, transparent); border-top-color: var(--c-bg);
        animation: btnspin 0.7s linear infinite;
      }
      @keyframes btnspin { to { transform: rotate(360deg); } }
    </style>
    <AdminHead />
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <h1><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11v3" /><path d="M7 9v7" /><path d="M7 9l10-5v16l-10-5" /><path d="M17 8.5a4 4 0 0 1 0 7" /><path d="M9.5 16.5 11 21" /></svg>{t("nav.marketing")}</h1>

        <div class="mtabs" id="mtabs">
          <button class="mtab is-active" data-tab="popup"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>{t("tab.marketing.popup")}</button>
          <button class="mtab" data-tab="news"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>{t("tab.marketing.news")}</button>
          <button class="mtab" data-tab="coupons"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" /><line x1="13" y1="5" x2="13" y2="7" /><line x1="13" y1="11" x2="13" y2="13" /><line x1="13" y1="17" x2="13" y2="19" /></svg>{t("tab.marketing.coupons")}</button>
          <button class="mtab" data-tab="giftcards"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 12 20 22 4 22 4 12" /><rect x="2" y="7" width="20" height="5" /><line x1="12" y1="22" x2="12" y2="7" /><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" /><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" /></svg>{t("tab.marketing.giftcards")}</button>
          <button class="mtab" data-tab="promos"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19" /><circle cx="6.5" cy="6.5" r="2.5" /><circle cx="17.5" cy="17.5" r="2.5" /></svg>{t("tab.marketing.promos")}</button>
        </div>

        <div class="state" id="state">{t("sup.loading")}</div>

        <div id="tab-popup" style="display:none">
          <div class="actionsbar">
            <button class="pill" id="add-btn">+ {t("mk.newPopup")}</button>
          </div>
          <div class="state" id="empty" style="display:none">
            {t("mk.popupEmpty")}
          </div>
          <div class="pops" id="pops"></div>
        </div>

        <div id="tab-coupons" style="display:none">
          <div class="actionsbar">
            <button class="pill" id="cp-add">+ {t("mk.newCoupon")}</button>
          </div>
          <div class="state" id="cp-empty" style="display:none">
            {t("mk.couponEmpty")}
          </div>
          <div class="pops" id="coupons"></div>
        </div>

        <div id="tab-giftcards" style="display:none">
          <div class="actionsbar">
            <button class="pill" id="gc-add">+ {t("mk.newGift")}</button>
            <button class="pill" id="gc-shop">{t("mk.buyVouchers")}</button>
          </div>
          <div class="state" id="gc-empty" style="display:none">
            {t("mk.giftEmpty")}
          </div>
          <div class="pops" id="giftcards"></div>
        </div>

        <div id="tab-promos" style="display:none">
          <div class="state">{t("mk.promoSoon")}</div>
        </div>

        <div id="tab-news" style="display:none">
          <div class="n-stats">
            <div class="n-stat">
              <div class="n-stat-lab">{t("mk.sentThisMonth")}</div>
              <div class="n-stat-big"><span id="n-sent">—</span><span class="n-stat-sub" id="n-quota">/ —</span></div>
            </div>
            <div class="n-stat">
              <div class="n-stat-lab">{t("mk.sendsRemaining")}</div>
              <div class="n-stat-row">
                <div class="n-stat-big" id="n-remaining">—</div>
                <button class="pill" id="c-buy" type="button">+ {t("mk.addCredits")}</button>
              </div>
              <span class="n-stat-note" id="n-purchased"></span>
            </div>
            <div class="n-stat">
              <div class="n-stat-lab">{t("mk.recipients")}</div>
              <div class="n-stat-big"><span id="n-recipients">—</span><span class="n-stat-sub">{t("mk.optedIn")}</span></div>
              <span class="n-stat-note" id="n-optout"></span>
            </div>
          </div>

          <div class="actionsbar">
            <button class="pill" id="n-add">+ {t("mk.newNewsletter")}</button>
          </div>

          <h2 class="n-htitle" id="nd-tit" style="display:none">{t("mk.drafts")}</h2>
          <div class="n-history" id="nd-list"></div>

          <h2 class="n-htitle" id="np-tit" style="display:none">{t("mk.scheduled")}</h2>
          <div class="n-history" id="np-list"></div>

          <h2 class="n-htitle">{t("mk.lastSends")}</h2>
          <div class="state" id="n-hempty" style="display:none">{t("mk.noSends")}</div>
          <div class="n-history" id="n-history"></div>
        </div>
      </main>
      <AdminFooter />
    </div>

    <script id="pub-langs" type="application/json" is:inline set:html={pubLangsJson}></script>
    <script id="site-pages" type="application/json" is:inline set:html={sitePagesJson}></script>
    <!-- Modale creazione/modifica -->
    <div class="overlay" id="overlay">
      <div class="modal">
        <button class="m-close" id="m-close" type="button" aria-label={t("common.close")}>×</button>
        <h2 id="m-title">{t("mk.newPopup")}</h2>

        <div class="picks picks--lang" id="f-lang"></div>
        <p class="f-hint" style="margin:0.4rem 0 0.9rem">
          {t("mk.popupLangHint")}
        </p>

        <label class="f-lab">{t("mk.position")}</label>
        <div class="pos-picker" id="f-pos">
          <button type="button" class="pos-opt is-on" data-pos="center"><span class="pos-screen"><span class="pos-dot pos-c"></span></span><span class="pos-name">{t("mk.posCenter")}</span></button>
          <button type="button" class="pos-opt" data-pos="bottom-left"><span class="pos-screen"><span class="pos-dot pos-bl"></span></span><span class="pos-name">{t("mk.posBL")}</span></button>
          <button type="button" class="pos-opt" data-pos="bottom-center"><span class="pos-screen"><span class="pos-dot pos-bc"></span></span><span class="pos-name">{t("mk.posBC")}</span></button>
          <button type="button" class="pos-opt" data-pos="bottom-right"><span class="pos-screen"><span class="pos-dot pos-br"></span></span><span class="pos-name">{t("mk.posBR")}</span></button>
        </div>

        <label class="f-lab">{t("mk.image")}</label>
        <div class="f-img-row">
          <span class="f-img-prev" id="f-img-prev"></span>
          <button type="button" class="pill" id="f-upload">{t("cli.uploadPhoto")}</button>
          <button type="button" class="pill" id="f-lib">{t("menu.library")}</button>
          <button type="button" class="pill" id="f-img-del" style="display:none">{t("ord.remove")}</button>
          <input type="file" id="f-file" accept=".jpg,.jpeg,.png,.webp,.gif" style="display:none" />
          <span class="f-hint" id="f-upload-state"></span>
        </div>
        <input type="hidden" id="f-img" />

        <div id="f-panels"></div>

        <p class="f-hint">{t("mk.popupTipPre")}<strong>#reserver</strong>{t("mk.popupTipPost")}</p>

        <label class="f-lab">{t("mk.pagesWhere")}</label>
        <div class="picks" id="f-pages"></div>

        <label class="f-lab">{t("mk.scheduling")}</label>
        <div class="picks" id="f-kind">
          <span class="pick is-on" data-k="always">{t("mk.schedAlways")}</span>
          <span class="pick" data-k="dates">{t("mk.schedDates")}</span>
          <span class="pick" data-k="weekly">{t("mk.schedWeekly")}</span>
        </div>

        <div class="sched-block" id="sched-dates">
          <div class="f-row">
            <div>
              <label class="f-lab" for="f-ds">{t("mk.from")}</label>
              <input type="text" class="f-input f-date" id="f-ds" readonly placeholder={t("mk.datePh")} />
            </div>
            <div>
              <label class="f-lab" for="f-de">{t("mk.to")}</label>
              <input type="text" class="f-input f-date" id="f-de" readonly placeholder={t("mk.datePh")} />
            </div>
          </div>
        </div>

        <div class="sched-block" id="sched-weekly">
          <div class="picks" id="f-days"></div>
          <div class="f-row" style="margin-top:0.8rem">
            <div>
              <label class="f-lab" for="f-hs">{t("mk.timeFrom")}</label>
              <input type="time" class="f-input" id="f-hs" />
            </div>
            <div>
              <label class="f-lab" for="f-he">{t("mk.timeTo")}</label>
              <input type="time" class="f-input" id="f-he" />
            </div>
          </div>
        </div>

        <label class="f-lab" for="f-max">{t("mk.maxViews")}</label>
        <input type="number" class="f-input" id="f-max" min="1" max="10" value="3" style="max-width:120px" />

        <div class="m-foot">
          <button class="m-save" id="m-save" type="button">{t("common.save")}</button>
          <span class="sw-wrap">
            <label class="switch"><input type="checkbox" id="f-active" checked /><span class="track"></span></label>
            <span class="sw-lab">{t("menu.active")}</span>
          </span>
          <span class="m-err" id="m-err"></span>
        </div>
      </div>
    </div>

    <!-- Modale acquisto crediti -->
    <div class="overlay" id="c-overlay">
      <div class="modal" style="max-width:520px">
        <button class="m-close" id="c-close" type="button" aria-label={t("common.close")}>×</button>
        <h2>{t("mk.buyCredits")}</h2>
        <p class="f-hint" style="margin-bottom:1.1rem">
          {t("mk.creditsInfo")}
        </p>
        <div class="c-packs">
          <button class="c-pack" type="button" data-pack="500" data-price="5,99 €"><span class="c-pack-n">+500</span><span class="c-pack-p">5,99&nbsp;€</span></button>
          <button class="c-pack" type="button" data-pack="1000" data-price="9,99 €"><span class="c-pack-n">+1000</span><span class="c-pack-p">9,99&nbsp;€</span></button>
          <button class="c-pack" type="button" data-pack="2000" data-price="14,99 €"><span class="c-pack-n">+2000</span><span class="c-pack-p">14,99&nbsp;€</span></button>
          <button class="c-pack" type="button" data-pack="5000" data-price="29,99 €"><span class="c-pack-n">+5000</span><span class="c-pack-p">29,99&nbsp;€</span></button>
        </div>
        <div class="m-foot" id="c-foot" style="display:none">
          <button class="m-save" id="c-checkout" type="button">{t("mk.pay")}</button>
          <span class="m-err" id="c-err"></span>
        </div>
      </div>
    </div>

    <!-- Modale nuova newsletter -->
    <div class="overlay" id="n-overlay">
      <div class="modal">
        <button class="m-close" id="n-close" type="button" aria-label={t("common.close")}>×</button>
        <h2>{t("mk.newNewsletter")}</h2>

        <label class="f-lab">{t("mk.newsRecipientsLang")}</label>
        <div class="seg-row" id="n-lang"></div>
        <label class="f-lab">{t("mk.newsRecipientsGroup")}</label>
        <div class="seg-row" id="n-seg"></div>

        <label class="f-lab">{t("mk.image")}</label>
        <div class="f-img-row">
          <span class="f-img-prev" id="n-img-prev"></span>
          <button type="button" class="pill" id="n-upload">{t("cli.uploadPhoto")}</button>
          <button type="button" class="pill" id="n-lib">{t("menu.library")}</button>
          <button type="button" class="pill" id="n-img-del" style="display:none">{t("ord.remove")}</button>
          <input type="file" id="n-file" accept=".jpg,.jpeg,.png,.webp,.gif" style="display:none" />
          <span class="f-hint" id="n-upload-state"></span>
        </div>
        <input type="hidden" id="n-img" />

        <label class="f-lab" for="n-subject">{t("mk.subjectReq")}</label>
        <input type="text" class="f-input" id="n-subject" placeholder={t("mk.subjectPh")} />

        <label class="f-lab" for="n-msg">{t("mk.messageReq")}</label>
        <textarea class="f-area" id="n-msg" style="min-height:140px" placeholder={t("mk.newsMsgPh")}></textarea>

        <label class="f-lab">{t("mk.btnOpt")}</label>
        <div class="f-row">
          <input type="text" class="f-input" id="n-btnl" placeholder={t("mk.btnLabelMenuPh")} />
          <input type="text" class="f-input" id="n-btnu" placeholder={t("mk.linkHttpsPh")} />
          <button class="pill asset-pick" type="button" data-target="n-btnu" title={t("mk.chooseAsset")}>{t("nav.assets")}</button>
        </div>

        <label class="f-lab">{t("mk.btn2Opt")}</label>
        <div class="f-row">
          <input type="text" class="f-input" id="n-btn2l" placeholder={t("mk.btnLabelBookTablePh")} />
          <input type="text" class="f-input" id="n-btn2u" placeholder={t("mk.linkHttpsPh")} />
          <button class="pill asset-pick" type="button" data-target="n-btn2u" title={t("mk.chooseAsset")}>{t("nav.assets")}</button>
        </div>

        <label class="f-lab">{t("mk.send")}</label>
        <div class="seg-row" id="n-when">
          <button type="button" class="seg-pill is-on" data-w="now">{t("mk.now")}</button>
          <button type="button" class="seg-pill" data-w="date">{t("mk.schedule")}</button>
          <button type="button" class="seg-pill" data-w="weekly">{t("mk.everyWeek")}</button>
          <button type="button" class="seg-pill" data-w="monthly">{t("mk.everyMonth")}</button>
        </div>
        <div class="f-row" id="n-prog" style="display:none; align-items:center; gap:0.6rem; flex-wrap:wrap">
          <input type="text" class="f-input" id="np-date" placeholder={t("home.date")} readonly style="max-width:160px; cursor:pointer; display:none" />
          <span class="seg-row" id="np-dow" style="display:none; margin-bottom:0"></span>
          <input type="number" class="f-input" id="np-day" min="1" max="28" value="1" title={t("mk.dayOfMonthTitle")} style="max-width:90px; display:none" />
          <select class="f-input" id="np-heure" style="max-width:110px"></select>
        </div>

        <div class="m-foot m-foot--news">
          <p class="m-foot-note">{t("mk.newsFooterHint")}</p>
          <div class="m-foot-row">
            <button class="m-save" id="n-send" type="button">{t("mk.sendToAll")}</button>
            <button class="pill" id="n-test" type="button">{t("mk.sendMeTest")}</button>
            <button class="pill" id="n-draft" type="button">{t("mk.saveDraft")}</button>
            <span class="m-err" id="n-err"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Modale coupon -->
    <div class="overlay" id="cp-overlay">
      <div class="modal">
        <button class="m-close" id="cp-close" type="button" aria-label={t("common.close")}>×</button>
        <h2 id="cp-title">{t("mk.newCoupon")}</h2>

        <label class="f-lab" for="cp-code">{t("mk.codeReq")}</label>
        <input type="text" class="f-input" id="cp-code" placeholder={t("mk.couponCodePh")} style="text-transform:uppercase" />

        <label class="f-lab" for="cp-desc">{t("mk.descInternalOpt")}</label>
        <input type="text" class="f-input" id="cp-desc" placeholder={t("mk.descInternalPh")} />

        <label class="f-lab">{t("mk.discountTypeReq")}</label>
        <div class="picks" id="cp-type">
          <span class="pick is-on" data-t="percent">{t("mk.percentage")}</span>
          <span class="pick" data-t="fixed">{t("mk.fixedAmount")}</span>
        </div>

        <div class="f-row">
          <div>
            <label class="f-lab" for="cp-value"><span id="cp-value-lab">{t("mk.valuePercent")}</span> *</label>
            <input type="number" class="f-input" id="cp-value" min="0" step="0.01" placeholder="10" />
          </div>
          <div>
            <label class="f-lab" for="cp-maxcap">{t("mk.discountCap")}</label>
            <input type="number" class="f-input" id="cp-maxcap" min="0" step="0.01" placeholder={t("mk.unlimited")} />
