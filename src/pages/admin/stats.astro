---
// Pannello admin — STATISTIQUES: incasso, ordini, ora di punta e
// piatti più ordinati, per periodo (giorno/settimana/mese/anno/totale).
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHead from "../../components/admin/AdminHead.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import "../../styles/filters.css";
import { CLIENT } from "../../config/client";
import { verificaTokenLocale } from "../../lib/admin/adminAuth";
import { calcolaStats } from "../../lib/admin/calcolaStats";
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";

const lang = await adminLang();
const t = adminT(lang);

export const prerender = false;

// SSR (Fase 2): se il cookie di sessione è valido, pre-calcoliamo le stats del
// periodo di default ("day") sul server. Altrimenti ssrStats resta null → la
// pagina calcola lato client come prima.
let ssrStats: unknown = null;
try {
  const token = Astro.cookies.get("mdd_at")?.value ?? "";
  const staff = token ? await verificaTokenLocale(token) : null;
  if (staff) ssrStats = await calcolaStats("day");
} catch {
  ssrStats = null;
}
const ssrStatsJson = ssrStats ? JSON.stringify(ssrStats).replace(/</g, "\\u003c") : "";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("nav.stats") + " — Admin " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@700&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-hover: #e04f00;
        --c-input: #e6e6e6;
        --c-bg: #ffffff;
        --c-text: #666666;
        --c-accent: #ff7300;
        --c-muted: #a6a6a6;
        --c-line: #ebebeb;
        --c-card: #ffffff;
        --font-title: "Quicksand", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; overflow-x: hidden; }
      #app { display: none; min-height: 100vh; flex-direction: column; }

      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; margin-bottom: 1.25rem; }
      h1 svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .state { color: var(--c-muted); text-align: center; padding: 3rem 1rem; }

      /* Selettore periodo — pillole condivise (.rh-filters/.rh-filter in filters.css,
         con scroll orizzontale su mobile). Qui resta solo la spaziatura di pagina. */
      .periods { padding-top: 1.4rem; margin: 0 0 1.5rem; border-top: 1px solid var(--c-line); }

      /* Griglia stat */
      .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-bottom: 1.25rem; }
      /* iPad / tablet (incl. iPad mini verticale): 3 colonne come desktop, ma numeri
         più piccoli e spaziatura ridotta perché le colonne sono strette. */
      @media (min-width: 641px) and (max-width: 1024px) {
        .grid:not(.grid4) { gap: 0.7rem; }
        .grid:not(.grid4) .stat { padding: 1.1rem; }
        .grid:not(.grid4) .stat-big { font-size: 2rem; }
        .grid:not(.grid4) .stat-lab { font-size: 0.68rem; }
      }
      /* Telefono: 3 colonne compatte con numeri piccoli. */
      @media (max-width: 640px) {
        .grid:not(.grid4) { grid-template-columns: repeat(3, 1fr); gap: 0.4rem; }
        .grid:not(.grid4) .stat { padding: 0.7rem 0.6rem; }
        .grid:not(.grid4) .stat-big { font-size: 1.35rem; }
        .grid:not(.grid4) .stat-lab { font-size: 0.58rem; letter-spacing: 0.03em; margin-bottom: 0.4rem; }
        .grid:not(.grid4) .stat-sub { font-size: 0.66rem; margin-top: 0.4rem; }
      }
      .stat { background: var(--c-card); border: 1px solid var(--c-line); padding: 1.6rem; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); }
      .stat-lab { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); margin-bottom: 0.7rem; }
      .stat-big { font-family: var(--font-title); font-size: 3rem; line-height: 1; color: var(--c-accent); }
      .stat-sub { color: var(--c-muted); font-size: 0.85rem; margin-top: 0.6rem; }

      /* Top piatti */
      .top { background: var(--c-card); border: 1px solid var(--c-line); padding: 1.6rem; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); }
      .top-title { font-family: var(--font-title); font-size: 1.5rem; letter-spacing: 0.04em; color: var(--c-accent); margin-bottom: 1rem; }
      .top-row { display: flex; align-items: center; gap: 0.9rem; padding: 0.55rem 0; border-bottom: 1px solid var(--c-line); }
      .top-row:last-child { border-bottom: none; }
      .top-pos { font-family: var(--font-title); font-size: 1.2rem; color: var(--c-muted); min-width: 1.6rem; }
      .top-name { flex: 1; font-weight: 700; }
      .top-qty { font-family: var(--font-title); font-size: 1.2rem; letter-spacing: 0.03em; white-space: nowrap; }
      .top-cents { color: var(--c-muted); font-size: 0.85rem; white-space: nowrap; min-width: 6rem; text-align: right; }
      .top-bar { height: 4px; background: var(--c-line); border-radius: 999px; overflow: hidden; flex-basis: 100%; margin-top: 0.35rem; }
      .top-bar > span { display: block; height: 100%; background: var(--c-accent); border-radius: 999px; }
      .top-line { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.9rem; }

      /* Istogramma */
      .chart { background: var(--c-card); border: 1px solid var(--c-line); padding: 1.6rem; margin-bottom: 1.25rem; position: relative; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); }
      .chart-title { font-family: var(--font-title); font-size: 1.5rem; letter-spacing: 0.04em; color: var(--c-accent); margin-bottom: 1rem; }
      .chart-wrap { overflow-x: auto; padding-bottom: 0.2rem; }
      .chart-bars { display: flex; align-items: flex-end; gap: 2px; height: 200px; border-bottom: 1px solid var(--c-line); }
      .cbar { flex: 1 0 14px; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-end; height: 100%; }
      .cbar .cval { font-family: var(--font-title); font-size: 0.85rem; color: var(--c-text); text-align: center; margin-bottom: 3px; }
      .cbar .fill { background: var(--c-accent); border-radius: 4px 4px 0 0; min-height: 2px; }
      .cbar.zero .fill { background: var(--c-line); }
      .cbar:hover .fill { filter: brightness(1.15); }
      .chart-labs { display: flex; gap: 2px; margin-top: 0.4rem; }
      .clab { flex: 1 0 14px; text-align: center; font-size: 0.62rem; color: var(--c-muted); white-space: nowrap; }
      .chart-tip {
        position: absolute; z-index: 10; pointer-events: none; display: none;
        background: var(--c-bg); border: 1px solid var(--c-accent); color: var(--c-text);
        font-size: 0.8rem; padding: 0.35rem 0.7rem; border-radius: 999px; white-space: nowrap;
        box-shadow: 0 6px 16px rgba(0, 0, 0, calc(0.5 * var(--sh, 0.15)));
      }

      .loading { opacity: 0.45; pointer-events: none; }

      /* Onglets Finances / Google — mêmes pastilles que la page Assets */
      .tabs2 { display: flex; gap: 0.4rem; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-bottom: 1.5rem; }
      .tabs2::-webkit-scrollbar { display: none; }
      .tab2 { flex-shrink: 0; }
      .tab2 {
        background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted);
        font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.05em;
        padding: 0.5rem 1.2rem; cursor: pointer; border-radius: 10px;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .tab2 .t-ico { width: 16px; height: 16px; margin-right: 0.45rem; vertical-align: -3px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .tab2:hover { color: var(--c-text); border-color: var(--c-accent); }
      .tab2.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }

      .grid.grid4 { grid-template-columns: repeat(4, 1fr); }
      @media (max-width: 900px) { .grid.grid4 { grid-template-columns: repeat(2, 1fr); } }
      .stat-sub .delta { font-weight: 800; }
      .stat-sub .delta.up { color: #1a8f4c; }
      .stat-sub .delta.down { color: #c0392b; }

      /* Grafico a linee (SVG) */
      .lchart { position: relative; width: 100%; }
      .lchart svg { display: block; width: 100%; height: auto; }
      .lchart .gl { stroke: var(--c-line); stroke-width: 1; }
      .lchart .axlab { fill: var(--c-muted); font-size: 11px; font-family: var(--font-body); }
      .lchart .cross { stroke: var(--c-muted); stroke-width: 1; stroke-dasharray: 3 3; opacity: 0; }
      .lchart .cdot { opacity: 0; }

      /* Deux colonnes (requêtes / pages) */
      .two-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
      @media (max-width: 900px) { .two-cols { grid-template-columns: 1fr; } }
      /* --- Tab Prenotazioni --- */
      .sec-lab { font-family: var(--font-title); letter-spacing: 0.05em; font-size: 1.05rem; color: var(--c-muted); margin: 1.6rem 0 0.7rem; }
      .sec-lab:first-child { margin-top: 0; }
      .rkpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; margin-bottom: 1.4rem; }
      .rkpi-card { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px; padding: 1.1rem 1.2rem; box-shadow: 0 4px 14px rgba(0, 0, 0, calc(0.28 * var(--sh, 0.15))); }
      .rkpi-head { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-title); letter-spacing: 0.05em; font-size: 1.05rem; color: var(--c-text); margin-bottom: 0.4rem; }
      .rkpi-head svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .rkpi-item { padding: 0.7rem 0; border-top: 1px solid var(--c-line); min-width: 0; }
      .rkpi-item:first-child { border-top: none; }
      .rkpi-lab { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-muted); margin-bottom: 0.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .rkpi-val { font-family: var(--font-title); font-size: 1.7rem; line-height: 1; color: var(--c-accent); letter-spacing: 0.02em; }
      .rkpi-sub { color: var(--c-muted); font-size: 0.76rem; margin-top: 0.3rem; }
      @media (max-width: 640px) {
        .rkpi-grid { grid-template-columns: 1fr; }
        .rkpi-body { display: grid; grid-template-columns: 1fr 1fr; column-gap: 0.9rem; row-gap: 0; }
        .rkpi-item { border-top: none; padding: 0.55rem 0; }
        .rkpi-val { font-size: 1.35rem; }
      }
      .rsub { color: var(--c-muted); font-size: 0.82rem; margin: -0.6rem 0 0.6rem; }
      .rlegend { display: flex; gap: 1.1rem; flex-wrap: wrap; margin: 0 0 1rem; }
      .rlegend span { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--c-muted); }
      .rlegend i { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }
      .rbar-lab { fill: var(--c-muted); font-size: 11px; font-family: var(--font-body); }
      .rbar-val { fill: var(--c-text); font-size: 11px; font-family: var(--font-body); }
      .hb-row { display: grid; grid-template-columns: 6.5rem 1fr auto; align-items: center; gap: 0.7rem; margin-bottom: 0.5rem; }
      .hb-k { font-size: 0.85rem; color: var(--c-text); }
      .hb-bar { position: relative; height: 22px; background: var(--c-bg); border: 1px solid var(--c-line); border-radius: 6px; overflow: hidden; }
      .hb-fill { position: absolute; inset: 0 auto 0 0; background: var(--c-accent); }
      .hb-val { font-family: var(--font-title); font-size: 1rem; min-width: 3rem; text-align: right; color: var(--c-text); }
      @media (max-width: 640px) { .hb-row { grid-template-columns: 5rem 1fr auto; } .sec-lab { font-size: 0.95rem; } }
      .gtab-row, .gtab-head { display: flex; align-items: baseline; gap: 0.8rem; }
      .gtab-row { padding: 0.5rem 0; border-bottom: 1px solid var(--c-line); font-size: 0.9rem; }
      .gtab-row:last-child { border-bottom: none; }
      .gt-key, .h-key { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .gt-key { font-weight: 700; color: var(--c-text); }
      /* Colonnes chiffres : largeur fixe + alignées à droite → tout s'aligne */
      .gt-sub, .h-sub { flex: 0 0 4.5rem; width: 4.5rem; text-align: right; font-variant-numeric: tabular-nums; }
      .gt-n, .h-n { flex: 0 0 3.2rem; width: 3.2rem; text-align: right; font-variant-numeric: tabular-nums; }
      .gt-sub { color: var(--c-muted); font-size: 0.8rem; }
      .gt-n { font-family: var(--font-title); font-size: 1.15rem; letter-spacing: 0.03em; color: var(--c-accent); }
      .gtab-head { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-muted); padding-bottom: 0.3rem; }

      /* Sources de trafic (barres) */
      .src-row { display: flex; align-items: center; gap: 0.8rem; padding: 0.55rem 0; border-bottom: 1px solid var(--c-line); }
      .src-row:last-child { border-bottom: none; }
      .src-nom { flex: 0 0 8rem; font-weight: 700; color: var(--c-text); }
      .src-bar { flex: 1; height: 8px; background: var(--c-line); border-radius: 999px; overflow: hidden; min-width: 40px; }
      .src-bar > span { display: block; height: 100%; background: var(--c-accent); border-radius: 999px; }
      .src-n { flex: 0 0 3rem; text-align: right; font-family: var(--font-title); font-size: 1.15rem; letter-spacing: 0.03em; color: var(--c-accent); }
      .src-pct { flex: 0 0 2.8rem; text-align: right; color: var(--c-muted); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
      @media (max-width: 560px) { .src-nom { flex-basis: 6rem; font-size: 0.9rem; } }
      /* Override mobile posti in fondo per vincere sulle regole base (stessa specificità). */
      @media (max-width: 640px) {
        .top-title, .chart-title { font-size: 1rem; margin-bottom: 0.6rem; }
        .chart, .top { padding: 0.7rem; }
        .grid4 .stat { padding: 1rem; }
        .grid4 .stat-big { font-size: 1.8rem; }
        .grid4 .stat-lab { font-size: 0.66rem; }
        .grid4 .stat-sub { font-size: 0.72rem; }
      }
    </style>
    <AdminHead />
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <h1><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>{t("nav.stats")}</h1>

        <div class="tabs2" id="tabs2">
          <button type="button" class="tab2" data-tab="ggl"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>Google</button>
          <button type="button" class="tab2 is-on" data-tab="fin"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M15 9.5a3.5 3.5 0 1 0 0 5" /><line x1="7.5" y1="11" x2="12.5" y2="11" /><line x1="7.5" y1="13" x2="11.5" y2="13" /></svg>{t("st.finances")}</button>
          <button type="button" class="tab2" data-tab="resa"><svg class="t-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>{t("st.resaTab")}</button>
        </div>

        <section class="pane2" data-pane="fin">
        <div class="rh-filters periods" id="periods">
          <button class="rh-filter is-on" data-p="day">{t("st.pDay")}</button>
          <button class="rh-filter" data-p="week">{t("res.week")}</button>
          <button class="rh-filter" data-p="month">{t("res.month")}</button>
          <button class="rh-filter" data-p="ytd">{t("st.pYear")}</button>
          <button class="rh-filter" data-p="all">{t("ord.total")}</button>
        </div>
        <div class="state" id="state">{t("sup.loading")}</div>
        <div id="content" style="display:none">
          <div class="grid">
            <div class="stat">
              <div class="stat-lab">{t("st.revenue")}</div>
              <div class="stat-big" id="s-rev">—</div>
              <div class="stat-sub" id="s-avg"></div>
            </div>
            <div class="stat">
              <div class="stat-lab">{t("nav.orders")}</div>
              <div class="stat-big" id="s-count">—</div>
              <div class="stat-sub" id="s-count-sub"></div>
            </div>
            <div class="stat">
              <div class="stat-lab">{t("st.peakHour")}</div>
              <div class="stat-big" id="s-peak">—</div>
              <div class="stat-sub" id="s-peak-sub"></div>
            </div>
          </div>
          <div class="chart">
            <div class="chart-title" id="c-title">{t("st.byHour")}</div>
            <div class="chart-wrap">
              <div class="chart-bars" id="c-bars"></div>
              <div class="chart-labs" id="c-labs"></div>
            </div>
            <div class="chart-tip" id="c-tip"></div>
          </div>

          <div class="top">
            <div class="top-title">{t("st.topDishes")}</div>
            <div id="s-top"></div>
          </div>
        </div>
        </section>

        <section class="pane2" data-pane="ggl" hidden>
          <div class="rh-filters periods" id="g-periods">
            <button class="rh-filter" data-d="7">{t("st.days7")}</button>
            <button class="rh-filter is-on" data-d="28">{t("st.days28")}</button>
            <button class="rh-filter" data-d="90">{t("st.months3")}</button>
            <button class="rh-filter" data-d="180">{t("st.months6")}</button>
            <button class="rh-filter" data-d="365">{t("st.months12")}</button>
          </div>
          <div class="state" id="g-state">{t("sup.loading")}</div>
          <div class="state" id="g-empty" style="display:none">
            {t("st.scNotConfig")}
          </div>
          <div id="g-content" style="display:none">
            <div class="grid grid4">
              <div class="stat"><div class="stat-lab">{t("st.clicks")}</div><div class="stat-big" id="k-clicks">—</div><div class="stat-sub" id="k-clicks-d"></div></div>
              <div class="stat"><div class="stat-lab">{t("st.impressions")}</div><div class="stat-big" id="k-impr">—</div><div class="stat-sub" id="k-impr-d"></div></div>
              <div class="stat"><div class="stat-lab">CTR</div><div class="stat-big" id="k-ctr">—</div><div class="stat-sub" id="k-ctr-d"></div></div>
              <div class="stat"><div class="stat-lab">{t("st.position")}</div><div class="stat-big" id="k-pos">—</div><div class="stat-sub" id="k-pos-d"></div></div>
            </div>
            <div class="chart">
              <div class="chart-title">{t("st.clicks")}</div>
              <div class="lchart" id="g-chart-clicks"></div>
              <div class="chart-tip" id="tip-clicks"></div>
            </div>
            <div class="chart">
              <div class="chart-title">{t("st.impressions")}</div>
              <div class="lchart" id="g-chart-impr"></div>
              <div class="chart-tip" id="tip-impr"></div>
            </div>
            <div class="two-cols">
              <div class="top">
                <div class="top-title">{t("st.queries")}</div>
                <div class="gtab-head"><span class="h-key">{t("st.keyword")}</span><span class="h-sub">{t("st.imprShort")}</span><span class="h-n">{t("st.clicks")}</span></div>
                <div id="g-queries"></div>
              </div>
              <div class="top">
                <div class="top-title">{t("st.pages")}</div>
                <div class="gtab-head"><span class="h-key">{t("st.page")}</span><span class="h-sub">{t("st.imprShort")}</span><span class="h-n">{t("st.clicks")}</span></div>
                <div id="g-pages"></div>
              </div>
            </div>
          </div>

          <div class="top" id="g-sources-card" style="display:none; margin-top:1.25rem">
            <div class="top-title">{t("st.trafficSources")}</div>
            <p style="margin:-0.4rem 0 1rem; color:var(--c-muted); font-size:0.8rem">
              {t("st.trafficIntro")}
            </p>
            <div id="g-sources"></div>
          </div>
        </section>

        <section class="pane2" data-pane="resa" hidden>
          <div class="rh-filters periods" id="r-periods">
            <button class="rh-filter" data-g="7">{t("st.rFil7")}</button>
            <button class="rh-filter" data-g="15">{t("st.rFil15")}</button>
            <button class="rh-filter is-on" data-g="30">{t("st.rFil30")}</button>
            <button class="rh-filter" data-g="90">{t("st.rFil90")}</button>
            <button class="rh-filter" data-g="180">{t("st.rFil180")}</button>
            <button class="rh-filter" data-g="365">{t("st.rFil365")}</button>
          </div>
          <div class="state" id="r-state">{t("sup.loading")}</div>
          <div class="state" id="r-empty" style="display:none">{t("st.rNoData")}</div>
          <div id="r-content" style="display:none">
            <div class="rkpi-grid">
              <div class="rkpi-card"><div class="rkpi-head"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>{t("st.rSecOverview")}</div><div class="rkpi-body" id="r-kpi1"></div></div>
              <div class="rkpi-card"><div class="rkpi-head"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="20" x2="6" y2="13"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="10"/></svg>{t("st.rSecAvg")}</div><div class="rkpi-body" id="r-kpi2"></div></div>
              <div class="rkpi-card"><div class="rkpi-head"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>{t("st.rSecReliab")}</div><div class="rkpi-body" id="r-kpi3"></div></div>
            </div>

            <div class="chart">
              <div class="chart-title">{t("st.rTrend")}</div>
              <p class="rsub">{t("st.rTrendSub")}</p>
              <div class="rlegend">
                <span><i style="background:var(--c-accent)"></i>{t("st.rLegBook")}</span>
                <span><i style="background:#7fa6ae"></i>{t("st.rLegCanc")}</span>
                <span><i style="background:#5c6b7a"></i>{t("st.rLegNs")}</span>
              </div>
              <div class="lchart" id="r-trend"></div>
            </div>

            <div class="two-cols">
              <div class="chart"><div class="chart-title">{t("st.rByWeekday")}</div><div class="lchart" id="r-week"></div></div>
              <div class="chart"><div class="chart-title">{t("st.rByHour")}</div><div class="lchart" id="r-hours"></div></div>
            </div>

            <div class="two-cols">
              <div class="top"><div class="top-title">{t("st.rBySource")}</div><div id="r-src"></div></div>
              <div class="top"><div class="top-title">{t("st.rCoversSvc")}</div><div id="r-svc"></div></div>
            </div>
          </div>
        </section>
      </main>
      <AdminFooter />
    </div>

    <AdminNav current="stats" />

    <!-- Dati SSR (Fase 2): stats del periodo "day" pre-calcolate dal server. -->
    <script id="ssr-stats" type="application/json" is:inline set:html={ssrStatsJson}></script>

    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";

      const LANG = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(LANG);
      const LOC = ADMIN_LOCALE[LANG] ?? "fr-BE";

      type Stats = {
        period: string;
        orders: number;
        revenue_cents: number;
        avg_cents: number;
        peak_hour: number | null;
        peak_count: number;
        series_kind: string;
        series: { label: string; count: number }[];
        top: { name: string; qty: number; cents: number }[];
      };

      const NOMI_PERIODO: Record<string, string> = {
        day: tr("home.today"),
        week: tr("st.thisWeek"),
        month: tr("st.thisMonth"),
        ytd: tr("st.thisYear"),
        all: tr("st.allTime"),
      };

      function esc(s: string): string {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }
      function euro(cents: number): string {
        return (cents / 100).toLocaleString(LOC, { style: "currency", currency: "EUR" });
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const contentEl = document.getElementById("content") as HTMLDivElement;
        const periodsEl = document.getElementById("periods") as HTMLDivElement;

        logoutBtn.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        // Sblocco IMMEDIATO con la sessione locale (nessuna rete). getUser()
        // gira in background solo per validare il token (revoca → login).
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        const headers = { Authorization: `Bearer ${session.access_token ?? ""}` };

        let periodo = "day";

        function render(s: Stats) {
          (document.getElementById("s-rev") as HTMLElement).textContent = euro(s.revenue_cents);
          (document.getElementById("s-avg") as HTMLElement).textContent =
            s.orders > 0 ? `${tr("st.avgBasket")} : ${euro(s.avg_cents)}` : "";
          (document.getElementById("s-count") as HTMLElement).textContent = String(s.orders);
          (document.getElementById("s-count-sub") as HTMLElement).textContent =
            `${tr("st.paidOrders")} ${NOMI_PERIODO[s.period] ?? ""}`;

          const peakEl = document.getElementById("s-peak") as HTMLElement;
          const peakSub = document.getElementById("s-peak-sub") as HTMLElement;
          if (s.peak_hour === null) {
            peakEl.textContent = "—";
            peakSub.textContent = "";
          } else {
            const h = String(s.peak_hour).padStart(2, "0");
            const h2 = String((s.peak_hour + 1) % 24).padStart(2, "0");
            peakEl.textContent = `${h}:00–${h2}:00`;
            peakSub.textContent = `${s.peak_count} ${s.peak_count > 1 ? tr("home.ordersWord") : tr("ord.commandeSg")} ${tr("st.inThisSlot")}`;
          }

          renderChart(s);

          const topEl = document.getElementById("s-top") as HTMLElement;
          if (!s.top.length) {
            topEl.innerHTML = `<p class="state">${tr("st.noOrdersPeriod")}</p>`;
            return;
          }
          const maxQty = s.top[0].qty;
          topEl.innerHTML = s.top
            .map(
              (t, i) => `
            <div class="top-row">
              <div class="top-line" style="flex:1">
                <span class="top-pos">${i + 1}</span>
                <span class="top-name">${esc(t.name)}</span>
                <span class="top-qty">${t.qty}×</span>
                <span class="top-cents">${euro(t.cents)}</span>
                <span class="top-bar"><span style="width:${Math.round((t.qty / maxQty) * 100)}%"></span></span>
              </div>
            </div>`
            )
            .join("");
        }

        const TITOLI: Record<string, string> = {
          hour: tr("st.byHour"),
          weekday: tr("st.byWeekday"),
          day: tr("st.byMonthDay"),
          month: tr("st.byMonth"),
          quarter: tr("st.byQuarter"),
        };

        function renderChart(s: Stats) {
          (document.getElementById("c-title") as HTMLElement).textContent =
            TITOLI[s.series_kind] ?? tr("nav.orders");
          const barsEl = document.getElementById("c-bars") as HTMLElement;
          const labsEl = document.getElementById("c-labs") as HTMLElement;

          if (!s.series.length) {
            barsEl.innerHTML = `<p class="state" style="width:100%">${tr("st.noData")}</p>`;
            labsEl.innerHTML = "";
            return;
          }
          const max = Math.max(...s.series.map((b) => b.count), 1);
          // Etichette dirette selettive: solo sul picco (le altre via tooltip)
          const peakIdx = s.series.findIndex((b) => b.count === max);
          // Diradamento etichette asse quando i bucket sono tanti
          const passo = s.series.length > 16 ? 2 : 1;

          barsEl.innerHTML = s.series
            .map((b, i) => {
              const hPct = Math.round((b.count / max) * 100);
              const val = i === peakIdx && b.count > 0 ? `<span class="cval">${b.count}</span>` : "";
              return `<div class="cbar${b.count === 0 ? " zero" : ""}" role="img" aria-label="${esc(b.label)} : ${b.count} ${tr("home.ordersWord")}" data-lab="${esc(b.label)}" data-n="${b.count}">${val}<span class="fill" style="height:${hPct}%"></span></div>`;
            })
            .join("");
          labsEl.innerHTML = s.series
            .map((b, i) => `<span class="clab">${i % passo === 0 ? esc(b.label) : ""}</span>`)
            .join("");
        }

        // Tooltip per barra (mouse e tocco)
        const tipEl = document.getElementById("c-tip") as HTMLElement;
        const chartEl = document.querySelector(".chart") as HTMLElement;
        chartEl.addEventListener("pointerover", (e) => {
          const bar = (e.target as HTMLElement).closest(".cbar") as HTMLElement | null;
          if (!bar) { tipEl.style.display = "none"; return; }
          const n = Number(bar.dataset.n);
          tipEl.textContent = `${bar.dataset.lab} · ${n} ${n === 1 ? tr("ord.commandeSg") : tr("home.ordersWord")}`;
          tipEl.style.display = "block";
          const cr = chartEl.getBoundingClientRect();
          const br = bar.getBoundingClientRect();
          const left = br.left - cr.left + br.width / 2 - tipEl.offsetWidth / 2;
          tipEl.style.left = `${Math.max(4, Math.min(left, cr.width - tipEl.offsetWidth - 4))}px`;
          tipEl.style.top = `${br.top - cr.top - tipEl.offsetHeight - 8}px`;
        });
        chartEl.addEventListener("pointerleave", () => { tipEl.style.display = "none"; });

        async function carica(datiIniziali?: Stats) {
          contentEl.classList.add("loading");
          try {
            let s: Stats;
            if (datiIniziali) {
              s = datiIniziali; // dati già pronti dal server (SSR)
            } else {
              const res = await fetch("/api/admin/stats?period=" + periodo, { headers });
              if (!res.ok) {
                stateEl.textContent = tr("sup.load.error");
                stateEl.style.display = "block";
                return;
              }
              s = (await res.json()) as Stats;
            }
            stateEl.style.display = "none";
            contentEl.style.display = "block";
            render(s);
          } catch {
            stateEl.textContent = tr("common.netErr");
            stateEl.style.display = "block";
          } finally {
            contentEl.classList.remove("loading");
          }
        }

        periodsEl.addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".rh-filter") as HTMLElement | null;
          if (!t || t.dataset.p === periodo) return;
          periodo = t.dataset.p!;
          periodsEl.querySelectorAll(".rh-filter").forEach((b) => b.classList.toggle("is-on", b === t));
          carica();
        });

        // ===================== Onglet Google (Search Console) =====================
        type GLigne = { key: string; clicks: number; impressions: number; ctr: number; position: number };
        type GDetail = {
          configured: boolean; error?: string; days: number;
          kpi: { clicks: number; impressions: number; ctr: number; position: number;
                 prev: { clicks: number; impressions: number; ctr: number; position: number } };
          serie: { date: string; clicks: number; impressions: number }[];
          topQueries: GLigne[]; topPages: GLigne[];
        };

        const tabs2 = document.getElementById("tabs2") as HTMLElement;
        const paneGgl = document.querySelector('.pane2[data-pane="ggl"]') as HTMLElement;
        const paneFin = document.querySelector('.pane2[data-pane="fin"]') as HTMLElement;
        const paneResa = document.querySelector('.pane2[data-pane="resa"]') as HTMLElement;
        const gPeriods = document.getElementById("g-periods") as HTMLElement;
        const gState = document.getElementById("g-state") as HTMLElement;
        const gEmpty = document.getElementById("g-empty") as HTMLElement;
        const gContent = document.getElementById("g-content") as HTMLElement;
        let gDays = 28;
        let gLoaded = false;
        let gSerie: { date: string; clicks: number; impressions: number }[] = [];
        const nfInt = new Intl.NumberFormat(LOC);

        const SRC_NOMI: Record<string, string> = {
          google: "Google", facebook: "Facebook", instagram: "Instagram",
          direct: tr("st.directUnknown"), tiktok: "TikTok", x: "X (Twitter)",
          bing: "Bing", yahoo: "Yahoo", duckduckgo: "DuckDuckGo",
          linkedin: "LinkedIn", youtube: "YouTube", whatsapp: "WhatsApp",
          newsletter: tr("tab.marketing.news"), autre: tr("st.other"),
        };

        // Sources de trafic (analytics interne) — indépendant de Search Console.
        async function caricaSources() {
          const card = document.getElementById("g-sources-card") as HTMLElement | null;
          const box = document.getElementById("g-sources") as HTMLElement | null;
          if (!card || !box) return;
          try {
            const res = await fetch("/api/admin/traffic?days=" + gDays, { headers });
            const j = (await res.json()) as { sources: { source: string; count: number }[]; total: number };
            card.style.display = "";
            if (!j.sources || !j.sources.length) {
              box.innerHTML = `<p class="state" style="padding:0.8rem 0">${tr("st.noVisits")}</p>`;
              return;
            }
            const max = Math.max(...j.sources.map((x) => x.count));
            box.innerHTML = j.sources.map((x) => {
              const nom = SRC_NOMI[x.source] ?? (x.source.charAt(0).toUpperCase() + x.source.slice(1));
              const pct = j.total ? Math.round((x.count / j.total) * 100) : 0;
              const w = Math.round((x.count / max) * 100);
              return `<div class="src-row"><span class="src-nom">${esc(nom)}</span>` +
                `<span class="src-bar"><span style="width:${w}%"></span></span>` +
                `<span class="src-n">${nfInt.format(x.count)}</span><span class="src-pct">${pct}%</span></div>`;
            }).join("");
          } catch {
            card.style.display = "none";
          }
        }

        function deltaPct(cur: number, prev: number): { txt: string; cls: string } {
          if (prev <= 0) return { txt: cur > 0 ? `▲ ${tr("st.newLower")}` : "", cls: cur > 0 ? "up" : "" };
          const d = Math.round(((cur - prev) / prev) * 100);
          if (d === 0) return { txt: `— ${tr("st.stable")}`, cls: "" };
          return { txt: (d > 0 ? "▲ " : "▼ ") + Math.abs(d) + "%", cls: d > 0 ? "up" : "down" };
        }
        function setDelta(id: string, r: { txt: string; cls: string }) {
          const el = document.getElementById(id);
          if (el) el.innerHTML = r.txt ? `<span class="delta ${r.cls}">${r.txt}</span> ${tr("st.vsPrevPeriod")}` : "";
        }
        function fmtJour(iso: string): string {
          const d = new Date(iso + "T00:00:00");
          return d.toLocaleDateString(LOC, { day: "numeric", month: "short" });
        }

        // Grafico a linee SVG con crosshair + tooltip (una sola serie per grafico).
        function drawLine(boxId: string, tipId: string, pts: { date: string; val: number }[], color: string) {
          const box = document.getElementById(boxId) as HTMLElement | null;
          const tip = document.getElementById(tipId) as HTMLElement | null;
          if (!box) return;
          const W = Math.max(320, Math.round(box.clientWidth || 600));
          const H = 230, padL = 0, padR = 0, padT = 16, padB = 26;
          const iw = W - padL - padR, ih = H - padT - padB;
          const n = pts.length;
          if (!n) { box.innerHTML = `<p class="state" style="padding:1.5rem 0">${tr("st.noData")}</p>`; return; }
          const maxV = Math.max(1, ...pts.map((p) => p.val));
          const X = (i: number) => padL + (n <= 1 ? iw / 2 : (i / (n - 1)) * iw);
          const Y = (v: number) => padT + ih - (v / maxV) * ih;

          const pathD = pts.map((p, i) => `${i ? "L" : "M"} ${X(i).toFixed(1)} ${Y(p.val).toFixed(1)}`).join(" ");
          const areaD = `${pathD} L ${X(n - 1).toFixed(1)} ${padT + ih} L ${X(0).toFixed(1)} ${padT + ih} Z`;

          // 3 linee guida orizzontali + etichette valore
          let grid = "";
          for (let k = 0; k <= 2; k++) {
            const val = (maxV / 2) * k;
            const yy = Y(val);
            grid += `<line class="gl" x1="${padL}" y1="${yy.toFixed(1)}" x2="${W - padR}" y2="${yy.toFixed(1)}" />`;
            grid += `<text class="axlab" x="2" y="${(yy - 4).toFixed(1)}" text-anchor="start">${nfInt.format(Math.round(val))}</text>`;
          }
          // ~6 etichette data sull'asse x
          let xlab = "";
          const passo = Math.max(1, Math.ceil(n / 6));
          for (let i = 0; i < n; i += passo) {
            const xx = X(i);
            const anc = xx < 24 ? "start" : xx > W - 24 ? "end" : "middle";
            xlab += `<text class="axlab" x="${xx.toFixed(1)}" y="${H - 8}" text-anchor="${anc}">${fmtJour(pts[i].date)}</text>`;
          }

          box.innerHTML =
            `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" role="img" aria-label="${tr("st.evolution")}">` +
            grid + xlab +
            `<path d="${areaD}" fill="${color}" fill-opacity="0.10" stroke="none" />` +
            `<path d="${pathD}" fill="none" stroke="${color}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />` +
            `<line class="cross" x1="0" y1="${padT}" x2="0" y2="${padT + ih}" />` +
            `<circle class="cdot" r="4" fill="${color}" stroke="#fff" stroke-width="1.5" />` +
            `</svg>`;

          const svg = box.querySelector("svg") as SVGSVGElement;
          const cross = box.querySelector(".cross") as SVGLineElement;
          const dot = box.querySelector(".cdot") as SVGCircleElement;
          const chart = box.closest(".chart") as HTMLElement;

          const move = (ev: PointerEvent) => {
            const rect = svg.getBoundingClientRect();
            const vx = ((ev.clientX - rect.left) / rect.width) * W;
            let i = n <= 1 ? 0 : Math.round(((vx - padL) / iw) * (n - 1));
            i = Math.max(0, Math.min(n - 1, i));
            const px = X(i), py = Y(pts[i].val);
            cross.setAttribute("x1", String(px)); cross.setAttribute("x2", String(px));
            cross.style.opacity = "1";
            dot.setAttribute("cx", String(px)); dot.setAttribute("cy", String(py));
            dot.style.opacity = "1";
            if (tip && chart) {
              const cr = chart.getBoundingClientRect();
              tip.style.display = "block";
              tip.style.left = ((px / W) * rect.width + (rect.left - cr.left)) + "px";
              tip.style.top = ((py / H) * rect.height + (rect.top - cr.top) - 10) + "px";
              tip.style.transform = "translate(-50%, -100%)";
              tip.textContent = `${fmtJour(pts[i].date)} · ${nfInt.format(pts[i].val)}`;
            }
          };
          const leave = () => {
            cross.style.opacity = "0"; dot.style.opacity = "0";
            if (tip) tip.style.display = "none";
          };
          svg.addEventListener("pointermove", move);
          svg.addEventListener("pointerleave", leave);
        }

        function renderGTable(id: string, rows: GLigne[], isPage: boolean) {
          const el = document.getElementById(id);
          if (!el) return;
          if (!rows.length) { el.innerHTML = `<p class="state" style="padding:1rem 0">${tr("st.noData")}</p>`; return; }
          el.innerHTML = rows.slice(0, 10).map((r) => {
            let label = r.key;
            if (isPage) { try { const u = new URL(r.key); label = u.pathname === "/" ? tr("nav.home") : u.pathname; } catch { /* garde brut */ } }
            return `<div class="gtab-row"><span class="gt-key" title="${esc(r.key)}">${esc(label)}</span>` +
              `<span class="gt-sub">${nfInt.format(r.impressions)}</span><span class="gt-n">${nfInt.format(r.clicks)}</span></div>`;
          }).join("");
        }

        function renderG(v: GDetail) {
          (document.getElementById("k-clicks") as HTMLElement).textContent = nfInt.format(v.kpi.clicks);
          (document.getElementById("k-impr") as HTMLElement).textContent = nfInt.format(v.kpi.impressions);
          (document.getElementById("k-ctr") as HTMLElement).textContent = (v.kpi.ctr * 100).toFixed(1).replace(".", ",") + " %";
          (document.getElementById("k-pos") as HTMLElement).textContent = v.kpi.position ? v.kpi.position.toFixed(1).replace(".", ",") : "—";
          setDelta("k-clicks-d", deltaPct(v.kpi.clicks, v.kpi.prev.clicks));
          setDelta("k-impr-d", deltaPct(v.kpi.impressions, v.kpi.prev.impressions));
          // CTR : variation en points de %
          const dctr = (v.kpi.ctr - v.kpi.prev.ctr) * 100;
          setDelta("k-ctr-d", Math.abs(dctr) < 0.05
            ? { txt: `— ${tr("st.stable")}`, cls: "" }
            : { txt: (dctr > 0 ? "▲ " : "▼ ") + Math.abs(dctr).toFixed(1).replace(".", ",") + " pt", cls: dctr > 0 ? "up" : "down" });
          // Position : plus bas = meilleur (donc baisse = vert)
          const dpos = v.kpi.position - v.kpi.prev.position;
          setDelta("k-pos-d", (!v.kpi.position || !v.kpi.prev.position || Math.abs(dpos) < 0.05)
            ? { txt: "", cls: "" }
            : { txt: (dpos < 0 ? "▲ " : "▼ ") + Math.abs(dpos).toFixed(1).replace(".", ","), cls: dpos < 0 ? "up" : "down" });

          gSerie = v.serie;
          drawLine("g-chart-clicks", "tip-clicks", v.serie.map((p) => ({ date: p.date, val: p.clicks })), "var(--c-accent)");
          drawLine("g-chart-impr", "tip-impr", v.serie.map((p) => ({ date: p.date, val: p.impressions })), "#5c6b7a");
          renderGTable("g-queries", v.topQueries, false);
          renderGTable("g-pages", v.topPages, true);
        }

        async function caricaG() {
          gState.style.display = "";
          gState.textContent = tr("sup.loading");
          gEmpty.style.display = "none";
          gContent.classList.add("loading");
          void caricaSources(); // provenance : charge en parallèle, indépendant
          try {
            const res = await fetch("/api/admin/search-console?detail=1&days=" + gDays, { headers });
            const v = (await res.json()) as GDetail;
            if (!v.configured) { gState.style.display = "none"; gContent.style.display = "none"; gEmpty.style.display = ""; return; }
            if (v.error) { gState.textContent = "Google : " + v.error; gContent.style.display = "none"; return; }
            gState.style.display = "none";
            gContent.style.display = "";
            renderG(v);
          } catch {
            gState.textContent = tr("common.netErr");
          } finally {
            gContent.classList.remove("loading");
            gLoaded = true;
          }
        }

        gPeriods.addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".rh-filter") as HTMLElement | null;
          if (!t || Number(t.dataset.d) === gDays) return;
          gDays = Number(t.dataset.d);
          gPeriods.querySelectorAll(".rh-filter").forEach((b) => b.classList.toggle("is-on", b === t));
          void caricaG();
        });

        // ============ PRENOTAZIONI ============
        type RSerie = { date: string; pren: number; canc: number; ns: number };
        type RStats = {
          totale: number; coperti: number; copertiMediPren: number;
          giornoTopIdx: number; giornoTopMedia: number;
          fasciaTopOra: string; fasciaTopPct: number;
          mediaTavoliGiorno: number; tempoMedioMin: number;
          spesaMediaCents: number; spesaCopertoCents: number; anticipoOre: number;
          cancellazioni: number; cancellazioniPct: number; noshow: number; noshowPct: number;
          presenzaPct: number; eventiSpeciali: number;
          serie: RSerie[]; perGiorno: number[];
          perOra: { ora: string; n: number }[];
          perFonte: { fonte: string; n: number }[];
          copertiServizio: { servizio: string; coperti: number }[];
        };
        const rState = document.getElementById("r-state") as HTMLElement;
        const rEmpty = document.getElementById("r-empty") as HTMLElement;
        const rContent = document.getElementById("r-content") as HTMLElement;
        const rPeriods = document.getElementById("r-periods") as HTMLElement;
        let rDays = 30, rLoaded = false;
        let rDati: RStats | null = null;

        const nf1 = (x: number) => x.toLocaleString(LOC, { maximumFractionDigits: 1 });
        function rTile(lab: string, big: string, sub: string): string {
          return `<div class="rkpi-item"><div class="rkpi-lab" title="${lab}">${lab}</div><div class="rkpi-val">${esc(big)}</div>${sub ? `<div class="rkpi-sub">${sub}</div>` : ""}</div>`;
        }
        function fmtMin(min: number): string {
          if (!min) return "\u2014";
          const h = Math.floor(min / 60), m = Math.round(min % 60);
          return h ? `${h}h${String(m).padStart(2, "0")}` : `${m}m`;
        }
        function fmtLead(ore: number): string {
          if (!ore) return "\u2014";
          return ore < 24 ? `${nf1(ore)} h` : `${nf1(ore / 24)} g`;
        }
        function giornoNome(idx: number, style: "long" | "short"): string {
          if (idx < 0) return "\u2014";
          const ref = new Date(2024, 0, 1 + idx); // 1 gen 2024 = lunedì
          return ref.toLocaleDateString(LOC, { weekday: style });
        }
        function rMulti(boxId: string, series: { data: number[]; color: string; area?: boolean }[], labels: string[]): void {
          const box = document.getElementById(boxId); if (!box) return;
          const W = Math.max(320, Math.round(box.clientWidth || 600));
          const H = 220, padT = 16, padB = 24, ih = H - padT - padB, n = labels.length;
          if (!n) { box.innerHTML = ""; return; }
          const max = Math.max(1, ...series.flatMap((s) => s.data));
          const X = (i: number) => (n <= 1 ? W / 2 : (i / (n - 1)) * W);
          const Y = (v: number) => padT + ih - (v / max) * ih;
          let g = "";
          for (let k = 0; k <= 2; k++) { const val = (max / 2) * k, yy = Y(val); g += `<line class="gl" x1="0" y1="${yy.toFixed(1)}" x2="${W}" y2="${yy.toFixed(1)}"/>`; g += `<text class="axlab" x="2" y="${(yy - 4).toFixed(1)}">${nfInt.format(Math.round(val))}</text>`; }
          let paths = "";
          for (const sr of series) {
            const d = sr.data.map((v, i) => `${i ? "L" : "M"}${X(i).toFixed(1)} ${Y(v).toFixed(1)}`).join(" ");
            if (sr.area) paths += `<path d="M${X(0).toFixed(1)} ${padT + ih} ${sr.data.map((v, i) => `L${X(i).toFixed(1)} ${Y(v).toFixed(1)}`).join(" ")} L${X(n - 1).toFixed(1)} ${padT + ih} Z" fill="${sr.color}" fill-opacity="0.12"/>`;
            paths += `<path d="${d}" fill="none" stroke="${sr.color}" stroke-width="2" stroke-linejoin="round"/>`;
          }
          let xl = ""; const step = Math.max(1, Math.ceil(n / 7));
          for (let i = 0; i < n; i += step) { const xx = X(i), a = xx < 24 ? "start" : xx > W - 24 ? "end" : "middle"; xl += `<text class="axlab" x="${xx.toFixed(1)}" y="${H - 6}" text-anchor="${a}">${labels[i]}</text>`; }
          box.innerHTML = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">${g}${paths}${xl}</svg>`;
        }
        function rBars(boxId: string, data: number[], labels: string[], color: string): void {
          const box = document.getElementById(boxId); if (!box) return;
          const W = Math.max(320, Math.round(box.clientWidth || 600));
          const H = 200, padT = 14, padB = 22, ih = H - padT - padB, n = data.length;
          if (!n) { box.innerHTML = ""; return; }
          const max = Math.max(1, ...data), gap = W / n, bw = gap * 0.6;
          let b = "";
          data.forEach((v, i) => {
            const h = (v / max) * ih, x = i * gap + (gap - bw) / 2, y = padT + ih - h;
            b += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" rx="3" fill="${color}"/>`;
            b += `<text class="rbar-lab" x="${(x + bw / 2).toFixed(1)}" y="${H - 6}" text-anchor="middle">${labels[i]}</text>`;
            if (v) b += `<text class="rbar-val" x="${(x + bw / 2).toFixed(1)}" y="${(y - 4).toFixed(1)}" text-anchor="middle">${nfInt.format(v)}</text>`;
          });
          box.innerHTML = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">${b}</svg>`;
        }
        function rHbars(boxId: string, rows: { k: string; v: number; c?: string }[]): void {
          const box = document.getElementById(boxId); if (!box) return;
          if (!rows.length) { box.innerHTML = `<p class="state" style="padding:1rem 0">${tr("st.noData")}</p>`; return; }
          const max = Math.max(1, ...rows.map((r) => r.v));
          box.innerHTML = rows.map((r) => `<div class="hb-row"><span class="hb-k">${esc(r.k)}</span><div class="hb-bar"><div class="hb-fill" style="width:${Math.max(4, Math.round((r.v / max) * 100))}%;background:${r.c || "var(--c-accent)"}"></div></div><span class="hb-val">${nfInt.format(r.v)}</span></div>`).join("");
        }
        const FONTE_LAB: Record<string, string> = { web: tr("st.srcWeb"), phone: tr("st.srcPhone"), walkin: tr("st.srcWalkin"), google: tr("st.srcGoogle"), altro: tr("st.srcOther") };
        const SVC_LAB: Record<string, string> = { midi: tr("st.svMidi"), soir: tr("st.svSoir") };

        function renderResa(): void {
          const d = rDati; if (!d) return;
          (document.getElementById("r-kpi1") as HTMLElement).innerHTML =
            rTile(tr("st.rTotal"), nfInt.format(d.totale), "") +
            rTile(tr("st.rCovers"), nfInt.format(d.coperti), `${nf1(d.copertiMediPren)} ${tr("st.rPerBooking")}`) +
            rTile(tr("st.rTopDay"), giornoNome(d.giornoTopIdx, "long"), d.giornoTopIdx >= 0 ? `${tr("st.rDayAvg")} ${nf1(d.giornoTopMedia)}` : "") +
            rTile(tr("st.rPeakSlot"), d.fasciaTopOra || "\u2014", d.fasciaTopOra ? `${Math.round(d.fasciaTopPct)}% ${tr("st.rOfTotal")}` : "");
          (document.getElementById("r-kpi2") as HTMLElement).innerHTML =
            rTile(tr("st.rAvgTables"), nf1(d.mediaTavoliGiorno), "") +
            rTile(tr("st.rTableTime"), fmtMin(d.tempoMedioMin), "") +
            rTile(tr("st.rAvgSpend"), euro(d.spesaMediaCents), d.spesaCopertoCents ? `${euro(d.spesaCopertoCents)} ${tr("st.rPerCover")}` : "") +
            rTile(tr("st.rLead"), fmtLead(d.anticipoOre), tr("st.rLeadSub"));
          (document.getElementById("r-kpi3") as HTMLElement).innerHTML =
            rTile(tr("st.rCancel"), nfInt.format(d.cancellazioni), `${nf1(d.cancellazioniPct)}% ${tr("st.rOfTotal")}`) +
            rTile(tr("st.rNoshow"), nfInt.format(d.noshow), `${nf1(d.noshowPct)}% ${tr("st.rOfTotal")}`) +
            rTile(tr("st.rShowRate"), `${Math.round(d.presenzaPct)}%`, tr("st.rShowRateSub")) +
            rTile(tr("st.rSpecial"), nfInt.format(d.eventiSpeciali), tr("st.rSpecialSub"));

          rMulti("r-trend", [
            { data: d.serie.map((x) => x.pren), color: "var(--c-accent)", area: true },
            { data: d.serie.map((x) => x.canc), color: "#7fa6ae" },
            { data: d.serie.map((x) => x.ns), color: "#5c6b7a" },
          ], d.serie.map((x) => fmtJour(x.date)));
          rBars("r-week", d.perGiorno, [0, 1, 2, 3, 4, 5, 6].map((i) => giornoNome(i, "short")), "var(--c-accent)");
          rBars("r-hours", d.perOra.map((o) => o.n), d.perOra.map((o) => o.ora.slice(0, 2)), "var(--c-accent)");
          rHbars("r-src", d.perFonte.map((f) => ({ k: FONTE_LAB[f.fonte] ?? f.fonte, v: f.n })));
          rHbars("r-svc", d.copertiServizio.map((x) => ({ k: SVC_LAB[x.servizio] ?? x.servizio, v: x.coperti, c: x.servizio === "midi" ? "#7fa6ae" : "var(--c-accent)" })));
        }

        async function caricaResa(): Promise<void> {
          rLoaded = true;
          rState.style.display = "block"; rState.textContent = tr("sup.loading");
          rEmpty.style.display = "none"; rContent.style.display = "none";
          try {
            const res = await fetch("/api/admin/stats-reservations?giorni=" + rDays, { headers });
            const j = await res.json();
            if (!res.ok) throw new Error(j.error || tr("res.connErr"));
            rDati = j.stats as RStats;
            rState.style.display = "none";
            if (!rDati || (rDati.totale === 0 && rDati.cancellazioni === 0)) { rEmpty.style.display = "block"; return; }
            rContent.style.display = "block";
            renderResa();
          } catch (e) {
            rState.textContent = (e as Error).message || tr("res.connErr");
          }
        }

        rPeriods.addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".rh-filter") as HTMLElement | null;
          if (!t || Number(t.dataset.g) === rDays) return;
          rDays = Number(t.dataset.g);
          rPeriods.querySelectorAll(".rh-filter").forEach((b) => b.classList.toggle("is-on", b === t));
          void caricaResa();
        });

        tabs2.addEventListener("click", (e) => {
          const t = (e.target as HTMLElement).closest(".tab2") as HTMLElement | null;
          if (!t) return;
          const tab = t.dataset.tab;
          tabs2.querySelectorAll(".tab2").forEach((b) => b.classList.toggle("is-on", b === t));
          paneFin.hidden = tab !== "fin";
          paneGgl.hidden = tab !== "ggl";
          paneResa.hidden = tab !== "resa";
          if (tab === "ggl" && !gLoaded) void caricaG();
          if (tab === "resa" && !rLoaded) void caricaResa();
        });

        // Ridisegna i grafici quando la finestra cambia (SVG rifitta la larghezza)
        let rzT: number | undefined;
        window.addEventListener("resize", () => {
          window.clearTimeout(rzT);
          rzT = window.setTimeout(() => {
            if (!paneGgl.hidden && gSerie.length) {
              drawLine("g-chart-clicks", "tip-clicks", gSerie.map((p) => ({ date: p.date, val: p.clicks })), "var(--c-accent)");
              drawLine("g-chart-impr", "tip-impr", gSerie.map((p) => ({ date: p.date, val: p.impressions })), "#5c6b7a");
            }
            if (!paneResa.hidden && rDati) renderResa();
          }, 180);
        });

        // Primo caricamento: usa le stats SSR (Fase 2) se presenti e il periodo
        // è ancora "day" (il default pre-calcolato dal server), senza fetch.
        let ssrStatsDati: Stats | null = null;
        try {
          const raw = document.getElementById("ssr-stats")?.textContent?.trim();
          if (raw && periodo === "day") ssrStatsDati = JSON.parse(raw);
        } catch {
          ssrStatsDati = null;
        }
        await carica(ssrStatsDati ?? undefined);
      })();
    </script>
  </body>
</html>
