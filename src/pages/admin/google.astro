          <p class="menu-note" style="margin-bottom:1.3rem">{t("gg.fotoNote")}</p>
          <div id="foto-body"><p class="fi-soon">{t("gg.attrLoading")}</p></div>
          <input type="file" id="foto-file" accept="image/*" style="display:none" />
