---
// Pannello admin — GOOGLE (recensioni della scheda Business Profile).
// Legge dalla cache locale (istantaneo); "Synchroniser" tira da Google.
// Rispondere / modificare / eliminare la risposta a ogni recensione.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHead from "../../components/admin/AdminHead.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import ImagePicker from "../../components/admin/ImagePicker.astro";
import "../../styles/fab.css";
import { CLIENT } from "../../config/client";
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";

const lang = await adminLang();
const t = adminT(lang);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("gg.title") + " — Admin " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@700&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-input: #e6e6e6;
        --c-bg: #ffffff;
        --c-text: #666666;
        --c-accent: #ff7300;
        --c-muted: #a6a6a6;
        --c-line: #ebebeb;
        --c-card: #ffffff;
        --font-title: "Quicksand", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; }
      #app { display: none; min-height: 100vh; flex-direction: column; }
      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; margin-bottom: 1.25rem; }
      h1 svg { width: 20px; height: 20px; fill: var(--c-accent); }

      /* Barra stato/statistiche */
      .g-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem; background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1rem 1.2rem; margin-bottom: 1.1rem; }
      .g-stat { display: flex; flex-direction: column; gap: .15rem; }
      .g-stat .k { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: var(--c-muted); }
      .g-stat .v { font-family: var(--font-title); font-size: 1.25rem; color: var(--c-text); }
      .g-stat .v small { font-size: .8rem; color: var(--c-muted); }
      .g-loc { font-family: var(--font-title); font-size: 1.05rem; color: var(--c-text); }
      .g-sync { margin-left: auto; display: inline-flex; align-items: center; gap: .5rem; background: var(--c-accent); color: var(--c-bg); border: none; font-family: var(--font-title); font-size: .95rem; letter-spacing: .03em; padding: .6rem 1.2rem; border-radius: 999px; cursor: pointer; transition: background .2s, transform .15s; }
      .g-sync:hover { background: var(--c-hover); transform: scale(.97); }
      .g-sync:disabled { opacity: .55; cursor: default; transform: none; }
      .g-synced-at { flex-basis: 100%; font-size: .74rem; color: var(--c-muted); }

      /* Filtri */
      .g-filters { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
      .g-fil { background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-title); font-size: .85rem; letter-spacing: .03em; padding: .45rem 1.1rem; border-radius: 999px; cursor: pointer; transition: all .15s; }
      .g-fil:hover { border-color: var(--c-accent); color: var(--c-text); }
      .g-fil.active { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }

      .state { text-align: center; color: var(--c-muted); padding: 2.5rem 1rem; }

      /* Card recensione */
      .rev { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1.1rem 1.2rem; margin-bottom: .9rem; }
      .rev-top { display: flex; align-items: center; gap: .8rem; }
      .rev-av { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; background: var(--c-input); flex: 0 0 auto; display: flex; align-items: center; justify-content: center; color: var(--c-muted); font-family: var(--font-title); font-size: 1.1rem; overflow: hidden; }
      .rev-av img { width: 100%; height: 100%; object-fit: cover; }
      .rev-who { min-width: 0; }
      .rev-name { font-family: var(--font-title); font-size: 1rem; color: var(--c-text); }
      .rev-date { font-size: .76rem; color: var(--c-muted); margin-top: .1rem; }
      .rev-stars { margin-left: auto; color: #f5b301; font-size: 1rem; letter-spacing: 1px; white-space: nowrap; }
      .rev-stars .off { color: var(--c-line); }
      .rev-body { color: var(--c-text); font-size: .92rem; line-height: 1.5; margin-top: .7rem; white-space: pre-wrap; }

      /* Risposta esistente */
      .rev-reply { margin-top: .85rem; border-left: 3px solid var(--c-accent); background: color-mix(in srgb, var(--c-accent) 7%, transparent); border-radius: 0 10px 10px 0; padding: .6rem .85rem; }
      .rev-reply .lab { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: var(--c-accent); font-weight: 700; }
      .rev-reply .txt { color: var(--c-text); font-size: .88rem; line-height: 1.45; margin-top: .25rem; white-space: pre-wrap; }

      /* Azioni + editor risposta */
      .rev-actions { display: flex; gap: .5rem; margin-top: .8rem; flex-wrap: wrap; }
      .rev-btn { background: transparent; border: 1px solid var(--c-line); color: var(--c-text); font-family: var(--font-body); font-size: .82rem; padding: .4rem .9rem; border-radius: 999px; cursor: pointer; transition: all .15s; }
      .rev-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .rev-btn[data-act="reply"] { border-color: var(--c-accent); }
      .rev-btn.danger:hover { border-color: #d33; color: #d33; }
      .rev-btn.armato { border-color: #d33; color: #fff; background: #a3320f; }
      .rev-edit { margin-top: .8rem; display: none; }
      .rev-edit.open { display: block; }
      .rev-edit textarea { width: 100%; min-height: 84px; resize: vertical; background: var(--c-input); border: 1px solid var(--c-line); color: var(--c-text); border-radius: 10px; padding: .6rem .8rem; font-family: var(--font-body); font-size: .9rem; }
      .rev-edit textarea:focus { outline: none; border-color: var(--c-accent); }
      .rev-edit .row { display: flex; gap: .5rem; margin-top: .55rem; }
      .rev-pub { background: var(--c-accent); color: var(--c-bg); border: none; font-family: var(--font-title); font-size: .85rem; padding: .5rem 1.1rem; border-radius: 999px; cursor: pointer; }
      .rev-pub:disabled { opacity: .55; cursor: default; }

      /* Pannello "non collegato" */
      .g-connect { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1.6rem 1.4rem; text-align: center; }
      .g-connect h2 { font-family: var(--font-title); font-weight: 400; font-size: 1.2rem; color: var(--c-text); margin-bottom: .5rem; }
      .g-connect p { color: var(--c-muted); font-size: .9rem; max-width: 460px; margin: 0 auto 1.1rem; line-height: 1.5; }
      .g-connect button { background: var(--c-accent); color: var(--c-bg); border: none; font-family: var(--font-title); font-size: 1rem; letter-spacing: .03em; padding: .75rem 1.6rem; border-radius: 999px; cursor: pointer; }

      /* Barra sede collegata */
      .g-locbar { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; padding: .6rem .9rem; background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px; }
      .g-locbar-k { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: var(--c-muted); }
      .g-locbar-t { font-size: .95rem; color: var(--c-text); }
      .g-locbar-t b { font-family: var(--font-title); color: var(--c-text); }
      .g-locbar-b { margin-left: auto; background: transparent; border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-body); font-size: .8rem; padding: .35rem .85rem; border-radius: 999px; cursor: pointer; transition: all .15s; }
      .g-locbar-b:hover { border-color: var(--c-accent); color: var(--c-accent); }

      /* Selettore sede */
      .g-picker { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1.3rem 1.3rem; margin-bottom: 1.1rem; }
      .g-picker h2 { font-family: var(--font-title); font-weight: 400; font-size: 1.15rem; color: var(--c-text); margin-bottom: .35rem; }
      .g-picker > p { color: var(--c-muted); font-size: .88rem; margin-bottom: 1rem; line-height: 1.45; }
      .g-picker .state.is-err { color: #d33; text-align: left; padding: .5rem 0; }
      .pick { display: flex; align-items: center; gap: .9rem; width: 100%; text-align: left; background: var(--c-input); border: 1px solid var(--c-line); border-radius: 12px; padding: .85rem 1rem; margin-bottom: .6rem; cursor: pointer; transition: border-color .15s, background .15s; }
      .pick:hover { border-color: var(--c-accent); }
      .pick.is-current { border-color: var(--c-accent); }
      .pick-body { min-width: 0; flex: 1; }
      .pick-name { font-family: var(--font-title); font-size: 1rem; color: var(--c-text); }
      .pick-addr { font-size: .8rem; color: var(--c-muted); margin-top: .1rem; }
      .pick-badge { font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; color: var(--c-accent); border: 1px solid var(--c-accent); border-radius: 999px; padding: .1rem .5rem; white-space: nowrap; }
      .pick-go { font-size: .8rem; font-family: var(--font-title); color: var(--c-bg); background: var(--c-accent); border-radius: 999px; padding: .35rem .9rem; white-space: nowrap; }

      .g-fil-n { opacity: .65; font-size: .85em; margin-left: .15em; font-variant-numeric: tabular-nums; }
      .g-fil.active .g-fil-n { opacity: .9; }

      /* Lista recensioni in masonry — colonne bilanciate via JS, in ordine di data */
      #list { display: flex; gap: .9rem; align-items: flex-start; }
      .g-col { flex: 1 1 0; min-width: 0; }
      .g-col .rev { margin-bottom: .9rem; }

      .g-dist { display: flex; gap: .7rem; flex-wrap: wrap; align-items: center; }
      .g-dist-i { font-size: .85rem; color: var(--c-text); white-space: nowrap; font-variant-numeric: tabular-nums; }
      .g-dist-i b { color: #f5b301; font-weight: 400; margin-right: .12rem; }

      /* Tab di sezione (Recensioni, e in futuro Profilo/Foto/Post) */
      .mtabs { display: flex; gap: .4rem; flex-wrap: wrap; padding-bottom: 1.25rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--c-line); }
      .mtab { background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-title); font-size: 1rem; letter-spacing: .05em; padding: .5rem 1.2rem; cursor: pointer; border-radius: 10px; transition: background .15s, color .15s, border-color .15s; }
      .mtab:hover { color: var(--c-text); border-color: var(--c-accent); }
      .mtab.is-active { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .g-tab-panel { display: block; }

      /* Layout: fiche business (sinistra) + recensioni (a destra) */
      .g-split { display: flex; gap: 1.1rem; align-items: flex-start; }
      .g-reviews { flex: 1 1 0; min-width: 0; }
      .g-fiche { flex: 0 0 360px; max-width: 360px; position: sticky; top: 96px; }
      @media (max-width: 1000px) { .g-split { flex-direction: column; } .g-fiche { position: static; flex-basis: auto; max-width: none; width: 100%; } }

      /* Card fiche (replica Google Business) */
      .fiche { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; overflow: hidden; }
      .fiche-map { width: 100%; height: 170px; border: 0; display: block; background: var(--c-input); }
      .fiche-b { padding: 1rem 1.1rem; }
      .fiche-head { display: flex; align-items: center; gap: .7rem; }
      .fiche-head-t { min-width: 0; }
      .fiche-logo { width: 52px; height: 52px; border-radius: 12px; object-fit: cover; flex: 0 0 auto; background: var(--c-input); }
      .fiche-name { font-family: var(--font-title); font-size: 1.15rem; color: var(--c-text); letter-spacing: .02em; }
      .fiche-cat { font-size: .8rem; color: var(--c-muted); margin-top: .1rem; }
      .fiche-rate { display: flex; align-items: center; gap: .4rem; margin: .55rem 0 .3rem; }
      .fiche-rate .rv { font-family: var(--font-title); font-size: 1.1rem; color: var(--c-text); }
      .fiche-rate .st { color: #f5b301; letter-spacing: 1px; }
      .fiche-rate .st .off { color: var(--c-line); }
      .fiche-rate .ct { font-size: .78rem; color: var(--c-muted); }
      .fiche-row { display: flex; gap: .55rem; align-items: flex-start; padding: .6rem 0; border-top: 1px solid var(--c-line); font-size: .86rem; color: var(--c-text); }
      .fiche-row > svg { width: 16px; height: 16px; flex: 0 0 auto; margin-top: .12rem; fill: none; stroke: var(--c-accent); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
      .fiche-row a { color: var(--c-text); text-decoration: none; word-break: break-word; }
      .fiche-row a:hover { text-decoration: underline; color: var(--c-accent); }
      .fiche-hours { width: 100%; }
      .fiche-hours .hr { display: flex; justify-content: space-between; gap: .5rem; font-size: .82rem; padding: .1rem 0; color: var(--c-muted); }
      .fiche-hours .hr.today { color: var(--c-text); font-weight: 700; }
      .fiche-hours .hr .rg { text-align: right; }
      .fiche-desc { font-size: .84rem; color: var(--c-muted); line-height: 1.5; padding-top: .6rem; border-top: 1px solid var(--c-line); margin-top: .1rem; white-space: pre-wrap; }

      /* Toast */
      .toast { position: fixed; left: 50%; bottom: 6rem; transform: translateX(-50%) translateY(1rem); background: var(--c-text); color: var(--c-bg); padding: .7rem 1.2rem; border-radius: 999px; font-size: .88rem; opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; z-index: 200; }
      .toast.is-visible { opacity: 1; transform: translateX(-50%) translateY(0); }
      .toast.is-error { background: #d33; color: #fff; }
      /* ---- Tab POST ---- */
      .p-compose { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px; padding: 1.1rem 1.2rem; margin-bottom: 1.5rem; }
      .p-types { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: 1rem; }
      .p-type { background: none; border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-body); font-size: .85rem; padding: .4rem 1rem; border-radius: 999px; cursor: pointer; }
      .p-type.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .p-field { margin-bottom: .85rem; }
      .p-lab { display: block; font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--c-muted); margin: 0 0 .35rem; }
      .p-field input, .p-field select, .p-field textarea { width: 100%; box-sizing: border-box; background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text); font-family: var(--font-body); font-size: .9rem; padding: .55rem .7rem; border-radius: 8px; }
      .p-field textarea { min-height: 90px; resize: vertical; }
      .p-field input:focus, .p-field select:focus, .p-field textarea:focus { outline: none; border-color: var(--c-accent); }
      .p-dates { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
      .p-photo { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
      .p-photo-prev { width: 64px; height: 64px; border-radius: 10px; overflow: hidden; flex-shrink: 0; border: 1px solid var(--c-line); background: rgba(255,255,255,.04); display: flex; align-items: center; justify-content: center; color: var(--c-muted); }
      .p-photo-prev svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; }
      .p-photo-prev img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .p-photo-btn { background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text); font-family: var(--font-body); font-size: .9rem; padding: .55rem 1.2rem; border-radius: 999px; cursor: pointer; transition: border-color .15s, color .15s; }
      .p-photo-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .p-photo-state { font-size: .78rem; color: var(--c-muted); }
      .p-cta-row { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
      .p-offer .p-lab { margin-top: .6rem; }
      .p-actions { display: flex; align-items: center; gap: .8rem; margin-top: .4rem; }
      .p-msg { font-size: .8rem; color: #ff8a8f; margin-right: auto; }
      .p-list-tit { font-family: var(--font-title); font-size: 1.1rem; letter-spacing: .04em; margin: 0 0 .8rem; }
      .p-card { display: flex; gap: .9rem; background: var(--c-card); border: 1px solid var(--c-line); border-radius: 10px; padding: .8rem .95rem; margin-bottom: .7rem; }
      .p-card-img img { width: 70px; height: 70px; object-fit: cover; border-radius: 8px; display: block; }
      .p-card-main { flex: 1; min-width: 0; }
      .p-card-top { display: flex; align-items: center; gap: .5rem; margin-bottom: .3rem; }
      .p-badge { font-size: .68rem; text-transform: uppercase; letter-spacing: .05em; background: color-mix(in srgb, var(--c-accent) 18%, transparent); color: var(--c-accent); border-radius: 999px; padding: .12rem .55rem; font-weight: 700; }
      .p-state-b { font-size: .68rem; text-transform: uppercase; color: #ffcf8f; }
      .p-card-dt { font-size: .75rem; color: var(--c-muted); margin-left: auto; }
      .p-card-txt { margin: 0 0 .5rem; font-size: .9rem; line-height: 1.5; color: var(--c-text); }
      .p-card-act { display: flex; align-items: center; gap: .8rem; }
      .p-card-link { display: inline-flex; align-items: center; gap: .3rem; font-size: .82rem; font-weight: 600; color: var(--c-accent); text-decoration: none; }
      .p-card-link:hover { color: var(--c-accent); opacity: .8; }
      .p-card-link .p-card-link-arr { transition: transform .15s; }
      .p-card-link:hover .p-card-link-arr { transform: translateX(3px); }
      .i-btn { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 1px solid var(--c-line); color: var(--c-text); cursor: pointer; border-radius: 50%; font-size: .95rem; transition: border-color .15s, color .15s, background .15s; }
      .i-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .i-btn:disabled { opacity: .3; cursor: not-allowed; }
      .i-del { background: rgba(237, 28, 36, 0.25); border-color: rgba(237, 28, 36, 0.35); color: #fff; }
      .i-del:hover { background: rgba(237, 28, 36, 0.55); border-color: #ed1c24; color: #fff; }
      .i-del .k-ico { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .i-del.confirm { background: #a3320f; border-color: #a3320f; color: #fff; width: auto; padding: 0 .7rem; border-radius: 999px; font-size: .75rem; }
      .p-del { margin-left: auto; }
      @media (max-width: 560px) { .p-dates, .p-cta-row { grid-template-columns: 1fr; } }
      /* Sinistra: riquadro pubblica · Destra: post pubblicati (desktop / tablet landscape) */
      .p-cols, .p-col { display: block; }
      .p-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; align-items: start; }
      /* Colonna sinistra sticky SOLO su desktop/tablet landscape (sotto l'header ~80px) */
      @media (min-width: 901px) and (orientation: landscape), (min-width: 1025px) {
        .p-overlay { position: sticky; top: calc(48px + 2rem + 1rem); align-self: start; }
      }
      /* Tablet in orizzontale (es. iPad mini 1024): colonne 2/5 - 3/5 */
      @media (orientation: landscape) and (min-width: 901px) and (max-width: 1180px) {
        .p-layout { grid-template-columns: 2fr 3fr; }
      }
      .p-compose { margin-bottom: 0; }
      .p-fab, .p-close { display: none; }
      /* Tablet verticale / mobile: riquadro pubblica in un MODALE (FAB), lista a tutta larghezza */
      @media (max-width: 900px), (orientation: portrait) and (max-width: 1024px) {
        .p-layout { display: block; }
        .p-compose { margin-bottom: 1.5rem; }
        body.tab-posts .p-fab { display: inline-flex; }
        .p-overlay { position: fixed; inset: 0; z-index: 300; background: rgba(0,0,0,.65); display: none; align-items: center; justify-content: center; padding: 1rem; overflow-y: auto; }
        .p-overlay.is-open { display: flex; }
        .p-overlay .p-compose { width: 100%; max-width: 560px; margin: 0; max-height: 90vh; overflow-y: auto; position: relative; }
        .p-close { display: block; position: absolute; top: .5rem; right: .7rem; background: none; border: none; color: var(--c-muted); font-size: 1.7rem; line-height: 1; cursor: pointer; }
      }
    </style>
    <AdminHead />
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <h1>
          <svg viewBox="0 0 210 210" aria-hidden="true" style="fill:var(--c-accent);stroke:none"><path d="M0,105C0,47.103,47.103,0,105,0c23.383,0,45.515,7.523,64.004,21.756l-24.4,31.696C133.172,44.652,119.477,40,105,40c-35.841,0-65,29.159-65,65s29.159,65,65,65c28.867,0,53.398-18.913,61.852-45H105V85h105v20c0,57.897-47.103,105-105,105S0,162.897,0,105z" /></svg>
          Google
        </h1>

        <div class="mtabs" id="g-tabs">
          <button class="mtab is-active" data-gtab="reviews">{t("gg.tabReviews")}</button>
          <button class="mtab" data-gtab="posts">{t("gg.tabPosts")}</button>
        </div>

        <div class="g-tab-panel" data-gpanel="reviews">
        <!-- Non ancora configurata: il setup e' lato MOODD (super admin) -->
        <div class="g-connect" id="notready" style="display:none">
          <h2>{t("gg.notReadyTitle")}</h2>
          <p>{t("gg.notReadyHint")}</p>
        </div>

        <!-- Collegato -->
        <div id="dash" style="display:none">
          <div id="reviews-area" style="display:none">
          <div class="g-split">
          <aside class="g-fiche" id="g-fiche"></aside>
          <div class="g-reviews">
          <div class="g-filters">
            <button class="g-fil active" data-f="all">{t("gg.fAll")} <span class="g-fil-n" data-n="all"></span></button>
            <button class="g-fil" data-f="toreply">{t("gg.fToReply")} <span class="g-fil-n" data-n="toreply"></span></button>
            <button class="g-fil" data-f="replied">{t("gg.fReplied")} <span class="g-fil-n" data-n="replied"></span></button>
            <button class="g-fil" data-f="high">{t("gg.fHigh")} <span class="g-fil-n" data-n="high"></span></button>
            <button class="g-fil" data-f="low">{t("gg.fLow")} <span class="g-fil-n" data-n="low"></span></button>
            <button class="g-sync" id="sync-btn" type="button">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
              <span id="sync-lbl">{t("gg.syncNow")}</span>
            </button>
          </div>

          <div class="state" id="state">{t("sup.loading")}</div>
          <div id="list"></div>
          </div>
          </div>
          </div>
        </div>
        </div>

        <div class="g-tab-panel" data-gpanel="posts" style="display:none">
          <div class="g-connect" id="posts-notready" style="display:none">
            <h2>{t("gg.notReadyTitle")}</h2>
            <p>{t("gg.postsConnectHint")}</p>
          </div>
          <div id="posts-area" style="display:none">
            <button class="fab-add fab-pill p-fab" id="p-fab" type="button"><span class="fab-plus">+</span> {t("gg.tabPosts")}</button>
            <div class="p-layout">
            <div class="p-overlay" id="p-overlay">
            <div class="p-compose">
              <button type="button" class="p-close" id="p-close" aria-label="Fermer">×</button>
              <div class="p-types" id="p-types">
                <button type="button" class="p-type is-on" data-pt="STANDARD">{t("gg.postStandard")}</button>
                <button type="button" class="p-type" data-pt="EVENT">{t("gg.postEvent")}</button>
                <button type="button" class="p-type" data-pt="OFFER">{t("gg.postOffer")}</button>
              </div>

              <div class="p-cols">
              <div class="p-col">
              <div class="p-field" data-when="EVENT OFFER">
                <label class="p-lab">{t("gg.postTitle")}</label>
                <input type="text" id="p-title" maxlength="58" />
              </div>
              <div class="p-field p-dates" data-when="EVENT OFFER">
                <div><label class="p-lab">{t("gg.postStart")}</label><input type="date" id="p-start" /></div>
                <div><label class="p-lab">{t("gg.postEnd")}</label><input type="date" id="p-end" /></div>
              </div>

              <div class="p-field">
                <label class="p-lab">{t("gg.postText")}</label>
                <textarea id="p-summary" maxlength="1500" placeholder={t("gg.postTextPh")}></textarea>
              </div>

              <div class="p-field">
                <label class="p-lab">{t("gg.postPhoto")}</label>
                <div class="p-photo">
                  <span class="p-photo-prev" id="p-photo-prev"></span>
                  <button type="button" class="p-photo-btn" id="p-photo-up">{t("cli.uploadPhoto")}</button>
                  <button type="button" class="p-photo-btn" id="p-photo-lib">{t("menu.library")}</button>
                  <button type="button" class="p-photo-btn" id="p-photo-clear" style="display:none">{t("gg.postRemovePhoto")}</button>
                  <input type="file" id="p-photo-file" accept="image/*" style="display:none" />
                  <span class="p-photo-state" id="p-photo-state"></span>
                </div>
              </div>

              </div>
              <div class="p-col">
              <div class="p-field p-cta" data-when="STANDARD EVENT">
                <label class="p-lab">{t("gg.postCta")}</label>
                <div class="p-cta-row">
                  <select id="p-cta-type">
                    <option value="">{t("gg.postCtaNone")}</option>
                    <option value="LEARN_MORE">{t("gg.ctaLearnMore")}</option>
                    <option value="BOOK">{t("gg.ctaBook")}</option>
                    <option value="ORDER">{t("gg.ctaOrder")}</option>
                    <option value="SIGN_UP">{t("gg.ctaSignUp")}</option>
                    <option value="SHOP">{t("gg.ctaShop")}</option>
                    <option value="CALL">{t("gg.ctaCall")}</option>
                  </select>
                  <input type="url" id="p-cta-url" placeholder="https://" />
                </div>
              </div>

              <div class="p-field p-offer" data-when="OFFER">
                <label class="p-lab">{t("gg.postCoupon")}</label>
                <input type="text" id="p-coupon" maxlength="58" placeholder={t("gg.postCouponPh")} />
                <label class="p-lab">{t("gg.postRedeemUrl")}</label>
                <input type="url" id="p-redeem" placeholder="https://" />
                <label class="p-lab">{t("gg.postTerms")}</label>
                <textarea id="p-terms" maxlength="5000"></textarea>
              </div>

              </div>
              </div>

              <div class="p-actions">
                <span class="p-msg" id="p-msg"></span>
                <button type="button" class="g-sync" id="p-publish">{t("gg.postPublish")}</button>
              </div>
            </div>
            </div>

            <div class="p-published">
            <div class="state" id="p-state" style="display:none">{t("sup.loading")}</div>
            <div id="p-list"></div>
            </div>
            </div>
          </div>
        </div>
      </main>
      <AdminFooter />
    </div>

    <div class="toast" id="toast"></div>

    <ImagePicker />

    <AdminNav current="google" />
    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";
      import { comprimiFoto } from "../../lib/admin/imageCompress";

      const LANG = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(LANG);
      const LOC = ADMIN_LOCALE[LANG] ?? "fr-BE";

      type Rec = {
        review_id: string;
        author: string;
        photo: string;
        rating: number;
        comment: string;
        create_time: string | null;
        reply_comment: string | null;
        reply_time: string | null;
      };

      function esc(s: string): string {
        return String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }
      function stelle(n: number): string {
        let out = "";
        for (let i = 1; i <= 5; i++) out += i <= n ? "★" : '<span class="off">★</span>';
        return out;
      }
      function dataFmt(iso: string | null): string {
        if (!iso) return "";
        try {
          return new Date(iso).toLocaleDateString(LOC, { day: "2-digit", month: "short", year: "numeric" });
        } catch {
          return "";
        }
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement | null;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement | null;
        const notready = document.getElementById("notready") as HTMLDivElement;
        const dash = document.getElementById("dash") as HTMLDivElement;
        const syncBtn = document.getElementById("sync-btn") as HTMLButtonElement;
        const syncLbl = document.getElementById("sync-lbl") as HTMLSpanElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const listEl = document.getElementById("list") as HTMLDivElement;
        const toastEl = document.getElementById("toast") as HTMLDivElement;
        const reviewsArea = document.getElementById("reviews-area") as HTMLDivElement;
        const ficheEl = document.getElementById("g-fiche") as HTMLDivElement;

        logoutBtn?.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        if (userEmail) userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        async function authFresh(): Promise<Record<string, string>> {
          const { data } = await supabaseBrowser.auth.getSession();
          return { Authorization: `Bearer ${data.session?.access_token ?? session?.access_token ?? ""}`, "Content-Type": "application/json" };
        }

        let toastTimer: number | undefined;
        function toast(msg: string, isErr = false) {
          toastEl.textContent = msg;
          toastEl.classList.toggle("is-error", isErr);
          toastEl.classList.add("is-visible");
          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => toastEl.classList.remove("is-visible"), 2600);
        }

        let recensioni: Rec[] = [];
        let filtro: "all" | "toreply" | "replied" | "high" | "low" = "all";

        function cardHTML(r: Rec): string {
          const av = r.photo
            ? `<span class="rev-av"><img src="${esc(r.photo)}" alt="" referrerpolicy="no-referrer" /></span>`
            : `<span class="rev-av">${esc((r.author || "?").slice(0, 1).toUpperCase())}</span>`;
          const rispostaHTML = r.reply_comment
            ? `<div class="rev-reply"><div class="lab">${esc(tr("gg.yourReply"))}</div><div class="txt">${esc(r.reply_comment)}</div></div>`
            : "";
          const azioni = r.reply_comment
            ? `<button class="rev-btn" data-act="edit">${esc(tr("gg.replyEdit"))}</button>
               <button class="rev-btn danger" data-act="del">${esc(tr("gg.replyDelete"))}</button>`
            : `<button class="rev-btn" data-act="reply">${esc(tr("gg.reply"))}</button>`;
          return `
            <div class="rev" data-id="${esc(r.review_id)}">
              <div class="rev-top">
                ${av}
                <div class="rev-who">
                  <div class="rev-name">${esc(r.author || "—")}</div>
                  <div class="rev-date">${dataFmt(r.create_time)}</div>
                </div>
                <div class="rev-stars">${stelle(r.rating)}</div>
              </div>
              ${r.comment ? `<div class="rev-body">${esc(r.comment)}</div>` : ""}
              ${rispostaHTML}
              <div class="rev-actions">${azioni}</div>
              <div class="rev-edit">
                <textarea placeholder="${esc(tr("gg.replyPh"))}">${esc(r.reply_comment ?? "")}</textarea>
                <div class="row">
                  <button class="rev-pub" data-act="publish">${esc(tr("gg.replyPublish"))}</button>
                  <button class="rev-btn" data-act="cancel">${esc(tr("gg.cancel"))}</button>
                </div>
              </div>
            </div>`;
        }

        function passa(r: Rec, f: string): boolean {
          if (f === "toreply") return !r.reply_comment;
          if (f === "replied") return Boolean(r.reply_comment);
          if (f === "high") return r.rating >= 4;
          if (f === "low") return r.rating >= 1 && r.rating <= 3;
          return true; // all
        }

        function aggiornaConteggi() {
          for (const f of ["all", "toreply", "replied", "high", "low"]) {
            const n = recensioni.filter((r) => passa(r, f)).length;
            const el = document.querySelector(`.g-fil-n[data-n="${f}"]`);
            if (el) el.textContent = String(n);
          }
        }

        function colCount(): number {
          const w = listEl.clientWidth || window.innerWidth;
          return Math.max(1, Math.min(3, Math.floor(w / 300)));
        }

        function render() {
          if (!recensioni.length) {
            stateEl.style.display = "block";
            stateEl.textContent = tr("gg.emptySync");
            listEl.innerHTML = "";
            aggiornaConteggi();
            return;
          }
          aggiornaConteggi();
          const arr = recensioni.filter((r) => passa(r, filtro));
          stateEl.style.display = arr.length ? "none" : "block";
          if (!arr.length) { stateEl.textContent = tr("gg.empty"); listEl.innerHTML = ""; return; }

          // Masonry: le recensioni (gia' ordinate dalla piu' recente) vengono
          // messe in ordine nella colonna piu' bassa -> lettura recente->vecchia
          // da sinistra a destra, senza buchi.
          const n = colCount();
          listEl.innerHTML = "";
          const cols: HTMLDivElement[] = [];
          for (let i = 0; i < n; i++) {
            const c = document.createElement("div");
            c.className = "g-col";
            cols.push(c);
            listEl.appendChild(c);
          }
          const h = new Array(n).fill(0);
          for (const r of arr) {
            let mi = 0;
            for (let i = 1; i < n; i++) if (h[i] < h[mi]) mi = i;
            const wrap = document.createElement("div");
            wrap.innerHTML = cardHTML(r);
            const card = wrap.firstElementChild as HTMLElement | null;
            if (!card) continue;
            cols[mi].appendChild(card);
            h[mi] += card.offsetHeight + 14;
          }
        }

        let resizeT: number | undefined;
        window.addEventListener("resize", () => {
          window.clearTimeout(resizeT);
          resizeT = window.setTimeout(render, 150);
        });

        type Scheda = {
          title: string; address: string; phone: string; website: string;
          category: string; description: string; logo: string; lat: number | null; lng: number | null;
          hours: { d: number; ranges: string[] }[];
        };

        function ficheIcon(inner: string): string {
          return `<svg viewBox="0 0 24 24" aria-hidden="true">${inner}</svg>`;
        }

        function renderFiche(p: Scheda | null, rating: string, count: string) {
          if (!p) { ficheEl.style.display = "none"; ficheEl.innerHTML = ""; return; }
          ficheEl.style.display = "block";
          const dayNames: string[] = [];
          for (let i = 0; i < 7; i++) {
            dayNames.push(new Intl.DateTimeFormat(LOC, { weekday: "short" }).format(new Date(Date.UTC(2024, 0, 1 + i))));
          }
          const todayIdx = (new Date().getDay() + 6) % 7;
          const rNum = Math.round(Number(rating) || 0);
          const stelleF = [1, 2, 3, 4, 5].map((n) => (n <= rNum ? "★" : `<span class="off">★</span>`)).join("");
          const mapQ = p.lat != null && p.lng != null ? `${p.lat},${p.lng}` : `${p.title} ${p.address}`;
          const hoursHTML = p.hours
            .map((h) => `<div class="hr${h.d === todayIdx ? " today" : ""}"><span>${esc(dayNames[h.d])}</span><span class="rg">${h.ranges.length ? esc(h.ranges.join(", ")) : esc(tr("gg.closed"))}</span></div>`)
            .join("");
          const site = p.website.replace("https://", "").replace("http://", "");
          const rShow = rating ? Number(rating).toFixed(1) : "—";
          ficheEl.innerHTML = `
            <div class="fiche">
              <iframe class="fiche-map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=${encodeURIComponent(mapQ)}&z=15&output=embed"></iframe>
              <div class="fiche-b">
                <div class="fiche-head">
                  ${p.logo ? `<img class="fiche-logo" src="${esc(p.logo)}" alt="" referrerpolicy="no-referrer" />` : ""}
                  <div class="fiche-head-t">
                    <div class="fiche-name">${esc(p.title)}</div>
                    ${p.category ? `<div class="fiche-cat">${esc(p.category)}</div>` : ""}
                  </div>
                </div>
                <div class="fiche-rate"><span class="rv">${esc(rShow)}</span><span class="st">${stelleF}</span><span class="ct">${esc(count)} ${esc(tr("gg.total"))}</span></div>
                ${p.address ? `<div class="fiche-row">${ficheIcon('<path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>')}<a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQ)}" target="_blank" rel="noopener">${esc(p.address)}</a></div>` : ""}
                ${p.phone ? `<div class="fiche-row">${ficheIcon('<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7 12.8 12.8 0 0 0 .6 2.6 2 2 0 0 1-.5 2.1L8 9.5a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5 12.8 12.8 0 0 0 2.6.6A2 2 0 0 1 22 16.9z"/>')}<a href="tel:${esc(p.phone)}">${esc(p.phone)}</a></div>` : ""}
                ${p.website ? `<div class="fiche-row">${ficheIcon('<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/>')}<a href="${esc(p.website)}" target="_blank" rel="noopener">${esc(site)}</a></div>` : ""}
                <div class="fiche-row">${ficheIcon('<circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/>')}<div class="fiche-hours">${hoursHTML}</div></div>
                ${p.description ? `<div class="fiche-desc">${esc(p.description)}</div>` : ""}
              </div>
            </div>`;
        }

        async function carica() {
          try {
            const res = await fetch("/api/admin/google/reviews", { headers: await authFresh() });
            if (!res.ok) throw new Error();
            const j = await res.json();
            const bound = Boolean(j.connected && (j.location ?? "").trim());
            if (!bound) {
              // Setup (collegamento + scelta scheda) e' lato super admin: qui niente config.
              notready.style.display = "block";
              dash.style.display = "none";
              return;
            }
            notready.style.display = "none";
            dash.style.display = "block";
            reviewsArea.style.display = "block";

            recensioni = (j.reviews ?? []) as Rec[];
            renderFiche((j.profile ?? null) as Scheda | null, j.rating ?? "", j.count ?? "");
            render();
          } catch {
            stateEl.style.display = "block";
            stateEl.textContent = tr("res.connErr");
          }
        }

        // Filtri
        document.querySelectorAll<HTMLButtonElement>(".g-fil").forEach((b) => {
          b.addEventListener("click", () => {
            document.querySelectorAll(".g-fil").forEach((x) => x.classList.remove("active"));
            b.classList.add("active");
            filtro = (b.dataset.f as typeof filtro) ?? "all";
            render();
          });
        });

        // Sincronizza
        syncBtn.addEventListener("click", async () => {
          syncBtn.disabled = true;
          const old = syncLbl.textContent;
          syncLbl.textContent = tr("gg.syncing");
          try {
            const res = await fetch("/api/admin/google/sync", { method: "POST", headers: await authFresh() });
            const j = await res.json();
            if (res.status === 409 && j.needChoice) { notready.style.display = "block"; dash.style.display = "none"; return; }
            if (!res.ok) throw new Error(j.error || "");
            if (j.reviewError) toast(`${tr("gg.reviewErr")} ${j.reviewError}`, true);
            else toast(tr("gg.synced"));
            await carica();
          } catch (e) {
            toast((e as Error).message || tr("res.connErr"), true);
          } finally {
            syncBtn.disabled = false;
            syncLbl.textContent = old;
          }
        });

        // Azioni sulle card (delega)
        listEl.addEventListener("click", async (ev) => {
          const btn = (ev.target as HTMLElement).closest("button") as HTMLButtonElement | null;
          if (!btn) return;
          const card = btn.closest(".rev") as HTMLElement | null;
          if (!card) return;
          const id = card.dataset.id!;
          const act = btn.dataset.act;
          const editor = card.querySelector(".rev-edit") as HTMLElement;
          const ta = card.querySelector(".rev-edit textarea") as HTMLTextAreaElement;

          if (act === "reply" || act === "edit") {
            editor.classList.add("open");
            ta.focus();
            return;
          }
          if (act === "cancel") {
            editor.classList.remove("open");
            return;
          }
          if (act === "publish") {
            const testo = ta.value.trim();
            if (!testo) { ta.focus(); return; }
            btn.disabled = true;
            btn.textContent = tr("gg.replySaving");
            try {
              const res = await fetch("/api/admin/google/reply", {
                method: "POST",
                headers: await authFresh(),
                body: JSON.stringify({ reviewId: id, comment: testo }),
              });
              const j = await res.json();
              if (!res.ok) throw new Error(j.error || "");
              const r = recensioni.find((x) => x.review_id === id);
              if (r) { r.reply_comment = testo; r.reply_time = new Date().toISOString(); }
              toast(tr("gg.replySaved"));
              render();
            } catch (e) {
              toast((e as Error).message || tr("res.connErr"), true);
              btn.disabled = false;
              btn.textContent = tr("gg.replyPublish");
            }
            return;
          }
          if (act === "del") {
            if (!btn.classList.contains("armato")) {
              btn.classList.add("armato");
              btn.textContent = tr("gg.replyDeleteQ");
              window.setTimeout(() => {
                btn.classList.remove("armato");
                btn.textContent = tr("gg.replyDelete");
              }, 4000);
              return;
            }
            try {
              const res = await fetch(`/api/admin/google/reply?reviewId=${encodeURIComponent(id)}`, {
                method: "POST",
                headers: { ...(await authFresh()), "X-Method-Override": "DELETE" },
              });
              const j = await res.json();
              if (!res.ok) throw new Error(j.error || "");
              const r = recensioni.find((x) => x.review_id === id);
              if (r) { r.reply_comment = null; r.reply_time = null; }
              toast(tr("gg.replyDeleted"));
              render();
            } catch (e) {
              toast((e as Error).message || tr("res.connErr"), true);
            }
            return;
          }
        });

        document.getElementById("g-tabs")?.addEventListener("click", (ev) => {
          const b = (ev.target as HTMLElement).closest(".mtab") as HTMLElement | null;
          if (!b) return;
          document.querySelectorAll("#g-tabs .mtab").forEach((x) => x.classList.remove("is-active"));
          b.classList.add("is-active");
          const tab = b.dataset.gtab;
          document.querySelectorAll<HTMLElement>(".g-tab-panel").forEach((p) => {
            p.style.display = p.dataset.gpanel === tab ? "block" : "none";
          });
        });

        // ============ POST GOOGLE (Novità / Evento / Offerta) ============
        (function initPost() {
          let loaded = false;
          let pType = "STANDARD";
          let pPhoto = "";
          let postLang = "fr";
          const area = document.getElementById("posts-area") as HTMLElement | null;
          const notready = document.getElementById("posts-notready") as HTMLElement | null;
          const typesEl = document.getElementById("p-types");
          const prev = document.getElementById("p-photo-prev");
          const clearBtn = document.getElementById("p-photo-clear") as HTMLElement | null;
          const upBtn = document.getElementById("p-photo-up") as HTMLButtonElement | null;
          const libBtn = document.getElementById("p-photo-lib");
          const fileInput = document.getElementById("p-photo-file") as HTMLInputElement | null;
          const photoState = document.getElementById("p-photo-state");
          const ICO_IMG = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>';
          const pubBtn = document.getElementById("p-publish") as HTMLButtonElement | null;
          const msg = document.getElementById("p-msg");
          const listEl = document.getElementById("p-list");
          const stateEl = document.getElementById("p-state") as HTMLElement | null;
          const fab = document.getElementById("p-fab");
          const overlay = document.getElementById("p-overlay");
          const closeBtn = document.getElementById("p-close");
          const apri = () => overlay?.classList.add("is-open");
          const chiudi = () => overlay?.classList.remove("is-open");
          fab?.addEventListener("click", apri);
          closeBtn?.addEventListener("click", chiudi);
          overlay?.addEventListener("click", (e) => { if (e.target === overlay) chiudi(); });
          const gv = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value ?? "";
          const sv = (id: string, v: string) => { const e = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null; if (e) e.value = v; };
          const escP = (x: unknown) => String(x ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
          const ICO_TRASH = '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>';

          function applyType() {
            typesEl?.querySelectorAll(".p-type").forEach((b) => b.classList.toggle("is-on", (b as HTMLElement).dataset.pt === pType));
            document.querySelectorAll<HTMLElement>("#posts-area [data-when]").forEach((el) => {
              el.style.display = (el.dataset.when || "").split(" ").includes(pType) ? "" : "none";
            });
          }
          function renderPhoto() {
            if (prev) prev.innerHTML = pPhoto ? `<img src="${escP(pPhoto)}" alt="" />` : ICO_IMG;
            if (clearBtn) clearBtn.style.display = pPhoto ? "" : "none";
          }
          renderPhoto();
          typesEl?.addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest(".p-type") as HTMLElement | null; if (!b?.dataset.pt) return; pType = b.dataset.pt; applyType(); });
          libBtn?.addEventListener("click", () => window.dispatchEvent(new CustomEvent("imgpick:open")));
          upBtn?.addEventListener("click", () => fileInput?.click());
          fileInput?.addEventListener("change", async () => {
            const file = fileInput.files?.[0];
            if (!file || !upBtn) return;
            upBtn.disabled = true;
            if (photoState) photoState.textContent = tr("cli.uploading");
            try {
              const foto = await comprimiFoto(file);
              if (foto.size > 4 * 1024 * 1024) throw new Error(tr("cli.fileTooBig"));
              const b64 = await new Promise<string>((res, rej) => { const r = new FileReader(); r.onload = () => res(String(r.result).split(",")[1] ?? ""); r.onerror = () => rej(new Error()); r.readAsDataURL(foto); });
              const resp = await fetch("/api/admin/upload", { method: "POST", headers: await authFresh(), body: JSON.stringify({ filename: foto.name, data: b64, bucket: "popups", folder: "google" }) });
              const j = await resp.json();
              if (!resp.ok || !j.url) throw new Error(j.error ?? tr("cli.uploadError"));
              pPhoto = j.url as string; renderPhoto();
              if (photoState) photoState.textContent = "";
            } catch (err) {
              if (photoState) photoState.textContent = err instanceof Error ? err.message : tr("cli.uploadError");
            } finally {
              upBtn.disabled = false; fileInput.value = "";
            }
          });
          clearBtn?.addEventListener("click", () => { pPhoto = ""; renderPhoto(); });
          window.addEventListener("imgpick:pick", (e) => {
            const panel = document.querySelector('[data-gpanel="posts"]') as HTMLElement | null;
            if (!panel || panel.style.display === "none") return; // il picker serve solo al tab Post
            pPhoto = (e as CustomEvent<{ url: string }>).detail.url; renderPhoto();
          });

          const badge = (t: string) => t === "EVENT" ? tr("gg.postEvent") : t === "OFFER" ? tr("gg.postOffer") : tr("gg.postStandard");
          function postCard(p: any): string {
            const foto = p.media?.[0]?.googleUrl || p.media?.[0]?.sourceUrl || "";
            const dt = p.createTime ? new Date(p.createTime).toLocaleDateString() : "";
            const testo = escP((p.summary || p.event?.title || "").slice(0, 160));
            const link = p.searchUrl ? `<a class="p-card-link" href="${escP(p.searchUrl)}" target="_blank" rel="noopener">${tr("gg.postView")} <span class="p-card-link-arr">\u2192</span></a>` : "";
            const stato = p.state && p.state !== "LIVE" ? `<span class="p-state-b">${escP(p.state)}</span>` : "";
            return `<div class="p-card">${foto ? `<span class="p-card-img"><img src="${escP(foto)}" alt="" /></span>` : ""}<div class="p-card-main"><div class="p-card-top"><span class="p-badge">${badge(p.topicType)}</span>${stato}<span class="p-card-dt">${escP(dt)}</span></div><p class="p-card-txt">${testo || "\u2014"}</p><div class="p-card-act">${link}<button type="button" class="i-btn i-del p-del" data-name="${escP(p.name || "")}" title="${tr("common.delete")}">${ICO_TRASH}</button></div></div></div>`;
          }
          async function loadPosts() {
            if (stateEl) stateEl.style.display = "";
            try {
              const r = await fetch("/api/admin/google/posts", { headers: await authFresh() });
              const j = await r.json();
              if (!r.ok) { if (area) area.style.display = "none"; if (notready) notready.style.display = ""; return; }
              if (notready) notready.style.display = "none";
              if (area) area.style.display = "";
              const limite = Date.now() - 365 * 24 * 3600 * 1000; // solo ultimi 12 mesi
              const posts = ((j.posts || []) as any[]).filter((p) => !p.createTime || Date.parse(p.createTime) >= limite);
              if (listEl) listEl.innerHTML = posts.length ? posts.map(postCard).join("") : `<p class="state">${tr("gg.postNone")}</p>`;
            } catch { if (listEl) listEl.innerHTML = ""; } finally { if (stateEl) stateEl.style.display = "none"; }
          }
          async function caricaLang() {
            try { const r = await fetch("/api/admin/pages", { headers: await authFresh() }); if (r.ok) { const j = await r.json(); if (Array.isArray(j.publicLangs) && j.publicLangs[0]) postLang = String(j.publicLangs[0]); } } catch { /* default fr */ }
          }
          pubBtn?.addEventListener("click", async () => {
            if (!pubBtn) return;
            if (msg) msg.textContent = "";
            const body = { tipo: pType, lang: postLang, summary: gv("p-summary"), photo: pPhoto,
              ctaType: gv("p-cta-type"), ctaUrl: gv("p-cta-url"), title: gv("p-title"),
              startDate: gv("p-start"), endDate: gv("p-end"), couponCode: gv("p-coupon"),
              redeemUrl: gv("p-redeem"), terms: gv("p-terms") };
            pubBtn.disabled = true; const orig = pubBtn.textContent; pubBtn.textContent = tr("gg.postPublishing");
            try {
              const r = await fetch("/api/admin/google/posts", { method: "POST", headers: await authFresh(), body: JSON.stringify(body) });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || tr("res.connErr"));
              toast(tr("gg.postDone"));
              ["p-summary", "p-title", "p-start", "p-end", "p-cta-url", "p-coupon", "p-redeem", "p-terms"].forEach((id) => sv(id, ""));
              pPhoto = ""; renderPhoto();
              chiudi();
              await loadPosts();
            } catch (e) { if (msg) msg.textContent = (e as Error).message; }
            finally { pubBtn.disabled = false; pubBtn.textContent = orig; }
          });
          listEl?.addEventListener("click", async (e) => {
            const b = (e.target as HTMLElement).closest(".i-del") as HTMLButtonElement | null; if (!b) return;
            const name = b.dataset.name || ""; if (!name) return;
            // Conferma a 2 tocchi (standard RH): 1° tap = pillola rossa piena, 2° = elimina
            if (!b.classList.contains("confirm")) {
              b.classList.add("confirm");
              b.textContent = tr("common.confirm");
              window.setTimeout(() => { if (b.classList.contains("confirm")) { b.classList.remove("confirm"); b.innerHTML = ICO_TRASH; } }, 3000);
              return;
            }
            b.disabled = true;
            try {
              const r = await fetch(`/api/admin/google/posts?name=${encodeURIComponent(name)}`, { method: "POST", headers: { ...(await authFresh()), "X-Method-Override": "DELETE" } });
              if (!r.ok) { const j = await r.json(); throw new Error(j.error || tr("res.connErr")); }
              toast(tr("gg.postDeleted"));
              await loadPosts();
            } catch (err) { b.disabled = false; b.classList.remove("confirm"); b.innerHTML = ICO_TRASH; toast((err as Error).message, true); }
          });
          document.getElementById("g-tabs")?.addEventListener("click", async (ev) => {
            const b = (ev.target as HTMLElement).closest(".mtab") as HTMLElement | null;
            if (!b) return;
            const isPosts = b.dataset.gtab === "posts";
            document.body.classList.toggle("tab-posts", isPosts);
            window.dispatchEvent(new Event("resize")); // ricalcola la posizione del FAB sopra l'isola
            if (!isPosts) return;
            applyType();
            if (loaded) return; loaded = true;
            await caricaLang(); await loadPosts();
          });
        })();

        await carica();
      })();
    </script>
  </body>
</html>
