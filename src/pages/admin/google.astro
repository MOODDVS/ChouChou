---
// Pannello admin — GOOGLE (recensioni della scheda Business Profile).
// Legge dalla cache locale (istantaneo); "Synchroniser" tira da Google.
// Rispondere / modificare / eliminare la risposta a ogni recensione.
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminHead from "../../components/admin/AdminHead.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminFooter from "../../components/admin/AdminFooter.astro";
import ImagePicker from "../../components/admin/ImagePicker.astro";
import "../../styles/fab.css";
import "../../styles/filters.css";
import "../../styles/savebar.css";
import { CLIENT } from "../../config/client";
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";

const lang = await adminLang();
const t = adminT(lang);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("gg.title") + " — Admin " + CLIENT.nome}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@700&family=Nunito+Sans:wght@400;600;700;900&display=swap"
    />
    <style is:global>
      :root {
        --c-input: #e6e6e6;
        --c-bg: #ffffff;
        --c-text: #666666;
        --c-accent: #ff7300;
        --c-muted: #a6a6a6;
        --c-line: #ebebeb;
        --c-card: #ffffff;
        --font-title: "Quicksand", system-ui, sans-serif;
        --font-body: "Nunito Sans", system-ui, sans-serif;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); min-height: 100vh; }
      #app { display: none; min-height: 100vh; flex-direction: column; }
      h1 { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 0.55rem; margin-bottom: 1.25rem; }
      h1 svg { width: 20px; height: 20px; fill: var(--c-accent); }

      /* Barra stato/statistiche */
      .g-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem; background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1rem 1.2rem; margin-bottom: 1.1rem; }
      .g-stat { display: flex; flex-direction: column; gap: .15rem; }
      .g-stat .k { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: var(--c-muted); }
      .g-stat .v { font-family: var(--font-title); font-size: 1.25rem; color: var(--c-text); }
      .g-stat .v small { font-size: .8rem; color: var(--c-muted); }
      .g-loc { font-family: var(--font-title); font-size: 1.05rem; color: var(--c-text); }
      .g-sync { margin-left: auto; display: inline-flex; align-items: center; gap: .5rem; background: var(--c-accent); color: var(--c-bg); border: none; font-family: var(--font-title); font-size: .95rem; letter-spacing: .03em; padding: .6rem 1.2rem; border-radius: 999px; cursor: pointer; transition: background .2s, transform .15s; }
      .g-sync:hover { background: var(--c-hover); transform: scale(.97); }
      .g-sync:disabled { opacity: .55; cursor: default; transform: none; }
      .g-synced-at { flex-basis: 100%; font-size: .74rem; color: var(--c-muted); }

      /* Filtri */
      .g-filters { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
      .g-fil { background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-title); font-size: .85rem; letter-spacing: .03em; padding: .45rem 1.1rem; border-radius: 999px; cursor: pointer; transition: all .15s; }
      .g-fil:hover { border-color: var(--c-accent); color: var(--c-text); }
      .g-fil.active { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }

      .state { text-align: center; color: var(--c-muted); padding: 2.5rem 1rem; }

      /* Card recensione */
      .rev { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1.1rem 1.2rem; margin-bottom: .9rem; }
      .rev-top { display: flex; align-items: center; gap: .8rem; }
      .rev-av { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; background: var(--c-input); flex: 0 0 auto; display: flex; align-items: center; justify-content: center; color: var(--c-muted); font-family: var(--font-title); font-size: 1.1rem; overflow: hidden; }
      .rev-av img { width: 100%; height: 100%; object-fit: cover; }
      .rev-who { min-width: 0; }
      .rev-name { font-family: var(--font-title); font-size: 1rem; color: var(--c-text); }
      .rev-date { font-size: .76rem; color: var(--c-muted); margin-top: .1rem; }
      .rev-stars { margin-left: auto; color: #f5b301; font-size: 1rem; letter-spacing: 1px; white-space: nowrap; }
      .rev-stars .off { color: var(--c-line); }
      .rev-body { color: var(--c-text); font-size: .92rem; line-height: 1.5; margin-top: .7rem; white-space: pre-wrap; }

      /* Risposta esistente */
      .rev-reply { margin-top: .85rem; border-left: 3px solid var(--c-accent); background: color-mix(in srgb, var(--c-accent) 7%, transparent); border-radius: 0 10px 10px 0; padding: .6rem .85rem; }
      .rev-reply .lab { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: var(--c-accent); font-weight: 700; }
      .rev-reply .txt { color: var(--c-text); font-size: .88rem; line-height: 1.45; margin-top: .25rem; white-space: pre-wrap; }

      /* Azioni + editor risposta */
      .rev-actions { display: flex; gap: .5rem; margin-top: .8rem; flex-wrap: wrap; }
      .rev-btn { background: transparent; border: 1px solid var(--c-line); color: var(--c-text); font-family: var(--font-body); font-size: .82rem; padding: .4rem .9rem; border-radius: 999px; cursor: pointer; transition: all .15s; }
      .rev-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .rev-btn[data-act="reply"] { border-color: var(--c-accent); }
      .rev-btn.danger:hover { border-color: #d33; color: #d33; }
      .rev-btn.armato { border-color: #d33; color: #fff; background: #a3320f; }
      .rev-edit { margin-top: .8rem; display: none; }
      .rev-edit.open { display: block; }
      .rev-edit textarea { width: 100%; min-height: 84px; resize: vertical; background: var(--c-input); border: 1px solid var(--c-line); color: var(--c-text); border-radius: 10px; padding: .6rem .8rem; font-family: var(--font-body); font-size: .9rem; }
      .rev-edit textarea:focus { outline: none; border-color: var(--c-accent); }
      .rev-edit .row { display: flex; gap: .5rem; margin-top: .55rem; }
      .rev-pub { background: var(--c-accent); color: var(--c-bg); border: none; font-family: var(--font-title); font-size: .85rem; padding: .5rem 1.1rem; border-radius: 999px; cursor: pointer; }
      .rev-pub:disabled { opacity: .55; cursor: default; }

      /* Pannello "non collegato" */
      .g-connect { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1.6rem 1.4rem; text-align: center; }
      .g-connect h2 { font-family: var(--font-title); font-weight: 400; font-size: 1.2rem; color: var(--c-text); margin-bottom: .5rem; }
      .g-connect p { color: var(--c-muted); font-size: .9rem; max-width: 460px; margin: 0 auto 1.1rem; line-height: 1.5; }
      .g-connect button { background: var(--c-accent); color: var(--c-bg); border: none; font-family: var(--font-title); font-size: 1rem; letter-spacing: .03em; padding: .75rem 1.6rem; border-radius: 999px; cursor: pointer; }

      /* Barra sede collegata */
      .g-locbar { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; padding: .6rem .9rem; background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px; }
      .g-locbar-k { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: var(--c-muted); }
      .g-locbar-t { font-size: .95rem; color: var(--c-text); }
      .g-locbar-t b { font-family: var(--font-title); color: var(--c-text); }
      .g-locbar-b { margin-left: auto; background: transparent; border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-body); font-size: .8rem; padding: .35rem .85rem; border-radius: 999px; cursor: pointer; transition: all .15s; }
      .g-locbar-b:hover { border-color: var(--c-accent); color: var(--c-accent); }

      /* Selettore sede */
      .g-picker { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1.3rem 1.3rem; margin-bottom: 1.1rem; }
      .g-picker h2 { font-family: var(--font-title); font-weight: 400; font-size: 1.15rem; color: var(--c-text); margin-bottom: .35rem; }
      .g-picker > p { color: var(--c-muted); font-size: .88rem; margin-bottom: 1rem; line-height: 1.45; }
      .g-picker .state.is-err { color: #d33; text-align: left; padding: .5rem 0; }
      .pick { display: flex; align-items: center; gap: .9rem; width: 100%; text-align: left; background: var(--c-input); border: 1px solid var(--c-line); border-radius: 12px; padding: .85rem 1rem; margin-bottom: .6rem; cursor: pointer; transition: border-color .15s, background .15s; }
      .pick:hover { border-color: var(--c-accent); }
      .pick.is-current { border-color: var(--c-accent); }
      .pick-body { min-width: 0; flex: 1; }
      .pick-name { font-family: var(--font-title); font-size: 1rem; color: var(--c-text); }
      .pick-addr { font-size: .8rem; color: var(--c-muted); margin-top: .1rem; }
      .pick-badge { font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; color: var(--c-accent); border: 1px solid var(--c-accent); border-radius: 999px; padding: .1rem .5rem; white-space: nowrap; }
      .pick-go { font-size: .8rem; font-family: var(--font-title); color: var(--c-bg); background: var(--c-accent); border-radius: 999px; padding: .35rem .9rem; white-space: nowrap; }

      .g-fil-n { opacity: .65; font-size: .85em; margin-left: .15em; font-variant-numeric: tabular-nums; }
      .g-fil.active .g-fil-n { opacity: .9; }

      /* Lista recensioni in masonry — colonne bilanciate via JS, in ordine di data */
      #list { display: flex; gap: .9rem; align-items: flex-start; }
      .g-col { flex: 1 1 0; min-width: 0; }
      .g-col .rev { margin-bottom: .9rem; }

      .g-dist { display: flex; gap: .7rem; flex-wrap: wrap; align-items: center; }
      .g-dist-i { font-size: .85rem; color: var(--c-text); white-space: nowrap; font-variant-numeric: tabular-nums; }
      .g-dist-i b { color: #f5b301; font-weight: 400; margin-right: .12rem; }

      /* Tab di sezione (Recensioni, e in futuro Profilo/Foto/Post) */
      .mtabs { display: flex; gap: .4rem; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-bottom: 1.25rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--c-line); }
      .mtabs::-webkit-scrollbar { display: none; }
      .mtab { flex-shrink: 0; background: var(--c-card); border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-title); font-size: 1rem; letter-spacing: .05em; padding: .5rem 1.2rem; cursor: pointer; border-radius: 10px; transition: background .15s, color .15s, border-color .15s; }
      .mtab:hover { color: var(--c-text); border-color: var(--c-accent); }
      .mtab.is-active { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .g-tab-panel { display: block; }
      .menu-hd { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.3rem; }
      .menu-tit { font-family: var(--font-title); font-size: 1.3rem; letter-spacing: .02em; margin: 0 0 .3rem; }
      .menu-note { color: var(--c-muted); font-size: .85rem; line-height: 1.5; margin: 0; max-width: 620px; }
      .menu-row { display: flex; justify-content: space-between; gap: 1rem; padding: .4rem 0; border-bottom: 1px solid var(--c-line); font-size: .9rem; }
      .menu-row:last-child { border-bottom: none; }
      .menu-row .p { color: var(--c-accent); font-weight: 600; white-space: nowrap; }
      .foto-duo { display: flex; gap: 2rem; flex-wrap: wrap; }
      .foto-one { flex: 1 1 260px; min-width: 0; }
      .foto-one .fi-h3 { margin-top: 0; }
      .foto-single { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
      .foto-thumb { width: 120px; height: 120px; object-fit: cover; border-radius: 12px; border: 1px solid var(--c-line); background: var(--c-bg); display: block; }
      .foto-logo .foto-thumb, .foto-logo .foto-empty { width: 90px; height: 90px; }
      .foto-thumb.big { width: 220px; height: 120px; }
      .foto-empty { width: 120px; height: 120px; border-radius: 12px; border: 1px dashed var(--c-line); display: flex; align-items: center; justify-content: center; color: var(--c-muted); }
      .foto-thumb.big + .foto-btns, .foto-empty.big { }
      .foto-btns { display: flex; gap: .5rem; flex-wrap: wrap; }
      .foto-btn { background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text); font-family: var(--font-body); font-size: .85rem; padding: .45rem 1.1rem; border-radius: 999px; cursor: pointer; transition: border-color .15s, background .15s, color .15s; }
      .foto-btn:hover { border-color: var(--c-accent); }
      .foto-btn.del { color: var(--c-muted); }
      .foto-btn.confirm, .foto-x.confirm { background: #d64545; border-color: #d64545; color: #fff; }
      .foto-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: .8rem; }
      .foto-cell { position: relative; }
      .foto-cell img { width: 100%; height: 130px; object-fit: cover; border-radius: 10px; border: 1px solid var(--c-line); display: block; }
      .foto-x { position: absolute; top: 6px; right: 6px; background: rgba(10,20,26,.72); border: none; color: #fff; border-radius: 999px; width: 28px; height: 28px; font-size: 1.05rem; line-height: 1; cursor: pointer; }
      .foto-add { min-height: 130px; border: 1px dashed color-mix(in srgb, var(--c-accent) 55%, var(--c-line)); background: color-mix(in srgb, var(--c-accent) 10%, transparent); color: var(--c-accent); border-radius: 10px; cursor: pointer; font-family: var(--font-title); font-size: .85rem; letter-spacing: .03em; }
      .foto-add:hover { background: color-mix(in srgb, var(--c-accent) 20%, transparent); }

      /* Layout: fiche business (sinistra) + recensioni (a destra) */
      .g-split { display: flex; gap: 1.1rem; align-items: flex-start; }
      .g-reviews { flex: 1 1 0; min-width: 0; }
      .g-fiche { flex: 0 0 360px; max-width: 360px; position: sticky; top: 96px; }
      @media (max-width: 1000px) { .g-split { flex-direction: column; } .g-fiche { position: static; flex-basis: auto; max-width: none; width: 100%; } }

      /* Card fiche (replica Google Business) */
      .fiche { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; overflow: hidden; }
      .fiche-map { width: 100%; height: 170px; border: 0; display: block; background: var(--c-input); }
      .fiche-b { padding: 1rem 1.1rem; }
      .fiche-head { display: flex; align-items: center; gap: .7rem; }
      .fiche-head-t { min-width: 0; }
      .fiche-logo { width: 52px; height: 52px; border-radius: 12px; object-fit: cover; flex: 0 0 auto; background: var(--c-input); }
      .fiche-name { font-family: var(--font-title); font-size: 1.15rem; color: var(--c-text); letter-spacing: .02em; }
      .fiche-cat { font-size: .8rem; color: var(--c-muted); margin-top: .1rem; }
      .fiche-rate { display: flex; align-items: center; gap: .4rem; margin: .55rem 0 .3rem; }
      .fiche-rate .rv { font-family: var(--font-title); font-size: 1.1rem; color: var(--c-text); }
      .fiche-rate .st { color: #f5b301; letter-spacing: 1px; }
      .fiche-rate .st .off { color: var(--c-line); }
      .fiche-rate .ct { font-size: .78rem; color: var(--c-muted); }
      .fiche-row { display: flex; gap: .55rem; align-items: flex-start; padding: .6rem 0; border-top: 1px solid var(--c-line); font-size: .86rem; color: var(--c-text); }
      .fiche-row > svg { width: 16px; height: 16px; flex: 0 0 auto; margin-top: .12rem; fill: none; stroke: var(--c-accent); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
      .fiche-row a { color: var(--c-text); text-decoration: none; word-break: break-word; }
      .fiche-row a:hover { text-decoration: underline; color: var(--c-accent); }
      .fiche-hours { width: 100%; }
      .fiche-hours .hr { display: flex; justify-content: space-between; gap: .5rem; font-size: .82rem; padding: .1rem 0; color: var(--c-muted); }
      .fiche-hours .hr.today { color: var(--c-text); font-weight: 700; }
      .fiche-hours .hr .rg { text-align: right; }
      .fiche-desc { font-size: .84rem; color: var(--c-muted); line-height: 1.5; padding-top: .6rem; border-top: 1px solid var(--c-line); margin-top: .1rem; white-space: pre-wrap; }

      /* Toast */
      .toast { position: fixed; left: 50%; bottom: 6rem; transform: translateX(-50%) translateY(1rem); background: var(--c-text); color: var(--c-bg); padding: .7rem 1.2rem; border-radius: 999px; font-size: .88rem; opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; z-index: 200; }
      .toast.is-visible { opacity: 1; transform: translateX(-50%) translateY(0); }
      .toast.is-error { background: #d33; color: #fff; }
      /* ---- Tab POST ---- */
      .p-compose { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px; padding: 1.1rem 1.2rem; margin-bottom: 1.5rem; }
      .p-types { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: 1rem; }
      .p-type { background: none; border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-body); font-size: .85rem; padding: .4rem 1rem; border-radius: 999px; cursor: pointer; }
      .p-type.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .p-field { margin-bottom: .85rem; }
      .p-lab { display: block; font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--c-muted); margin: 0 0 .35rem; }
      .p-field input, .p-field select, .p-field textarea { width: 100%; box-sizing: border-box; background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text); font-family: var(--font-body); font-size: .9rem; padding: .55rem .7rem; border-radius: 8px; }
      .p-field textarea { min-height: 90px; resize: vertical; }
      .p-field input:focus, .p-field select:focus, .p-field textarea:focus { outline: none; border-color: var(--c-accent); }
      .p-dates { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
      .p-photo { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
      .p-photo-prev { width: 64px; height: 64px; border-radius: 10px; overflow: hidden; flex-shrink: 0; border: 1px solid var(--c-line); background: rgba(255,255,255,.04); display: flex; align-items: center; justify-content: center; color: var(--c-muted); }
      .p-photo-prev svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; }
      .p-photo-prev img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .p-photo-btn { background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text); font-family: var(--font-body); font-size: .9rem; padding: .55rem 1.2rem; border-radius: 999px; cursor: pointer; transition: border-color .15s, color .15s; }
      .p-photo-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .p-photo-state { font-size: .78rem; color: var(--c-muted); }
      .p-cta-row { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
      .p-offer .p-lab { margin-top: .6rem; }
      .p-actions { display: flex; align-items: center; gap: .8rem; margin-top: .4rem; }
      .p-msg { font-size: .8rem; color: #ff8a8f; margin-right: auto; }
      .p-list-tit { font-family: var(--font-title); font-size: 1.1rem; letter-spacing: .04em; margin: 0 0 .8rem; }
      .p-card { display: flex; gap: .9rem; background: var(--c-card); border: 1px solid var(--c-line); border-radius: 10px; padding: .8rem .95rem; margin-bottom: .7rem; }
      .p-card-img img { width: 70px; height: 70px; object-fit: cover; border-radius: 8px; display: block; }
      .p-card-main { flex: 1; min-width: 0; }
      .p-card-top { display: flex; align-items: center; gap: .5rem; margin-bottom: .3rem; }
      .p-badge { font-size: .68rem; text-transform: uppercase; letter-spacing: .05em; background: color-mix(in srgb, var(--c-accent) 18%, transparent); color: var(--c-accent); border-radius: 999px; padding: .12rem .55rem; font-weight: 700; }
      .p-state-b { font-size: .68rem; text-transform: uppercase; color: #ffcf8f; }
      .p-card-dt { font-size: .75rem; color: var(--c-muted); margin-left: auto; }
      .p-card-txt { margin: 0 0 .5rem; font-size: .9rem; line-height: 1.5; color: var(--c-text); }
      .p-card-act { display: flex; align-items: center; gap: .8rem; }
      .p-card-link { display: inline-flex; align-items: center; gap: .3rem; font-size: .82rem; font-weight: 600; color: var(--c-accent); text-decoration: none; }
      .p-card-link:hover { color: var(--c-accent); opacity: .8; }
      .p-card-link .p-card-link-arr { transition: transform .15s; }
      .p-card-link:hover .p-card-link-arr { transform: translateX(3px); }
      .i-btn { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 1px solid var(--c-line); color: var(--c-text); cursor: pointer; border-radius: 50%; font-size: .95rem; transition: border-color .15s, color .15s, background .15s; }
      .i-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .i-btn:disabled { opacity: .3; cursor: not-allowed; }
      .i-del { background: rgba(237, 28, 36, 0.25); border-color: rgba(237, 28, 36, 0.35); color: #fff; }
      .i-del:hover { background: rgba(237, 28, 36, 0.55); border-color: #ed1c24; color: #fff; }
      .i-del .k-ico { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .i-del.confirm { background: #a3320f; border-color: #a3320f; color: #fff; width: auto; padding: 0 .7rem; border-radius: 999px; font-size: .75rem; }
      .p-del { margin-left: auto; }
      @media (max-width: 560px) { .p-dates, .p-cta-row { grid-template-columns: 1fr; } }
      /* Sinistra: riquadro pubblica · Destra: post pubblicati (desktop / tablet landscape) */
      .p-cols, .p-col { display: block; }
      .p-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; align-items: start; }
      /* Colonna sinistra sticky SOLO su desktop/tablet landscape (sotto l'header ~80px) */
      @media (min-width: 901px) and (orientation: landscape), (min-width: 1025px) {
        .p-overlay { position: sticky; top: calc(48px + 2rem + 1rem); align-self: start; }
      }
      /* Tablet in orizzontale (es. iPad mini 1024): colonne 2/5 - 3/5 */
      @media (orientation: landscape) and (min-width: 901px) and (max-width: 1180px) {
        .p-layout { grid-template-columns: 2fr 3fr; }
      }
      .p-compose { margin-bottom: 0; }
      .p-fab, .p-close { display: none; }
      /* Tablet verticale / mobile: riquadro pubblica in un MODALE (FAB), lista a tutta larghezza */
      @media (max-width: 900px), (orientation: portrait) and (max-width: 1024px) {
        .p-layout { display: block; }
        .p-compose { margin-bottom: 1.5rem; }
        body.tab-posts .p-fab { display: inline-flex; }
        .p-overlay { position: fixed; inset: 0; z-index: 300; background: rgba(0,0,0,.65); display: none; align-items: center; justify-content: center; padding: 1rem; overflow-y: auto; }
        .p-overlay.is-open { display: flex; }
        .p-overlay .p-compose { width: 100%; max-width: 560px; margin: 0; max-height: 90vh; overflow-y: auto; position: relative; }
        .p-close { display: block; position: absolute; top: .5rem; right: .7rem; background: none; border: none; color: var(--c-muted); font-size: 1.7rem; line-height: 1; cursor: pointer; }
      }
      /* ---- Tab SCHEDA (Business Information) ---- */
      .fiche-head { font-size: .85rem; color: var(--c-muted); line-height: 1.6; margin-bottom: 1.3rem; }
      .fiche-head b { color: var(--c-text); font-family: var(--font-title); font-size: 1.1rem; letter-spacing: .02em; }
      .fiche-form { max-width: none; }
      /* Orari/Attributi/Links restano a larghezza leggibile; Informazioni usa tutta la pagina. */
      .fi-sec[data-sec="attr"], .fi-sec[data-sec="links"] { max-width: 900px; }
      /* filtri: stile condiviso in src/styles/filters.css (.rh-filters / .rh-filter) */
      .fi-filtri { margin-bottom: 1.4rem; }
      .fi-soon { color: var(--c-muted); font-size: .9rem; font-style: italic; }
      .fi-field { margin-bottom: 1rem; }
      .fi-field textarea, .fi-field input { width: 100%; box-sizing: border-box; background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text); font-size: .9rem; padding: .55rem .7rem; border-radius: 8px; font-family: var(--font-body); }
      .fi-field textarea { min-height: 90px; resize: vertical; }
      .fi-field textarea:focus, .fi-field input:focus { outline: none; border-color: var(--c-accent); }
      .fi-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .fi-block { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 1.1rem 1.2rem; margin: 0 0 .9rem; }
      .fi-block > .fi-field:last-child, .fi-block > .attr-row:last-child { margin-bottom: 0; }
      .fi-h3 { font-family: var(--font-title); font-size: 1.05rem; letter-spacing: .03em; margin: 0 0 .8rem; }
      .fi-hd { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: .8rem; }
      .fi-hd .fi-h3 { margin: 0; }
      .fi-sync { display: inline-flex; align-items: center; gap: .35rem; background: var(--c-accent); color: var(--c-bg); border: 1px solid var(--c-accent); font-family: var(--font-title); font-size: .82rem; letter-spacing: .03em; padding: .4rem 1rem; border-radius: 999px; cursor: pointer; transition: background .2s, border-color .2s, transform .15s; }
      .fi-sync:hover { background: var(--c-hover); border-color: var(--c-hover); transform: scale(0.96); }
      .fi-sync:disabled { opacity: .6; cursor: default; }
      .fi-field select { width: 100%; box-sizing: border-box; background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text); font-size: .9rem; padding: .55rem .7rem; border-radius: 8px; font-family: var(--font-body); }
      .fi-field select:focus { outline: none; border-color: var(--c-accent); }
      .fi-row3 { display: grid; grid-template-columns: 1fr 2fr 1.4fr; gap: 1rem; }
      .fi-count { text-align: right; font-size: .72rem; color: var(--c-muted); margin-top: .25rem; }
      .fi-warn { color: var(--c-muted); font-size: .8rem; line-height: 1.5; margin: .6rem 0 0; display: flex; gap: .45rem; align-items: flex-start; }
      .fi-warn::before { content: "\26A0"; color: var(--c-accent); flex-shrink: 0; }
      .attr-note { color: var(--c-muted); font-size: .8rem; line-height: 1.5; margin: 0 0 1.2rem; }
      .attr-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: .6rem 0; border-bottom: 1px solid var(--c-line); }
      .attr-row:last-child { border-bottom: none; }
      .attr-lab { font-size: .9rem; color: var(--c-text); padding-top: .35rem; flex: 1; }
      .attr-ctrl { flex-shrink: 0; }
      .attr-tri { display: inline-flex; border: 1px solid var(--c-line); border-radius: 8px; overflow: hidden; }
      .attr-tri button { background: var(--c-bg); border: none; border-left: 1px solid var(--c-line); color: var(--c-muted); font-size: .8rem; padding: .35rem .8rem; cursor: pointer; font-family: var(--font-body); }
      .attr-tri button:first-child { border-left: none; }
      .attr-tri button.on { background: var(--c-accent); color: var(--c-bg); }
      select.attr-enum { background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text); font-size: .85rem; padding: .4rem .6rem; border-radius: 8px; font-family: var(--font-body); max-width: 220px; }
      .attr-re { display: flex; flex-wrap: wrap; gap: .4rem; justify-content: flex-end; max-width: 60%; }
      .attr-chip { background: var(--c-bg); border: 1px solid var(--c-line); border-radius: 999px; padding: .3rem .8rem; font-size: .8rem; color: var(--c-muted); cursor: pointer; }
      .attr-chip.on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); }
      .attr-urls { display: flex; flex-direction: column; gap: .4rem; min-width: 260px; }
      .attr-urls input { background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text); font-size: .85rem; padding: .4rem .6rem; border-radius: 8px; font-family: var(--font-body); }
      @media (max-width: 640px) { .attr-row { flex-direction: column; align-items: stretch; } .attr-re { max-width: none; justify-content: flex-start; } }
      .fi-day { display: flex; align-items: flex-start; gap: 1.2rem; padding: .65rem 0; border-bottom: 1px solid var(--c-line); flex-wrap: wrap; }
      .fi-day-head { display: flex; align-items: center; gap: .7rem; min-width: 160px; }
      .fi-day-nome { font-weight: 700; width: 46px; }
      .fi-day-sw { display: inline-flex; align-items: center; gap: .5rem; font-size: .82rem; color: var(--c-muted); cursor: pointer; }
      .fi-ranges { display: flex; flex-direction: column; gap: .4rem; flex: 1; min-width: 200px; }
      .fi-range { display: flex; align-items: center; gap: .4rem; }
      .fi-range input[type=time], .fi-sp input[type=time], .fi-sp input[type=date] { background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-text); border-radius: 6px; padding: .4rem .55rem; font-size: .85rem; font-family: var(--font-body); }
      .fi-r-del, .fi-sp-del { background: none; border: none; color: var(--c-muted); cursor: pointer; font-size: 1.15rem; line-height: 1; }
      .fi-r-del:hover, .fi-sp-del:hover { color: #ff8a8f; }
      .fi-r-add { background: none; border: 1px dashed var(--c-line); color: var(--c-muted); border-radius: 999px; padding: .25rem .8rem; font-size: .78rem; cursor: pointer; align-self: flex-start; }
      .fi-r-add:hover { border-color: var(--c-accent); color: var(--c-accent); }
      .fi-closed { color: var(--c-muted); font-size: .85rem; font-style: italic; }
      .fi-sp { margin-bottom: .8rem; padding-bottom: .7rem; border-bottom: 1px solid var(--c-line); }
      .fi-sp:last-child { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
      .fi-sp-head { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
      .fi-sp .fi-ranges { margin-top: .5rem; }
      .fi-add {
        margin-top: .6rem;
        display: inline-flex; align-items: center; gap: .4rem;
        background: color-mix(in srgb, var(--c-accent) 10%, transparent);
        border: 1px dashed color-mix(in srgb, var(--c-accent) 55%, var(--c-line));
        color: var(--c-accent);
        font-family: var(--font-title); font-size: .9rem; letter-spacing: .03em;
        padding: .5rem 1.3rem; border-radius: 999px; cursor: pointer;
        transition: background .2s, border-color .2s, color .2s, transform .15s;
      }
      .fi-add:hover { background: color-mix(in srgb, var(--c-accent) 20%, transparent); border-color: var(--c-accent); }
      .fi-add:active { transform: scale(0.96); }
      .fi-actions { display: flex; align-items: center; gap: .8rem; margin-top: 1.4rem; border-top: 1px solid var(--c-line); padding-top: 1.2rem; }
      .fi-actions .p-msg { margin-right: auto; color: var(--c-muted); }
      @media (max-width: 640px) { .fi-row2, .fi-row3 { grid-template-columns: 1fr; } }
      /* quando la Provincia/Regione non serve (paese che non la usa), riempi lo spazio */
      @media (min-width: 641px) and (max-width: 999px) { .fi-row3.senza-prov { grid-template-columns: 1fr 2fr; } }
      /* Desktop: sezione Informazioni su 3 colonne (una card per colonna). */
      @media (min-width: 1000px) {
        .fi-sec[data-sec="info"] { display: grid; grid-template-columns: repeat(3, 1fr); gap: .9rem; align-items: start; }
        .fi-sec[data-sec="info"] .fi-block { margin: 0; }
        .fi-sec[data-sec="info"] .fi-row2, .fi-sec[data-sec="info"] .fi-row3 { grid-template-columns: 1fr; }
      }
      /* Desktop + iPad orizzontale: Orari di apertura e Orari speciali affiancati 50/50. */
      @media (min-width: 1000px) {
        .fi-sec[data-sec="orari"] { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; align-items: start; }
        .fi-sec[data-sec="orari"] .fi-block { margin: 0; }
      }
      .switch { position: relative; width: 38px; height: 21px; flex-shrink: 0; display: inline-block; }
      .switch input { opacity: 0; width: 0; height: 0; }
      .switch .track { position: absolute; inset: 0; cursor: pointer; border-radius: 999px; background: var(--c-line); transition: background 0.2s; }
      .switch .track::before { content: ""; position: absolute; width: 15px; height: 15px; border-radius: 50%; left: 3px; top: 3px; background: var(--c-muted); transition: transform 0.2s, background 0.2s; }
      .switch input:checked + .track { background: var(--c-accent); }
      .switch input:checked + .track::before { transform: translateX(17px); background: var(--c-bg); }

      /* ===== Tab DATA (statistiche) ===== */
      .dt-kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .7rem; margin-bottom: 1.6rem; }
      .dt-kpi { border: 1px solid var(--c-line); border-radius: 12px; background: var(--c-card); padding: .9rem 1rem; }
      .dt-kpi .k-lab { display: flex; align-items: center; gap: .45rem; color: var(--c-muted); font-size: .8rem; letter-spacing: .02em; margin-bottom: .35rem; }
      .dt-kpi .k-lab svg { width: 16px; height: 16px; fill: none; stroke: var(--c-accent); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
      .dt-kpi .k-val { font-family: var(--font-title); font-size: 1.7rem; line-height: 1; color: var(--c-text); }
      .dt-block { border: 1px solid var(--c-line); border-radius: 12px; background: var(--c-card); padding: 1.1rem 1.2rem; margin-bottom: 1.4rem; }
      .dt-block h3 { font-family: var(--font-title); font-size: 1.05rem; letter-spacing: .03em; margin: 0 0 .9rem; color: var(--c-text); }
      /* selettore metrica del grafico */
      .dt-metsel { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: 1rem; }
      .dt-met { flex-shrink: 0; background: var(--c-bg); border: 1px solid var(--c-line); color: var(--c-muted); font-family: var(--font-body); font-size: .78rem; padding: .3rem .8rem; border-radius: 999px; cursor: pointer; display: inline-flex; align-items: center; gap: .35rem; }
      .dt-met.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); font-weight: 700; }
      .dt-met .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; opacity: .8; }
      .dt-chart { width: 100%; display: grid; grid-template-columns: 2.3rem 1fr; grid-template-rows: auto auto; align-items: stretch; }
      .dt-yaxis { grid-column: 1; grid-row: 1; position: relative; }
      .dt-yl { position: absolute; right: .45rem; transform: translateY(-50%); font-size: .58rem; color: var(--c-muted); font-family: var(--font-body); line-height: 1; white-space: nowrap; }
      .dt-plot { grid-column: 2; grid-row: 1; min-width: 0; }
      .dt-xaxis { grid-column: 2; grid-row: 2; position: relative; height: .95rem; margin-top: .25rem; }
      .dt-xl { position: absolute; top: 0; font-size: .58rem; color: var(--c-muted); font-family: var(--font-body); line-height: 1; white-space: nowrap; }
      .dt-chart svg { width: 100%; height: auto; display: block; overflow: visible; }
      .dt-chart .grid { stroke: var(--c-line); stroke-width: 1; opacity: .35; stroke-dasharray: 3 4; }
      .dt-chart .area { fill: var(--c-accent); opacity: .13; }
      .dt-chart .line { fill: none; stroke: var(--c-accent); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
      .dt-chart .pt { fill: var(--c-accent); }
      /* keyword */
      .dt-kw { display: flex; flex-direction: column; gap: .55rem; }
      .dt-kw-row { display: grid; grid-template-columns: 1.6rem 1fr auto; align-items: center; gap: .7rem; }
      .dt-kw-rank { color: var(--c-muted); font-size: .82rem; text-align: left; }
      .dt-kw-bar { position: relative; height: 26px; background: var(--c-bg); border: 1px solid var(--c-line); border-radius: 6px; overflow: hidden; }
      .dt-kw-fill { position: absolute; inset: 0 auto 0 0; background: var(--c-accent); }
      .dt-kw-txt { position: absolute; inset: 0; display: flex; align-items: center; padding: 0 .6rem; font-size: .82rem; color: var(--c-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .dt-kw-val { font-family: var(--font-title); font-size: .95rem; color: var(--c-text); min-width: 3.2rem; text-align: right; }
      .dt-kw-val.approx { color: var(--c-muted); }
      .dt-empty { color: var(--c-muted); text-align: center; padding: 1.4rem 0; }
      @media (max-width: 560px) {
        .dt-kpis { grid-template-columns: 1fr 1fr; }
        .dt-kpi .k-val { font-size: 1.4rem; }
        .dt-chart svg { height: 200px; }
        .dt-yl { right: auto; left: 0; }
      }
    </style>
    <AdminHead />
  </head>
  <body>
    <div id="app">
      <AdminHeader />
      <main>
        <h1>
          <svg viewBox="0 0 210 210" aria-hidden="true" style="fill:var(--c-accent);stroke:none"><path d="M0,105C0,47.103,47.103,0,105,0c23.383,0,45.515,7.523,64.004,21.756l-24.4,31.696C133.172,44.652,119.477,40,105,40c-35.841,0-65,29.159-65,65s29.159,65,65,65c28.867,0,53.398-18.913,61.852-45H105V85h105v20c0,57.897-47.103,105-105,105S0,162.897,0,105z" /></svg>
          Google
        </h1>

        <div class="mtabs" id="g-tabs">
          <button class="mtab is-active" data-gtab="fiche">{t("gg.tabFiche")}</button>
          <button class="mtab" data-gtab="reviews">{t("gg.tabReviews")}</button>
          <button class="mtab" data-gtab="posts">{t("gg.tabPosts")}</button>
          <button class="mtab" data-gtab="menu">{t("gg.tabMenu")}</button>
          <button class="mtab" data-gtab="foto">{t("gg.tabFoto")}</button>
          <button class="mtab" data-gtab="data">{t("gg.tabData")}</button>
        </div>

        <div class="g-tab-panel" data-gpanel="fiche">
          <div class="g-connect" id="fiche-notready" style="display:none">
            <h2>{t("gg.notReadyTitle")}</h2>
            <p>{t("gg.ficheConnectHint")}</p>
          </div>
          <div id="fiche-area" style="display:none">
            <div class="fi-filtri rh-filters" id="fi-filtri">
              <button type="button" class="rh-filter is-on" data-sec="info">{t("gg.ficheSecInfo")}</button>
              <button type="button" class="rh-filter" data-sec="orari">{t("gg.ficheSecHours")}</button>
              <button type="button" class="rh-filter" data-sec="links">{t("gg.ficheSecLinks")}</button>
              <button type="button" class="rh-filter" data-sec="attr">{t("gg.ficheSecAttr")}</button>
            </div>
            <div class="fiche-form">
              <div class="fi-sec" data-sec="info">
                <div class="fi-block">
                  <h3 class="fi-h3">{t("gg.ficheGeneral")}</h3>
                  <div class="fi-row2">
                    <div class="fi-field"><label class="p-lab">{t("gg.ficheName")}</label><input type="text" id="fi-name" /></div>
                    <div class="fi-field"><label class="p-lab">{t("gg.ficheStatus")}</label><select id="fi-status"><option value="OPEN">{t("gg.ficheStOpen")}</option><option value="CLOSED_TEMPORARILY">{t("gg.ficheStTemp")}</option><option value="CLOSED_PERMANENTLY">{t("gg.ficheStPerm")}</option></select></div>
                  </div>
                  <div class="fi-field"><label class="p-lab">{t("gg.ficheDesc")}</label><textarea id="fi-desc" maxlength="750" placeholder={t("gg.ficheDescPh")}></textarea><div class="fi-count"><span id="fi-desc-count">0</span>/750</div></div>
                </div>
                <div class="fi-block">
                  <h3 class="fi-h3">{t("gg.ficheContacts")}</h3>
                  <div class="fi-row2">
                    <div class="fi-field"><label class="p-lab">{t("gg.fichePhone")}</label><input type="tel" id="fi-phone" /></div>
                    <div class="fi-field"><label class="p-lab">{t("gg.fichePhone2")}</label><input type="tel" id="fi-phone2" /></div>
                  </div>
                  <div class="fi-field"><label class="p-lab">{t("gg.ficheWebsite")}</label><input type="url" id="fi-web" placeholder="https://" /></div>
                </div>
                <div class="fi-block">
                  <h3 class="fi-h3">{t("gg.ficheAddress")}</h3>
                  <div class="fi-field"><label class="p-lab">{t("gg.ficheAddrLine")}</label><input type="text" id="fi-addr-line" /></div>
                  <div class="fi-row3" id="fi-addr-row">
                    <div class="fi-field"><label class="p-lab">{t("gg.ficheAddrCap")}</label><input type="text" id="fi-addr-cap" /></div>
                    <div class="fi-field"><label class="p-lab">{t("gg.ficheAddrCity")}</label><input type="text" id="fi-addr-city" /></div>
                    <div class="fi-field" id="fi-prov-field"><label class="p-lab">{t("gg.ficheAddrProv")}</label><input type="text" id="fi-addr-prov" /></div>
                  </div>
                  <div class="fi-field" style="max-width:160px"><label class="p-lab">{t("gg.ficheAddrCountry")}</label><input type="text" id="fi-addr-country" maxlength="2" /></div>
                  <p class="fi-warn">{t("gg.ficheAddrWarn")}</p>
                </div>
              </div>
              <div class="fi-sec" data-sec="orari" style="display:none">
                <div class="fi-block">
                  <div class="fi-hd">
                    <h3 class="fi-h3">{t("gg.ficheHours")}</h3>
                    <button type="button" class="fi-sync" id="fi-sync-rh">↻ {t("gg.ficheSyncRH")}</button>
                  </div>
                  <div id="fi-days"></div>
                </div>
                <div class="fi-block">
                  <h3 class="fi-h3">{t("gg.ficheSpecial")}</h3>
                  <div id="fi-special"></div>
                  <button type="button" class="pill sec-btn fi-add" id="fi-special-add">{t("gg.ficheSpecialAdd")}</button>
                </div>
              </div>
              <div class="fi-sec" data-sec="links" style="display:none">
                <p class="attr-note">{t("gg.linksNote")}</p>
                <div id="fi-links"><p class="fi-soon">{t("gg.attrLoading")}</p></div>
              </div>
              <div class="fi-sec" data-sec="attr" style="display:none">
                <p class="attr-note">{t("gg.attrNote")}</p>
                <div id="fi-attr"><p class="fi-soon">{t("gg.attrLoading")}</p></div>
              </div>
            </div>
          </div>
