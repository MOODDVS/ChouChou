          <div class="fi-filtri rh-filters" id="dt-range">
            <button type="button" class="rh-filter" data-g="7">{t("gg.data7")}</button>
            <button type="button" class="rh-filter is-on" data-g="30">{t("gg.data30")}</button>
            <button type="button" class="rh-filter" data-g="90">{t("gg.data90")}</button>
          </div>
          <p class="menu-note" style="margin:-.6rem 0 1.4rem">{t("gg.dataNote")}</p>
          <div id="dt-body"><p class="fi-soon">{t("gg.attrLoading")}</p></div>
        </div>
        <div class="save-bar" id="fi-savebar">
