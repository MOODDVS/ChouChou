    </div>

    <div class="toast" id="toast"></div>

    <ImagePicker />

    <AdminNav current="google" />
    <script>
      import { supabaseBrowser } from "../../lib/supabaseBrowser";
      import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";
      import { comprimiFoto } from "../../lib/admin/imageCompress";

      const LANG = (document.documentElement.lang || "fr") as AdminLang;
      const tr = adminT(LANG);
      const LOC = ADMIN_LOCALE[LANG] ?? "fr-BE";

      type Rec = {
        review_id: string;
        author: string;
        photo: string;
        rating: number;
        comment: string;
        create_time: string | null;
        reply_comment: string | null;
        reply_time: string | null;
      };

      function esc(s: string): string {
        return String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }
      function stelle(n: number): string {
        let out = "";
        for (let i = 1; i <= 5; i++) out += i <= n ? "★" : '<span class="off">★</span>';
        return out;
      }
      function dataFmt(iso: string | null): string {
        if (!iso) return "";
        try {
          return new Date(iso).toLocaleDateString(LOC, { day: "2-digit", month: "short", year: "numeric" });
        } catch {
          return "";
        }
      }

      (async () => {
        const app = document.getElementById("app") as HTMLDivElement;
        const userEmail = document.getElementById("user-email") as HTMLSpanElement | null;
        const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement | null;
        const notready = document.getElementById("notready") as HTMLDivElement;
        const dash = document.getElementById("dash") as HTMLDivElement;
        const syncBtn = document.getElementById("sync-btn") as HTMLButtonElement;
        const syncLbl = document.getElementById("sync-lbl") as HTMLSpanElement;
        const stateEl = document.getElementById("state") as HTMLDivElement;
        const listEl = document.getElementById("list") as HTMLDivElement;
        const toastEl = document.getElementById("toast") as HTMLDivElement;
        const reviewsArea = document.getElementById("reviews-area") as HTMLDivElement;
        const ficheEl = document.getElementById("g-fiche") as HTMLDivElement;

        logoutBtn?.addEventListener("click", async () => {
          await supabaseBrowser.auth.signOut();
          window.location.replace("/admin/login");
        });

        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const session = sessionData.session;
        if (!session) {
          window.location.replace("/admin/login");
          return;
        }
        if (userEmail) userEmail.textContent = session.user.email ?? "";
        app.style.display = "flex";
        supabaseBrowser.auth.getUser().then(({ data, error }) => {
          if (error || !data.user) window.location.replace("/admin/login");
        });

        async function authFresh(): Promise<Record<string, string>> {
          const { data } = await supabaseBrowser.auth.getSession();
          return { Authorization: `Bearer ${data.session?.access_token ?? session?.access_token ?? ""}`, "Content-Type": "application/json" };
        }

        let toastTimer: number | undefined;
        function toast(msg: string, isErr = false) {
          toastEl.textContent = msg;
          toastEl.classList.toggle("is-error", isErr);
          toastEl.classList.add("is-visible");
          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => toastEl.classList.remove("is-visible"), 2600);
        }

        let recensioni: Rec[] = [];
        let filtro: "all" | "toreply" | "replied" | "high" | "low" = "all";

        function cardHTML(r: Rec): string {
          const av = r.photo
            ? `<span class="rev-av"><img src="${esc(r.photo)}" alt="" referrerpolicy="no-referrer" /></span>`
            : `<span class="rev-av">${esc((r.author || "?").slice(0, 1).toUpperCase())}</span>`;
          const rispostaHTML = r.reply_comment
            ? `<div class="rev-reply"><div class="lab">${esc(tr("gg.yourReply"))}</div><div class="txt">${esc(r.reply_comment)}</div></div>`
            : "";
          const azioni = r.reply_comment
            ? `<button class="rev-btn" data-act="edit">${esc(tr("gg.replyEdit"))}</button>
               <button class="rev-btn danger" data-act="del">${esc(tr("gg.replyDelete"))}</button>`
            : `<button class="rev-btn" data-act="reply">${esc(tr("gg.reply"))}</button>`;
          return `
            <div class="rev" data-id="${esc(r.review_id)}">
              <div class="rev-top">
                ${av}
                <div class="rev-who">
                  <div class="rev-name">${esc(r.author || "—")}</div>
                  <div class="rev-date">${dataFmt(r.create_time)}</div>
                </div>
                <div class="rev-stars">${stelle(r.rating)}</div>
              </div>
              ${r.comment ? `<div class="rev-body">${esc(r.comment)}</div>` : ""}
              ${rispostaHTML}
              <div class="rev-actions">${azioni}</div>
              <div class="rev-edit">
                <textarea placeholder="${esc(tr("gg.replyPh"))}">${esc(r.reply_comment ?? "")}</textarea>
                <div class="row">
                  <button class="rev-pub" data-act="publish">${esc(tr("gg.replyPublish"))}</button>
                  <button class="rev-btn" data-act="cancel">${esc(tr("gg.cancel"))}</button>
                </div>
              </div>
            </div>`;
        }

        function passa(r: Rec, f: string): boolean {
          if (f === "toreply") return !r.reply_comment;
          if (f === "replied") return Boolean(r.reply_comment);
          if (f === "high") return r.rating >= 4;
          if (f === "low") return r.rating >= 1 && r.rating <= 3;
          return true; // all
        }

        function aggiornaConteggi() {
          for (const f of ["all", "toreply", "replied", "high", "low"]) {
            const n = recensioni.filter((r) => passa(r, f)).length;
            const el = document.querySelector(`.g-fil-n[data-n="${f}"]`);
            if (el) el.textContent = String(n);
          }
        }

        function colCount(): number {
          const w = listEl.clientWidth || window.innerWidth;
          return Math.max(1, Math.min(3, Math.floor(w / 300)));
        }

        function render() {
          if (!recensioni.length) {
            stateEl.style.display = "block";
            stateEl.textContent = tr("gg.emptySync");
            listEl.innerHTML = "";
            aggiornaConteggi();
            return;
          }
          aggiornaConteggi();
          const arr = recensioni.filter((r) => passa(r, filtro));
          stateEl.style.display = arr.length ? "none" : "block";
          if (!arr.length) { stateEl.textContent = tr("gg.empty"); listEl.innerHTML = ""; return; }

          // Masonry: le recensioni (gia' ordinate dalla piu' recente) vengono
          // messe in ordine nella colonna piu' bassa -> lettura recente->vecchia
          // da sinistra a destra, senza buchi.
          const n = colCount();
          listEl.innerHTML = "";
          const cols: HTMLDivElement[] = [];
          for (let i = 0; i < n; i++) {
            const c = document.createElement("div");
            c.className = "g-col";
            cols.push(c);
            listEl.appendChild(c);
          }
          const h = new Array(n).fill(0);
          for (const r of arr) {
            let mi = 0;
            for (let i = 1; i < n; i++) if (h[i] < h[mi]) mi = i;
            const wrap = document.createElement("div");
            wrap.innerHTML = cardHTML(r);
            const card = wrap.firstElementChild as HTMLElement | null;
            if (!card) continue;
            cols[mi].appendChild(card);
            h[mi] += card.offsetHeight + 14;
          }
        }

        let resizeT: number | undefined;
        window.addEventListener("resize", () => {
          window.clearTimeout(resizeT);
          resizeT = window.setTimeout(render, 150);
        });

        type Scheda = {
          title: string; address: string; phone: string; website: string;
          category: string; description: string; logo: string; lat: number | null; lng: number | null;
          hours: { d: number; ranges: string[] }[];
        };

        function ficheIcon(inner: string): string {
          return `<svg viewBox="0 0 24 24" aria-hidden="true">${inner}</svg>`;
        }

        function renderFiche(p: Scheda | null, rating: string, count: string) {
          if (!p) { ficheEl.style.display = "none"; ficheEl.innerHTML = ""; return; }
          ficheEl.style.display = "block";
          const dayNames: string[] = [];
          for (let i = 0; i < 7; i++) {
            dayNames.push(new Intl.DateTimeFormat(LOC, { weekday: "short" }).format(new Date(Date.UTC(2024, 0, 1 + i))));
          }
          const todayIdx = (new Date().getDay() + 6) % 7;
          const rNum = Math.round(Number(rating) || 0);
          const stelleF = [1, 2, 3, 4, 5].map((n) => (n <= rNum ? "★" : `<span class="off">★</span>`)).join("");
          const mapQ = p.lat != null && p.lng != null ? `${p.lat},${p.lng}` : `${p.title} ${p.address}`;
          const hoursHTML = p.hours
            .map((h) => `<div class="hr${h.d === todayIdx ? " today" : ""}"><span>${esc(dayNames[h.d])}</span><span class="rg">${h.ranges.length ? esc(h.ranges.join(", ")) : esc(tr("gg.closed"))}</span></div>`)
            .join("");
          const site = p.website.replace("https://", "").replace("http://", "");
          const rShow = rating ? Number(rating).toFixed(1) : "—";
          ficheEl.innerHTML = `
            <div class="fiche">
              <iframe class="fiche-map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=${encodeURIComponent(mapQ)}&z=15&output=embed"></iframe>
              <div class="fiche-b">
                <div class="fiche-head">
                  ${p.logo ? `<img class="fiche-logo" src="${esc(p.logo)}" alt="" referrerpolicy="no-referrer" />` : ""}
                  <div class="fiche-head-t">
                    <div class="fiche-name">${esc(p.title)}</div>
                    ${p.category ? `<div class="fiche-cat">${esc(p.category)}</div>` : ""}
                  </div>
                </div>
                <div class="fiche-rate"><span class="rv">${esc(rShow)}</span><span class="st">${stelleF}</span><span class="ct">${esc(count)} ${esc(tr("gg.total"))}</span></div>
                ${p.address ? `<div class="fiche-row">${ficheIcon('<path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>')}<a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQ)}" target="_blank" rel="noopener">${esc(p.address)}</a></div>` : ""}
                ${p.phone ? `<div class="fiche-row">${ficheIcon('<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7 12.8 12.8 0 0 0 .6 2.6 2 2 0 0 1-.5 2.1L8 9.5a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5 12.8 12.8 0 0 0 2.6.6A2 2 0 0 1 22 16.9z"/>')}<a href="tel:${esc(p.phone)}">${esc(p.phone)}</a></div>` : ""}
                ${p.website ? `<div class="fiche-row">${ficheIcon('<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/>')}<a href="${esc(p.website)}" target="_blank" rel="noopener">${esc(site)}</a></div>` : ""}
                <div class="fiche-row">${ficheIcon('<circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/>')}<div class="fiche-hours">${hoursHTML}</div></div>
                ${p.description ? `<div class="fiche-desc">${esc(p.description)}</div>` : ""}
              </div>
            </div>`;
        }

        async function carica() {
          try {
            const res = await fetch("/api/admin/google/reviews", { headers: await authFresh() });
            if (!res.ok) throw new Error();
            const j = await res.json();
            const bound = Boolean(j.connected && (j.location ?? "").trim());
            if (!bound) {
              // Setup (collegamento + scelta scheda) e' lato super admin: qui niente config.
              notready.style.display = "block";
              dash.style.display = "none";
              return;
            }
            notready.style.display = "none";
            dash.style.display = "block";
            reviewsArea.style.display = "block";

            recensioni = (j.reviews ?? []) as Rec[];
            renderFiche((j.profile ?? null) as Scheda | null, j.rating ?? "", j.count ?? "");
            render();
          } catch {
            stateEl.style.display = "block";
            stateEl.textContent = tr("res.connErr");
          }
        }

        // Filtri
        document.querySelectorAll<HTMLButtonElement>(".g-fil").forEach((b) => {
          b.addEventListener("click", () => {
            document.querySelectorAll(".g-fil").forEach((x) => x.classList.remove("active"));
            b.classList.add("active");
            filtro = (b.dataset.f as typeof filtro) ?? "all";
            render();
          });
        });

        // Sincronizza
        syncBtn.addEventListener("click", async () => {
          syncBtn.disabled = true;
          const old = syncLbl.textContent;
          syncLbl.textContent = tr("gg.syncing");
          try {
            const res = await fetch("/api/admin/google/sync", { method: "POST", headers: await authFresh() });
            const j = await res.json();
            if (res.status === 409 && j.needChoice) { notready.style.display = "block"; dash.style.display = "none"; return; }
            if (!res.ok) throw new Error(j.error || "");
            if (j.reviewError) toast(`${tr("gg.reviewErr")} ${j.reviewError}`, true);
            else toast(tr("gg.synced"));
            await carica();
          } catch (e) {
            toast((e as Error).message || tr("res.connErr"), true);
          } finally {
            syncBtn.disabled = false;
            syncLbl.textContent = old;
          }
        });

        // Azioni sulle card (delega)
        listEl.addEventListener("click", async (ev) => {
          const btn = (ev.target as HTMLElement).closest("button") as HTMLButtonElement | null;
          if (!btn) return;
          const card = btn.closest(".rev") as HTMLElement | null;
          if (!card) return;
          const id = card.dataset.id!;
          const act = btn.dataset.act;
          const editor = card.querySelector(".rev-edit") as HTMLElement;
          const ta = card.querySelector(".rev-edit textarea") as HTMLTextAreaElement;

          if (act === "reply" || act === "edit") {
            editor.classList.add("open");
            ta.focus();
            return;
          }
          if (act === "cancel") {
            editor.classList.remove("open");
            return;
          }
          if (act === "publish") {
            const testo = ta.value.trim();
            if (!testo) { ta.focus(); return; }
            btn.disabled = true;
            btn.textContent = tr("gg.replySaving");
            try {
              const res = await fetch("/api/admin/google/reply", {
                method: "POST",
                headers: await authFresh(),
                body: JSON.stringify({ reviewId: id, comment: testo }),
              });
              const j = await res.json();
              if (!res.ok) throw new Error(j.error || "");
              const r = recensioni.find((x) => x.review_id === id);
              if (r) { r.reply_comment = testo; r.reply_time = new Date().toISOString(); }
              toast(tr("gg.replySaved"));
              render();
            } catch (e) {
              toast((e as Error).message || tr("res.connErr"), true);
              btn.disabled = false;
              btn.textContent = tr("gg.replyPublish");
            }
            return;
          }
          if (act === "del") {
            if (!btn.classList.contains("armato")) {
              btn.classList.add("armato");
              btn.textContent = tr("gg.replyDeleteQ");
              window.setTimeout(() => {
                btn.classList.remove("armato");
                btn.textContent = tr("gg.replyDelete");
              }, 4000);
              return;
            }
            try {
              const res = await fetch(`/api/admin/google/reply?reviewId=${encodeURIComponent(id)}`, {
                method: "POST",
                headers: { ...(await authFresh()), "X-Method-Override": "DELETE" },
              });
              const j = await res.json();
              if (!res.ok) throw new Error(j.error || "");
              const r = recensioni.find((x) => x.review_id === id);
              if (r) { r.reply_comment = null; r.reply_time = null; }
              toast(tr("gg.replyDeleted"));
              render();
            } catch (e) {
              toast((e as Error).message || tr("res.connErr"), true);
            }
            return;
          }
        });

        document.getElementById("g-tabs")?.addEventListener("click", (ev) => {
          const b = (ev.target as HTMLElement).closest(".mtab") as HTMLElement | null;
          if (!b) return;
          document.querySelectorAll("#g-tabs .mtab").forEach((x) => x.classList.remove("is-active"));
          b.classList.add("is-active");
          const tab = b.dataset.gtab;
          document.querySelectorAll<HTMLElement>(".g-tab-panel").forEach((p) => {
            p.style.display = p.dataset.gpanel === tab ? "block" : "none";
          });
        });

        // ============ POST GOOGLE (Novità / Evento / Offerta) ============
        (function initPost() {
          let loaded = false;
          let pType = "STANDARD";
          let pPhoto = "";
          let postLang = "fr";
          const area = document.getElementById("posts-area") as HTMLElement | null;
          const notready = document.getElementById("posts-notready") as HTMLElement | null;
          const typesEl = document.getElementById("p-types");
          const prev = document.getElementById("p-photo-prev");
          const clearBtn = document.getElementById("p-photo-clear") as HTMLElement | null;
          const upBtn = document.getElementById("p-photo-up") as HTMLButtonElement | null;
          const libBtn = document.getElementById("p-photo-lib");
          const fileInput = document.getElementById("p-photo-file") as HTMLInputElement | null;
          const photoState = document.getElementById("p-photo-state");
          const ICO_IMG = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>';
          const pubBtn = document.getElementById("p-publish") as HTMLButtonElement | null;
          const msg = document.getElementById("p-msg");
          const listEl = document.getElementById("p-list");
          const stateEl = document.getElementById("p-state") as HTMLElement | null;
          const fab = document.getElementById("p-fab");
          const overlay = document.getElementById("p-overlay");
          const closeBtn = document.getElementById("p-close");
          const apri = () => overlay?.classList.add("is-open");
          const chiudi = () => overlay?.classList.remove("is-open");
          fab?.addEventListener("click", apri);
          closeBtn?.addEventListener("click", chiudi);
          overlay?.addEventListener("click", (e) => { if (e.target === overlay) chiudi(); });
          const gv = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value ?? "";
          const sv = (id: string, v: string) => { const e = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null; if (e) e.value = v; };
          const escP = (x: unknown) => String(x ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
          const ICO_TRASH = '<svg class="k-ico" viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>';

          function applyType() {
            typesEl?.querySelectorAll(".p-type").forEach((b) => b.classList.toggle("is-on", (b as HTMLElement).dataset.pt === pType));
            document.querySelectorAll<HTMLElement>("#posts-area [data-when]").forEach((el) => {
              el.style.display = (el.dataset.when || "").split(" ").includes(pType) ? "" : "none";
            });
          }
          function renderPhoto() {
            if (prev) prev.innerHTML = pPhoto ? `<img src="${escP(pPhoto)}" alt="" />` : ICO_IMG;
            if (clearBtn) clearBtn.style.display = pPhoto ? "" : "none";
          }
          renderPhoto();
          typesEl?.addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest(".p-type") as HTMLElement | null; if (!b?.dataset.pt) return; pType = b.dataset.pt; applyType(); });
          libBtn?.addEventListener("click", () => window.dispatchEvent(new CustomEvent("imgpick:open")));
          upBtn?.addEventListener("click", () => fileInput?.click());
          fileInput?.addEventListener("change", async () => {
            const file = fileInput.files?.[0];
            if (!file || !upBtn) return;
            upBtn.disabled = true;
            if (photoState) photoState.textContent = tr("cli.uploading");
            try {
              const foto = await comprimiFoto(file);
              if (foto.size > 4 * 1024 * 1024) throw new Error(tr("cli.fileTooBig"));
              const b64 = await new Promise<string>((res, rej) => { const r = new FileReader(); r.onload = () => res(String(r.result).split(",")[1] ?? ""); r.onerror = () => rej(new Error()); r.readAsDataURL(foto); });
              const resp = await fetch("/api/admin/upload", { method: "POST", headers: await authFresh(), body: JSON.stringify({ filename: foto.name, data: b64, bucket: "popups", folder: "google" }) });
              const j = await resp.json();
              if (!resp.ok || !j.url) throw new Error(j.error ?? tr("cli.uploadError"));
              pPhoto = j.url as string; renderPhoto();
              if (photoState) photoState.textContent = "";
            } catch (err) {
              if (photoState) photoState.textContent = err instanceof Error ? err.message : tr("cli.uploadError");
            } finally {
              upBtn.disabled = false; fileInput.value = "";
            }
          });
          clearBtn?.addEventListener("click", () => { pPhoto = ""; renderPhoto(); });
          window.addEventListener("imgpick:pick", (e) => {
            const panel = document.querySelector('[data-gpanel="posts"]') as HTMLElement | null;
            if (!panel || panel.style.display === "none") return; // il picker serve solo al tab Post
            pPhoto = (e as CustomEvent<{ url: string }>).detail.url; renderPhoto();
          });

          const badge = (t: string) => t === "EVENT" ? tr("gg.postEvent") : t === "OFFER" ? tr("gg.postOffer") : tr("gg.postStandard");
          function postCard(p: any): string {
            const foto = p.media?.[0]?.googleUrl || p.media?.[0]?.sourceUrl || "";
            const dt = p.createTime ? new Date(p.createTime).toLocaleDateString() : "";
            const testo = escP((p.summary || p.event?.title || "").slice(0, 160));
            const link = p.searchUrl ? `<a class="p-card-link" href="${escP(p.searchUrl)}" target="_blank" rel="noopener">${tr("gg.postView")} <span class="p-card-link-arr">\u2192</span></a>` : "";
            const stato = p.state && p.state !== "LIVE" ? `<span class="p-state-b">${escP(p.state)}</span>` : "";
            return `<div class="p-card">${foto ? `<span class="p-card-img"><img src="${escP(foto)}" alt="" /></span>` : ""}<div class="p-card-main"><div class="p-card-top"><span class="p-badge">${badge(p.topicType)}</span>${stato}<span class="p-card-dt">${escP(dt)}</span></div><p class="p-card-txt">${testo || "\u2014"}</p><div class="p-card-act">${link}<button type="button" class="i-btn i-del p-del" data-name="${escP(p.name || "")}" title="${tr("common.delete")}">${ICO_TRASH}</button></div></div></div>`;
          }
          async function loadPosts() {
            if (stateEl) stateEl.style.display = "";
            try {
              const r = await fetch("/api/admin/google/posts", { headers: await authFresh() });
              const j = await r.json();
              if (!r.ok) { if (area) area.style.display = "none"; if (notready) notready.style.display = ""; return; }
              if (notready) notready.style.display = "none";
              if (area) area.style.display = "";
              const limite = Date.now() - 365 * 24 * 3600 * 1000; // solo ultimi 12 mesi
              const posts = ((j.posts || []) as any[]).filter((p) => !p.createTime || Date.parse(p.createTime) >= limite);
              if (listEl) listEl.innerHTML = posts.length ? posts.map(postCard).join("") : `<p class="state">${tr("gg.postNone")}</p>`;
            } catch { if (listEl) listEl.innerHTML = ""; } finally { if (stateEl) stateEl.style.display = "none"; }
          }
          async function caricaLang() {
            try { const r = await fetch("/api/admin/pages", { headers: await authFresh() }); if (r.ok) { const j = await r.json(); if (Array.isArray(j.publicLangs) && j.publicLangs[0]) postLang = String(j.publicLangs[0]); } } catch { /* default fr */ }
          }
          pubBtn?.addEventListener("click", async () => {
            if (!pubBtn) return;
            if (msg) msg.textContent = "";
            const body = { tipo: pType, lang: postLang, summary: gv("p-summary"), photo: pPhoto,
              ctaType: gv("p-cta-type"), ctaUrl: gv("p-cta-url"), title: gv("p-title"),
              startDate: gv("p-start"), endDate: gv("p-end"), couponCode: gv("p-coupon"),
              redeemUrl: gv("p-redeem"), terms: gv("p-terms") };
            pubBtn.disabled = true; const orig = pubBtn.textContent; pubBtn.textContent = tr("gg.postPublishing");
            try {
              const r = await fetch("/api/admin/google/posts", { method: "POST", headers: await authFresh(), body: JSON.stringify(body) });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || tr("res.connErr"));
              toast(tr("gg.postDone"));
              ["p-summary", "p-title", "p-start", "p-end", "p-cta-url", "p-coupon", "p-redeem", "p-terms"].forEach((id) => sv(id, ""));
              pPhoto = ""; renderPhoto();
              chiudi();
              await loadPosts();
            } catch (e) { if (msg) msg.textContent = (e as Error).message; }
            finally { pubBtn.disabled = false; pubBtn.textContent = orig; }
          });
          listEl?.addEventListener("click", async (e) => {
            const b = (e.target as HTMLElement).closest(".i-del") as HTMLButtonElement | null; if (!b) return;
            const name = b.dataset.name || ""; if (!name) return;
            // Conferma a 2 tocchi (standard RH): 1° tap = pillola rossa piena, 2° = elimina
            if (!b.classList.contains("confirm")) {
              b.classList.add("confirm");
              b.textContent = tr("common.confirm");
              window.setTimeout(() => { if (b.classList.contains("confirm")) { b.classList.remove("confirm"); b.innerHTML = ICO_TRASH; } }, 3000);
              return;
            }
            b.disabled = true;
            try {
              const r = await fetch(`/api/admin/google/posts?name=${encodeURIComponent(name)}`, { method: "POST", headers: { ...(await authFresh()), "X-Method-Override": "DELETE" } });
              if (!r.ok) { const j = await r.json(); throw new Error(j.error || tr("res.connErr")); }
              toast(tr("gg.postDeleted"));
              await loadPosts();
            } catch (err) { b.disabled = false; b.classList.remove("confirm"); b.innerHTML = ICO_TRASH; toast((err as Error).message, true); }
          });
          document.getElementById("g-tabs")?.addEventListener("click", async (ev) => {
            const b = (ev.target as HTMLElement).closest(".mtab") as HTMLElement | null;
            if (!b) return;
            const isPosts = b.dataset.gtab === "posts";
            document.body.classList.toggle("tab-posts", isPosts);
            window.dispatchEvent(new Event("resize")); // ricalcola la posizione del FAB sopra l'isola
            if (!isPosts) return;
            applyType();
            if (loaded) return; loaded = true;
            await caricaLang(); await loadPosts();
          });
        })();

        // ============ MODIFICA SCHEDA GOOGLE (Business Information) ============
        (function initFiche() {
          let loaded = false;
          let fiHours: { chiuso: boolean; ranges: { a: string; b: string }[] }[] = [];
          let fiSpecial: { date: string; closed: boolean; ranges: { a: string; b: string }[] }[] = [];
          let activeSec = "info";
          let attrLoaded = false;
          type AItem = { id: string; type: string; label: string; options: { value: string; label: string }[]; bool: boolean | null; enumVal: string | null; set: string[]; urls: string[]; repeatable: boolean };
          let attrModel: AItem[] = [];
          let attrInitial = "";
          const area = document.getElementById("fiche-area") as HTMLElement | null;
          const notready = document.getElementById("fiche-notready") as HTMLElement | null;
          const daysEl = document.getElementById("fi-days");
          const specialEl = document.getElementById("fi-special");
          const desc = document.getElementById("fi-desc") as HTMLTextAreaElement | null;
          const phone = document.getElementById("fi-phone") as HTMLInputElement | null;
          const web = document.getElementById("fi-web") as HTMLInputElement | null;
          const nameEl = document.getElementById("fi-name") as HTMLInputElement | null;
          const phone2 = document.getElementById("fi-phone2") as HTMLInputElement | null;
          const statusEl = document.getElementById("fi-status") as HTMLSelectElement | null;
          const descCount = document.getElementById("fi-desc-count");
          const aLine = document.getElementById("fi-addr-line") as HTMLInputElement | null;
          const aCap = document.getElementById("fi-addr-cap") as HTMLInputElement | null;
          const aCity = document.getElementById("fi-addr-city") as HTMLInputElement | null;
          const aProv = document.getElementById("fi-addr-prov") as HTMLInputElement | null;
          const aCountry = document.getElementById("fi-addr-country") as HTMLInputElement | null;
          const provField = document.getElementById("fi-prov-field") as HTMLElement | null;
          const addrRow = document.getElementById("fi-addr-row") as HTMLElement | null;
          // Paesi il cui indirizzo Google usa la Provincia/Regione (administrativeArea):
          // provincia/stato/regione. Altrove (Belgio, Francia, Germania, NL…) il campo
          // non serve e Google rifiuta il valore → lo nascondiamo.
          const PAESI_REGIONE = new Set([
            "IT", "ES", "US", "CA", "AU", "BR", "IN", "CN", "JP", "KR", "MX", "AR",
            "CL", "CO", "PE", "VE", "EC", "ID", "MY", "TH", "PH", "VN", "ZA", "EG",
            "SA", "AE", "TR", "RU", "UA", "NZ", "MA", "TN",
          ]);
          let provDaGoogle = false;   // Google ha restituito una regione per QUESTA scheda?
          let paeseIniziale = "";     // paese originale letto da Google
          function aggiornaCampiPaese(): void {
            const code = (aCountry?.value || "").trim().toUpperCase();
            const mostra = PAESI_REGIONE.has(code) || (provDaGoogle && code === paeseIniziale);
            if (provField) provField.style.display = mostra ? "" : "none";
            if (addrRow) addrRow.classList.toggle("senza-prov", !mostra);
            if (aProv && !mostra) aProv.value = ""; // niente valore fantasma se il campo è nascosto
          }
          aCountry?.addEventListener("input", aggiornaCampiPaese);
          const msg = document.getElementById("fi-msg");
          const updCount = () => { if (descCount && desc) descCount.textContent = String(desc.value.length); };
          desc?.addEventListener("input", updCount);
          const saveBtn = document.getElementById("fi-save") as HTMLButtonElement | null;
          const esc = (x: unknown) => String(x ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
          const WD = [0, 1, 2, 3, 4, 5, 6].map((d) => tr("gg.wd" + d));
          document.getElementById("fi-filtri")?.addEventListener("click", (e) => {
            const b = (e.target as HTMLElement).closest(".rh-filter") as HTMLElement | null;
            if (!b?.dataset.sec) return;
            activeSec = b.dataset.sec;
            document.querySelectorAll("#fi-filtri .rh-filter").forEach((x) => x.classList.toggle("is-on", x === b));
            document.querySelectorAll<HTMLElement>(".fi-sec").forEach((sec) => { sec.style.display = sec.dataset.sec === activeSec ? "" : "none"; });
            if ((activeSec === "attr" || activeSec === "links") && !attrLoaded) { attrLoaded = true; void loadAttr(); }
          });

          function renderDays() {
            if (!daysEl) return;
            daysEl.innerHTML = fiHours.map((g, d) => {
              const ranges = g.chiuso
                ? `<span class="fi-closed">${tr("gg.ficheClosed")}</span>`
                : g.ranges.map((r, ri) => `<div class="fi-range"><input type="time" class="fi-ra" data-d="${d}" data-ri="${ri}" value="${esc(r.a)}" /><span>\u2013</span><input type="time" class="fi-rb" data-d="${d}" data-ri="${ri}" value="${esc(r.b)}" /><button type="button" class="fi-r-del" data-d="${d}" data-ri="${ri}">\u00d7</button></div>`).join("") + `<button type="button" class="fi-r-add" data-d="${d}">+ ${tr("gg.ficheAddRange")}</button>`;
              return `<div class="fi-day"><div class="fi-day-head"><span class="fi-day-nome">${esc(WD[d])}</span><label class="fi-day-sw"><span class="switch"><input type="checkbox" class="fi-open" data-d="${d}" ${g.chiuso ? "" : "checked"} /><span class="track"></span></span>${g.chiuso ? tr("gg.ficheClosed") : tr("gg.ficheOpen")}</label></div><div class="fi-ranges">${ranges}</div></div>`;
            }).join("");
          }
          function renderSpecial() {
            if (!specialEl) return;
            specialEl.innerHTML = fiSpecial.map((sp, i) => {
              const head = `<div class="fi-sp-head"><input type="date" class="fi-sp-date" data-i="${i}" value="${esc(sp.date)}" /><label class="fi-day-sw"><span class="switch"><input type="checkbox" class="fi-sp-open" data-i="${i}" ${sp.closed ? "" : "checked"} /><span class="track"></span></span>${sp.closed ? tr("gg.ficheClosed") : tr("gg.ficheOpen")}</label><button type="button" class="fi-sp-del" data-i="${i}">\u00d7</button></div>`;
              if (sp.closed) return `<div class="fi-sp">${head}</div>`;
              const ranges = sp.ranges.map((r, ri) => `<div class="fi-range"><input type="time" class="fi-spr-a" data-i="${i}" data-ri="${ri}" value="${esc(r.a)}" /><span>\u2013</span><input type="time" class="fi-spr-b" data-i="${i}" data-ri="${ri}" value="${esc(r.b)}" /><button type="button" class="fi-r-del fi-spr-del" data-i="${i}" data-ri="${ri}">\u00d7</button></div>`).join("") + `<button type="button" class="fi-r-add fi-spr-add" data-i="${i}">+ ${tr("gg.ficheAddRange")}</button>`;
              return `<div class="fi-sp">${head}<div class="fi-ranges">${ranges}</div></div>`;
            }).join("");
          }

          daysEl?.addEventListener("change", (e) => {
            const t = e.target as HTMLInputElement;
            if (!t.classList.contains("fi-open")) return;
            const d = Number(t.dataset.d);
            fiHours[d].chiuso = !t.checked;
            if (t.checked && !fiHours[d].ranges.length) fiHours[d].ranges = [{ a: "09:00", b: "18:00" }];
            renderDays();
          });
          daysEl?.addEventListener("input", (e) => {
            const t = e.target as HTMLInputElement;
            const d = Number(t.dataset.d), ri = Number(t.dataset.ri);
            if (Number.isNaN(d) || Number.isNaN(ri) || !fiHours[d]?.ranges[ri]) return;
            if (t.classList.contains("fi-ra")) fiHours[d].ranges[ri].a = t.value;
            if (t.classList.contains("fi-rb")) fiHours[d].ranges[ri].b = t.value;
          });
          daysEl?.addEventListener("click", (e) => {
            const add = (e.target as HTMLElement).closest(".fi-r-add") as HTMLElement | null;
            if (add) { const d = Number(add.dataset.d); fiHours[d].ranges.push({ a: "", b: "" }); renderDays(); return; }
            const del = (e.target as HTMLElement).closest(".fi-r-del") as HTMLElement | null;
            if (del) { const d = Number(del.dataset.d), ri = Number(del.dataset.ri); fiHours[d].ranges.splice(ri, 1); renderDays(); }
          });

          specialEl?.addEventListener("input", (e) => {
            const t = e.target as HTMLInputElement; const i = Number(t.dataset.i);
            if (!fiSpecial[i]) return;
            if (t.classList.contains("fi-sp-date")) { fiSpecial[i].date = t.value; return; }
            const ri = Number(t.dataset.ri);
            if (Number.isNaN(ri) || !fiSpecial[i].ranges[ri]) return;
            if (t.classList.contains("fi-spr-a")) fiSpecial[i].ranges[ri].a = t.value;
            if (t.classList.contains("fi-spr-b")) fiSpecial[i].ranges[ri].b = t.value;
          });
          specialEl?.addEventListener("change", (e) => {
            const t = e.target as HTMLInputElement;
            if (!t.classList.contains("fi-sp-open")) return;
            const i = Number(t.dataset.i);
            fiSpecial[i].closed = !t.checked;
            if (t.checked && !fiSpecial[i].ranges.length) fiSpecial[i].ranges = [{ a: "09:00", b: "18:00" }];
            renderSpecial();
          });
          specialEl?.addEventListener("click", (e) => {
            const add = (e.target as HTMLElement).closest(".fi-spr-add") as HTMLElement | null;
            if (add) { const i = Number(add.dataset.i); fiSpecial[i].ranges.push({ a: "", b: "" }); renderSpecial(); return; }
            const rdel = (e.target as HTMLElement).closest(".fi-spr-del") as HTMLElement | null;
            if (rdel) { const i = Number(rdel.dataset.i), ri = Number(rdel.dataset.ri); fiSpecial[i].ranges.splice(ri, 1); renderSpecial(); return; }
            const del = (e.target as HTMLElement).closest(".fi-sp-del") as HTMLElement | null;
            if (del) { fiSpecial.splice(Number(del.dataset.i), 1); renderSpecial(); }
          });
          document.getElementById("fi-special-add")?.addEventListener("click", () => { fiSpecial.push({ date: "", closed: true, ranges: [] }); renderSpecial(); });
          document.getElementById("fi-sync-rh")?.addEventListener("click", async () => {
            const sb = document.getElementById("fi-sync-rh") as HTMLButtonElement | null;
            if (sb) sb.disabled = true;
            try {
              const r = await fetch("/api/admin/google/rh-hours", { headers: await authFresh() });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || tr("res.connErr"));
              fiHours = [0, 1, 2, 3, 4, 5, 6].map((d) => {
                const gg = (j.hours || []).find((x: { d: number }) => x.d === d);
                return { chiuso: gg ? !!gg.chiuso : true, ranges: gg ? (gg.ranges || []).map((rr: { a: string; b: string }) => ({ a: rr.a, b: rr.b })) : [] };
              });
              renderDays();
              const rhSpecial = (j.special || []).map((sp2: { date: string; closed: boolean; ranges: { a: string; b: string }[] }) => ({ date: sp2.date, closed: !!sp2.closed, ranges: sp2.closed ? [] : (sp2.ranges || []).map((r: { a: string; b: string }) => ({ a: r.a, b: r.b })) }));
              const rhDates = new Set(rhSpecial.map((sp2: { date: string }) => sp2.date));
              fiSpecial = [...fiSpecial.filter((sp2) => !rhDates.has(sp2.date)), ...rhSpecial].sort((a, b) => a.date.localeCompare(b.date));
              renderSpecial();
              dirty();
              toast(tr("gg.ficheSyncDone"));
            } catch (e) { toast((e as Error).message, true); }
            finally { if (sb) sb.disabled = false; }
          });

          async function loadFiche() {
            try {
              const r = await fetch("/api/admin/google/profile", { headers: await authFresh() });
              const j = await r.json();
              if (!r.ok) { if (area) area.style.display = "none"; if (notready) notready.style.display = ""; return; }
              if (notready) notready.style.display = "none";
              if (area) area.style.display = "";
              const sc = j.scheda || {};
              if (desc) desc.value = sc.description || "";
              if (phone) phone.value = sc.phone || "";
              if (web) web.value = sc.website || "";
              if (nameEl) nameEl.value = sc.title || "";
              if (phone2) phone2.value = sc.phone2 || "";
              if (statusEl) statusEl.value = sc.status || "OPEN";
              const ad = sc.addr || {};
              if (aLine) aLine.value = ad.lines || "";
              if (aCap) aCap.value = ad.postalCode || "";
              if (aCity) aCity.value = ad.locality || "";
              if (aProv) aProv.value = ad.adminArea || "";
              if (aCountry) aCountry.value = ad.regionCode || "";
              provDaGoogle = !!String(ad.adminArea || "").trim();
              paeseIniziale = String(ad.regionCode || "").trim().toUpperCase();
              aggiornaCampiPaese();
              updCount();
              fiHours = [0, 1, 2, 3, 4, 5, 6].map((d) => {
                const g = (sc.hours || []).find((x: { d: number }) => x.d === d);
                return { chiuso: g ? !!g.chiuso : true, ranges: g ? (g.ranges || []).map((r: { a: string; b: string }) => ({ a: r.a, b: r.b })) : [] };
              });
              const spGroups = new Map<string, { date: string; closed: boolean; ranges: { a: string; b: string }[] }>();
              (sc.special || []).forEach((x: { date: string; closed: boolean; a: string; b: string }) => {
                if (!x.date) return;
                if (!spGroups.has(x.date)) spGroups.set(x.date, { date: x.date, closed: false, ranges: [] });
                const g = spGroups.get(x.date)!;
                if (x.closed) g.closed = true;
                else g.ranges.push({ a: x.a || "", b: x.b || "" });
              });
              fiSpecial = [...spGroups.values()].map((g) => ({ date: g.date, closed: g.closed, ranges: g.closed ? [] : g.ranges }));
              renderDays(); renderSpecial();
            } catch { /* rete assente */ }
          }

          const attrEl = document.getElementById("fi-attr");
          const linksEl = document.getElementById("fi-links");
          function attrSnap(it: AItem): string { return JSON.stringify({ b: it.bool, e: it.enumVal, s: [...it.set].sort(), u: [...it.urls] }); }
          function renderAttrItem(it: AItem, i: number): string {
            let ctrl = "";
            if (it.type === "BOOL") {
              const btn = (v: string, lab: string, on: boolean) => `<button type="button" data-i="${i}" data-v="${v}" class="${on ? "on" : ""}">${lab}</button>`;
              ctrl = `<div class="attr-tri">${btn("true", tr("gg.attrYes"), it.bool === true)}${btn("false", tr("gg.attrNo"), it.bool === false)}${btn("", tr("gg.attrUnset"), it.bool === null)}</div>`;
            } else if (it.type === "ENUM") {
              const opts = `<option value="">${tr("gg.attrUnset")}</option>` + it.options.map((o) => `<option value="${esc(o.value)}" ${it.enumVal === o.value ? "selected" : ""}>${esc(o.label)}</option>`).join("");
              ctrl = `<select class="attr-enum" data-i="${i}">${opts}</select>`;
            } else if (it.type === "REPEATED_ENUM") {
              ctrl = `<div class="attr-re">${it.options.map((o) => `<button type="button" class="attr-chip ${it.set.includes(o.value) ? "on" : ""}" data-i="${i}" data-v="${esc(o.value)}">${esc(o.label)}</button>`).join("")}</div>`;
            } else if (it.type === "URL") {
              // Valore singolo (Facebook, menu, ...): un solo campo. Solo se ripetibile
              // mostriamo i valori esistenti + un campo vuoto per aggiungerne altri.
              const urls = it.urls.length > 1 ? it.urls : [it.urls[0] ?? ""];
              ctrl = `<div class="attr-urls">${urls.map((u) => `<input type="url" data-i="${i}" placeholder="https://" value="${esc(u)}" />`).join("")}</div>`;
            }
            return `<div class="attr-row"><span class="attr-lab">${esc(it.label)}</span><span class="attr-ctrl">${ctrl}</span></div>`;
          }
          function attrRender(groups: { group: string; items: AItem[] }[]) {
            attrModel = [];
            groups.forEach((g) => g.items.forEach((it) => attrModel.push(it)));
            attrInitial = JSON.stringify(attrModel.map(attrSnap));
            // Split: gli attributi URL vanno nel tab "Links / Azioni", il resto in "Attributi".
            let i = -1;
            const attrHtml: string[] = [], linkHtml: string[] = [];
            groups.forEach((g) => {
              const aItems: string[] = [], lItems: string[] = [];
              g.items.forEach((it) => { i++; const html = renderAttrItem(it, i); (it.type === "URL" ? lItems : aItems).push(html); });
              if (aItems.length) attrHtml.push(`<div class="fi-block"><h3 class="fi-h3">${esc(g.group)}</h3>${aItems.join("")}</div>`);
              if (lItems.length) linkHtml.push(`<div class="fi-block"><h3 class="fi-h3">${esc(g.group)}</h3>${lItems.join("")}</div>`);
            });
            if (attrEl) attrEl.innerHTML = attrHtml.length ? attrHtml.join("") : `<p class="fi-soon">${tr("gg.attrEmpty")}</p>`;
            if (linksEl) linksEl.innerHTML = linkHtml.length ? linkHtml.join("") : `<p class="fi-soon">${tr("gg.attrEmpty")}</p>`;
          }
          const attrHosts = [attrEl, linksEl];
          const onAttrClick = (e: Event) => {
            const t = e.target as HTMLElement;
            const tri = t.closest(".attr-tri button") as HTMLElement | null;
            if (tri) {
              const i = Number(tri.dataset.i), v = tri.dataset.v;
              if (attrModel[i]) attrModel[i].bool = v === "true" ? true : v === "false" ? false : null;
              tri.parentElement?.querySelectorAll("button").forEach((x) => x.classList.toggle("on", x === tri));
              return;
            }
            const chip = t.closest(".attr-chip") as HTMLElement | null;
            if (chip) {
              const i = Number(chip.dataset.i), v = String(chip.dataset.v);
              const it = attrModel[i]; if (!it) return;
              const on = it.set.includes(v);
              it.set = on ? it.set.filter((x) => x !== v) : [...it.set, v];
              chip.classList.toggle("on", !on);
            }
          };
          const onAttrChange = (e: Event) => {
            const t = e.target as HTMLElement;
            if (t.classList.contains("attr-enum")) {
              const sel = t as HTMLSelectElement, i = Number(sel.dataset.i);
              if (attrModel[i]) attrModel[i].enumVal = sel.value || null;
            }
          };
          const onAttrInput = (e: Event) => {
            const t = e.target as HTMLInputElement;
            if (t.type === "url" && t.dataset.i != null) {
              const it = attrModel[Number(t.dataset.i)]; if (!it) return;
              const box = t.closest(".attr-urls") as HTMLElement | null; if (!box) return;
              it.urls = [...box.querySelectorAll<HTMLInputElement>("input")].map((x) => x.value.trim()).filter(Boolean);
            }
          };
          attrHosts.forEach((el) => {
            el?.addEventListener("click", onAttrClick);
            el?.addEventListener("change", onAttrChange);
            el?.addEventListener("input", onAttrInput);
          });
          async function loadAttr() {
            const load = `<p class="fi-soon">${tr("gg.attrLoading")}</p>`;
            if (attrEl) attrEl.innerHTML = load;
            if (linksEl) linksEl.innerHTML = load;
            try {
              const r = await fetch("/api/admin/google/attributes?lang=" + encodeURIComponent(LANG), { headers: await authFresh() });
              const j = await r.json();
              if (!r.ok) { const m = `<p class="fi-soon">${esc(j.error || tr("res.connErr"))}</p>`; if (attrEl) attrEl.innerHTML = m; if (linksEl) linksEl.innerHTML = m; return; }
              attrRender(j.gruppi || []);
            } catch { const m = `<p class="fi-soon">${tr("res.connErr")}</p>`; if (attrEl) attrEl.innerHTML = m; if (linksEl) linksEl.innerHTML = m; }
          }
          async function saveAttr() {
            const init = JSON.parse(attrInitial || "[]") as string[];
            const changed = attrModel
              .map((it, i) => ({ it, i }))
              .filter(({ it, i }) => attrSnap(it) !== init[i])
              .map(({ it }) => ({
                id: it.id, type: it.type, bool: it.bool, enumVal: it.enumVal,
                set: it.set,
                unset: it.type === "REPEATED_ENUM" ? it.options.map((o) => o.value).filter((v) => !it.set.includes(v)) : [],
                urls: it.urls,
              }));
            if (!changed.length) return;
            const r = await fetch("/api/admin/google/attributes", { method: "PUT", headers: await authFresh(), body: JSON.stringify({ items: changed }) });
            const j = await r.json();
            if (!r.ok) throw new Error(j.error || tr("res.connErr"));
            if (Array.isArray(j.notApplied) && j.notApplied.length) {
              const labels = j.notApplied.map((id: string) => attrModel.find((a) => a.id === id)?.label || id);
              throw new Error(tr("gg.attrNotApplied") + " " + labels.join(", "));
            }
            attrInitial = JSON.stringify(attrModel.map(attrSnap));
          }

          const saveBar = document.getElementById("fi-savebar") as HTMLElement | null;
          function dirty() { saveBar?.classList.add("is-visible"); }
          function salvato() {
            if (!saveBtn) return;
            saveBtn.classList.add("is-saved");
            saveBtn.textContent = tr("gg.ficheSaved");
            setTimeout(() => {
              saveBar?.classList.remove("is-visible");
              setTimeout(() => { if (saveBtn) { saveBtn.classList.remove("is-saved"); saveBtn.textContent = tr("common.save"); } }, 300);
            }, 1600);
          }
          // La barra "Salva" appare appena si modifica qualcosa (come nelle altre pagine).
          [nameEl, statusEl, desc, phone, phone2, web, aLine, aCap, aCity, aProv, aCountry].forEach((el) => {
            el?.addEventListener("input", dirty); el?.addEventListener("change", dirty);
          });
          [daysEl, specialEl, attrEl, linksEl].forEach((el) => {
            el?.addEventListener("input", dirty); el?.addEventListener("change", dirty);
          });
          daysEl?.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest(".fi-r-add, .fi-r-del")) dirty(); });
          specialEl?.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest(".fi-sp-del, .fi-spr-add, .fi-spr-del")) dirty(); });
          attrEl?.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest(".attr-tri button, .attr-chip")) dirty(); });
          document.getElementById("fi-special-add")?.addEventListener("click", dirty);

          saveBtn?.addEventListener("click", async () => {
            if (!saveBtn) return;
            if (msg) { msg.textContent = ""; msg.classList.remove("err"); }
            saveBtn.disabled = true;
            saveBtn.textContent = tr("gg.ficheSaving");
            try {
              if (activeSec === "attr" || activeSec === "links") {
                await saveAttr();
              } else {
                const body = {
                  title: nameEl?.value ?? "",
                  description: desc?.value ?? "",
                  phone: phone?.value ?? "",
                  phone2: phone2?.value ?? "",
                  website: web?.value ?? "",
                  status: statusEl?.value ?? "OPEN",
                  addr: {
                    lines: aLine?.value ?? "",
                    postalCode: aCap?.value ?? "",
                    locality: aCity?.value ?? "",
                    adminArea: aProv?.value ?? "",
                    regionCode: aCountry?.value ?? "",
                  },
                  hours: fiHours.map((g, d) => ({ d, chiuso: g.chiuso, ranges: g.ranges })),
                  special: fiSpecial.filter((sp) => sp.date).flatMap((sp) =>
                sp.closed
                  ? [{ date: sp.date, closed: true, a: "", b: "" }]
                  : sp.ranges.filter((r) => r.a && r.b).map((r) => ({ date: sp.date, closed: false, a: r.a, b: r.b }))
              ),
                };
                const r = await fetch("/api/admin/google/profile", { method: "PUT", headers: await authFresh(), body: JSON.stringify(body) });
                const j = await r.json();
                if (!r.ok) throw new Error(j.error || tr("res.connErr"));
              }
              salvato();
            } catch (e) {
              if (msg) { msg.textContent = (e as Error).message; msg.classList.add("err"); }
              saveBtn.textContent = tr("common.save");
            } finally {
              saveBtn.disabled = false;
            }
          });

          document.getElementById("g-tabs")?.addEventListener("click", (ev) => {
            const b = (ev.target as HTMLElement).closest(".mtab") as HTMLElement | null;
            if (!b) return;
            if (b.dataset.gtab !== "fiche") { saveBar?.classList.remove("is-visible"); return; }
            if (loaded) return;
            loaded = true; void loadFiche();
          });
          loaded = true; void loadFiche(); // tab di default: carica subito
        })();

        // ============ MENU (Food Menu Google, sync da RestoHub) ============
        (function initMenu() {
          let loaded = false;
          const bodyEl = document.getElementById("menu-body");
          const syncBtn = document.getElementById("menu-sync") as HTMLButtonElement | null;
          const escM = (x: unknown) => String(x ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
          const fmtP = (c: number) => "€ " + (c / 100).toFixed(2).replace(".", ",");
          async function loadMenu() {
            if (!bodyEl) return;
            bodyEl.innerHTML = `<p class="fi-soon">${tr("gg.attrLoading")}</p>`;
            try {
              const r = await fetch("/api/admin/google/menu", { headers: await authFresh() });
              const j = await r.json();
              if (!r.ok) { bodyEl.innerHTML = `<p class="fi-soon">${escM(j.error || tr("res.connErr"))}</p>`; return; }
              const sez = (j.sezioni || []) as { name: string; items: { name: string; priceCents: number }[] }[];
              if (!sez.length) { bodyEl.innerHTML = `<p class="fi-soon">${tr("gg.menuEmpty")}</p>`; return; }
              bodyEl.innerHTML = sez.map((s2) => `<div class="fi-block"><h3 class="fi-h3">${escM(s2.name)}</h3>${(s2.items || []).map((it) => `<div class="menu-row"><span>${escM(it.name)}</span><span class="p">${fmtP(it.priceCents)}</span></div>`).join("")}</div>`).join("");
            } catch { bodyEl.innerHTML = `<p class="fi-soon">${tr("res.connErr")}</p>`; }
          }
          syncBtn?.addEventListener("click", async () => {
            if (!syncBtn) return;
            syncBtn.disabled = true; const o = syncBtn.textContent; syncBtn.textContent = tr("gg.menuSyncing");
            try {
              const r = await fetch("/api/admin/google/menu", { method: "POST", headers: await authFresh() });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || tr("res.connErr"));
              toast(tr("gg.menuSynced"));
            } catch (e) { toast((e as Error).message, true); }
            finally { syncBtn.disabled = false; syncBtn.textContent = o; }
          });
          document.getElementById("g-tabs")?.addEventListener("click", (ev) => {
            const b = (ev.target as HTMLElement).closest(".mtab") as HTMLElement | null;
            if (b?.dataset.gtab !== "menu" || loaded) return;
            loaded = true; void loadMenu();
          });
        })();

        // ============ FOTO (Media Google: logo, copertina, galleria) ============
        (function initFoto() {
          let loaded = false;
          let upCat = "ADDITIONAL";
          type FMedia = { id: string; url: string; category: string };
          let data: { logo: FMedia | null; cover: FMedia | null; gallery: FMedia[] } = { logo: null, cover: null, gallery: [] };
          const bodyEl = document.getElementById("foto-body");
          const fileInput = document.getElementById("foto-file") as HTMLInputElement | null;
          const escF = (x: unknown) => String(x ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
          const ICO = `<svg viewBox="0 0 24 24" width="20" height="20"><rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`;
          function renderFoto() {
            if (!bodyEl) return;
            const slot = (cat: string, m: FMedia | null, big: boolean) => m
              ? `<div class="foto-single"><img class="foto-thumb${big ? " big" : ""}" src="${escF(m.url)}" referrerpolicy="no-referrer" alt="" /><div class="foto-btns"><button type="button" class="foto-btn" data-up="${cat}">${tr("gg.fotoReplace")}</button><button type="button" class="foto-btn del" data-del="${escF(m.id)}">${tr("gg.fotoDelete")}</button></div></div>`
              : `<div class="foto-single"><span class="foto-empty${big ? " big" : ""}">${ICO}</span><button type="button" class="foto-btn" data-up="${cat}">${tr("gg.fotoUpload")}</button></div>`;
            const gal = `<button type="button" class="foto-add" data-up="ADDITIONAL">+ ${tr("gg.fotoAdd")}</button>`
              + data.gallery.map((m) => `<div class="foto-cell"><img src="${escF(m.url)}" referrerpolicy="no-referrer" alt="" /><button type="button" class="foto-x" data-del="${escF(m.id)}">\u00d7</button></div>`).join("");
            bodyEl.innerHTML =
              `<div class="fi-block"><div class="foto-duo">` +
                `<div class="foto-one foto-logo"><h3 class="fi-h3">${tr("gg.fotoLogo")}</h3>${slot("LOGO", data.logo, false)}</div>` +
                `<div class="foto-one"><h3 class="fi-h3">${tr("gg.fotoCover")}</h3>${slot("COVER", data.cover, true)}</div>` +
              `</div></div>` +
              `<div class="fi-block"><h3 class="fi-h3">${tr("gg.fotoGallery")}</h3><div class="foto-grid">${gal}</div></div>`;
          }
          async function loadFoto() {
            if (!bodyEl) return;
            bodyEl.innerHTML = `<p class="fi-soon">${tr("gg.attrLoading")}</p>`;
            try {
              const r = await fetch("/api/admin/google/media", { headers: await authFresh() });
              const j = await r.json();
              if (!r.ok) { bodyEl.innerHTML = `<p class="fi-soon">${escF(j.error || tr("res.connErr"))}</p>`; return; }
              data = { logo: j.logo || null, cover: j.cover || null, gallery: (j.gallery || []) as FMedia[] };
              renderFoto();
            } catch { bodyEl.innerHTML = `<p class="fi-soon">${tr("res.connErr")}</p>`; }
          }
          bodyEl?.addEventListener("click", async (e) => {
            const up = (e.target as HTMLElement).closest("[data-up]") as HTMLElement | null;
            if (up) {
              upCat = String(up.dataset.up);
              if (up.classList.contains("foto-add")) { window.dispatchEvent(new CustomEvent("imgpick:open")); return; }
              fileInput?.click();
              return;
            }
            const del = (e.target as HTMLElement).closest("[data-del]") as HTMLButtonElement | null;
            if (!del) { bodyEl.querySelectorAll(".confirm").forEach((x) => x.classList.remove("confirm")); return; }
            if (!del.classList.contains("confirm")) {
              bodyEl.querySelectorAll(".confirm").forEach((x) => { x.classList.remove("confirm"); if (x.classList.contains("del")) x.textContent = tr("gg.fotoDelete"); });
              del.classList.add("confirm");
              if (del.classList.contains("del")) del.textContent = tr("gg.fotoConfirm");
              return;
            }
            del.disabled = true;
            try {
              const r = await fetch("/api/admin/google/media", { method: "POST", headers: { ...(await authFresh()), "X-Method-Override": "DELETE" }, body: JSON.stringify({ name: del.dataset.del }) });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || tr("res.connErr"));
              toast(tr("gg.fotoDeleted"));
              await loadFoto();
            } catch (err) { toast((err as Error).message, true); del.disabled = false; }
          });
          fileInput?.addEventListener("change", async () => {
            const file = fileInput.files?.[0];
            if (!file) return;
            toast(tr("cli.uploading"));
            try {
              const foto = await comprimiFoto(file);
              if (foto.size > 5 * 1024 * 1024) throw new Error(tr("cli.fileTooBig"));
              const b64 = await new Promise<string>((res, rej) => { const rd = new FileReader(); rd.onload = () => res(String(rd.result).split(",")[1] ?? ""); rd.onerror = () => rej(new Error()); rd.readAsDataURL(foto); });
              const up = await fetch("/api/admin/upload", { method: "POST", headers: await authFresh(), body: JSON.stringify({ filename: foto.name, data: b64, bucket: "popups", folder: "google-media" }) });
              const uj = await up.json();
              if (!up.ok || !uj.url) throw new Error(uj.error || tr("cli.uploadError"));
              // Logo/Copertina sono slot singoli: se ne esiste già uno, lo elimino prima
              // (altrimenti Google terrebbe due logo/copertine).
              const vecchia = upCat === "LOGO" ? data.logo : upCat === "COVER" ? data.cover : null;
              if (vecchia) {
                try { await fetch("/api/admin/google/media", { method: "POST", headers: { ...(await authFresh()), "X-Method-Override": "DELETE" }, body: JSON.stringify({ name: vecchia.id }) }); } catch { /* best-effort */ }
              }
              const r = await fetch("/api/admin/google/media", { method: "POST", headers: await authFresh(), body: JSON.stringify({ url: uj.url, category: upCat }) });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || tr("res.connErr"));
              toast(tr("gg.fotoUploaded"));
              await loadFoto();
            } catch (err) { toast((err as Error).message, true); }
            finally { fileInput.value = ""; }
          });
          window.addEventListener("imgpick:pick", async (e) => {
            const panel = document.querySelector('[data-gpanel="foto"]') as HTMLElement | null;
            if (!panel || panel.style.display === "none") return; // solo quando siamo nel tab Foto
            const url = (e as CustomEvent<{ url: string }>).detail?.url;
            if (!url) return;
            toast(tr("cli.uploading"));
            try {
              const r = await fetch("/api/admin/google/media", { method: "POST", headers: await authFresh(), body: JSON.stringify({ url, category: upCat }) });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || tr("res.connErr"));
              toast(tr("gg.fotoUploaded"));
              await loadFoto();
            } catch (err) { toast((err as Error).message, true); }
          });
          document.getElementById("g-tabs")?.addEventListener("click", (ev) => {
            const b = (ev.target as HTMLElement).closest(".mtab") as HTMLElement | null;
            if (b?.dataset.gtab !== "foto" || loaded) return;
            loaded = true; void loadFoto();
          });
        })();

