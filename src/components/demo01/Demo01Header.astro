---
// Header del template demo01, estratto come componente riutilizzabile
// (stesso markup/CSS di _page.html). Usato dal Demo01Layout per tutte le
// pagine satellite (conferma/annullo ordine, feedback). Le voci puntano
// alla home /demo01#… così funzionano anche fuori dalla one-page.
interface Props { nome: string; lang?: string; }
const { nome, lang = "fr" } = Astro.props;
const L = ["fr", "en", "it"].includes(lang) ? lang : "fr";

const D: Record<string, Record<string, string>> = {
  fr: { home: "Accueil", resto: "Le restaurant", carte: "La carte", menus: "Les menus", contact: "Nous contacter", book: "Réserver", cart: "Panier" },
  en: { home: "Home", resto: "The restaurant", carte: "A la carte", menus: "Set menus", contact: "Contact us", book: "Book", cart: "Cart" },
  it: { home: "Home", resto: "Il ristorante", carte: "La carta", menus: "I menu", contact: "Contatti", book: "Prenota", cart: "Carrello" },
};
const t = D[L];

// Link lang: ricarica la pagina corrente cambiando solo ?lang, preservando gli altri parametri.
const langHref = (l: string) => {
  const u = new URL(Astro.url);
  u.searchParams.set("lang", l);
  return u.pathname + u.search;
};
---
<header>
  <div class="wrap nav">
    <a class="brand" href="/demo01">
      <span class="logo">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 L21.5 20 Q12 24 2.5 20 Z" fill="#f7f1e6"/><circle cx="9.8" cy="12" r="1.35" fill="#e23b2e"/><circle cx="14.2" cy="14.3" r="1.35" fill="#e23b2e"/><circle cx="11.6" cy="16.8" r="1.15" fill="#46a860"/></svg>
      </span>
      <span set:html={nome.replace(/ /g, "&nbsp;")}></span>
    </a>
    <nav class="nav-links">
      <a href="/demo01#accueil">{t.home}</a>
      <a href="/demo01#restaurant">{t.resto}</a>
      <a href="/demo01#commander">{t.carte}</a>
      <a href="/demo01#menus">{t.menus}</a>
      <a href="/demo01#reserver">{t.contact}</a>
    </nav>
    <div class="nav-right">
      <span class="powered">Propulsé par <b>RestoHub</b></span>
      <div class="lang">
        <a class={"lang-b" + (L === "fr" ? " on" : "")} href={langHref("fr")}>FR</a>
        <a class={"lang-b" + (L === "it" ? " on" : "")} href={langHref("it")}>IT</a>
        <a class={"lang-b" + (L === "en" ? " on" : "")} href={langHref("en")}>EN</a>
      </div>
      <a class="btn-cart" href="/demo01#commander" aria-label={t.cart} title={t.cart}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      </a>
      <a class="btn btn-p" href="/demo01#reserver">{t.book}</a>
    </div>
  </div>
</header>
