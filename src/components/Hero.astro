---
// Hero homepage a tutto schermo:
// - slideshow di 3 immagini con dissolvenza incrociata (fade in/out)
// - overlay scuro + testo centrato (Benvenuti / La Molisana / Pasta & Pizza / città)
// - due bottoni outline: Notre carte + Commander
// - striscia tricolore italiana sul bordo inferiore
// Le immagini si cambiano QUI: percorsi in SLIDES (public/slideshow/).
// Se un'immagine manca, viene saltata dalla rotazione (niente flash nero).
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const en = lang === "en";

const SLIDES = [
  "/slideshow/slide-01.webp",
  "/slideshow/slide-02.webp",
  "/slideshow/slide-03.webp",
];

const L = {
  menu: en ? "Our menu" : "Notre carte",
  order: en ? "Order" : "Commander",
};
---

<section class="hero" id="hero">
  <div class="hero-slides" id="hero-slides">
    {SLIDES.map((src, i) => (
      <img
        class={"hero-slide" + (i === 0 ? " is-on" : "")}
        src={src}
        alt=""
        loading={i === 0 ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={i === 0 ? "high" : "auto"}
      />
    ))}
  </div>
  <div class="hero-overlay"></div>

  <div class="hero-center">
    <p class="hero-eyebrow">Benvenuti alla Pizzeria</p>
    <h1 class="hero-title">La Molisana</h1>
    <p class="hero-sub">Pasta &amp; Pizza</p>
    <p class="hero-city">Bruxelles, Saint&#8209;Gilles</p>
    <div class="hero-cta">
      <a href={getLocalizedUrl("/menu", lang)} class="hero-btn">{L.menu}</a>
      <a href={getLocalizedUrl("/order", lang)} class="hero-btn hero-btn-order">{L.order}</a>
    </div>
  </div>

  <div class="hero-flag" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--c-bg);
  }

  /* --- Slideshow con dissolvenza --- */
  .hero-slides, .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-slide {
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.6s ease-in-out;
  }
  .hero-slide.is-on { opacity: 1; }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  /* --- Contenuto centrato --- */
  .hero-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1.5rem;
    color: #fff;
  }
  .hero-center > * {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-in 0.9s ease-out forwards;
  }
  .hero-eyebrow { animation-delay: 0.15s; }
  .hero-title { animation-delay: 0.3s; }
  .hero-sub { animation-delay: 0.45s; }
  .hero-city { animation-delay: 0.6s; }
  .hero-cta { animation-delay: 0.8s; }
  @keyframes hero-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    margin: 0;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.4rem, 8.5vw, 6.8rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    margin: 0.2rem 0 0;
  }
  .hero-sub {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    margin: 0.35rem 0 0;
  }
  .hero-city {
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 1.1vw, 0.95rem);
    letter-spacing: 0.55em;
    text-transform: uppercase;
    opacity: 0.9;
    margin: 0.9rem 0 0;
    padding-left: 0.55em; /* compensa l'ultimo letter-spacing per centrare davvero */
  }

  .hero-cta {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 2.2rem;
  }
  .hero-btn {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border: 2px solid rgba(255, 255, 255, 0.9);
    padding: 13px 38px;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .hero-btn:hover {
    background: #fff;
    color: var(--c-bg);
    transform: scale(0.96);
  }

  /* --- Striscia tricolore --- */
  .hero-flag {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    background: linear-gradient(
      90deg,
      #007153 0%, #007153 33.333%,
      #ffffff 33.333%, #ffffff 66.666%,
      #ed1c24 66.666%, #ed1c24 100%
    );
  }

  @media (max-width: 640px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
      width: min(320px, 100%);
      gap: 0.8rem;
    }
    .hero-btn { padding: 13px 26px; text-align: center; }
    /* Commander è già nella barra fissa in basso: qui sparisce */
    .hero-btn-order { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-center > * { animation: none; opacity: 1; transform: none; }
    .hero-slide { transition: none; }
  }
</style>

<script>
  // Slideshow: dissolvenza incrociata ogni 6 secondi.
  // Le immagini non caricate (404) vengono saltate dalla rotazione.
  const contenitore = document.getElementById("hero-slides");
  const slides = Array.from(contenitore?.querySelectorAll<HTMLImageElement>(".hero-slide") ?? []);

  slides.forEach((img) => {
    img.addEventListener("error", () => {
      img.dataset.dead = "1";
      img.classList.remove("is-on");
    });
  });

  let attuale = 0;
  function prossima() {
    const vive = slides.filter((s) => s.dataset.dead !== "1");
    if (vive.length < 2) return; // con 0-1 immagini non c'è niente da alternare
    const corrente = slides[attuale];
    let i = attuale;
    do {
      i = (i + 1) % slides.length;
    } while (slides[i].dataset.dead === "1" && i !== attuale);
    if (i === attuale) return;
    corrente?.classList.remove("is-on");
    slides[i].classList.add("is-on");
    attuale = i;
  }

  const riduci = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (slides.length > 1 && !riduci) {
    setInterval(prossima, 6000);
  }
</script>
