---
// Hero homepage a tutto schermo:
// - slideshow di 3 immagini con dissolvenza incrociata (fade in/out)
// - overlay scuro + testo centrato (Benvenuti / La Molisana / Pasta & Pizza / città)
// - due bottoni outline: Notre carte + Commander
// - striscia tricolore italiana sul bordo inferiore
// Le immagini si cambiano QUI: percorsi in SLIDES (public/slideshow/).
// Se un'immagine manca, viene saltata dalla rotazione (niente flash nero).
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";
import { siteImages, siteImg } from "../lib/siteImages";
import { DateTime } from "luxon";
import { configGiornoEffettiva } from "../lib/schedule";

const lang = getLangFromUrl(Astro.url);
const en = lang === "en";

const IMGS = await siteImages();
const SLIDES = [
  siteImg(IMGS, "site_hero_1", "/slideshow/slide-01.webp"),
  siteImg(IMGS, "site_hero_2", "/slideshow/slide-02.webp"),
  siteImg(IMGS, "site_hero_3", "/slideshow/slide-03.webp"),
];

const L = {
  menu: en ? "Our menu" : "Notre carte",
  reserve: en ? "Book a table" : "Réserver",
};

// --- Stato di OGGI (rispetta anche i giorni speciali dell'admin) ---
let statoOggi: "open" | "closed" | null = null;
let fasceOggi: string[] = [];
try {
  const cfg = await configGiornoEffettiva(DateTime.now());
  if (cfg) {
    const hhmm = (t: string | null) => (t ? String(t).slice(0, 5) : "");
    if (cfg.lunch_active && cfg.lunch_open && cfg.lunch_close)
      fasceOggi.push(`${hhmm(cfg.lunch_open)} – ${hhmm(cfg.lunch_close)}`);
    if (cfg.dinner_active && cfg.dinner_open && cfg.dinner_close)
      fasceOggi.push(`${hhmm(cfg.dinner_open)} – ${hhmm(cfg.dinner_close)}`);
    statoOggi = fasceOggi.length > 0 ? "open" : "closed";
  }
} catch {
  statoOggi = null; // DB irraggiungibile: nessun badge, niente errori in pagina
}
---

<section class="hero" id="hero">
  <div class="hero-slides" id="hero-slides">
    {SLIDES.map((src, i) => (
      <img
        class={"hero-slide" + (i === 0 ? " is-on" : "")}
        src={src}
        alt=""
        loading={i === 0 ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={i === 0 ? "high" : "auto"}
      />
    ))}
  </div>
  <div class="hero-overlay"></div>

  <div class="hero-center">
    <p class="hero-eyebrow">Benvenuti alla Pizzeria</p>
    <h1 class="hero-title">La Molisana</h1>
    <p class="hero-sub">Pasta &amp; Pizza</p>
    <p class="hero-city">Bruxelles, Saint&#8209;Gilles</p>
    <div class="hero-cta">
      <a href={getLocalizedUrl("/menu", lang)} class="hero-btn">{L.menu}</a>
      <button type="button" class="hero-btn hero-btn-order" data-reserver>{L.reserve}</button>
    </div>
  </div>

  {statoOggi === "open" && (
    <div class="hero-today is-open">
      <p class="ht-line">{en ? "We are open today" : "Nous sommes ouverts aujourd'hui"}</p>
      <p class="ht-hours">{fasceOggi.join(" · ")}</p>
    </div>
  )}
  {statoOggi === "closed" && (
    <div class="hero-today is-closed">
      <p class="ht-line">{en ? "We are closed today" : "Nous sommes fermés aujourd'hui"}</p>
    </div>
  )}

  <div class="hero-flag" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--c-bg);
  }

  /* --- Slideshow con dissolvenza --- */
  .hero-slides, .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-slide {
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.6s ease-in-out;
  }
  .hero-slide.is-on { opacity: 1; }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  /* --- Contenuto centrato --- */
  .hero-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1.5rem;
    color: #fff;
  }
  .hero-center > * {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-in 0.9s ease-out forwards;
  }
  .hero-eyebrow { animation-delay: 0.15s; }
  .hero-title { animation-delay: 0.3s; }
  .hero-sub { animation-delay: 0.45s; }
  .hero-city { animation-delay: 0.6s; }
  .hero-cta { animation-delay: 0.8s; }
  @keyframes hero-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    margin: 0;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.4rem, 8.5vw, 6.8rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    margin: 0.2rem 0 0;
  }
  .hero-sub {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    margin: 0.35rem 0 0;
  }
  .hero-city {
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 1.1vw, 0.95rem);
    letter-spacing: 0.55em;
    text-transform: uppercase;
    opacity: 0.9;
    margin: 0.9rem 0 0;
    padding-left: 0.55em; /* compensa l'ultimo letter-spacing per centrare davvero */
  }

  .hero-cta {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 2.2rem;
  }
  .hero-btn {
    background: transparent;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border: 2px solid rgba(255, 255, 255, 0.9);
    padding: 13px 38px;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .hero-btn:hover {
    background: #fff;
    color: var(--c-bg);
    transform: scale(0.96);
  }

  /* --- Badge "aperti/chiusi oggi" --- */
  .hero-today {
    position: absolute;
    left: 50%;
    bottom: 36px;
    transform: translateX(-50%);
    z-index: 3;
    text-align: center;
    padding: 0.55rem 1.4rem;
    border-radius: 999px;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 16px); /* parte più in basso e centrato */
    animation: hero-today-in 0.8s ease-out 1s forwards;
  }
  @keyframes hero-today-in {
    to { opacity: 1; transform: translate(-50%, 0); }
  }
  .hero-today.is-open {
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .hero-today.is-closed {
    background: rgba(237, 28, 36, 0.92);
  }
  .ht-line {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }
  .is-open .ht-line::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2e9e6b;
    margin-right: 0.5rem;
    vertical-align: 1px;
  }
  .ht-hours {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-size: 1.02rem;
    letter-spacing: 0.03em;
    color: #fff;
  }

  /* --- Striscia tricolore --- */
  .hero-flag {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    background: linear-gradient(
      90deg,
      #007153 0%, #007153 33.333%,
      #ffffff 33.333%, #ffffff 66.666%,
      #ed1c24 66.666%, #ed1c24 100%
    );
  }

  @media (max-width: 900px) {
    /* Sopra la barra fissa Commander/Réserver/burger (64px + 14 di margine) */
    .hero-today { bottom: 96px; }
  }

  @media (max-width: 640px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
      width: min(320px, 100%);
      gap: 0.8rem;
    }
    .hero-btn { padding: 13px 26px; text-align: center; }
    /* Réserver è già nella barra fissa in basso: qui sparisce */
    .hero-btn-order { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-center > * { animation: none; opacity: 1; transform: none; }
    .hero-today { animation: none; opacity: 1; transform: translate(-50%, 0); }
    .hero-slide { transition: none; }
  }
</style>

<script>
  // Slideshow: dissolvenza incrociata ogni 6 secondi.
  // Le immagini non caricate (404) vengono saltate dalla rotazione.
  const contenitore = document.getElementById("hero-slides");
  const slides = Array.from(contenitore?.querySelectorAll<HTMLImageElement>(".hero-slide") ?? []);

  slides.forEach((img) => {
    img.addEventListener("error", () => {
      img.dataset.dead = "1";
      img.classList.remove("is-on");
    });
  });

  let attuale = 0;
  function prossima() {
    const vive = slides.filter((s) => s.dataset.dead !== "1");
    if (vive.length < 2) return; // con 0-1 immagini non c'è niente da alternare
    const corrente = slides[attuale];
    let i = attuale;
    do {
      i = (i + 1) % slides.length;
    } while (slides[i].dataset.dead === "1" && i !== attuale);
    if (i === attuale) return;
    corrente?.classList.remove("is-on");
    slides[i].classList.add("is-on");
    attuale = i;
  }

  const riduci = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (slides.length > 1 && !riduci) {
    setInterval(prossima, 6000);
  }
</script>
