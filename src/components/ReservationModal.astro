---
// Modale prenotazioni (RestoHub), disponibile su TUTTO il sito.
// Si apre cliccando qualsiasi elemento con l'attributo data-reserver.
// Contenuto: fondo navy brand ChouChou, logo ChouChou in piccolo e il
// widget caricato via iframe dalla pagina isolata /reservation
// (solo alla prima apertura: zero peso finché non serve).
---

<div class="resmod" id="resmod" aria-hidden="true">
  <div class="resmod__overlay" data-resmod-close></div>
  <div class="resmod__box" role="dialog" aria-modal="true" aria-label="Réservation">
    <iframe id="resmod-frame" title="Réservation, Comptoir ChouChou" data-src="/reservation-embed"></iframe>
  </div>
  <button class="resmod__close" type="button" data-resmod-close>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
    <span>Fermer</span>
  </button>
</div>

<style>
  .resmod {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 16px;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .resmod.open {
    visibility: visible;
    opacity: 1;
  }

  .resmod__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .resmod__box {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(468px, 100%);
    max-height: calc(100% - 76px);
    background: #353c4e;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.55);
    transform: translateY(16px);
    transition: transform 0.3s ease;
  }
  .resmod.open .resmod__box { transform: none; }

  /* Bouton fermer : pilule magenta sous le modale, avec « Fermer ».
     position/z-index : au-dessus du voile flou (sinon le bouton paraît flou). */
  .resmod__close {
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ed2289;
    border: none;
    border-radius: 999px;
    padding: 0.65rem 1.4rem;
    color: #fff;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .resmod__close:hover { background: #c8176f; transform: translateY(-1px); }
  .resmod__close svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    fill: none;
  }

  #resmod-frame {
    width: 100%;
    height: 480px; /* provvisoria: lo script la adatta al contenuto */
    margin: 0;
    border: 0;
    border-radius: 0;
    background: #353c4e;
    display: block;
  }

  @media (max-width: 640px) {
    .resmod { padding: 10px; }
  }
</style>

<script>
  const mod = document.getElementById("resmod");
  const frame = document.getElementById("resmod-frame") as HTMLIFrameElement | null;

  function apri() {
    // Il widget si carica solo alla prima apertura
    if (frame && !frame.getAttribute("src")) {
      frame.setAttribute("src", frame.dataset.src ?? "/reservation-embed");
    }
    mod?.classList.add("open");
    mod?.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  // Il widget è su una pagina NOSTRA (/reservation, stessa origine):
  // possiamo leggere l'altezza reale del contenuto e adattare l'iframe,
  // così sotto il widget non resta mai spazio vuoto.
  function ridimensiona() {
    try {
      const doc = frame?.contentDocument;
      if (!doc || !doc.body) return;
      let need = doc.body.scrollHeight;
      // Le datepicker est en position: fixed : il ne compte pas dans le
      // scrollHeight. Quand il est ouvert, on agrandit l'iframe pour qu'il
      // tienne en entier (sinon l'iframe le rognerait). Le cadre (max-height +
      // overflow auto) gère le débordement sur les petits écrans.
      const dp = doc.querySelector(".dp-panel") as HTMLElement | null;
      if (dp && getComputedStyle(dp).display !== "none") {
        need = Math.max(need, Math.ceil(dp.getBoundingClientRect().bottom) + 16);
      }
      const hpx = Math.max(240, need) + "px";
      if (frame!.style.height !== hpx) frame!.style.height = hpx;
    } catch {
      /* in caso di sorprese l'altezza resta quella di base */
    }
  }
  frame?.addEventListener("load", () => {
    ridimensiona();
    try {
      const doc = frame.contentDocument;
      if (doc?.body && "ResizeObserver" in window) {
        new ResizeObserver(ridimensiona).observe(doc.body);
      }
      // Ouverture/fermeture du datepicker et des accordéons : le widget stoppe
      // parfois la propagation du clic, donc on surveille les mutations du DOM
      // (le datepicker bascule son style display) pour réajuster l'iframe.
      if (doc?.body && "MutationObserver" in window) {
        const mo = new MutationObserver(() => ridimensiona());
        mo.observe(doc.body, {
          attributes: true,
          attributeFilter: ["style", "class"],
          childList: true,
          subtree: true,
        });
      }
      doc?.addEventListener("click", () => setTimeout(ridimensiona, 30));
    } catch {
      /* niente observer: va bene comunque */
    }
  });
  window.addEventListener("resize", ridimensiona);

  function chiudi() {
    mod?.classList.remove("open");
    mod?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  // Qualsiasi elemento con data-reserver apre il modale, ovunque nel sito.
  document.addEventListener("click", (e) => {
    const el = e.target as HTMLElement;
    const trigger = el.closest("[data-reserver]");
    if (trigger) {
      e.preventDefault();
      apri();
      return;
    }
    if (el.closest("[data-resmod-close]")) chiudi();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") chiudi();
  });
</script>
