---
// Navigazione mobile del sito pubblico (≤900px):
// - barra fissa in basso: Commander / Réserver / burger (pillole arrotondate)
// - pannello "carta" ORO che slitta dal BASSO verso l'alto (e riscende
//   alla chiusura): logo, link (pagina attiva in bianco), Réserver,
//   telefono, FR/EN, Fermer ⬇.
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const en = lang === "en";

const rawPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = rawPath.replace(/^\/en/, "") || "/";

// Etichette nella lingua della pagina (Benvenuti resta italiano: è brand)
const nav = [
  { label: "Benvenuti", path: "/" },
  { label: en ? "Our Menu" : "Notre carte", path: "/menu" },
  { label: en ? "The Ambiance" : "L'Ambiance", path: "/ambiance" },
  { label: "Contact", path: "/contact" },
  // { label: "Jobs", path: "/jobs" }, // nascosto per ora — riattivare togliendo il commento
];

function isActive(path: string): boolean {
  const clean = path.replace(/\/$/, "") || "/";
  return clean === current;
}

// Sulla pagina Commander la barra mostra solo il burger: lo spazio dei
// bottoni Commander/Réserver è occupato dall'isola carrello di OrderApp.
const isOrder = current === "/order";

const PHONE_DISPLAY = "+32 455 13 14 65";
const PHONE_TEL = "+32455131465";
const BOOK = en ? "Book" : "Réserver";
const CLOSE = en ? "Close" : "Fermer";
---

<!-- Pannello oro: slitta dal basso all'apertura, riscende alla chiusura -->
<div class="mnav-panel" id="mnav-panel">
  <img class="mnav-logo" src="/SVG/logoLa-Molisana-.svg" alt="La Molisana — Pizza & Pasta" />
  <hr class="mnav-sep" />

  <nav class="mnav-links">
    {nav.map((item) => (
      <a
        href={getLocalizedUrl(item.path, lang)}
        class={"mnav-link" + (isActive(item.path) ? " is-active" : "")}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="mnav-cta">
    <button class="mnav-book" id="mnav-reserver-panel" type="button" data-reserver>{BOOK}</button>
    <a href={getLocalizedUrl("/order", lang)} class="mnav-book">{en ? "Order" : "Commander"}</a>
  </div>

  <a href={`tel:${PHONE_TEL}`} class="mnav-phone">{PHONE_DISPLAY}</a>

  <div class="mnav-lang">
    <a href={getLocalizedUrl(current, "fr")} class={"mnav-lang-opt" + (lang === "fr" ? " is-active" : "")}>FR</a>
    <span class="mnav-lang-sep">/</span>
    <a href={getLocalizedUrl(current, "en")} class={"mnav-lang-opt" + (lang === "en" ? " is-active" : "")}>EN</a>
  </div>

  <button class="mnav-close" id="mnav-close" type="button">
    {CLOSE}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10" />
      <path d="M12 7.5v9" />
      <path d="m8.5 13 3.5 3.5L15.5 13" />
    </svg>
  </button>
</div>

<!-- Velo sfumato dietro i controlli in basso: meno confusione col contenuto -->
<div class="mnav-scrim" aria-hidden="true"></div>

<!-- Bottom bar fissa -->
<div class={"mnav-bar" + (isOrder ? " mnav-bar--order" : "")} id="mnav-bar">
  {!isOrder && (
    <a href={getLocalizedUrl("/order", lang)} class="mnav-act mnav-act-solid">{en ? "Order" : "Commander"}</a>
  )}
  {!isOrder && (
    <button class="mnav-act mnav-act-solid" id="mnav-reserver" type="button" data-reserver>{BOOK}</button>
  )}
  <button class="mnav-burger" id="mnav-burger" aria-label="Menu" aria-expanded="false">
    <span class="mnav-burger-icon" id="mnav-burger-icon">
      <span></span><span></span><span></span>
    </span>
  </button>
</div>

<style>
  .mnav-bar, .mnav-panel, .mnav-scrim { display: none; }

  @media (max-width: 900px) {
    /* --- Velo sfumato: marrone 75% in basso -> trasparente in alto --- */
    .mnav-scrim {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      height: 180px;
      background: linear-gradient(to top, rgba(35, 31, 32, 0.75), rgba(35, 31, 32, 0));
      mix-blend-mode: multiply;
      pointer-events: none;
      z-index: 50;
    }

    /* --- Barra fissa in basso --- */
    .mnav-bar {
      display: flex;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: 14px;
      height: 64px;
      padding: 8px;
      gap: 8px;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      z-index: 100;
      align-items: stretch;
      transition: transform 0.35s ease, opacity 0.35s ease;
    }
    /* Pagina Commander: resta solo il burger, la barra si stringe a destra */
    .mnav-bar--order { left: auto; }

    /* Con il pannello aperto la barra scende fuori schermo */
    .mnav-bar.is-hidden {
      transform: translateY(140%);
      opacity: 0;
      pointer-events: none;
    }
    .mnav-act {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 0.95rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border: none;
      border-radius: 10px;
      background: none;
      cursor: pointer;
    }
    .mnav-act-solid { background: var(--c-accent); color: var(--c-bg); font-weight: 400; }
    .mnav-burger {
      width: 54px;
      flex-shrink: 0;
      background: var(--c-accent);
      border: none;
      border-radius: 10px;
      color: var(--c-bg);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mnav-burger-icon {
      position: relative;
      width: 22px;
      height: 16px;
      display: inline-block;
    }
    .mnav-burger-icon span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--c-bg);
      transition: transform 0.3s ease, opacity 0.2s ease;
    }
    .mnav-burger-icon span:nth-child(1) { top: 0; }
    .mnav-burger-icon span:nth-child(2) { top: 7px; }
    .mnav-burger-icon span:nth-child(3) { top: 14px; }
    .mnav-burger.is-open .mnav-burger-icon span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .mnav-burger.is-open .mnav-burger-icon span:nth-child(2) { opacity: 0; }
    .mnav-burger.is-open .mnav-burger-icon span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* --- Pannello "carta" oro dal basso --- */
    .mnav-panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.35rem;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: 12px;
      max-height: calc(100dvh - 24px);
      overflow-y: auto;
      background: var(--c-accent);
      color: var(--c-bg);
      border-radius: 20px;
      padding: 2.2rem 1.5rem 1rem;
      box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.35);
      z-index: 110;
      transform: translateY(calc(100% + 40px));
      transition: transform 0.45s cubic-bezier(0.6, 0, 0.2, 1);
    }
    .mnav-panel.is-open { transform: translateY(0); }

    .mnav-logo { width: 190px; height: auto; display: block; }
    .mnav-sep {
      width: 100%;
      border: none;
      border-top: 1px solid rgba(35, 31, 32, 0.25);
      margin: 0;
    }

    .mnav-links {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.15rem;
    }
    .mnav-link {
      font-family: var(--font-display);
      font-size: 1.55rem;
      letter-spacing: 0.02em;
      color: var(--c-bg);
      text-decoration: none;
    }
    .mnav-link.is-active { color: #fff; }

    .mnav-cta {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .mnav-book {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      background: var(--c-bg);
      color: #fff;
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 1rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      border: none;
      border-radius: 10px;
      padding: 0.95rem;
      cursor: pointer;
      text-decoration: none;
    }

    .mnav-phone {
      font-family: var(--font-display);
      font-size: 1.5rem;
      color: var(--c-bg);
      text-decoration: none;
    }

    .mnav-lang {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.9rem;
    }
    .mnav-lang-opt { color: var(--c-bg); opacity: 0.5; text-decoration: none; }
    .mnav-lang-opt.is-active { opacity: 1; }
    .mnav-lang-sep { opacity: 0.4; }

    .mnav-close {
      align-self: flex-end;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: none;
      border: none;
      color: var(--c-bg);
      font-family: var(--font-body);
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      padding: 0.25rem;
      margin-top: -0.5rem;
    }
    .mnav-close svg { width: 20px; height: 20px; display: block; }
  }
  @media (max-width: 390px) {
    .mnav-act { font-size: 0.82rem; letter-spacing: 0.05em; }
  }
</style>

<script>
  const burger = document.getElementById("mnav-burger");
  const panel = document.getElementById("mnav-panel");
  const bar = document.getElementById("mnav-bar");
  const closeBtn = document.getElementById("mnav-close");

  function setOpen(open: boolean) {
    panel?.classList.toggle("is-open", open);
    bar?.classList.toggle("is-hidden", open);
    if (burger) {
      burger.classList.toggle("is-open", open);
      burger.setAttribute("aria-expanded", open ? "true" : "false");
    }
    document.body.style.overflow = open ? "hidden" : "";
  }

  burger?.addEventListener("click", () => {
    setOpen(!panel?.classList.contains("is-open"));
  });
  closeBtn?.addEventListener("click", () => setOpen(false));
  panel?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => setOpen(false));
  });

  // Réserver: il modale si apre via [data-reserver] (ReservationModal);
  // dal pannello chiudiamo anche il menu.
  document.getElementById("mnav-reserver-panel")?.addEventListener("click", () => setOpen(false));
</script>
