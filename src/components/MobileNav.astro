---
import { getLangFromUrl, useTranslations, getLocalizedUrl } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const rawPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = rawPath.replace(/^\/en/, "") || "/";

const nav = [
  { label: "Benvenuti", path: "/" },
  { label: "Notre carte", path: "/menu" },
  { label: "L'Ambiance", path: "/ambiance" },
  { label: "Contact", path: "/contact" },
  { label: "Jobs", path: "/jobs" },
];

const IG = "https://www.instagram.com/pizzeria77waterloo/";
const FB = "https://www.facebook.com/profile.php?id=61551793199466";
---

<!-- Pannello a tutto schermo (slide dall'alto) -->
<div class="mnav-panel" id="mnav-panel">
  <nav class="mnav-links">
    {nav.map((item) => <a href={getLocalizedUrl(item.path, lang)} class="mnav-link">{item.label}</a>)}
  </nav>

  <div class="mnav-foot">
    <a href="tel:+32455131465" class="mnav-phone">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
      </svg>
      <span>{t("nav.call")} · +32 455 13 14 65</span>
    </a>

    <div class="mnav-lang">
      <a href={getLocalizedUrl(current, "fr")} class={"mnav-lang-opt" + (lang === "fr" ? " is-active" : "")}>FR</a>
      <span class="mnav-lang-sep">/</span>
      <a href={getLocalizedUrl(current, "en")} class={"mnav-lang-opt" + (lang === "en" ? " is-active" : "")}>EN</a>
    </div>

    <div class="mnav-social">
      <a href={IG} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="2" y="2" width="20" height="20" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a href={FB} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
          <path d="M14 9h3l.4-3H14V4.3c0-.86.24-1.45 1.47-1.45H17.5V.2C17.16.15 16.18.05 15.05.05c-2.37 0-4 1.45-4 4.1V6H8v3h3.05v8h2.95V9z" />
        </svg>
      </a>
    </div>
  </div>
</div>

<!-- Bottom bar fissa -->
<div class="mnav-bar">
  <a href={getLocalizedUrl("/order", lang)} class="mnav-act mnav-act-solid">Commander</a>
  <button class="mnav-burger" id="mnav-burger" aria-label="Menu" aria-expanded="false">
    <span class="mnav-burger-icon" id="mnav-burger-icon">
      <span></span><span></span><span></span>
    </span>
  </button>
</div>

<style>
  .mnav-bar, .mnav-panel { display: none; }

  @media (max-width: 900px) {
    .mnav-bar {
      display: flex;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: 14px;
      height: 60px;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      z-index: 100;
      align-items: stretch;
    }
    .mnav-act {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 0.98rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      border: none;
      background: none;
      cursor: pointer;
    }
    .mnav-act-solid { background: var(--c-accent); color: var(--c-bg); font-weight: 400; }
    .mnav-act-outline { color: var(--c-text); border-left: 1px solid rgba(255, 255, 255, 0.15); }
    .mnav-burger {
      width: 60px;
      background: none;
      border: none;
      border-left: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--c-text);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mnav-burger-icon {
      position: relative;
      width: 22px;
      height: 16px;
      display: inline-block;
    }
    .mnav-burger-icon span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 2px;
      background: #fff;
      transition: transform 0.3s ease, opacity 0.2s ease;
    }
    .mnav-burger-icon span:nth-child(1) { top: 0; }
    .mnav-burger-icon span:nth-child(2) { top: 7px; }
    .mnav-burger-icon span:nth-child(3) { top: 14px; }
    .mnav-burger.is-open .mnav-burger-icon span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .mnav-burger.is-open .mnav-burger-icon span:nth-child(2) { opacity: 0; }
    .mnav-burger.is-open .mnav-burger-icon span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .mnav-panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.97);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 99;
      transform: translateY(-100%);
      transition: transform 0.4s cubic-bezier(0.6, 0, 0.2, 1);
    }
    .mnav-panel.is-open { transform: translateY(0); }

    .mnav-links {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }
    .mnav-link {
      font-family: var(--font-title);
      font-size: 2.6rem;
      letter-spacing: 0.04em;
      color: var(--c-text);
    }
    .mnav-foot {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      margin-top: 1rem;
    }
    .mnav-phone {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--c-text);
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 1.05rem;
    }
    .mnav-panel-book {
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-text);
      background: transparent;
      border: 1.5px solid var(--c-text);
      border-radius: 0;
      padding: 0.7rem 1.6rem;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease;
    }
    .mnav-panel-book:hover { background: var(--c-text); color: var(--c-bg); }
    .mnav-lang {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.9rem;
    }
    .mnav-lang-opt { opacity: 0.5; }
    .mnav-lang-opt.is-active { opacity: 1; color: var(--c-accent); }
    .mnav-lang-sep { opacity: 0.4; }

    .mnav-social {
      display: flex;
      gap: 1.5rem;
      margin-top: 0.5rem;
    }
    .mnav-social a {
      color: var(--c-text);
      opacity: 0.85;
      transition: opacity 0.15s;
    }
    .mnav-social a:hover { opacity: 1; }
  }
</style>

<script>
  const burger = document.getElementById("mnav-burger");
  const panel = document.getElementById("mnav-panel");

  function chiudiPannello() {
    if (panel) panel.classList.remove("is-open");
    if (burger) {
      burger.classList.remove("is-open");
      burger.setAttribute("aria-expanded", "false");
    }
    document.body.style.overflow = "";
  }

  if (burger && panel) {
    burger.addEventListener("click", () => {
      const open = panel.classList.toggle("is-open");
      burger.classList.toggle("is-open", open);
      burger.setAttribute("aria-expanded", open ? "true" : "false");
      document.body.style.overflow = open ? "hidden" : "";
    });

    panel.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", chiudiPannello);
    });
  }

</script>