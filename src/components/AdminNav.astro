---
// Floating navigation bar condivisa per le pagine admin.
// Stile: pillola "liquid glass", ogni voce con icona sopra e label piccola sotto.
// Visibile su tutti i dispositivi (fissa in basso, centrata).
interface Props {
  current?: "home" | "orders" | "bookings";
}
const { current } = Astro.props;
---

<nav class="admin-nav" aria-label="Navigation admin">
  <a href="/admin" class={current === "home" ? "active" : ""} aria-label="Accueil">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 11.5 12 4l9 7.5" />
      <path d="M5 10v9h14v-9" />
    </svg>
    <span>Accueil</span>
  </a>
  <a href="/admin/orders" class={current === "orders" ? "active" : ""} aria-label="Commandes">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 2 4 6v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6l-2-4Z" />
      <path d="M4 6h16" />
      <path d="M9 10a3 3 0 0 0 6 0" />
    </svg>
    <span>Commandes</span>
  </a>
  <a href="/admin/bookings" class={current === "bookings" ? "active" : ""} aria-label="Réservations">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="1" />
      <path d="M3 9h18" />
      <path d="M8 3v4M16 3v4" />
    </svg>
    <span>Réservations</span>
  </a>
</nav>

<style is:global>
  .admin-nav {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.25rem;
    padding: 0.4rem;
    z-index: 100;

    /* Pillola */
    border-radius: 999px;

    /* Liquid glass */
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .admin-nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--c-muted, #b3b3b3);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    transition: background 0.2s, color 0.2s;
  }
  .admin-nav a svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .admin-nav a:hover {
    color: var(--c-text, #fff);
  }
  .admin-nav a.active {
    background: rgba(255, 255, 255, 0.95);
    color: #000;
  }

  @media (max-width: 520px) {
    .admin-nav {
      left: 1rem;
      right: 1rem;
      transform: none;
      justify-content: space-around;
    }
    .admin-nav a {
      flex: 1;
      padding: 0.5rem 0.4rem;
    }
  }
</style>
