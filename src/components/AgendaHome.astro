---
// Section « Agenda » (accueil), sous la photo plein écran.
// - Un bandeau de texte géant (Quicksand + Birthstone) qui défile de gauche
//   à droite et DÉBORDE vers le haut sur la photo du restaurant au-dessus.
// - Deux blocs « prochains rendez-vous » (navy).
// Photos des events gérées depuis l'admin (slots site_event_1/2) ; repli navy.
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";
import { siteImages } from "../lib/siteImages";
const lang = getLangFromUrl(Astro.url);
const en = lang === "en";
const IMGS = await siteImages();

const word = en ? "L'agenda" : "L'agenda";
const script = en ? "les rendez-vous" : "les rendez-vous";
const UNITS = [0, 1, 2, 3];

const EVENTS = [
  {
    img: IMGS["site_event_1"] || null,
    meta: en ? "Coming soon · Guest chef" : "Prochainement · Un soir, un Chef",
    title: "Un soir, un Chef",
    text: en
      ? "Every so often, Comptoir Chouchou invites a renowned chef to take over the kitchen for one unique evening. Upcoming dates are always announced on our agenda."
      : "Régulièrement, le Comptoir Chouchou convie un chef de renom à prendre les fourneaux le temps d'une soirée unique. Les prochaines dates sont toujours annoncées sur notre agenda.",
    cta: en ? "See the agenda" : "Voir l'agenda",
    reserve: false,
  },
  {
    img: IMGS["site_event_2"] || null,
    meta: en ? "First Sunday of the month · Brunch" : "Le 1er dimanche du mois · Brunch",
    title: en ? "The Sunday brunch" : "Le brunch du dimanche",
    text: en
      ? "On the first Sunday of every month, a generous homemade brunch to share with family or friends, in the heart of the Walloon Brabant countryside. By reservation only."
      : "Le premier dimanche de chaque mois, un brunch généreux et fait maison à partager en famille ou entre amis, au cœur de la campagne du Brabant wallon. Sur réservation uniquement.",
    cta: en ? "Book a table" : "Réserver",
    reserve: true,
  },
];
---

<section class="agd">
  <div class="agd-marquee" aria-hidden="true">
    <div class="agd-row">
      <div class="agd-seq">
        {UNITS.map(() => (
          <span class="agd-unit">
            <span class="agd-word">{word}</span>
            <span class="agd-dot agd-dot--sep">✦</span>
            <span class="agd-script">{script}</span>
            <span class="agd-dot">✦</span>
          </span>
        ))}
      </div>
      <div class="agd-seq">
        {UNITS.map(() => (
          <span class="agd-unit">
            <span class="agd-word">{word}</span>
            <span class="agd-dot agd-dot--sep">✦</span>
            <span class="agd-script">{script}</span>
            <span class="agd-dot">✦</span>
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="agd-in">
    <div class="agd-grid">
      {EVENTS.map((e) => (
        e.reserve ? (
          <div class="ev ev--static">
            <div class="ev-media">
              {e.img ? (
                <img src={e.img} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="ph" aria-hidden="true"></span>
              )}
            </div>
            <div class="ev-body">
              <p class="ev-meta">{e.meta}</p>
              <h3 class="ev-title">{e.title}</h3>
              <p class="ev-text">{e.text}</p>
              <button type="button" class="ev-cta ev-cta--btn" data-reserver>{e.cta}</button>
            </div>
          </div>
        ) : (
          <a class="ev" href={getLocalizedUrl("/agenda", lang)}>
            <div class="ev-media">
              {e.img ? (
                <img src={e.img} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="ph" aria-hidden="true"></span>
              )}
            </div>
            <div class="ev-body">
              <p class="ev-meta">{e.meta}</p>
              <h3 class="ev-title">{e.title}</h3>
              <p class="ev-text">{e.text}</p>
              {e.cta && <span class="ev-cta">{e.cta}</span>}
            </div>
          </a>
        )
      ))}
    </div>
  </div>
</section>

<style>
  .agd {
    --avorio: #f7f4ee;
    --navy: #353c4e;
    --mag: #ed2289;
    position: relative;
    z-index: 1;
    display: flow-root;
    background: #ffffff;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* --- Bandeau défilant, déborde sur la photo au-dessus --- */
  .agd-marquee {
    position: relative;
    z-index: 3;
    overflow: hidden;
    margin-top: clamp(-14rem, -20vw, -7rem);
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .agd-row {
    display: flex;
    width: max-content;
    animation: agd-scroll 180s linear infinite;
  }
  .agd-seq { display: flex; flex: 0 0 auto; align-items: baseline; }
  .agd-unit { display: inline-flex; align-items: baseline; white-space: nowrap; }
  .agd-word {
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--navy);
    font-size: clamp(7rem, 20vw, 18rem);
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .agd-script {
    font-family: var(--font-script);
    color: var(--mag);
    font-size: clamp(9rem, 26vw, 22rem);
    line-height: 1;
    margin: 0 0.18em;
  }
  .agd-dot {
    color: var(--mag);
    font-size: clamp(3.2rem, 8vw, 6rem);
    line-height: 1;
    margin: 0 0.35em 0 0.1em;
    align-self: center;
  }
  .agd-dot--sep { color: var(--navy); margin: 0 0.2em 0 0.55em; }
  @keyframes agd-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* --- Blocs événements --- */
  .agd-in {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 2rem;
  }
  .agd-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2vw, 1.8rem);
  }
  .ev {
    display: flex;
    flex-direction: column;
    background: transparent;
    color: var(--navy);
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .ev:hover { transform: translateY(-3px); }
  .ev-media { width: 100%; }
  .ev-media img,
  .ev-media .ph {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .ev-media .ph { background: linear-gradient(150deg, #e2ddd0, #d3ccbc); }
  .ev-body { padding: clamp(1.2rem, 1.8vw, 1.6rem) 0 0; }
  .ev-meta {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mag);
    margin: 0;
  }
  .ev-title {
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--navy);
    font-size: clamp(1.4rem, 2.4vw, 1.95rem);
    line-height: 1.1;
    margin: 0.5rem 0 0.7rem;
  }
  .ev-text {
    font-family: var(--font-body);
    color: #4a5064;
    font-size: 0.98rem;
    line-height: 1.6;
    margin: 0;
  }
  .ev-cta {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: var(--mag);
  }
  .ev-cta::after { content: " \2192"; }
  .ev:hover .ev-cta { text-decoration: underline; }
  .ev--static { cursor: default; }
  .ev--static:hover { transform: none; }
  /* meme aspect que le lien "Voir l'agenda" : texte magenta + fleche */
  .ev-cta--btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .ev-cta--btn:hover { text-decoration: underline; }

  @media (max-width: 760px) {
    .agd-grid { grid-template-columns: 1fr; }
    .agd-marquee { margin-top: clamp(-8rem, -22vw, -4rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .agd-row { animation: none; }
  }
</style>
