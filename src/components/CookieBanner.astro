---
import { getLangFromUrl } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const isEn = lang === "en";

const cookiesHref = isEn ? "/en/cookies" : "/cookies";

const T = isEn
  ? {
      text: "We use a cookie only to remember your choice, and Google Maps on the contact page (only with your consent).",
      accept: "Accept",
      decline: "Decline",
      more: "Cookie policy",
    }
  : {
      text: "Nous utilisons un cookie uniquement pour mémoriser votre choix, et Google Maps sur la page contact (seulement avec votre consentement).",
      accept: "Accepter",
      decline: "Refuser",
      more: "Politique cookies",
    };
---

<div id="cookie-banner" class="ckb" hidden>
  <p class="ckb__kicker" aria-hidden="true">cookies</p>
  <p class="ckb__text">
    {T.text} <a href={cookiesHref} class="ckb__link">{T.more}</a>
  </p>
  <div class="ckb__actions">
    <button type="button" class="ckb__btn ckb__btn--decline" data-cookie-decline>{T.decline}</button>
    <button type="button" class="ckb__btn ckb__btn--accept" data-cookie-accept>{T.accept}</button>
  </div>
</div>

<style>
  .ckb {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 300;
    width: 350px;
    max-width: calc(100vw - 2rem);
    background: #353c4e;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    padding: 1.3rem 1.4rem;
    box-sizing: border-box;
    box-shadow: 0 14px 44px rgba(0, 0, 0, 0.5);
  }
  .ckb__kicker {
    margin: 0 0 0.1rem;
    font-family: var(--font-script);
    color: #ed2289;
    font-size: 2rem;
    line-height: 0.9;
  }
  .ckb__text {
    margin: 0 0 1.1rem;
    color: #f7f4ee;
    font-family: var(--font-body);
    font-size: 0.87rem;
    line-height: 1.55;
  }
  .ckb__link {
    color: #ed2289;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .ckb__link:hover { color: #ffffff; }
  .ckb__actions {
    display: flex;
    gap: 0.6rem;
  }
  .ckb__btn {
    flex: 1;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.7rem 0.5rem;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .ckb__btn--accept {
    background: #ed2289;
    border: 2px solid #ed2289;
    color: #ffffff;
  }
  .ckb__btn--accept:hover {
    background: #c8176f;
    border-color: #c8176f;
  }
  .ckb__btn--decline {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.4);
    color: #f7f4ee;
  }
  .ckb__btn--decline:hover {
    border-color: #ffffff;
  }

  /* Su mobile la barra di navigazione in basso occupa spazio: alzo il banner */
  @media (max-width: 900px) {
    .ckb {
      bottom: 100px;
    }
  }
</style>

<script is:inline>
  (function () {
    var KEY = "lm-cookie-consent"; // valori: "accepted" | "declined"
    var banner = document.getElementById("cookie-banner");
    if (!banner) return;

    var scelta = null;
    try {
      scelta = window.localStorage.getItem(KEY);
    } catch (e) {
      scelta = null;
    }

    // Mostra il banner solo se non c'è ancora una scelta
    if (scelta !== "accepted" && scelta !== "declined") {
      banner.hidden = false;
    }

    function salva(valore) {
      try {
        window.localStorage.setItem(KEY, valore);
      } catch (e) {}
      banner.hidden = true;
      // Avvisa il resto della pagina (es. la mappa) che la scelta è cambiata
      window.dispatchEvent(
        new CustomEvent("cookie-consent-changed", { detail: { consent: valore } })
      );
    }

    var btnAccept = banner.querySelector("[data-cookie-accept]");
    var btnDecline = banner.querySelector("[data-cookie-decline]");
    if (btnAccept) btnAccept.addEventListener("click", function () { salva("accepted"); });
    if (btnDecline) btnDecline.addEventListener("click", function () { salva("declined"); });
  })();
</script>