---
// Sezione "chi siamo" della homepage:
// - desktop: blocco di testo marrone a sinistra che si SOVRAPPONE all'immagine
//   di destra (l'immagine è più alta del blocco; il blocco proietta una
//   piccola ombra sull'immagine)
// - mobile: titolo, testo, bottoni impilati a tutta larghezza, poi la foto.
// L'immagine si cambia QUI: costante FOTO (file in public/).
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";
import { siteImages, siteImg } from "../lib/siteImages";

const lang = getLangFromUrl(Astro.url);
const en = lang === "en";

const IMGS = await siteImages();
const FOTO = siteImg(IMGS, "site_story", "/la-molisana-home-foto-01.webp");

const L = {
  title: en ? "Pizzeria La Molisana in Saint-Gilles" : "Pizzeria La Molisana à Saint-Gilles",
  p1: en
    ? "Welcome to our Italian restaurant in the heart of the Place de la Maison Communale in Saint-Gilles, Brussels!"
    : "Bienvenue dans notre restaurant italien situé au cœur de la Place de la Maison Communale de Saint-Gilles à Bruxelles !",
  p2: en
    ? "Our team is delighted to invite you to enjoy authentic Italian cuisine, prepared with the freshest and highest-quality ingredients. Let yourself be tempted by our pizzas, our homemade pasta and La Molisana's exclusive dishes, and savour every bite."
    : "Notre équipe est ravie de vous inviter à déguster une cuisine italienne authentique, préparée avec les ingrédients les plus frais et de la plus haute qualité. Laissez-vous tenter par nos pizzas, nos pâtes maison et les plats exclusifs de La Molisana, et savourez chaque bouchée sans hésiter.",
  p3: en
    ? "Our warm and welcoming atmosphere will make you feel right at home — we are proud to be a family-run restaurant where everyone is welcome."
    : "Notre atmosphère chaleureuse et accueillante vous permettra de vous sentir comme chez vous, et nous sommes fiers d'être un restaurant familial où tout le monde est le bienvenu.",
  menu: en ? "Our menu" : "Notre carte",
  ambiance: en ? "The ambiance" : "L'Ambiance",
};
---

<section class="story">
  <div class="story-text">
    <h2 class="story-title">{L.title}</h2>
    <p>{L.p1}</p>
    <p>{L.p2}</p>
    <p>{L.p3}</p>
    <div class="story-cta">
      <a href={getLocalizedUrl("/menu", lang)} class="story-btn">{L.menu}</a>
      <a href={getLocalizedUrl("/ambiance", lang)} class="story-btn">{L.ambiance}</a>
    </div>
  </div>

  <div class="story-media">
    <img src={FOTO} alt={L.title} loading="lazy" decoding="async" />
  </div>
</section>

<style>
  .story {
    display: flex;
    align-items: center;
    max-width: var(--maxw);
    margin: 0 auto;
    background: var(--c-bg);
    padding: 6rem 2rem;
  }

  /* --- Blocco testo marrone che si sovrappone all'immagine --- */
  .story-text {
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    width: min(600px, 52%);
    background: var(--c-bg);
    padding: 3.25rem 3.5rem 3.25rem 0; /* niente padding a sinistra: testo allineato alle sezioni sotto */
    margin-right: -110px; /* la sovrapposizione sull'immagine */
  }
  /* Ombra "a foglio sopraelevato": visibile SOLO sulla parte che copre
     l'immagine (il ritaglio parte esattamente dal bordo dell'immagine),
     quindi niente alone a sinistra del blocco. */
  .story-text::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.5);
    clip-path: inset(-60px -60px -60px calc(100% - 110px));
  }
  .story-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.2vw, 2.9rem);
    line-height: 1.15;
    margin: 0 0 1.8rem;
  }
  .story-text p {
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.75;
    margin: 0 0 1.25rem;
  }

  .story-cta {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
    margin-top: 2.2rem;
  }
  .story-btn {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    text-align: center;
    border: 2px solid rgba(255, 255, 255, 0.9);
    padding: 13px 38px;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .story-btn:hover {
    background: #fff;
    color: var(--c-bg);
    transform: scale(0.96);
  }

  /* --- Immagine: più alta del blocco, dietro di lui --- */
  .story-media {
    flex: 1;
    min-width: 0;
  }
  .story-media img {
    display: block;
    width: 100%;
    height: clamp(620px, 78vh, 800px);
    object-fit: cover;
  }

  /* --- Animazione d'ingresso (come il hero): parte quando la sezione entra in vista --- */
  .story-text > *,
  .story-media {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .story-media { transition-delay: 0.15s; }
  .story-text > :nth-child(1) { transition-delay: 0.1s; }
  .story-text > :nth-child(2) { transition-delay: 0.25s; }
  .story-text > :nth-child(3) { transition-delay: 0.4s; }
  .story-text > :nth-child(4) { transition-delay: 0.55s; }
  .story-text > :nth-child(5) { transition-delay: 0.7s; }
  .story.in-view .story-text > *,
  .story.in-view .story-media {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .story-text > *, .story-media { opacity: 1; transform: none; transition: none; }
  }

  /* --- Mobile: tutto impilato, foto in fondo --- */
  @media (max-width: 900px) {
    .story {
      flex-direction: column;
      align-items: stretch;
      padding: 3rem 1.5rem;
    }
    .story-text {
      width: auto;
      padding: 0;
      margin-right: 0;
    }
    .story-text::before { display: none; }
    .story-cta {
      flex-direction: column;
      align-items: stretch;
      gap: 0.9rem;
    }
    .story-btn { padding: 13px 26px; }
    .story-media { margin-top: 2.5rem; }
    .story-media img { height: auto; }
  }
</style>

<script>
  // Entrata del contenuto quando la sezione arriva in vista (una volta sola).
  const sezione = document.querySelector(".story");
  if (sezione) {
    const oss = new IntersectionObserver(
      (voci) => {
        for (const v of voci) {
          if (v.isIntersecting) {
            sezione.classList.add("in-view");
            oss.disconnect();
          }
        }
      },
      { threshold: 0.22 }
    );
    oss.observe(sezione);
  }
</script>
