---
import { getLangFromUrl, useTranslations } from "../i18n/ui";
import { linksSocial } from "../lib/links";
import { siteImages, siteImg } from "../lib/siteImages";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Ogni slide con le sue dimensioni reali (servono a Safari per calcolare
// la larghezza del nastro PRIMA che le immagini carichino → niente collasso).
const IMGS = await siteImages();
const slides = [
  { src: siteImg(IMGS, "site_gallery_1", "/slideshow/slide-01.webp"), w: 2200, h: 1466 },
  { src: siteImg(IMGS, "site_gallery_2", "/slideshow/slide-02.webp"), w: 2200, h: 1467 },
  { src: siteImg(IMGS, "site_gallery_3", "/slideshow/slide-03.webp"), w: 2200, h: 1467 },
  { src: siteImg(IMGS, "site_gallery_4", "/slideshow/slide-04.webp"), w: 784, h: 1000 },
  { src: siteImg(IMGS, "site_gallery_5", "/slideshow/slide-05.webp"), w: 1000, h: 667 },
  { src: siteImg(IMGS, "site_gallery_6", "/slideshow/slide-06.webp"), w: 667, h: 1000 },
  { src: siteImg(IMGS, "site_gallery_7", "/slideshow/slide-07.webp"), w: 1200, h: 800 },
  { src: siteImg(IMGS, "site_gallery_8", "/slideshow/slide-08.webp"), w: 1064, h: 1200 },
  { src: siteImg(IMGS, "site_gallery_9", "/slideshow/slide-09.webp"), w: 1200, h: 800 },
  { src: siteImg(IMGS, "site_gallery_10", "/slideshow/slide-10.webp"), w: 800, h: 1200 },
]

const loop = [...slides, ...slides];

const en = lang === "en";
// Social gestiti dall'admin (Réglages -> Liens)
const social = await linksSocial();
---

<section class="strip" aria-label="Galerie La Molisana">
  <div class="strip-intro">
    <h2 class="strip-title">{t("strip.title")}</h2>
    <p class="strip-text">{t("strip.text")}</p>
  </div>

  <div class="strip-viewport">
    <div class="strip-track">
      {loop.map((s) => (
        <div class="strip-cell" style={`aspect-ratio: ${s.w} / ${s.h};`}>
          <img src={s.src} alt="" width={s.w} height={s.h} loading="eager" decoding="async" />
        </div>
      ))}
    </div>
  </div>

  <div class="strip-follow">
    <h3 class="follow-title">{en ? "Follow us" : "Suivez-nous"}</h3>
    <div class="follow-icons">
      {social.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label} set:html={s.icon} />
      ))}
    </div>
  </div>
</section>

<style>
  .strip {
    width: 100%;
    overflow: hidden;
    background: var(--c-bg);
    padding-top: 6rem;
    padding-bottom: 7rem;
  }

  .strip-intro {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 2rem 1.5rem 2.5rem;
    text-align: center;
  }

  .strip-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    margin: 0 0 1rem;
    color: var(--c-text);
  }

  .strip-text {
    max-width: 620px;
    margin: 0 auto;
    color: var(--c-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* viewport: nasconde l'overflow; il track scorre dentro */
  .strip-viewport {
    width: 100%;
    overflow: hidden;
  }

  .strip-track {
    display: flex;
    gap: 14px;
    padding: 0 7px;
    width: max-content;
    animation: strip-scroll 60s linear infinite;
    will-change: transform;
  }

  .strip-cell {
    flex: 0 0 auto;
    height: 360px;
    /* la larghezza è derivata dall'aspect-ratio inline (proporzioni reali) */
  }

  .strip-cell img {
    display: block;
    height: 360px;
    width: auto;
    object-fit: cover;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* --- Suivez-nous sotto il carosello --- */
  .strip-follow {
    text-align: center;
    margin-top: 4rem;
    padding: 0 1.5rem;
  }
  .follow-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.9rem;
    margin: 0 0 1.2rem;
    color: var(--c-text);
  }
  .follow-icons {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }
  .follow-icons a {
    color: var(--c-text);
    display: inline-flex;
    transition: color 0.15s;
  }
  .follow-icons a:hover { color: var(--c-accent); }
  .follow-icons a :global(svg) { width: 26px; height: 26px; display: block; }

  @keyframes strip-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (max-width: 700px) {
    .strip-cell, .strip-cell img { height: 240px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip-track {
      animation: none;
    }
    .strip-viewport {
      overflow-x: auto;
    }
  }
</style>