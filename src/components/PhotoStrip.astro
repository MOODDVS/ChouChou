---
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Ogni slide con le sue dimensioni reali (servono a Safari per calcolare
// la larghezza del nastro PRIMA che le immagini carichino → niente collasso).
const slides = [
  { src: "/slideshow/slide-01.webp", w: 2200, h: 1466 },
  { src: "/slideshow/slide-02.webp", w: 2200, h: 1467 },
  { src: "/slideshow/slide-03.webp", w: 2200, h: 1467 },
  { src: "/slideshow/slide-04.webp", w: 784, h: 1000 },
  { src: "/slideshow/slide-05.webp", w: 1000, h: 667 },
  { src: "/slideshow/slide-06.webp", w: 667, h: 1000 },
  { src: "/slideshow/slide-07.webp", w: 1200, h: 800 },
  { src: "/slideshow/slide-08.webp", w: 1064, h: 1200 },
  { src: "/slideshow/slide-09.webp", w: 1200, h: 800 },
  { src: "/slideshow/slide-10.webp", w: 800, h: 1200 },
]

const loop = [...slides, ...slides];

const en = lang === "en";
const FB = "https://www.facebook.com/pizzerialamolisana";
const IG = "https://www.instagram.com/pizzeria.lamolisana/";
---

<section class="strip" aria-label="Galerie La Molisana">
  <div class="strip-intro">
    <h2 class="strip-title">{t("strip.title")}</h2>
    <p class="strip-text">{t("strip.text")}</p>
  </div>

  <div class="strip-viewport">
    <div class="strip-track">
      {loop.map((s) => (
        <div class="strip-cell" style={`aspect-ratio: ${s.w} / ${s.h};`}>
          <img src={s.src} alt="" width={s.w} height={s.h} loading="eager" decoding="async" />
        </div>
      ))}
    </div>
  </div>

  <div class="strip-follow">
    <h3 class="follow-title">{en ? "Follow us" : "Suivez-nous"}</h3>
    <div class="follow-icons">
      <a href={FB} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg viewBox="0 0 176 176" fill="currentColor" aria-hidden="true">
          <path d="M171.63,40.85C167.68,25,151,8.31,135.15,4.36A262,262,0,0,0,88,0,262.18,262.18,0,0,0,40.85,4.36C25,8.31,8.32,25,4.37,40.85a256.4,256.4,0,0,0,0,94.3C8.32,151,25,167.7,40.85,171.64A262.18,262.18,0,0,0,88,176q6.72,0,13.4-.35a268.5,268.5,0,0,0,33.75-4c15.89-3.94,32.53-20.6,36.48-36.49A262.39,262.39,0,0,0,176,86.49,262.11,262.11,0,0,0,171.63,40.85ZM115.88,77.59l-1.77,15.32a2.86,2.86,0,0,1-2.82,2.57h-16l-.08,45.45a2.05,2.05,0,0,1-2,2.07H77a2,2,0,0,1-2-2.08L75,95.48H63a2.87,2.87,0,0,1-2.84-2.9L60.1,77.25a2.88,2.88,0,0,1,2.84-2.92H75V59.53C75,42.35,85.2,33,100.16,33h12.26a2.88,2.88,0,0,1,2.85,2.92V48.83a2.88,2.88,0,0,1-2.85,2.92H104.9c-8.13,0-9.71,4-9.71,9.77V74.33h17.87A2.89,2.89,0,0,1,115.88,77.59Z" />
        </svg>
      </a>
      <a href={IG} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
          <path d="m301 256c0 24.851562-20.148438 45-45 45s-45-20.148438-45-45 20.148438-45 45-45 45 20.148438 45 45zm0 0" />
          <path d="m332 120h-152c-33.085938 0-60 26.914062-60 60v152c0 33.085938 26.914062 60 60 60h152c33.085938 0 60-26.914062 60-60v-152c0-33.085938-26.914062-60-60-60zm-76 211c-41.355469 0-75-33.644531-75-75s33.644531-75 75-75 75 33.644531 75 75-33.644531 75-75 75zm86-146c-8.285156 0-15-6.714844-15-15s6.714844-15 15-15 15 6.714844 15 15-6.714844 15-15 15zm0 0" />
          <path d="m377 0h-242c-74.4375 0-135 60.5625-135 135v242c0 74.4375 60.5625 135 135 135h242c74.4375 0 135-60.5625 135-135v-242c0-74.4375-60.5625-135-135-135zm45 332c0 49.625-40.375 90-90 90h-152c-49.625 0-90-40.375-90-90v-152c0-49.625 40.375-90 90-90h152c49.625 0 90 40.375 90 90zm0 0" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .strip {
    width: 100%;
    overflow: hidden;
    background: var(--c-bg);
    padding-top: 6rem;
    padding-bottom: 7rem;
  }

  .strip-intro {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 2rem 1.5rem 2.5rem;
    text-align: center;
  }

  .strip-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    margin: 0 0 1rem;
    color: var(--c-text);
  }

  .strip-text {
    max-width: 620px;
    margin: 0 auto;
    color: var(--c-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* viewport: nasconde l'overflow; il track scorre dentro */
  .strip-viewport {
    width: 100%;
    overflow: hidden;
  }

  .strip-track {
    display: flex;
    gap: 14px;
    padding: 0 7px;
    width: max-content;
    animation: strip-scroll 60s linear infinite;
    will-change: transform;
  }

  .strip-cell {
    flex: 0 0 auto;
    height: 360px;
    /* la larghezza è derivata dall'aspect-ratio inline (proporzioni reali) */
  }

  .strip-cell img {
    display: block;
    height: 360px;
    width: auto;
    object-fit: cover;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* --- Suivez-nous sotto il carosello --- */
  .strip-follow {
    text-align: center;
    margin-top: 4rem;
    padding: 0 1.5rem;
  }
  .follow-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.9rem;
    margin: 0 0 1.2rem;
    color: var(--c-text);
  }
  .follow-icons {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }
  .follow-icons a {
    color: var(--c-text);
    display: inline-flex;
    transition: color 0.15s;
  }
  .follow-icons a:hover { color: var(--c-accent); }
  .follow-icons svg { width: 26px; height: 26px; display: block; }

  @keyframes strip-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (max-width: 700px) {
    .strip-cell, .strip-cell img { height: 240px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip-track {
      animation: none;
    }
    .strip-viewport {
      overflow-x: auto;
    }
  }
</style>