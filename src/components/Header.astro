---
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";
import { linksSocial } from "../lib/links";

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);

// Percorso corrente normalizzato (senza slash finale e senza prefisso /en).
const rawPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = rawPath.replace(/^\/en/, "") || "/";

const en = lang === "en";

// Etichette nella lingua della pagina (Benvenuti resta italiano: è brand)
const nav = [
  { label: "Benvenuti", path: "/" },
  { label: en ? "Our Menu" : "Notre carte", path: "/menu" },
  { label: en ? "The Ambiance" : "L'Ambiance", path: "/ambiance" },
  { label: "Contact", path: "/contact" },
  // { label: "Jobs", path: "/jobs" }, // nascosto per ora — riattivare togliendo il commento
];

function isActive(path: string): boolean {
  const clean = path.replace(/\/$/, "") || "/";
  return clean === current;
}

const PHONE_DISPLAY = "+32 455 13 14 65";
const PHONE_TEL = "+32455131465";
const EMAIL = "info@lamolisana.be";
// Social gestiti dall'admin (Réglages -> Liens)
const social = await linksSocial();
---

<header class={"hdr" + (transparent ? " hdr-transparent" : "")}>
  <div class="hdr-inner">
    <nav class="hdr-nav">
      {nav.map((item) => (
        <a
          href={getLocalizedUrl(item.path, lang)}
          class={"hdr-link" + (isActive(item.path) ? " is-active" : "")}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a href={getLocalizedUrl("/", lang)} class="hdr-logo" aria-label="La Molisana — accueil">
      <img src="/SVG/logoLa-Molisana-.svg" alt="La Molisana — Pizza & Pasta" />
    </a>

    <div class="hdr-right">
      <div class="hdr-lang">
        <button class="hdr-lang__btn" id="hdr-lang-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Langue">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" />
            <path d="M3.5 12h17" />
            <path d="M12 3.5c2.6 2.3 3.9 5.1 3.9 8.5s-1.3 6.2-3.9 8.5c-2.6-2.3-3.9-5.1-3.9-8.5s1.3-6.2 3.9-8.5z" />
          </svg>
          <span>{lang.toUpperCase()}</span>
        </button>
        <div class="hdr-lang__menu" id="hdr-lang-menu">
          <a href={getLocalizedUrl(current, "fr")} class={lang === "fr" ? "is-active" : ""}>FR</a>
          <a href={getLocalizedUrl(current, "en")} class={lang === "en" ? "is-active" : ""}>EN</a>
        </div>
      </div>

      <div class="hdr-social">
        {social.map((s) => (
          <a href={s.url} class="soc" aria-label={s.label} target="_blank" rel="noopener noreferrer" set:html={s.icon} />
        ))}
      </div>

      <a href={getLocalizedUrl("/order", lang)} class="btn">{lang === "en" ? "Order" : "Commander"}</a>
      <button type="button" class="btn" data-reserver>{lang === "en" ? "Book" : "Réserver"}</button>
    </div>
  </div>
</header>

<style>
  .hdr {
    width: 100%;
    background: var(--c-bg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  /* Homepage: header trasparente in cima, poi #231f20 (linea bianca + ombra) allo scroll */
  .hdr-transparent {
    position: fixed;
    top: 0;
    left: 0;
    background: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hdr-transparent.scrolled {
    background: var(--c-bg);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  .hdr-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    padding: 0 2rem;
  }

  /* Nav a sinistra */
  .hdr-nav { display: flex; align-items: center; gap: 1.8rem; }
  .hdr-link {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: 0.01em;
    color: var(--c-text);
    opacity: 0.85;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color 0.15s, opacity 0.15s;
  }
  .hdr-link:hover { opacity: 1; color: var(--c-accent); }
  .hdr-link.is-active { opacity: 1; color: var(--c-accent); }

  /* Logo centrato */
  .hdr-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: block;
  }
  .hdr-logo img {
    display: block;
    height: 36px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  /* Destra: telefono + social + bottone */
  .hdr-right { display: flex; align-items: center; gap: 1.5rem; }
  .hdr-lang { position: relative; }
  .hdr-lang__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    color: var(--c-text);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    padding: 0.3rem 0.2rem;
    transition: color 0.15s;
  }
  .hdr-lang__btn:hover { color: var(--c-accent); }
  .hdr-lang__btn svg {
    width: 19px;
    height: 19px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .hdr-lang__menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 72px;
    background: var(--c-bg);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    padding: 0.3rem;
    display: none;
    z-index: 60;
  }
  .hdr-lang.open .hdr-lang__menu { display: block; }
  .hdr-lang__menu a {
    display: block;
    padding: 0.45rem 0.8rem;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--c-text);
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }
  .hdr-lang__menu a:hover { background: rgba(255, 255, 255, 0.08); }
  .hdr-lang__menu a.is-active { color: var(--c-accent); }

  .hdr-social { display: flex; align-items: center; gap: 0.9rem; }
  .soc {
    color: var(--c-text);
    opacity: 0.9;
    display: inline-flex;
    transition: opacity 0.15s, color 0.15s;
  }
  .soc:hover { opacity: 1; color: var(--c-accent); }
  .soc :global(svg) { width: 20px; height: 20px; display: block; }

  .btn {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 12px 26px;
    background: var(--c-accent);
    color: var(--c-bg);
    border: none;
    border-radius: 10px;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: inset 0 0 0 1.5px var(--c-accent);
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    cursor: pointer;
  }
  /* I due bottoni (Commander + Réserver) stanno vicini tra loro */
  .btn + .btn { margin-left: -0.75rem; }
  .btn:hover {
    background: #ffffff;
    color: var(--c-bg);
    box-shadow: inset 0 0 0 1.5px #ffffff;
    transform: scale(0.96);
  }

  @media (max-width: 1150px) {
    .hdr-nav { gap: 1.15rem; }
    .hdr-link { font-size: 0.9rem; }
    .hdr-right { gap: 0.8rem; }
    .btn { padding: 11px 18px; font-size: 0.85rem; }
  }
  /* 901–1320px: logo in alto, link centrati sotto; telefono/social/bottone nascosti */
  @media (max-width: 1320px) and (min-width: 901px) {
    .hdr-inner {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: auto;
      gap: 0.5rem;
      padding: 0.85rem 1.5rem;
    }
    .hdr-logo { position: static; transform: none; order: -1; }
    .hdr-right { display: none; }
    .hdr-nav { justify-content: center; flex-wrap: wrap; gap: 1.4rem; }
    .hdr-link { font-size: 0.95rem; }
  }

  @media (max-width: 900px) {
    .hdr-inner { flex-direction: row; justify-content: center; height: 72px; padding: 0 1.5rem; }
    .hdr-nav, .hdr-right { display: none; }
    .hdr-logo { position: static; transform: none; }
    .hdr-logo img { height: 30px; }
  }
</style>

<script>
  // Dropdown lingua (icona mondo): toggle al click, chiusura al click fuori
  const langBox = document.querySelector(".hdr-lang");
  const langBtn = document.getElementById("hdr-lang-btn");
  langBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const aperto = langBox?.classList.toggle("open");
    langBtn.setAttribute("aria-expanded", aperto ? "true" : "false");
  });
  document.addEventListener("click", () => {
    langBox?.classList.remove("open");
    langBtn?.setAttribute("aria-expanded", "false");
  });

  const header = document.querySelector(".hdr-transparent");
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 50) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
