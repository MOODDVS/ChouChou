---
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);

// Percorso corrente normalizzato (senza slash finale e senza prefisso /en).
const rawPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = rawPath.replace(/^\/en/, "") || "/";

const nav = [
  { label: "Benvenuti", path: "/" },
  { label: "Notre carte", path: "/menu", caret: true },
  { label: "L'Ambiance", path: "/ambiance" },
  { label: "Contact", path: "/contact" },
  { label: "Jobs", path: "/jobs" },
];

function isActive(path: string): boolean {
  const clean = path.replace(/\/$/, "") || "/";
  return clean === current;
}

const PHONE_DISPLAY = "+32 455 13 14 65";
const PHONE_TEL = "+32455131465";
const EMAIL = "info@lamolisana.be";
const FB = "https://www.facebook.com/pizzerialamolisana";
const IG = "https://www.instagram.com/pizzeria.lamolisana/";
---

<header class={"hdr" + (transparent ? " hdr-transparent" : "")}>
  <div class="hdr-inner">
    <nav class="hdr-nav">
      {nav.map((item) => (
        <a
          href={getLocalizedUrl(item.path, lang)}
          class={"hdr-link" + (isActive(item.path) ? " is-active" : "")}
        >
          {item.label}{item.caret && <span class="caret">▾</span>}
        </a>
      ))}
    </nav>

    <a href={getLocalizedUrl("/", lang)} class="hdr-logo" aria-label="La Molisana — accueil">
      <img src="/SVG/logoLa-Molisana-.svg" alt="La Molisana — Pizza & Pasta" />
    </a>

    <div class="hdr-right">
      <a href={`tel:${PHONE_TEL}`} class="hdr-phone">{PHONE_DISPLAY}</a>

      <div class="hdr-social">
        <a href={FB} class="soc" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 176 176" fill="currentColor" aria-hidden="true">
            <path d="M171.63,40.85C167.68,25,151,8.31,135.15,4.36A262,262,0,0,0,88,0,262.18,262.18,0,0,0,40.85,4.36C25,8.31,8.32,25,4.37,40.85a256.4,256.4,0,0,0,0,94.3C8.32,151,25,167.7,40.85,171.64A262.18,262.18,0,0,0,88,176q6.72,0,13.4-.35a268.5,268.5,0,0,0,33.75-4c15.89-3.94,32.53-20.6,36.48-36.49A262.39,262.39,0,0,0,176,86.49,262.11,262.11,0,0,0,171.63,40.85ZM115.88,77.59l-1.77,15.32a2.86,2.86,0,0,1-2.82,2.57h-16l-.08,45.45a2.05,2.05,0,0,1-2,2.07H77a2,2,0,0,1-2-2.08L75,95.48H63a2.87,2.87,0,0,1-2.84-2.9L60.1,77.25a2.88,2.88,0,0,1,2.84-2.92H75V59.53C75,42.35,85.2,33,100.16,33h12.26a2.88,2.88,0,0,1,2.85,2.92V48.83a2.88,2.88,0,0,1-2.85,2.92H104.9c-8.13,0-9.71,4-9.71,9.77V74.33h17.87A2.89,2.89,0,0,1,115.88,77.59Z" />
          </svg>
        </a>
        <a href={IG} class="soc" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
            <path d="m301 256c0 24.851562-20.148438 45-45 45s-45-20.148438-45-45 20.148438-45 45-45 45 20.148438 45 45zm0 0" />
            <path d="m332 120h-152c-33.085938 0-60 26.914062-60 60v152c0 33.085938 26.914062 60 60 60h152c33.085938 0 60-26.914062 60-60v-152c0-33.085938-26.914062-60-60-60zm-76 211c-41.355469 0-75-33.644531-75-75s33.644531-75 75-75 75 33.644531 75 75-33.644531 75-75 75zm86-146c-8.285156 0-15-6.714844-15-15s6.714844-15 15-15 15 6.714844 15 15-6.714844 15-15 15zm0 0" />
            <path d="m377 0h-242c-74.4375 0-135 60.5625-135 135v242c0 74.4375 60.5625 135 135 135h242c74.4375 0 135-60.5625 135-135v-242c0-74.4375-60.5625-135-135-135zm45 332c0 49.625-40.375 90-90 90h-152c-49.625 0-90-40.375-90-90v-152c0-49.625 40.375-90 90-90h152c49.625 0 90 40.375 90 90zm0 0" />
          </svg>
        </a>
      </div>

      <a href={getLocalizedUrl("/order", lang)} class="btn">Commander</a>
    </div>
  </div>
</header>

<style>
  .hdr {
    width: 100%;
    background: var(--c-bg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  /* Homepage: header trasparente in cima, poi #231f20 (linea bianca + ombra) allo scroll */
  .hdr-transparent {
    position: fixed;
    top: 0;
    left: 0;
    background: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hdr-transparent.scrolled {
    background: var(--c-bg);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  .hdr-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    padding: 0 2rem;
  }

  /* Nav a sinistra */
  .hdr-nav { display: flex; align-items: center; gap: 1.8rem; }
  .hdr-link {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: 0.01em;
    color: var(--c-text);
    opacity: 0.85;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color 0.15s, opacity 0.15s;
  }
  .hdr-link:hover { opacity: 1; color: var(--c-accent); }
  .hdr-link.is-active { opacity: 1; color: var(--c-accent); }
  .caret { font-size: 0.7rem; opacity: 0.8; }

  /* Logo centrato */
  .hdr-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: block;
  }
  .hdr-logo img {
    display: block;
    height: 36px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  /* Destra: telefono + social + bottone */
  .hdr-right { display: flex; align-items: center; gap: 1.5rem; }
  .hdr-phone {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    color: var(--c-text);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s;
  }
  .hdr-phone:hover { color: var(--c-accent); }

  .hdr-social { display: flex; align-items: center; gap: 0.9rem; }
  .soc {
    color: var(--c-text);
    opacity: 0.9;
    display: inline-flex;
    transition: opacity 0.15s, color 0.15s;
  }
  .soc:hover { opacity: 1; color: var(--c-accent); }
  .soc svg { width: 20px; height: 20px; display: block; }

  .btn {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 12px 26px;
    background: var(--c-accent);
    color: var(--c-bg);
    border: none;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: inset 0 0 0 1.5px var(--c-accent);
    transition: background 0.2s ease, color 0.2s ease;
    cursor: pointer;
  }
  .btn:hover { background: transparent; color: var(--c-accent); }

  @media (max-width: 1150px) {
    .hdr-nav { gap: 1.15rem; }
    .hdr-link { font-size: 0.9rem; }
    .hdr-right { gap: 1rem; }
    .hdr-phone { font-size: 0.9rem; }
  }
  /* 901–1320px: logo in alto, link centrati sotto; telefono/social/bottone nascosti */
  @media (max-width: 1320px) and (min-width: 901px) {
    .hdr-inner {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: auto;
      gap: 0.5rem;
      padding: 0.85rem 1.5rem;
    }
    .hdr-logo { position: static; transform: none; order: -1; }
    .hdr-right { display: none; }
    .hdr-nav { justify-content: center; flex-wrap: wrap; gap: 1.4rem; }
    .hdr-link { font-size: 0.95rem; }
  }

  @media (max-width: 900px) {
    .hdr-inner { flex-direction: row; justify-content: center; height: 72px; padding: 0 1.5rem; }
    .hdr-nav, .hdr-right { display: none; }
    .hdr-logo { position: static; transform: none; }
    .hdr-logo img { height: 30px; }
  }
</style>

<script>
  const header = document.querySelector(".hdr-transparent");
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 50) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
