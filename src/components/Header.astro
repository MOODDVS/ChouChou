---
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";
import { linksSocial } from "../lib/links";

interface Props {
  /** Home: header flottant transparent en haut, fond au scroll. */
  transparent?: boolean;
  /** Page à fond clair : logo social + texte tournant en navy (sinon blanc). */
  onLight?: boolean;
}
const { transparent = false, onLight = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const en = lang === "en";

// Chemin courant normalisé (sans slash final ni préfixe /en).
const rawPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = rawPath.replace(/^\/en/, "") || "/";

const nav = [
  { label: en ? "Home" : "Accueil", path: "/" },
  { label: en ? "Menu" : "Carte", path: "/menu" },
  { label: en ? "Grocery" : "Épicerie", path: "/epicerie" },
  { label: en ? "Events" : "Agenda", path: "/agenda" },
  { label: "Contact", path: "/contact" },
];

function isActive(path: string): boolean {
  const clean = path.replace(/\/$/, "") || "/";
  return clean === current;
}

// Social gérés par l'admin (Réglages → Liens). L'anneau alterne IG ⇄ FB
// TOUJOURS (décoratif même sans lien configuré) ; au survol, les réseaux
// réellement configurés dans l'admin s'affichent et deviennent cliquables.
const social = await linksSocial();
const IG_ICON = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.9 5.9 0 0 0-2.13 1.39A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.39 2.13a5.9 5.9 0 0 0 2.13 1.39c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.39 5.9 5.9 0 0 0 1.39-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.39-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zM12 16a4 4 0 1 1 4-4 4 4 0 0 1-4 4zM19.85 5.59a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44z"/></svg>';
const FB_ICON = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07z"/></svg>';
const cycle = [{ icon: IG_ICON }, { icon: FB_ICON }];
// Lien du badge « Suivez-nous » : Instagram en priorité, sinon Facebook, sinon 1er configuré.
const primaryUrl =
  social.find((s) => s.k === "instagram")?.url ||
  social.find((s) => s.k === "facebook")?.url ||
  social[0]?.url ||
  "";
---

<header class={"chdr" + (transparent ? " is-transparent" : "") + (onLight ? " is-onlight" : "")}>
  <div class="chdr-in">
    <!-- Logo (bloc navy, logo blanc, petite animation en boucle) -->
    <a href={getLocalizedUrl("/", lang)} class="clogo-blk" aria-label="Comptoir Chouchou — accueil">
      <span class="clogo">
        <span class="comptoir">Comptoir</span>
        <span class="chou">Chouchou</span>
      </span>
    </a>

    <!-- Nav (bloc ivoire, se resserre sur les liens, poussé à droite) -->
    <nav class="cnav">
      {nav.map((item) => (
        <a href={getLocalizedUrl(item.path, lang)} class={"cnav-a" + (isActive(item.path) ? " on" : "")}>
          {item.label}
        </a>
      ))}
    </nav>

    <!-- CTA (Commander masqué pour le moment) -->
    <button type="button" class="cbtn cbtn-res" data-reserver>
      {en ? "Book" : "Réserver"} <span class="arw">→</span>
    </button>

    <!-- Langue (bloc navy) -->
    <div class="clang">
      <svg class="clang-globe" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path>
      </svg>
      <div class="clang-langs">
        <a href={getLocalizedUrl(current, "fr")} class={"clang-l" + (lang === "fr" ? " on" : "")}>FR</a>
        <span class="clang-sep">|</span>
        <a href={getLocalizedUrl(current, "en")} class={"clang-l" + (lang === "en" ? " on" : "")}>EN</a>
      </div>
    </div>

    <!-- Badge social circulaire : « SUIVEZ-NOUS » tourne autour des icônes IG⇄FB centrées -->
    <a class="csoc" href={primaryUrl || undefined} target={primaryUrl ? "_blank" : undefined} rel={primaryUrl ? "noopener noreferrer" : undefined} aria-label="Suivez-nous">
      <svg class="csoc-ring" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <path id="csoc-path" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"></path>
        </defs>
        <text><textPath href="#csoc-path" textLength="232" lengthAdjust="spacing">SUIVEZ-NOUS <tspan class="csoc-dot">•</tspan> SUIVEZ-NOUS <tspan class="csoc-dot">•</tspan> </textPath></text>
      </svg>
      <span class="csoc-cycle" aria-hidden="true">
        {cycle.map((s, i) => (
          <span class={"ic " + (i === 0 ? "a" : "b")} set:html={s.icon} />
        ))}
      </span>
    </a>
  </div>
</header>

<style>
  .chdr {
    --navy: #353c4e;
    --navd: #2a303e;
    --mag: #ed2289;
    --magd: #c8176f;
    --ivory: #f7f4ee;
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navd);
    transition: transform 0.35s ease;
    will-change: transform;
  }
  /* Home : flotte au-dessus du hero, prend un fond discret au scroll */
  .chdr.is-transparent {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    transition: background 0.3s ease, box-shadow 0.3s ease, backdrop-filter 0.3s ease, transform 0.35s ease;
  }
  .chdr.is-transparent.scrolled {
    background: transparent;
    backdrop-filter: none;
    box-shadow: none;
  }
  /* Auto-hide : glisse vers le haut au scroll descendant */
  .chdr.chdr--hidden { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) {
    .chdr { transition: none; }
    .chdr.chdr--hidden { transform: none; }
  }

  .chdr-in {
    max-width: 1440px;
    margin: 0 auto;
    padding: 24px 28px;
    display: flex;
    align-items: stretch;
    gap: 14px;
  }
  .chdr-in > * { min-height: 72px; }
  /* Ombre tres legere sur les blocs de l'header */
  .clogo-blk,
  .cnav,
  .cbtn-res,
  .clang {
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.1);
  }

  /* Logo */
  /* Bloc logo « comme le logo » : bloc navy à BORDURE BLANCHE (pas de cadre
     interne), Comptoir en cursive magenta à l'intérieur, Chouchou centré.
     Proportions proches du logo (~3:1). */
  .clogo-blk {
    position: relative;
    background: var(--navy);
    border: 1.6px solid #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 40px;
    text-decoration: none;
  }
  .clogo { position: relative; display: block; }
  /* Chouchou centré dans le bloc ; Comptoir (plus petit) flotte au-dessus,
     en haut à gauche, sans décaler le centrage. */
  .clogo .chou {
    display: block;
    font-family: var(--font-title);
    font-weight: 500;
    font-size: 1.85rem;
    letter-spacing: 0.01em;
    line-height: 1;
    text-align: center;
    color: #fff;
  }
  .clogo .comptoir {
    position: absolute;
    top: -0.66em;
    left: -6px;
    transform: rotate(-4deg);
    transform-origin: left center;
    font-family: var(--font-script);
    font-size: 1.15rem;
    line-height: 1;
    white-space: nowrap;
    color: var(--mag);
  }
  /* Nav ivoire : ne s'élargit pas, poussée à droite */
  .cnav {
    background: #fff;
    display: flex;
    align-items: center;
    gap: 1.85rem;
    padding: 0 30px;
    margin-left: auto;
  }
  .cnav-a {
    color: var(--navy);
    text-decoration: none;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    position: relative;
  }
  .cnav-a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 0;
    height: 2px;
    background: var(--mag);
    transition: width 0.2s;
  }
  .cnav-a:hover::after, .cnav-a.on::after { width: 100%; }
  .cnav-a.on { color: var(--mag); }

  /* Boutons Commander + Réserver */
  .cbtn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 26px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: #fff;
  }
  .cbtn .arw { transition: transform 0.2s; }
  .cbtn:hover .arw { transform: translateX(5px); }
  .cbtn-cmd { background: var(--navy); }
  .cbtn-cmd:hover { background: var(--navd); }
  .cbtn-res { background: var(--mag); }
  .cbtn-res:hover { background: var(--magd); }

  /* Langue (bloc navy autonome) */
  .clang {
    background: var(--navy);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0 16px;
  }
  .clang-globe { width: 18px; height: 18px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; }
  .clang-langs {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-title);
    font-size: 0.78rem;
    line-height: 1;
  }
  .clang-l { text-decoration: none; color: #fff; font-weight: 600; opacity: 0.33; transition: opacity 0.15s ease; }
  .clang-l.on { font-weight: 700; opacity: 1; }
  .clang-l:not(.on):hover { opacity: 0.7; }
  .clang-sep { color: #fff; opacity: 0.33; font-size: 0.78rem; }

  /* Badge social circulaire : « SUIVEZ-NOUS » tourne autour des icônes IG⇄FB centrées */
  .csoc {
    position: relative;
    align-self: center;
    flex: 0 0 auto;
    width: 66px;
    height: 66px;
    min-height: 0;
    display: block;
    text-decoration: none;
  }
  .csoc-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-origin: center;
    animation: csoc-spin 16s linear infinite;
  }
  .csoc-ring text {
    fill: #fff;
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 9px;
    transition: fill 0.2s;
  }
  /* Les deux séparateurs « • » restent magenta et referment l'anneau */
  .csoc-ring .csoc-dot { fill: var(--mag); font-size: 13px; }
  /* Page à fond clair : badge social en navy (les points restent magenta) */
  .chdr.is-onlight .csoc-ring text { fill: #353c4e; }
  .chdr.is-onlight .csoc-cycle .ic { color: #353c4e; }
  @keyframes csoc-spin { to { transform: rotate(360deg); } }
  .csoc-cycle { position: absolute; inset: 0; pointer-events: none; }
  .csoc-cycle .ic {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: color 0.2s;
  }
  .csoc-cycle .ic :global(svg) { width: 18px; height: 18px; display: block; fill: currentColor; }
  .csoc-cycle .a { animation: csA 6s infinite; }
  .csoc-cycle .b { animation: csB 6s infinite; }
  @keyframes csA {
    0%, 42% { opacity: 1; transform: translateY(0); }
    50%, 92% { opacity: 0; transform: translateY(-7px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes csB {
    0%, 42% { opacity: 0; transform: translateY(7px); }
    50%, 92% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(7px); }
  }
  /* Survol : icônes + anneau en magenta, rotation en pause */
  .csoc:hover .csoc-cycle .ic { color: var(--mag); }
  .csoc:hover .csoc-ring text { fill: var(--mag); }
  .csoc:hover .csoc-ring { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .csoc-ring { animation: none; }
    .csoc-cycle .a, .csoc-cycle .b { animation: none; }
    .csoc-cycle .b { opacity: 0; }
  }

  /* ===== Tablette & mobile : uniquement le logo ===== */
  @media (max-width: 1024px) {
    /* Logo à gauche + badge social circulaire à droite ; rien d'autre. */
    .chdr-in { justify-content: space-between; align-items: center; padding: 16px 18px; }
    .cnav, .cbtn, .clang { display: none; }
    .clogo-blk { padding: 8px 26px; }
    .clogo .chou { font-size: 1.5rem; }
    .clogo .comptoir { font-size: 1.05rem; }
    /* Aucun fond au scroll sur mobile. */
    .chdr.is-transparent.scrolled {
      background: transparent;
      backdrop-filter: none;
      box-shadow: none;
    }
  }
</style>

<script>
  // Fond du header au scroll (uniquement en mode transparent / home)
  const hdr = document.querySelector(".chdr.is-transparent");
  if (hdr) {
    const onScroll = () => {
      if (window.scrollY > 40) hdr.classList.add("scrolled");
      else hdr.classList.remove("scrolled");
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  // Badge social : blanc sur le hero sombre, navy dès qu'on passe sur le
  // contenu clair. (Pages entièrement claires : is-onlight vient du prop,
  // on n'y touche pas.)
  const hdrLight = document.querySelector(".chdr");
  const heroEl =
    (document.querySelector('main [class*="hero"]') ||
    document.querySelector("main section")) as HTMLElement | null;
  if (hdrLight && heroEl && !hdrLight.classList.contains("is-onlight")) {
    let tickL = false;
    const majLight = () => {
      const heroH = heroEl.offsetHeight || window.innerHeight;
      if (window.scrollY >= heroH - 6) hdrLight.classList.add("is-onlight");
      else hdrLight.classList.remove("is-onlight");
      tickL = false;
    };
    window.addEventListener("scroll", () => {
      if (!tickL) { window.requestAnimationFrame(majLight); tickL = true; }
    }, { passive: true });
    window.addEventListener("resize", majLight, { passive: true });
    majLight();
  }

  // Auto-hide : cache l'header au scroll vers le bas, le montre au scroll vers le haut
  const bar = document.querySelector(".chdr");
  if (bar) {
    let lastY = window.scrollY;
    let ticking = false;
    const TOP = 80; // toujours visible pres du haut
    const update = () => {
      const y = window.scrollY;
      if (y <= TOP) {
        bar.classList.remove("chdr--hidden");
      } else if (y > lastY + 4) {
        bar.classList.add("chdr--hidden");      // vers le bas -> cache
      } else if (y < lastY - 4) {
        bar.classList.remove("chdr--hidden");   // vers le haut -> montre
      }
      lastY = y;
      ticking = false;
    };
    window.addEventListener("scroll", () => {
      if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
  }
</script>
