---
// Ultima sezione della homepage: 3 schede — Menu / Ambiance / Contact.
// Ogni scheda: foto, titolo Marcellus, riga di testo, bottone outline.
// Le foto si cambiano QUI: costanti nelle CARDS (file in public/).
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";
import { siteImages, siteImg } from "../lib/siteImages";

const lang = getLangFromUrl(Astro.url);
const en = lang === "en";

const IMGS = await siteImages();
const CARDS = [
  {
    img: siteImg(IMGS, "site_cta_menu", "/la-molisana-cta-menu.webp"),
    href: getLocalizedUrl("/menu", lang),
    title: en ? "The menu" : "Le menu",
    text: en
      ? "Our pizzas, homemade pasta, antipasti and desserts — dine in or take away."
      : "Nos pizzas, pâtes maison, antipasti et desserts — sur place ou à emporter.",
    btn: en ? "The menu" : "Le menu",
  },
  {
    img: siteImg(IMGS, "site_cta_ambiance", "/la-molisana-cta-ambiance.webp"),
    href: getLocalizedUrl("/ambiance", lang),
    title: en ? "The ambiance" : "L'Ambiance",
    text: en
      ? "Discover our dining room, our terrace and the spirit of the house."
      : "Découvrez notre salle, notre terrasse et l'esprit de la maison.",
    btn: en ? "The ambiance" : "L'Ambiance",
  },
  {
    img: siteImg(IMGS, "site_cta_contact", "/la-molisana-cta-contact.webp"),
    href: getLocalizedUrl("/contact", lang),
    title: "Contact",
    text: en
      ? "Opening hours, address and reservations — find us in Saint-Gilles."
      : "Horaires, adresse et réservations — retrouvez-nous à Saint-Gilles.",
    btn: "Contact",
  },
];
---

<section class="cta3">
  {CARDS.map((c) => (
    <a href={c.href} class="cta3-card">
      <div class="cta3-media">
        <img src={c.img} alt="" loading="lazy" decoding="async" />
      </div>
      <h2 class="cta3-title">{c.title}</h2>
      <p class="cta3-text">{c.text}</p>
      <span class="cta3-btn">{c.btn}</span>
    </a>
  ))}
</section>

<style>
  .cta3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    max-width: var(--maxw);
    margin: 0 auto;
    background: var(--c-bg);
    padding: 5rem 2rem 7rem;
  }

  .cta3-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: var(--c-text);
  }

  .cta3-media {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 1.6rem;
  }
  .cta3-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }
  .cta3-card:hover .cta3-media img { transform: scale(1.05); }

  .cta3-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.9rem;
    margin: 0 0 0.6rem;
  }
  .cta3-text {
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--c-muted);
    margin: 0 0 1.6rem;
    max-width: 340px;
  }

  .cta3-btn {
    display: inline-block;
    margin-top: auto;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.9);
    padding: 13px 38px;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .cta3-card:hover .cta3-btn {
    background: #fff;
    color: var(--c-bg);
    transform: scale(0.96);
  }

  /* --- Animazione d'ingresso --- */
  .cta3-card {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .cta3-card:nth-child(1) { transition-delay: 0.1s; }
  .cta3-card:nth-child(2) { transition-delay: 0.25s; }
  .cta3-card:nth-child(3) { transition-delay: 0.4s; }
  .cta3.in-view .cta3-card { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .cta3-card { opacity: 1; transform: none; transition: none; }
  }

  /* --- Responsive --- */
  @media (max-width: 900px) {
    .cta3 {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 3rem 1.5rem 4rem;
    }
  }
</style>

<script>
  // Entrata delle schede quando la sezione arriva in vista (una volta sola).
  const sezione = document.querySelector(".cta3");
  if (sezione) {
    const oss = new IntersectionObserver(
      (voci) => {
        for (const v of voci) {
          if (v.isIntersecting) {
            sezione.classList.add("in-view");
            oss.disconnect();
          }
        }
      },
      { threshold: 0.18 }
    );
    oss.observe(sezione);
  }
</script>
