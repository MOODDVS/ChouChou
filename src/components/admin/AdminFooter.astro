---
// Footer minimale delle pagine admin (componente condiviso, incluso
// una volta per pagina). FISSO in basso: non scorre con il contenuto.
// Linea leggera sopra per delimitarlo; la nav flottante gli passa sopra.
import { PRODOTTO } from "../../config/client";
---

<footer class="ah-footer">
  <span>{PRODOTTO.copyright + " - " + PRODOTTO.nome + " " + PRODOTTO.versione}</span>
</footer>

<style>
  .ah-footer {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 80; /* sotto la nav flottante (100) */
    padding: 0.45rem 1.5rem;
    text-align: right;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--c-muted, var(--c-muted));
    background: color-mix(in srgb, var(--c-bg) 85%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--c-line, var(--c-line));
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .ah-footer { padding: 0.4rem 1rem; }
  }
</style>
