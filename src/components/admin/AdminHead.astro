---
/**
 * ANTI-FLASH del tema — va messo in fondo al <head> di OGNI pagina admin.
 *
 * Stampa lato SERVER i colori del cliente (Réglages → Design), l'effet verre,
 * l'intensita' delle ombre, la barra colorata del browser e la favicon del
 * brand. Essendo nel <head>, arrivano PRIMA del primo paint: niente piu'
 * lampo arancione RestoHub in attesa del fetch di /api/admin/pages.
 *
 * Costo: zero query in piu' — caricaBootAdmin() e' la stessa lettura, in
 * cache 60s, che le pagine gia' fanno per la lingua (adminLang()).
 *
 * AdminNav continua ad applicare il tema anche lato client dopo il fetch:
 * serve a recepire un cambio di colori avvenuto DENTRO i 60s di cache.
 */
import { caricaBootAdmin, cssTema } from "../../lib/admin/adminBoot";
import { CLIENT } from "../../config/client";
import Fonts from "../Fonts.astro";
import "../../styles/modal.css";   // guscio condiviso dei modali (.md-*)
import "../../styles/switch.css";  // interruttore condiviso (.switch)
import "../../styles/toast.css";   // toast condiviso (.toast)
import "../../styles/field.css";   // campi condivisi (.md-box input, .fld)
import "../../styles/button.css";  // bottoni d'azione condivisi (.btn)
import "../../styles/fab.css";     // pulsante fisso in basso a destra (.fab-add .fab-pill)
import "../../styles/sede.css";    // multi-sede: pastiglia e selettore (.sede-avatar)
import "../../styles/stati.css";   // menu degli stati di una prenotazione (.st-menu)
import "../../styles/prep.css";    // bottoni 15/30/45 e «Fermer» (.prep-btn)
// ⚠️ I filtri a pastiglia erano l'unico componente condiviso che OGNI PAGINA
// doveva ricordarsi di importare da sola. Ed e' andata come doveva: la
// colonna Notes della Accueil ha avuto i suoi filtri e ha mostrato quattro
// bottoni grigi di sistema — il CSS non c'era, e non c'era nessun errore,
// solo un disegno che non somigliava a niente. Ora sta qui con gli altri.
import "../../styles/filters.css"; // filtri a pastiglia condivisi (.rh-filter)
import "../../styles/tablet.css";  // iPad orizzontale: scala ridotta (vedi il file)

const boot = await caricaBootAdmin();
// App installata col marchio del cliente: vale solo se l'icona c'e' davvero
// (caricaBootAdmin ripiega gia' su "restohub" se manca, qui e' solo leggibilita').
const marchioCliente = boot.pwaBrand === "client" && !!boot.appIcon;
// IL COLORE DEI PLACEHOLDER, una volta per tutto il pannello.
//
// ⚠️ NON `--c-muted`, ed e' il guasto visto su 450 Gradi (09/10/2026): il
// grigio secondario e' un colore del TEMA, che ogni cliente sceglie, e li'
// e' quasi bianco — i suggerimenti dentro i campi si leggevano come testo
// scritto davvero. Un placeholder non e' testo secondario: e' testo che NON
// C'E', e deve sembrarlo su qualunque tema.
//
// ⚠️ Mescolato con `transparent` e non col fondo pagina: i campi hanno il
// LORO fondo (`--c-input`), che nei temi scuri e' piu' chiaro della pagina.
// Mescolando con `--c-bg` il suggerimento sarebbe stato calcolato su un
// fondo che non e' quello su cui si posa. Trasparente si fonde con quello
// che ha dietro, qualunque sia.
//
// `:where()` = specificita' zero, quindi ogni regola di pagina vince:
// percio' il colore sta in una VARIABILE, e chi ha una sua regola
// `::placeholder` usa quella (vedi `styles/field.css`) invece di un grigio
// proprio. `opacity:1` annulla lo 0.54 che ci mette Firefox.
const PLACEHOLDER_CSS =
  ":root{--c-ph:color-mix(in srgb,var(--c-text) 38%,transparent)}" +
  ":where(input,textarea)::placeholder{color:var(--c-ph);opacity:1}";
// Layout del contenuto: UNICA definizione per <main>, condivisa da tutte le
// pagine admin (AdminHead è nel <head> di ognuna). Prima era ripetuta in ogni
// pagina. Mobile: meno padding laterale (più spazio alle card); il padding in
// basso resta per la bottom-nav.
// ⚠️ I colori di STATO stanno qui, una volta per tutto il pannello. Il verde
// «va bene» era dichiarato dentro `super.astro` (su `.pane`) e serviva anche
// alla Accueil: due dichiarazioni dello stesso colore sono due colori, e un
// giorno divergono senza che nessuno se ne accorga. `--c-barra` e' il tono
// delle barrette dei grafici: una serie sola, un colore solo, e non il
// corallo — quello e' il colore dell'ATTENZIONE in tutto il pannello.
const STATO_CSS = ":root{--c-ok:#2e9e6b;--c-ok-chiaro:#4fbe8c;--c-barra:#4e8f9c}";
// ⚠️ `hidden` DEVE nascondere, sempre. L'attributo si appoggia alla regola
// del browser `[hidden]{display:none}`, che e' debolissima: QUALUNQUE regola
// nostra che dia un `display` a quell'elemento la batte, e l'elemento resta
// in pagina con l'attributo addosso. Non da' nessun errore — si vede, e solo
// se qualcuno guarda. E' successo tre volte: il modale (`.md-overlay`), il
// menu delle sedi (`.ah-sede-menu`) e il campo «+ etichetta» delle note, ogni
// volta rattoppato sul posto con una regola in piu'. Qui si chiude per tutti.
// `!important` e' voluto: `hidden` dice che la cosa NON C'E', e non e' una
// preferenza di stile che un'altra regola possa discutere.
// IL VETRO (liquid glass): le tre sfocature del telaio, QUI e non nei loro
// componenti — ed e' l'unico motivo per cui stanno separate dal fondo che
// accompagnano.
//
// ⚠️ IL GUASTO (09/10/2026, trovato su L'Huile). Header, isola della nav e
// filo del copyright avevano ognuno il suo `backdrop-filter` nel proprio
// `<style>`, e sul sito in produzione il vetro era sparito da tutti e tre
// insieme: il fondo trasparente c'era, la sfocatura no. Nel browser
// `getComputedStyle` diceva `none` e la proprieta' non era NEMMENO nel CSS
// servito — cioe' non e' il browser che la ignora, e' la COSTRUZIONE che la
// butta via. Vite 8 passa il CSS dei componenti a lightningcss con un
// bersaglio di browser «largamente disponibili», e `backdrop-filter` non e'
// ancora in quell'elenco (Safari lo ha senza prefisso solo dal 18): la riga
// viene tolta in silenzio. Nessun errore, nessun avviso — solo un pannello
// piatto, e tre componenti che sembravano a posto.
//
// Questo foglio invece e' una STRINGA stampata a runtime (`is:inline`): la
// costruzione non lo guarda nemmeno, e quello che c'e' scritto arriva al
// browser esattamente com'e'. Il giorno in cui il bersaglio cambia ancora,
// qui non cambia niente.
//
// ⚠️ Si dichiara SOLO la sfocatura: i fondi semitrasparenti restano nei
// componenti, dove non danno fastidio a nessuno e dove si leggono accanto al
// resto del loro disegno. La specificita' lo permette — le regole dei
// componenti hanno un attributo in piu' (lo scope di Astro) e vincono sul
// fondo, ma la sfocatura non la dichiarano piu' nessuno.
const VETRO_CSS =
  "html.glass .ah-header{-webkit-backdrop-filter:blur(20px) saturate(150%);backdrop-filter:blur(20px) saturate(150%)}" +
  "html.glass .admin-nav{-webkit-backdrop-filter:blur(26px) saturate(150%);backdrop-filter:blur(26px) saturate(150%)}" +
  ".ah-footer{-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}";
const HIDDEN_CSS = "[hidden]{display:none!important}";
// ⚠️ L'ISOLA IN BASSO, IN DUE PEZZI E UNA SOMMA. Sta qui accanto a
// `--h-header` perche' e' la stessa specie di misura: l'altezza che il telaio
// del pannello si prende sullo schermo.
//   --h-nav-h    altezza dell'isola (uguale a `.fab-pill` in styles/fab.css,
//                che e' disegnato apposta per posarsi sulla sua linea)
//   --h-nav-gap  quanto sta staccata dal bordo (`bottom` di `.admin-nav`)
//   --h-nav      la somma: l'ingombro totale, per chi deve starci FUORI
//                (il piede del `main` qui sotto).
// ⚠️ I pezzi separati non sono pedanteria: chi ci passa SOTTO di proposito
// — la fascia della Accueil, che si ferma a meta' isola — ha bisogno della
// meta' dell'ALTEZZA, e con la sola somma dovrebbe dividere per due anche lo
// stacco dal bordo, cioe' inventarsi un numero che nessuna delle due scale
// controlla. Qui ogni scala dichiara i due pezzi e la somma si rifa' da sola.
//   desktop  57px + 1.25rem                               = 77px
//   tablet   46px + 0.9rem col piede a 13px               = 58px
// Se si tocca una di quelle misure, questa riga la segue: sono scritte nei
// commenti di fab.css e AdminNav, che rimandano qui.
// Telefono: l'isola e' alta come sul desktop, quindi i valori non cambiano.
// ⚠️ Il filo del copyright (AdminFooter, ~28px) sta SOTTO l'isola e piu'
// basso di lei: chi sta fuori dall'isola e' gia' fuori anche da quello.
//
// ⚠️ E' LA STESSA MISURA DEL PIEDE DEL `main`, e percio' il piede la USA
// invece di riscriverla. Erano `8rem` sul desktop e `6rem` sul tablet, scelti
// a occhio: due numeri che esistevano solo per lasciar passare l'isola e che
// nessuno avrebbe aggiornato il giorno in cui l'isola cambia altezza — anzi,
// sul tablet i 6rem col piede a 13px fanno 78px contro un'isola da 58, cioe'
// gia' due misure che non si parlavano. Ora il piede e' l'ingombro + l'aria
// per staccare l'ultima riga, e le media query cambiano solo le VARIABILI.
const LAYOUT_CSS =
  ":root{--h-header:81px;--h-nav-h:57px;--h-nav-gap:1.25rem;--h-nav:calc(var(--h-nav-h) + var(--h-nav-gap))}" +
  "main{--pad-y:2rem;--pad-x:1.5rem;flex:1;width:100%;padding:var(--pad-y) var(--pad-x) calc(var(--h-nav) + 3rem)}" +
  "@media(max-width:640px){main{--pad-y:1.25rem;--pad-x:1rem}}" +
  // iPad orizzontale al dito: stessa fascia di styles/tablet.css.
  "@media(min-width:1024px) and (max-width:1366px) and (pointer:coarse){:root{--h-header:51px;--h-nav-h:46px;--h-nav-gap:0.9rem}main{--pad-y:1rem;--pad-x:1rem}}";
// ⚠️ LE FUNZIONI SPENTE, una volta per tutto il pannello e per TUTTI.
// `data-admin-page="orders"` marca cio' che PARLA di ordini: la colonna della
// giornata, le tile, i numeri. Se il super ha spento Commandes in Pages
// visibles, quel ristorante non prende ordini e nulla di tutto questo deve
// comparire — nemmeno al super, che pure la pagina deve poterla riaprire
// (il link in nav resta: lo tocca solo AdminNav, con `a[data-page]`).
//
// Qui e non lato client: `boot` e' la stessa lettura in cache che la pagina
// fa comunque, non serve ne' cookie ne' token, e stando nel <head> arriva
// prima del primo paint. Una rimozione dal DOM dopo un fetch, invece, era un
// lampo di tile e una griglia che teneva il posto a una colonna che spariva.
const SPENTE_CSS = boot.hiddenPages
  .filter((k) => /^[a-z]+$/.test(k))
  .map((k) => `[data-admin-page="${k}"]{display:none!important}`)
  .join("");
const css = cssTema(boot.theme) + PLACEHOLDER_CSS + STATO_CSS + HIDDEN_CSS + LAYOUT_CSS + VETRO_CSS + SPENTE_CSS;

const hex = (v: string | undefined): string =>
  typeof v === "string" && /^#[0-9a-fA-F]{6}$/.test(v) ? v : "";

// I tag <meta name="theme-color"> e <link rel="icon"> sono dichiarati piu' in
// alto nel <head>, quindi qui esistono gia': un micro script inline (sincrono,
// pre-paint) li riallinea. Nessun localStorage, nessuna rete: i valori sono
// gia' scritti dentro lo script dal server.
const bg = hex(boot.theme.bg);
// Dati anti-flash passati come JSON (blocco dati, non eseguito → fuori da CSP);
// lo script statico qui sotto li legge e li applica pre-paint. Statico = un solo
// nonce per-richiesta lo copre (come AdminNav), niente set:html dinamico.
const flash = { glass: boot.theme.glass === "on", bg: bg || null, logo: boot.logo || null };
const flashJson = flash.glass || flash.bg || flash.logo ? JSON.stringify(flash).replace(/</g, "\\u003c") : "";
// ⚠️ Astro 7 (compilatore Rust): il binding `Astro` dentro il componente viene
// creato SOLO se il frontmatter lo nomina. Usarlo unicamente nel template
// (nonce={Astro.locals.cspNonce}) compilava in un riferimento a una variabile
// mai dichiarata → «Astro is not defined» a runtime. Leggerlo qui e' la forma
// sicura: vale per QUALSIASI uso di Astro nel solo template.
const nonce = Astro.locals.cspNonce;
---

{/* is:inline = Astro NON tocca il tag: resta esattamente qui, in fondo
    al <head>, dopo i :root della pagina => vince nella cascata. */}
{css && <style is:inline set:html={css} />}
{flashJson && <script type="application/json" id="mdd-flash" is:inline set:html={flashJson} />}
{flashJson && (
  <script is:inline nonce={nonce}>
    (function () {
      var d = document;
      try {
        var el = d.getElementById("mdd-flash");
        if (!el) return;
        var b = JSON.parse(el.textContent || "{}");
        if (b.glass) d.documentElement.classList.add("glass");
        if (b.bg) { var m = d.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute("content", b.bg); }
        if (b.logo) d.querySelectorAll('link[rel~="icon"]').forEach(function (l) { l.setAttribute("href", b.logo); });
      } catch (e) { /* niente flash: la pagina resta col tema di default */ }
    })();
  </script>
)}
{/* Installazione PWA. Il manifest sta QUI, non nelle singole pagine: era
    ripetuto identico in 12 file, e ora il suo contenuto dipende da una scelta
    del super admin (icona RestoHub o del cliente) che va letta a runtime.
    L'icona iOS e il nome vanno dichiarati a parte: iOS IGNORA il manifest per
    queste due cose, quindi non basta cambiare il manifest. */}
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="apple-touch-icon" href={marchioCliente ? boot.appIcon! : "/restohub/apple-touch-icon.png"} />
<meta name="apple-mobile-web-app-title" content={marchioCliente ? CLIENT.nome : "RestoHub"} />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
{/* I font del pannello: Fonts.astro dichiara tutte le famiglie e decide
    da solo cosa precaricare. */}
<Fonts />
