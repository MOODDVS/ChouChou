      <path d="M3 11.5 12 4l9 7.5" />
      <path d="M5 10v9h14v-9" />
    </svg>
    <span>{t("nav.s.home")}</span>
  </a>
  <a href="/admin/orders" data-page="orders" class={current === "orders" ? "active" : ""} aria-label={t("nav.orders")}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 2 4 6v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6l-2-4Z" />
      <path d="M4 6h16" />
      <path d="M9 10a3 3 0 0 0 6 0" />
    </svg>
    <span>{t("nav.s.orders")}</span>
    <span class="nav-badge" data-badge="orders" hidden></span>
  </a>
  <a href="/admin/reservations" data-page="reservations" class={current === "reservations" ? "active" : ""} aria-label={t("nav.reservations")}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="4" width="18" height="17" rx="2" />
      <line x1="16" y1="2" x2="16" y2="6" />
      <line x1="8" y1="2" x2="8" y2="6" />
      <line x1="3" y1="10" x2="21" y2="10" />
      <polyline points="9 15 11 17 15 13" />
    </svg>
    <span>{t("nav.s.reservations")}</span>
    <span class="nav-badge" data-badge="reservations" hidden></span>
  </a>
  <a href="/admin/clients" data-page="clients" class={current === "clients" ? "active" : ""} aria-label={t("nav.clients")}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
    </svg>
    <span>{t("nav.s.clients")}</span>
  </a>
  <a href="/admin/menu" data-page="menu" class={current === "menu" ? "active" : ""} aria-label={t("nav.menu")}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
    </svg>
    <span>{t("nav.s.menu")}</span>
  </a>
  <a href="/admin/stats" data-page="stats" class={current === "stats" ? "active" : ""} aria-label={t("nav.stats")}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <line x1="18" y1="20" x2="18" y2="10" />
      <line x1="12" y1="20" x2="12" y2="4" />
      <line x1="6" y1="20" x2="6" y2="14" />
    </svg>
    <span>{t("nav.s.stats")}</span>
  </a>
  <a href="/admin/marketing" data-page="marketing" class={current === "marketing" ? "active" : ""} aria-label={t("nav.marketing")}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 11v3" />
      <path d="M7 9v7" />
      <path d="M7 9l10-5v16l-10-5" />
      <path d="M17 8.5a4 4 0 0 1 0 7" />
      <path d="M9.5 16.5 11 21" />
    </svg>
    <span>{t("nav.s.marketing")}</span>
  </a>
  <a href="/admin/assets" data-page="assets" class={current === "assets" ? "active" : ""} aria-label={t("nav.assets")}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </svg>
    <span>{t("nav.s.assets")}</span>
  </a>
  <a href="/admin/settings" data-page="settings" class={current === "settings" ? "active" : ""} aria-label={t("nav.settings")}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <line x1="4" y1="21" x2="4" y2="14" />
      <line x1="4" y1="10" x2="4" y2="3" />
      <line x1="12" y1="21" x2="12" y2="12" />
      <line x1="12" y1="8" x2="12" y2="3" />
      <line x1="20" y1="21" x2="20" y2="16" />
      <line x1="20" y1="12" x2="20" y2="3" />
      <line x1="1" y1="14" x2="7" y2="14" />
      <line x1="9" y1="8" x2="15" y2="8" />
      <line x1="17" y1="16" x2="23" y2="16" />
    </svg>
    <span>{t("nav.s.settings")}</span>
  </a>
</nav>

<!-- Bottone SUPER ADMIN (solo admin@moodd.online): isola separata a sinistra -->
<a href="/admin/super" class={"admin-super" + (current === "super" ? " active" : "")} id="admin-nav-super" aria-label={t("nav.super")} style="display:none">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3" />
    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
  </svg>
  <span>{t("nav.s.super")}</span>
</a>

<!-- ANTI-FLASH permessi: script SINCRONO (gira prima del primo paint).
     Con cache dei permessi dell'ULTIMO utente visto su questo browser:
     nasconde subito le voci vietate (nav + tile). Senza cache (primo login):
     nav invisibile finché lo script asincrono non ha la lista vera. Il tag
     <style id="nav-permessi"> viene rimosso dallo script asincrono. -->
<script is:inline>
  (() => {
    try {
      // Email dell'utente corrente: sessione Supabase in localStorage (sync)
      let email = "";
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i) || "";
        if (/^sb-.*-auth-token$/.test(k)) {
          const v = JSON.parse(localStorage.getItem(k) || "null");
          email = (v && (v.user?.email || v.currentSession?.user?.email)) || "";
          break;
        }
      }
      const raw = localStorage.getItem("mdd_nav_hidden");
      const cache = raw ? JSON.parse(raw) : null;
      const st = document.createElement("style");
      st.id = "nav-permessi";
      if (cache && email && cache.email === email) {
        // CSS da pagine vietate (nav + tile) E tab vietati (pillole + sezioni)
        const ok = (x) => /^[a-z]+$/.test(String(x));
        const sel = [];
        for (const k of Array.isArray(cache.hidden) ? cache.hidden : []) {
          if (ok(k)) sel.push(`.admin-nav a[data-page="${k}"]`, `[data-admin-page="${k}"]`);
        }
        for (const t of Array.isArray(cache.hiddenTabs) ? cache.hiddenTabs : []) {
          const [p, k] = String(t).split(":");
          if (!ok(p) || !ok(k)) continue;
          if (p === "marketing") sel.push(`#mtabs .mtab[data-tab="${k}"]`);
          if (p === "settings") sel.push(`#tabs button[data-t="${k}"]`, `#content .section[data-tab="${k}"]`);
          if (p === "menu") sel.push(`#k-filtri .kf-pill[data-kind="${k}"]`);
        }
        if (sel.length) st.textContent = sel.join(", ") + " { display: none !important; }";
      } else {
        // Primo accesso su questo browser: meglio nav e barre tab invisibili
        // un attimo che mostrare voci vietate
        st.textContent = ".admin-nav, #mtabs, #tabs, #k-filtri { visibility: hidden; }";
      }
      document.head.appendChild(st);
    } catch { /* niente cache: la nav resta visibile */ }

    // --- TEMA brand (Reglages -> Couleurs): applica la cache PRIMA del paint.
    // La cache e' per-installazione (non per utente): stessi colori per tutti.
    try {
      const t = JSON.parse(localStorage.getItem("mdd_theme") || "null");
      if (t && typeof t === "object") {
        for (const k in t) {
          if (/^[a-z]+$/.test(k) && /^#[0-9a-f]{6}$/i.test(String(t[k]))) {
            document.documentElement.style.setProperty("--c-" + k, t[k]);
          }
        }
        if (/^#[0-9a-f]{6}$/i.test(String(t.bg))) {
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", t.bg);
        }
        document.documentElement.classList.toggle("glass", t.glass === "on");
        if (/^\d{1,3}$/.test(String(t.shadow))) {
          document.documentElement.style.setProperty("--sh", String(Math.min(100, Number(t.shadow)) / 100));
        }
      }
    } catch { /* niente tema in cache */ }

    // --- Logo brand (favicon caricata in Admin -> General): dalla cache,
    // PRIMA del paint, sull'header e sulla favicon del tab.
    try {
      const u = localStorage.getItem("mdd_logo") || "";
      if (/^https:\/\//.test(u) || u.startsWith("/")) {
        const img = document.getElementById("ah-logo");
        if (img) img.src = u;
        document.querySelectorAll('link[rel~="icon"]').forEach((l) => { l.href = u; });
      }
    } catch { /* niente logo in cache */ }
  })();
</script>

<style is:global>
  /* Effet verre (Reglages -> Design): di DEFAULT le superfici sono opache;
     html.glass (tema glass:"on") riattiva trasparenze e blur. */
  html.glass .admin-nav,
  html.glass .admin-super:not(.active) {
    background: color-mix(in srgb, var(--c-card) 82%, transparent);
    backdrop-filter: blur(26px) saturate(150%);
    -webkit-backdrop-filter: blur(26px) saturate(150%);
  }

  /* "+" dei bottoni flottanti (Résa, Commande, Client, Plat): più grande
     del testo, senza allargare il bottone. */
  .fab-plus {
    font-size: 1.45em;
    line-height: 1;
    margin-right: 0.32rem;
    font-weight: 400;
    transform: translateY(0.02em);
    display: inline-block;
  }

  .admin-nav {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.25rem;
    padding: 0.35rem;
    z-index: 100;

    /* Pillola */
    border-radius: 999px;

    /* Liquid glass */
    background: var(--c-card);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, calc(0.55 * var(--sh, 0.15))),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .admin-nav a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.18rem;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.56rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--c-muted, var(--c-muted));
    text-decoration: none;
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    transition: background 0.2s, color 0.2s;
  }
  .admin-nav a svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .admin-nav a:hover {
    color: var(--c-text, #fff);
  }
  .admin-nav a.active {
    background: var(--c-accent, var(--c-accent));
    color: var(--c-bg);
  }

  /* Pallino rosso "non visti" su Commandes / Réservations */
  .admin-nav a .nav-badge {
    position: absolute;
    top: 1px;
    right: 6px;
    min-width: 15px;
    height: 15px;
    padding: 0 4px;
    box-sizing: border-box;
    border-radius: 999px;
    background: #e2483d;
    color: #fff;
    font-size: 0.54rem;
    font-weight: 800;
    line-height: 15px;
    text-align: center;
    letter-spacing: 0;
    box-shadow: 0 0 0 2px var(--c-card);
    pointer-events: none;
  }
  .admin-nav a .nav-badge[hidden] { display: none; }

  /* --- Isola separata del super admin (ingranaggio, a sinistra) --- */
  /* MOBILE : la page Réglages (super admin) est pensée pour le bureau —
     on cache son bouton ; l'accès direct par URL reste possible. */
  @media (max-width: 560px) {
    .admin-super { display: none !important; }
  }

  .admin-super {
    position: fixed;
    bottom: 1.25rem;
    left: 1rem;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.18rem;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.56rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--c-muted, var(--c-muted));
    text-decoration: none;
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    background: var(--c-card);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, calc(0.55 * var(--sh, 0.15))),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition: color 0.2s, background 0.2s;
  }
  .admin-super svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .admin-super:hover { color: var(--c-text, #fff); }
  .admin-super.active { background: var(--c-accent, var(--c-accent)); color: var(--c-bg); }

  @media (max-width: 520px) {
    /* Icone a grandezza normale + SCROLL laterale dentro l'isola.
       La voce attiva viene riportata in vista dallo script (scrollIntoView). */
    .admin-nav {
      left: 1rem;
      right: 1rem;
      transform: none;
      justify-content: flex-start;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      scroll-behavior: smooth;
    }
    .admin-nav::-webkit-scrollbar { display: none; }
    .admin-nav a {
      flex: 0 0 auto;
      padding: 0.42rem 0.85rem;
    }
    /* su mobile la barra occupa tutta la larghezza: l'ingranaggio sale sopra */
    .admin-super { bottom: calc(1.25rem + 72px); }
  }

  /* --- Toast globale "Nouvelle réservation / commande" (poller) --- */
  /* Fondo ORO, testo MARRONE, più alto: titolo + dettagli su due righe. */
  .mn-toast {
    position: fixed; left: 50%; bottom: 5.5rem; transform: translateX(-50%) translateY(160%);
    display: flex; align-items: center; gap: 1.1rem; max-width: 94vw; min-width: 340px; min-height: 92px;
    background: linear-gradient(135deg, #eec063 0%, var(--c-accent) 52%, #d09a3b 100%);
    border: 1.5px solid #b9822b; color: #3a2b1c;
    font-family: var(--font-body, system-ui, sans-serif); line-height: 1.25;
    padding: 1.25rem 1.6rem; border-radius: 20px; cursor: pointer; z-index: 500;
    opacity: 0; pointer-events: none;
    transition: opacity 0.35s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 18px 50px rgba(0, 0, 0, calc(0.55 * var(--sh, 0.15)));
  }
  .mn-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); pointer-events: auto; }
  .mn-ico { flex-shrink: 0; width: 52px; height: 52px; border-radius: 50%;
    background: rgba(58, 43, 28, 0.14); display: flex; align-items: center; justify-content: center; }
  .mn-toast svg { width: 30px; height: 30px; fill: none; stroke: #4a3418; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .mn-txt { display: flex; flex-direction: column; gap: 0.18rem; min-width: 0; }
  .mn-txt strong { color: #2c2013; font-weight: 800; font-size: 1.18rem; letter-spacing: 0.01em; }
  .mn-txt .det { color: #5a4327; font-weight: 600; font-size: 1rem; }
  .mn-toast .mn-toast-x { margin-left: auto; padding-left: 0.6rem; color: #7a5f38; font-size: 1.6rem; line-height: 1; align-self: center; }
  .mn-toast.is-cancel { border-color: #a5401f; }
  .mn-toast.is-cancel svg { stroke: #9a3418; }
  .mn-toast.is-cancel .mn-ico { background: rgba(150, 45, 20, 0.16); }
  .mn-toast.is-cancel strong { color: #8f2e15; }
  @media (max-width: 520px) { .mn-toast { bottom: calc(1.25rem + 138px); min-width: 0; width: 92vw; padding: 1.05rem 1.25rem; } }
</style>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { isSuperUser, TEMA_CHIAVI } from "../../lib/admin/superAdmin";

  // Visibilità delle pagine admin:
  // - super admin (MOODD): vede tutto + il bottone ingranaggio
  // - altri utenti: le pagine nascoste spariscono dalla barra e dai tile,
  //   e l'accesso diretto a una pagina nascosta rimanda all'Accueil.
  (async () => {
    // "svela": toglie lo <style id="nav-permessi"> messo dallo script inline
    // anti-flash (cache o nav invisibile) — da chiamare a OGNI uscita.
    const svela = () => document.getElementById("nav-permessi")?.remove();
    const nav = document.querySelector(".admin-nav[data-current]") as HTMLElement | null;
    if (!nav) { svela(); return; }
    const { data } = await supabaseBrowser.auth.getSession();
    const token = data.session?.access_token ?? "";
    const email = data.session?.user?.email ?? "";
    if (!token) { svela(); return; }
    const current = nav.dataset.current ?? "";
    // Cache permessi per l'anti-flash del PROSSIMO caricamento (per utente)
    const salvaCache = (hidden: string[], hiddenTabs: string[]) => {
      try { localStorage.setItem("mdd_nav_hidden", JSON.stringify({ email, hidden, hiddenTabs })); } catch { /* storage pieno */ }
    };
    // CSS finale dei permessi (stesse regole dello script inline): resta nel
    // <style id="nav-permessi"> così le pillole tab sono nascoste PRIMA che
    // gli script di pagina (marketing/settings) le rimuovano davvero.
    const cssPermessi = (hidden: string[], hiddenTabs: string[]): string => {
      const ok = (x: string) => /^[a-z]+$/.test(x);
      const sel: string[] = [];
      for (const k of hidden) if (ok(k)) sel.push(`.admin-nav a[data-page="${k}"]`, `[data-admin-page="${k}"]`);
      for (const t of hiddenTabs) {
        const [p, k] = String(t).split(":");
        if (!p || !k || !ok(p) || !ok(k)) continue;
        if (p === "marketing") sel.push(`#mtabs .mtab[data-tab="${k}"]`);
        if (p === "settings") sel.push(`#tabs button[data-t="${k}"]`, `#content .section[data-tab="${k}"]`);
        if (p === "menu") sel.push(`#k-filtri .kf-pill[data-kind="${k}"]`);
      }
      return sel.length ? sel.join(", ") + " { display: none !important; }" : "";
    };
    // TEMA brand: applica i colori veri (inline sul <html> => vince sui
    // :root delle pagine), aggiorna theme-color e salva la cache anti-flash.
    const applicaTema = (t: Record<string, string> | undefined) => {
      const tema = t && typeof t === "object" ? t : {};
      const root = document.documentElement;
      for (const k of TEMA_CHIAVI) {
        const v = tema[k];
        if (typeof v === "string" && /^#[0-9a-f]{6}$/i.test(v)) root.style.setProperty("--c-" + k, v);
        else root.style.removeProperty("--c-" + k); // default della pagina
      }
      const bg = typeof tema.bg === "string" && /^#[0-9a-f]{6}$/i.test(tema.bg) ? tema.bg : "#ffffff";
      document.querySelector('meta[name="theme-color"]')?.setAttribute("content", bg);
      root.classList.toggle("glass", tema.glass === "on");
      if (/^\d{1,3}$/.test(String(tema.shadow))) {
        root.style.setProperty("--sh", String(Math.min(100, Number(tema.shadow)) / 100));
      } else {
        root.style.removeProperty("--sh");
      }
      try { localStorage.setItem("mdd_theme", JSON.stringify(tema)); } catch { /* storage pieno */ }
    };
    // Logo brand nell'header (+ favicon del tab): brand_favicon se caricata,
    // altrimenti si torna al logo di default del client.
    const applicaLogo = (u: string | null | undefined) => {
      const img = document.getElementById("ah-logo") as HTMLImageElement | null;
      const ok = typeof u === "string" && (/^https:\/\//.test(u) || u.startsWith("/"));
      if (ok) {
        if (img) img.src = u as string;
        document.querySelectorAll('link[rel~="icon"]').forEach((l) => l.setAttribute("href", u as string));
        try { localStorage.setItem("mdd_logo", u as string); } catch { /* pieno */ }
      } else {
        if (img && img.dataset.default) img.src = img.dataset.default;
        try { localStorage.removeItem("mdd_logo"); } catch { /* niente */ }
      }
    };
    const applicaStile = (css: string) => {
      let st = document.getElementById("nav-permessi") as HTMLStyleElement | null;
      if (!css) { st?.remove(); return; }
      if (!st) {
        st = document.createElement("style");
        st.id = "nav-permessi";
        document.head.appendChild(st);
      }
      st.textContent = css;
    };

    if (isSuperUser(data.session?.user)) {
      const sup = document.getElementById("admin-nav-super");
      if (sup && !window.matchMedia("(max-width: 560px)").matches) {
        sup.style.display = "flex";
        posizionaSuper();
      }
      salvaCache([], []);
      svela();
      // Anche il super riceve il tema del cliente (fetch in background)
      fetch("/api/admin/pages", { headers: { Authorization: `Bearer ${token}` } })
        .then((r) => (r.ok ? r.json() : null))
        .then((j) => {
          if (!j) return;
          const jj = j as { theme?: Record<string, string>; logo?: string | null };
          applicaTema(jj.theme);
          applicaLogo(jj.logo);
        })
        .catch(() => { /* rete assente */ });
      return; // il super vede tutto
    }
    if (current === "super") {
      window.location.replace("/admin");
      return;
    }

    try {
      const res = await fetch("/api/admin/pages", {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (!res.ok) { svela(); return; }
      const j = (await res.json()) as { hidden: string[]; hiddenTabs?: string[]; theme?: Record<string, string>; logo?: string | null };
      const hidden = j.hidden ?? [];
      const hiddenTabs = j.hiddenTabs ?? [];
      salvaCache(hidden, hiddenTabs);
      applicaTema(j.theme);
      applicaLogo(j.logo);

      for (const k of hidden) {
        nav.querySelector(`a[data-page="${k}"]`)?.remove();
        document.querySelectorAll(`[data-admin-page="${k}"]`).forEach((el) => el.remove());
      }
      // Stile PERSISTENTE coi permessi veri: sostituisce quello dell'inline
      // (che poteva essere "nav invisibile" al primo accesso) e tiene coperte
      // le pillole tab finché gli script di pagina non le tolgono dal DOM.
      applicaStile(cssPermessi(hidden, hiddenTabs));
      if (hidden.includes(current)) window.location.replace("/admin");
    } catch {
      // rete assente: non si blocca l'admin
      svela();
    }
  })();

  // --- Ingranaggio Admin: accanto all'isola dei link, stessa altezza (ogni pagina) ---
  function posizionaSuper() {
    const barra = document.querySelector(".admin-nav") as HTMLElement | null;
    const sup = document.getElementById("admin-nav-super") as HTMLElement | null;
    if (!barra || !sup || sup.style.display === "none") return;
    if (!window.matchMedia("(min-width: 521px)").matches) {
      // mobile: la barra occupa tutta la larghezza → resta la regola CSS (sopra la barra)
      sup.style.left = "";
      sup.style.bottom = "";
      sup.style.height = "";
      return;
    }
    const r = barra.getBoundingClientRect();
    sup.style.height = `${r.height}px`;
    sup.style.boxSizing = "border-box";
    sup.style.justifyContent = "center";
    const g = sup.getBoundingClientRect();
    sup.style.left = `${Math.max(8, r.left - g.width - 12)}px`;
    sup.style.bottom = `${window.innerHeight - r.bottom}px`;
  }
  window.addEventListener("resize", posizionaSuper);

  // --- Poller globale: toast "Nouvelle réservation" su OGNI pagina admin ---
  // Ogni ~20s chiede le prenotazioni PUBBLICHE (web/google) create dopo l'ultimo
  // controllo; mostra un toast cliccabile e notifica la pagina Réservations
  // (evento moodd:new-resa) perché ricarichi la lista se è il giorno mostrato.
  (async () => {
    const { data } = await supabaseBrowser.auth.getSession();
    const token = data.session?.access_token ?? "";
    if (!token) return;
    const headers = { Authorization: `Bearer ${token}` };

    const tEl = document.createElement("div");
    tEl.className = "mn-toast";
    tEl.setAttribute("role", "status");
    document.body.appendChild(tEl);

    // Suono campana. I browser bloccano l'audio finché l'utente non interagisce:
    // al primo click/tasto lo "sblocchiamo" (play+pause muto) così poi parte.
    const bell = new Audio("/sounds/nouvelle-resa.mp3");     // prenotazione (1 rintocco)
    bell.preload = "auto";
    bell.volume = 0.55;
    const beepOrder = new Audio("/sounds/nouvelle-commande.mp3"); // ordine (beep ×3)
    beepOrder.preload = "auto";
    beepOrder.volume = 0.6;
    let audioPronto = false;
    // Sblocco audio: iOS NON rispetta `volume` da JavaScript (solo i tasti
    // fisici), quindi il vecchio trucco "volume 0 + play" faceva suonare le
    // notifiche a ogni cambio pagina. `muted` invece è rispettato ovunque.
    // Lo sblocco vale per tutta la sessione: niente ripetizioni ad ogni pagina.
    function sbloccaAudio() {
      if (audioPronto) return;
      audioPronto = true;
      try { sessionStorage.setItem("mdd_audio_ok", "1"); } catch { /* privato */ }
      for (const a of [bell, beepOrder]) {
        a.muted = true;
        a.play()
          .then(() => { a.pause(); a.currentTime = 0; a.muted = false; })
          .catch(() => { a.muted = false; });
      }
      window.removeEventListener("pointerdown", sbloccaAudio);
      window.removeEventListener("keydown", sbloccaAudio);
    }
    try {
      // Già sbloccato in questa sessione: non rifare il play muto
      if (sessionStorage.getItem("mdd_audio_ok") === "1") audioPronto = true;
    } catch { /* niente sessionStorage */ }
    window.addEventListener("pointerdown", sbloccaAudio);
    window.addEventListener("keydown", sbloccaAudio);
    function suona(a: HTMLAudioElement) {
      try { a.currentTime = 0; void a.play().catch(() => {}); } catch { /* ignora */ }
    }

    let since = new Date().toISOString();
    // Ordini: NON usiamo l'orario di creazione (un ordine nasce 'pending' e
    // diventa 'paid' dopo, col webhook → il segnalibro temporale lo mancava).
    // Teniamo invece l'insieme degli ID già pagati e avvisiamo sui NUOVI.
    const ordiniVisti = new Set<string>();
    let baselineOrdini = false;
    let lastDate = "";
    let lastHref = "/admin/reservations";
    let tTimer: number | undefined;

    const esc = (s: string) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    const jjmm = (iso: string) => { const p = iso.split("-"); return `${p[2]}/${p[1]}`; };
    const euro = (c: number) => (Math.round(Number(c)) / 100).toFixed(2).replace(".", ",") + " €";

    tEl.addEventListener("click", () => { window.location.href = lastHref; });

    function mostra(eventi: { tipo: string; r: any }[]) {
      const n = eventi.length;
      const last = eventi[n - 1];
      const r = last.r;
      lastDate = r.date;
      lastHref = "/admin/reservations" + (lastDate ? "?date=" + lastDate : "");
      const nome = String(r.first_name || r.last_name || "").trim();
      const label = last.tipo === "cancelled" ? "Réservation annulée"
        : last.tipo === "modified" ? "Réservation modifiée"
        : "Nouvelle réservation";
      const titolo = n === 1 ? label : `${n} mises à jour`;
      const dettaglio = n === 1
        ? `${esc(nome)} · ${jjmm(r.date)} ${esc(r.heure)} · ${r.people} pers.`
        : "";
      tEl.classList.toggle("is-cancel", n === 1 && last.tipo === "cancelled");
      const icoResa = `<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="9 15 11 17 15 13"/></svg>`;
      tEl.innerHTML = `<span class="mn-ico">${icoResa}</span><span class="mn-txt"><strong>${titolo}</strong>${dettaglio ? `<span class="det">${dettaglio}</span>` : ""}</span><span class="mn-toast-x">›</span>`;
      tEl.classList.add("show");
      window.clearTimeout(tTimer);
      tTimer = window.setTimeout(() => tEl.classList.remove("show"), 5000);
    }

    async function poll() {
      try {
        const res = await fetch("/api/admin/reservations?new_since=" + encodeURIComponent(since), { headers });
        if (!res.ok) return;
        const j = (await res.json()) as { news?: any[]; changes?: any[]; now?: string };
        if (j.now) since = j.now;
        const news = j.news ?? [];
        const changes = j.changes ?? [];
        const eventi = [
          ...news.map((r: any) => ({ tipo: "new", r })),
          ...changes.map((r: any) => ({ tipo: r.kind as string, r })),
        ];
        if (!eventi.length) return;
        mostra(eventi);
        if (news.length) suona(bell); // campana solo per una NUOVA prenotazione
        for (const ev of eventi) window.dispatchEvent(new CustomEvent("moodd:new-resa", { detail: ev.r }));
      } catch {
        // rete assente: nessun blocco
      }
    }

    // --- Ordini dal sito: toast "Nouvelle commande" + beep ×3 ---
    function mostraOrdine(ordini: any[]) {
      const n = ordini.length;
      const o = ordini[n - 1];
      lastHref = "/admin/orders";
      const nome = String(o.customer_name || "").trim();
      const titolo = n === 1 ? "Nouvelle commande" : `${n} nouvelles commandes`;
      const dettaglio = n === 1 ? `${esc(nome)} · ${euro(o.total_cents)}` : "";
      tEl.classList.remove("is-cancel");
      const icoCmd = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 4 6v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6l-2-4Z"/><path d="M4 6h16"/><path d="M9 10a3 3 0 0 0 6 0"/></svg>`;
      tEl.innerHTML = `<span class="mn-ico">${icoCmd}</span><span class="mn-txt"><strong>${titolo}</strong>${dettaglio ? `<span class="det">${dettaglio}</span>` : ""}</span><span class="mn-toast-x">›</span>`;
      tEl.classList.add("show");
      window.clearTimeout(tTimer);
      tTimer = window.setTimeout(() => tEl.classList.remove("show"), 5000);
    }
    async function pollOrdini() {
      try {
        const res = await fetch("/api/admin/orders?recent_paid=1", { headers });
        if (!res.ok) return;
        const j = (await res.json()) as { orders?: any[] };
        const ordini = (j.orders ?? []) as any[];

        // Primo giro: registra gli ordini GIÀ pagati come "visti", senza avvisare.
        if (!baselineOrdini) {
          for (const o of ordini) ordiniVisti.add(o.id);
          baselineOrdini = true;
          return;
        }

        const nuovi = ordini.filter((o) => !ordiniVisti.has(o.id));
        for (const o of ordini) ordiniVisti.add(o.id);
        // Tiene l'insieme limitato: se cresce troppo, lo ricostruisce dai recenti.
        if (ordiniVisti.size > 500) {
          ordiniVisti.clear();
          for (const o of ordini) ordiniVisti.add(o.id);
        }
        if (!nuovi.length) return;

        mostraOrdine(nuovi);
        suona(beepOrder); // beep del controller ×3
        for (const o of nuovi) window.dispatchEvent(new CustomEvent("moodd:new-order", { detail: o }));
      } catch {
        // rete assente: nessun blocco
      }
    }

    pollOrdini(); // baseline immediata: registra i pagati già presenti al load

    // Mobile: l'isola scorre in orizzontale → la pagina ATTIVA va portata in vista
    if (window.matchMedia("(max-width: 520px)").matches) {
      const nav = document.querySelector(".admin-nav") as HTMLElement | null;
      const attivo = nav?.querySelector("a.active") as HTMLElement | null;
      if (nav && attivo) nav.scrollLeft = attivo.offsetLeft - (nav.clientWidth - attivo.offsetWidth) / 2;
    }
    window.setInterval(poll, 20000);
    window.setInterval(pollOrdini, 20000);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") { poll(); pollOrdini(); }
    });
  })();

  // --- Pallini "non visti" su Commandes / Réservations (+ badge PWA) ---
  // Conteggio lato server dei nuovi dall'ultima volta che si è aperta la
  // sezione (per-dispositivo, in localStorage). Aggiornato dal vivo tramite
  // gli eventi del poller. setAppBadge aggiorna l'icona dell'app installata.
  (async () => {
    const { data } = await supabaseBrowser.auth.getSession();
    const token = data.session?.access_token ?? "";
    if (!token) return;
    const headers = { Authorization: `Bearer ${token}` };
    const navEl = document.querySelector(".admin-nav[data-current]") as HTMLElement | null;
    const current = navEl?.dataset.current ?? "";
    let bResa = 0;
    let bCmd = 0;

    const setBadge = (page: string, n: number) => {
      const el = document.querySelector(`.admin-nav a[data-page="${page}"] .nav-badge`) as HTMLElement | null;
      if (!el) return;
      if (n > 0) { el.textContent = n > 99 ? "99+" : String(n); el.removeAttribute("hidden"); }
      else { el.setAttribute("hidden", ""); }
    };
    const render = () => {
      setBadge("reservations", bResa);
      setBadge("orders", bCmd);
      const tot = bResa + bCmd;
      try {
        const n = navigator as Navigator & { setAppBadge?: (n?: number) => Promise<void>; clearAppBadge?: () => Promise<void> };
        if (tot > 0 && typeof n.setAppBadge === "function") void n.setAppBadge(tot);
        else if (typeof n.clearAppBadge === "function") void n.clearAppBadge();
      } catch { /* Badging API assente */ }
    };
    const ls = {
      get(k: string): string { try { return localStorage.getItem(k) ?? ""; } catch { return ""; } },
      set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* pieno */ } },
    };
    const now0 = new Date().toISOString();

    // Réservations: segnalibro temporale (created_at affidabile alla nascita)
    if (current === "reservations") {
      ls.set("mdd_resa_seen_at", now0);
    } else {
      const seenAt = ls.get("mdd_resa_seen_at");
      if (!seenAt) {
        ls.set("mdd_resa_seen_at", now0); // primo giro: baseline a zero
      } else {
        try {
          const r = await fetch("/api/admin/reservations?new_since=" + encodeURIComponent(seenAt), { headers });
          if (r.ok) {
            const j = (await r.json()) as { news?: unknown[]; changes?: unknown[] };
            bResa = (j.news?.length ?? 0) + (j.changes?.length ?? 0);
          }
        } catch { /* rete assente */ }
      }
    }

    // Commandes: per-ID (un ordine nasce pending e diventa paid dopo → il
    // confronto temporale mancherebbe la transizione). Set degli ID già visti.
    try {
      const r = await fetch("/api/admin/orders?recent_paid=1", { headers });
      if (r.ok) {
        const j = (await r.json()) as { orders?: { id: string }[] };
        const ids = (j.orders ?? []).map((o) => o.id);
        const raw = ls.get("mdd_cmd_seen_ids");
        let seen: Set<string> | null = null;
        if (raw) { try { seen = new Set(JSON.parse(raw) as string[]); } catch { seen = null; } }
        if (current === "orders" || seen === null) {
          ls.set("mdd_cmd_seen_ids", JSON.stringify(ids.slice(-800)));
          bCmd = 0;
        } else {
          bCmd = ids.filter((id) => !seen!.has(id)).length;
        }
      }
    } catch { /* rete assente */ }

    render();

    // Aggiornamento dal vivo (eventi dispatchati dal poller qui sopra)
    window.addEventListener("moodd:new-resa", () => {
      if (current === "reservations") { ls.set("mdd_resa_seen_at", new Date().toISOString()); return; }
      bResa += 1;
      render();
    });
    window.addEventListener("moodd:new-order", (e: Event) => {
      const id = (e as CustomEvent<{ id?: string }>).detail?.id;
      if (current === "orders") {
        if (id) {
          try {
            const s2 = new Set<string>(JSON.parse(ls.get("mdd_cmd_seen_ids") || "[]") as string[]);
            s2.add(id);
            ls.set("mdd_cmd_seen_ids", JSON.stringify([...s2].slice(-800)));
          } catch { /* pieno */ }
        }
        return;
      }
      bCmd += 1;
      render();
    });
  })();
</script>
