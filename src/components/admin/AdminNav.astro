---
// Floating navigation bar condivisa per le pagine admin.
// Stile: pillola "liquid glass", ogni voce con icona sopra e label piccola sotto.
// Visibile su tutti i dispositivi (fissa in basso, centrata).
interface Props {
  current?: "home" | "orders" | "clients" | "menu" | "stats" | "marketing" | "settings";
}
const { current } = Astro.props;
---

<nav class="admin-nav" aria-label="Navigation admin">
  <a href="/admin" class={current === "home" ? "active" : ""} aria-label="Accueil">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 11.5 12 4l9 7.5" />
      <path d="M5 10v9h14v-9" />
    </svg>
    <span>Accu.</span>
  </a>
  <a href="/admin/orders" class={current === "orders" ? "active" : ""} aria-label="Commandes">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 2 4 6v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6l-2-4Z" />
      <path d="M4 6h16" />
      <path d="M9 10a3 3 0 0 0 6 0" />
    </svg>
    <span>Comm.</span>
  </a>
  <a href="/admin/clients" class={current === "clients" ? "active" : ""} aria-label="Clients">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
    </svg>
    <span>Clie.</span>
  </a>
  <a href="/admin/menu" class={current === "menu" ? "active" : ""} aria-label="Menu">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
    </svg>
    <span>Menu</span>
  </a>
  <a href="/admin/stats" class={current === "stats" ? "active" : ""} aria-label="Statistiques">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <line x1="18" y1="20" x2="18" y2="10" />
      <line x1="12" y1="20" x2="12" y2="4" />
      <line x1="6" y1="20" x2="6" y2="14" />
    </svg>
    <span>Stat.</span>
  </a>
  <a href="/admin/marketing" class={current === "marketing" ? "active" : ""} aria-label="Marketing">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 11v3" />
      <path d="M7 9v7" />
      <path d="M7 9l10-5v16l-10-5" />
      <path d="M17 8.5a4 4 0 0 1 0 7" />
      <path d="M9.5 16.5 11 21" />
    </svg>
    <span>Mark.</span>
  </a>
  <a href="/admin/settings" class={current === "settings" ? "active" : ""} aria-label="Réglages">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <line x1="4" y1="21" x2="4" y2="14" />
      <line x1="4" y1="10" x2="4" y2="3" />
      <line x1="12" y1="21" x2="12" y2="12" />
      <line x1="12" y1="8" x2="12" y2="3" />
      <line x1="20" y1="21" x2="20" y2="16" />
      <line x1="20" y1="12" x2="20" y2="3" />
      <line x1="1" y1="14" x2="7" y2="14" />
      <line x1="9" y1="8" x2="15" y2="8" />
      <line x1="17" y1="16" x2="23" y2="16" />
    </svg>
    <span>Régl.</span>
  </a>
</nav>

<style is:global>
  .admin-nav {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.25rem;
    padding: 0.35rem;
    z-index: 100;

    /* Pillola */
    border-radius: 999px;

    /* Liquid glass */
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .admin-nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.18rem;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.56rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--c-muted, #b3aca6);
    text-decoration: none;
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    transition: background 0.2s, color 0.2s;
  }
  .admin-nav a svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .admin-nav a:hover {
    color: var(--c-text, #fff);
  }
  .admin-nav a.active {
    background: var(--c-accent, #dfab4e);
    color: #231f20;
  }

  @media (max-width: 520px) {
    .admin-nav {
      left: 1rem;
      right: 1rem;
      transform: none;
      justify-content: space-around;
    }
    .admin-nav a {
      flex: 1;
      padding: 0.42rem 0.3rem;
    }
  }
</style>
