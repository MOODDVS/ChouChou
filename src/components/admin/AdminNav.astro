---
// Floating navigation bar condivisa per le pagine admin.
// Stile: pillola "liquid glass", ogni voce con icona sopra e label piccola sotto.
// Visibile su tutti i dispositivi (fissa in basso, centrata).
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";
interface Props {
  current?: "home" | "orders" | "reservations" | "clients" | "menu" | "stats" | "marketing" | "assets" | "settings" | "super";
}
const { current } = Astro.props;
const lang = await adminLang();
const t = adminT(lang);
---

<nav class="admin-nav" aria-label="Navigation admin" data-current={current ?? ""}>
