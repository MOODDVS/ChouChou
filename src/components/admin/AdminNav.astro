---
// Floating navigation bar condivisa per le pagine admin.
// Stile: pillola "liquid glass", ogni voce con icona sopra e label piccola sotto.
// Visibile su tutti i dispositivi (fissa in basso, centrata).
interface Props {
  current?: "home" | "orders" | "reservations" | "clients" | "menu" | "stats" | "marketing" | "assets" | "settings" | "super";
}
const { current } = Astro.props;
---

<nav class="admin-nav" aria-label="Navigation admin" data-current={current ?? ""}>
  <a href="/admin" class={current === "home" ? "active" : ""} aria-label="Accueil">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 11.5 12 4l9 7.5" />
      <path d="M5 10v9h14v-9" />
    </svg>
    <span>Accu.</span>
  </a>
  <a href="/admin/orders" data-page="orders" class={current === "orders" ? "active" : ""} aria-label="Commandes">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 2 4 6v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6l-2-4Z" />
      <path d="M4 6h16" />
      <path d="M9 10a3 3 0 0 0 6 0" />
    </svg>
    <span>Comm.</span>
  </a>
  <a href="/admin/reservations" data-page="reservations" class={current === "reservations" ? "active" : ""} aria-label="Réservations">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="4" width="18" height="17" rx="2" />
      <line x1="16" y1="2" x2="16" y2="6" />
      <line x1="8" y1="2" x2="8" y2="6" />
      <line x1="3" y1="10" x2="21" y2="10" />
      <polyline points="9 15 11 17 15 13" />
    </svg>
    <span>Résa.</span>
  </a>
  <a href="/admin/clients" data-page="clients" class={current === "clients" ? "active" : ""} aria-label="Clients">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
    </svg>
    <span>Clie.</span>
  </a>
  <a href="/admin/menu" data-page="menu" class={current === "menu" ? "active" : ""} aria-label="Menu">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
    </svg>
    <span>Menu</span>
  </a>
  <a href="/admin/stats" data-page="stats" class={current === "stats" ? "active" : ""} aria-label="Statistiques">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <line x1="18" y1="20" x2="18" y2="10" />
      <line x1="12" y1="20" x2="12" y2="4" />
      <line x1="6" y1="20" x2="6" y2="14" />
    </svg>
    <span>Stat.</span>
  </a>
  <a href="/admin/marketing" data-page="marketing" class={current === "marketing" ? "active" : ""} aria-label="Marketing">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 11v3" />
      <path d="M7 9v7" />
      <path d="M7 9l10-5v16l-10-5" />
      <path d="M17 8.5a4 4 0 0 1 0 7" />
      <path d="M9.5 16.5 11 21" />
    </svg>
    <span>Mark.</span>
  </a>
  <a href="/admin/assets" data-page="assets" class={current === "assets" ? "active" : ""} aria-label="Assets">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </svg>
    <span>Assets</span>
  </a>
  <a href="/admin/settings" data-page="settings" class={current === "settings" ? "active" : ""} aria-label="Réglages">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <line x1="4" y1="21" x2="4" y2="14" />
      <line x1="4" y1="10" x2="4" y2="3" />
      <line x1="12" y1="21" x2="12" y2="12" />
      <line x1="12" y1="8" x2="12" y2="3" />
      <line x1="20" y1="21" x2="20" y2="16" />
      <line x1="20" y1="12" x2="20" y2="3" />
      <line x1="1" y1="14" x2="7" y2="14" />
      <line x1="9" y1="8" x2="15" y2="8" />
      <line x1="17" y1="16" x2="23" y2="16" />
    </svg>
    <span>Régl.</span>
  </a>
</nav>

<!-- Bottone SUPER ADMIN (solo admin@moodd.online): isola separata a sinistra -->
<a href="/admin/super" class={"admin-super" + (current === "super" ? " active" : "")} id="admin-nav-super" aria-label="Admin MOODD" style="display:none">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3" />
    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
  </svg>
  <span>Admin</span>
</a>

<style is:global>
  .admin-nav {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.25rem;
    padding: 0.35rem;
    z-index: 100;

    /* Pillola */
    border-radius: 999px;

    /* Liquid glass */
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .admin-nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.18rem;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.56rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--c-muted, #b3aca6);
    text-decoration: none;
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    transition: background 0.2s, color 0.2s;
  }
  .admin-nav a svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .admin-nav a:hover {
    color: var(--c-text, #fff);
  }
  .admin-nav a.active {
    background: var(--c-accent, #dfab4e);
    color: #231f20;
  }

  /* --- Isola separata del super admin (ingranaggio, a sinistra) --- */
  .admin-super {
    position: fixed;
    bottom: 1.25rem;
    left: 1rem;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.18rem;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.56rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--c-muted, #b3aca6);
    text-decoration: none;
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition: color 0.2s, background 0.2s;
  }
  .admin-super svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .admin-super:hover { color: var(--c-text, #fff); }
  .admin-super.active { background: var(--c-accent, #dfab4e); color: #231f20; }

  @media (max-width: 520px) {
    .admin-nav {
      left: 1rem;
      right: 1rem;
      transform: none;
      justify-content: space-around;
    }
    .admin-nav a {
      flex: 1;
      padding: 0.42rem 0.3rem;
    }
    /* su mobile la barra occupa tutta la larghezza: l'ingranaggio sale sopra */
    .admin-super { bottom: calc(1.25rem + 72px); }
  }
</style>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { isSuper } from "../../lib/admin/superAdmin";

  // Visibilità delle pagine admin:
  // - super admin (MOODD): vede tutto + il bottone ingranaggio
  // - altri utenti: le pagine nascoste spariscono dalla barra e dai tile,
  //   e l'accesso diretto a una pagina nascosta rimanda all'Accueil.
  (async () => {
    const nav = document.querySelector(".admin-nav[data-current]") as HTMLElement | null;
    if (!nav) return;
    const { data } = await supabaseBrowser.auth.getSession();
    const token = data.session?.access_token ?? "";
    const email = data.session?.user?.email ?? "";
    if (!token) return;
    const current = nav.dataset.current ?? "";

    if (isSuper(email)) {
      const sup = document.getElementById("admin-nav-super");
      if (sup) sup.style.display = "flex";
      return; // il super vede tutto
    }
    if (current === "super") {
      window.location.replace("/admin");
      return;
    }

    try {
      const res = await fetch("/api/admin/pages", {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (!res.ok) return;
      const { hidden } = (await res.json()) as { hidden: string[] };
      if (!hidden.length) return;

      for (const k of hidden) {
        nav.querySelector(`a[data-page="${k}"]`)?.remove();
        document.querySelectorAll(`[data-admin-page="${k}"]`).forEach((el) => el.remove());
      }
      if (hidden.includes(current)) window.location.replace("/admin");
    } catch {
      // rete assente: non si blocca l'admin
    }
  })();
</script>
