---
// Header condiviso delle pagine admin (dashboard, ordini).
// data-tz: fuso del ristorante (app_config.timezone) esposto al client —
// orologio, data e formattazioni delle pagine admin lo leggono da qui.
import { CLIENT } from "../../config/client";
import { aggiornaTimezone } from "../../lib/slots";
import { caricaBootAdmin } from "../../lib/admin/adminBoot";
import { adminT, ADMIN_LOCALE } from "../../i18n/admin";
const TZ_RISTO = await aggiornaTimezone();
// Stessa lettura in cache di AdminHead: lingua + favicon del brand, 0 query in piu'.
const boot = await caricaBootAdmin();
const lang = boot.lang;
const t = adminT(lang);
const dateLocale = ADMIN_LOCALE[lang];
// Logo dell'header deciso dal SERVER: niente lampo del logo di default.
const logoSrc = boot.logo || CLIENT.logoAdmin;
---

<header class="ah-header" data-tz={TZ_RISTO} data-locale={dateLocale}>
  <div class="ah-left">
    <a href="/admin" class="ah-brand" aria-label={CLIENT.nome + " — Accueil"}>
      <img id="ah-logo" src={logoSrc} data-default={CLIENT.logoAdmin} alt={CLIENT.nome} />
    </a>
    <div class="ah-date">
      <svg class="ah-date-ico" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" />
        <line x1="16" y1="2" x2="16" y2="6" />
        <line x1="8" y1="2" x2="8" y2="6" />
        <line x1="3" y1="10" x2="21" y2="10" />
      </svg>
      <span class="ah-date-day" id="ah-date-day"></span>
      <span class="ah-date-rest" id="ah-date-rest"></span>
    </div>
  </div>
  <div class="ah-clock" id="ah-clock" aria-label={t("hdr.time")}>
    <svg class="ah-clock-ico" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <polyline points="12 7 12 12 15 14" />
    </svg>
    <time id="ah-clock-time">--:--:--</time>
  </div>
  <div class="ah-user">
    <span id="ah-hello" class="ah-hello" style="display:none"></span>
    <span id="user-email" class="ah-email" style="display:none"></span>
    <button id="install-btn" type="button" class="ah-logout" style="display:none" aria-label={t("hdr.install")} title={t("hdr.install")}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3v12" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="4" y1="21" x2="20" y2="21" />
      </svg>
    </button>
    <button id="fs-btn" type="button" class="ah-logout" aria-label={t("hdr.fullscreen")} title={t("hdr.fullscreen")}>
      <svg id="fs-ico-in" viewBox="0 0 24 24" aria-hidden="true">
        <polyline points="15 3 21 3 21 9" />
        <polyline points="9 21 3 21 3 15" />
        <line x1="21" y1="3" x2="14" y2="10" />
        <line x1="3" y1="21" x2="10" y2="14" />
      </svg>
      <svg id="fs-ico-out" viewBox="0 0 24 24" aria-hidden="true" style="display:none">
        <polyline points="4 14 10 14 10 20" />
        <polyline points="20 10 14 10 14 4" />
        <line x1="14" y1="10" x2="21" y2="3" />
        <line x1="3" y1="21" x2="10" y2="14" />
      </svg>
    </button>
    <button id="logout-btn" type="button" class="ah-logout" aria-label={t("hdr.logout")} title={t("hdr.logout")}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <polyline points="16 17 21 12 16 7" />
        <line x1="21" y1="12" x2="9" y2="12" />
      </svg>
    </button>
    <div id="install-hint" class="ah-inst-hint" style="display:none" role="status">{t("hdr.installHint")}</div>
  </div>
</header>

<style>
  html.glass .ah-header {
    background: color-mix(in srgb, var(--c-header, var(--c-bg)) 85%, transparent);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
  }
  .ah-header { position: sticky; top: 0; z-index: 90; display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-bottom: 1px solid var(--c-line); background: var(--c-header, var(--c-bg)); box-shadow: 0 4px 16px rgba(0, 0, 0, calc(0.35 * var(--sh, 0.15))); }
  .ah-left { display: flex; align-items: center; gap: 0.9rem; min-width: 0; }
  .ah-brand { display: flex; align-items: center; }
  .ah-brand img { width: 48px; height: 48px; display: block; border-radius: 10px; border: 1px solid var(--c-line); }
  .ah-date { display: flex; align-items: center; gap: 0.5rem; min-width: 0; font-family: var(--font-title); font-weight: 600; font-size: 1.2rem; letter-spacing: 0.05em; text-transform: uppercase; white-space: nowrap; }
  .ah-date-ico { width: 18px; height: 18px; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .ah-date-day { color: var(--c-accent); }
  .ah-date-rest { color: var(--c-text); }
  .ah-user { display: flex; align-items: center; gap: 1rem; position: relative; }
  .ah-inst-hint { position: absolute; top: calc(100% + 8px); right: 0; z-index: 100; max-width: 280px; background: var(--c-header, var(--c-bg)); border: 1px solid var(--c-line); color: var(--c-text); padding: 0.7rem 0.9rem; font-size: 0.8rem; line-height: 1.5; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); }
  /* Orologio centrato nell'header: icona oro, ora bianca */
  .ah-clock { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-title); font-weight: 600; font-size: 1.5rem; letter-spacing: 0.05em; color: var(--c-text); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ah-clock-ico { width: 20px; height: 20px; fill: none; stroke: var(--c-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .ah-email { font-size: 0.85rem; color: var(--c-muted); }
  .ah-hello { font-size: 0.92rem; color: var(--c-muted); white-space: nowrap; }
  .ah-hello strong { color: var(--c-text); font-weight: 700; }
  /* Tablet landscape: data e orologio più piccoli per stare comodi. */
  @media (min-width: 1024px) and (max-width: 1366px) {
    .ah-date { font-size: 0.95rem; }
    .ah-date-ico { width: 15px; height: 15px; }
    .ah-clock { font-size: 1.15rem; }
    .ah-clock-ico { width: 16px; height: 16px; }
  }
  /* Tablet portrait: nasconde la data (come su mobile) per non sovrapporsi all'orologio. */
  @media (min-width: 641px) and (max-width: 1023px) {
    .ah-date { display: none; }
    /* Orologio al posto della data: accanto al logo, non più centrato. */
    .ah-clock { position: static; transform: none; margin: 0 auto 0 0.9rem; }
  }
  /* Mobile (telefoni): niente data né orologio, header essenziale. */
  @media (max-width: 640px) {
    .ah-header { padding: 0.7rem 1rem; }
    .ah-brand img { width: 40px; height: 40px; }
    .ah-date { display: none; }
    .ah-clock { display: none; }
    .ah-email { display: none; }
    .ah-hello { display: none; }
  }
  .ah-logout { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; background: transparent; border: 1px solid var(--c-line); color: var(--c-text); border-radius: 0; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .ah-logout:hover { background: var(--c-accent); color: var(--c-bg); border-color: var(--c-accent); }
  .ah-logout svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
</style>

<style is:global>
  /* Il saluto è iniettato via JS (innerHTML) quindi senza l'attributo di scope
     dello style sopra: queste regole devono essere GLOBALI per applicarsi. */
  .ah-hello .ah-greet { display: inline-block; font-family: "Homemade Apple", cursive; font-weight: 400; font-size: 1.15em; line-height: 1; vertical-align: -0.04em; margin-right: 0.18em; transition: opacity 0.35s ease, transform 0.35s ease; }
  .ah-hello strong { color: #fff; font-weight: 700; }
</style>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";

  // Registra il service worker: richiesto da Chrome (Android) per
  // installare l'admin come vera app (PWA) e non semplice scorciatoia.
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("/sw.js").catch(() => {
      /* registrazione fallita: il sito funziona comunque */
    });
  }

  // ----- Bottone "Installer l'application" (PWA) -----
  // Chrome/Edge/Android/desktop: prompt nativo via beforeinstallprompt.
  // iOS Safari: nessuna API di install -> il bottone mostra le istruzioni
  //             ("Partager" -> "Sur l'écran d'accueil").
  const installBtn = document.getElementById("install-btn") as HTMLButtonElement | null;
  const installHint = document.getElementById("install-hint") as HTMLElement | null;
  let promptInstall: any = null;

  const giaInstallata =
    window.matchMedia("(display-mode: standalone)").matches ||
    (navigator as any).standalone === true;
  const nav = navigator as any;
  const isIOS =
    /iphone|ipad|ipod/i.test(nav.userAgent) ||
    (nav.platform === "MacIntel" && nav.maxTouchPoints > 1);
  const isSafari = /^((?!chrome|android|crios|fxios|edg).)*safari/i.test(nav.userAgent);

  function mostraHint(v: boolean) {
    if (installHint) installHint.style.display = v ? "" : "none";
  }

  if (installBtn && !giaInstallata) {
    // Sempre visibile finché l'app non è installata: su Chrome/Edge/Android
    // il click apre il prompt nativo (se disponibile), altrimenti (iOS, o
    // prompt non ancora pronto) mostra le istruzioni.
    installBtn.style.display = "";
    window.addEventListener("beforeinstallprompt", (e: Event) => {
      e.preventDefault();
      promptInstall = e; // prompt nativo disponibile al click
    });
  }

  window.addEventListener("appinstalled", () => {
    promptInstall = null;
    mostraHint(false);
    if (installBtn) installBtn.style.display = "none";
  });

  installBtn?.addEventListener("click", async () => {
    if (promptInstall) {
      mostraHint(false);
      promptInstall.prompt();
      try { await promptInstall.userChoice; } catch { /* ignorato */ }
      promptInstall = null;
      installBtn.style.display = "none";
    } else {
      // Nessun prompt (iOS o browser senza API): mostra/nasconde le istruzioni.
      mostraHint(installHint ? installHint.style.display === "none" : false);
    }
    installBtn.blur();
  });

  // Chiudi il popover cliccando altrove.
  document.addEventListener("click", (e) => {
    if (!installHint || installHint.style.display === "none") return;
    const t = e.target as Node;
    if (t !== installHint && t !== installBtn && !installBtn?.contains(t) && !installHint.contains(t)) {
      mostraHint(false);
    }
  });

  // ----- Saluto con il NOME dell'utente -----
  // Nome da session.user.user_metadata (full_name/name/...); se manca, si
  // mostra l'email come prima. Il saluto ruota tra le lingue a ogni caricamento.
  const helloEl = document.getElementById("ah-hello");
  const emailEl = document.getElementById("user-email");
  const escH = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const SALUTI = ["Ciao", "Salut", "Hola", "Hallo", "Olá", "Hej", "Hello", "Hoi", "Ahoj"];
  function nomeDaUtente(u: any): string {
    const m = (u && u.user_metadata) || {};
    const raw = String(m.full_name || m.name || m.first_name || m.given_name || m.nome || "").trim();
    return raw ? raw.split(/\s+/)[0] : "";
  }
  supabaseBrowser.auth.getSession().then(({ data }: any) => {
    const u = data && data.session && data.session.user;
    if (!helloEl) return;
    const nome = nomeDaUtente(u);
    if (nome) {
      let gi = Math.floor(Math.random() * SALUTI.length);
      helloEl.innerHTML = `<span class="ah-greet">${escH(SALUTI[gi])}</span> <strong>${escH(nome)}</strong>`;
      helloEl.style.display = "";
      if (emailEl) emailEl.style.display = "none";
      // Colore del nome adattato allo sfondo dell'header: bianco su sfondo scuro,
      // accent su sfondo chiaro (così resta leggibile con header chiari).
      const strongEl = helloEl.querySelector("strong") as HTMLElement | null;
      const headerEl = document.querySelector(".ah-header") as HTMLElement | null;
      if (strongEl && headerEl) {
        const rgb = getComputedStyle(headerEl).backgroundColor.match(/\d+(?:\.\d+)?/g);
        if (rgb && rgb.length >= 3) {
          const r = Number(rgb[0]), g = Number(rgb[1]), b = Number(rgb[2]);
          const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
          strongEl.style.color = lum > 0.6 ? "var(--c-accent)" : "#fff";
        }
      }
      // Cambia la parola del saluto ogni 5s con dissolvenza.
      const gwEl = helloEl.querySelector(".ah-greet") as HTMLElement | null;
      if (gwEl) {
        setInterval(() => {
          gi = (gi + 1) % SALUTI.length;
          gwEl.style.opacity = "0";
          gwEl.style.transform = "translateY(-5px)";
          setTimeout(() => {
            gwEl.textContent = SALUTI[gi];
            gwEl.style.opacity = "1";
            gwEl.style.transform = "translateY(0)";
          }, 350);
        }, 5000);
      }
    } else {
      helloEl.style.display = "none";
      if (emailEl) { emailEl.textContent = (u && u.email) || ""; emailEl.style.display = ""; }
    }
  });

  // Fullscreen del browser (API standard + fallback webkit per iPad).
  // NB: il fullscreen decade cambiando pagina — per il tutto-schermo
  // permanente usare la PWA ("Ajouter à l'écran d'accueil").
  const fsBtn = document.getElementById("fs-btn");
  const icoIn = document.getElementById("fs-ico-in");
  const icoOut = document.getElementById("fs-ico-out");
  const root = document.documentElement as any;
  const doc = document as any;

  // In modalità PWA standalone il bottone non serve: nascosto.
  const standalone =
    window.matchMedia("(display-mode: standalone)").matches ||
    (navigator as any).standalone === true;
  const supporto = !!(root.requestFullscreen || root.webkitRequestFullscreen);

  if (fsBtn && (!supporto || standalone)) {
    fsBtn.style.display = "none";
  }

  function fsAttivo(): boolean {
    return !!(document.fullscreenElement || doc.webkitFullscreenElement);
  }
  function aggiornaIcona() {
    if (!icoIn || !icoOut) return;
    icoIn.style.display = fsAttivo() ? "none" : "";
    icoOut.style.display = fsAttivo() ? "" : "none";
  }

  fsBtn?.addEventListener("click", async () => {
    try {
      if (fsAttivo()) {
        if (document.exitFullscreen) await document.exitFullscreen();
        else if (doc.webkitExitFullscreen) doc.webkitExitFullscreen();
      } else {
        if (root.requestFullscreen) await root.requestFullscreen();
        else if (root.webkitRequestFullscreen) root.webkitRequestFullscreen();
      }
    } catch {
      /* richiesta rifiutata dal browser: nessun crash */
    }
    // Togli il focus al bottone: senza, resta "selezionato" dopo il click
    (fsBtn as HTMLButtonElement).blur();
  });
  document.addEventListener("fullscreenchange", aggiornaIcona);
  document.addEventListener("webkitfullscreenchange", aggiornaIcona);

  // ----- Data (accanto al logo) + orologio live (a destra) -----
  // Fuso del RISTORANTE (Réglages → Général, esposto in data-tz): l'ora è
  // quella del locale anche se il tablet è impostato su un altro fuso.
  const TZ = (document.querySelector(".ah-header") as HTMLElement | null)?.dataset.tz || "Europe/Brussels";
  // Locale delle date/ore = lingua scelta per l'admin (data-locale).
  const LOC = (document.querySelector(".ah-header") as HTMLElement | null)?.dataset.locale || "fr-BE";
  const dateDay = document.getElementById("ah-date-day");
  const dateRest = document.getElementById("ah-date-rest");
  const clockEl = document.getElementById("ah-clock-time");
  let ultimoGiorno = "";

  function aggiornaData(now: Date) {
    if (!dateDay || !dateRest) return;
    // Giorno in ORO, resto della data in bianco (MAIUSCOLO via CSS).
    const wd = now.toLocaleDateString(LOC, { timeZone: TZ, weekday: "long" });
    const resto = now.toLocaleDateString(LOC, {
      timeZone: TZ,
      day: "numeric",
      month: "long",
      year: "numeric",
    });
    dateDay.textContent = wd;
    dateRest.textContent = resto;
  }

  function aggiornaOrologio() {
    const now = new Date();
    if (clockEl) {
      clockEl.textContent = now.toLocaleTimeString(LOC, {
        timeZone: TZ,
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hourCycle: "h23",
      });
    }
    // La data cambia solo a mezzanotte: la aggiorno solo quando serve.
    const giorno = now.toLocaleDateString("en-CA", { timeZone: TZ });
    if (giorno !== ultimoGiorno) {
      ultimoGiorno = giorno;
      aggiornaData(now);
    }
  }

  aggiornaOrologio();
  setInterval(aggiornaOrologio, 1000);
</script>
