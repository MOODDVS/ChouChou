---
// Jours spéciaux — form condiviso.
// Usato da Réglages → Horaire e dal modale "+" della tile Jours spéciaux
// in home. Nessun id: tutto per classe, così due istanze possono convivere
// sulla stessa pagina. Lo script è unico (Astro deduplica) e inizializza
// ogni radice ".spf" che trova.
//
// Ganci per la pagina ospite (entrambi opzionali):
//  - evento "spf:servizi"  -> detail.servizi = [{key, da, a}] per usare i
//    servizi LIVE dell'editor invece di quelli salvati (Réglages).
//  - evento "spf:loaded"   -> detail.days = giorni speciali appena caricati.
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";
import { verificaTokenLocale } from "../../lib/admin/adminAuth";
import { sediVisibili } from "../../lib/admin/sede";

const lang = await adminLang();
const t = adminT(lang);
// Multi-sede: l'interruttore «vale per tutte le sedi» ha senso solo per chi
// ne vede piu' d'una. Un responsabile legato a un punto ne vede una sola e
// non deve poter chiudere anche gli altri — l'API lo impedisce comunque,
// perche' nascondere un comando non e' un permesso.
/**
 * `azioneFuori`: il bottone «Aggiungi» non lo disegna il form, perche' chi lo
 * ospita ha un posto migliore — il PIEDE del modale, dove stanno «Annulla» e
 * la conferma di ogni altra finestra del pannello.
 *
 * ⚠️ Una proprieta' e non una regola CSS che lo nasconde: un bottone invisibile
 * resta nel foglio e nella tabulazione, e il giorno che qualcuno toglie quella
 * riga di CSS ricompare un secondo «Aggiungi» a meta' modale. Qui o c'e' o non
 * c'e', e chi lo toglie si prende l'impegno di chiamare `spf:aggiungi`.
 */
const { azioneFuori = false } = Astro.props;

const staffSpf = await verificaTokenLocale(Astro.cookies.get("mdd_at")?.value ?? "");
const piuSedi = (await sediVisibili(staffSpf)).length > 1;
---

<div class="spf" data-fuori={azioneFuori ? "1" : null}>
  {/* ⚠️ L'ELENCO STA SOTTO IL MODULO, come gli eventi locali nell'altra
      linguetta. Sopra, la prima cosa del pannello era quello che c'e' gia' —
      e per aggiungere un giorno bisognava scendere oltre un elenco che in un
      ristorante con due settimane di ferie e tre feste e' lungo. Il modulo e'
      cio' per cui si apre questa finestra; l'elenco e' la conferma di quello
      che si e' appena fatto, e la conferma viene dopo. */}
  <div class="sp-add">
    <div class="sp-row">
      <span class="sp-type">
        <button type="button" class="rh-filter spf-t-closed is-on">{t("home.tagClosed")}</button>
        <button type="button" class="rh-filter spf-t-open">{t("home.tagOpen")}</button>
      </span>
    </div>
    <div class="sp-row sp-dates">
      <input type="text" class="fld spf-from" placeholder={t("mk.datePh")} readonly />
      <span class="hint">→</span>
      <input type="text" class="fld spf-to" placeholder={t("mk.datePh")} readonly />
    </div>
    <div class="spf-hours" style="display:none">
      <div class="sp-row">
        <span class="sp-type">
          <button type="button" class="rh-filter spf-m-continu is-on">{t("set.hor.continuous")}</button>
          <button type="button" class="rh-filter spf-m-coupe">{t("set.hor.split")}</button>
        </span>
      </div>
      <div class="sp-row">
        <span class="f-label spf-lab-midi">{t("set.hor.midi")}</span>
        <input type="time" class="fld spf-lo" value="11:00" />
        <span class="hint">→</span>
        <input type="time" class="fld spf-lc" value="23:30" />
      </div>
      <div class="sp-row spf-soir" style="display:none">
        <span class="f-label">{t("set.hor.evening")}</span>
        <input type="time" class="fld spf-do" value="18:00" />
        <span class="hint">→</span>
        <input type="time" class="fld spf-dc" value="23:00" />
      </div>
      <div class="sp-servs-wrap">
        <span class="f-label">{t("set.hor.activeServices")}</span>
        <div class="sp-servs spf-servs"></div>
        <span class="hint">{t("set.hor.noServiceHint")}</span>
      </div>
    </div>
    <div class="sp-row">
      <input type="text" class="fld spf-note" placeholder={t("set.hor.notePh")} maxlength="200" />
      {piuSedi && (
        <span class="sw-wrap spf-tutte-wrap">
          <label class="switch"><input type="checkbox" class="spf-tutte" /><span class="track"></span></label>
          <span class="sw-lab">{t("sd.tutte")}</span>
        </span>
      )}
      {!azioneFuori && <button type="button" class="md-btn md-btn-primary spf-add">{t("common.add")}</button>}
    </div>
    <span class="msg spf-msg"></span>
  </div>
  <div class="sp-list spf-list"></div>
</div>

<style is:global>
  /* --- Jours spéciaux (form condiviso) --- */
  .spf .sp-type { display: inline-flex; gap: 0.4rem; }
  .spf .sp-list { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 1.3rem; }
  /* La riga e' la stessa CARD della colonna e del modale: fondo `--c-card`,
     12px di raggio, la stessa imbottitura.
     ⚠️ Il bordo si ricava dal COLORE DEL TESTO mescolato al fondo, non da
     `--c-line`: questo form vive sul `--c-card` di Réglages E sul `--c-bg` di
     un modale. Li' il fondo della card e' uguale a quello della pagina, ed e'
     il bordo a tenerla staccata — per questo non si puo' togliere. Era per
     questo che la Accueil se lo ridipingeva con un `#evt-overlay` davanti. */
  .spf .sp-item { display: flex; align-items: center; gap: 0.7rem;
    background: var(--c-card); border: 1px solid color-mix(in srgb, var(--c-text) 22%, var(--c-bg));
    border-radius: 12px; padding: 0.6rem 0.65rem 0.6rem 0.8rem; font-size: 0.9rem; }
  /* La pastiglia «aperto / chiuso» e' `.spx-b` di `styles/stati.css`, la
     stessa della colonna sulla Accueil: qui era riscritta con gli stessi
     colori e una misura diversa — due pastiglie uguali che non si somigliano. */
  .spf .sp-txt { flex: 1; display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }
  .spf .sp-date { font-weight: 800; color: var(--c-text); }
  .spf .sp-ore { color: var(--c-muted); font-size: 0.82rem; }
  .spf .sp-note { color: var(--c-muted); font-style: italic; font-size: 0.82rem; }
  .spf .sp-sv-pill { display: inline-flex; align-items: center; gap: 0.3rem; border-radius: 999px; padding: 0.12rem 0.6rem; font-size: 0.72rem; font-weight: 700; background: color-mix(in srgb, var(--c-accent) 14%, transparent); color: var(--c-gold); border: 1px solid color-mix(in srgb, var(--c-accent) 35%, transparent); white-space: nowrap; }
  .spf .sp-sv-pill small { font-weight: 600; opacity: 0.8; font-size: 0.68rem; }
  .spf .sp-sv-pill.is-cmd { background: rgba(93, 85, 85, 0.25); color: var(--c-muted); border-color: var(--c-line); }
  /* Il `gap` base tiene unite le righe di una stessa cosa (i due orari, le due
     date). L'aria in piu' si mette SOLO dove comincia una sezione nuova, con
     un margine: un gap piu grande dappertutto avrebbe slegato anche le righe
     che devono restare insieme. */
  .spf .sp-add { border-top: 1px solid color-mix(in srgb, var(--c-text) 22%, var(--c-bg)); padding-top: 1.25rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .spf .sp-add > .sp-dates { margin-top: 0.55rem; }
  .spf .sp-add > .spf-hours { margin-top: 1.1rem; }
  /* Ultima riga (nota + Aggiungi): e' la conclusione, si stacca dal resto. */
  .spf .sp-add > div:last-of-type { margin-top: 1.2rem; }
  .spf .sp-servs-wrap { display: flex; flex-direction: column; gap: 0.45rem; margin-top: 1.1rem; }
  .spf .sp-servs { display: flex; flex-wrap: wrap; gap: 0.5rem 1.3rem; }
  .spf .sp-sv {
    display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;
    font-size: 0.86rem; color: var(--c-muted); user-select: none;
  }
  .spf .sp-sv.is-on { color: var(--c-text); }
  /* L'interruttore e' il componente condiviso (.switch in styles/switch.css):
     qui lo stato NON e' un checkbox ma la classe `is-on` messa dal JS sulla
     riga, perche' a essere cliccabile e' tutta la riga del servizio. Per
     questo `.switch` riceve `is-on` insieme al genitore. */
  .spf .sp-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .spf .sp-dates { flex-wrap: nowrap; }
  .spf .spf-hours { display: flex; flex-direction: column; gap: 0.6rem; }
  /* Continuato / Spezzato decide la forma di quello che viene dopo: un filo
     d'aria in piu' sotto lo rende una scelta, non un'altra riga del gruppo. */
  .spf .spf-hours > .sp-row:first-child { margin-bottom: 0.35rem; }
  .spf .sp-dates input { flex: 1; min-width: 0; cursor: pointer; }
  /* Gli orari si stringono invece di andare a capo, a QUALSIASI larghezza:
     questo form vive dentro un modale, e la larghezza della FINESTRA non dice
     quanto sia largo il contenitore (era un @media a 560). Il `max-width` li
     tiene alla loro taglia naturale quando lo spazio c'e'. */
  .spf .sp-row input[type="time"] { flex: 1 1 auto; min-width: 0; max-width: 8rem; }
  .spf .spf-note { flex: 1; min-width: 140px; }
  /* Il bottone di conferma e' quello dei modali (`.md-btn.md-btn-primary`), la
     nota e' `.hint`, l'etichetta e' `.f-label`: qui resta solo la misura che
     tiene le etichette incolonnate con le righe accanto. */
  .spf .f-label { min-width: 3rem; }
  .spf .msg { font-size: 0.9rem; }
  .spf .msg.ok { color: #4caf7d; }
  .spf .msg.err { color: #ff6b6b; }
  /* I campi sono quelli condivisi (`styles/field.css`): fondo, bordo, fuoco e
     l'icona dell'orologio stanno li', una volta per tutta l'applicazione. */
</style>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { SERVIZI_WIDGET, nomeServizio } from "../../lib/reservationI18n";
  import { adminT, ADMIN_LOCALE, type AdminLang } from "../../i18n/admin";

  type SpecialDay = {
    id: string;
    type: "closed" | "open";
    date_from: string;
    date_to: string;
    lunch_open: string | null;
    lunch_close: string | null;
    dinner_open: string | null;
    dinner_close: string | null;
    note: string;
    services?: string[] | null;
  };
  type SpResa = { id: string; date: string; heure: string; people: number; first_name: string; last_name: string };
  type SpOrdine = { id: string; pickup_time: string; customer_name: string; total_cents: number };
  /** Cosa una chiusura lascia appeso: le confermate (che il bottone annulla),
   *  le richieste in attesa e gli ordini da ritirare (che NON si toccano da
   *  qui — un rimborso si firma nella pagina Commandes). */
  type SpImpatto = { reservations: SpResa[]; pending: SpResa[]; orders: SpOrdine[] };
  type Servizio = { key: string; da: number; a: number };

  (async () => {
    const radici = Array.from(document.querySelectorAll<HTMLElement>(".spf"));
    if (!radici.length) return;

    const LANG = (document.documentElement.lang || "fr") as AdminLang;
    const tr = adminT(LANG);
    const LOC = ADMIN_LOCALE[LANG] ?? "fr-BE";

    const { data: sd } = await supabaseBrowser.auth.getSession();
    const token = sd.session?.access_token ?? "";
    if (!token) return;
    const headers = { Authorization: `Bearer ${token}` };

    const esc = (s: string): string => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
    const fmtData = (iso: string): string => { const [y, m, d] = iso.split("-"); return `${d}/${m}/${y}`; };

    /**
     * LA DATA CHE ARRIVA DA FUORI — `?spx=2026-12-25`.
     *
     * La colonna «Jours spéciaux» della Accueil manda qui: chi ha cliccato
     * Noël vuole decidere QUEL giorno, e un modulo vuoto vorrebbe dire
     * ricercarlo a mano sul calendario, che e' esattamente il lavoro che la
     * colonna aveva appena risparmiato.
     *
     * ⚠️ Letta una volta sola, FUORI da `init`, e subito togliuta
     * dall'indirizzo: il form puo' avere due istanze nella stessa pagina (il
     * pannello e il modale), e dentro `init` la prima avrebbe consumato il
     * parametro e la seconda si sarebbe trovata un modulo vuoto. Togliere il
     * parametro serve anche a un altro guasto: senza, un ricarico della pagina
     * riscriverebbe la data sopra quella che l'utente ha appena cambiato.
     */
    const SPX_ARRIVO: string = (() => {
      try {
        const p = new URLSearchParams(location.search);
        const iso = String(p.get("spx") ?? "");
        if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return "";
        p.delete("spx");
        const q = p.toString();
        history.replaceState(null, "", location.pathname + (q ? "?" + q : "") + location.hash);
        return iso;
      } catch { return ""; }
    })();
    const hhmm = (m: number): string => `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
    const minuti = (v: string): number => { const m = /^(\d{1,2}):(\d{2})$/.exec(v); return m ? Number(m[1]) * 60 + Number(m[2]) : -1; };
    const isoOggi = (): string => {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    };

    // ---- Servizi: prima l'editor LIVE della pagina ospite, poi la config salvata
    let serviziSalvati: Servizio[] | null = null;
    async function serviziDaConfig(): Promise<Servizio[]> {
      if (serviziSalvati) return serviziSalvati;
      let out: Servizio[] = [];
      try {
        const res = await fetch("/api/admin/settings", { headers });
        if (res.ok) {
          const j = (await res.json()) as { reservations?: Record<string, string> };
          const arr = JSON.parse(j.reservations?.reservation_services || "[]") as { key?: string; label?: string; from: string; to: string }[];
          out = arr
            .map((sv) => {
              let key = sv.key && SERVIZI_WIDGET[sv.key] ? sv.key : "";
              if (!key) {
                const lab = (sv.label ?? "").trim().toLowerCase();
                const hit = Object.entries(SERVIZI_WIDGET).find(([, vv]) => vv.fr.toLowerCase() === lab);
                key = hit ? hit[0] : "midi";
              }
              return { key, da: minuti(sv.from), a: minuti(sv.to) };
            })
            .filter((sv) => sv.da >= 0 && sv.a > sv.da);
        }
      } catch { /* nessuna config raggiungibile: si usano i default */ }
      if (!out.length) out = [{ key: "midi", da: 12 * 60, a: 14 * 60 }, { key: "soir", da: 18 * 60, a: 21 * 60 + 30 }];
      serviziSalvati = out;
      return out;
    }
    async function serviziCorrenti(): Promise<Servizio[]> {
      const det: { servizi: Servizio[] | null } = { servizi: null };
      document.dispatchEvent(new CustomEvent("spf:servizi", { detail: det }));
      return det.servizi && det.servizi.length ? det.servizi : await serviziDaConfig();
    }

    // ---- Datepicker brand (un solo pannello per pagina, condiviso dalle istanze)
    const MESI = Array.from({ length: 12 }, (_, m) =>
      new Date(Date.UTC(2024, m, 1)).toLocaleDateString(LOC, { month: "long", timeZone: "UTC" })
    );
    const DOW = tr("res.dowInitials").split(",");
    let dpTarget: HTMLInputElement | null = null;
    let dpAnno = 0;
    let dpMese = 0;
    const dpPanel = document.createElement("div");
    dpPanel.className = "dp-panel";
    dpPanel.style.position = "absolute";
    dpPanel.style.display = "none";
    document.body.appendChild(dpPanel);

    function dpRender() {
      const oggi = isoOggi();
      const sel = dpTarget?.dataset.iso ?? "";
      const offset = (new Date(dpAnno, dpMese, 1).getDay() + 6) % 7; // lunedì = 0
      const nGiorni = new Date(dpAnno, dpMese + 1, 0).getDate();
      const oy = Number(oggi.slice(0, 4));
      const om = Number(oggi.slice(5, 7)) - 1;
      const prevOff = dpAnno < oy || (dpAnno === oy && dpMese <= om);
      let celle = "";
      for (let i = 0; i < offset; i++) celle += '<span class="dp-cell dp-vuota"></span>';
      for (let g = 1; g <= nGiorni; g++) {
        const iso = `${dpAnno}-${String(dpMese + 1).padStart(2, "0")}-${String(g).padStart(2, "0")}`;
        const cls = ["dp-cell"];
        const off = iso < oggi;
        if (off) cls.push("dp-off");
        if (iso === oggi) cls.push("dp-today");
        if (iso === sel) cls.push("dp-sel");
        celle += `<button type="button" class="${cls.join(" ")}" data-iso="${iso}" ${off ? "disabled" : ""}>${g}</button>`;
      }
      dpPanel.innerHTML = `
        <div class="dp-head">
          <button type="button" class="dp-nav" data-nav="-1" ${prevOff ? "disabled" : ""}>‹</button>
          <span class="dp-title">${MESI[dpMese]} ${dpAnno}</span>
          <button type="button" class="dp-nav" data-nav="1">›</button>
        </div>
        <div class="dp-dow">${DOW.map((g) => `<span>${g}</span>`).join("")}</div>
        <div class="dp-grid">${celle}</div>`;
    }
    function dpApri(target: HTMLInputElement) {
      // Sulla stessa pagina può esserci un altro datepicker (widget, eventi):
      // ne resta aperto uno solo.
      document.querySelectorAll<HTMLElement>(".dp-panel").forEach((x) => { if (x !== dpPanel) x.style.display = "none"; });
      dpTarget = target;
      const base = target.dataset.iso || isoOggi();
      dpAnno = Number(base.slice(0, 4));
      dpMese = Number(base.slice(5, 7)) - 1;
      dpRender();
      dpPanel.style.maxHeight = "";
      dpPanel.style.overflowY = "";
      dpPanel.style.display = "block";
      const r = target.getBoundingClientRect();
      const pw = dpPanel.offsetWidth || 308;
      const ph = dpPanel.offsetHeight || 360;
      const gap = 6;
      const navReserve = window.innerWidth <= 900 ? 90 : 12;
      const headerReserve = 72;
      const spaceBelow = window.innerHeight - r.bottom - gap - navReserve;
      const spaceAbove = r.top - gap - headerReserve;
      let topVp: number;
      if (ph <= spaceBelow) {
        topVp = r.bottom + gap;
      } else if (ph <= spaceAbove) {
        topVp = r.top - gap - ph;
      } else if (spaceBelow >= spaceAbove) {
        topVp = r.bottom + gap;
        dpPanel.style.maxHeight = `${Math.max(220, spaceBelow)}px`;
        dpPanel.style.overflowY = "auto";
      } else {
        const h = Math.max(220, spaceAbove);
        topVp = r.top - gap - h;
        dpPanel.style.maxHeight = `${h}px`;
        dpPanel.style.overflowY = "auto";
      }
      const leftVp = Math.max(8, Math.min(r.left, window.innerWidth - pw - 8));
      dpPanel.style.left = `${leftVp + window.scrollX}px`;
      dpPanel.style.top = `${topVp + window.scrollY}px`;
    }
    function dpChiudi() {
      dpPanel.style.display = "none";
      dpTarget = null;
    }
    dpPanel.addEventListener("click", (e) => {
      e.stopPropagation();
      const t = e.target as HTMLElement;
      if (t.classList.contains("dp-nav")) {
        dpMese += Number(t.dataset.nav);
        if (dpMese < 0) { dpMese = 11; dpAnno--; }
        if (dpMese > 11) { dpMese = 0; dpAnno++; }
        dpRender();
        return;
      }
      if (t.classList.contains("dp-cell") && t.dataset.iso && dpTarget) {
        const iso = t.dataset.iso;
        const target = dpTarget;
        target.dataset.iso = iso;
        target.value = fmtData(iso);
        // Se scelgo l'inizio e la fine manca (o è prima), allineo la fine.
        const radice = target.closest(".spf") as HTMLElement | null;
        if (radice && target.classList.contains("spf-from")) {
          const a = radice.querySelector(".spf-to") as HTMLInputElement;
          if (!a.dataset.iso || a.dataset.iso < iso) { a.dataset.iso = iso; a.value = fmtData(iso); }
        }
        dpChiudi();
      }
    });
    document.addEventListener("click", (e) => {
      if (dpPanel.style.display !== "none" && !dpPanel.contains(e.target as Node)) dpChiudi();
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") dpChiudi(); });

    // ---- Modale di allerta: prenotazioni sui giorni che sto per chiudere
    /* ⚠️ I COMPONENTI DEL PANNELLO, non un modale disegnato a mano. Questo
       era l'ultimo fondo, bordo, raggio e bottone scritti dentro un
       `style="..."`: `.md-overlay`, `.md-box`, `.md-head`, `.md-body`,
       `.md-foot`, `.md-btn` e `.md-btn-primary` sono gli stessi di tutti gli
       altri modali — e il giorno che il tema cambia, cambia anche questo
       invece di restare indietro da solo. */
    function chiediImpatto(imp: SpImpatto): Promise<"cancel" | "keep" | null> {
      return new Promise((resolve) => {
        const resas = imp.reservations;
        const ov = document.createElement("div");
        ov.className = "md-overlay";
        ov.style.zIndex = "700"; // sopra il modale che l'ha aperto
        const unaResa = (r: SpResa) => {
          const p = r.date.split("-");
          const nom = esc((r.first_name + " " + r.last_name).trim());
          return `<li>${p[2]}/${p[1]} &middot; ${r.heure} &middot; ${r.people} ${tr("res.pers")} &middot; ${nom}</li>`;
        };
        const righe = resas.map(unaResa).join("");
        /* ⚠️ Le due righe che prima non c'erano. Una chiusura chiude il sito
           per i NUOVI ordini e avvisa delle prenotazioni confermate — e
           taceva su quelli GIA' PAGATI per quel giorno: il cliente arriva,
           pagamento fatto, porta chiusa. Si dicono qui e si gestiscono dove
           si vede l'importo. */
        const avviso = (testo: string) =>
          `<p class="hint" style="margin:0 0 0.6rem;">⚠ ${esc(testo)}</p>`;
        const extra =
          (imp.pending.length
            ? avviso(tr("set.hor.impactPending").replace("{n}", String(imp.pending.length)))
            : "") +
          (imp.orders.length
            ? avviso(tr("set.hor.impactOrders").replace("{n}", String(imp.orders.length)))
            : "");
        /* ⚠️ SENZA PRENOTAZIONI CONFERMATE il modale cambia faccia: titolo
           «0 réservation(s)» e un bottone «annulla e avvisa i clienti» che non
           avrebbe nessuno da avvisare sarebbero due bugie in una finestra che
           serve a decidere. Resta l'avviso — gli ordini, le richieste — e i
           due bottoni veri: vado avanti, o torno indietro. */
        const conResa = resas.length > 0;
        ov.innerHTML = `
          <div class="md-back"></div>
          <div class="md-box" style="max-width:460px;">
            <div class="md-head">
              <h3 class="md-title">${conResa ? `${resas.length} ${tr("set.hor.impactTitle")}` : tr("set.hor.impactOther")}</h3>
            </div>
            <div class="md-body">
              ${conResa ? `<p class="hint" style="margin:0 0 0.8rem;">${tr("set.hor.impactMsg")}</p>` : ""}
              ${conResa ? `<ul style="margin:0 0 0.9rem;padding-left:1.1rem;font-size:0.85rem;line-height:1.6;">${righe}</ul>` : ""}
              ${extra}
            </div>
            <div class="md-foot">
              <button type="button" class="md-btn" data-r="abort">${tr("common.cancel")}</button>
              ${conResa
                ? `<button type="button" class="md-btn" data-r="keep">${tr("set.hor.impactKeep")}</button>` +
                  `<button type="button" class="md-btn md-btn-primary" data-r="cancel">${tr("set.hor.impactCancel")}</button>`
                : `<button type="button" class="md-btn md-btn-primary" data-r="keep">${tr("common.add")}</button>`}
            </div>
          </div>`;
        document.body.appendChild(ov);
        ov.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest("button[data-r]") as HTMLElement | null;
          // ⚠️ Il velo adesso e' `.md-back`, un elemento suo: senza questo
          // controllo il tocco fuori dalla finestra non chiudeva piu' niente —
          // prima il velo ERA l'overlay, e `e.target === ov` bastava.
          const fuori = e.target === ov || (e.target as HTMLElement).classList.contains("md-back");
          if (!b && !fuori) return;
          const r = b?.dataset.r ?? "abort";
          ov.remove();
          resolve(r === "cancel" ? "cancel" : r === "keep" ? "keep" : null);
        });
      });
    }

    // ---- Lista: una sola sorgente, tutte le istanze restano allineate
    const istanze: { render: (days: SpecialDay[]) => void }[] = [];
    /** Il cestino del pannello (`.ibtn.ibtn-danger`), non una «x» nuda: una x
     *  si preme per sbaglio, e qui dietro c'e' una chiusura che sparisce —
     *  cioe' un ristorante che torna aperto a Natale senza che nessuno
     *  l'abbia deciso. Stessa icona di tutti gli altri cestini.
     *  ⚠️ FUORI da `itemHTML`: lo rimette anche chi disarma la conferma dopo
     *  tre secondi, e li' dentro non ci arriverebbe. */
    const TRASH_SPF =
      '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>';
    function itemHTML(s: SpecialDay): string {
      const dates = s.date_from === s.date_to ? fmtData(s.date_from) : `${fmtData(s.date_from)} → ${fmtData(s.date_to)}`;
      let ore = "";
      if (s.type === "open" && s.lunch_open && s.lunch_close) {
        ore = `${s.lunch_open.slice(0, 5)}–${s.lunch_close.slice(0, 5)}`;
        if (s.dinner_open && s.dinner_close) ore += ` / ${s.dinner_open.slice(0, 5)}–${s.dinner_close.slice(0, 5)}`;
        ore = `<span class="sp-ore">${ore}</span>`;
      }
      let servTxt = "";
      if (s.type === "open" && Array.isArray(s.services)) {
        servTxt = s.services.length
          ? s.services
              .map((tok) => {
                const [k, h] = tok.split("|");
                const orario = h ? ` <small>${esc(h.replace("-", "–"))}</small>` : "";
                return `<span class="sp-sv-pill">${esc(nomeServizio(k, LANG))}${orario}</span>`;
              })
              .join("")
          : `<span class="sp-sv-pill is-cmd">${tr("set.hor.ordersOnly")}</span>`;
      }
      const nota = s.note ? `<span class="sp-note">${esc(s.note)}</span>` : "";
      const badge = s.type === "closed"
        ? `<span class="spx-b closed">${tr("home.tagClosed")}</span>`
        : `<span class="spx-b open">${tr("home.tagOpen")}</span>`;
      return `<div class="sp-item">${badge}<span class="sp-txt"><span class="sp-date">${dates}</span>${ore}${servTxt}${nota}</span>` +
        `<button type="button" class="ibtn ibtn-danger sp-del" data-id="${s.id}" title="${tr("common.delete")}" aria-label="${tr("common.delete")}">${TRASH_SPF}</button></div>`;
    }
    async function ricarica() {
      try {
        const res = await fetch("/api/admin/special-days", { headers });
        if (!res.ok) return;
        const j = await res.json();
        const days = (j.days as SpecialDay[]) ?? [];
        istanze.forEach((i) => i.render(days));
        // La pagina ospite può reagire (es. bloccare i giorni chiusi nel widget).
        (window as unknown as { __spfDays?: SpecialDay[] }).__spfDays = days;
        document.dispatchEvent(new CustomEvent("spf:loaded", { detail: { days } }));
      } catch { /* silenzioso: le liste restano come sono */ }
    }

    // ---- Una istanza del form
    function init(root: HTMLElement) {
      const q = <T extends HTMLElement>(c: string): T => root.querySelector(c) as T;
      const lista = q<HTMLDivElement>(".spf-list");
      const inFrom = q<HTMLInputElement>(".spf-from");
      const inTo = q<HTMLInputElement>(".spf-to");
      const inNote = q<HTMLInputElement>(".spf-note");
      const boxOre = q<HTMLElement>(".spf-hours");
      const inLo = q<HTMLInputElement>(".spf-lo");
      const inLc = q<HTMLInputElement>(".spf-lc");
      const boxSoir = q<HTMLElement>(".spf-soir");
      const inDo = q<HTMLInputElement>(".spf-do");
      const inDc = q<HTMLInputElement>(".spf-dc");
      const labMidi = q<HTMLElement>(".spf-lab-midi");
      const bContinu = q<HTMLButtonElement>(".spf-m-continu");
      const bCoupe = q<HTMLButtonElement>(".spf-m-coupe");
      const bClosed = q<HTMLButtonElement>(".spf-t-closed");
      const bOpen = q<HTMLButtonElement>(".spf-t-open");
      // ⚠️ Puo' non esserci: con `azioneFuori` il bottone sta nel piede del
      // modale. `q()` lancerebbe sul `null`, quindi qui si cerca a mano.
      const bAdd = root.querySelector<HTMLButtonElement>(".spf-add");
      /** La data che arriva da fuori: dall'indirizzo (`?spx=`, da un'altra
       *  pagina) o da un evento (`spf:data`, dalla colonna della Accueil che
       *  apre il modale qui accanto). Dal e Al sullo stesso giorno: la colonna
       *  manda una data, non un periodo — chi vuole due settimane allarga il
       *  secondo campo. */
      function metteData(iso: string): void {
        if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return;
        inFrom.dataset.iso = iso; inFrom.value = fmtData(iso);
        inTo.dataset.iso = iso; inTo.value = fmtData(iso);
      }
      if (SPX_ARRIVO) metteData(SPX_ARRIVO);
      document.addEventListener("spf:data", (e) => {
        metteData(String((e as CustomEvent<{ iso?: string }>).detail?.iso ?? ""));
      });
      const inTutte = root.querySelector(".spf-tutte") as HTMLInputElement | null;
      const msg = q<HTMLSpanElement>(".spf-msg");
      const boxServs = q<HTMLDivElement>(".spf-servs");
      const servSel = new Set<string>();
      let tipo: "closed" | "open" = "closed";
      let modo: "continu" | "coupe" = "continu";

      istanze.push({
        render: (days) => {
          lista.innerHTML = days.length ? days.map(itemHTML).join("") : `<p class="hint">${tr("set.hor.noSpecialDays")}</p>`;
        },
      });

      let servizi: Servizio[] = [];
      function renderServs() {
        boxServs.innerHTML = servizi.length
          ? servizi
              .map((sv) => {
                const tok = `${sv.key}|${hhmm(sv.da)}-${hhmm(sv.a)}`;
                const ore = tok.split("|")[1].replace("-", "–");
                return `<span class="sp-sv${servSel.has(tok) ? " is-on" : ""}" data-tok="${tok}"><span class="switch switch-sm${servSel.has(tok) ? " is-on" : ""}"><span class="track"></span></span>${esc(nomeServizio(sv.key, LANG))} · ${ore}</span>`;
              })
              .join("")
          : `<span class="hint">${tr("set.hor.noServiceConfig")}</span>`;
      }
      boxServs.addEventListener("click", (e) => {
        const el = (e.target as HTMLElement).closest(".sp-sv") as HTMLElement | null;
        if (!el || !el.dataset.tok) return;
        if (servSel.has(el.dataset.tok)) servSel.delete(el.dataset.tok);
        else servSel.add(el.dataset.tok);
        renderServs();
      });

      bClosed.addEventListener("click", () => {
        tipo = "closed";
        bClosed.classList.add("is-on");
        bOpen.classList.remove("is-on");
        boxOre.style.display = "none";
      });
      bOpen.addEventListener("click", async () => {
        tipo = "open";
        bOpen.classList.add("is-on");
        bClosed.classList.remove("is-on");
        boxOre.style.display = "flex";
        servizi = await serviziCorrenti();
        renderServs();
      });
      bContinu.addEventListener("click", () => {
        modo = "continu";
        bContinu.classList.add("is-on");
        bCoupe.classList.remove("is-on");
        boxSoir.style.display = "none";
        labMidi.style.display = "none";
        if (inLc.value === "14:30") inLc.value = "23:30";
      });
      bCoupe.addEventListener("click", () => {
        modo = "coupe";
        bCoupe.classList.add("is-on");
        bContinu.classList.remove("is-on");
        boxSoir.style.display = "flex";
        labMidi.style.display = "";
        if (inLc.value === "23:30") inLc.value = "14:30";
        if (!inDo.value) inDo.value = "18:00";
        if (!inDc.value) inDc.value = "23:00";
      });
      // All'avvio la modalità è Continu: etichetta Midi nascosta
      labMidi.style.display = "none";

      [inFrom, inTo].forEach((el) => {
        el.addEventListener("click", (e) => { e.stopPropagation(); dpApri(el); });
      });

      async function aggiungi(): Promise<void> {
        msg.textContent = "";
        msg.className = "msg spf-msg";
        if (!inFrom.dataset.iso) {
          msg.textContent = tr("set.hor.chooseDate");
          msg.classList.add("err");
          return;
        }
        if (bAdd) bAdd.disabled = true;
        try {
          let cancellaResa = false;
          const dal = inFrom.dataset.iso;
          const al = inTo.dataset.iso || inFrom.dataset.iso;
          if (tipo === "closed") {
            const impRes = await fetch(`/api/admin/special-days-impact?from=${dal}&to=${al}`, { headers });
            const impJ = (await impRes.json()) as Partial<SpImpatto>;
            const imp: SpImpatto = {
              reservations: impJ.reservations ?? [],
              pending: impJ.pending ?? [],
              orders: impJ.orders ?? [],
            };
            // ⚠️ Il modale si apre anche per le sole richieste in attesa o per
            // i soli ordini: erano il caso in cui la chiusura passava in
            // silenzio pur lasciando qualcuno ad aspettare davanti alla porta.
            if (imp.reservations.length || imp.pending.length || imp.orders.length) {
              const scelta = await chiediImpatto(imp);
              if (scelta === null) { if (bAdd) bAdd.disabled = false; return; }
              cancellaResa = scelta === "cancel" && imp.reservations.length > 0;
            }
          }
          const res = await fetch("/api/admin/special-days", {
            method: "POST",
            headers: { ...headers, "Content-Type": "application/json" },
            body: JSON.stringify({
              type: tipo,
              date_from: dal,
              date_to: al,
              lunch_open: tipo === "open" ? inLo.value : null,
              lunch_close: tipo === "open" ? inLc.value : null,
              dinner_open: tipo === "open" && modo === "coupe" ? inDo.value : null,
              dinner_close: tipo === "open" && modo === "coupe" ? inDc.value : null,
              services: tipo === "open" ? [...servSel] : null,
              note: inNote.value.trim(),
              // Assente o falso = solo questa sede. L'interruttore esiste
              // solo per chi vede piu' di una sede.
              tutte: inTutte?.checked === true,
            }),
          });
          const j = await res.json();
          if (!res.ok) {
            msg.textContent = j.error ?? tr("menu.errorDot");
            msg.classList.add("err");
          } else {
            if (cancellaResa) {
              try {
                const cRes = await fetch("/api/admin/special-days-impact", {
                  method: "POST",
                  headers: { ...headers, "Content-Type": "application/json" },
                  body: JSON.stringify({ from: dal, to: al }),
                });
                const cJ = (await cRes.json()) as { cancelled?: number };
                msg.textContent = cRes.ok
                  ? `${cJ.cancelled ?? 0} ${tr("set.hor.cancelledEmailed")}`
                  : tr("set.hor.dayCreatedCancelErr");
                if (!cRes.ok) msg.classList.add("err");
              } catch {
                msg.textContent = tr("set.hor.dayCreatedCancelErr");
                msg.classList.add("err");
              }
            }
            inFrom.value = ""; inTo.value = ""; inNote.value = "";
            delete inFrom.dataset.iso; delete inTo.dataset.iso;
            await ricarica();
          }
        } catch {
          msg.textContent = tr("common.netErr");
          msg.classList.add("err");
        } finally {
          if (bAdd) bAdd.disabled = false;
        }
      }
      bAdd?.addEventListener("click", () => void aggiungi());
      /** Chi ha preso il bottone se ne assume la chiamata. ⚠️ Solo l'istanza
       *  che ha ceduto il bottone ascolta: in una pagina con due form (il
       *  pannello e il modale) un ascolto per tutti vorrebbe dire due giorni
       *  speciali creati con un clic solo. */
      if (root.dataset.fuori === "1") {
        document.addEventListener("spf:aggiungi", () => void aggiungi());
      }

      /** Cancella un giorno speciale e rilegge l'elenco.
       *  ⚠️ Una funzione sola per i due posti che la chiedono — il cestino di
       *  questo elenco e quello della colonna sulla Accueil. La chiamata al
       *  server, l'intestazione con l'override del metodo e il rinfresco
       *  stanno qui: la colonna dice QUALE, non COME. */
      async function cancellaGiorno(id: string): Promise<void> {
        if (!id) return;
        try {
          await fetch("/api/admin/special-days?id=" + encodeURIComponent(id), {
            method: "POST",
            headers: { ...headers, "X-Method-Override": "DELETE" },
          });
          await ricarica();
        } catch { /* la lista resta com'era */ }
      }
      if (root.dataset.fuori === "1") {
        document.addEventListener("spf:cancella", (e) => {
          void cancellaGiorno(String((e as CustomEvent<{ id?: string }>).detail?.id ?? ""));
        });
      }

      lista.addEventListener("click", async (e) => {
        // ⚠️ `closest` e non `classList`: dentro il bottone c'e' un'icona, e
        // il bersaglio del clic e' il disegno — con `classList` il cestino
        // funzionava solo se lo si prendeva sul bordo.
        const b = (e.target as HTMLElement).closest(".sp-del") as HTMLButtonElement | null;
        if (!b) return;
        // ⚠️ LA GUARDIA A DUE TOCCHI, che qui non c'era: un tocco solo
        // cancellava la chiusura, e una chiusura cancellata vuol dire un
        // ristorante che torna aperto senza che nessuno l'abbia deciso. Primo
        // tocco: la pastiglia chiede. Si disarma da sola dopo tre secondi,
        // come gli altri cestini del pannello.
        if (!b.classList.contains("confirm")) {
          b.classList.add("confirm");
          b.textContent = tr("home.deleteQ");
          window.setTimeout(() => { b.classList.remove("confirm"); b.innerHTML = TRASH_SPF; }, 3000);
          return;
        }
        await cancellaGiorno(b.dataset.id ?? "");
      });
    }

    radici.forEach(init);
    await ricarica();
  })();
</script>
