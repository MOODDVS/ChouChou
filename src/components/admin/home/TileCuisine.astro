---
// Isola "Cuisine" della Accueil → Réglages, tab Cuisine.
// Stato Ouverte/Fermée = app_config.orders_closed (chiusura totale commandes),
// con lo switch per aprire/chiudere direttamente dal tile. Préparation e
// créneaux vengono dalla config di oggi. Popolata dallo script di index.astro.
---
<a class="tile" href="/admin/settings?tab=cuisine" data-admin-page="settings" data-tile="cuisine">
  <div class="tile-title"><svg class="tt-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z" /><line x1="6" y1="17" x2="18" y2="17" /></svg>Cuisine</div>
  <div class="sched-status" id="cui-status">—</div>
  <div class="tile-next sched-two">
    <div>
      <span class="lab">Préparation</span>
      <span class="val" id="cui-prep">—</span>
    </div>
    <div>
      <span class="lab">Créneaux</span>
      <span class="val" id="cui-slot">—</span>
    </div>
  </div>
  <div class="cui-row">
    <span class="cui-lab">Commandes en ligne</span>
    <button type="button" class="cui-sw" id="cui-sw" aria-label="Ouvrir ou fermer la cuisine"><span class="cui-knob"></span></button>
  </div>
</a>
