  <div class="j-col j-spx" id="j-spx" data-admin-page="settings" style="display:none">
    <div class="j-hd">
      <span class="j-hd-x">
        <span class="j-t"><Fragment set:html={ICO_SPX} />{t("home.specialDays")}<span class="j-pil n" id="j-spx-cnt"></span></span>
      </span>
      {/* LO STESSO BOTTONE di Notes, con la sua parola: due colonne accanto
