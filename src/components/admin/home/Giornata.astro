      <div><span class="k">{t("as.free")}</span><span class="v att" id="j-foto-libere">—</span><span class="d" id="j-foto-libere-d"></span></div>
      <div><span class="k">{t("home.phSpace")}</span><span class="v" id="j-foto-peso">—</span><span class="d" id="j-foto-peso-d"></span></div>
