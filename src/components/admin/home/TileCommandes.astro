---
// Isola "Commandes" della Accueil → pagina Commandes.
// data-admin-page="orders": AdminNav la rimuove se il super la disattiva.
import { adminLang } from "../../../lib/admin/adminLang";
import { adminT } from "../../../i18n/admin";
const lang = await adminLang();
const t = adminT(lang);
---
<a class="tile" href="/admin/orders" data-admin-page="orders" data-tile="orders">
  <div class="tile-title"><svg class="tt-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 4 6v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6l-2-4Z"/><path d="M4 6h16"/><path d="M9 10a3 3 0 0 0 6 0"/></svg>{t("nav.orders")}</div>
  <div class="ord-two">
    <div>
      <div class="tile-big" id="ord-count">0</div>
      <div class="tile-sub">{t("home.today")}</div>
    </div>
    <div>
      <div class="tile-big" id="ord-tot">—</div>
      <div class="tile-sub">{t("home.cashed")}</div>
    </div>
  </div>
  <div class="tile-next">
    <span class="lab">{t("home.nextPickups")}</span>
    <div class="ord-nexts" id="ord-next-list"></div>
  </div>
</a>
