---
/**
 * LA NAVIGAZIONE DEL PALMARE, in basso sotto il pollice (spostata da
 * /admin/salle il 25/10/2026: ora la usano la sala e Commandes).
 */
import { adminT, type AdminLang } from "../../i18n/admin";

interface Props { lang: AdminLang; attiva: "salle" | "orders" }
const { lang, attiva } = Astro.props;
const t = adminT(lang);

// La navigazione. Sala e Commandes sono pagine (25/10/2026); Alertes e
// Shifts per ora solo disegno: bottoni senza destinazione, e lo dicono
// (aria-disabled).
const VOCI = [
  { k: "salle", label: t("sal.nav.salle"), href: "/admin/salle",
    ico: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>' },
  { k: "orders", label: t("sal.nav.orders"), href: "/admin/salle/orders",
    ico: '<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/>' },
  { k: "notif", label: t("sal.nav.notif"), href: "",
    ico: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>' },
  { k: "shifts", label: t("sal.nav.shifts"), href: "",
    ico: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
];
---

    <nav class="sal-nav" aria-label={t("sal.title")}>
      {VOCI.map((v) => v.href ? (
        <a class="sal-voce" href={v.href} aria-current={v.k === attiva ? "page" : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={v.ico}></svg>
          {v.label}
        </a>
      ) : (
        <button type="button" class="sal-voce" aria-disabled="true">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={v.ico}></svg>
          {v.label}
        </button>
      ))}
    </nav>

<style is:global>
  /* L'altezza della pillola di navigazione: da qui le pagine sanno quanto
     spazio lasciare in fondo. */
  :root {
    --sal-nav-h: 58px;
    --sal-nav-bottom: calc(env(safe-area-inset-bottom) + 1rem);
  }
      /* ---------- la navigazione, in basso sotto il pollice ----------
         ⚠️ La stessa pillola della barra dell'admin (`.admin-nav` in
         AdminNav.astro): galleggia, fondo dell'header, voce attiva piena col
         colore attivo. Il palmare e' un pezzo dell'admin e deve sembrarlo.
         Copiata e non importata: AdminNav porta con se' la logica delle
         pagine dell'admin, che il palmare non ha. Se cambia il disegno di
         la', si cambia anche qui. */
      .sal-nav {
        position: fixed; left: 50%; transform: translateX(-50%); z-index: 20;
        bottom: calc(env(safe-area-inset-bottom) + 1rem);
        display: flex; gap: 0.25rem; padding: 0.35rem;
        max-width: calc(100vw - 2rem);
        border-radius: 999px;
        background: var(--c-header, var(--c-bg));
        border: 1px solid rgba(255, 255, 255, 0.12);
        /* Niente ombra portata (Enzo, 23/10/2026: «togli i drop shadow»), solo
           il filo di luce in alto. */
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
      }
      html.glass .sal-nav {
        background: color-mix(in srgb, var(--c-header, var(--c-bg)) 82%, transparent);
        -webkit-backdrop-filter: blur(26px) saturate(150%); backdrop-filter: blur(26px) saturate(150%);
      }
      .sal-voce {
        display: flex; flex: 0 0 auto; flex-direction: column; align-items: center; gap: 0.18rem;
        min-width: 64px; padding: 0.42rem 0.85rem; border-radius: 999px; border: none;
        background: transparent; color: var(--c-hmuted, var(--c-muted));
        font-family: var(--font-body, system-ui, sans-serif);
        font-size: 0.56rem; letter-spacing: 0.03em; text-transform: uppercase;
        cursor: pointer; transition: background 0.2s, color 0.2s;
      }
      .sal-voce svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .sal-voce[aria-current="page"] {
        background: var(--c-hactive, var(--c-accent));
        color: var(--c-hactive-text, var(--c-bg));
      }
  a.sal-voce { text-decoration: none; }
</style>
