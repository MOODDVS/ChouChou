---
// Modale "Libreria" riutilizzabile: mostra tutte le immagini gia' caricate
// (bucket `menu` e `popups`) e lascia sceglierne una senza doverla ricaricare.
// Comunicazione via eventi window:
//   apertura  → window.dispatchEvent(new CustomEvent("imgpick:open"))
//               (detail.mode = "link" mostra anche il tab Documenti:
//                serve a scegliere un URL da incollare in un campo lien)
//   selezione → evento "imgpick:pick" con detail = { url }
// La pagina che lo usa tiene il riferimento al campo di destinazione
// e ascolta "imgpick:pick".
import Modal from "./Modal.astro";
import { adminLang } from "../../lib/admin/adminLang";
import { adminT } from "../../i18n/admin";

const lang = await adminLang();
const t = adminT(lang);
---

<Modal id="imgpick-overlay" title={t("ip.title")} width="680px">
  <div class="ip-head">
    <button type="button" class="btn" id="imgpick-add">{"+ " + t("ip.add")}</button>
    <input type="file" id="imgpick-file" accept=".jpg,.jpeg,.png,.webp,.gif" style="display:none" />
    <div class="ip-tabs" id="imgpick-tabs">
      <button type="button" class="ip-tab is-on" data-b="">{t("ip.all")}</button>
      <button type="button" class="ip-tab" data-b="menu">{t("nav.menu")}</button>
      <button type="button" class="ip-tab" data-b="marketing">{t("nav.marketing")}</button>
      <button type="button" class="ip-tab" data-b="libre">{t("ip.free")}</button>
      <button type="button" class="ip-tab" data-b="docs" id="imgpick-tab-docs" hidden>{t("ip.docs")}</button>
    </div>
  </div>
  <div class="ip-body">
    <div class="ip-state" id="imgpick-state">{t("sup.loading")}</div>
    <div class="ip-grid" id="imgpick-grid"></div>
  </div>
</Modal>

<style is:global>
  /* ⚠️ SOPRA gli altri modali. La libreria si apre SEMPRE da dentro un altro
     modale (piatto, cliente, evento, popup), quindi deve stare sopra il 400 di
     `.md-overlay` — e non puo' dipendere dall'ordine nel DOM, perche' il
     componente e' incluso in punti diversi da pagina a pagina (in Clienti sta
     PRIMA del modale che lo apre). */
  #imgpick-overlay { z-index: 440; }
  /* La testata (aggiungi + filtri) sta ferma, scorre solo la griglia. */
  #imgpick-overlay .md-body { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
  .ip-head { flex: 0 0 auto; margin-bottom: 0.9rem; }
  .ip-head .btn { margin-bottom: 0.9rem; }
  .ip-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
  /* Filtri: scorrono in orizzontale invece di andare a capo, cosi' la testata
     resta alta una riga sola anche quando i tab sono cinque. */
  .ip-tabs { display: flex; gap: 0.4rem; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .ip-tabs::-webkit-scrollbar { display: none; }
  .ip-tab {
    flex-shrink: 0;
    background: var(--c-card); border: 1px solid color-mix(in srgb, var(--c-text) 20%, var(--c-bg)); color: var(--c-muted);
    font-family: var(--font-body); font-size: 0.82rem; letter-spacing: 0.03em;
    padding: 0.35rem 0.9rem; cursor: pointer; border-radius: 999px;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .ip-tab:hover { color: var(--c-text); border-color: var(--c-accent); }
  .ip-tab.is-on { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-bg); font-weight: 700; }
  .ip-state { color: var(--c-muted); text-align: center; padding: 1.5rem 0; }
  .ip-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .ip-cell {
    padding: 0; border: 1px solid var(--c-line); background: var(--c-card);
    cursor: pointer; border-radius: 8px; overflow: hidden; display: block;
    transition: border-color 0.15s, transform 0.15s;
  }
  .ip-cell:hover { border-color: var(--c-accent); transform: scale(0.97); }
  .ip-cell img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
  .ip-cell--pdf {
    aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.4rem; color: var(--c-muted); padding: 0.4rem;
  }
  .ip-cell--pdf svg { width: 26px; height: 26px; fill: none; stroke: var(--c-accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ip-doc-name { font-size: 0.62rem; word-break: break-all; text-align: center; max-height: 2.4em; overflow: hidden; }
  .ip-cell--pdf img { object-position: top; }
  @media (max-width: 640px) {
    .ip-grid { gap: 0.4rem; }
  }
</style>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { comprimiFoto } from "../../lib/admin/imageCompress";
  import { adminT, type AdminLang } from "../../i18n/admin";

  const LANG = (document.documentElement.lang || "fr") as AdminLang;
  const tr = adminT(LANG);

  type Img = { bucket: string; name: string; url: string; used_by: string[]; tags: string[] };
  type Doc = { name: string; url: string; thumb_url: string | null };

  const ICO_PDF =
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>';

  const overlay = document.getElementById("imgpick-overlay") as HTMLDivElement;
  const grid = document.getElementById("imgpick-grid") as HTMLDivElement;
  const stateEl = document.getElementById("imgpick-state") as HTMLDivElement;
  const tabsEl = document.getElementById("imgpick-tabs") as HTMLDivElement;
  const addBtn = document.getElementById("imgpick-add") as HTMLButtonElement;
  const addFile = document.getElementById("imgpick-file") as HTMLInputElement;

  let imgs: Img[] = [];
  let docs: Doc[] = [];
  let modo: "image" | "link" = "image";
  let filtro = "";

  function esc(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function vuoto(msg: string) {
    stateEl.style.display = "";
    stateEl.textContent = msg;
    grid.innerHTML = "";
  }

  function render() {
    if (filtro === "docs") {
      if (!docs.length) return vuoto(tr("ip.noDocs"));
      stateEl.style.display = "none";
      grid.innerHTML = docs
        .map((d) =>
          d.thumb_url
            ? `<button type="button" class="ip-cell" data-url="${esc(d.url)}" title="${esc(d.name)}"><img src="${esc(d.thumb_url)}" alt="" loading="lazy" /></button>`
            : `<button type="button" class="ip-cell ip-cell--pdf" data-url="${esc(d.url)}" title="${esc(d.name)}">${ICO_PDF}<span class="ip-doc-name">${esc(d.name)}</span></button>`
        )
        .join("");
      return;
    }
    const vis = !filtro
      ? imgs
      : filtro === "libre"
        ? imgs.filter((i) => !i.tags.length)
        : imgs.filter((i) => i.tags.includes(filtro));
    if (!vis.length) return vuoto(tr("ip.noImages"));
    stateEl.style.display = "none";
    grid.innerHTML = vis
      .map(
        (i) =>
          `<button type="button" class="ip-cell" data-url="${esc(i.url)}" title="${esc(i.name)}"><img src="${esc(i.url)}" alt="" loading="lazy" /></button>`
      )
      .join("");
  }

  async function carica() {
    vuoto(tr("sup.loading"));
    try {
      const { data } = await supabaseBrowser.auth.getSession();
      const token = data.session?.access_token ?? "";
      const [resImg, resDoc] = await Promise.all([
        fetch("/api/admin/images", { headers: { Authorization: `Bearer ${token}` } }),
        modo === "link"
          ? fetch("/api/admin/documents", { headers: { Authorization: `Bearer ${token}` } })
          : Promise.resolve(null),
      ]);
      if (!resImg.ok) throw new Error();
      imgs = ((await resImg.json()) as { images: Img[] }).images;
      docs = resDoc && resDoc.ok ? ((await resDoc.json()) as { documents: Doc[] }).documents : [];
      render();
    } catch {
      stateEl.textContent = tr("ip.loadErr");
    }
  }

  function chiudi() {
    overlay.hidden = true;
  }

  window.addEventListener("imgpick:open", (e) => {
    modo = (e as CustomEvent<{ mode?: string }>).detail?.mode === "link" ? "link" : "image";
    const tabDocs = document.getElementById("imgpick-tab-docs") as HTMLButtonElement;
    tabDocs.hidden = modo !== "link";
    if (modo !== "link" && filtro === "docs") {
      filtro = "";
      tabsEl.querySelectorAll<HTMLElement>(".ip-tab").forEach((el) => el.classList.toggle("is-on", el.dataset.b === ""));
    }
    overlay.hidden = false;
    void carica(); // ricarica sempre: include gli upload appena fatti
  });

  tabsEl.addEventListener("click", (e) => {
    const t = (e.target as HTMLElement).closest(".ip-tab") as HTMLElement | null;
    if (!t) return;
    filtro = t.dataset.b ?? "";
    tabsEl.querySelectorAll(".ip-tab").forEach((el) => el.classList.toggle("is-on", el === t));
    render();
  });

  grid.addEventListener("click", (e) => {
    const cell = (e.target as HTMLElement).closest(".ip-cell") as HTMLElement | null;
    if (!cell) return;
    window.dispatchEvent(new CustomEvent("imgpick:pick", { detail: { url: cell.dataset.url ?? "" } }));
    chiudi();
  });

  addBtn.addEventListener("click", () => addFile.click());
  addFile.addEventListener("change", async () => {
    const file = addFile.files?.[0];
    if (!file) return;
    const prev = addBtn.textContent;
    addBtn.disabled = true;
    addBtn.textContent = tr("ip.sending");
    try {
      const foto = await comprimiFoto(file);
      if (foto.size > 4 * 1024 * 1024) throw new Error(tr("ip.tooBig"));
      const b64 = await new Promise<string>((resolve, reject) => {
        const r = new FileReader();
        r.onload = () => resolve(String(r.result).split(",")[1] ?? "");
        r.onerror = () => reject(new Error(tr("ip.unreadable")));
        r.readAsDataURL(foto);
      });
      const { data } = await supabaseBrowser.auth.getSession();
      const token = data.session?.access_token ?? "";
      const res = await fetch("/api/admin/upload", {
        method: "POST",
        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: JSON.stringify({ filename: foto.name, data: b64, bucket: "popups" }),
      });
      const j = (await res.json()) as { error?: string; url?: string };
      if (!res.ok || !j.url) throw new Error(j.error ?? tr("as.uploadFailed"));
      window.dispatchEvent(new CustomEvent("imgpick:pick", { detail: { url: j.url } }));
      chiudi();
    } catch (err) {
      stateEl.style.display = "";
      stateEl.textContent = err instanceof Error ? err.message : tr("as.uploadFailed");
    } finally {
      addBtn.disabled = false;
      addBtn.textContent = prev;
      addFile.value = "";
    }
  });

  // Chiusura: le ancore del guscio condiviso (sfondo, ×).
  overlay.querySelectorAll("[data-md-close]").forEach((el) => el.addEventListener("click", chiudi));
  // ⚠️ Capture su window: l'Escape chiude SOLO la libreria, non il modale che
  // sta sotto e che l'ha aperta. Senza `stopPropagation` si chiuderebbero
  // tutti e due, e il lavoro a meta' nel modale sotto andrebbe perso.
  window.addEventListener(
    "keydown",
    (e) => {
      if (e.key === "Escape" && !overlay.hidden) {
        e.stopPropagation();
        chiudi();
      }
    },
    true
  );
</script>
