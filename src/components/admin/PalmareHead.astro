---
/**
 * LA TESTA DELLE PAGINE DEL PALMARE (22/10/2026) — /admin/salle e figlie.
 *
 * Le meta della PWA, i colori di ripiego e il reset, una volta sola per tutte
 * le pagine del palmare; poi `AdminHead`, che porta i colori del cliente, i
 * caratteri e il manifest come nel resto dell'admin.
 *
 * ⚠️ Va dentro <head>, e la pagina ci mette dopo i SUOI stili.
 */
import AdminHead from "./AdminHead.astro";
import { CLIENT } from "../../config/client";

interface Props { titolo: string }
const { titolo } = Astro.props;
// La CSP dell'admin esegue solo gli script col nonce della richiesta
// (middleware.ts): anche quello dello zoom qui sotto deve portarlo.
const nonce = Astro.locals.cspNonce;
---

<meta charset="utf-8" />
{/* ⚠️ NIENTE ZOOM NEL PALMARE (Enzo, 31/10/2026): e' un'app di lavoro, non
    una pagina da leggere — due dita sulla mappa o un doppio tocco su un tavolo
    non devono ingrandire niente. Diverso dal resto dell'admin e dai siti
    (vedi `NoZoom.astro`), dove lo zoom voluto resta. Tre pezzi, perche' Safari
    su iPhone ignora `user-scalable=no`: il viewport (Android), `touch-action:
    manipulation` (il doppio tocco) e lo script qui sotto (le due dita). */}
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
<title>{titolo + " — " + CLIENT.nome}</title>
<meta name="robots" content="noindex, nofollow" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="theme-color" content="#000000" />
<style is:global>
  /* I ripieghi delle altre pagine admin: AdminHead, piu' sotto, li
     sovrascrive coi colori del cliente (Réglages → Design). */
  :root {
    --c-bg: #0c2a30; --c-text: #e9efef; --c-muted: #86a0a4;
    --c-line: #244a52; --c-card: #16424b; --c-accent: #cb534d;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { touch-action: manipulation; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
  body { background: var(--c-bg); color: var(--c-text); font-family: var(--font-body); }

  /* ---------- LE PILLOLE DI SCELTA, sopra la navigazione (31/10/2026) ----------
     Le sale nella mappa e i filtri di Commandes: una famiglia sola, scritta
     una volta. `.pm-scelte` e' la fila, `.pm-scelta` il bottone, `<b>` dentro
     il bottone un contatore. Fondo e bordo come la pillola del cameriere in
     alto (`.sal-pillola`); la scelta (aria-pressed) nel colore d'accento. */
  .pm-scelte {
    position: fixed; left: 0; right: 0; z-index: 19;
    /* 1rem sopra la navigazione (31/10/2026: era 0.6rem). */
    bottom: calc(var(--sal-nav-bottom) + var(--sal-nav-h) + 1rem);
    display: flex; justify-content: safe center; gap: 0.4rem;
    padding: 0 1rem; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .pm-scelte::-webkit-scrollbar { display: none; }
  .pm-scelta {
    flex: 0 0 auto; height: 34px; padding: 0 0.95rem; border-radius: 999px; white-space: nowrap;
    display: inline-flex; align-items: center; gap: 0.4rem;
    border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-text);
    font: inherit; font-size: 0.78rem; font-weight: 700; cursor: pointer;
  }
  .pm-scelta:has(> b) { padding-right: 0.6rem; }
  .pm-scelta > b {
    min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--c-bg); color: var(--c-text); font-size: 0.7rem;
  }
  .pm-scelta[aria-pressed="true"] { background: var(--c-accent); color: var(--c-bg); border-color: var(--c-accent); }
</style>
<script is:inline nonce={nonce}>
  // Le due dita su iPhone e iPad: Safari ignora `user-scalable=no`, ma lascia
  // annullare i suoi gesti. E un tocco a piu' dita che si muove non scorre.
  (function () {
    var no = function (e) { e.preventDefault(); };
    document.addEventListener("gesturestart", no, { passive: false });
    document.addEventListener("gesturechange", no, { passive: false });
    document.addEventListener("gestureend", no, { passive: false });
    document.addEventListener("touchmove", function (e) { if (e.touches && e.touches.length > 1) e.preventDefault(); }, { passive: false });
  })();
</script>
<AdminHead />
