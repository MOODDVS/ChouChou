---
// Section photo plein écran du restaurant, sous la section « Découvrir ».
// Un dégradé avorio (100% en haut vers 0% au milieu) fond le bord haut de
// la photo dans la section avorio au-dessus : aucune ligne visible.
---

<section class="resto-photo">
  <img
    class="resto-img"
    src="/chouchou-restaurant.webp"
    alt="Le Comptoir ChouChou, restaurant à Mont-Saint-Guibert, et sa terrasse au coucher du soleil"
    loading="lazy"
    decoding="async"
  />
  <div class="resto-fade" aria-hidden="true"></div>
</section>

<style>
  .resto-photo {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
    background: #f7f4ee;
  }
  .resto-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Dégradé avorio -> transparent sur la moitié haute : masque la ligne du haut */
  .resto-fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 52%;
    background: linear-gradient(
      to bottom,
      #f7f4ee 0%,
      rgba(247, 244, 238, 0.85) 22%,
      rgba(247, 244, 238, 0) 100%
    );
    pointer-events: none;
  }
</style>
