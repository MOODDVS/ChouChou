---
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";
import { supabaseAdmin } from "../lib/db";
import { linksSocial } from "../lib/links";
import { cacheOr } from "../lib/cache";

const lang = getLangFromUrl(Astro.url);
const en = lang === "en";


const EMAIL = "pizzeria@lamolisana.be";
const PHONE_DISPLAY = "+32 455 13 14 65";
const PHONE_TEL = "+32455131465";

const YEAR = new Date().getFullYear();

// Social gestiti dall'admin (Réglages -> Liens)
const social = await linksSocial();

// --- Orari settimanali dal DB (settings) — sempre allineati con l'admin ---
const DAYS = en
  ? ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
  : ["Dimanche", "Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi"];
const ORDER = [1, 2, 3, 4, 5, 6, 0]; // Lun..Dim
const CLOSED = en ? "Closed" : "Fermé";

function hhmm(t: string | null): string {
  return t ? String(t).slice(0, 5) : "";
}
function bande(row: any): string {
  const b: string[] = [];
  if (row?.lunch_active && row.lunch_open && row.lunch_close) b.push(`${hhmm(row.lunch_open)} – ${hhmm(row.lunch_close)}`);
  if (row?.dinner_active && row.dinner_open && row.dinner_close) b.push(`${hhmm(row.dinner_open)} – ${hhmm(row.dinner_close)}`);
  return b.length ? b.join(" · ") : CLOSED;
}

let horaires: { days: string; val: string }[] = [];
let fermetures: string[] = [];
try {
  // Cache 60s: il footer è su tutte le pagine, una query basta
  const data = await cacheOr("footer:settings", async () => {
    const { data: righe, error } = await supabaseAdmin
      .from("settings")
      .select("day_of_week, lunch_active, lunch_open, lunch_close, dinner_active, dinner_open, dinner_close");
    if (error || !righe) throw new Error("settings illeggibili");
    return righe;
  });
  if (data && data.length) {
    const byDay: Record<number, any> = {};
    for (const r of data) byDay[r.day_of_week] = r;
    const seq = ORDER.map((d) => ({ label: DAYS[d], val: bande(byDay[d]) }));

    // Giorni di chiusura: righe a parte ("Mardi fermé"), consecutivi raggruppati
    const runs: string[][] = [];
    for (let i = 0; i < seq.length; i++) {
      if (seq[i].val !== CLOSED) continue;
      if (i > 0 && seq[i - 1].val === CLOSED) runs[runs.length - 1].push(seq[i].label);
      else runs.push([seq[i].label]);
    }
    fermetures = runs.map((r) => (r.length === 1 ? r[0] : `${r[0]} – ${r[r.length - 1]}`));

    // Giorni APERTI raggruppati per orario identico: una chiusura in mezzo
    // non spezza il gruppo (Lun + Mer..Dim stesso orario -> "Lundi – Dimanche")
    const aperti = seq.filter((x) => x.val !== CLOSED);
    const groups: { val: string; days: string[] }[] = [];
    for (const it of aperti) {
      const last = groups[groups.length - 1];
      if (last && last.val === it.val) last.days.push(it.label);
      else groups.push({ val: it.val, days: [it.label] });
    }
    horaires = groups.map((g) => ({
      days: g.days.length === 1 ? g.days[0] : `${g.days[0]} – ${g.days[g.days.length - 1]}`,
      val: g.val,
    }));
  }
} catch {
  horaires = [];
}
// Fallback statico se il DB non risponde
if (!horaires.length) {
  horaires = en ? [{ days: "Mon – Sun", val: "11:00 – 23:30" }] : [{ days: "Lun – Dim", val: "11:00 – 23:30" }];
  fermetures = en ? ["Tuesday"] : ["Mardi"];
}
const CLOSED_LINE = en ? "closed" : "fermé";

const L = {
  address: en ? "Address" : "Adresse",
  hours: en ? "Opening hours" : "Horaires",
  contact: "Contact",
  follow: en ? "Follow us" : "Nous Suivre",
  rights: en ? "All rights reserved" : "Tous droits réservés",
  privacy: en ? "Privacy" : "Confidentialité",
  cookies: "Cookies",
};
---

<footer class="ftr">
  <div class="ftr-strip"></div>

  <div class="ftr-cols">
    <div class="ftr-col">
      <h2 class="ftr-title">{L.address}</h2>
      <div class="ftr-body">
        Av. Adolphe Demeur 37<br />
        1060 · Saint-Gilles
      </div>
    </div>

    <div class="ftr-col">
      <h2 class="ftr-title">{L.hours}</h2>
      <div class="ftr-body">
        {horaires.map((h) => (
          <p class="ftr-hr">{h.days}<br />{h.val}</p>
        ))}
        {fermetures.map((f) => (
          <p class="ftr-hr ftr-closed">{f} {CLOSED_LINE}</p>
        ))}
      </div>
    </div>

    <div class="ftr-col">
      <h2 class="ftr-title">{L.contact}</h2>
      <div class="ftr-body">
        <a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a><br />
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>
    </div>

    <div class="ftr-col">
      <h2 class="ftr-title">{L.follow}</h2>
      <div class="ftr-social">
        {social.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label} set:html={s.icon} />
        ))}
      </div>
    </div>
  </div>

  <div class="ftr-legal">
    <p class="lg">
      <span>© {YEAR}</span><span class="lg-sep">&nbsp;</span>
      <span>{L.rights}</span><span class="lg-sep">&nbsp;•&nbsp;</span>
      <span>Migraf SRL / La Molisana</span><span class="lg-sep">&nbsp;/&nbsp;</span>
      <span>BE 0899 648 967</span><span class="lg-sep">&nbsp;-&nbsp;</span>
      <span><a href={getLocalizedUrl("/privacy", lang)}>{L.privacy}</a> · <a href={getLocalizedUrl("/cookies", lang)}>{L.cookies}</a></span>
    </p>
    <p>
      <a href="https://www.moodd.online" target="_blank" rel="noopener noreferrer">Powered by MOODD</a>
    </p>
  </div>
</footer>

<style>
  .ftr { width: 100%; background: var(--c-bg); }
  .ftr-strip {
    height: 3px;
    background: linear-gradient(90deg, transparent 0%, rgba(223, 171, 78, 0.55) 50%, transparent 100%);
  }

  .ftr-cols {
    max-width: var(--maxw);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 3.5rem 2rem;
  }
  .ftr-col { padding: 0 2rem; text-align: center; }
  .ftr-col + .ftr-col { border-left: 1px solid var(--c-line); }

  .ftr-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    letter-spacing: 0.02em;
    margin: 0 0 1.3rem;
  }
  .ftr-body {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--c-text);
  }
  .ftr-body a { color: var(--c-text); text-decoration: none; transition: color 0.15s; }
  .ftr-body a:hover { color: var(--c-accent); }
  .ftr-hr { margin: 0 0 0.6rem; }
  .ftr-hr:last-child { margin-bottom: 0; }
  .ftr-closed { opacity: 0.55; }

  .ftr-social { display: flex; justify-content: center; gap: 1.3rem; margin-top: 0.4rem; }
  .ftr-social a { color: var(--c-text); display: inline-flex; transition: color 0.15s; }
  .ftr-social a:hover { color: var(--c-accent); }
  .ftr-social a :global(svg) { width: 22px; height: 22px; display: block; }

  .ftr-legal {
    border-top: 1px solid var(--c-line);
    padding: 1.1rem 2rem 1.3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
  }
  .ftr-legal p {
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0;
  }
  .ftr-legal a { color: var(--c-muted); text-decoration: none; }
  .ftr-legal a:hover { color: var(--c-text); }

  @media (max-width: 860px) {
    .ftr-cols { grid-template-columns: 1fr 1fr; gap: 2.5rem 0; padding: 2.75rem 1rem; }
    .ftr-col { padding: 0 1rem; }
    .ftr-col + .ftr-col { border-left: none; }
    .ftr-col:nth-child(even) { border-left: 1px solid var(--c-line); }
    .ftr-title { font-size: 1.7rem; }
  }
  @media (max-width: 640px) {
    .ftr-legal {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
      padding: 1.4rem 1.5rem 1.6rem;
    }
    .lg span { display: block; line-height: 1.9; }
    .lg .lg-sep { display: none; }
  }

  @media (max-width: 520px) {
    .ftr-cols { grid-template-columns: 1fr; gap: 0; }
    .ftr-col { border-left: none !important; border-top: 1px solid var(--c-line); padding: 1.6rem 1rem; }
    .ftr-col:first-child { border-top: none; padding-top: 0; }
  }
</style>
