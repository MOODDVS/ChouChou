---
import { getLangFromUrl, getLocalizedUrl } from "../i18n/ui";
import { linksSocial } from "../lib/links";

const lang = getLangFromUrl(Astro.url);
const en = lang === "en";
const YEAR = new Date().getFullYear();

// Social gestiti dall'admin (Réglages -> Liens)
const social = await linksSocial();

// Pagina corrente, per evidenziare la voce attiva (come l'header)
const rawPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = rawPath.replace(/^\/en/, "") || "/";
const isActive = (path: string): boolean => (path.replace(/\/$/, "") || "/") === current;

const nav = [
  { label: en ? "Home" : "Accueil", path: "/" },
  { label: en ? "Our menu" : "Notre carte", path: "/menu" },
  { label: en ? "The Ambiance" : "L'Ambiance", path: "/ambiance" },
  { label: "Contact", path: "/contact" },
];

const L = {
  order: en ? "Order" : "Commander",
  book: en ? "Book" : "Réserver",
  emailL: "Email",
  firstL: en ? "First name" : "Prénom",
  lastL: en ? "Last name" : "Nom",
  subscribe: en ? "Subscribe" : "S'inscrire",
  legal: en ? "Legal notice" : "Mentions légales",
  privacy: en ? "Privacy" : "Confidentialité",
  cookies: "Cookies",
};
---

<footer class="foot">

  <div class="foot-inner">

  <!-- riga alta : about | nav | newsletter -->
  <div class="foot-top">

    <!-- About -->
    <div class="about">
      <img class="about-photo" src="/yasmina-koeune-chouchou.webp" alt="Yasmina Koeune — Comptoir Chouchou" width="168" height="230" loading="lazy" decoding="async" />
      <div class="about-body">
        <p class="about-txt">
          {en ? (
            <Fragment>Counter cuisine, fresh produce and a <span class="em">warm</span> atmosphere. A friendly address where you feel right at home, in the heart of the neighbourhood.</Fragment>
          ) : (
            <Fragment>Cuisine de comptoir, produits frais et ambiance <span class="em">chaleureuse</span>. Une adresse conviviale où l'on se sent comme à la maison, au cœur du quartier.</Fragment>
          )}
        </p>
        <a class="brand-link" href={getLocalizedUrl("/", lang)}>
          Comptoir Chouchou
          <span class="circ" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Nav -->
    <nav class="nav">
      {nav.map((item) => (
        <a class={"nav-a" + (isActive(item.path) ? " on" : "")} href={getLocalizedUrl(item.path, lang)}>{item.label}</a>
      ))}
      <div class="sep"></div>
      <a class={"nav-a" + (isActive("/order") ? " on" : "")} href={getLocalizedUrl("/order", lang)}>{L.order}</a>
      <button class="nav-a" type="button" data-reserver>{L.book}</button>
      {social.length > 0 && <div class="sep"></div>}
      {social.map((s) => (
        <a class="nav-a ext" href={s.url} target="_blank" rel="noopener noreferrer">
          {s.label}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
        </a>
      ))}
    </nav>

    <!-- Newsletter -->
    <div class="news" data-newsletter data-lang={lang}>
      <div class="field">
        <label for="ftr-email">{L.emailL}</label>
        <input id="ftr-email" name="email" type="email" autocomplete="email" />
      </div>
      <div class="field">
        <label for="ftr-first">{L.firstL}</label>
        <input id="ftr-first" name="first_name" type="text" autocomplete="given-name" />
      </div>
      <div class="field">
        <label for="ftr-last">{L.lastL}</label>
        <input id="ftr-last" name="last_name" type="text" autocomplete="family-name" />
      </div>
      <label class="news-consent">
        <input type="checkbox" id="ftr-consent" />
        <span>
          {en
            ? (<Fragment>I agree to receive the newsletter and the restaurant's <a href={getLocalizedUrl("/privacy", lang)}>terms</a>.</Fragment>)
            : (<Fragment>J'accepte de recevoir la newsletter et les <a href={getLocalizedUrl("/privacy", lang)}>conditions</a> du restaurant.</Fragment>)}
        </span>
      </label>
      <button class="subscribe" type="button">
        {L.subscribe}
        <span class="circ" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </span>
      </button>
      <p class="news-msg" role="status" aria-live="polite"></p>
    </div>

  </div>

  <hr class="foot-rule" />

  </div><!-- /foot-inner -->

  <!-- wordmark gigante — full width, ajusté à la largeur (jamais coupé) -->
  <div class="wordmark">
    <span class="big" id="ch-wordmark">ChouChou</span>
  </div>

  <!-- barre légale -->
  <div class="foot-inner">
  <div class="foot-legal">
    <span>Comptoir ChouChou © {YEAR}</span>
    <span class="legal-links">
      <a href={getLocalizedUrl("/privacy", lang)}>{L.privacy}</a>
      <span class="dot">·</span>
      <a href={getLocalizedUrl("/cookies", lang)}>{L.cookies}</a>
      <span class="dot">·</span>
      <a href="https://www.moodd.online" target="_blank" rel="noopener noreferrer">Powered by MOODD</a>
    </span>
  </div>
  </div><!-- /foot-inner -->

  <script is:inline>
    (function () {
      var el = document.getElementById('ch-wordmark');
      if (!el) return;
      function fit() {
        var p = el.parentElement;
        var cs = getComputedStyle(p);
        var avail = p.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
        if (avail <= 0) return;
        el.style.fontSize = '100px';
        var w = el.scrollWidth;
        if (!w) return;
        el.style.fontSize = (100 * avail / w * 0.99) + 'px';
      }
      fit();
      window.addEventListener('resize', fit, { passive: true });
      window.addEventListener('load', fit);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    })();
  </script>

  <script is:inline>
    (function () {
      var box = document.querySelector('[data-newsletter]');
      if (!box) return;
      var lang = box.getAttribute('data-lang') === 'en' ? 'en' : 'fr';
      var btn = box.querySelector('.subscribe');
      var msg = box.querySelector('.news-msg');
      var fEmail = box.querySelector('#ftr-email');
      var fFirst = box.querySelector('#ftr-first');
      var fLast = box.querySelector('#ftr-last');
      var fConsent = box.querySelector('#ftr-consent');
      if (!btn || !msg || !fEmail) return;
      var RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      var T = {
        fr: {
          invalid: "Merci d'indiquer une adresse email valide.",
          ok: "Merci ! Votre inscription est bien enregistrée.",
          err: "Oups, une erreur est survenue. Réessayez dans un instant.",
          consent: "Merci d'accepter les conditions pour vous inscrire."
        },
        en: {
          invalid: "Please enter a valid email address.",
          ok: "Thank you! You're now subscribed.",
          err: "Oops, something went wrong. Please try again.",
          consent: "Please accept the terms to subscribe."
        }
      };
      var t = T[lang];
      var busy = false;

      function setMsg(text, kind) {
        msg.textContent = text;
        msg.className = 'news-msg' + (kind ? ' ' + kind : '');
      }

      function submit() {
        if (busy) return;
        var email = (fEmail.value || '').trim();
        if (!RE.test(email)) { setMsg(t.invalid, 'err'); fEmail.focus(); return; }
        if (fConsent && !fConsent.checked) { setMsg(t.consent, 'err'); return; }
        busy = true;
        setMsg('', '');
        btn.setAttribute('disabled', 'disabled');
        fetch('/api/newsletter-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: email,
            first_name: (fFirst && fFirst.value || '').trim(),
            last_name: (fLast && fLast.value || '').trim(),
            lang: lang
          })
        }).then(function (res) {
          if (!res.ok) throw new Error('bad');
          setMsg(t.ok, 'ok');
          fEmail.value = '';
          if (fFirst) fFirst.value = '';
          if (fLast) fLast.value = '';
        }).catch(function () {
          setMsg(t.err, 'err');
        }).then(function () {
          busy = false;
          btn.removeAttribute('disabled');
        });
      }

      btn.addEventListener('click', submit);
      [fEmail, fFirst, fLast].forEach(function (el) {
        if (!el) return;
        el.addEventListener('keydown', function (ev) {
          if (ev.key === 'Enter') { ev.preventDefault(); submit(); }
        });
      });
    })();
  </script>

</footer>

<style>
  .foot {
    --navy: #353c4e;
    --mag: #ed2289;
    --ivory: #f7f4ee;
    --line: rgba(247, 244, 238, 0.16);
    --muted: rgba(247, 244, 238, 0.62);
    position: relative;
    width: 100%;
    background: var(--navy);
    color: var(--ivory);
    padding: 64px 0 30px;
    overflow: hidden;
  }
  .foot-inner { max-width: 1440px; margin: 0 auto; padding: 0 28px; }

  /* halo magenta discret, signature de la marque */
  .foot::before {
    content: "";
    position: absolute;
    left: 8%;
    bottom: -10%;
    width: 640px;
    height: 640px;
    max-width: 70vw;
    background: radial-gradient(circle, rgba(237, 34, 137, 0.16) 0%, rgba(237, 34, 137, 0) 62%);
    pointer-events: none;
  }

  /* ---- riga alta ---- */
  .foot-top {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 0;
    padding-bottom: 56px;
  }

  /* About */
  .about { display: flex; gap: 26px; padding-right: 48px; }
  .about-photo {
    flex: 0 0 168px;
    width: 168px;
    height: 230px;
    border-radius: 4px;
    object-fit: cover;
    display: block;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }
  .about-body { padding-top: 6px; }
  .about-txt {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.02rem;
    line-height: 1.62;
    color: var(--ivory);
    margin: 0 0 26px;
    max-width: 24em;
  }
  .about-txt .em { font-family: var(--font-script); font-style: normal; color: var(--mag); font-size: 1.5em; line-height: 0; }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ivory);
    text-decoration: none;
  }
  .circ {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ivory);
    color: var(--navy);
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
    flex: 0 0 auto;
  }
  .circ svg { width: 15px; height: 15px; }
  .brand-link:hover .circ { background: var(--mag); color: #fff; transform: translate(2px, -2px); }

  /* Nav */
  .nav { padding-left: 52px; border-left: 1px solid var(--line); }
  .nav-a {
    display: block;
    font-family: var(--font-title);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ivory);
    text-decoration: none;
    padding: 7px 0;
    width: max-content;
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: color 0.18s ease;
  }
  .nav-a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 2px;
    height: 1.5px;
    width: 0;
    background: var(--mag);
    transition: width 0.22s ease;
  }
  .nav-a:hover { color: var(--mag); }
  .nav-a:hover::after { width: 100%; }
  .nav-a.on { color: var(--mag); }
  .nav-a.on::after { width: 100%; }
  .nav .sep { height: 22px; }
  .nav .ext { display: inline-flex; align-items: center; gap: 8px; }
  .nav .ext svg { width: 12px; height: 12px; color: var(--mag); }

  /* Newsletter */
  .news { padding-left: 40px; }
  .field { position: relative; margin-bottom: 26px; }
  .field label {
    display: block;
    font-family: var(--font-title);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 9px;
  }
  .field input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    color: var(--ivory);
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: 0 0 9px;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .field input:focus { border-color: var(--mag); }
  .subscribe {
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ivory);
  }
  .subscribe .circ { background: var(--mag); color: #fff; }
  .subscribe:hover .circ { transform: translateX(3px); background: var(--ivory); color: var(--navy); }
  .subscribe[disabled] { opacity: 0.55; cursor: default; }

  .news-msg {
    margin: 16px 0 0;
    min-height: 1.2em;
    font-family: var(--font-body);
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .news-msg.ok { color: var(--ivory); }
  .news-msg.err { color: #ff9db6; }

  .news-consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 4px 0 20px;
    cursor: pointer;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .news-consent input {
    margin-top: 2px;
    width: 15px;
    height: 15px;
    accent-color: var(--mag);
    flex: 0 0 auto;
    cursor: pointer;
  }
  .news-consent a { color: var(--ivory); text-decoration: underline; text-underline-offset: 2px; }
  .news-consent a:hover { color: var(--mag); }

  /* ---- divisoria ---- */
  .foot-rule { border: none; border-top: 1px solid var(--line); margin: 0; }

  /* ---- wordmark gigante ---- */
  .wordmark {
    position: relative;
    padding: 30px 24px 8px;
    text-align: center;
    overflow: hidden;
  }
  .wordmark .big {
    display: inline-block;
    max-width: 100%;
    font-family: var(--font-title);
    font-weight: 500;
    font-size: 20vw;
    letter-spacing: 0.005em;
    white-space: nowrap;
    line-height: 0.82;
    background: linear-gradient(100deg,
      var(--ivory) 0%, var(--ivory) 40%,
      var(--mag) 50%,
      var(--ivory) 60%, var(--ivory) 100%);
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: chshine 7s linear infinite;
  }
  @keyframes chshine {
    0% { background-position: 160% 0; }
    100% { background-position: -60% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wordmark .big { animation: none; -webkit-text-fill-color: var(--ivory); color: var(--ivory); }
  }

  /* ---- barra legale ---- */
  .foot-legal {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 14px;
  }
  .foot-legal span, .foot-legal a {
    font-family: var(--font-title);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .foot-legal .legal-links { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .foot-legal .legal-links a:hover { color: var(--ivory); }
  .foot-legal .dot { opacity: 0.5; }

  @media (max-width: 1024px) {
    .foot { padding: 48px 0 24px; }
    .foot-inner { padding: 0 18px; }
    .foot-top { grid-template-columns: 1fr; gap: 44px; padding-bottom: 44px; }
    .nav { border-left: none; padding-left: 0; }
    .news { padding-left: 0; }
    .about { padding-right: 0; }
    .wordmark { padding: 22px 16px 6px; }
  }
  @media (max-width: 560px) {
    .foot-legal { flex-direction: column; align-items: flex-start; gap: 10px; }
    /* Poco spazio: foto sopra, testo sotto */
    .about { flex-direction: column; align-items: flex-start; gap: 22px; }
    .about-photo { flex: none; }
  }
</style>
