    errCampi: "Vérifiez les champs.", errChiuso: "Le service vient de se terminer.",
    errTavolo: "Cette table n’existe pas. Vérifiez le numéro.",
    errGenerico: "Impossible d’enregistrer la table. Réessayez.",
    chiusoTitolo: "Nous sommes fermés", chiusoRiapre: "Nous rouvrons aujourd’hui à {ora}.",
    chiusoOggi: "Le service est terminé pour aujourd’hui.", aggiorna: "Actualiser",
    nonDisponibileTitolo: "Commande indisponible", nonDisponibileTesto: "La commande depuis la table n’est pas disponible pour le moment. Un membre de l’équipe peut prendre votre commande.",
    chiama: "Appeler le serveur", chiamaTitolo: "À quelle table êtes-vous ?", chiamaFatto: "C’est noté : un serveur arrive à la table {t}.", chiamaErr: "L’appel n’est pas passé. Faites signe à un serveur.", chiamaNomeTitolo: "Pour que le serveur vous trouve", chiamaNome: "Votre prénom", chiamaInvia: "Appeler le serveur", chiamaFattoNome: "C’est noté : un serveur arrive.", chiamaAttendi: "Le serveur est prévenu. Vous pourrez rappeler dans {tempo}.",
  },
  en: {
    titolo: "Order from your table",
    tavolo: "Your table", tavoloAiuto: "The number written on the table",
    persone: "How many of you?",
    scegli: "Choose", cambia: "Change", chiudi: "Close", tavoloUnito: "This table is already open: your order is added to it.", scegliTavolo: "Choose your table…",
    errCampi: "Please check the fields.", errChiuso: "Service has just ended.",
    errTavolo: "That table doesn’t exist. Check the number.",
    errGenerico: "Could not register the table. Please try again.",
    chiusoTitolo: "We’re closed", chiusoRiapre: "We reopen today at {ora}.",
    chiusoOggi: "Service is over for today.", aggiorna: "Refresh",
    nonDisponibileTitolo: "Ordering unavailable", nonDisponibileTesto: "Ordering from the table isn’t available right now. A member of staff can take your order.",
    chiama: "Call the waiter", chiamaTitolo: "Which table are you at?", chiamaFatto: "Got it: a waiter is on the way to table {t}.", chiamaErr: "The call didn’t go through. Please wave to a member of staff.", chiamaNomeTitolo: "So the waiter can find you", chiamaNome: "Your first name", chiamaInvia: "Call the waiter", chiamaFattoNome: "Got it: a waiter is on the way.", chiamaAttendi: "The waiter has been told. You can call again in {tempo}.",
  },
  it: {
    titolo: "Ordina dal tavolo",
    tavolo: "Il tuo tavolo", tavoloAiuto: "Il numero scritto sul tavolo",
    persone: "In quanti siete?",
    scegli: "Scegli", cambia: "Cambia", chiudi: "Chiudi", tavoloUnito: "Questo tavolo è già aperto: il tuo ordine si aggiunge al suo.", scegliTavolo: "Scegli il tuo tavolo…",
    errCampi: "Controlla i campi.", errChiuso: "Il servizio è appena terminato.",
