---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileNav from "../components/MobileNav.astro";
import CookieBanner from "../components/CookieBanner.astro";
import ReservationModal from "../components/ReservationModal.astro";
import SitePopup from "../components/SitePopup.astro";
import { getLangFromUrl } from "../i18n/ui";
import { CLIENT } from "../config/client";
import { supabaseAdmin } from "../lib/db";
import { cacheOr } from "../lib/cache";
import { restaurantJsonLd } from "../lib/jsonLd";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  transparentHeader?: boolean;
  lightHeader?: boolean;
  hideMobileNav?: boolean;
  bare?: boolean;
}
const { title = `${CLIENT.nome} — ${CLIENT.claim}`, description: descProp, noindex = false, transparentHeader = true, lightHeader = false, hideMobileNav = false, bare = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);

// SEO: descrizione per-pagina (passata dalle pagine); fallback ricco di keyword locali.
const description =
  descProp ??
  (lang === "en"
    ? "Comptoir Chouchou, restaurant and grocery in Mont-Saint-Guibert, Walloon Brabant. Creative, homemade cuisine in tune with the seasons. Book your table."
    : "Comptoir Chouchou, restaurant et épicerie à Mont-Saint-Guibert, en Brabant wallon. Cuisine créative et faite maison, au fil des saisons. Réservez votre table.");

const siteUrl = (process.env.PUBLIC_SITE_URL ?? import.meta.env.PUBLIC_SITE_URL ?? "https://example.com").replace(/\/$/, "");
const ogImage = `${siteUrl}/slideshow/slide-01.webp`;
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// Favicon del brand (Admin -> Général): usata sul sito pubblico E sull'admin.
// Se non caricata, si ricade sui file statici in /public.
const brandFavicon = await cacheOr("public:favicon", async () => {
  try {
    const { data } = await supabaseAdmin
      .from("app_config").select("value").eq("key", "brand_favicon").maybeSingle();
    const v = String((data as { value?: unknown } | null)?.value ?? "").trim();
    return v.startsWith("https://") || v.startsWith("/") ? v : "";
  } catch {
    return "";
  }
});
const ogLocale = lang === "en" ? "en_US" : "fr_BE";

// hreflang FR/EN (versione alternata della pagina corrente)
const _p = Astro.url.pathname;
const frPath = _p === "/en" ? "/" : _p.startsWith("/en/") ? _p.slice(3) : _p;
const enPath = frPath === "/" ? "/en" : "/en" + frPath;
const frUrl = new URL(frPath, siteUrl).href;
const enUrl = new URL(enPath, siteUrl).href;

// Dati strutturati Restaurant (SEO locale), su tutte le pagine tranne quelle "bare".
const jsonLd = bare ? "" : await restaurantJsonLd(siteUrl, lang);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" hreflang="fr-be" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />

    {brandFavicon ? (
      <link rel="icon" href={brandFavicon} />
    ) : (
      <>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
      </>
    )}
    <link rel="apple-touch-icon" href={brandFavicon || "/apple-touch-icon.png"} />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn, iMessage) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={CLIENT.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Birthstone&family=Lato:wght@400;700&family=Quicksand:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Birthstone&family=Lato:wght@400;700&family=Quicksand:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <style is:global>
      :root {
        --c-bg: #231f20;
        --c-text: #ffffff;
        --c-accent: #dfab4e;
        --c-muted: #b3aca6;
        --c-line: #3a3335;
        --font-title: "Quicksand", system-ui, sans-serif;
        --font-body: "Lato", system-ui, sans-serif;
        --font-display: "Quicksand", system-ui, sans-serif;
        --font-script: "Birthstone", cursive;
        --maxw: 1440px;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--c-bg);
        color: var(--c-text);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
      }
      /* Riserva sempre lo spazio della scrollbar: header (fixed) e footer
         (flusso) restano centrati sullo stesso 1440px, niente scostamenti. */
      html { scrollbar-gutter: stable; }
      h1, h2, h3, h4 {
        font-family: var(--font-title);
        font-weight: 600;
        letter-spacing: 0.02em;
        line-height: 1.05;
        margin: 0 0 0.5em;
      }
      a { color: inherit; text-decoration: none; }
      /* Enfasi corsiva manoscritta Chouchou (Birthstone) */
      em, i, .script { font-family: var(--font-script); font-style: normal; font-weight: 400; }
      .script { font-size: 1.35em; line-height: 1; }
      .container {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0 2rem;
      }

      /* Su mobile, spazio extra in fondo per non finire sotto la bottom bar */
      @media (max-width: 900px) {
        body { padding-bottom: 88px; }
      }
      @media (max-width: 600px) {
        /* Nome/Cognome/Email/Tel: uno sotto l'altro, 100% */
        .bk-row--stack { flex-direction: column; gap: 0.8rem; }
        .bk-row--stack > * { width: 100%; flex: none; }
      }

      /* ===== Modale prenotazione ===== */
      .bk-overlay {
        position: fixed;
        inset: 0;
        z-index: 200;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 5vh 1rem;
        overflow-y: auto;
      }
      .bk-modal {
        position: relative;
        width: 100%;
        max-width: 560px;
        background: var(--c-bg);
        border: 1px solid var(--c-text);
        padding: 2.5rem 2rem;
      }
      .bk-close {
        position: absolute;
        top: 0.8rem;
        right: 1rem;
        background: none;
        border: none;
        color: var(--c-muted);
        font-size: 1.8rem;
        line-height: 1;
        cursor: pointer;
      }
      .bk-close:hover { color: var(--c-text); }
      /* Close circolare in basso a destra: cerchio bianco, X nera */
      .bk-close-fab {
        position: absolute;
        bottom: 1.2rem;
        right: 1.2rem;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--c-text);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
        transition: transform 0.15s ease, opacity 0.15s ease;
      }
      .bk-close-fab:hover { transform: scale(1.08); opacity: 0.9; }
      .bk-claim {
        font-family: var(--font-title);
        letter-spacing: 0.35em;
        font-size: 0.75rem;
        color: var(--c-muted);
        margin: 0 0 0.6rem;
      }
      .bk-title {
        font-family: var(--font-title);
        font-size: clamp(1.9rem, 6vw, 2.6rem);
        line-height: 1;
        margin: 0 0 1.5rem;
        color: var(--c-text);
      }
      .bk-form { display: flex; flex-direction: column; gap: 0.8rem; }
      .bk-row { display: flex; gap: 0.8rem; flex-wrap: wrap; }
      .bk-row > * { flex: 1; min-width: 120px; }
      /* Date + Personnes: 60 / 40 */
      .bk-row--datepeople > *:first-child { flex: 1; }
      .bk-row--datepeople > *:last-child { flex: 1; min-width: 0; }
      .bk-field { display: flex; flex-direction: column; gap: 0.3rem; }
      .bk-label {
        font-size: 0.75rem;
        color: var(--c-muted);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .bk-input, .bk-textarea {
        width: 100%;
        box-sizing: border-box;
        background: transparent;
        border: 1px solid var(--c-text);
        color: var(--c-text);
        font-family: var(--font-body);
        font-size: 1rem;
        padding: 0.7rem 0.9rem;
        border-radius: 0;
      }
      .bk-input::placeholder, .bk-textarea::placeholder { color: var(--c-muted); }
      .bk-input:focus, .bk-textarea:focus { outline: none; box-shadow: 0 0 0 1px var(--c-text); }
      /* I picker nativi date/time sono chiari su sfondo scuro: li schiarisco */
      .bk-input[type="date"], .bk-input[type="time"] { color-scheme: dark; }
      /* Stepper numero persone (no input testuale: niente bug tastiera mobile) */
      .bk-stepper {
        display: flex;
        align-items: stretch;
        border: 1px solid var(--c-text);
      }
      .bk-step {
        width: 2.6rem;
        flex-shrink: 0;
        background: transparent;
        border: none;
        color: var(--c-text);
        font-size: 1.4rem;
        line-height: 1;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: background 0.2s ease, color 0.2s ease;
      }
      .bk-step:first-child { border-right: 1px solid var(--c-text); }
      .bk-step:last-child { border-left: 1px solid var(--c-text); }
      .bk-step:hover:not(:disabled) { background: var(--c-text); color: var(--c-bg); }
      .bk-step:disabled { opacity: 0.3; cursor: not-allowed; }
      .bk-step-val {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--c-text);
        font-size: 1.1rem;
        font-family: var(--font-body);
        min-width: 0;
        padding: calc(0.7rem - 1px) 0; /* -1px sopra e sotto compensa i 2px di bordo del contenitore */
      }
      .bk-date { cursor: pointer; }
      .bk-textarea { resize: vertical; }
      .bk-check {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--c-text);
        font-size: 0.9rem;
        cursor: pointer;
        margin: 0.3rem 0;
      }
      .bk-check input { accent-color: var(--c-text); width: 16px; height: 16px; }
      .bk-consent { align-items: flex-start; color: var(--c-muted); line-height: 1.4; }
      .bk-consent input { margin-top: 0.15rem; flex-shrink: 0; }
      .bk-consent a { color: var(--c-text); text-decoration: underline; text-underline-offset: 2px; }

      /* Slot prenotazione (tab Midi/Soir + orari) */
      .bk-slots { display: flex; flex-direction: column; gap: 0.6rem; margin: 0.3rem 0; }
      .bk-tabs { display: flex; gap: 0.5rem; }
      .bk-tab {
        flex: 1;
        padding: 0.5rem;
        border: 1px solid var(--c-line);
        background: transparent;
        color: var(--c-muted);
        font-family: var(--font-title);
        font-size: 1.1rem;
        letter-spacing: 0.05em;
        cursor: pointer;
        border-radius: 0;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }
      .bk-tab.is-active { background: var(--c-text); color: var(--c-bg); border-color: var(--c-text); }
      .bk-tab:disabled { opacity: 0.35; cursor: not-allowed; }
      .bk-slot-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .bk-slot {
        padding: 0.45rem 0.85rem;
        border: 1px solid var(--c-text);
        background: transparent;
        color: var(--c-text);
        font-size: 0.9rem;
        cursor: pointer;
        border-radius: 0;
        transition: background 0.2s ease, color 0.2s ease;
      }
      .bk-slot.is-selected { background: var(--c-text); color: var(--c-bg); }
      .bk-slot-msg { color: var(--c-muted); font-size: 0.9rem; margin: 0; }

      .bk-submit {
        margin-top: 0.5rem;
        width: 100%;
        padding: 0.85rem;
        background: var(--c-text);
        color: var(--c-bg);
        border: 1px solid var(--c-text);
        font-family: var(--font-title);
        font-size: 1.2rem;
        letter-spacing: 0.05em;
        cursor: pointer;
        border-radius: 0;
        transition: background 0.2s ease, color 0.2s ease;
      }
      .bk-submit:hover:not(:disabled) { background: transparent; color: var(--c-text); }
      .bk-submit:disabled { opacity: 0.5; cursor: not-allowed; }
      .bk-error { color: #ff6b6b; font-size: 0.85rem; margin: 0; }
      .bk-note { font-size: 0.78rem; color: var(--c-muted); text-align: center; margin: 0.4rem 0 0; }
      .bk-done { text-align: center; }
      .bk-done .bk-sub { color: var(--c-muted); line-height: 1.6; margin: 0 0 1.5rem; }

      /* Calendario custom prenotazione */
      .bk-datebtn {
        text-align: left;
        cursor: pointer;
        font-family: var(--font-body);
      }
      .bk-cal {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        z-index: 10;
        width: 280px;
        max-width: 90vw;
        background: var(--c-bg);
        border: 1px solid var(--c-text);
        padding: 0.8rem;
      }
      .bk-cal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.6rem;
      }
      .bk-cal-title {
        font-family: var(--font-title);
        font-size: 1.2rem;
        letter-spacing: 0.03em;
        color: var(--c-text);
      }
      .bk-cal-nav {
        width: 32px;
        height: 32px;
        border: 1px solid var(--c-line);
        background: transparent;
        color: var(--c-text);
        font-size: 1.2rem;
        line-height: 1;
        cursor: pointer;
        border-radius: 0;
      }
      .bk-cal-nav:disabled { opacity: 0.3; cursor: not-allowed; }
      .bk-cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 2px;
      }
      .bk-cal-dow { margin-bottom: 4px; }
      .bk-cal-dowcell {
        text-align: center;
        font-size: 0.7rem;
        color: var(--c-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.2rem 0;
      }
      .bk-cal-cell {
        aspect-ratio: 1;
        border: none;
        background: transparent;
        color: var(--c-text);
        font-family: var(--font-body);
        font-size: 0.9rem;
        cursor: pointer;
        border-radius: 0;
        transition: background 0.15s ease, color 0.15s ease;
      }
      .bk-cal-cell.is-empty { background: none; cursor: default; }
      .bk-cal-cell:not(.is-disabled):not(.is-empty):hover { background: var(--c-line); }
      .bk-cal-cell.is-disabled { color: #4a4a4a; cursor: not-allowed; text-decoration: line-through; }
      .bk-cal-cell.is-selected { background: var(--c-text); color: var(--c-bg); }
    </style>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />}
  </head>
  <body>
    {!bare && <Header transparent={transparentHeader} onLight={lightHeader} />}
    <main>
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && !hideMobileNav && <MobileNav />}
    <ReservationModal />
    <SitePopup />
    <CookieBanner />

    <!-- Analytics interne : provenance des arrivées (sans cookie ni donnée
         perso). Ne beacon QUE les entrées externes/directes, pas les
         navigations internes. Voir /api/track et supabase/traffic.sql. -->
    <script is:inline>
      (function () {
        try {
          var ref = document.referrer || "";
          var rh = "";
          try { rh = ref ? new URL(ref).host : ""; } catch (e) {}
          if (rh && rh === location.host) return; // navigation interne : on ignore
          var utm = new URLSearchParams(location.search).get("utm_source") || "";
          var body = JSON.stringify({ p: location.pathname, r: ref, u: utm });
          if (navigator.sendBeacon) {
            navigator.sendBeacon("/api/track", body);
          } else {
            fetch("/api/track", { method: "POST", body: body, keepalive: true });
          }
        } catch (e) { /* jamais bloquer la page pour des stats */ }
      })();
    </script>
  </body>
</html>